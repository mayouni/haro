# what a run writes: the guard's oracle work folder (it was Ring++'s runtime/haro-forge-oracle), measurements, scratch output
runtime/
# Python's bytecode, written beside the scripts
__pycache__/
*.pyc
# Ring's compiled objects
*.ringo
# the Haro VM's build output and cache (vm/build.zig)
vm/zig-out/
vm/.zig-cache/
# the checked build (zig build -Doptimize=ReleaseSafe -j2 -p zig-out-safe)
vm/zig-out-safe/

# a session's own permission list can hold a typed secret; ignored here, not only by one machine's global ignore (LOOKOUT-W45-SECRETS-01)
.claude/settings.local.json

# Central's files: each desk keeps them on its own machine, and Central reads them there (CENTRAL-PUBLICREPO-HARO-01)
WHATS-NEXT.md
