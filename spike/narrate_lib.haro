# narrate_lib.haro -- NARRATE: the court's voice (Haro v0.13), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a NARRATE loads this file
# beside court_lib.haro and carries the voice as
#   $aCourtNarrate = [name, opens, ends, refuses, [[kind, template], ...]]
# `narrate <file>` answers a sentence back in that voice: the opening, one
# sentence per declaration in file order, the ending -- or, when the court
# stops, the one refusal line with the line, the message and the code the
# envelope of v0.11 gives the same verdict.
#
# Two laws of the estate keep it honest (stz CLAUDE.md, stzn v0):
#   the StzNarration law -- a narration is a RENDERING of a real run, never
#   stored, the plain-text sentence being the document: this court prints to
#   stdout, writes no file, and has no verb that reads a narration back;
#   stzn's honesty guard -- a narration never alters a value it shows: a
#   placeholder is filled with the sentence's own text, verbatim, never
#   uppercased, trimmed or rephrased.
#
# A placeholder is {name}, {verb}, {rationale}, {line} or a seat of the kind
# (the meta-court refused any other at declaration). A seat the sentence left
# out fills as nothing; a list seat fills as its items joined by ", ", a pair
# list as key -> value joined by ", ". A kind the voice does not speak is
# narrated plainly: its verb, its name and the author's own reason -- the
# rationale is mandatory on every declaration (C6 3.8), so a narration never
# drops it.
#
# Functions only; the globals are the generated court's.

func NarBaseName(tPath)
	nCut = 0
	for i = 1 to len(tPath)
		if tPath[i] = "/" or ascii(tPath[i]) = 92 nCut = i ok
	next
	return substr(tPath, nCut + 1)

# a seat's value as text, verbatim
func NarSeatText(aDecl, tSeat)
	aC = aDecl[4]
	for i = 1 to len(aC)
		if lower(aC[i][1]) = tSeat
			aV = aC[i][3]
			tK = aV[1]
			if tK = "word" or tK = "string" or tK = "number" return aV[2] ok
			tOut = ""
			if tK = "pairlist"
				for j = 1 to len(aV[2])
					if j > 1 tOut += ", " ok
					tOut += aV[2][j][1] + " -> " + aV[2][j][2]
				next
				return tOut
			ok
			for j = 1 to len(aV[2])
				if j > 1 tOut += ", " ok
				tOut += aV[2][j]
			next
			return tOut
		ok
	next
	return ""

# fill a template: aVals is [[key, text], ...]; an unknown key fills as nothing
func NarFill(tT, aVals)
	tOut = ""
	nN = len(tT)
	nI = 1
	while nI <= nN
		tC = tT[nI]
		if tC = "{"
			nJ = nI + 1
			tW = ""
			while nJ <= nN and tT[nJ] != "}"
				tW += tT[nJ]
				nJ++
			end
			for k = 1 to len(aVals)
				if aVals[k][1] = tW tOut += aVals[k][2] ok
			next
			nI = nJ
		else
			tOut += tC
		ok
		nI++
	end
	return tOut

func NarSays(tKind)
	aS = $aCourtNarrate[5]
	for i = 1 to len(aS)
		if aS[i][1] = tKind return aS[i][2] ok
	next
	return ""

func NarrateRun(tFile)
	tSrc = read(tFile)
	CtSetCode("PARSE", [])
	tErr = ""
	aDecls = null
	try
		aDecls = CtDeclare(tSrc)
	catch
		tErr = cCatchError
	done
	tBase = NarBaseName(tFile)
	if tErr != ""
		tRefuses = $aCourtNarrate[4]
		if tRefuses = "" tRefuses = "I stopped at line {line}: {message}" ok
		tCites = ""
		for i = 1 to len($aCourtCites)
			if i > 1 tCites += ", " ok
			tCites += $aCourtCites[i]
		next
		? NarFill(tRefuses, [["language", $tCourtLang], ["file", tBase], ["line", string(CtLineOf(tErr))], ["code", $tCourtCode], ["message", CtStripPrefix(tErr)], ["cites", tCites]])
		return
	ok
	tOpens = $aCourtNarrate[2]
	if tOpens = "" tOpens = "{file} is a sentence of {language}, {count} declarations." ok
	tEnds = $aCourtNarrate[3]
	if tEnds = "" tEnds = "That is all of it." ok
	aTop = [["language", $tCourtLang], ["file", tBase], ["count", string(len(aDecls))]]
	? NarFill(tOpens, aTop)
	for i = 1 to len(aDecls)
		aD = aDecls[i]
		aKind = CtKindByVerb(aD[1])
		tT = ""
		if not isnull(aKind) tT = NarSays(aKind[2]) ok
		if tT = ""
			? lower(aD[1]) + " " + aD[2] + ": " + aD[5]
		else
			aVals = [["name", aD[2]], ["verb", aD[1]], ["rationale", aD[5]], ["line", string(aD[3])]]
			if not isnull(aKind)
				for j = 1 to len(aKind[3])
					aVals + [aKind[3][j][1], NarSeatText(aD, aKind[3][j][1])]
				next
			ok
			? NarFill(tT, aVals)
		ok
	next
	? NarFill(tEnds, aTop)

# ---- v0.16: a run and a question, told ---------------------------------------------------
#
#   <court>.ring narrate-run <file> <algorithm> <record json>
#   <court>.ring narrate-ask <file> <question> <rows json>
#
# The narration is a PROJECTION OF THE RUN ITSELF: the very run `run` or `ask` makes, with a
# flag raised so that each step records what it did as it does it (run_lib's RunNote, ask_lib's
# AskNote) -- never a second execution, never a replay, so what is told cannot differ from what
# was done. Each event is told in the template the voice's TELLS gives its key, or in a plain
# default; a step nested under another is indented two spaces a level; values are printed as
# `run` and `ask` print them. The same two laws as `narrate`: written to stdout and nowhere
# else, and no verb reads a narration back.

func NarTellText(tKey)
	aT = $aCourtNarrate[6]
	for i = 1 to len(aT)
		if aT[i][1] = tKey return aT[i][2] ok
	next
	return ""

func NarIndent(nN)
	tOut = ""
	for i = 1 to nN
		tOut += "  "
	next
	return tOut

# the one refusal line, as `narrate` gives it
func NarRefuse(tErr, tBase)
	tRefuses = $aCourtNarrate[4]
	if tRefuses = "" tRefuses = "I stopped at line {line}: {message}" ok
	tCites = ""
	for i = 1 to len($aCourtCites)
		if i > 1 tCites += ", " ok
		tCites += $aCourtCites[i]
	next
	? NarFill(tRefuses, [["language", $tCourtLang], ["file", tBase], ["line", string(CtLineOf(tErr))], ["code", $tCourtCode], ["message", CtStripPrefix(tErr)], ["cites", tCites]])

# one step of a run, told: [depth, name, value, key, taken, count]
func NarTellStep(aDecls, aE)
	aD = CtDeclNamed(aDecls, aE[2])
	aKind = CtKindByVerb(aD[1])
	tT = ""
	if not isnull(aKind) tT = NarTellText(aKind[2]) ok
	if tT = ""
		# a step the voice does not tell: its verb and name, and what it DID, read off the event's own fields
		tL = lower(aD[1]) + " " + aD[2]
		if aE[5] != ""
			tL += ": " + aE[5]
		but aE[6] != ""
			tL += ": " + aE[6] + " item(s)"
		but aE[4] != ""
			tL += ": " + aE[3] + " under " + aE[4]
		but aE[3] != ""
			tL += ": " + aE[3]
		ok
		return tL
	ok
	aVals = [["name", aD[2]], ["verb", aD[1]], ["rationale", aD[5]], ["line", string(aD[3])], ["value", aE[3]], ["key", aE[4]], ["taken", aE[5]], ["count", aE[6]]]
	# what the step DID is told before what was written: a seat that shares a name with one of the
	# event's own placeholders ({value} of a compute is the number it made, not the expression
	# that made it) is shadowed, so no key is filled twice
	if not isnull(aKind)
		for j = 1 to len(aKind[3])
			tSeatKey = aKind[3][j][1]
			bTaken = false
			for m = 1 to len(aVals)
				if aVals[m][1] = tSeatKey bTaken = true ok
			next
			if not bTaken
				aVals + [tSeatKey, NarSeatText(aD, tSeatKey)]
			ok
		next
	ok
	return NarFill(tT, aVals)

func NarTellRun(tFile, tAlg, tRec)
	CtSetCode("PARSE", [])
	tBase = NarBaseName(tFile)
	tErr = ""
	aDecls = null
	try
		aDecls = CtDeclare(read(tFile))
	catch
		tErr = cCatchError
	done
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	ok
	aRecord = null
	try
		aRecord = ExJsonParse(tRec)
	catch
		tErr = cCatchError
	done
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	ok
	tRecText = ExJson(aRecord)
	$bRunTrace = true
	$aRunTrace = []
	$nRunDepth = 0
	aRes = null
	try
		aRes = RunAlgorithm(aDecls, tAlg, aRecord)
	catch
		tErr = cCatchError
	done
	$bRunTrace = false
	tT = NarTellText("run")
	if tT = "" tT = "Running {algorithm}." ok
	? NarFill(tT, [["language", $tCourtLang], ["file", tBase], ["algorithm", tAlg], ["record", tRecText]])
	for i = 1 to len($aRunTrace)
		aE = $aRunTrace[i]
		? NarIndent(aE[1]) + NarTellStep(aDecls, aE)
	next
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	ok
	tT = NarTellText("result")
	if tT = "" tT = "{algorithm} answers {result}." ok
	? NarFill(tT, [["language", $tCourtLang], ["file", tBase], ["algorithm", tAlg], ["result", ExJson(aRes)]])

func NarAskDefault(tEvent)
	if tEvent = "ask" return "Asking {from}." ok
	if tEvent = "matched" return "{count} of {total} matched." ok
	if tEvent = "ordered" return "Ordered by {field}." ok
	if tEvent = "cut" return "Cut to {limit}." ok
	return "{count} answered: {rows}"

func NarTellAsk(tFile, tQ, tRows)
	CtSetCode("PARSE", [])
	tBase = NarBaseName(tFile)
	tErr = ""
	aDecls = null
	try
		aDecls = CtDeclare(read(tFile))
	catch
		tErr = cCatchError
	done
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	ok
	aRows = null
	try
		aRows = ExJsonParse(tRows)
	catch
		tErr = cCatchError
	done
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	ok
	$bAskTrace = true
	$aAskTrace = []
	try
		AskRun(aDecls, tQ, aRows)
	catch
		tErr = cCatchError
	done
	$bAskTrace = false
	for i = 1 to len($aAskTrace)
		aE = $aAskTrace[i]
		tT = NarTellText(aE[1])
		if tT = "" tT = NarAskDefault(aE[1]) ok
		aVals = [["language", $tCourtLang], ["file", tBase]]
		for j = 1 to len(aE[2])
			aV2 = aE[2][j]
			if islist(aV2[2])
				# v0.27: the rows a told answer carries leave redacted under the voice's safeguard
				aRows2 = aV2[2]
				if CtSafeguard("voice") = "redaction" aRows2 = CtRedactRows(aRows2, CtMarkedFields(aDecls)) ok
				aV3 = [aV2[1], ExJson(aRows2)]
				aVals + aV3
			else
				aVals + aV2
			ok
		next
		? NarFill(tT, aVals)
	next
	if tErr != ""
		NarRefuse(tErr, tBase)
	ok
