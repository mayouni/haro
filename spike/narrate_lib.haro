# narrate_lib.haro -- NARRATE: the court's voice (Haro v0.13), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a NARRATE loads this file
# beside court_lib.haro and carries the voice as
#   $aCourtNarrate = [name, opens, ends, refuses, [[kind, template], ...]]
# `narrate <file>` answers a sentence back in that voice: the opening, one
# sentence per declaration in file order, the ending -- or, when the court
# stops, the one refusal line with the line, the message and the code the
# envelope of v0.11 gives the same verdict.
#
# Two laws of the estate keep it honest (stz CLAUDE.md, stzn v0):
#   the StzNarration law -- a narration is a RENDERING of a real run, never
#   stored, the plain-text sentence being the document: this court prints to
#   stdout, writes no file, and has no verb that reads a narration back;
#   stzn's honesty guard -- a narration never alters a value it shows: a
#   placeholder is filled with the sentence's own text, verbatim, never
#   uppercased, trimmed or rephrased.
#
# A placeholder is {name}, {verb}, {rationale}, {line} or a seat of the kind
# (the meta-court refused any other at declaration). A seat the sentence left
# out fills as nothing; a list seat fills as its items joined by ", ", a pair
# list as key -> value joined by ", ". A kind the voice does not speak is
# narrated plainly: its verb, its name and the author's own reason -- the
# rationale is mandatory on every declaration (C6 3.8), so a narration never
# drops it.
#
# Functions only; the globals are the generated court's.

func NarBaseName(tPath)
	nCut = 0
	for i = 1 to Len(tPath)
		if tPath[i] = "/" or Ascii(tPath[i]) = 92 nCut = i end
	end
	return SubStr(tPath, nCut + 1)
end
# a seat's value as text, verbatim
func NarSeatText(xDecl, tSeat)
	xC = xDecl[4]
	for i = 1 to Len(xC)
		if Lower(xC[i][1]) = tSeat
			xV = xC[i][3]
			tK = xV[1]
			if tK = "word" or tK = "string" or tK = "number" return xV[2] end
			tOut = ""
			if tK = "pairlist"
				for j = 1 to Len(xV[2])
					if j > 1 tOut += ", " end
					tOut += xV[2][j][1] + " -> " + xV[2][j][2]
				end
				return tOut
			end
			for j = 1 to Len(xV[2])
				if j > 1 tOut += ", " end
				tOut += xV[2][j]
			end
			return tOut
		end
	end
	return ""
end
# fill a template: aVals is [[key, text], ...]; an unknown key fills as nothing
func NarFill(tT, vVals)
	tOut = ""
	nN = Len(tT)
	nI = 1
	while nI <= nN
		tC = tT[nI]
		if tC = "{"
			nJ = nI + 1
			tW = ""
			while nJ <= nN and tT[nJ] != "}"
				tW += tT[nJ]
				nJ++
			end
			for k = 1 to Len(vVals)
				if vVals[k][1] = tW tOut += vVals[k][2] end
			end
			nI = nJ
		else
			tOut += tC
		end
		nI++
	end
	return tOut
end
func NarSays(tKind)
	xS = $xCourtNarrate[5]
	for i = 1 to Len(xS)
		if xS[i][1] = tKind return xS[i][2] end
	end
	return ""
end
func NarrateRun(tFile)
	tSrc = Read(tFile)
	CtSetCode("PARSE", [])
	tErr = ""
	xDecls = ""
	try
		xDecls = CtDeclare(tSrc)
	catch
		tErr = cCatchError
	end
	tBase = NarBaseName(tFile)
	if tErr != ""
		tRefuses = $xCourtNarrate[4]
		if tRefuses = "" tRefuses = "I stopped at line {line}: {message}" end
		tCites = ""
		for i = 1 to Len($xCourtCites)
			if i > 1 tCites += ", " end
			tCites += $xCourtCites[i]
		end
		? NarFill(tRefuses, [["language", $tCourtLang], ["file", tBase], ["line", String(CtLineOf(tErr))], ["code", $tCourtCode], ["message", CtStripPrefix(tErr)], ["cites", tCites]])
		return
	end
	tOpens = $xCourtNarrate[2]
	if tOpens = "" tOpens = "{file} is a sentence of {language}, {count} declarations." end
	tEnds = $xCourtNarrate[3]
	if tEnds = "" tEnds = "That is all of it." end
	vTop = [["language", $tCourtLang], ["file", tBase], ["count", String(Len(xDecls))]]
	? NarFill(tOpens, vTop)
	for i = 1 to Len(xDecls)
		xD = xDecls[i]
		xKind = CtKindByVerb(xD[1])
		tT = ""
		if not IsEmpty(xKind) tT = NarSays(xKind[2]) end
		if tT = ""
			? Lower(xD[1]) + " " + xD[2] + ": " + xD[5]
		else
			vVals = [["name", xD[2]], ["verb", xD[1]], ["rationale", xD[5]], ["line", String(xD[3])]]
			if not IsEmpty(xKind)
				for j = 1 to Len(xKind[3])
					vVals + [xKind[3][j][1], NarSeatText(xD, xKind[3][j][1])]
				end
			end
			? NarFill(tT, vVals)
		end
	end
	? NarFill(tEnds, vTop)
end
# ---- v0.16: a run and a question, told ---------------------------------------------------
#
#   <court>.ring narrate-run <file> <algorithm> <record json>
#   <court>.ring narrate-ask <file> <question> <rows json>
#
# The narration is a PROJECTION OF THE RUN ITSELF: the very run `run` or `ask` makes, with a
# flag raised so that each step records what it did as it does it (run_lib's RunNote, ask_lib's
# AskNote) -- never a second execution, never a replay, so what is told cannot differ from what
# was done. Each event is told in the template the voice's TELLS gives its key, or in a plain
# default; a step nested under another is indented two spaces a level; values are printed as
# `run` and `ask` print them. The same two laws as `narrate`: written to stdout and nowhere
# else, and no verb reads a narration back.

func NarTellText(tKey)
	xT = $xCourtNarrate[6]
	for i = 1 to Len(xT)
		if xT[i][1] = tKey return xT[i][2] end
	end
	return ""
end
func NarIndent(nN)
	tOut = ""
	for i = 1 to nN
		tOut += "  "
	end
	return tOut
end
# the one refusal line, as `narrate` gives it
func NarRefuse(tErr, tBase)
	tRefuses = $xCourtNarrate[4]
	if tRefuses = "" tRefuses = "I stopped at line {line}: {message}" end
	tCites = ""
	for i = 1 to Len($xCourtCites)
		if i > 1 tCites += ", " end
		tCites += $xCourtCites[i]
	end
	? NarFill(tRefuses, [["language", $tCourtLang], ["file", tBase], ["line", String(CtLineOf(tErr))], ["code", $tCourtCode], ["message", CtStripPrefix(tErr)], ["cites", tCites]])
end
# one step of a run, told: [depth, name, value, key, taken, count]
func NarTellStep(xDecls, xE)
	xD = CtDeclNamed(xDecls, xE[2])
	xKind = CtKindByVerb(xD[1])
	tT = ""
	if not IsEmpty(xKind) tT = NarTellText(xKind[2]) end
	if tT = ""
		# a step the voice does not tell: its verb and name, and what it DID, read off the event's own fields
		tL = Lower(xD[1]) + " " + xD[2]
		if xE[5] != ""
			tL += ": " + xE[5]
		elseif xE[6] != ""
			tL += ": " + xE[6] + " item(s)"
		elseif xE[4] != ""
			tL += ": " + xE[3] + " under " + xE[4]
		elseif xE[3] != ""
			tL += ": " + xE[3]
		end
		return tL
	end
	vVals = [["name", xD[2]], ["verb", xD[1]], ["rationale", xD[5]], ["line", String(xD[3])], ["value", xE[3]], ["key", xE[4]], ["taken", xE[5]], ["count", xE[6]]]
	# what the step DID is told before what was written: a seat that shares a name with one of the
	# event's own placeholders ({value} of a compute is the number it made, not the expression
	# that made it) is shadowed, so no key is filled twice
	if not IsEmpty(xKind)
		for j = 1 to Len(xKind[3])
			tSeatKey = xKind[3][j][1]
			bTaken = false
			for m = 1 to Len(vVals)
				if vVals[m][1] = tSeatKey bTaken = true end
			end
			if not bTaken
				vVals + [tSeatKey, NarSeatText(xD, tSeatKey)]
			end
		end
	end
	return NarFill(tT, vVals)
end
func NarTellRun(tFile, tAlg, tRec)
	CtSetCode("PARSE", [])
	tBase = NarBaseName(tFile)
	tErr = ""
	xDecls = ""
	try
		xDecls = CtDeclare(Read(tFile))
	catch
		tErr = cCatchError
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	end
	xRecord = ""
	try
		xRecord = ExJsonParse(tRec)
	catch
		tErr = cCatchError
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	end
	tRecText = ExJson(xRecord)
	$bRunTrace = true
	$vRunTrace = []
	$nRunDepth = 0
	xRes = ""
	try
		xRes = RunAlgorithm(xDecls, tAlg, xRecord)
	catch
		tErr = cCatchError
	end
	$bRunTrace = false
	tT = NarTellText("run")
	if tT = "" tT = "Running {algorithm}." end
	? NarFill(tT, [["language", $tCourtLang], ["file", tBase], ["algorithm", tAlg], ["record", tRecText]])
	for i = 1 to Len($vRunTrace)
		xE = $vRunTrace[i]
		? NarIndent(xE[1]) + NarTellStep(xDecls, xE)
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	end
	tT = NarTellText("result")
	if tT = "" tT = "{algorithm} answers {result}." end
	? NarFill(tT, [["language", $tCourtLang], ["file", tBase], ["algorithm", tAlg], ["result", ExJson(xRes)]])
end
func NarAskDefault(tEvent)
	if tEvent = "ask" return "Asking {from}." end
	if tEvent = "matched" return "{count} of {total} matched." end
	if tEvent = "ordered" return "Ordered by {field}." end
	if tEvent = "cut" return "Cut to {limit}." end
	return "{count} answered: {rows}"
end
func NarTellAsk(tFile, tQ, tRows)
	CtSetCode("PARSE", [])
	tBase = NarBaseName(tFile)
	tErr = ""
	xDecls = ""
	try
		xDecls = CtDeclare(Read(tFile))
	catch
		tErr = cCatchError
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	end
	xRows = ""
	try
		xRows = ExJsonParse(tRows)
	catch
		tErr = cCatchError
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
		return
	end
	$bAskTrace = true
	$vAskTrace = []
	try
		AskRun(xDecls, tQ, xRows)
	catch
		tErr = cCatchError
	end
	$bAskTrace = false
	for i = 1 to Len($vAskTrace)
		xE = $vAskTrace[i]
		tT = NarTellText(xE[1])
		if tT = "" tT = NarAskDefault(xE[1]) end
		vVals = [["language", $tCourtLang], ["file", tBase]]
		for j = 1 to Len(xE[2])
			xV2 = xE[2][j]
			if IsList(xV2[2])
				# v0.27: the rows a told answer carries leave redacted under the voice's safeguard
				xRows2 = xV2[2]
				if CtSafeguard("voice") = "redaction" xRows2 = CtRedactRows(xRows2, CtMarkedFields(xDecls)) end
				vV3 = [xV2[1], ExJson(xRows2)]
				vVals + vV3
			else
				vVals + xV2
			end
		end
		? NarFill(tT, vVals)
	end
	if tErr != ""
		NarRefuse(tErr, tBase)
	end
end
