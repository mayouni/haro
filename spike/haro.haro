# haro.haro -- `haro haro.haro <file.haro>`: judge a language declaration
# with the stzu v0.1 meta-court, in pure core Ring, on rnx or on the oracle.
#
# Prints "ok" and the structural fields on acceptance, or the one refusal
# line "stzu (line N): message". The spike's first act: the declaring
# altitude of Haro, judged by the same fixtures as the Luau meta-court.
#
# sysargv is [interpreter, script, args...] on both runtimes, so the file
# is sysargv[3]. The two parse-state globals are born here, at the top
# level, because on Ring a `$name` first assigned inside a function is
# that function's local (C-2's own note), and on Ring++ `$` is the global.

load "haro_lib.haro"

$aStzuToks = []
$aStzuUnions = []
$nStzuPos = 1
$aCondToks = []
$nCondPos = 1
$aCondDeclSeats = []
$aCondDecls = []
$aCondVerbOf = []
$tCondOther = ""
$aCondRefSeats = []
$aCondFormats = []
$bCondUnread = false
$aCondLangs = []
$tCondLang = ""
$aCourtSentences = []
$tStzuDir = ""
$bStzuCollect = false
$aStzuFound = []
$aStzuBroken = []
$aStzuLastName = ""
$aStzuUnresolved = []
$aStzuWarnings = []
$aStzuNotes = []
$aBlkToks = []
$nBlkPos = 1

if Len(sysargv) < 3
	? "usage: haro.haro <file.haro> [all | fmt]"
else
	tPath = sysargv[3]
	tSrc = Read(tPath)
	$tStzuDir = StzuDirOf(tPath)
	bAll = false
	bFmt = false
	if Len(sysargv) >= 4
		if sysargv[4] = "all" bAll = true end
		if sysargv[4] = "fmt" bFmt = true end
	end
	if bFmt
		HaroFmt(tSrc)
	elseif bAll
		HaroAll(tSrc)
	else
		try
			aLang = StzuDeclare(tSrc)
			StzuPrintLanguage(aLang)
		catch
			? cCatchError
		end
	end
end

# v0.30: `fmt` -- the canonical printing of the declaration (BLOCKS.md 3.2): the one reader of C6 reads it into a
# block and the one printer prints it; a text the reader refuses prints the refusal line. The meta-court judges
# nothing here: a declaration is printed before it is judged, so an author sees the spelling of what was written
func HaroFmt(tText)
	try
		FWrite(stdout, BlkPrintC6(BlkLoad(tText)))
	catch
		? cCatchError
	end
end
# v0.15: `all` -- every defect of the declaration, one line each, in the order of the file.
# A FUNCTION, not top-level code, on purpose: on Ring a bare assignment inside a function to a
# name that exists as a global writes the GLOBAL, so the names used here (cE, aL, aFd) must be
# ones no script-level variable of this file is called -- cErr and aLang are, and StzuDeclare
# assigns both of its own (found on the oracle: its cErr leaked into the top level's)
func HaroAll(tText)
	$bStzuCollect = true
	tE = ""
	aL = null
	try
		aL = StzuDeclare(tText)
	catch
		tE = cCatchError
	end
	$bStzuCollect = false
	if tE != ""
		$aStzuFound + [StzuLineOf(tE), StzuStripPrefix(tE)]
	end
	if Len($aStzuFound) > 0
		aFd = StzuSortFound($aStzuFound)
		for k = 1 to Len(aFd)
			? "haro (line " + String(aFd[k][1]) + "): " + String(aFd[k][2])
		end
	else
		StzuPrintLanguage(aL)
	end
end
