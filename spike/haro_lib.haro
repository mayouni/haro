# haro_lib.haro -- the stzu meta-court, v0.2, in pure core Ring (no Softanza).
#
# v0.1 was a port of stz/face/stz/Stzu.luau (437 lines); it still is, and the
# 28 v0.1 fixtures still pass unchanged. v0.2 is the declaring altitude of Haro
# grown by the WORLD and REFINE seats and the type kinds a real language's
# court needs (haro/spike/v02/GRAMMAR.md; the judge is v02/fixtures.json,
# written first): MENU, RANGE, FORMAT as seat types; a seat typed by a
# DECLARATION as a reference; NAMES on a declaration; CONSTRAINT with a
# condition in the closed language of cond_lib.haro; WORLD (ONE, FIRST);
# REFINE (POINTS, FLOOR).
#
# v0.6 (haro/spike/v06/GRAMMAR.md): a list of a two-seat FORM written as
# name: value pairs; an EXPRESSION's ABSENT, DIVISION and EQUALITY; and
# WALK, the one kinetic kind -- which kind is walked, by which steps, in
# what order, under which guards, computing what, failing how.
#
# v0.7 (haro/spike/v07/GRAMMAR.md): ASK, the Q letter -- the language's own
# closed question grammar: FROM which kinds, WHERE in which expression,
# which optional CLAUSES (where, order, limit); and ABSENT missing.
#
# v0.17 (haro/spike/v17/GRAMMAR.md): UNDERSTAND -- how a human language reaches closed questions: the eight
# kinds that play TONGUE, MEANING, ALIAS, SURFACE, STEP, FRAME, EXAMPLE and COUNTEREXAMPLE.
# v0.13 (haro/spike/v13/GRAMMAR.md): NARRATE -- how a run of the language is
# narrated back, the court's voice: a template per declaration kind, an
# opening, an ending, a refusal; a projection of the sentence, never stored,
# never parsed back (the StzNarration law; stzn).
#
# v0.12 (haro/spike/v12/GRAMMAR.md): FORMS -- a vocabulary's function-name
# grammar as data (principle 7): the fluent, passive and statement forms, the
# parameter suffixes, one meaning per suffix, and which declaration spells a
# family from a base and the forms it offers.
#
# v0.11 (haro/spike/v11/GRAMMAR.md): the Diagnostic Contract (C2 v1.2.0) --
# CODE, CODES and CITES, so a forged court speaks the family's envelope.
#
# v0.10 (haro/spike/v10/GRAMMAR.md): the WORLD as versioned data -- SYMBOL, a
# seat type resolved against a C1 world.json when the court is handed one, and
# PUBLISH on the WORLD, the kinds a sentence contributes as symbols.
#
# v0.9 (haro/spike/v09/GRAMMAR.md): what A needs -- RUN, the kinetic declaration
# of structured steps (OF, COMPUTE, COLLECT, GROUP, BRANCH, ITERATE: a kind and
# its seats by role), and a list seat whose element is a UNION of declarations.
#
# v0.8 (haro/spike/v08/GRAMMAR.md): what F needs -- a REFUSAL's NAMED words;
# pair lists keyed by a MENU or a DECLARATION with reference values; a UNION
# of DECLARATIONs; the shapes duration, landmark, deadline; the WORLD's
# ENTRY kinds; the relations reachable, referenced and keyed_by.

#
# The same file runs on haro and on the oracle and must print the same bytes.
# Refusals are one channel, "stzu (line N): message". Functions only; the
# globals ($aStzuToks, $nStzuPos, and cond_lib's) are born in the root file.

load "cond_lib.haro"
load "block_lib.haro"
load "pattern_lib.haro"
load "form_expand.haro"

# ---- the closed menus -------------------------------------------------------

func StzuOperators
	return ["or", "and", "not", "cmp", "contains", "add", "sub", "mul", "div", "mod", "round", "neg"]
end
func StzuOperands
	return ["number", "text", "flag", "ref", "var", "agg"]
end
func StzuAggregates
	return ["sum", "count", "avg", "min", "max"]
end
func StzuPrimitives
	return ["name", "text", "number", "flag", "ref"]
end
func StzuRefusalCategories
	return ["unknown_verb", "unknown_declaration", "unknown_seat", "unknown_variable",
	        "unterminated_string", "unexpected_character", "dangling_reference", "duplicate_name"]
end
func StzuShapes
	return ["absolute_path", "ipv4", "cidr", "mac", "label", "domain", "hex64", "hex64_lower", "duration", "landmark", "deadline"]
end
func StzuRefinementKinds
	return ["knob", "field", "symbol", "policy", "composite", "pipeline"]
end
func StzuPostures
	return ["trusted", "external", "sandboxed", "llm"]
end
# v0.23: Zin's six articles, in Zin's order and numbering (zin constitution.zig:35-40; charter 2),
# its eight weaves (ZIN_CONSTITUTIONAL_WEAVES.md) and its three severities -- the closed words of a
# CONSTITUTION; the weaves and severities are carried here and judged at ZC4
func StzuArticles
	return ["explainability", "reversibility", "visible_state", "predictable_authority", "organizational_sovereignty", "trust_hierarchy"]
end
func StzuWeaves
	return ["resilience", "observability", "sovereignty", "privacy", "temporal_integrity", "cost_awareness", "learnability", "structural_integrity"]
end
func StzuSeverities
	return ["constitutional", "governance", "advisory"]
end
# kind -> list of [clause, shape]; shapes: string namelist seatlist number ident pointlist
# (sorted by clause name, as Luau's table.sort gives, for the allowed-list text)
func StzuClauses(tKind)
	if tKind = "LANGUAGE"
		return [["COURT", "string"], ["EXTENSION", "string"], ["GRAMMAR", "string"], ["NEEDS", "namelist"], ["VERSION", "string"]]
	elseif tKind = "DECLARATION"
		return [["CODES", "messagelist"], ["INCLUDES", "namelist"], ["MESSAGES", "messagelist"], ["NAMES", "ident"], ["OPENS", "ident"], ["SEATS", "seatlist"], ["SEVERITIES", "pairlist"], ["VERB", "string"]]
	elseif tKind = "FORM"
		return [["SEATS", "seatlist"]]
	elseif tKind = "EXPRESSION"
		return [["ABSENT", "ident"], ["AGGREGATES", "namelist"], ["CONTEXTS", "contextlist"], ["DIVISION", "ident"], ["EQUALITY", "ident"], ["OPERANDS", "namelist"], ["OPERATORS", "namelist"], ["VARIABLES", "namelist"]]
	elseif tKind = "REFUSAL"
		return [["CITES", "citelist"], ["CODE", "string"], ["CODES", "messagelist"], ["MESSAGE", "string"], ["NAMED", "messagelist"], ["SEVERITIES", "pairlist"]]
	elseif tKind = "MENU"
		return [["CITES", "citelist"], ["CODE", "string"], ["MESSAGE", "string"], ["WORDS", "namelist"]]
	elseif tKind = "RANGE"
		return [["CITES", "citelist"], ["CODE", "string"], ["MAX", "number"], ["MESSAGE", "string"], ["MIN", "number"]]
	elseif tKind = "FORMAT"
		return [["CITES", "citelist"], ["CODE", "string"], ["FOLD", "ident"], ["MESSAGE", "string"], ["SHAPE", "ident"]]
	elseif tKind = "SENTENCE"
		return [["MESSAGE", "string"], ["OF", "string"], ["REFUSED", "string"]]
	elseif tKind = "VIEW"
		return [["NAMED", "string"], ["ON", "ident"], ["ONE", "string"], ["WHERE", "string"]]
	elseif tKind = "CONSTRAINT"
		return [["CITES", "citelist"], ["CODE", "string"], ["EXCEPT", "namelist"], ["MESSAGE", "string"], ["ON", "ident"], ["SEVERITY", "ident"], ["THEN", "string"], ["WHEN", "string"]]
	elseif tKind = "WORLD"
		return [["ENTRY", "namelist"], ["FIRST", "ident"], ["ONE", "namelist"], ["PUBLISH", "pairlist"]]
	elseif tKind = "REFINE"
		return [["FLOOR", "pointlist"], ["POINTS", "pointlist"]]
	elseif tKind = "CONSTITUTION"
		return [["ARTICLES", "namelist"], ["MOVEMENT", "ident"], ["PERSONAL", "pathlist"], ["REGIME", "ident"], ["SAFEGUARDS", "pairlist"], ["SOVEREIGN", "ident"], ["WEAVES", "pairlist"], ["ZONE", "ident"]]
	elseif tKind = "UNION"
		return [["CITES", "citelist"], ["CODE", "string"], ["MESSAGE", "string"], ["OF", "typelist"]]
	elseif tKind = "WALK"
		return [["COMPUTE", "ident"], ["FAIL", "ident"], ["FORMULA", "ident"], ["GUARDS", "pathlist"], ["OF", "ident"], ["ORDER", "ident"], ["STEPS", "ident"], ["THROUGH", "ident"]]
	elseif tKind = "ASK"
		return [["CLAUSES", "namelist"], ["FIELDS", "path"], ["FROM", "namelist"], ["WHERE", "ident"]]
	elseif tKind = "RUN"
		return [["BRANCH", "namelist"], ["COLLECT", "namelist"], ["COMPUTE", "namelist"], ["GROUP", "namelist"], ["ITERATE", "namelist"], ["OF", "namelist"]]
	elseif tKind = "PATTERN"
		return [["CITES", "citelist"], ["CODE", "string"], ["MATCH", "rule"], ["MESSAGE", "string"], ["OVER", "path"], ["SETS", "pointlist"], ["SEVERITY", "ident"]]
	elseif tKind = "SYMBOL"
		return [["CITES", "citelist"], ["CODE", "string"], ["KIND", "string"], ["MESSAGE", "string"], ["REF", "string"]]
	elseif tKind = "FORMS"
		return [["FAMILY", "namelist"], ["FLUENT", "string"], ["PARAMS", "messagelist"], ["PASSIVE", "string"], ["STATEMENT", "string"]]
	elseif tKind = "NARRATE"
		return [["ENDS", "string"], ["OPENS", "string"], ["REFUSES", "string"], ["SAYS", "messagelist"], ["TELLS", "messagelist"]]
	elseif tKind = "UNDERSTAND"
		return [["ALIAS", "namelist"], ["COUNTEREXAMPLE", "namelist"], ["EXAMPLE", "namelist"], ["FRAME", "namelist"], ["MEANING", "namelist"], ["STEP", "namelist"], ["SURFACE", "namelist"], ["TONGUE", "namelist"]]
	end
	return []
end
func StzuRequired(tKind)
	if tKind = "LANGUAGE"
		return ["VERSION", "GRAMMAR", "COURT", "EXTENSION"]
	elseif tKind = "DECLARATION"
		return ["VERB", "SEATS"]
	elseif tKind = "FORM"
		return ["SEATS"]
	elseif tKind = "EXPRESSION"
		return ["OPERATORS", "OPERANDS"]
	elseif tKind = "REFUSAL"
		return ["MESSAGE"]
	elseif tKind = "MENU"
		return ["WORDS"]
	elseif tKind = "RANGE"
		return ["MIN", "MAX"]
	elseif tKind = "FORMAT"
		return ["SHAPE"]
	elseif tKind = "CONSTRAINT"
		return ["ON", "WHEN", "MESSAGE"]
	elseif tKind = "CONSTITUTION"
		return ["ARTICLES"]
	elseif tKind = "WORLD"
		return []
	elseif tKind = "REFINE"
		return ["POINTS"]
	elseif tKind = "UNION"
		return ["OF"]
	elseif tKind = "SENTENCE"
		return ["OF"]
	elseif tKind = "VIEW"
		return ["ONE"]
	elseif tKind = "WALK"
		return ["OF", "STEPS", "THROUGH", "ORDER"]
	elseif tKind = "ASK"
		return ["FROM"]
	elseif tKind = "RUN"
		return ["OF"]
	elseif tKind = "PATTERN"
		return ["OVER", "MATCH", "MESSAGE"]
	elseif tKind = "SYMBOL"
		return ["KIND"]
	elseif tKind = "FORMS"
		return ["PARAMS"]
	elseif tKind = "NARRATE"
		return []
	elseif tKind = "UNDERSTAND"
		return ["TONGUE", "MEANING", "ALIAS", "SURFACE", "STEP", "FRAME", "EXAMPLE", "COUNTEREXAMPLE"]
	end
	return []
end
func StzuIsKind(tWord)
	return InStrList(tWord, ["LANGUAGE", "DECLARATION", "FORM", "EXPRESSION", "REFUSAL",
	                         "MENU", "RANGE", "FORMAT", "CONSTRAINT", "WORLD", "REFINE", "UNION",
	                         "SENTENCE", "VIEW", "WALK", "ASK", "RUN", "SYMBOL", "FORMS", "NARRATE", "UNDERSTAND", "CONSTITUTION", "PATTERN"])
end
# C2 2.1: a code is ^[A-Z][A-Z0-9]*([_-][A-Z0-9]+)*$ ; C2 2.5: a cite is
# kind:value, kind in rule|article|right|pattern, value [A-Za-z0-9_.-]+ (v0.11)
func StzuIsC2Code(tS)
	if Len(tS) = 0 return false end
	if not IsUpperChar(tS[1]) return false end
	bSep = false
	for i = 2 to Len(tS)
		tC = tS[i]
		if tC = "_" or tC = "-"
			if bSep return false end
			bSep = true
		elseif IsUpperChar(tC) or IsDigitChar(tC)
			bSep = false
		else
			return false
		end
	end
	return not bSep
end
func StzuIsC2Cite(tS)
	nN = SubStr(tS, ":")
	if nN < 2 return false end
	tKind = Left(tS, nN - 1)
	if not InStrList(tKind, ["rule", "article", "right", "pattern"]) return false end
	tV = SubStr(tS, nN + 1)
	if Len(tV) = 0 return false end
	for i = 1 to Len(tV)
		tC = tV[i]
		if not (IsUpperChar(tC) or IsLowerChar(tC) or IsDigitChar(tC) or tC = "_" or tC = "." or tC = "-") return false end
	end
	return true
end
# v0.16: the placeholders an event of a run or a question can fill, or a refusal naming why it cannot be told
func StzuTellPlaceholders(tKey, aDeclarations, aRun, aAsk, tLName, nLine)
	if tKey = "run" or tKey = "result"
		if IsNull(aRun) StzuFail(nLine, "TELLS: '" + tKey + "' tells a run, and this language declares no RUN") end
		if tKey = "run" return ["language", "file", "algorithm", "record"] end
		return ["language", "file", "algorithm", "result"]
	end
	if InStrList(tKey, ["ask", "matched", "ordered", "cut", "answer"])
		if IsNull(aAsk) StzuFail(nLine, "TELLS: '" + tKey + "' tells a question, and this language declares no ASK") end
		if tKey = "ask" return ["language", "file", "question", "from"] end
		if tKey = "matched" return ["count", "total", "from"] end
		if tKey = "ordered" return ["field", "direction"] end
		if tKey = "cut" return ["limit", "dropped", "count"] end
		return ["count", "rows"]
	end
	aDecl = null
	for j = 1 to Len(aDeclarations)
		if aDeclarations[j][1] = tKey aDecl = aDeclarations[j] end
	end
	if IsNull(aDecl) StzuFail(nLine, "TELLS: no declaration '" + tKey + "' in " + tLName) end
	if IsNull(aRun) StzuFail(nLine, "TELLS: '" + tKey + "' tells a step, and this language declares no RUN") end
	bPlays = false
	for r = 1 to Len(aRun[2])
		if aRun[2][r][1] != "OF"
			if aRun[2][r][2][1] = tKey bPlays = true end
		end
	end
	if not bPlays StzuFail(nLine, "TELLS: '" + tKey + "' plays no construct of this language's RUN") end
	aOk = ["name", "verb", "rationale", "line", "value", "key", "taken", "count"]
	for j = 1 to Len(aDecl[3])
		aOk + aDecl[3][j][1]
	end
	return aOk
end
# v0.13: every {word} of a template names a placeholder the voice can fill, and every brace closes
func StzuCheckTemplate(tT, aAllowed, nLine, tWhere)
	nN = Len(tT)
	nI = 1
	while nI <= nN
		if tT[nI] = "{"
			nJ = nI + 1
			tW = ""
			while nJ <= nN and tT[nJ] != "}"
				tW += tT[nJ]
				nJ++
			end
			if nJ > nN
				StzuFail(nLine, "a '{' is never closed in " + tWhere)
			end
			if not InStrList(tW, aAllowed)
				StzuFail(nLine, "'{" + tW + "}' in " + tWhere + " is not a placeholder the voice can fill: it fills " + StzuJoinWords(aAllowed))
			end
			nI = nJ
		end
		nI++
	end
end
func StzuJoinWords(aL)
	tOut = ""
	for i = 1 to Len(aL)
		if i > 1 tOut += ", " end
		tOut += aL[i]
	end
	return tOut
end
# v0.12: a suffix is letters, and no two roles spell the same one (the FF clash)
func StzuWantSuffix(tS, nLine, tWhere)
	if Len(tS) = 0 StzuFail(nLine, "'" + tS + "' on " + tWhere + " is not a suffix: a suffix is letters") end
	for i = 1 to Len(tS)
		if not (IsUpperChar(tS[i]) or IsLowerChar(tS[i]))
			StzuFail(nLine, "'" + tS + "' on " + tWhere + " is not a suffix: a suffix is letters")
		end
	end
end
func StzuWantOneMeaning(aSpelt, tRole, tSuffix, nLine)
	for i = 1 to Len(aSpelt)
		if aSpelt[i][2] = tSuffix
			StzuFail(nLine, "'" + tSuffix + "' is spelt twice, as " + aSpelt[i][1] + " and as " + tRole + ": one meaning per suffix")
		end
	end
end
func StzuWantCode(tCode, nLine, tWhere)
	if not StzuIsC2Code(tCode)
		StzuFail(nLine, "'" + tCode + "' on " + tWhere + " is not a code in the Diagnostic Contract's format: an uppercase identifier, [A-Z][A-Z0-9]* with _ or - between parts")
	end
end
# v0.28 (HARO-MENU-CITES-01): the word none cites nothing and passes; an empty list says nothing and is refused
# by name -- the machine language's own idiom for EGRESS, a list or the word none, never an empty list
func StzuWantCites(aCites, nLine, tWhere)
	if IsString(aCites) return end
	if Len(aCites) = 0
		StzuFail(nLine, "an empty CITES says nothing: a list names what the refusal cites, and the word none says it cites nothing")
	end
	for i = 1 to Len(aCites)
		if not StzuIsC2Cite(aCites[i])
			StzuFail(nLine, "'" + aCites[i] + "' on " + tWhere + " is not a cite: kind:value with kind rule, article, right or pattern")
		end
	end
end
# v0.35: a SEVERITIES list -- each entry named once, each error or warning
func StzuWantSeverities(aSv, tWhat)
	for i = 1 to Len(aSv)
		for j = 1 to i - 1
			if aSv[j][1] = aSv[i][1] StzuFail(aSv[i][3], "'" + aSv[i][1] + "' is named twice in SEVERITIES") end
		end
		if aSv[i][2] != "error" and aSv[i][2] != "warning"
			StzuFail(aSv[i][3], "'" + aSv[i][2] + "' is not a SEVERITY of " + tWhat + ": error or warning")
		end
	end
end
# v0.35: a seat whose value is a reference the court resolves -- to a DECLARATION, a UNION holding one, a SYMBOL the world resolves, or a
# list of pairs whose keys or values are references
func StzuIsReferenceSeat(aSeat, aDeclared, aForms, aUnions)
	tK = DeclaredKind(aDeclared, aSeat[2])
	if tK = "DECLARATION" or tK = "SYMBOL" return true end
	if tK = "UNION"
		for i = 1 to Len(aUnions)
			if aUnions[i][1] = aSeat[2]
				for j = 1 to Len(aUnions[i][2])
					if DeclaredKind(aDeclared, aUnions[i][2][j][1]) = "DECLARATION" and not aUnions[i][2][j][2] return true end
				end
			end
		end
		return false
	end
	if tK = "FORM" and aSeat[3]
		for i = 1 to Len(aForms)
			if aForms[i][1] = aSeat[2] and StzuIsPairForm(aForms[i][2], aDeclared)
				if StzuPairRefs(aForms[i][2], aDeclared) return true end
			end
		end
	end
	return false
end
func StzuCodesOf(aClauses, nLine, tWhere)
	aCodes = []
	if HasClause(aClauses, "CODES")
		aCodes = ClauseValue(aClauses, "CODES")
		for i = 1 to Len(aCodes)
			StzuWantCode(aCodes[i][2], aCodes[i][3], tWhere + "." + aCodes[i][1])
		end
	end
	return aCodes
end
func StzuCodeOf(aClauses, nLine, tWhere)
	tCode = ""
	if HasClause(aClauses, "CODE")
		tCode = ClauseValue(aClauses, "CODE")
		StzuWantCode(tCode, nLine, tWhere)
	end
	return tCode
end
func StzuCitesOf(aClauses, nLine, tWhere)
	aCites = []
	if HasClause(aClauses, "CITES")
		aCites = ClauseValue(aClauses, "CITES")
		StzuWantCites(aCites, nLine, tWhere)
	end
	return aCites
end
# the directory part of a path, "" when none (core Ring has no dirname)
func StzuDirOf(tPath)
	nN = 0
	for i = 1 to Len(tPath)
		if tPath[i] = "/" or tPath[i] = Char(92) nN = i end
	end
	if nN = 0 return "" end
	return Left(tPath, nN - 1)
end
# what a seat's type name resolves to in a language record:
# prim form expr menu range format decl union sentence
func StzuTypeKindOf(aLang, tOf)
	if InStrList(tOf, StzuPrimitives()) return "prim" end
	aL = LangGet(aLang, "forms")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "form" end end
	aL = LangGet(aLang, "menus")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "menu" end end
	aL = LangGet(aLang, "ranges")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "range" end end
	aL = LangGet(aLang, "formats")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "format" end end
	aL = LangGet(aLang, "declarations")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "decl" end end
	aL = LangGet(aLang, "unions")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "union" end end
	aL = LangGet(aLang, "sentences")
	for i = 1 to Len(aL) if aL[i][1] = tOf return "sentence" end end
	aL = LangGet(aLang, "symbols")
	if not IsNull(aL)
		for i = 1 to Len(aL) if aL[i][1] = tOf return "symbol" end end
	end
	return "expr"
end
# the condition tables of a language record and of the languages its
# SENTENCEs name (v0.4): one entry per language, [lang, declseats, onedecls,
# views, verbof]
func StzuCondLangs(aLang, aViewEntries)
	aOut = [StzuCondLang(aLang, aViewEntries)]
	aS = LangGet(aLang, "sentences")
	for i = 1 to Len(aS)
		if not IsNull(aS[i][3])
			aInner = StzuCondLangs(aS[i][3], [])
			for j = 1 to Len(aInner)
				aOut + aInner[j]
			end
		end
	end
	return aOut
end
func StzuCondLang(aLang, aViewEntries)
	aDecls = LangGet(aLang, "declarations")
	aSents = LangGet(aLang, "sentences")
	aDeclSeats = []
	aVerbOf = []
	for i = 1 to Len(aDecls)
		aS = aDecls[i][3]
		aInfo = []
		for j = 1 to Len(aS)
			tOf = aS[j][2]
			tTK = StzuTypeKindOf(aLang, tOf)
			tTarget = ""
			if tTK = "decl" tTarget = LangGet(aLang, "name") end
			if tTK = "sentence"
				for k = 1 to Len(aSents)
					if aSents[k][1] = tOf
						if not IsNull(aSents[k][3]) tTarget = LangGet(aSents[k][3], "name") end
					end
				end
			end
			aInfo + [aS[j][1], tOf, aS[j][3], tTK, tTarget]
		end
		aDeclSeats + [aDecls[i][1], aInfo]
		aVerbOf + [aDecls[i][1], aDecls[i][2]]
	end
	aOne = []
	aEntry = []
	aW = LangGet(aLang, "world")
	if not IsNull(aW)
		aOne = aW[1]
		if Len(aW) >= 4 aEntry = aW[4] end
	end
	# v0.8: the forms, so a condition can read a pair list's keys and values
	aFormTable = []
	aFm = LangGet(aLang, "forms")
	for i = 1 to Len(aFm)
		aFS = aFm[i][2]
		aInfo = []
		for j = 1 to Len(aFS)
			aInfo + [aFS[j][1], aFS[j][2], StzuTypeKindOf(aLang, aFS[j][2])]
		end
		aFormTable + [aFm[i][1], aInfo]
	end
	return [LangGet(aLang, "name"), aDeclSeats, aOne, aViewEntries, aVerbOf, aEntry, aFormTable]
end
func StzuAllowedList(tKind)
	aC = StzuClauses(tKind)
	tOut = ""
	for i = 1 to Len(aC)
		if i > 1 tOut += ", " end
		tOut += aC[i][1]
	end
	return tOut
end
func StzuClauseShape(tKind, tClause)
	aC = StzuClauses(tKind)
	for i = 1 to Len(aC)
		if aC[i][1] = tClause return aC[i][2] end
	end
	return ""
end
# ---- small helpers ----------------------------------------------------------

func InStrList(tS, aL)
	for i = 1 to Len(aL)
		if aL[i] = tS return true end
	end
	return false
end
func StzuJoin(aL, tSep)
	tOut = ""
	for i = 1 to Len(aL)
		if i > 1 tOut += tSep end
		tOut += aL[i]
	end
	return tOut
end
# character classes by byte code, never by string ordering (HF-30)
func IsLowerStart(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or nN = 95
end
func IsLowerChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or nN = 95 or (nN >= 48 and nN <= 57)
end
func IsUpperStart(tC)
	nN = Ascii(tC)
	return (nN >= 65 and nN <= 90)
end
func IsUpperChar(tC)
	nN = Ascii(tC)
	return (nN >= 65 and nN <= 90) or nN = 95 or (nN >= 48 and nN <= 57)
end
func IsDigitChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)
end
func IsUpperSnake(tW)
	if Len(tW) = 0 return false end
	if not IsUpperStart(tW[1]) return false end
	for i = 2 to Len(tW)
		if not IsUpperChar(tW[i]) return false end
	end
	return true
end
# v0.40: the closed catalog of nine (D51) -- the words Harobanda's machine file and stzlib's stzSystemCapabilities already use
func StzuCapabilities
	return ["filesystem", "process", "network", "environment", "dynamic_load", "gpio", "threads", "clock", "inference"]
end
func StzuCapabilityList
	aC = StzuCapabilities()
	tC = ""
	for i = 1 to Len(aC)
		if i > 1 tC += ", " end
		tC += aC[i]
	end
	return tC
end
# v0.40: the words of a MENU, or NULL when the name is not a MENU
func StzuMenuWords(aMenus, tName)
	for i = 1 to Len(aMenus)
		if aMenus[i][1] = tName return aMenus[i][2] end
	end
	return null
end
func StzuFail(nLine, tMsg)
	Raise("haro (line " + String(nLine) + "): " + tMsg)
end
# v0.15: a collecting meta-court. In collect mode a refusal met at one of the declaration loop's
# or a whole-file pass's elements is NOTED and the run goes on to the next element; out of collect
# mode it is raised again, same string, so every earlier verdict is unchanged to the byte. A
# declaration that did not parse is BROKEN: the court resumes at the next DEFINE, and a later
# finding that quotes a broken name says nothing -- it is a consequence, not a second defect.
func StzuNote(tErr)
	if not $bStzuCollect Raise(tErr) end
	tMsg = StzuStripPrefix(tErr)
	if StzuQuotesBroken(tMsg) return end
	$aStzuFound + [StzuLineOf(tErr), tMsg]
end
func StzuStripPrefix(tMsg)
	nN = SubStr(tMsg, "): ")
	if nN > 0 return SubStr(tMsg, nN + 3) end
	return tMsg
end
func StzuLineOf(tMsg)
	nAt = SubStr(tMsg, "(line ")
	if nAt = 0 return 0 end
	nEnd = SubStr(tMsg, "): ")
	if nEnd <= nAt return 0 end
	return Number(SubStr(tMsg, nAt + 6, nEnd - nAt - 6))
end
# a seat typed by a declaration or a FORM whose own seat types did not resolve says nothing of its
# own: what a check would make of it is an echo of the refusal already made. (A seat typed by a
# declaration that did not READ needs no check of its own: that name is not declared, so the
# finding about the seat quotes it and is silenced with the rest of its consequences.)
func StzuSeatsTouchUnresolved(aSeats)
	for i = 1 to Len(aSeats)
		if InStrList(aSeats[i][2], $aStzuUnresolved) return true end
	end
	return false
end
func StzuIsUnresolved(tName)
	for i = 1 to Len($aStzuUnresolved)
		if $aStzuUnresolved[i] = tName return true end
	end
	return false
end
func StzuQuotesBroken(tMsg)
	for i = 1 to Len($aStzuBroken)
		if SubStr(tMsg, "'" + $aStzuBroken[i] + "'") > 0 return true end
	end
	return false
end
# after a declaration failed: when it failed in the PARSE, resume at the next DEFINE, and remember its
# name as broken, so that what quotes it, or is typed by it, says nothing of its own -- those are its
# consequences, not second defects. (Registering the name as declared would also have silenced the
# "resolves to nothing" findings, but no law needed it with the two checks above, so it is not done.)
# A declaration refused AFTER it parsed is already past; a duplicate name is the one refusal that
# leaves the first declaration of that name sound, so it breaks nothing.
func StzuBreak(bParsed, nStart, tErr)
	tName = ""
	if bParsed
		if SubStr(tErr, "is already declared") = 0
			tName = $aStzuLastName
		end
	else
		if nStart + 2 <= Len($aStzuToks)
			if $aStzuToks[nStart + 2][1] = "ident" and $aStzuToks[nStart + 1][1] = "keyword"
				tName = $aStzuToks[nStart + 2][2]
			end
		end
		if $nStzuPos <= nStart $nStzuPos = nStart + 1 end
		while StzuPeek()[1] != "eof"
			aT = StzuPeek()
			if aT[1] = "keyword" and aT[2] = "DEFINE" exit end
			StzuAdvance()
		end
	end
	if tName != "" $aStzuBroken + tName end
end
# the findings in the order of the file, ties in the order they were met
func StzuSortFound(aF)
	aOut = []
	for i = 1 to Len(aF)
		nAt = Len(aOut) + 1
		for j = Len(aOut) to 1 step -1
			if aOut[j][1] > aF[i][1]
				nAt = j
			else
				exit
			end
		end
		Insert(aOut, nAt - 1, aF[i])
	end
	return aOut
end
# ---- tokenizer --------------------------------------------------------------
# a token is [type, value, line]; types: string number ident keyword
# lparen rparen lbracket rbracket comma colon question dot eof

func StzuTokenize(tSrc)
	# v0.30: the one lexer (block_lib.haro) reads the text; the meta-court keeps its own words for what it refuses.
	# A comment is a value of the block and layout to the meta-court
	aToks = BlkTokenize(tSrc)
	aE = BlkLexError(aToks)
	if not IsNull(aE)
		if aE[2] = "unterminated_string"
			StzuFail(aE[3], "Unterminated string")
		elseif aE[2] = "mixed_case"
			StzuFail(aE[3], "'" + aE[4] + "' is neither a lower_snake identifier nor an UPPER_SNAKE keyword")
		elseif aE[2] = "number_glued"
			StzuFail(aE[3], "'" + aE[4] + "' is neither a number nor a word")
		elseif aE[2] = "doubled_quote"
			StzuFail(aE[3], "a doubled quote inside a string waits for C6's amendment (Q-B2): Ringua writes it; today a C6 string has no escape")
		else
			StzuFail(aE[3], "character '" + aE[4] + "' is not part of the stzu grammar")
		end
	end
	return BlkWithoutComments(aToks)
end
# ---- parser -----------------------------------------------------------------

func StzuPeek
	return $aStzuToks[$nStzuPos]
end
func StzuAdvance
	aT = $aStzuToks[$nStzuPos]
	$nStzuPos++
	return aT
end
func StzuExpect(tType, tWhat)
	aT = StzuPeek()
	if aT[1] != tType
		StzuFail(aT[3], "Expected " + tWhat + " but found '" + aT[2] + "'")
	end
	return StzuAdvance()
end
func StzuExpectKeyword(tV)
	aT = StzuPeek()
	if aT[1] != "keyword" or aT[2] != tV
		StzuFail(aT[3], "Expected " + tV + " but found '" + aT[2] + "'")
	end
	StzuAdvance()
end
func StzuParseNameList
	StzuExpect("lbracket", "'['")
	aNames = []
	while StzuPeek()[1] != "rbracket"
		aT = StzuExpect("ident", "an identifier")
		aNames + aT[2]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aNames
end
# a seat is [name, of, isList, optional, line]
func StzuParseSeatList
	StzuExpect("lbracket", "'['")
	aSeats = []
	while StzuPeek()[1] != "rbracket"
		aName = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		bList = false
		tOf = ""
		if StzuPeek()[1] = "lbracket"
			StzuAdvance()
			bList = true
			aOf = StzuExpect("ident", "a seat type")
			tOf = aOf[2]
			StzuExpect("rbracket", "']'")
		else
			aOf = StzuExpect("ident", "a seat type")
			tOf = aOf[2]
		end
		bOpt = false
		if StzuPeek()[1] = "question"
			StzuAdvance()
			bOpt = true
		end
		aSeats + [aName[2], tOf, bList, bOpt, aName[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aSeats
end
# a point is [decl, seat, word, line]: [ decl.seat: word, ... ]
func StzuParsePointList
	StzuExpect("lbracket", "'['")
	aPoints = []
	while StzuPeek()[1] != "rbracket"
		aD = StzuExpect("ident", "a declaration name")
		StzuExpect("dot", "'.'")
		aS = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		aW = StzuExpect("ident", "a word")
		aPoints + [aD[2], aS[2], aW[2], aD[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aPoints
end
# an alternative of a UNION is [type, isList, line]: [ a, [b], ... ]   (v0.3)
func StzuParseTypeList
	StzuExpect("lbracket", "'['")
	aTypes = []
	while StzuPeek()[1] != "rbracket"
		bList = false
		if StzuPeek()[1] = "lbracket"
			StzuAdvance()
			bList = true
			aOf = StzuExpect("ident", "a type")
			StzuExpect("rbracket", "']'")
		else
			aOf = StzuExpect("ident", "a type")
		end
		aTypes + [aOf[2], bList, aOf[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aTypes
end
# a context is [name, [variables], line]: [ seat: [a, b], ... ]   (v0.5)
func StzuParseContextList
	StzuExpect("lbracket", "'['")
	aCtx = []
	while StzuPeek()[1] != "rbracket"
		aN = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		aVars = StzuParseNameList()
		aCtx + [aN[2], aVars, aN[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aCtx
end
# a path is a dotted name as written, with its line: [ seat, ref.seat, ... ]   (v0.6)
func StzuParsePathList
	StzuExpect("lbracket", "'['")
	aPaths = []
	while StzuPeek()[1] != "rbracket"
		aT = StzuExpect("ident", "a seat or a path")
		tP = aT[2]
		while StzuPeek()[1] = "dot"
			StzuAdvance()
			aT2 = StzuExpect("ident", "a seat name after '.'")
			tP += "." + aT2[2]
		end
		aPaths + [tP, aT[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aPaths
end
# v0.32: a rule, between brackets, as the pattern engine reads it (BLOCKS.md 4.3): the tokens between the matching brackets
# rejoined into one line of C6. Comments are layout to the meta-court and go; a rule that holds both quote marks cannot ride in the
# source of a court, so it is refused here
func StzuParseRule
	aT0 = StzuExpect("lbracket", "'[': a rule is written [ ... ]")
	nDepth = 1
	tOut = "["
	tPrevT = "lbracket"
	while nDepth > 0
		aT = StzuPeek()
		if aT[1] = "eof"
			StzuFail(aT0[3], "a rule is not closed: the '[' on line " + String(aT0[3]) + " has no ']'")
		end
		StzuAdvance()
		tT = aT[1]
		tText = aT[2]
		if tT = "string" tText = '"' + aT[2] + '"' end
		if tT = "lbracket" nDepth++ end
		if tT = "rbracket" nDepth-- end
		bTight = tT = "rbracket" or tT = "rparen" or tT = "comma" or tT = "colon" or tT = "question" or tT = "dot" or tPrevT = "lbracket" or tPrevT = "lparen" or tPrevT = "dot"
		if not bTight tOut += " " end
		tOut += tText
		tPrevT = tT
	end
	if SubStr(tOut, '"') > 0 and SubStr(tOut, "'") > 0
		StzuFail(aT0[3], "a rule that holds a double quote and a single quote cannot ride into a court: spell the string without the apostrophe")
	end
	return tOut
end
# v0.32: a seat named as declaration.seat
func StzuParsePath(tClause)
	aT1 = StzuExpect("ident", "a declaration name")
	if tClause = "FIELDS"
		# v0.34: the seat of the kind asked, then the seat of the declaration it refers to
		StzuExpect("dot", "'.' after the seat: FIELDS is written seat.seat")
	else
		StzuExpect("dot", "'.' after the declaration: OVER names a seat as declaration.seat")
	end
	aT2 = StzuExpect("ident", "a seat name after '.'")
	return aT1[2] + "." + aT2[2]
end
# a string list: [ "a", "b", ... ]   (v0.11)
func StzuParseStringList
	StzuExpect("lbracket", "'['")
	aOut = []
	while StzuPeek()[1] != "rbracket"
		aT = StzuExpect("string", "a string")
		aOut + aT[2]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aOut
end
# v0.28: CITES is a list of cites or the word none (HARO-MENU-CITES-01). The word reads as the string
# "none" and a list as a list, so a record tells "cites nothing" from "cites these" without a flag
func StzuParseCiteList
	aT = StzuPeek()
	if aT[1] = "ident"
		StzuAdvance()
		if aT[2] != "none"
			StzuFail(aT[3], "CITES is a list of cites or the word none, not '" + aT[2] + "'")
		end
		return "none"
	end
	return StzuParseStringList()
end
# a pair is [key, word, line]: [ key: word, ... ]   (v0.10)
func StzuParsePairList
	StzuExpect("lbracket", "'['")
	aPairs = []
	while StzuPeek()[1] != "rbracket"
		aK = StzuExpect("ident", "a name")
		StzuExpect("colon", "':'")
		aV = StzuExpect("ident", "a name")
		aPairs + [aK[2], aV[2], aK[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ']' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	return aPairs
end
# a message is [seat, text, line]: [ seat: "text", ... ]   (v0.3)
func StzuParseMessageList
	StzuExpect("lbracket", "'['")
	aMsgs = []
	while StzuPeek()[1] != "rbracket"
		aS = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		aT = StzuExpect("string", "a message string")
		aMsgs + [aS[2], aT[2], aS[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			aNext = StzuPeek()
			StzuFail(aNext[3], "Expected ',' or ']' but found '" + aNext[2] + "'")
		end
	end
	StzuAdvance()
	return aMsgs
end
func ClauseValue(aClauses, tName)
	for i = 1 to Len(aClauses)
		if aClauses[i][1] = tName return aClauses[i][2] end
	end
	return null
end
func HasClause(aClauses, tName)
	for i = 1 to Len(aClauses)
		if aClauses[i][1] = tName return true end
	end
	return false
end
# one DEFINE <KIND> <name> AS ( clauses ) RATIONALE "..."
# returns [kind, name, clauses, rationale, line]
func StzuParseDeclaration
	aT = StzuPeek()
	if aT[1] != "keyword" or aT[2] != "DEFINE"
		StzuFail(aT[3], "Unknown verb '" + aT[2] + "'. The stzu verb set is closed -- a language is declared, never programmed.")
	end
	nDeclLine = aT[3]
	StzuAdvance()
	aKind = StzuPeek()
	if aKind[1] != "keyword" or not StzuIsKind(aKind[2])
		StzuFail(aKind[3], "Unknown declaration 'DEFINE " + aKind[2] + "'. The stzu verb set is closed -- a language is declared, never programmed.")
	end
	tKind = StzuAdvance()[2]
	aName = StzuExpect("ident", "a lower_snake name")
	tName = aName[2]
	StzuExpectKeyword("AS")
	StzuExpect("lparen", "'('")
	aClauses = []
	while StzuPeek()[1] != "rparen"
		aCt = StzuPeek()
		if aCt[1] != "keyword"
			StzuFail(aCt[3], "Expected a clause name but found '" + aCt[2] + "'")
		end
		tShape = StzuClauseShape(tKind, aCt[2])
		if tShape = ""
			StzuFail(aCt[3], "Unknown clause '" + aCt[2] + "' in " + tKind + " -- allowed: " + StzuAllowedList(tKind))
		end
		if HasClause(aClauses, aCt[2])
			StzuFail(aCt[3], "clause " + aCt[2] + " given twice")
		end
		StzuAdvance()
		if tShape = "string"
			aTv = StzuExpect("string", "a string")
			aClauses + [aCt[2], aTv[2]]
		elseif tShape = "namelist"
			aClauses + [aCt[2], StzuParseNameList()]
		elseif tShape = "seatlist"
			aClauses + [aCt[2], StzuParseSeatList()]
		elseif tShape = "number"
			aTv = StzuExpect("number", "a number")
			aClauses + [aCt[2], aTv[2]]
		elseif tShape = "ident"
			aTv = StzuExpect("ident", "a lower_snake name")
			aClauses + [aCt[2], aTv[2]]
		elseif tShape = "typelist"
			aClauses + [aCt[2], StzuParseTypeList()]
		elseif tShape = "messagelist"
			aClauses + [aCt[2], StzuParseMessageList()]
		elseif tShape = "contextlist"
			aClauses + [aCt[2], StzuParseContextList()]
		elseif tShape = "pathlist"
			aClauses + [aCt[2], StzuParsePathList()]
		elseif tShape = "pairlist"
			aClauses + [aCt[2], StzuParsePairList()]
		elseif tShape = "citelist"
			aClauses + [aCt[2], StzuParseCiteList()]
		elseif tShape = "stringlist"
			aClauses + [aCt[2], StzuParseStringList()]
		elseif tShape = "rule"
			aClauses + [aCt[2], StzuParseRule()]
		elseif tShape = "path"
			aClauses + [aCt[2], StzuParsePath(aCt[2])]
		else
			aClauses + [aCt[2], StzuParsePointList()]
		end
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rparen"
			aT = StzuPeek()
			StzuFail(aT[3], "Expected ',' or ')' but found '" + aT[2] + "'")
		end
	end
	StzuAdvance()
	aRt = StzuPeek()
	if aRt[1] != "keyword" or aRt[2] != "RATIONALE"
		StzuFail(aRt[3], "every stzu declaration carries its RATIONALE (the commons, 3.8)")
	end
	StzuAdvance()
	aTr = StzuExpect("string", "the rationale string")
	aReq = StzuRequired(tKind)
	for i = 1 to Len(aReq)
		if not HasClause(aClauses, aReq[i])
			StzuFail(nDeclLine, tKind + " requires the " + aReq[i] + " clause")
		end
	end
	return [tKind, tName, aClauses, aTr[2], nDeclLine]
end
# ---- the language record ------------------------------------------------------
#   name version grammar court extension rationale
#   declarations: [name, verb, seats, rationale, line, names, messages]
#                 (names "" or a MENU/FORMAT; messages [seat, text, line] per reference seat, v0.3)
#   unions:       [name, alternatives, message, line]            (an alternative [type, isList, line], v0.3)
#   forms:        [name, seats, rationale, line]
#   expressions:  [name, operators, operands, aggregates, variables, rationale, line, contexts,
#                  absent, division, equality]
#                 (a context [seat, [variables], line], v0.5; the three semantics words
#                  "" when not declared, v0.6: ABSENT zero|refuse, DIVISION calm|refuse,
#                  EQUALITY kind|value)
#   walks:        [name, of, steps, through, order, guards, compute, formula, fail, line]
#                 (guards a list of [path, line]; compute, formula, fail "" when absent, v0.6)
#   ask:          [name, from kinds, where, clauses, rationale, line] or NULL   (v0.7)
#   run:          [name, [[role, [kind, seat, ...]], ...], rationale, line] or NULL   (v0.9)
#   symbols:      [name, kind, ref, message, line, code, cites]   (a seat type resolved against the world, v0.10; v0.11 code, cites)
#   narrate:      [name, opens, ends, refuses, says [[kind, template, line]], rationale, line, tells] or NULL   (v0.13; tells [[event, template, line]], v0.16)
#   formset:      [name, fluent, passive, statement, params, family, rationale, line] or NULL
#                 (v0.12: params [[key, suffix, line]], family [kind, base seat, forms seat] or [])
#   (v0.11) declarations gain codes [[seat, code, line]] as their eighth element; refusals gain code,
#   codes and cites as their sixth to eighth; menus, ranges, formats, unions and constraints a code last
#                 and world gains publish: [[kind, symbolkind, line], ...] as its fifth element
#   refusals:     [name, message, rationale, line, named]          (named [word, text, line] per trespasser, v0.8)
#   menus:        [name, words, message, line]
#   ranges:       [name, min, max, message, line]
#   formats:      [name, shape, message, line, fold]            (fold "" or "case", v0.4)
#   sentences:    [name, of, language record, message, refused, line]   (v0.4)
#   views:        [name, on, one, named, where, line]            (on "" for the whole sentence, v0.4)
#   constraints:  [name, on, when, then, message, line]        (then "" when absent)
#   (v0.28) menus, ranges, formats and unions gain their cites after their code; a cites value is a list of
#   cites, or the string "none" (CITES none: the refusal cites nothing), on every element that cites
#   world:        [one, first, line, entry] or NULL             (one and entry lists, first "" or a name; entry v0.8)
#   refine:       [points, floors] or NULL                       (lists of [decl, seat, word, line])

func LangGet(aLang, tKey)
	for i = 1 to Len(aLang)
		if aLang[i][1] = tKey return aLang[i][2] end
	end
	return null
end
func DeclaredKind(aDeclared, tName)
	for i = 1 to Len(aDeclared)
		if aDeclared[i][1] = tName return aDeclared[i][2] end
	end
	return ""
end
func StzuDeclare(tSrc)
	$aStzuToks = StzuTokenize(tSrc)
	$nStzuPos = 1
	$aStzuWarnings = []
	$aStzuNotes = []

	if StzuPeek()[1] = "eof"
		StzuFail(1, "an empty file declares nothing -- a .haro file opens with DEFINE LANGUAGE")
	end

	bHaveLang = false
	tLName = "" tLVersion = "" tLGrammar = "" tLCourt = "" tLExtension = "" tLRationale = ""
	# v0.40: the doors the language NEEDS (D51), or NULL when it says nothing -- and what each kind OPENS, [verb, word, by seat]
	aLNeeds = null nLNeedsLine = 0
	aOpensOut = []
	aDeclarations = []
	aForms = []
	aExpressions = []
	aRefusals = []
	aMenus = []
	aRanges = []
	aFormats = []
	aConstraints = []
	aPatterns = []
	aUnions = []
	aSentences = []
	aViews = []
	aWalks = []
	aAsk = null
	aRun = null
	aFormset = null
	aNarrate = null
	aUnderstand = null
	aSymbols = []
	aWorld = null
	aRefine = null
	aConstitution = null
	aDeclared = []
	aVerbs = []
	nCount = 0

	while StzuPeek()[1] != "eof"
		nStart = $nStzuPos
		nCount++
		bParsed = false
		try
			aD = StzuParseDeclaration()
			bParsed = true
			tKind = aD[1] tName = aD[2] aClauses = aD[3] tRationale = aD[4] nLine = aD[5]
			$aStzuLastName = tName
			if nCount = 1 and tKind != "LANGUAGE"
				StzuFail(nLine, "the LANGUAGE declaration comes first")
			end
			if tKind = "LANGUAGE"
				if bHaveLang
					StzuFail(nLine, "a .haro file declares exactly one LANGUAGE")
				end
				bHaveLang = true
				tLName = tName
				tLVersion = ClauseValue(aClauses, "VERSION")
				tLGrammar = ClauseValue(aClauses, "GRAMMAR")
				tLCourt = ClauseValue(aClauses, "COURT")
				tLExtension = ClauseValue(aClauses, "EXTENSION")
				tLRationale = tRationale
				if HasClause(aClauses, "NEEDS")
					aLNeeds = ClauseValue(aClauses, "NEEDS")
					nLNeedsLine = nLine
				end
			elseif tKind = "WORLD"
				if not IsNull(aWorld)
					StzuFail(nLine, "a .haro file declares at most one WORLD")
				end
				aOne = []
				if HasClause(aClauses, "ONE") aOne = ClauseValue(aClauses, "ONE") end
				tFirst = ""
				if HasClause(aClauses, "FIRST") tFirst = ClauseValue(aClauses, "FIRST") end
				# v0.8: the ENTRY kinds -- the first declaration of one of them is
				# where `reachable` starts walking
				aEntry = []
				if HasClause(aClauses, "ENTRY") aEntry = ClauseValue(aClauses, "ENTRY") end
				# v0.10: PUBLISH -- which kinds a sentence contributes to the world,
				# and as which symbol kind
				aPublish = []
				if HasClause(aClauses, "PUBLISH") aPublish = ClauseValue(aClauses, "PUBLISH") end
				aWorld = [aOne, tFirst, nLine, aEntry, aPublish]
			elseif tKind = "REFINE"
				if not IsNull(aRefine)
					StzuFail(nLine, "a .haro file declares at most one REFINE")
				end
				aFloors = []
				if HasClause(aClauses, "FLOOR") aFloors = ClauseValue(aClauses, "FLOOR") end
				aRefine = [ClauseValue(aClauses, "POINTS"), aFloors, nLine]
			elseif tKind = "CONSTITUTION"
				# v0.23: the constitution -- the articles a world declares itself under (charter 2,
				# ratified 2026-11-01); judged once the whole file is read, below
				if not IsNull(aConstitution)
					StzuFail(nLine, "a .haro file declares at most one CONSTITUTION")
				end
				aCWeaves = []
				if HasClause(aClauses, "WEAVES") aCWeaves = ClauseValue(aClauses, "WEAVES") end
				tCRegime = ""
				if HasClause(aClauses, "REGIME") tCRegime = ClauseValue(aClauses, "REGIME") end
				# v0.24: the zone seats of organizational_sovereignty (5): the zone kind, who holds it, what it is entered through
				tCZone = ""
				if HasClause(aClauses, "ZONE") tCZone = ClauseValue(aClauses, "ZONE") end
				tCSov = ""
				if HasClause(aClauses, "SOVEREIGN") tCSov = ClauseValue(aClauses, "SOVEREIGN") end
				tCMov = ""
				if HasClause(aClauses, "MOVEMENT") tCMov = ClauseValue(aClauses, "MOVEMENT") end
				# v0.25: the PERSONAL seats the weaves govern, as paths decl.seat
				aCPersonal = []
				if HasClause(aClauses, "PERSONAL") aCPersonal = ClauseValue(aClauses, "PERSONAL") end
				# v0.27: SAFEGUARDS [ask: consent | anonymisation, voice: redaction] -- what each path out of the world declares
				aCSafe = []
				if HasClause(aClauses, "SAFEGUARDS") aCSafe = ClauseValue(aClauses, "SAFEGUARDS") end
				aConstitution = [tName, ClauseValue(aClauses, "ARTICLES"), aCWeaves, tCRegime, nLine, tRationale, tCZone, tCSov, tCMov, aCPersonal, aCSafe]
			else
				if DeclaredKind(aDeclared, tName) != ""
					StzuFail(nLine, "'" + tName + "' is already declared -- one namespace, one name, one meaning")
				end
				aDeclared + [tName, tKind]
				if tKind = "DECLARATION"
					tVerb = ClauseValue(aClauses, "VERB")
					if not IsUpperSnake(tVerb)
						StzuFail(nLine, "VERB '" + tVerb + "' must be UPPER_SNAKE")
					end
					if InStrList(tVerb, aVerbs)
						StzuFail(nLine, "verb '" + tVerb + "' is already declared")
					end
					aVerbs + tVerb
					tNames = ""
					if HasClause(aClauses, "NAMES") tNames = ClauseValue(aClauses, "NAMES") end
					aMsgs = []
					if HasClause(aClauses, "MESSAGES") aMsgs = ClauseValue(aClauses, "MESSAGES") end
					# v0.11: a code per seat, for the envelope
					aCodes = StzuCodesOf(aClauses, nLine, tName)
					# v0.33: INCLUDES [form, ...] -- the seats of the FORMs come first; resolved after the whole file is read (form_expand.haro)
					aInc = []
					if HasClause(aClauses, "INCLUDES") aInc = ClauseValue(aClauses, "INCLUDES") end
					# v0.35: a severity per reference seat -- judged after the whole file is read, beside MESSAGES
					aSevs = []
					if HasClause(aClauses, "SEVERITIES") aSevs = ClauseValue(aClauses, "SEVERITIES") end
					# v0.40: OPENS -- a capability, or a seat whose MENU lists capabilities; judged after the whole file is read
					tOpens = ""
					if HasClause(aClauses, "OPENS") tOpens = ClauseValue(aClauses, "OPENS") end
					aDeclarations + [tName, tVerb, ClauseValue(aClauses, "SEATS"), tRationale, nLine, tNames, aMsgs, aCodes, aInc, aSevs, tOpens]
				elseif tKind = "FORM"
					aForms + [tName, ClauseValue(aClauses, "SEATS"), tRationale, nLine]
				elseif tKind = "EXPRESSION"
					aOps = ClauseValue(aClauses, "OPERATORS")
					for i = 1 to Len(aOps)
						if not InStrList(aOps[i], StzuOperators())
							StzuFail(nLine, "'" + aOps[i] + "' is not in the closed operator menu -- an escape hatch is unexpressible, not forbidden")
						end
					end
					aOpd = ClauseValue(aClauses, "OPERANDS")
					for i = 1 to Len(aOpd)
						if not InStrList(aOpd[i], StzuOperands())
							StzuFail(nLine, "'" + aOpd[i] + "' is not in the closed operand menu -- an escape hatch is unexpressible, not forbidden")
						end
					end
					aAgg = null
					if HasClause(aClauses, "AGGREGATES")
						aAgg = ClauseValue(aClauses, "AGGREGATES")
						for i = 1 to Len(aAgg)
							if not InStrList(aAgg[i], StzuAggregates())
								StzuFail(nLine, "'" + aAgg[i] + "' is not in the closed aggregate menu")
							end
						end
					end
					aVars = null
					if HasClause(aClauses, "VARIABLES")
						aVars = ClauseValue(aClauses, "VARIABLES")
					end
					# v0.5: the seats a host offers the expression, each with the
					# VARIABLES it admits
					aCtx = []
					if HasClause(aClauses, "CONTEXTS")
						aCtx = ClauseValue(aClauses, "CONTEXTS")
						if IsNull(aVars) StzuFail(nLine, "CONTEXTS requires a VARIABLES clause: a seat is a choice among the variables") end
						for i = 1 to Len(aCtx)
							for j = 1 to i - 1
								if aCtx[j][1] = aCtx[i][1]
									StzuFail(aCtx[i][3], "context '" + aCtx[i][1] + "' is named twice")
								end
							end
							for j = 1 to Len(aCtx[i][2])
								if not InStrList(aCtx[i][2][j], aVars)
									StzuFail(aCtx[i][3], "'" + aCtx[i][2][j] + "' is not a VARIABLE of " + tName + " (its VARIABLES: " + StzuJoin(aVars, ", ") + ")")
								end
							end
						end
					end
					# v0.6: the semantics an evaluator needs, each a closed choice
					tAbsent = ""
					if HasClause(aClauses, "ABSENT")
						tAbsent = ClauseValue(aClauses, "ABSENT")
						if tAbsent != "zero" and tAbsent != "missing" and tAbsent != "refuse"
							StzuFail(nLine, "ABSENT takes zero, missing or refuse: what a reference to nothing reads as; '" + tAbsent + "' is none of them")
						end
					end
					tDivision = ""
					if HasClause(aClauses, "DIVISION")
						tDivision = ClauseValue(aClauses, "DIVISION")
						if tDivision != "calm" and tDivision != "refuse"
							StzuFail(nLine, "DIVISION takes calm or refuse: what a division by zero yields; '" + tDivision + "' is neither")
						end
					end
					tEquality = ""
					if HasClause(aClauses, "EQUALITY")
						tEquality = ClauseValue(aClauses, "EQUALITY")
						if tEquality != "kind" and tEquality != "value"
							StzuFail(nLine, "EQUALITY takes kind or value: whether a number and a text can be equal; '" + tEquality + "' is neither")
						end
					end
					aExpressions + [tName, aOps, aOpd, aAgg, aVars, tRationale, nLine, aCtx, tAbsent, tDivision, tEquality]
				elseif tKind = "REFUSAL"
					if not InStrList(tName, StzuRefusalCategories())
						StzuFail(nLine, "'" + tName + "' is not a refusal category")
					end
					# v0.8: NAMED gives a known trespasser its own message -- an author
					# who writes FLOW or INVOKED_BY is told which law they met
					aNamedMsgs = []
					if HasClause(aClauses, "NAMED")
						aNamedMsgs = ClauseValue(aClauses, "NAMED")
						if tName != "unknown_declaration" and tName != "unknown_seat"
							StzuFail(nLine, "NAMED belongs to unknown_declaration and unknown_seat, the refusals a trespasser meets; '" + tName + "' is neither")
						end
					end
					tRCode = StzuCodeOf(aClauses, nLine, tName)
					aRCodes = StzuCodesOf(aClauses, nLine, tName)
					for i = 1 to Len(aRCodes)
						bNamed = false
						for j = 1 to Len(aNamedMsgs)
							if aNamedMsgs[j][1] = aRCodes[i][1] bNamed = true end
						end
						if not bNamed StzuFail(aRCodes[i][3], "CODES: '" + aRCodes[i][1] + "' is not a NAMED word of " + tName) end
					end
					aRCites = StzuCitesOf(aClauses, nLine, tName)
					# v0.35: a NAMED kind may be a warning -- read past and said. An unknown verb stops the parse, an unknown clause has no
					# declaration to belong to, a dangling reference is the seat's: only unknown_declaration's NAMED words can be read past
					aRSevs = []
					if HasClause(aClauses, "SEVERITIES")
						if tName != "unknown_declaration"
							StzuFail(nLine, "SEVERITIES belongs to unknown_declaration: a NAMED kind can be read past and said; '" + tName + "' cannot be a warning")
						end
						aRSevs = ClauseValue(aClauses, "SEVERITIES")
						StzuWantSeverities(aRSevs, "a NAMED word")
						for i = 1 to Len(aRSevs)
							bNamed = false
							for j = 1 to Len(aNamedMsgs)
								if aNamedMsgs[j][1] = aRSevs[i][1] bNamed = true end
							end
							if not bNamed StzuFail(aRSevs[i][3], "SEVERITIES: '" + aRSevs[i][1] + "' is not a NAMED word of " + tName) end
						end
					end
					aRefusals + [tName, ClauseValue(aClauses, "MESSAGE"), tRationale, nLine, aNamedMsgs, tRCode, aRCodes, aRCites, aRSevs]
				elseif tKind = "MENU"
					aWords = ClauseValue(aClauses, "WORDS")
					if Len(aWords) = 0
						StzuFail(nLine, "a MENU names at least one word")
					end
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					aMenus + [tName, aWords, tMsg, nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName)]
				elseif tKind = "RANGE"
					nMin = Number(ClauseValue(aClauses, "MIN"))
					nMax = Number(ClauseValue(aClauses, "MAX"))
					if nMin > nMax
						StzuFail(nLine, "RANGE " + tName + " has MIN above MAX (" + ClauseValue(aClauses, "MIN") + " > " + ClauseValue(aClauses, "MAX") + ")")
					end
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					aRanges + [tName, ClauseValue(aClauses, "MIN"), ClauseValue(aClauses, "MAX"), tMsg, nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName)]
				elseif tKind = "FORMAT"
					tShape = ClauseValue(aClauses, "SHAPE")
					if not InStrList(tShape, StzuShapes())
						StzuFail(nLine, "'" + tShape + "' is not a shape: the menu is absolute_path, ipv4, cidr, mac, label, domain, hex64, hex64_lower, duration, landmark, deadline")
					end
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					tFold = ""
					if HasClause(aClauses, "FOLD") tFold = ClauseValue(aClauses, "FOLD") end
					if tFold != "" and tFold != "case"
						StzuFail(nLine, "FOLD takes case, the one folding a court knows; '" + tFold + "' is not it")
					end
					aFormats + [tName, tShape, tMsg, nLine, tFold, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName)]
				elseif tKind = "SENTENCE"
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					tRefused = ""
					if HasClause(aClauses, "REFUSED") tRefused = ClauseValue(aClauses, "REFUSED") end
					aSentences + [tName, ClauseValue(aClauses, "OF"), null, tMsg, tRefused, nLine]
				elseif tKind = "VIEW"
					tOn = ""
					if HasClause(aClauses, "ON") tOn = ClauseValue(aClauses, "ON") end
					tNamed = ""
					if HasClause(aClauses, "NAMED") tNamed = ClauseValue(aClauses, "NAMED") end
					tWhere = ""
					if HasClause(aClauses, "WHERE") tWhere = ClauseValue(aClauses, "WHERE") end
					aViews + [tName, tOn, ClauseValue(aClauses, "ONE"), tNamed, tWhere, nLine]
				elseif tKind = "SYMBOL"
					tSKind = ClauseValue(aClauses, "KIND")
					for i = 1 to Len(aSymbols)
						if aSymbols[i][2] = tSKind
							StzuFail(nLine, "SYMBOL " + tName + " already resolves to " + tSKind + " through " + aSymbols[i][1] + ": one name, one meaning")
						end
					end
					tRef = ""
					if HasClause(aClauses, "REF") tRef = ClauseValue(aClauses, "REF") end
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					aSymbols + [tName, tSKind, tRef, tMsg, nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName)]
				elseif tKind = "FORMS"
					# v0.12: a vocabulary's function-name grammar as data (principle 7)
					if not IsNull(aFormset)
						StzuFail(nLine, "a .haro file declares at most one FORMS: a vocabulary spells its families one way (" + aFormset[1] + " is it)")
					end
					tFluent = ""
					if HasClause(aClauses, "FLUENT") tFluent = ClauseValue(aClauses, "FLUENT") end
					tPassive = ""
					if HasClause(aClauses, "PASSIVE") tPassive = ClauseValue(aClauses, "PASSIVE") end
					tStmt = ""
					if HasClause(aClauses, "STATEMENT") tStmt = ClauseValue(aClauses, "STATEMENT") end
					aParams = ClauseValue(aClauses, "PARAMS")
					aSpelt = []
					if tFluent != ""
						StzuWantSuffix(tFluent, nLine, "FLUENT")
						aSpelt + ["FLUENT", tFluent]
					end
					if tPassive != ""
						StzuWantSuffix(tPassive, nLine, "PASSIVE")
						StzuWantOneMeaning(aSpelt, "PASSIVE", tPassive, nLine)
						aSpelt + ["PASSIVE", tPassive]
					end
					if tStmt != ""
						StzuWantSuffix(tStmt, nLine, "STATEMENT")
						StzuWantOneMeaning(aSpelt, "STATEMENT", tStmt, nLine)
						aSpelt + ["STATEMENT", tStmt]
					end
					for i = 1 to Len(aParams)
						if aParams[i][1] = "fluent" or aParams[i][1] = "passive"
							StzuFail(aParams[i][3], "PARAMS: '" + aParams[i][1] + "' is the " + Upper(aParams[i][1]) + " role's own word, not a parameter suffix")
						end
						StzuWantSuffix(aParams[i][2], aParams[i][3], "PARAMS." + aParams[i][1])
						StzuWantOneMeaning(aSpelt, aParams[i][1], aParams[i][2], aParams[i][3])
						aSpelt + [aParams[i][1], aParams[i][2]]
					end
					aFamily = []
					if HasClause(aClauses, "FAMILY")
						aFamily = ClauseValue(aClauses, "FAMILY")
						if Len(aFamily) != 3
							StzuFail(nLine, "FAMILY is [kind, base seat, forms seat]: the declaration kind that declares a family, its base-verb seat and its offered-forms seat")
						end
					end
					aFormset = [tName, tFluent, tPassive, tStmt, aParams, aFamily, tRationale, nLine]
				elseif tKind = "NARRATE"
					# v0.13: how a run of the language is narrated back -- a voice, never stored, never parsed back
					if not IsNull(aNarrate)
						StzuFail(nLine, "a .haro file declares at most one NARRATE: a language has one voice (" + aNarrate[1] + " is it)")
					end
					tOpens = ""
					if HasClause(aClauses, "OPENS") tOpens = ClauseValue(aClauses, "OPENS") end
					tEnds = ""
					if HasClause(aClauses, "ENDS") tEnds = ClauseValue(aClauses, "ENDS") end
					tRefuses = ""
					if HasClause(aClauses, "REFUSES") tRefuses = ClauseValue(aClauses, "REFUSES") end
					# v0.16: a voice SAYS what a sentence is, TELLS what a run did, or both; one that does neither narrates nothing
					if not HasClause(aClauses, "SAYS") and not HasClause(aClauses, "TELLS")
						StzuFail(nLine, "NARRATE requires the SAYS clause or the TELLS clause: a voice that says and tells nothing narrates nothing")
					end
					aSays = []
					if HasClause(aClauses, "SAYS") aSays = ClauseValue(aClauses, "SAYS") end
					aTells = []
					if HasClause(aClauses, "TELLS") aTells = ClauseValue(aClauses, "TELLS") end
					for i = 1 to Len(aSays)
						for j = 1 to i - 1
							if aSays[j][1] = aSays[i][1]
								StzuFail(aSays[i][3], "SAYS: '" + aSays[i][1] + "' is voiced twice")
							end
						end
					end
					for i = 1 to Len(aTells)
						for j = 1 to i - 1
							if aTells[j][1] = aTells[i][1]
								StzuFail(aTells[i][3], "TELLS: '" + aTells[i][1] + "' is told twice")
							end
						end
					end
					aNarrate = [tName, tOpens, tEnds, tRefuses, aSays, tRationale, nLine, aTells]
				elseif tKind = "RUN"
					if not IsNull(aRun)
						StzuFail(nLine, "a .haro file declares at most one RUN: a language runs one way (" + aRun[1] + " is it)")
					end
					aRoles = []
					aRoleNames = ["OF", "COMPUTE", "COLLECT", "GROUP", "BRANCH", "ITERATE"]
					for i = 1 to Len(aRoleNames)
						if HasClause(aClauses, aRoleNames[i]) aRoles + [aRoleNames[i], ClauseValue(aClauses, aRoleNames[i])] end
					end
					aRun = [tName, aRoles, tRationale, nLine]
				elseif tKind = "UNDERSTAND"
					# v0.17: how a human language reaches closed questions -- the kinds that play the eight roles of N
					if not IsNull(aUnderstand)
						StzuFail(nLine, "a .haro file declares at most one UNDERSTAND: a language is understood one way (" + aUnderstand[1] + " is it)")
					end
					aRoles = []
					aRoleNames = ["TONGUE", "MEANING", "ALIAS", "SURFACE", "STEP", "FRAME", "EXAMPLE", "COUNTEREXAMPLE"]
					for i = 1 to Len(aRoleNames)
						aRoles + [aRoleNames[i], ClauseValue(aClauses, aRoleNames[i])]
					end
					aUnderstand = [tName, aRoles, tRationale, nLine]
				elseif tKind = "ASK"
					if not IsNull(aAsk)
						StzuFail(nLine, "a .haro file declares at most one ASK: a language asks in one grammar (" + aAsk[1] + " is it)")
					end
					tWhere = ""
					if HasClause(aClauses, "WHERE") tWhere = ClauseValue(aClauses, "WHERE") end
					aCl = []
					if HasClause(aClauses, "CLAUSES") aCl = ClauseValue(aClauses, "CLAUSES") end
					tAskFields = ""
					if HasClause(aClauses, "FIELDS") tAskFields = ClauseValue(aClauses, "FIELDS") end
					aAsk = [tName, ClauseValue(aClauses, "FROM"), tWhere, aCl, tRationale, nLine, tAskFields]
				elseif tKind = "WALK"
					aGuards = []
					if HasClause(aClauses, "GUARDS") aGuards = ClauseValue(aClauses, "GUARDS") end
					tCompute = ""
					if HasClause(aClauses, "COMPUTE") tCompute = ClauseValue(aClauses, "COMPUTE") end
					tFormula = ""
					if HasClause(aClauses, "FORMULA") tFormula = ClauseValue(aClauses, "FORMULA") end
					tFailSeat = ""
					if HasClause(aClauses, "FAIL") tFailSeat = ClauseValue(aClauses, "FAIL") end
					aWalks + [tName, ClauseValue(aClauses, "OF"), ClauseValue(aClauses, "STEPS"), ClauseValue(aClauses, "THROUGH"),
					          ClauseValue(aClauses, "ORDER"), aGuards, tCompute, tFormula, tFailSeat, nLine]
				elseif tKind = "UNION"
					aAlts = ClauseValue(aClauses, "OF")
					if Len(aAlts) < 2
						StzuFail(nLine, "a UNION names at least two alternatives")
					end
					tMsg = ""
					if HasClause(aClauses, "MESSAGE") tMsg = ClauseValue(aClauses, "MESSAGE") end
					aUnions + [tName, aAlts, tMsg, nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName)]
				elseif tKind = "PATTERN"
					# v0.32: OVER kind.seat, MATCH [rule], SETS [kind.seat: set]; resolved after the whole file is read
					tOver = ClauseValue(aClauses, "OVER")
					nDotAt = SubStr(tOver, ".")
					tPSev = "error"
					if HasClause(aClauses, "SEVERITY") tPSev = ClauseValue(aClauses, "SEVERITY") end
					if tPSev != "error" and tPSev != "warning"
						StzuFail(nLine, "'" + tPSev + "' is not a SEVERITY of a PATTERN: error or warning")
					end
					aPSets = []
					if HasClause(aClauses, "SETS") aPSets = ClauseValue(aClauses, "SETS") end
					aPatterns + [tName, Left(tOver, nDotAt - 1), SubStr(tOver, nDotAt + 1), ClauseValue(aClauses, "MATCH"), aPSets, ClauseValue(aClauses, "MESSAGE"), nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName), tPSev]
				else
					# CONSTRAINT: resolved after the whole file is read
					tThen = ""
					if HasClause(aClauses, "THEN") tThen = ClauseValue(aClauses, "THEN") end
					# v0.23: CITES on a CONSTRAINT -- the pinned instruments the maker's own rule cites (stzzui's S2)
					# v0.25: SEVERITY -- error (the court refuses) or warning (the court speaks it after its verdict); stzzui's S1
					tCnSev = "error"
					if HasClause(aClauses, "SEVERITY") tCnSev = ClauseValue(aClauses, "SEVERITY") end
					if tCnSev != "error" and tCnSev != "warning"
						StzuFail(nLine, "'" + tCnSev + "' is not a SEVERITY of a CONSTRAINT: error or warning")
					end
					# v0.33: EXCEPT [kind, ...] -- the kinds a constraint ON a FORM is not made for (form_expand.haro)
					aCnExc = []
					if HasClause(aClauses, "EXCEPT") aCnExc = ClauseValue(aClauses, "EXCEPT") end
					aConstraints + [tName, ClauseValue(aClauses, "ON"), ClauseValue(aClauses, "WHEN"), tThen, ClauseValue(aClauses, "MESSAGE"), nLine, StzuCodeOf(aClauses, nLine, tName), StzuCitesOf(aClauses, nLine, tName), tCnSev, aCnExc]
				end
			end
		catch
			tErr = cCatchError
			# the first declaration unreadable: there is no language to judge the rest by
			if nCount = 1 Raise(tErr) end
			StzuNote(tErr)
			StzuBreak(bParsed, nStart, tErr)
		end
	end

	# v0.33: INCLUDES, ON a FORM and a quantifier over a FORM are sugar: resolved here, before any pass reads a kind's seats (form_expand.haro)
	aDeclarations = StzuExpandIncludes(aDeclarations, aForms, aDeclared)
	aFormTab = StzuFormTable(aDeclarations)
	aConstraints = StzuExpandConstraints(aConstraints, aFormTab, aDeclarations, aDeclared)
	aViews = StzuExpandViews(aViews, aFormTab, aDeclarations)

	# the resolution pass (order-free; a name resolving to nothing is refused now)
	$aStzuUnions = aUnions
	for i = 1 to Len(aDeclarations)
		try
			StzuResolveSeats(aDeclarations[i][3], aDeclared)
			tNames = aDeclarations[i][6]
			if tNames != ""
				tK = DeclaredKind(aDeclared, tNames)
				if tK = ""
					StzuFail(aDeclarations[i][5], "NAMES '" + tNames + "' resolves to nothing in this declaration")
				end
				if tK != "MENU" and tK != "FORMAT"
					StzuFail(aDeclarations[i][5], "NAMES must name a MENU or a FORMAT; '" + tNames + "' is a " + tK)
				end
			end
		catch
			StzuNote(cCatchError)
			$aStzuUnresolved + aDeclarations[i][1]
		end
	end
	for i = 1 to Len(aForms)
		try
			StzuResolveSeats(aForms[i][2], aDeclared)
		catch
			StzuNote(cCatchError)
			$aStzuUnresolved + aForms[i][1]
		end
	end
	# v0.6: a list of a FORM writes one value an item (a one-seat FORM) or a
	# name: value pair an item (a two-seat FORM whose first seat is a name)
	for i = 1 to Len(aDeclarations)
		try
			if not StzuSeatsTouchUnresolved(aDeclarations[i][3]) StzuCheckListForms(aDeclarations[i][3], aDeclared, aForms) end
		catch
			StzuNote(cCatchError)
		end
	end
	for i = 1 to Len(aForms)
		try
			if not StzuSeatsTouchUnresolved(aForms[i][2]) StzuCheckListForms(aForms[i][2], aDeclared, aForms) end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.3: a UNION's alternatives are value types, told apart by shape
	for i = 1 to Len(aUnions)
		try
			aU = aUnions[i]
			aAlts = aU[2]
			aShapes = []
			for j = 1 to Len(aAlts)
				tShape = StzuAltShape(aAlts[j], aDeclared, aForms, aU[4])
				for k = 1 to Len(aShapes)
					if aShapes[k] = tShape
						# v0.8: two DECLARATIONs share the shape "word" and are told
						# apart by the name's resolution, in one namespace
						if DeclaredKind(aDeclared, aAlts[k][1]) = "DECLARATION" and DeclaredKind(aDeclared, aAlts[j][1]) = "DECLARATION" loop end
						StzuFail(aU[4], "'" + aAlts[k][1] + "' and '" + aAlts[j][1] + "' have the same shape (" + tShape + "): a UNION's alternatives are told apart by shape")
					end
				end
				aShapes + tShape
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.13: a NARRATE voices declared kinds, and fills only placeholders it can fill
	if not IsNull(aNarrate)
		try
			aSays = aNarrate[5]
			for i = 1 to Len(aSays)
				aNK = null
				for j = 1 to Len(aDeclarations)
					if aDeclarations[j][1] = aSays[i][1] aNK = aDeclarations[j] end
				end
				if IsNull(aNK) StzuFail(aSays[i][3], "SAYS: no declaration '" + aSays[i][1] + "' in " + tLName) end
				aOk = ["name", "verb", "rationale", "line"]
				for j = 1 to Len(aNK[3])
					aOk + aNK[3][j][1]
				end
				StzuCheckTemplate(aSays[i][2], aOk, aSays[i][3], "SAYS " + aSays[i][1])
			end
			# v0.16: TELLS names an event of a run or of a question, or a declaration that plays a construct of the RUN
			aTells = aNarrate[8]
			for i = 1 to Len(aTells)
				aOkT = StzuTellPlaceholders(aTells[i][1], aDeclarations, aRun, aAsk, tLName, aTells[i][3])
				StzuCheckTemplate(aTells[i][2], aOkT, aTells[i][3], "TELLS " + aTells[i][1])
			end
			if aNarrate[2] != "" StzuCheckTemplate(aNarrate[2], ["language", "file", "count"], aNarrate[7], "OPENS") end
			if aNarrate[3] != "" StzuCheckTemplate(aNarrate[3], ["language", "file", "count"], aNarrate[7], "ENDS") end
			if aNarrate[4] != "" StzuCheckTemplate(aNarrate[4], ["language", "file", "line", "code", "message", "cites"], aNarrate[7], "REFUSES") end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.12: a FORMS' FAMILY names a declared kind, a scalar base seat and a list forms seat
	if not IsNull(aFormset)
		try
			if Len(aFormset[6]) = 3
				aFam = aFormset[6]
				aFK = null
				for i = 1 to Len(aDeclarations)
					if aDeclarations[i][1] = aFam[1] aFK = aDeclarations[i] end
				end
				if IsNull(aFK) StzuFail(aFormset[8], "FAMILY: no declaration '" + aFam[1] + "'") end
				aBS = StzuSeatNamed(aFK[3], aFam[2])
				if IsNull(aBS) StzuFail(aFormset[8], "FAMILY: no seat '" + aFam[2] + "' on " + aFam[1]) end
				if aBS[3] StzuFail(aFormset[8], "FAMILY: the base seat '" + aFam[2] + "' of " + aFam[1] + " is one verb, not a list") end
				aFS = StzuSeatNamed(aFK[3], aFam[3])
				if IsNull(aFS) StzuFail(aFormset[8], "FAMILY: no seat '" + aFam[3] + "' on " + aFam[1]) end
				if not aFS[3] StzuFail(aFormset[8], "FAMILY: the forms seat '" + aFam[3] + "' of " + aFam[1] + " is a list of the forms offered") end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.11: CODES name seats of the declaration
	for i = 1 to Len(aDeclarations)
		try
			aCd = aDeclarations[i][8]
			for j = 1 to Len(aCd)
				if IsNull(StzuSeatNamed(aDeclarations[i][3], aCd[j][1]))
					StzuFail(aCd[j][3], "CODES: no seat '" + aCd[j][1] + "' on " + aDeclarations[i][1])
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.35: SEVERITIES holds a reference seat at warning: a seat of the kind, named once, error or warning, and a REFERENCE -- only a
	# reference that resolves to nothing may be a warning; a value of the wrong shape never is
	for i = 1 to Len(aDeclarations)
		try
			if Len(aDeclarations[i]) < 10 loop end
			if StzuIsUnresolved(aDeclarations[i][1]) or StzuSeatsTouchUnresolved(aDeclarations[i][3]) loop end
			aSv = aDeclarations[i][10]
			StzuWantSeverities(aSv, "a seat")
			for j = 1 to Len(aSv)
				aSvSeat = StzuSeatNamed(aDeclarations[i][3], aSv[j][1])
				if IsNull(aSvSeat) StzuFail(aSv[j][3], "SEVERITIES: no seat '" + aSv[j][1] + "' on " + aDeclarations[i][1]) end
				if not StzuIsReferenceSeat(aSvSeat, aDeclared, aForms, aUnions)
					StzuFail(aSv[j][3], "SEVERITIES: '" + aSv[j][1] + "' of " + aDeclarations[i][1] + " is not a reference: only a reference that resolves to nothing may be a warning")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.40: NEEDS and OPENS (D51) -- the doors a language's worlds may open. NEEDS names words of the nine, each once; a kind OPENS a
	# capability the LANGUAGE NEEDS, or a seat whose MENU lists capabilities; a kind that OPENS in a language that NEEDS nothing is refused
	# (silence refuses); a NEEDS word no kind can open is refused (least authority) -- a word of an OPENS seat's MENU counts as one a kind
	# can open. A language with neither clause is exactly what it was.
	try
		if not IsNull(aLNeeds)
			for i = 1 to Len(aLNeeds)
				if not InStrList(aLNeeds[i], StzuCapabilities())
					StzuFail(nLNeedsLine, "NEEDS: '" + aLNeeds[i] + "' is not a capability; the nine are " + StzuCapabilityList())
				end
				for j = 1 to i - 1
					if aLNeeds[j] = aLNeeds[i] StzuFail(nLNeedsLine, "NEEDS: '" + aLNeeds[i] + "' is named twice") end
				end
			end
		end
	catch
		StzuNote(cCatchError)
	end
	aOpened = []
	for i = 1 to Len(aDeclarations)
		try
			if Len(aDeclarations[i]) < 11 loop end
			tOp = aDeclarations[i][11]
			if tOp = "" loop end
			tKn = aDeclarations[i][1]
			bBySeat = false
			if InStrList(tOp, StzuCapabilities())
				aCanOpen = [tOp]
			else
				aOs = StzuSeatNamed(aDeclarations[i][3], tOp)
				if IsNull(aOs) StzuFail(aDeclarations[i][5], "OPENS: '" + tOp + "' is neither a capability nor a seat of " + tKn) end
				aCanOpen = StzuMenuWords(aMenus, aOs[2])
				if IsNull(aCanOpen) StzuFail(aDeclarations[i][5], "OPENS: the seat '" + tOp + "' of " + tKn + " is not a MENU of capabilities") end
				for j = 1 to Len(aCanOpen)
					if not InStrList(aCanOpen[j], StzuCapabilities())
						StzuFail(aDeclarations[i][5], "OPENS: the seat '" + tOp + "' of " + tKn + " is a MENU holding '" + aCanOpen[j] + "', which is not a capability")
					end
				end
				bBySeat = true
			end
			if IsNull(aLNeeds)
				StzuFail(aDeclarations[i][5], tKn + " OPENS " + tOp + ", and the LANGUAGE " + tLName + " NEEDS nothing: a door a kind opens is NEEDED first")
			end
			if not bBySeat and not InStrList(tOp, aLNeeds)
				StzuFail(aDeclarations[i][5], tKn + " OPENS " + tOp + ", and the LANGUAGE " + tLName + " does not NEED it")
			end
			for j = 1 to Len(aCanOpen) aOpened + aCanOpen[j] end
			aOpensOut + [aDeclarations[i][2], tOp, bBySeat]
		catch
			StzuNote(cCatchError)
		end
	end
	try
		if not IsNull(aLNeeds)
			for i = 1 to Len(aLNeeds)
				if not InStrList(aLNeeds[i], aOpened) StzuFail(nLNeedsLine, "NEEDS " + aLNeeds[i] + ", and no kind OPENS it") end
			end
		end
	catch
		StzuNote(cCatchError)
	end
	# v0.3: MESSAGES speaks for a reference seat
	for i = 1 to Len(aDeclarations)
		try
			# v0.15: a seat whose type resolved to nothing is not yet a reference seat or a plain one, so what
			# MESSAGES says of it would be an echo of the refusal already made
			if StzuIsUnresolved(aDeclarations[i][1]) or StzuSeatsTouchUnresolved(aDeclarations[i][3]) loop end
			aMsgs = aDeclarations[i][7]
			aSeats = aDeclarations[i][3]
			for j = 1 to Len(aMsgs)
				aFound = null
				for k = 1 to Len(aSeats)
					if aSeats[k][1] = aMsgs[j][1] aFound = aSeats[k] end
				end
				if IsNull(aFound)
					StzuFail(aMsgs[j][3], "MESSAGES: no seat '" + aMsgs[j][1] + "' on " + aDeclarations[i][1])
				end
				bRef = false
				if DeclaredKind(aDeclared, aFound[2]) = "DECLARATION" bRef = true end
				# v0.9: a list of references to several kinds
				if aFound[3] and DeclaredKind(aDeclared, aFound[2]) = "UNION" bRef = true end
				# v0.8: a list of pairs whose keys or values are references
				if aFound[3] and DeclaredKind(aDeclared, aFound[2]) = "FORM"
					for k = 1 to Len(aForms)
						if aForms[k][1] = aFound[2] and StzuIsPairForm(aForms[k][2], aDeclared)
							if StzuPairRefs(aForms[k][2], aDeclared) bRef = true end
						end
					end
				end
				bReq = true
				if aFound[3] or aFound[4] bReq = false end
				if not bRef and not bReq
					StzuFail(aMsgs[j][3], "MESSAGES speaks for a reference seat when its name resolves to nothing, or for a required seat when it is absent; '" + aMsgs[j][1] + "' is neither")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.15: a collecting meta-court judges the RELATIONS among declarations -- sentences, views, constraints,
	# walks, the ask, the run, the points -- only once every declaration reads and every type resolves. A
	# relation between declarations is undefined while one of them is not there to relate: what a view, a
	# constraint or a walk would say of it is an echo of the defect already found, not a second defect.
	# The parser and the checker of RingFlex stand on the same barrier. A run that is not collecting
	# never reaches this line having found anything, so its verdicts are what they were.
	if $bStzuCollect
		if Len($aStzuFound) > 0 return null end
	end

	# v0.4: a SENTENCE names another language's declaration, read beside this
	# one and judged by this same meta-court; its record is kept for the paths
	# that read through it
	for i = 1 to Len(aSentences)
		try
			aS = aSentences[i]
			tPath = aS[2]
			if $tStzuDir != "" tPath = $tStzuDir + "/" + tPath end
			if not FExists(tPath)
				StzuFail(aS[6], "SENTENCE " + aS[1] + ": '" + aS[2] + "' cannot be read from beside this declaration")
			end
			tInnerSrc = Read(tPath)
			aSaveToks = $aStzuToks
			nSavePos = $nStzuPos
			tSaveDir = $tStzuDir
			$tStzuDir = StzuDirOf(tPath)
			tErr = ""
			aInner = null
			bWas = $bStzuCollect
			$bStzuCollect = false
			try
				aInner = StzuDeclare(tInnerSrc)
			catch
				tErr = cCatchError
			end
			$bStzuCollect = bWas
			$aStzuToks = aSaveToks
			$nStzuPos = nSavePos
			$tStzuDir = tSaveDir
			if tErr != ""
				StzuFail(aS[6], "SENTENCE " + aS[1] + ": " + aS[2] + " is refused: " + tErr)
			end
			aSentences[i][3] = aInner
		catch
			StzuNote(cCatchError)
		end
	end

	# menu coherence, both ways
	for i = 1 to Len(aExpressions)
		try
			aE = aExpressions[i]
			bVar = false bAgg = false
			aOpd = aE[3]
			for j = 1 to Len(aOpd)
				if aOpd[j] = "var" bVar = true end
				if aOpd[j] = "agg" bAgg = true end
			end
			if bVar and IsNull(aE[5]) StzuFail(aE[7], "operand 'var' requires a VARIABLES clause") end
			if not IsNull(aE[5]) and not bVar StzuFail(aE[7], "a VARIABLES clause requires operand 'var'") end
			if bAgg and IsNull(aE[4]) StzuFail(aE[7], "operand 'agg' requires an AGGREGATES clause") end
			if not IsNull(aE[4]) and not bAgg StzuFail(aE[7], "an AGGREGATES clause requires operand 'agg'") end
		catch
			StzuNote(cCatchError)
		end
	end

	# the WORLD: ONE and FIRST name declarations
	aOneDecls = []
	if not IsNull(aWorld)
		try
			aOne = aWorld[1]
			for i = 1 to Len(aOne)
				tK = DeclaredKind(aDeclared, aOne[i])
				if tK = "" StzuFail(aWorld[3], "ONE: '" + aOne[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aWorld[3], "ONE must name a DECLARATION; '" + aOne[i] + "' is a " + tK) end
			end
			aOneDecls = aOne
			if aWorld[2] != ""
				tK = DeclaredKind(aDeclared, aWorld[2])
				if tK = "" StzuFail(aWorld[3], "FIRST: '" + aWorld[2] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aWorld[3], "FIRST must name a DECLARATION; '" + aWorld[2] + "' is a " + tK) end
			end
			aEntry = aWorld[4]
			for i = 1 to Len(aEntry)
				tK = DeclaredKind(aDeclared, aEntry[i])
				if tK = "" StzuFail(aWorld[3], "ENTRY: '" + aEntry[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aWorld[3], "ENTRY must name a DECLARATION; '" + aEntry[i] + "' is a " + tK) end
			end
			aPublish = aWorld[5]
			for i = 1 to Len(aPublish)
				tK = DeclaredKind(aDeclared, aPublish[i][1])
				if tK = "" StzuFail(aPublish[i][3], "PUBLISH: '" + aPublish[i][1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aPublish[i][3], "PUBLISH must name a DECLARATION; '" + aPublish[i][1] + "' is a " + tK) end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# the condition tables: this language and the languages its SENTENCEs name
	aRec = [ ["name", tLName], ["version", tLVersion], ["grammar", tLGrammar],
	         ["court", tLCourt], ["extension", tLExtension], ["rationale", tLRationale],
	         ["declarations", aDeclarations], ["forms", aForms],
	         ["expressions", aExpressions], ["refusals", aRefusals],
	         ["menus", aMenus], ["ranges", aRanges], ["formats", aFormats],
	         ["constraints", aConstraints], ["world", aWorld], ["refine", aRefine],
	         ["unions", aUnions], ["sentences", aSentences], ["views", aViews],
	         ["walks", aWalks], ["ask", aAsk], ["run", aRun], ["symbols", aSymbols],
	         ["formset", aFormset], ["narrate", aNarrate], ["understand", aUnderstand],
	         ["constitution", aConstitution], ["patterns", aPatterns],
	         ["needs", aLNeeds], ["opens", aOpensOut] ]
	$tCondLang = tLName
	$aCondLangs = StzuCondLangs(aRec, [])
	$aCondFormats = []
	for i = 1 to Len(aFormats)
		try
			$aCondFormats + [aFormats[i][1], aFormats[i][2]]
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.4: the VIEWs, in order (a VIEW reads the VIEWs declared before it)
	aViewEntries = []
	for i = 1 to Len(aViews)
		try
			aV = aViews[i]
			tOn = aV[2]
			if tOn != ""
				tK = DeclaredKind(aDeclared, tOn)
				if tK = "" StzuFail(aV[6], "ON: '" + tOn + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aV[6], "ON must name a DECLARATION; '" + tOn + "' is a " + tK) end
				if StzuHasSeat(aDeclarations, tOn, aV[1])
					StzuFail(aV[6], "VIEW '" + aV[1] + "' is already a seat of " + tOn + ": one name, one meaning")
				end
			end
			aOut = [null]
			tErr = ""
			tWhy = ""
			try
				tWhy = CondValidateView([aV[1], tOn, aV[3], aV[4], aV[5]], tLName, aOut)
			catch
				tErr = cCatchError
			end
			if tErr != "" StzuFail(aV[6], "VIEW " + aV[1] + ": " + tErr) end
			if tWhy != "" StzuFail(aV[6], "VIEW " + aV[1] + ": " + tWhy) end
			aViewEntries + [aV[1], tOn, aOut[1], aV[3], aV[4], aV[5]]
			$aCondLangs = StzuCondLangs(aRec, aViewEntries)
		catch
			StzuNote(cCatchError)
		end
	end

	# the CONSTRAINTs: ON names a declaration; every name a condition uses exists
	for i = 1 to Len(aConstraints)
		try
			aC = aConstraints[i]
			tK = DeclaredKind(aDeclared, aC[2])
			if tK = "" StzuFail(aC[6], "ON: '" + aC[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(aC[6], "ON must name a DECLARATION; '" + aC[2] + "' is a " + tK) end
			StzuCheckCondition(aC[3], aC[2], aOneDecls, aC[6])
			if aC[4] != ""
				StzuCheckCondition(aC[4], aC[2], aOneDecls, aC[6])
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.32: the PATTERNs. OVER and SETS name seats that exist; a set has one declaration and is neither a MENU nor a kind; the rules, taken
	# together, are judged by the pattern engine's own declaration -- the bound, the names, no recursion -- in its own words
	aSetSeen = []
	for i = 1 to Len(aPatterns)
		try
			aP = aPatterns[i]
			tK = DeclaredKind(aDeclared, aP[2])
			if tK = "" StzuFail(aP[7], "OVER: '" + aP[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(aP[7], "OVER must name a DECLARATION; '" + aP[2] + "' is a " + tK) end
			if IsNull(StzuSeatNamed(StzuSeatsOf(aDeclarations, aP[2]), aP[3]))
				StzuFail(aP[7], "OVER names a seat of " + aP[2] + "; '" + aP[3] + "' is not one")
			end
			aPS = aP[5]
			for j = 1 to Len(aPS)
				tK = DeclaredKind(aDeclared, aPS[j][1])
				if tK = "" StzuFail(aPS[j][4], "SETS: '" + aPS[j][1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(aPS[j][4], "SETS must name a DECLARATION; '" + aPS[j][1] + "' is a " + tK) end
				aSetSeat = StzuSeatNamed(StzuSeatsOf(aDeclarations, aPS[j][1]), aPS[j][2])
				if IsNull(aSetSeat)
					StzuFail(aPS[j][4], "SETS names a seat of " + aPS[j][1] + "; '" + aPS[j][2] + "' is not one")
				end
				if StzuIsPairListSeat(aSetSeat, aDeclared, aForms)
					StzuFail(aPS[j][4], "SETS: '" + aPS[j][1] + "." + aPS[j][2] + "' is a list of pairs; a set draws from words, strings and numbers")
				end
				tSK = DeclaredKind(aDeclared, aPS[j][3])
				if tSK != "" StzuFail(aPS[j][4], "set '" + aPS[j][3] + "' is already a " + tSK + ": one name, one meaning") end
				if InStrList(aPS[j][3], aSetSeen) StzuFail(aPS[j][4], "set '" + aPS[j][3] + "' is declared twice") end
				aSetSeen + aPS[j][3]
			end
		catch
			StzuNote(cCatchError)
		end
	end
	if Len(aPatterns) > 0
		aPN = []
		aPT = []
		aPSN = []
		aPSM = []
		for i = 1 to Len(aPatterns)
			aPN + aPatterns[i][1]
			aPT + aPatterns[i][4]
			for j = 1 to Len(aPatterns[i][5])
				aPSN + aPatterns[i][5][j][3]
				aPSM + []
			end
		end
		for i = 1 to Len(aMenus)
			aPSN + aMenus[i][1]
			aPSM + []
		end
		tPErr = ""
		try
			PatDeclare(aPN, aPT, aPSN, aPSM)
		catch
			tPErr = cCatchError
		end
		if tPErr != ""
			# the engine's words name the pattern first ("pattern NAME: ..." or "pattern NAME is recursive ..."): the finding stands at that pattern's line
			nPL = aPatterns[1][7]
			for i = 1 to Len(aPatterns)
				tHead = "pattern " + aPatterns[i][1]
				if Left(tPErr, Len(tHead) + 1) = tHead + ":" or Left(tPErr, Len(tHead) + 1) = tHead + " " nPL = aPatterns[i][7] end
			end
			try
				StzuFail(nPL, tPErr)
			catch
				StzuNote(cCatchError)
			end
		end
	end

	# v0.6: a WALK names the kind it walks, the kind of its steps, and the seats
	# of a step that carry its walk, its rank, its guards, its computed value
	# and its failure
	for i = 1 to Len(aWalks)
		try
			aW = aWalks[i]
			nL = aW[10]
			for j = 1 to i - 1
				if aWalks[j][2] = aW[2]
					StzuFail(nL, "'" + aW[2] + "' is already walked by " + aWalks[j][1] + ": a kind is walked once")
				end
			end
			tK = DeclaredKind(aDeclared, aW[2])
			if tK = "" StzuFail(nL, "OF: '" + aW[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(nL, "OF must name a DECLARATION; '" + aW[2] + "' is a " + tK) end
			tK = DeclaredKind(aDeclared, aW[3])
			if tK = "" StzuFail(nL, "STEPS: '" + aW[3] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(nL, "STEPS must name a DECLARATION; '" + aW[3] + "' is a " + tK) end
			aStepSeats = StzuSeatsOf(aDeclarations, aW[3])
			aT = StzuSeatNamed(aStepSeats, aW[4])
			if IsNull(aT) or aT[2] != aW[2] or aT[3]
				StzuFail(nL, "THROUGH names a seat of " + aW[3] + " that refers to " + aW[2] + "; '" + aW[4] + "' is not one")
			end
			aO = StzuSeatNamed(aStepSeats, aW[5])
			if IsNull(aO) or aO[3] or not (aO[2] = "number" or DeclaredKind(aDeclared, aO[2]) = "RANGE")
				StzuFail(nL, "ORDER names a number seat of " + aW[3] + "; '" + aW[5] + "' is not one")
			end
			aG = aW[6]
			for j = 1 to Len(aG)
				tP = aG[j][1]
				nDot = SubStr(tP, ".")
				if nDot = 0
					aS = StzuSeatNamed(aStepSeats, tP)
					if IsNull(aS) StzuFail(aG[j][2], "GUARDS: no seat '" + tP + "' on " + aW[3]) end
					if aS[3] or DeclaredKind(aDeclared, aS[2]) != "EXPRESSION"
						StzuFail(aG[j][2], "GUARDS: '" + tP + "' is not an expression seat of " + aW[3])
					end
				else
					tHead = Left(tP, nDot - 1)
					tTail = SubStr(tP, nDot + 1)
					aS = StzuSeatNamed(aStepSeats, tHead)
					if IsNull(aS) StzuFail(aG[j][2], "GUARDS: no seat '" + tHead + "' on " + aW[3]) end
					if aS[3] or DeclaredKind(aDeclared, aS[2]) != "DECLARATION"
						StzuFail(aG[j][2], "GUARDS: '" + tHead + "' is not a reference seat of " + aW[3] + ", so '" + tP + "' reads through nothing")
					end
					aS2 = StzuSeatNamed(StzuSeatsOf(aDeclarations, aS[2]), tTail)
					if IsNull(aS2) or aS2[3] or DeclaredKind(aDeclared, aS2[2]) != "EXPRESSION"
						StzuFail(aG[j][2], "GUARDS: '" + tP + "' is not an expression seat (no expression seat '" + tTail + "' on " + aS[2] + ")")
					end
				end
			end
			if aW[7] != ""
				aS = StzuSeatNamed(aStepSeats, aW[7])
				if IsNull(aS) or aS[3] or not (aS[2] = "name" or aS[2] = "text")
					StzuFail(nL, "COMPUTE names a name or text seat of " + aW[3] + "; '" + aW[7] + "' is not one")
				end
			end
			if aW[8] != ""
				aS = StzuSeatNamed(aStepSeats, aW[8])
				if IsNull(aS) or aS[3] or DeclaredKind(aDeclared, aS[2]) != "EXPRESSION"
					StzuFail(nL, "FORMULA names an expression seat of " + aW[3] + "; '" + aW[8] + "' is not one")
				end
			end
			if (aW[7] = "") != (aW[8] = "")
				StzuFail(nL, "COMPUTE and FORMULA go together: the computed seat and the expression that fills it")
			end
			if aW[9] != ""
				aS = StzuSeatNamed(aStepSeats, aW[9])
				if IsNull(aS) or aS[3] or not (aS[2] = "name" or aS[2] = "text" or DeclaredKind(aDeclared, aS[2]) = "MENU")
					StzuFail(nL, "FAIL names a name, text or MENU seat of " + aW[3] + "; '" + aW[9] + "' is not one")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.7: the ASK names the kinds a question may ask, the expression its
	# condition is written in, and the optional clauses it admits
	if not IsNull(aAsk)
		try
			nL = aAsk[6]
			aFrom = aAsk[2]
			if Len(aFrom) = 0 StzuFail(nL, "FROM names at least one kind a question may ask") end
			for i = 1 to Len(aFrom)
				tK = DeclaredKind(aDeclared, aFrom[i])
				if tK = "" StzuFail(nL, "FROM: '" + aFrom[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, "FROM must name a DECLARATION; '" + aFrom[i] + "' is a " + tK) end
			end
			if aAsk[3] != ""
				tK = DeclaredKind(aDeclared, aAsk[3])
				if tK = "" StzuFail(nL, "WHERE: '" + aAsk[3] + "' resolves to nothing in this declaration") end
				if tK != "EXPRESSION" StzuFail(nL, "WHERE must name an EXPRESSION; '" + aAsk[3] + "' is a " + tK) end
			end
			aCl = aAsk[4]
			for i = 1 to Len(aCl)
				if not InStrList(aCl[i], ["where", "order", "limit"])
					StzuFail(nL, "'" + aCl[i] + "' is not a clause a question admits: where, order, limit")
				end
				for j = 1 to i - 1
					if aCl[j] = aCl[i] StzuFail(nL, "clause '" + aCl[i] + "' is named twice") end
				end
			end
			if InStrList("where", aCl) and aAsk[3] = ""
				StzuFail(nL, "CLAUSES admits where, so WHERE names the expression a condition is written in")
			end
			if aAsk[3] != "" and not InStrList("where", aCl)
				StzuFail(nL, "WHERE names an expression no clause admits: add where to CLAUSES, or drop WHERE")
			end
			# v0.34: FIELDS seat.seat -- where the schema of a kind asked lives: a seat of every kind asked that refers to ONE declaration, and a
			# list of name: type pairs of that declaration. The court then refuses a question that names a field the declaration does not declare
			if aAsk[7] != ""
				nFD = SubStr(aAsk[7], ".")
				tFS1 = Left(aAsk[7], nFD - 1)
				tFS2 = SubStr(aAsk[7], nFD + 1)
				for i = 1 to Len(aFrom)
					aFSeat = StzuSeatNamed(StzuSeatsOf(aDeclarations, aFrom[i]), tFS1)
					if IsNull(aFSeat) StzuFail(nL, "FIELDS: '" + tFS1 + "' is not a seat of " + aFrom[i]) end
					if aFSeat[3] StzuFail(nL, "FIELDS: '" + tFS1 + "' of " + aFrom[i] + " must be one reference to a declaration") end
					if DeclaredKind(aDeclared, aFSeat[2]) != "DECLARATION"
						StzuFail(nL, "FIELDS: '" + tFS1 + "' of " + aFrom[i] + " must refer to a declaration, not to '" + aFSeat[2] + "'")
					end
					aFSeat2 = StzuSeatNamed(StzuSeatsOf(aDeclarations, aFSeat[2]), tFS2)
					if IsNull(aFSeat2) StzuFail(nL, "FIELDS: '" + tFS2 + "' is not a seat of " + aFSeat[2]) end
					if not StzuIsPairListSeat(aFSeat2, aDeclared, aForms)
						StzuFail(nL, "FIELDS: '" + tFS2 + "' of " + aFSeat[2] + " is not a list of name: type pairs")
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.9: the RUN names the kind that runs and the kinds that play the five
	# constructs, each with its seats by role
	if not IsNull(aRun)
		try
			nL = aRun[4]
			aRoles = aRun[2]
			for i = 1 to Len(aRoles)
				tRole = aRoles[i][1]
				aNames = aRoles[i][2]
				aWant = []
				if tRole = "OF" aWant = ["steps", "result"] end
				if tRole = "COMPUTE" or tRole = "COLLECT" aWant = ["into", "value"] end
				if tRole = "GROUP" aWant = ["into", "by", "value"] end
				if tRole = "BRANCH" aWant = ["when", "then", "else"] end
				if tRole = "ITERATE" aWant = ["over", "as", "do"] end
				if Len(aNames) != Len(aWant) + 1
					tN = "two"
					if Len(aWant) = 3 tN = "three" end
					StzuFail(nL, tRole + " names a kind and " + tN + " seats: " + StzuJoin(aWant, ", ") + " -- " + String(Len(aNames)) + " name(s) given")
				end
				tK = DeclaredKind(aDeclared, aNames[1])
				if tK = "" StzuFail(nL, tRole + ": '" + aNames[1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, tRole + " must name a DECLARATION; '" + aNames[1] + "' is a " + tK) end
				aKS = StzuSeatsOf(aDeclarations, aNames[1])
				for j = 1 to Len(aWant)
					tRoleSeat = aWant[j]
					tSeat = aNames[j + 1]
					aS = StzuSeatNamed(aKS, tSeat)
					if IsNull(aS) StzuFail(nL, tRole + ": no seat '" + tSeat + "' on " + aNames[1]) end
					tSK = DeclaredKind(aDeclared, aS[2])
					if tRoleSeat = "value" or tRoleSeat = "when" or tRoleSeat = "by"
						if aS[3] or tSK != "EXPRESSION"
							StzuFail(nL, tRole + ": '" + tSeat + "' is not an expression seat of " + aNames[1])
						end
					elseif tRoleSeat = "into" or tRoleSeat = "over" or tRoleSeat = "as"
						if aS[3] or aS[2] != "name"
							StzuFail(nL, tRole + ": '" + tSeat + "' is not a name seat of " + aNames[1])
						end
					else
						# steps, result, then, else, do: a list seat
						if not aS[3]
							StzuFail(nL, tRole + ": '" + tSeat + "' is not a list seat of " + aNames[1])
						end
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.17: the UNDERSTAND names, for each of the eight roles, the one declaration of this language that plays it,
	# and that declaration has the seats the emitted court reads (no declaration plays two roles)
	if not IsNull(aUnderstand)
		try
			nL = aUnderstand[4]
			aRoles = aUnderstand[2]
			for i = 1 to Len(aRoles)
				tRole = aRoles[i][1]
				aNames = aRoles[i][2]
				aWant = []
				if tRole = "TONGUE" aWant = ["code", "ignores", "allows", "digits", "names", "joins", "refuses"] end
				if tRole = "MEANING" aWant = ["slot", "of", "from", "words"] end
				if tRole = "ALIAS" aWant = ["meaning", "entity", "words"] end
				if tRole = "SURFACE" aWant = ["kind", "grammar", "court", "world", "entities", "spells", "tells"] end
				if tRole = "STEP" aWant = ["target", "query", "binds"] end
				if tRole = "FRAME" aWant = ["shape", "target", "query", "steps", "answers", "empty"] end
				if tRole = "EXAMPLE" aWant = ["means", "asking"] end
				if tRole = "COUNTEREXAMPLE" aWant = ["asking", "refused"] end
				if Len(aNames) != 1
					StzuFail(nL, tRole + " names the one DECLARATION that plays it -- " + String(Len(aNames)) + " name(s) given")
				end
				tK = DeclaredKind(aDeclared, aNames[1])
				if tK = "" StzuFail(nL, tRole + ": '" + aNames[1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, tRole + " must name a DECLARATION; '" + aNames[1] + "' is a " + tK) end
				for j = 1 to i - 1
					if aRoles[j][2][1] = aNames[1]
						StzuFail(nL, tRole + " and " + aRoles[j][1] + " name the same declaration '" + aNames[1] + "': a declaration plays one role")
					end
				end
				for j = 1 to Len(aWant)
					if not StzuHasSeat(aDeclarations, aNames[1], aWant[j])
						StzuFail(nL, tRole + ": no seat '" + aWant[j] + "' on " + aNames[1] + " -- the court of this language reads it")
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# the REFINE: every point is a seat of a declaration; kinds and floors are closed
	if not IsNull(aRefine)
		try
			aPoints = aRefine[1]
			for i = 1 to Len(aPoints)
				aP = aPoints[i]
				if not StzuHasSeat(aDeclarations, aP[1], aP[2])
					StzuFail(aP[4], "no such point '" + aP[1] + "." + aP[2] + "': a point is a seat of a declaration of this language")
				end
				if not InStrList(aP[3], StzuRefinementKinds())
					StzuFail(aP[4], "'" + aP[3] + "' is not a refinement kind: knob, field, symbol, policy, composite or pipeline")
				end
			end
			aFloors = aRefine[2]
			for i = 1 to Len(aFloors)
				aF = aFloors[i]
				if not InStrList(aF[3], StzuPostures())
					StzuFail(aF[4], "'" + aF[3] + "' is not a posture: trusted, external, sandboxed or llm")
				end
				bPoint = false
				for j = 1 to Len(aPoints)
					if aPoints[j][1] = aF[1] and aPoints[j][2] = aF[2] bPoint = true end
				end
				if not bPoint
					StzuFail(aF[4], "'" + aF[1] + "." + aF[2] + "' is not a declared point: a FLOOR stands on a POINT")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.23: the CONSTITUTION (charter 2, ratified 2026-11-01). Each article is one of Zin's six,
	# named once. The four Haro judges are judged THROUGH the mechanisms the charter names and never
	# reimplemented, in ARTICLES' order: explainability (1) through RATIONALE, the C2 envelope and the
	# NARRATE -- a NARRATE is declared and every REFUSAL and CONSTRAINT carries a CODE; reversibility
	# (2) through refinement -- a REFINE is declared; predictable_authority (4) through the gate's
	# governance stage -- no policy point is floored llm; trust_hierarchy (6) through the trust
	# posture -- every point has a FLOOR. v0.24 (ZC3): visible_state (3) through the three access paths a
	# language declares -- every declaration kind is told (NARRATE SAYS), asked (ASK FROM) or published
	# (WORLD PUBLISH); organizational_sovereignty (5) through the zones a world declares -- the
	# CONSTITUTION names the ZONE kind, its SOVEREIGN seat (a MENU word or a text, never optional) and its
	# MOVEMENT seat (a declared kind, never optional). WEAVES and REGIME are carried, their words closed,
	# and refused by name (ZC4).
	if not IsNull(aConstitution)
		try
			nCL = aConstitution[5]
			aArts = aConstitution[2]
			if Len(aArts) = 0
				StzuFail(nCL, "ARTICLES names no article: a constitution is under at least one")
			end
			for i = 1 to Len(aArts)
				if not InStrList(aArts[i], StzuArticles())
					StzuFail(nCL, "'" + aArts[i] + "' is not an article: explainability (1), reversibility (2), visible_state (3), predictable_authority (4), organizational_sovereignty (5) or trust_hierarchy (6)")
				end
				for j = 1 to i - 1
					if aArts[j] = aArts[i]
						StzuFail(nCL, "'" + aArts[i] + "' is named twice in ARTICLES: a world is under an article once")
					end
				end
			end
			aWv = aConstitution[3]
			for i = 1 to Len(aWv)
				if not InStrList(aWv[i][1], StzuWeaves())
					StzuFail(aWv[i][3], "'" + aWv[i][1] + "' is not a weave: resilience (W1), observability (W2), sovereignty (W3), privacy (W4), temporal_integrity (W5), cost_awareness (W6), learnability (W7) or structural_integrity (W8)")
				end
				if not InStrList(aWv[i][2], StzuSeverities())
					StzuFail(aWv[i][3], "'" + aWv[i][2] + "' is not a severity: constitutional, governance or advisory")
				end
			end
			# v0.25: sovereignty (W3) and privacy (W4) are judged below. v0.29 (WC1): so are the rules of the six carried weaves that need no
			# new seat (StzuWeaveRules); a weave none of whose rules is judged or held is carried, and refused by name
			for i = 1 to Len(aWv)
				if aWv[i][1] != "sovereignty" and aWv[i][1] != "privacy"
					aWR = StzuWeaveRules(aWv[i][1])
					if Len(aWR[1]) + Len(aWR[2]) = 0
						StzuFail(aWv[i][3], "WEAVES names '" + String(aWv[i][1]) + "', and none of its " + String(Len(aWR[3])) + " rules is judged in Haro v0.29 -- they are Zin's design, carried, not built")
					end
				end
			end
			# v0.25: the PERSONAL seats: each a seat of a declared kind, and the weaves' to govern
			aPers = aConstitution[10]
			aMarks = []
			for i = 1 to Len(aPers)
				tPP = aPers[i][1]
				nPD = SubStr(tPP, ".")
				tPDecl = ""
				tPSeat = ""
				tPSub = ""
				if nPD > 0
					tPDecl = Left(tPP, nPD - 1)
					tPSeat = SubStr(tPP, nPD + 1)
					# v0.27: a three-part path decl.seat.mark names the form seat that marks a field
					nPS = SubStr(tPSeat, ".")
					if nPS > 0
						tPSub = SubStr(tPSeat, nPS + 1)
						tPSeat = Left(tPSeat, nPS - 1)
					end
				end
				if nPD = 0 or DeclaredKind(aDeclared, tPDecl) != "DECLARATION"
					StzuFail(aPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "' is not a declaration kind")
				end
				if not StzuHasSeat(aDeclarations, tPDecl, tPSeat)
					StzuFail(aPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "' has no seat '" + tPSeat + "'")
				end
				if tPSub != ""
					aMS = StzuSeatRec(aDeclarations, tPDecl, tPSeat)
					aMF = null
					if aMS[3] aMF = StzuFormRec(aForms, aMS[2]) end
					if IsNull(aMF) or not StzuIsPairForm(aMF[2], aDeclared)
						StzuFail(aPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "." + tPSeat + "' is not a list of a pair form -- a mark lives on a form's seat")
					end
					aTS = null
					for j = 1 to Len(aMF[2])
						if aMF[2][j][1] = tPSub aTS = aMF[2][j] end
					end
					if IsNull(aTS)
						StzuFail(aPers[i][2], "PERSONAL names '" + tPP + "', and the form '" + aMF[1] + "' of '" + tPDecl + "." + tPSeat + "' has no seat '" + tPSub + "'")
					end
					aTM = StzuMenuRec(aMenus, aTS[2])
					if IsNull(aTM) or not InStrList("personal", aTM[2])
						StzuFail(aPers[i][2], "PERSONAL names '" + tPP + "' as a mark, and the MENU '" + aTS[2] + "' has no word 'personal' -- a mark seat is a MENU that can say personal")
					end
					aMarks + [tPP, aPers[i][2]]
				end
			end
			# v0.27: the safeguards -- a path (ask, voice) and the word it declares: stzFieldTags' five words, each on its path
			aSafe = aConstitution[11]
			tSafeAsk = ""
			tSafeVoice = ""
			for i = 1 to Len(aSafe)
				tSP = aSafe[i][1]
				tSW = aSafe[i][2]
				if not InStrList(tSW, ["consent", "anonymisation", "retention", "redaction", "on_premise"])
					StzuFail(aSafe[i][3], "'" + tSW + "' is not a safeguard: consent, anonymisation, retention, redaction or on_premise")
				end
				if tSP = "ask"
					if not InStrList(tSW, ["consent", "anonymisation"])
						StzuFail(aSafe[i][3], "'" + tSW + "' is not a safeguard of the ask path: consent or anonymisation")
					end
					tSafeAsk = tSW
				elseif tSP = "voice"
					if tSW != "redaction"
						StzuFail(aSafe[i][3], "'" + tSW + "' is not a safeguard of the voice path: redaction")
					end
					tSafeVoice = tSW
				else
					StzuFail(aSafe[i][3], "'" + tSP + "' is not a path Haro's weaves govern here: ask or voice -- the model path is stzlib's and HaroBase's (D35)")
				end
			end
			tSevPrivacy = ""
			tSevSovereignty = ""
			for i = 1 to Len(aWv)
				if aWv[i][1] = "privacy" tSevPrivacy = aWv[i][2] end
				if aWv[i][1] = "sovereignty" tSevSovereignty = aWv[i][2] end
			end
			if Len(aPers) > 0 and tSevPrivacy = "" and tSevSovereignty = ""
				StzuFail(nCL, "PERSONAL is named and neither privacy (W4) nor sovereignty (W3) is among WEAVES -- the personal seats are the weaves' to govern")
			end
			if Len(aSafe) > 0 and tSevPrivacy = ""
				StzuFail(nCL, "SAFEGUARDS is named and privacy (W4) is not among WEAVES -- a safeguard is a weave's escape")
			end
			# v0.25: a regime is read by the weaves' refusals; without a weave it is accepted by nothing
			if aConstitution[4] != "" and Len(aWv) = 0
				StzuFail(nCL, "REGIME is named and no weave is among WEAVES -- a regime is read by the weaves' refusals")
			end
			# v0.24: the zone seats are the sovereignty article's; named without it they are refused, not accepted by silence
			if aConstitution[7] != "" or aConstitution[8] != "" or aConstitution[9] != ""
				if not InStrList("organizational_sovereignty", aArts)
					StzuFail(nCL, "ZONE is named and organizational_sovereignty is not among ARTICLES -- the zone seats are the sovereignty article's")
				end
			end
			for i = 1 to Len(aArts)
				tArt = aArts[i]
				if tArt = "explainability"
					if IsNull(aNarrate)
						StzuFail(nCL, "Art. 1 explainability: '" + tLName + "' declares no NARRATE -- a world under explainability tells every run and every refusal in its own voice")
					end
					for j = 1 to Len(aRefusals)
						if aRefusals[j][6] = ""
							StzuFail(aRefusals[j][4], "Art. 1 explainability: REFUSAL '" + aRefusals[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
					for j = 1 to Len(aConstraints)
						if aConstraints[j][7] = ""
							StzuFail(aConstraints[j][6], "Art. 1 explainability: CONSTRAINT '" + aConstraints[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
					# v0.32: a PATTERN refuses as a CONSTRAINT does, so it is traceable the same way
					for j = 1 to Len(aPatterns)
						if aPatterns[j][8] = ""
							StzuFail(aPatterns[j][7], "Art. 1 explainability: PATTERN '" + aPatterns[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
				elseif tArt = "reversibility"
					if IsNull(aRefine)
						StzuFail(nCL, "Art. 2 reversibility: '" + tLName + "' declares no REFINE -- a world under reversibility changes only by refinement, whose inverse is computed before it lands and whose revert is an event (charter 6.5)")
					end
				elseif tArt = "visible_state"
					# v0.24: every declaration kind is reached by a declared path -- told, asked or published
					for j = 1 to Len(aDeclarations)
						tVK = aDeclarations[j][1]
						bReached = false
						if not IsNull(aNarrate)
							for k = 1 to Len(aNarrate[5])
								if aNarrate[5][k][1] = tVK bReached = true end
							end
						end
						if not IsNull(aAsk)
							if InStrList(tVK, aAsk[2]) bReached = true end
						end
						if not IsNull(aWorld)
							if Len(aWorld) >= 5
								for k = 1 to Len(aWorld[5])
									if aWorld[5][k][1] = tVK bReached = true end
								end
							end
						end
						if not bReached
							StzuFail(aDeclarations[j][5], "Art. 3 visible_state: kind '" + tVK + "' is reached by no declared path -- not told (NARRATE SAYS), not asked (ASK FROM), not published (WORLD PUBLISH): a state nothing can read is hidden")
						end
					end
				elseif tArt = "predictable_authority"
					if not IsNull(aRefine)
						aPts = aRefine[1]
						aFls = aRefine[2]
						for j = 1 to Len(aPts)
							if aPts[j][3] = "policy"
								for k = 1 to Len(aFls)
									if aFls[k][1] = aPts[j][1] and aFls[k][2] = aPts[j][2] and aFls[k][3] = "llm"
										StzuFail(aFls[k][4], "Art. 4 predictable_authority: policy point '" + aPts[j][1] + "." + aPts[j][2] + "' has FLOOR llm -- a rule is refined by no model-composed proposal, by construction (charter 6.4)")
									end
								end
							end
						end
					end
				elseif tArt = "organizational_sovereignty"
					# v0.24: the world names its zone kind, who holds a zone (never optional; a MENU word or a
					# text) and what a zone is entered through (never optional; a declared kind, the flow)
					tZ = aConstitution[7]
					tSv = aConstitution[8]
					tMv = aConstitution[9]
					if tZ = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: '" + tLName + "' names no ZONE -- a world under sovereignty says which of its kinds holds its data (ZONE), who holds each (SOVEREIGN) and through which declared flow a record enters it (MOVEMENT)")
					end
					if DeclaredKind(aDeclared, tZ) != "DECLARATION"
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' is not a declaration kind of '" + tLName + "'")
					end
					if tSv = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' has no SOVEREIGN seat named -- a zone is held by someone, never by silence")
					end
					aSS = StzuSeatRec(aDeclarations, tZ, tSv)
					if IsNull(aSS)
						StzuFail(nCL, "Art. 5 organizational_sovereignty: SOVEREIGN '" + tSv + "' is not a seat of '" + tZ + "'")
					end
					if aSS[4]
						StzuFail(aSS[5], "Art. 5 organizational_sovereignty: SOVEREIGN seat '" + tSv + "' of '" + tZ + "' is optional -- a zone's holder is never silent")
					end
					if aSS[2] != "text" and DeclaredKind(aDeclared, aSS[2]) != "MENU"
						StzuFail(aSS[5], "Art. 5 organizational_sovereignty: SOVEREIGN seat '" + tSv + "' of '" + tZ + "' is typed '" + aSS[2] + "' -- a holder is a word of a MENU of organizations, or a text")
					end
					if tMv = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' has no MOVEMENT seat named -- a record enters a zone through a declared flow, or not at all")
					end
					aMS = StzuSeatRec(aDeclarations, tZ, tMv)
					if IsNull(aMS)
						StzuFail(nCL, "Art. 5 organizational_sovereignty: MOVEMENT '" + tMv + "' is not a seat of '" + tZ + "'")
					end
					if aMS[4]
						StzuFail(aMS[5], "Art. 5 organizational_sovereignty: MOVEMENT seat '" + tMv + "' of '" + tZ + "' is optional -- an entry that may be silent is ungoverned")
					end
					if DeclaredKind(aDeclared, aMS[2]) != "DECLARATION"
						StzuFail(aMS[5], "Art. 5 organizational_sovereignty: MOVEMENT seat '" + tMv + "' of '" + tZ + "' is typed '" + aMS[2] + "' -- it names a declared kind, the flow a record walks in")
					end
				elseif tArt = "trust_hierarchy"
					if not IsNull(aRefine)
						aPts = aRefine[1]
						aFls = aRefine[2]
						for j = 1 to Len(aPts)
							bFl = false
							for k = 1 to Len(aFls)
								if aFls[k][1] = aPts[j][1] and aFls[k][2] = aPts[j][2] bFl = true end
							end
							if not bFl
								StzuFail(aPts[j][4], "Art. 6 trust_hierarchy: point '" + aPts[j][1] + "." + aPts[j][2] + "' has no FLOOR -- a trust requirement is declared, never implied: silence refuses")
							end
						end
					end
				end
			end
			# v0.25: the weaves over the PERSONAL seats, at the declared severity, the regime named.
			# Three paths a language declares: the voice (W4.4, a log), the ask (W4.2, analytics),
			# the published world (W3.1, a movement out of its zone); the model path is stzlib's and
			# HaroBase's, the same rung.
			tRg = aConstitution[4]
			for i = 1 to Len(aPers)
				tPP = aPers[i][1]
				nPD = SubStr(tPP, ".")
				tPDecl = Left(tPP, nPD - 1)
				tPSeat = SubStr(tPP, nPD + 1)
				# v0.27: a mark path (decl.seat.mark) is judged below, on the paths records take; a published schema moves no datum
				if SubStr(tPSeat, ".") > 0 loop end
				if tSevPrivacy != ""
					if not IsNull(aNarrate)
						for k = 1 to Len(aNarrate[5])
							if aNarrate[5][k][1] = tPDecl
								if SubStr(aNarrate[5][k][2], "{" + tPSeat + "}") > 0
									StzuWeave(tSevPrivacy, aNarrate[5][k][3], "W4.4 privacy: personal seat '" + tPP + "' is told by the voice -- a log carries no personal datum unredacted" + StzuRegimeTail(tRg, "W4.4"))
								end
							end
						end
					end
					if not IsNull(aAsk)
						if InStrList(tPDecl, aAsk[2])
							StzuWeave(tSevPrivacy, aAsk[6], "W4.2 privacy: kind '" + tPDecl + "' holds the personal seat '" + tPSeat + "' and is asked (ASK FROM) -- usage over personal data is analytics, which needs consent" + StzuRegimeTail(tRg, "W4.2"))
						end
					end
				end
				if tSevSovereignty != ""
					if not IsNull(aWorld)
						if Len(aWorld) >= 5
							for k = 1 to Len(aWorld[5])
								if aWorld[5][k][1] = tPDecl
									StzuWeave(tSevSovereignty, aWorld[5][k][3], "W3.1 sovereignty: kind '" + tPDecl + "' holds the personal seat '" + tPSeat + "' and is published to the world -- personal data stays in its declared zone" + StzuRegimeTail(tRg, "W3.1"))
								end
							end
						end
					end
				end
			end
			# v0.27: the weaves over the marks, on the two paths records take out of the world: the ask (W4.2) needs
			# consent or anonymisation, the voice telling rows (W4.4) needs redaction; the court applies what it can
			if tSevPrivacy != ""
				for i = 1 to Len(aMarks)
					if not IsNull(aAsk) and tSafeAsk = ""
						StzuWeave(tSevPrivacy, aAsk[6], "W4.2 privacy: the fields marked by '" + aMarks[i][1] + "' may be asked (ASK " + aAsk[1] + ") and no safeguard is declared for the ask path -- usage over personal data is analytics, which needs consent or anonymisation" + StzuRegimeTail(tRg, "W4.2"))
					end
					if not IsNull(aNarrate) and tSafeVoice = ""
						aTls = aNarrate[8]
						for k = 1 to Len(aTls)
							if SubStr(aTls[k][2], "{rows}") > 0
								StzuWeave(tSevPrivacy, aTls[k][3], "W4.4 privacy: the fields marked by '" + aMarks[i][1] + "' are told by the voice ('" + aTls[k][1] + "' tells {rows}) and no redaction is declared for the voice path -- a log carries no personal datum unredacted" + StzuRegimeTail(tRg, "W4.4"))
							end
						end
					end
				end
			end
			# v0.29 (WC1): the six carried weaves, as far as the court judges them with no new seat. Each rule is an article's condition read at
			# the WEAVE's severity (ZIN-WEAVES-INVENTORY.md): where the world stands under the article, the article's own refusal came first
			# above, constitutional, and the weave does not say it twice. W1.2 and W7.1 hold by construction and judge nothing.
			aAn = StzuArticles()
			for i = 1 to Len(aWv)
				tWN = aWv[i][1]
				tWS = aWv[i][2]
				if tWN = "resilience"
					# W1.5: a degradation preserves the invariants -- a CONSTRAINT held at warning that cites an article the world stands under
					for j = 1 to Len(aConstraints)
						if aConstraints[j][9] = "warning" and IsList(aConstraints[j][8])
							aCts = aConstraints[j][8]
							for k = 1 to Len(aCts)
								nCA = StzuCitedArticle(aCts[k])
								if nCA > 0
									if InStrList(aAn[nCA], aArts)
										StzuWeave(tWS, aConstraints[j][6], "W1.5 resilience: CONSTRAINT '" + aConstraints[j][1] + "' is SEVERITY warning and cites " + aCts[k] + ", and the world stands under " + aAn[nCA] + " -- a degradation must not pass a law the world declares" + StzuArtTail(nCA))
									end
								end
							end
						end
					end
				end
				if tWN = "observability"
					# W2.2 and W2.3: a model's proposal and a gate's denial are traced by the audit chain, which is Art. 3's
					if not IsNull(aRefine) and not InStrList("visible_state", aArts)
						aFlO = aRefine[2]
						for j = 1 to Len(aFlO)
							if aFlO[j][3] = "llm"
								StzuWeave(tWS, aFlO[j][4], "W2.2 observability: point '" + aFlO[j][1] + "." + aFlO[j][2] + "' has FLOOR llm -- a model may propose it -- and visible_state is not among ARTICLES: no chain keeps the model's proposal or its refusal" + StzuArtTail(3))
							end
						end
						StzuWeave(tWS, aRefine[3], "W2.3 observability: '" + tLName + "' declares a REFINE, whose gate denies, and visible_state is not among ARTICLES: a denial enters no audit chain" + StzuArtTail(3))
					end
				end
				if tWN = "temporal_integrity"
					# W5.2: the changes of points that have a history are versioned by the numbered chain, which is Art. 3's
					if not IsNull(aRefine) and not InStrList("visible_state", aArts)
						StzuWeave(tWS, aRefine[3], "W5.2 temporal_integrity: '" + tLName + "' declares a REFINE, which changes points that have a history, and visible_state is not among ARTICLES: no numbered chain versions the changes" + StzuArtTail(3))
					end
				end
				if tWN = "learnability"
					# W7.4: a denial is explained -- told by a voice and met by a stable identifier, Art. 1's two conditions
					nDen = Len(aRefusals) + Len(aConstraints)
					if nDen > 0 and IsNull(aNarrate)
						nDL = aConstraints[1][6]
						if Len(aRefusals) > 0
							nDL = aRefusals[1][4]
						end
						StzuWeave(tWS, nDL, "W7.4 learnability: '" + tLName + "' declares " + String(nDen) + " denial(s) (CONSTRAINT or REFUSAL) and no NARRATE -- a denial no voice tells is not explained" + StzuArtTail(1))
					end
					for j = 1 to Len(aRefusals)
						if aRefusals[j][6] = ""
							StzuWeave(tWS, aRefusals[j][4], "W7.4 learnability: REFUSAL '" + aRefusals[j][1] + "' carries no CODE -- a denial is explained to its reader by a stable identifier (C2 2.1)" + StzuArtTail(1))
						end
					end
					for j = 1 to Len(aConstraints)
						if aConstraints[j][7] = ""
							StzuWeave(tWS, aConstraints[j][6], "W7.4 learnability: CONSTRAINT '" + aConstraints[j][1] + "' carries no CODE -- a denial is explained to its reader by a stable identifier (C2 2.1)" + StzuArtTail(1))
						end
					end
				end
				if tWN = "structural_integrity"
					# W8.5: synthesis never overrides what the court proved -- a policy point a model may propose, Art. 4's condition
					if not IsNull(aRefine)
						aPts = aRefine[1]
						aFls = aRefine[2]
						for j = 1 to Len(aPts)
							if aPts[j][3] = "policy"
								for k = 1 to Len(aFls)
									if aFls[k][1] = aPts[j][1] and aFls[k][2] = aPts[j][2] and aFls[k][3] = "llm"
										StzuWeave(tWS, aFls[k][4], "W8.5 structural_integrity: policy point '" + aPts[j][1] + "." + aPts[j][2] + "' has FLOOR llm -- a model-composed proposal could replace a rule the court proved" + StzuArtTail(4))
									end
								end
							end
						end
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	return aRec
end
# v0.29 (WC1): the rules of the six carried weaves, as the court judges them -- [judged, held by construction, carried]. Judged: a
# refusal exists at the weave's severity. Held: nothing can fail (W1.2: the gate writes a change's inverse before the change lands;
# W7.1: a declaration without a RATIONALE is refused whatever the weaves say). Carried: Zin's design, not judged. The rule ids are
# Zin's (ZIN_CONSTITUTIONAL_WEAVES.md); a weave with no rule judged or held is refused by name
func StzuWeaveRules(tWeave)
	if tWeave = "resilience"
		return [["W1.5"], ["W1.2"], ["W1.1", "W1.3", "W1.4", "W1.6", "W1.7"]]
	elseif tWeave = "observability"
		return [["W2.2", "W2.3"], [], ["W2.1", "W2.4", "W2.5", "W2.6"]]
	elseif tWeave = "temporal_integrity"
		return [["W5.2"], [], ["W5.1", "W5.3", "W5.4", "W5.5"]]
	elseif tWeave = "cost_awareness"
		return [[], [], ["W6.1", "W6.2", "W6.3", "W6.4", "W6.5", "W6.6", "W6.7", "W6.8", "W6.9", "W6.10", "W6.11", "W6.12", "W6.13"]]
	elseif tWeave = "learnability"
		return [["W7.4"], ["W7.1"], ["W7.2", "W7.3", "W7.5", "W7.6"]]
	elseif tWeave = "structural_integrity"
		return [["W8.5"], [], ["W8.1", "W8.2", "W8.3", "W8.4"]]
	end
	return [[], [], []]
end
# the number of the article a cite names, `article:3` or `article:visible_state`, and 0 for any other cite
func StzuCitedArticle(tCite)
	if Left(tCite, 8) != "article:" return 0 end
	tV = SubStr(tCite, 9)
	aAn = StzuArticles()
	for i = 1 to Len(aAn)
		if tV = aAn[i] or tV = String(i) return i end
	end
	return 0
end
# the article a weave refusal serves, in the form the articles' own refusals use
func StzuArtTail(nArt)
	aAn = StzuArticles()
	return " [Art. " + String(nArt) + " " + String(aAn[nArt]) + "]"
end
# a comma-joined list with more words added to it
func StzuAppendWords(tList, aWords)
	for i = 1 to Len(aWords)
		if tList != "" tList += "," end
		tList += aWords[i]
	end
	return tList
end
# v0.25: a weave's verdict at its declared severity -- constitutional refuses, governance warns,
# advisory notes; the warnings and notes are printed after the structural fields
func StzuWeave(tSev, nLine, tMsg)
	if tSev = "constitutional"
		StzuFail(nLine, tMsg)
	elseif tSev = "governance"
		$aStzuWarnings + tMsg
	else
		$aStzuNotes + tMsg
	end
end
# v0.25: the regime's own article beside the constitution's, in a weave refusal -- the declared
# regime, never a default: gdpr's articles, Niger Law 2017-28 as Zin's African companion names it,
# a regime Haro has no table for named as declared, and "no regime declared" where there is none
func StzuRegimeTail(tRegime, tRule)
	tTail = ""
	if tRegime = ""
		tTail = "no regime declared"
	elseif tRegime = "gdpr"
		tTail = "gdpr: " + StzuGdprArticle(tRule)
	elseif tRegime = "niger_2017_28"
		tTail = "Niger Law 2017-28"
	else
		tTail = "regime '" + tRegime + "' as declared, which Haro v0.25 has no article table for"
	end
	return " [Art. 5 organizational_sovereignty; " + tTail + "]"
end
func StzuGdprArticle(tRule)
	if tRule = "W4.4" return "Article 5(1)(e)" end
	if tRule = "W4.2" return "Article 7" end
	if tRule = "W3.1" return "Chapter V" end
	return "Article 5"
end
# the value shape of a UNION's alternative, or the refusal (v0.3)
func StzuAltShape(aAlt, aDeclared, aForms, nLine)
	tOf = aAlt[1]
	tK = DeclaredKind(aDeclared, tOf)
	if aAlt[2]
		if tK = ""
			StzuFail(nLine, "alternative '" + tOf + "' resolves to nothing in this declaration")
		end
		if tK != "FORM"
			StzuFail(nLine, "'" + tOf + "' cannot be an alternative of a UNION as a list: a list alternative is a list of a FORM")
		end
		for i = 1 to Len(aForms)
			if aForms[i][1] = tOf
				aFS = aForms[i][2]
				if Len(aFS) > 0
					if aFS[1][2] = "text" return "stringlist" end
					if DeclaredKind(aDeclared, aFS[1][2]) = "FORMAT" return "stringlist" end
				end
			end
		end
		return "namelist"
	end
	if tOf = "text" return "string" end
	if tOf = "number" return "number" end
	if InStrList(tOf, StzuPrimitives()) return "word" end
	if tK = ""
		StzuFail(nLine, "alternative '" + tOf + "' resolves to nothing in this declaration")
	end
	if tK = "MENU" return "word" end
	if tK = "RANGE" return "number" end
	if tK = "FORMAT" return "string" end
	if tK = "DECLARATION" return "word" end
	StzuFail(nLine, "'" + tOf + "' cannot be an alternative of a UNION: an alternative is a MENU, a RANGE, a FORMAT, a primitive, a DECLARATION or a list of a FORM, not a " + tK)
end
func StzuSeatsOf(aDeclarations, tDecl)
	for i = 1 to Len(aDeclarations)
		if aDeclarations[i][1] = tDecl return aDeclarations[i][3] end
	end
	return []
end
func StzuSeatNamed(aSeats, tSeat)
	for i = 1 to Len(aSeats)
		if aSeats[i][1] = tSeat return aSeats[i] end
	end
	return null
end
# v0.6: a list seat whose element is a FORM of exactly two seats, the first a
# name and the second a scalar, is written as name: value pairs; every other
# FORM keeps v0.1's reading (its items follow the form's first seat), because
# the pinned judge lists a six-seat FORM and v0.6 refuses nothing v0.5 accepted
# v0.32: a seat that is a list of a FORM whose seats make a pair (name: value), which the court reads as a pair list
func StzuIsPairListSeat(aSeat, aDeclared, aForms)
	if not aSeat[3] return false end
	if DeclaredKind(aDeclared, aSeat[2]) != "FORM" return false end
	for i = 1 to Len(aForms)
		if aForms[i][1] = aSeat[2] return StzuIsPairForm(aForms[i][2], aDeclared) end
	end
	return false
end
func StzuIsPairForm(aFS, aDeclared)
	# v0.27: a pair form may carry a third, optional seat typed by a MENU -- the mark, written after the value
	if Len(aFS) != 2 and not StzuHasMarkSeat(aFS, aDeclared) return false end
	if aFS[1][3] or aFS[2][3] return false end
	tK1 = DeclaredKind(aDeclared, aFS[1][2])
	if aFS[1][2] != "name" and tK1 != "MENU" and tK1 != "DECLARATION" return false end
	return true
end
# v0.27: the mark seat of a pair form -- third, optional, a MENU
func StzuHasMarkSeat(aFS, aDeclared)
	if Len(aFS) != 3 return false end
	if aFS[3][3] or not aFS[3][4] return false end
	return DeclaredKind(aDeclared, aFS[3][2]) = "MENU"
end
# a pair form whose key or value is a reference (v0.8)
func StzuPairRefs(aFS, aDeclared)
	tK1 = DeclaredKind(aDeclared, aFS[1][2])
	tK2 = DeclaredKind(aDeclared, aFS[2][2])
	return tK1 = "DECLARATION" or tK2 = "DECLARATION" or tK2 = "UNION"
end
func StzuCheckListForms(aSeats, aDeclared, aForms)
	for i = 1 to Len(aSeats)
		aS = aSeats[i]
		if not aS[3] loop end
		if DeclaredKind(aDeclared, aS[2]) != "FORM" loop end
		for j = 1 to Len(aForms)
			if aForms[j][1] != aS[2] loop end
			aFS = aForms[j][2]
			if StzuIsPairForm(aFS, aDeclared)
				# the pair's value is a scalar of the second seat's type: a
				# primitive, a MENU, a RANGE, a FORMAT, or (v0.8) a reference --
				# a DECLARATION or a UNION of declarations
				tK2 = DeclaredKind(aDeclared, aFS[2][2])
				if not (InStrList(aFS[2][2], StzuPrimitives()) or tK2 = "MENU" or tK2 = "RANGE" or tK2 = "FORMAT" or tK2 = "DECLARATION" or tK2 = "UNION")
					StzuFail(aS[5], "a list of a FORM writes key: value pairs when the FORM is a key and a scalar; the second seat of '" + aS[2] + "' is a " + tK2 + ", which a pair cannot hold")
				end
			end
		end
	end
end
func StzuHasSeat(aDeclarations, tDecl, tSeat)
	for i = 1 to Len(aDeclarations)
		if aDeclarations[i][1] = tDecl
			aS = aDeclarations[i][3]
			for j = 1 to Len(aS)
				if aS[j][1] = tSeat return true end
			end
		end
	end
	return false
end
# v0.24: the seat record [name, of, isList, optional, line] of a declaration's seat, or NULL
func StzuSeatRec(aDeclarations, tDecl, tSeat)
	for i = 1 to Len(aDeclarations)
		if aDeclarations[i][1] = tDecl
			aS = aDeclarations[i][3]
			for j = 1 to Len(aS)
				if aS[j][1] = tSeat return aS[j] end
			end
		end
	end
	return null
end
# v0.27: a FORM's record by name, a MENU's record by name, or NULL
func StzuFormRec(aForms, tName)
	for i = 1 to Len(aForms)
		if aForms[i][1] = tName return aForms[i] end
	end
	return null
end
func StzuMenuRec(aMenus, tName)
	for i = 1 to Len(aMenus)
		if aMenus[i][1] = tName return aMenus[i] end
	end
	return null
end
func StzuCheckCondition(tCond, tOn, aOneDecls, nLine)
	aAst = null
	tErr = ""
	try
		aAst = CondParse(tCond)
	catch
		tErr = cCatchError
	end
	if tErr != ""
		StzuFail(nLine, tErr + " -- in '" + tCond + "'")
	end
	tWhy = CondValidate(aAst, tOn, aOneDecls, "")
	if tWhy != ""
		StzuFail(nLine, tWhy + " -- in '" + tCond + "'")
	end
end
# a seat type resolves to a primitive, a FORM, an EXPRESSION, a MENU, a RANGE,
# a FORMAT or a DECLARATION (a reference); a list seat's element is a FORM, a
# DECLARATION or a MENU
func StzuResolveSeats(aSeats, aDeclared)
	aUnionsRef = $aStzuUnions
	for i = 1 to Len(aSeats)
		aS = aSeats[i]
		tOf = aS[2]
		if aS[3]
			tK = DeclaredKind(aDeclared, tOf)
			if tK = ""
				StzuFail(aS[5], "seat type '" + tOf + "' resolves to nothing in this declaration")
			end
			if tK = "UNION"
				# v0.9: a list of references to several kinds -- a step list
				aUAlts = null
				aUL = aUnionsRef
				for k = 1 to Len(aUL)
					if aUL[k][1] = tOf aUAlts = aUL[k][2] end
				end
				if not IsNull(aUAlts)
					for k = 1 to Len(aUAlts)
						if DeclaredKind(aDeclared, aUAlts[k][1]) != "DECLARATION"
							StzuFail(aS[5], "a list seat's element UNION is a UNION of DECLARATIONs; '" + tOf + "' holds '" + aUAlts[k][1] + "'")
						end
					end
				end
				loop
			end
			if tK != "FORM" and tK != "DECLARATION" and tK != "MENU"
				StzuFail(aS[5], "a list seat's element must be a declared FORM, DECLARATION, MENU or a UNION of declarations; '" + tOf + "' is not")
			end
		elseif not InStrList(tOf, StzuPrimitives())
			tK = DeclaredKind(aDeclared, tOf)
			if tK = ""
				StzuFail(aS[5], "seat type '" + tOf + "' resolves to nothing in this declaration")
			end
			if tK != "FORM" and tK != "EXPRESSION" and tK != "MENU" and tK != "RANGE" and tK != "FORMAT" and tK != "DECLARATION" and tK != "UNION" and tK != "SENTENCE" and tK != "SYMBOL"
				StzuFail(aS[5], "seat type '" + tOf + "' must name a FORM, an EXPRESSION, a MENU, a RANGE, a FORMAT, a DECLARATION, a UNION, a SENTENCE or a SYMBOL, not a " + tK)
			end
		end
	end
end
# ---- the printed verdict ----------------------------------------------------

func StzuPrintLanguage(aLang)
	? "ok"
	? "language " + LangGet(aLang, "name")
	? "version " + LangGet(aLang, "version")
	? "grammar " + LangGet(aLang, "grammar")
	? "court " + LangGet(aLang, "court")
	? "extension " + LangGet(aLang, "extension")
	? "rationale " + LangGet(aLang, "rationale")
	? "declarations " + String(Len(LangGet(aLang, "declarations")))
	? "forms " + String(Len(LangGet(aLang, "forms")))
	? "expressions " + String(Len(LangGet(aLang, "expressions")))
	? "refusals " + String(Len(LangGet(aLang, "refusals")))
	? "menus " + String(Len(LangGet(aLang, "menus")))
	? "ranges " + String(Len(LangGet(aLang, "ranges")))
	? "formats " + String(Len(LangGet(aLang, "formats")))
	? "unions " + String(Len(LangGet(aLang, "unions")))
	? "sentences " + String(Len(LangGet(aLang, "sentences")))
	? "views " + String(Len(LangGet(aLang, "views")))
	? "constraints " + String(Len(LangGet(aLang, "constraints")))
	# v0.32: printed only where there is one, so a language without a PATTERN prints the bytes it printed
	aPaL = LangGet(aLang, "patterns")
	if not IsNull(aPaL)
		if Len(aPaL) > 0 ? "patterns " + String(Len(aPaL)) end
	end
	nCtx = 0
	aE = LangGet(aLang, "expressions")
	for i = 1 to Len(aE)
		if Len(aE[i]) >= 8 nCtx += Len(aE[i][8]) end
	end
	? "contexts " + String(nCtx)
	? "walks " + String(Len(LangGet(aLang, "walks")))
	nAsks = 0
	if not IsNull(LangGet(aLang, "ask")) nAsks = 1 end
	? "asks " + String(nAsks)
	nRuns = 0
	if not IsNull(LangGet(aLang, "run")) nRuns = 1 end
	? "runs " + String(nRuns)
	aSy = LangGet(aLang, "symbols")
	nSy = 0
	if not IsNull(aSy) nSy = Len(aSy) end
	? "symbols " + String(nSy)
	nFs = 0
	if not IsNull(LangGet(aLang, "formset")) nFs = 1 end
	? "formsets " + String(nFs)
	nNr = 0
	if not IsNull(LangGet(aLang, "narrate")) nNr = 1 end
	? "narrates " + String(nNr)
	nUn = 0
	if not IsNull(LangGet(aLang, "understand")) nUn = 1 end
	? "understands " + String(nUn)
	nWorld = 0
	if not IsNull(LangGet(aLang, "world")) nWorld = 1 end
	? "world " + String(nWorld)
	nPoints = 0
	aR = LangGet(aLang, "refine")
	if not IsNull(aR) nPoints = Len(aR[1]) end
	? "points " + String(nPoints)
	# v0.23: the constitution, and its articles in the declared order
	aCs = LangGet(aLang, "constitution")
	nCs = 0
	tArts = ""
	if not IsNull(aCs)
		nCs = 1
		for i = 1 to Len(aCs[2])
			if i > 1 tArts += "," end
			tArts += aCs[2][i]
		end
	end
	? "constitution " + String(nCs)
	? "articles " + tArts
	# v0.24: the zone kind of organizational_sovereignty, empty under none
	tZone = ""
	if not IsNull(aCs)
		if Len(aCs) >= 7 tZone = aCs[7] end
	end
	? "zone " + tZone
	# v0.25: the regime, the weaves with their severities, the personal seats
	tRegime = ""
	tWeaves = ""
	tPersonal = ""
	if not IsNull(aCs)
		if Len(aCs) >= 10
			tRegime = aCs[4]
			for i = 1 to Len(aCs[3])
				if i > 1 tWeaves += "," end
				tWeaves += aCs[3][i][1] + ":" + aCs[3][i][2]
			end
			for i = 1 to Len(aCs[10])
				if i > 1 tPersonal += "," end
				tPersonal += aCs[10][i][1]
			end
		end
	end
	# v0.27: the safeguards, as path:word, comma-joined
	tSafeg = ""
	if not IsNull(aCs)
		if Len(aCs) >= 11
			for i = 1 to Len(aCs[11])
				if i > 1 tSafeg += "," end
				tSafeg += aCs[11][i][1] + ":" + aCs[11][i][2]
			end
		end
	end
	? "regime " + tRegime
	? "weaves " + tWeaves
	? "personal " + tPersonal
	? "safeguards " + tSafeg
	# v0.29: the rules of the six carried weaves a constitution names -- judged, held by construction, carried -- printed only when one is named
	tJudged = ""
	tHeld = ""
	tCarried = ""
	bSix = false
	if not IsNull(aCs)
		for i = 1 to Len(aCs[3])
			tWn = aCs[3][i][1]
			if tWn != "sovereignty" and tWn != "privacy"
				bSix = true
				aWr = StzuWeaveRules(tWn)
				tJudged = StzuAppendWords(tJudged, aWr[1])
				tHeld = StzuAppendWords(tHeld, aWr[2])
				tCarried = StzuAppendWords(tCarried, aWr[3])
			end
		end
	end
	if bSix
		? "judged " + tJudged
		? "held " + tHeld
		? "carried " + tCarried
	end
	# v0.40: the doors, printed only for a language that NEEDS -- so every other verdict keeps its bytes
	aDoors = LangGet(aLang, "needs")
	if not IsNull(aDoors)
		tNd = ""
		for i = 1 to Len(aDoors)
			if i > 1 tNd += "," end
			tNd += aDoors[i]
		end
		? "needs " + tNd
		aOpn = LangGet(aLang, "opens")
		tOpn = ""
		for i = 1 to Len(aOpn)
			if i > 1 tOpn += "," end
			tOpn += aOpn[i][1] + ":" + aOpn[i][2]
		end
		? "opens " + tOpn
	end
	aD = LangGet(aLang, "declarations")
	aV = []
	for i = 1 to Len(aD)
		aV + aD[i][2]
	end
	aV = Sort(aV)
	tV = ""
	for i = 1 to Len(aV)
		if i > 1 tV += "," end
		tV += aV[i]
	end
	? "verbs " + tV
	# v0.25: a weave's warnings and notes, after the fields
	for i = 1 to Len($aStzuWarnings)
		? "warning " + $aStzuWarnings[i]
	end
	for i = 1 to Len($aStzuNotes)
		? "note " + $aStzuNotes[i]
	end
end
