# haro_lib.haro -- the stzu meta-court, v0.2, in pure core Ring (no Softanza).
#
# v0.1 was a port of stz/face/stz/Stzu.luau (437 lines); it still is, and the
# 28 v0.1 fixtures still pass unchanged. v0.2 is the declaring altitude of Haro
# grown by the WORLD and REFINE seats and the type kinds a real language's
# court needs (haro/spike/v02/GRAMMAR.md; the judge is v02/fixtures.json,
# written first): MENU, RANGE, FORMAT as seat types; a seat typed by a
# DECLARATION as a reference; NAMES on a declaration; CONSTRAINT with a
# condition in the closed language of cond_lib.haro; WORLD (ONE, FIRST);
# REFINE (POINTS, FLOOR).
#
# v0.6 (haro/spike/v06/GRAMMAR.md): a list of a two-seat FORM written as
# name: value pairs; an EXPRESSION's ABSENT, DIVISION and EQUALITY; and
# WALK, the one kinetic kind -- which kind is walked, by which steps, in
# what order, under which guards, computing what, failing how.
#
# v0.7 (haro/spike/v07/GRAMMAR.md): ASK, the Q letter -- the language's own
# closed question grammar: FROM which kinds, WHERE in which expression,
# which optional CLAUSES (where, order, limit); and ABSENT missing.
#
# v0.17 (haro/spike/v17/GRAMMAR.md): UNDERSTAND -- how a human language reaches closed questions: the eight
# kinds that play TONGUE, MEANING, ALIAS, SURFACE, STEP, FRAME, EXAMPLE and COUNTEREXAMPLE.
# v0.13 (haro/spike/v13/GRAMMAR.md): NARRATE -- how a run of the language is
# narrated back, the court's voice: a template per declaration kind, an
# opening, an ending, a refusal; a projection of the sentence, never stored,
# never parsed back (the StzNarration law; stzn).
#
# v0.12 (haro/spike/v12/GRAMMAR.md): FORMS -- a vocabulary's function-name
# grammar as data (principle 7): the fluent, passive and statement forms, the
# parameter suffixes, one meaning per suffix, and which declaration spells a
# family from a base and the forms it offers.
#
# v0.11 (haro/spike/v11/GRAMMAR.md): the Diagnostic Contract (C2 v1.2.0) --
# CODE, CODES and CITES, so a forged court speaks the family's envelope.
#
# v0.10 (haro/spike/v10/GRAMMAR.md): the WORLD as versioned data -- SYMBOL, a
# seat type resolved against a C1 world.json when the court is handed one, and
# PUBLISH on the WORLD, the kinds a sentence contributes as symbols.
#
# v0.9 (haro/spike/v09/GRAMMAR.md): what A needs -- RUN, the kinetic declaration
# of structured steps (OF, COMPUTE, COLLECT, GROUP, BRANCH, ITERATE: a kind and
# its seats by role), and a list seat whose element is a UNION of declarations.
#
# v0.8 (haro/spike/v08/GRAMMAR.md): what F needs -- a REFUSAL's NAMED words;
# pair lists keyed by a MENU or a DECLARATION with reference values; a UNION
# of DECLARATIONs; the shapes duration, landmark, deadline; the WORLD's
# ENTRY kinds; the relations reachable, referenced and keyed_by.

#
# The same file runs on haro and on the oracle and must print the same bytes.
# Refusals are one channel, "stzu (line N): message". Functions only; the
# globals ($aStzuToks, $nStzuPos, and cond_lib's) are born in the root file.

load "cond_lib.haro"
load "block_lib.haro"
load "pattern_lib.haro"
load "form_expand.haro"

# ---- the closed menus -------------------------------------------------------

func StzuOperators
	return ["or", "and", "not", "cmp", "contains", "add", "sub", "mul", "div", "mod", "round", "neg"]
end
func StzuOperands
	return ["number", "text", "flag", "ref", "var", "agg"]
end
func StzuAggregates
	return ["sum", "count", "avg", "min", "max"]
end
func StzuPrimitives
	return ["name", "text", "number", "flag", "ref"]
end
func StzuRefusalCategories
	return ["unknown_verb", "unknown_declaration", "unknown_seat", "unknown_variable",
	        "unterminated_string", "unexpected_character", "dangling_reference", "duplicate_name"]
end
func StzuShapes
	return ["absolute_path", "ipv4", "cidr", "mac", "label", "domain", "hex64", "hex64_lower", "duration", "landmark", "deadline"]
end
func StzuRefinementKinds
	return ["knob", "field", "symbol", "policy", "composite", "pipeline"]
end
func StzuPostures
	return ["trusted", "external", "sandboxed", "llm"]
end
# v0.23: Zin's six articles, in Zin's order and numbering (zin constitution.zig:35-40; charter 2),
# its eight weaves (ZIN_CONSTITUTIONAL_WEAVES.md) and its three severities -- the closed words of a
# CONSTITUTION; the weaves and severities are carried here and judged at ZC4
func StzuArticles
	return ["explainability", "reversibility", "visible_state", "predictable_authority", "organizational_sovereignty", "trust_hierarchy"]
end
func StzuWeaves
	return ["resilience", "observability", "sovereignty", "privacy", "temporal_integrity", "cost_awareness", "learnability", "structural_integrity"]
end
func StzuSeverities
	return ["constitutional", "governance", "advisory"]
end
# kind -> list of [clause, shape]; shapes: string namelist seatlist number ident pointlist
# (sorted by clause name, as Luau's table.sort gives, for the allowed-list text)
func StzuClauses(tKind)
	if tKind = "LANGUAGE"
		return [["COURT", "string"], ["EXTENSION", "string"], ["GRAMMAR", "string"], ["NEEDS", "namelist"], ["VERSION", "string"]]
	elseif tKind = "DECLARATION"
		return [["CODES", "messagelist"], ["INCLUDES", "namelist"], ["MESSAGES", "messagelist"], ["NAMES", "ident"], ["OPENS", "ident"], ["SEATS", "seatlist"], ["SEVERITIES", "pairlist"], ["VERB", "string"]]
	elseif tKind = "FORM"
		return [["SEATS", "seatlist"]]
	elseif tKind = "EXPRESSION"
		return [["ABSENT", "ident"], ["AGGREGATES", "namelist"], ["CONTEXTS", "contextlist"], ["DIVISION", "ident"], ["EQUALITY", "ident"], ["OPERANDS", "namelist"], ["OPERATORS", "namelist"], ["VARIABLES", "namelist"]]
	elseif tKind = "REFUSAL"
		return [["CITES", "citelist"], ["CODE", "string"], ["CODES", "messagelist"], ["MESSAGE", "string"], ["NAMED", "messagelist"], ["SEVERITIES", "pairlist"]]
	elseif tKind = "MENU"
		return [["CITES", "citelist"], ["CODE", "string"], ["MESSAGE", "string"], ["WORDS", "namelist"]]
	elseif tKind = "RANGE"
		return [["CITES", "citelist"], ["CODE", "string"], ["MAX", "number"], ["MESSAGE", "string"], ["MIN", "number"]]
	elseif tKind = "FORMAT"
		return [["CITES", "citelist"], ["CODE", "string"], ["FOLD", "ident"], ["MESSAGE", "string"], ["SHAPE", "ident"]]
	elseif tKind = "SENTENCE"
		return [["MESSAGE", "string"], ["OF", "string"], ["REFUSED", "string"]]
	elseif tKind = "VIEW"
		return [["NAMED", "string"], ["ON", "ident"], ["ONE", "string"], ["WHERE", "string"]]
	elseif tKind = "CONSTRAINT"
		return [["CITES", "citelist"], ["CODE", "string"], ["EXCEPT", "namelist"], ["MESSAGE", "string"], ["ON", "ident"], ["SEVERITY", "ident"], ["THEN", "string"], ["WHEN", "string"]]
	elseif tKind = "WORLD"
		return [["ENTRY", "namelist"], ["FIRST", "ident"], ["ONE", "namelist"], ["PUBLISH", "pairlist"]]
	elseif tKind = "REFINE"
		return [["FLOOR", "pointlist"], ["POINTS", "pointlist"]]
	elseif tKind = "CONSTITUTION"
		return [["ARTICLES", "namelist"], ["MOVEMENT", "ident"], ["PERSONAL", "pathlist"], ["REGIME", "ident"], ["SAFEGUARDS", "pairlist"], ["SOVEREIGN", "ident"], ["WEAVES", "pairlist"], ["ZONE", "ident"]]
	elseif tKind = "UNION"
		return [["CITES", "citelist"], ["CODE", "string"], ["MESSAGE", "string"], ["OF", "typelist"]]
	elseif tKind = "WALK"
		return [["COMPUTE", "ident"], ["FAIL", "ident"], ["FORMULA", "ident"], ["GUARDS", "pathlist"], ["OF", "ident"], ["ORDER", "ident"], ["STEPS", "ident"], ["THROUGH", "ident"]]
	elseif tKind = "ASK"
		return [["CLAUSES", "namelist"], ["FIELDS", "path"], ["FROM", "namelist"], ["WHERE", "ident"]]
	elseif tKind = "RUN"
		return [["BRANCH", "namelist"], ["COLLECT", "namelist"], ["COMPUTE", "namelist"], ["GROUP", "namelist"], ["ITERATE", "namelist"], ["OF", "namelist"]]
	elseif tKind = "PATTERN"
		return [["CITES", "citelist"], ["CODE", "string"], ["MATCH", "rule"], ["MESSAGE", "string"], ["OVER", "path"], ["SETS", "pointlist"], ["SEVERITY", "ident"]]
	elseif tKind = "SYMBOL"
		return [["CITES", "citelist"], ["CODE", "string"], ["KIND", "string"], ["MESSAGE", "string"], ["REF", "string"]]
	elseif tKind = "FORMS"
		return [["FAMILY", "namelist"], ["FLUENT", "string"], ["PARAMS", "messagelist"], ["PASSIVE", "string"], ["STATEMENT", "string"]]
	elseif tKind = "NARRATE"
		return [["ENDS", "string"], ["OPENS", "string"], ["REFUSES", "string"], ["SAYS", "messagelist"], ["TELLS", "messagelist"]]
	elseif tKind = "UNDERSTAND"
		return [["ALIAS", "namelist"], ["COUNTEREXAMPLE", "namelist"], ["EXAMPLE", "namelist"], ["FRAME", "namelist"], ["MEANING", "namelist"], ["STEP", "namelist"], ["SURFACE", "namelist"], ["TONGUE", "namelist"]]
	end
	return []
end
func StzuRequired(tKind)
	if tKind = "LANGUAGE"
		return ["VERSION", "GRAMMAR", "COURT", "EXTENSION"]
	elseif tKind = "DECLARATION"
		return ["VERB", "SEATS"]
	elseif tKind = "FORM"
		return ["SEATS"]
	elseif tKind = "EXPRESSION"
		return ["OPERATORS", "OPERANDS"]
	elseif tKind = "REFUSAL"
		return ["MESSAGE"]
	elseif tKind = "MENU"
		return ["WORDS"]
	elseif tKind = "RANGE"
		return ["MIN", "MAX"]
	elseif tKind = "FORMAT"
		return ["SHAPE"]
	elseif tKind = "CONSTRAINT"
		return ["ON", "WHEN", "MESSAGE"]
	elseif tKind = "CONSTITUTION"
		return ["ARTICLES"]
	elseif tKind = "WORLD"
		return []
	elseif tKind = "REFINE"
		return ["POINTS"]
	elseif tKind = "UNION"
		return ["OF"]
	elseif tKind = "SENTENCE"
		return ["OF"]
	elseif tKind = "VIEW"
		return ["ONE"]
	elseif tKind = "WALK"
		return ["OF", "STEPS", "THROUGH", "ORDER"]
	elseif tKind = "ASK"
		return ["FROM"]
	elseif tKind = "RUN"
		return ["OF"]
	elseif tKind = "PATTERN"
		return ["OVER", "MATCH", "MESSAGE"]
	elseif tKind = "SYMBOL"
		return ["KIND"]
	elseif tKind = "FORMS"
		return ["PARAMS"]
	elseif tKind = "NARRATE"
		return []
	elseif tKind = "UNDERSTAND"
		return ["TONGUE", "MEANING", "ALIAS", "SURFACE", "STEP", "FRAME", "EXAMPLE", "COUNTEREXAMPLE"]
	end
	return []
end
func StzuIsKind(tWord)
	return InStrList(tWord, ["LANGUAGE", "DECLARATION", "FORM", "EXPRESSION", "REFUSAL",
	                         "MENU", "RANGE", "FORMAT", "CONSTRAINT", "WORLD", "REFINE", "UNION",
	                         "SENTENCE", "VIEW", "WALK", "ASK", "RUN", "SYMBOL", "FORMS", "NARRATE", "UNDERSTAND", "CONSTITUTION", "PATTERN"])
end
# C2 2.1: a code is ^[A-Z][A-Z0-9]*([_-][A-Z0-9]+)*$ ; C2 2.5: a cite is
# kind:value, kind in rule|article|right|pattern, value [A-Za-z0-9_.-]+ (v0.11)
func StzuIsC2Code(tS)
	if Len(tS) = 0 return false end
	if not IsUpperChar(tS[1]) return false end
	bSep = false
	for i = 2 to Len(tS)
		tC = tS[i]
		if tC = "_" or tC = "-"
			if bSep return false end
			bSep = true
		elseif IsUpperChar(tC) or IsDigitChar(tC)
			bSep = false
		else
			return false
		end
	end
	return not bSep
end
func StzuIsC2Cite(tS)
	nN = SubStr(tS, ":")
	if nN < 2 return false end
	tKind = Left(tS, nN - 1)
	if not InStrList(tKind, ["rule", "article", "right", "pattern"]) return false end
	tV = SubStr(tS, nN + 1)
	if Len(tV) = 0 return false end
	for i = 1 to Len(tV)
		tC = tV[i]
		if not (IsUpperChar(tC) or IsLowerChar(tC) or IsDigitChar(tC) or tC = "_" or tC = "." or tC = "-") return false end
	end
	return true
end
# v0.16: the placeholders an event of a run or a question can fill, or a refusal naming why it cannot be told
func StzuTellPlaceholders(tKey, xDeclarations, xRun, xAsk, tLName, nLine)
	if tKey = "run" or tKey = "result"
		if IsEmpty(xRun) StzuFail(nLine, "TELLS: '" + tKey + "' tells a run, and this language declares no RUN") end
		if tKey = "run" return ["language", "file", "algorithm", "record"] end
		return ["language", "file", "algorithm", "result"]
	end
	if InStrList(tKey, ["ask", "matched", "ordered", "cut", "answer"])
		if IsEmpty(xAsk) StzuFail(nLine, "TELLS: '" + tKey + "' tells a question, and this language declares no ASK") end
		if tKey = "ask" return ["language", "file", "question", "from"] end
		if tKey = "matched" return ["count", "total", "from"] end
		if tKey = "ordered" return ["field", "direction"] end
		if tKey = "cut" return ["limit", "dropped", "count"] end
		return ["count", "rows"]
	end
	xDecl = ""
	for j = 1 to Len(xDeclarations)
		if xDeclarations[j][1] = tKey xDecl = xDeclarations[j] end
	end
	if IsEmpty(xDecl) StzuFail(nLine, "TELLS: no declaration '" + tKey + "' in " + tLName) end
	if IsEmpty(xRun) StzuFail(nLine, "TELLS: '" + tKey + "' tells a step, and this language declares no RUN") end
	bPlays = false
	for r = 1 to Len(xRun[2])
		if xRun[2][r][1] != "OF"
			if xRun[2][r][2][1] = tKey bPlays = true end
		end
	end
	if not bPlays StzuFail(nLine, "TELLS: '" + tKey + "' plays no construct of this language's RUN") end
	vOk = ["name", "verb", "rationale", "line", "value", "key", "taken", "count"]
	for j = 1 to Len(xDecl[3])
		vOk + xDecl[3][j][1]
	end
	return vOk
end
# v0.13: every {word} of a template names a placeholder the voice can fill, and every brace closes
func StzuCheckTemplate(tT, xAllowed, nLine, tWhere)
	nN = Len(tT)
	nI = 1
	while nI <= nN
		if tT[nI] = "{"
			nJ = nI + 1
			tW = ""
			while nJ <= nN and tT[nJ] != "}"
				tW += tT[nJ]
				nJ++
			end
			if nJ > nN
				StzuFail(nLine, "a '{' is never closed in " + tWhere)
			end
			if not InStrList(tW, xAllowed)
				StzuFail(nLine, "'{" + tW + "}' in " + tWhere + " is not a placeholder the voice can fill: it fills " + StzuJoinWords(xAllowed))
			end
			nI = nJ
		end
		nI++
	end
end
func StzuJoinWords(xL)
	tOut = ""
	for i = 1 to Len(xL)
		if i > 1 tOut += ", " end
		tOut += xL[i]
	end
	return tOut
end
# v0.12: a suffix is letters, and no two roles spell the same one (the FF clash)
func StzuWantSuffix(tS, nLine, tWhere)
	if Len(tS) = 0 StzuFail(nLine, "'" + tS + "' on " + tWhere + " is not a suffix: a suffix is letters") end
	for i = 1 to Len(tS)
		if not (IsUpperChar(tS[i]) or IsLowerChar(tS[i]))
			StzuFail(nLine, "'" + tS + "' on " + tWhere + " is not a suffix: a suffix is letters")
		end
	end
end
func StzuWantOneMeaning(vSpelt, tRole, tSuffix, nLine)
	for i = 1 to Len(vSpelt)
		if vSpelt[i][2] = tSuffix
			StzuFail(nLine, "'" + tSuffix + "' is spelt twice, as " + vSpelt[i][1] + " and as " + tRole + ": one meaning per suffix")
		end
	end
end
func StzuWantCode(tCode, nLine, tWhere)
	if not StzuIsC2Code(tCode)
		StzuFail(nLine, "'" + tCode + "' on " + tWhere + " is not a code in the Diagnostic Contract's format: an uppercase identifier, [A-Z][A-Z0-9]* with _ or - between parts")
	end
end
# v0.28 (HARO-MENU-CITES-01): the word none cites nothing and passes; an empty list says nothing and is refused
# by name -- the machine language's own idiom for EGRESS, a list or the word none, never an empty list
func StzuWantCites(xCites, nLine, tWhere)
	if IsString(xCites) return end
	if Len(xCites) = 0
		StzuFail(nLine, "an empty CITES says nothing: a list names what the refusal cites, and the word none says it cites nothing")
	end
	for i = 1 to Len(xCites)
		if not StzuIsC2Cite(xCites[i])
			StzuFail(nLine, "'" + xCites[i] + "' on " + tWhere + " is not a cite: kind:value with kind rule, article, right or pattern")
		end
	end
end
# v0.35: a SEVERITIES list -- each entry named once, each error or warning
func StzuWantSeverities(xSv, tWhat)
	for i = 1 to Len(xSv)
		for j = 1 to i - 1
			if xSv[j][1] = xSv[i][1] StzuFail(xSv[i][3], "'" + xSv[i][1] + "' is named twice in SEVERITIES") end
		end
		if xSv[i][2] != "error" and xSv[i][2] != "warning"
			StzuFail(xSv[i][3], "'" + xSv[i][2] + "' is not a SEVERITY of " + tWhat + ": error or warning")
		end
	end
end
# v0.35: a seat whose value is a reference the court resolves -- to a DECLARATION, a UNION holding one, a SYMBOL the world resolves, or a
# list of pairs whose keys or values are references
func StzuIsReferenceSeat(xSeat, vDeclared, vForms, vUnions)
	tK = DeclaredKind(vDeclared, xSeat[2])
	if tK = "DECLARATION" or tK = "SYMBOL" return true end
	if tK = "UNION"
		for i = 1 to Len(vUnions)
			if vUnions[i][1] = xSeat[2]
				for j = 1 to Len(vUnions[i][2])
					if DeclaredKind(vDeclared, vUnions[i][2][j][1]) = "DECLARATION" and not vUnions[i][2][j][2] return true end
				end
			end
		end
		return false
	end
	if tK = "FORM" and xSeat[3]
		for i = 1 to Len(vForms)
			if vForms[i][1] = xSeat[2] and StzuIsPairForm(vForms[i][2], vDeclared)
				if StzuPairRefs(vForms[i][2], vDeclared) return true end
			end
		end
	end
	return false
end
func StzuCodesOf(xClauses, nLine, tWhere)
	xCodes = []
	if HasClause(xClauses, "CODES")
		xCodes = ClauseValue(xClauses, "CODES")
		for i = 1 to Len(xCodes)
			StzuWantCode(xCodes[i][2], xCodes[i][3], tWhere + "." + xCodes[i][1])
		end
	end
	return xCodes
end
func StzuCodeOf(xClauses, nLine, tWhere)
	tCode = ""
	if HasClause(xClauses, "CODE")
		tCode = ClauseValue(xClauses, "CODE")
		StzuWantCode(tCode, nLine, tWhere)
	end
	return tCode
end
func StzuCitesOf(xClauses, nLine, tWhere)
	xCites = []
	if HasClause(xClauses, "CITES")
		xCites = ClauseValue(xClauses, "CITES")
		StzuWantCites(xCites, nLine, tWhere)
	end
	return xCites
end
# the directory part of a path, "" when none (core Ring has no dirname)
func StzuDirOf(tPath)
	nN = 0
	for i = 1 to Len(tPath)
		if tPath[i] = "/" or tPath[i] = Char(92) nN = i end
	end
	if nN = 0 return "" end
	return Left(tPath, nN - 1)
end
# what a seat's type name resolves to in a language record:
# prim form expr menu range format decl union sentence
func StzuTypeKindOf(xLang, tOf)
	if InStrList(tOf, StzuPrimitives()) return "prim" end
	xL = LangGet(xLang, "forms")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "form" end end
	xL = LangGet(xLang, "menus")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "menu" end end
	xL = LangGet(xLang, "ranges")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "range" end end
	xL = LangGet(xLang, "formats")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "format" end end
	xL = LangGet(xLang, "declarations")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "decl" end end
	xL = LangGet(xLang, "unions")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "union" end end
	xL = LangGet(xLang, "sentences")
	for i = 1 to Len(xL) if xL[i][1] = tOf return "sentence" end end
	xL = LangGet(xLang, "symbols")
	if not IsEmpty(xL)
		for i = 1 to Len(xL) if xL[i][1] = tOf return "symbol" end end
	end
	return "expr"
end
# the condition tables of a language record and of the languages its
# SENTENCEs name (v0.4): one entry per language, [lang, declseats, onedecls,
# views, verbof]
func StzuCondLangs(xLang, vViewEntries)
	xOut = [StzuCondLang(xLang, vViewEntries)]
	xS = LangGet(xLang, "sentences")
	for i = 1 to Len(xS)
		if not IsEmpty(xS[i][3])
			xInner = StzuCondLangs(xS[i][3], [])
			for j = 1 to Len(xInner)
				xOut + xInner[j]
			end
		end
	end
	return xOut
end
func StzuCondLang(xLang, vViewEntries)
	xDecls = LangGet(xLang, "declarations")
	xSents = LangGet(xLang, "sentences")
	vDeclSeats = []
	vVerbOf = []
	for i = 1 to Len(xDecls)
		xS = xDecls[i][3]
		xInfo = []
		for j = 1 to Len(xS)
			tOf = xS[j][2]
			tTK = StzuTypeKindOf(xLang, tOf)
			tTarget = ""
			if tTK = "decl" tTarget = LangGet(xLang, "name") end
			if tTK = "sentence"
				for k = 1 to Len(xSents)
					if xSents[k][1] = tOf
						if not IsEmpty(xSents[k][3]) tTarget = LangGet(xSents[k][3], "name") end
					end
				end
			end
			xInfo + [xS[j][1], tOf, xS[j][3], tTK, tTarget]
		end
		vDeclSeats + [xDecls[i][1], xInfo]
		vVerbOf + [xDecls[i][1], xDecls[i][2]]
	end
	xOne = []
	xEntry = []
	xW = LangGet(xLang, "world")
	if not IsEmpty(xW)
		xOne = xW[1]
		if Len(xW) >= 4 xEntry = xW[4] end
	end
	# v0.8: the forms, so a condition can read a pair list's keys and values
	vFormTable = []
	xFm = LangGet(xLang, "forms")
	for i = 1 to Len(xFm)
		xFS = xFm[i][2]
		xInfo = []
		for j = 1 to Len(xFS)
			xInfo + [xFS[j][1], xFS[j][2], StzuTypeKindOf(xLang, xFS[j][2])]
		end
		vFormTable + [xFm[i][1], xInfo]
	end
	return [LangGet(xLang, "name"), vDeclSeats, xOne, vViewEntries, vVerbOf, xEntry, vFormTable]
end
func StzuAllowedList(tKind)
	xC = StzuClauses(tKind)
	tOut = ""
	for i = 1 to Len(xC)
		if i > 1 tOut += ", " end
		tOut += xC[i][1]
	end
	return tOut
end
func StzuClauseShape(tKind, tClause)
	xC = StzuClauses(tKind)
	for i = 1 to Len(xC)
		if xC[i][1] = tClause return xC[i][2] end
	end
	return ""
end
# ---- small helpers ----------------------------------------------------------

func InStrList(tS, xL)
	for i = 1 to Len(xL)
		if xL[i] = tS return true end
	end
	return false
end
func StzuJoin(xL, tSep)
	tOut = ""
	for i = 1 to Len(xL)
		if i > 1 tOut += tSep end
		tOut += xL[i]
	end
	return tOut
end
# character classes by byte code, never by string ordering (HF-30)
func IsLowerStart(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or nN = 95
end
func IsLowerChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or nN = 95 or (nN >= 48 and nN <= 57)
end
func IsUpperStart(tC)
	nN = Ascii(tC)
	return (nN >= 65 and nN <= 90)
end
func IsUpperChar(tC)
	nN = Ascii(tC)
	return (nN >= 65 and nN <= 90) or nN = 95 or (nN >= 48 and nN <= 57)
end
func IsDigitChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)
end
func IsUpperSnake(tW)
	if Len(tW) = 0 return false end
	if not IsUpperStart(tW[1]) return false end
	for i = 2 to Len(tW)
		if not IsUpperChar(tW[i]) return false end
	end
	return true
end
# v0.40: the closed catalog of nine (D51) -- the words Harobanda's machine file and stzlib's stzSystemCapabilities already use
func StzuCapabilities
	return ["filesystem", "process", "network", "environment", "dynamic_load", "gpio", "threads", "clock", "inference"]
end
func StzuCapabilityList
	xC = StzuCapabilities()
	tC = ""
	for i = 1 to Len(xC)
		if i > 1 tC += ", " end
		tC += xC[i]
	end
	return tC
end
# v0.40: the words of a MENU, or NULL when the name is not a MENU
func StzuMenuWords(vMenus, tName)
	for i = 1 to Len(vMenus)
		if vMenus[i][1] = tName return vMenus[i][2] end
	end
	return ""
end
func StzuFail(nLine, tMsg)
	Raise("haro (line " + String(nLine) + "): " + tMsg)
end
# v0.15: a collecting meta-court. In collect mode a refusal met at one of the declaration loop's
# or a whole-file pass's elements is NOTED and the run goes on to the next element; out of collect
# mode it is raised again, same string, so every earlier verdict is unchanged to the byte. A
# declaration that did not parse is BROKEN: the court resumes at the next DEFINE, and a later
# finding that quotes a broken name says nothing -- it is a consequence, not a second defect.
func StzuNote(tErr)
	if not $bStzuCollect Raise(tErr) end
	tMsg = StzuStripPrefix(tErr)
	if StzuQuotesBroken(tMsg) return end
	$vStzuFound + [StzuLineOf(tErr), tMsg]
end
func StzuStripPrefix(tMsg)
	nN = SubStr(tMsg, "): ")
	if nN > 0 return SubStr(tMsg, nN + 3) end
	return tMsg
end
func StzuLineOf(tMsg)
	nAt = SubStr(tMsg, "(line ")
	if nAt = 0 return 0 end
	nEnd = SubStr(tMsg, "): ")
	if nEnd <= nAt return 0 end
	return Number(SubStr(tMsg, nAt + 6, nEnd - nAt - 6))
end
# a seat typed by a declaration or a FORM whose own seat types did not resolve says nothing of its
# own: what a check would make of it is an echo of the refusal already made. (A seat typed by a
# declaration that did not READ needs no check of its own: that name is not declared, so the
# finding about the seat quotes it and is silenced with the rest of its consequences.)
func StzuSeatsTouchUnresolved(xSeats)
	for i = 1 to Len(xSeats)
		if InStrList(xSeats[i][2], $vStzuUnresolved) return true end
	end
	return false
end
func StzuIsUnresolved(tName)
	for i = 1 to Len($vStzuUnresolved)
		if $vStzuUnresolved[i] = tName return true end
	end
	return false
end
func StzuQuotesBroken(tMsg)
	for i = 1 to Len($vStzuBroken)
		if SubStr(tMsg, "'" + $vStzuBroken[i] + "'") > 0 return true end
	end
	return false
end
# after a declaration failed: when it failed in the PARSE, resume at the next DEFINE, and remember its
# name as broken, so that what quotes it, or is typed by it, says nothing of its own -- those are its
# consequences, not second defects. (Registering the name as declared would also have silenced the
# "resolves to nothing" findings, but no law needed it with the two checks above, so it is not done.)
# A declaration refused AFTER it parsed is already past; a duplicate name is the one refusal that
# leaves the first declaration of that name sound, so it breaks nothing.
func StzuBreak(bParsed, nStart, tErr)
	tName = ""
	if bParsed
		if SubStr(tErr, "is already declared") = 0
			tName = $xStzuLastName
		end
	else
		if nStart + 2 <= Len($xStzuToks)
			if $xStzuToks[nStart + 2][1] = "ident" and $xStzuToks[nStart + 1][1] = "keyword"
				tName = $xStzuToks[nStart + 2][2]
			end
		end
		if $nStzuPos <= nStart $nStzuPos = nStart + 1 end
		while StzuPeek()[1] != "eof"
			xT = StzuPeek()
			if xT[1] = "keyword" and xT[2] = "DEFINE" exit end
			StzuAdvance()
		end
	end
	if tName != "" $vStzuBroken + tName end
end
# the findings in the order of the file, ties in the order they were met
func StzuSortFound(xF)
	xOut = []
	for i = 1 to Len(xF)
		nAt = Len(xOut) + 1
		for j = Len(xOut) to 1 step -1
			if xOut[j][1] > xF[i][1]
				nAt = j
			else
				exit
			end
		end
		Insert(xOut, nAt - 1, xF[i])
	end
	return xOut
end
# ---- tokenizer --------------------------------------------------------------
# a token is [type, value, line]; types: string number ident keyword
# lparen rparen lbracket rbracket comma colon question dot eof

func StzuTokenize(tSrc)
	# v0.30: the one lexer (block_lib.haro) reads the text; the meta-court keeps its own words for what it refuses.
	# A comment is a value of the block and layout to the meta-court
	xToks = BlkTokenize(tSrc)
	xE = BlkLexError(xToks)
	if not IsEmpty(xE)
		if xE[2] = "unterminated_string"
			StzuFail(xE[3], "Unterminated string")
		elseif xE[2] = "mixed_case"
			StzuFail(xE[3], "'" + xE[4] + "' is neither a lower_snake identifier nor an UPPER_SNAKE keyword")
		elseif xE[2] = "number_glued"
			StzuFail(xE[3], "'" + xE[4] + "' is neither a number nor a word")
		elseif xE[2] = "doubled_quote"
			StzuFail(xE[3], "a doubled quote inside a string waits for C6's amendment (Q-B2): Ringua writes it; today a C6 string has no escape")
		else
			StzuFail(xE[3], "character '" + xE[4] + "' is not part of the stzu grammar")
		end
	end
	return BlkWithoutComments(xToks)
end
# ---- parser -----------------------------------------------------------------

func StzuPeek
	return $xStzuToks[$nStzuPos]
end
func StzuAdvance
	xT = $xStzuToks[$nStzuPos]
	$nStzuPos++
	return xT
end
func StzuExpect(tType, tWhat)
	xT = StzuPeek()
	if xT[1] != tType
		StzuFail(xT[3], "Expected " + tWhat + " but found '" + xT[2] + "'")
	end
	return StzuAdvance()
end
func StzuExpectKeyword(tV)
	xT = StzuPeek()
	if xT[1] != "keyword" or xT[2] != tV
		StzuFail(xT[3], "Expected " + tV + " but found '" + xT[2] + "'")
	end
	StzuAdvance()
end
func StzuParseNameList
	StzuExpect("lbracket", "'['")
	xNames = []
	while StzuPeek()[1] != "rbracket"
		xT = StzuExpect("ident", "an identifier")
		xNames + xT[2]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return xNames
end
# a seat is [name, of, isList, optional, line]
func StzuParseSeatList
	StzuExpect("lbracket", "'['")
	xSeats = []
	while StzuPeek()[1] != "rbracket"
		xName = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		bList = false
		tOf = ""
		if StzuPeek()[1] = "lbracket"
			StzuAdvance()
			bList = true
			xOf = StzuExpect("ident", "a seat type")
			tOf = xOf[2]
			StzuExpect("rbracket", "']'")
		else
			xOf = StzuExpect("ident", "a seat type")
			tOf = xOf[2]
		end
		bOpt = false
		if StzuPeek()[1] = "question"
			StzuAdvance()
			bOpt = true
		end
		xSeats + [xName[2], tOf, bList, bOpt, xName[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return xSeats
end
# a point is [decl, seat, word, line]: [ decl.seat: word, ... ]
func StzuParsePointList
	StzuExpect("lbracket", "'['")
	xPoints = []
	while StzuPeek()[1] != "rbracket"
		xD = StzuExpect("ident", "a declaration name")
		StzuExpect("dot", "'.'")
		xS = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		xW = StzuExpect("ident", "a word")
		xPoints + [xD[2], xS[2], xW[2], xD[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return xPoints
end
# an alternative of a UNION is [type, isList, line]: [ a, [b], ... ]   (v0.3)
func StzuParseTypeList
	StzuExpect("lbracket", "'['")
	vTypes = []
	while StzuPeek()[1] != "rbracket"
		bList = false
		if StzuPeek()[1] = "lbracket"
			StzuAdvance()
			bList = true
			xOf = StzuExpect("ident", "a type")
			StzuExpect("rbracket", "']'")
		else
			xOf = StzuExpect("ident", "a type")
		end
		vTypes + [xOf[2], bList, xOf[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return vTypes
end
# a context is [name, [variables], line]: [ seat: [a, b], ... ]   (v0.5)
func StzuParseContextList
	StzuExpect("lbracket", "'['")
	xCtx = []
	while StzuPeek()[1] != "rbracket"
		xN = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		xVars = StzuParseNameList()
		xCtx + [xN[2], xVars, xN[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return xCtx
end
# a path is a dotted name as written, with its line: [ seat, ref.seat, ... ]   (v0.6)
func StzuParsePathList
	StzuExpect("lbracket", "'['")
	vPaths = []
	while StzuPeek()[1] != "rbracket"
		xT = StzuExpect("ident", "a seat or a path")
		tP = xT[2]
		while StzuPeek()[1] = "dot"
			StzuAdvance()
			xT2 = StzuExpect("ident", "a seat name after '.'")
			tP += "." + xT2[2]
		end
		vPaths + [tP, xT[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return vPaths
end
# v0.32: a rule, between brackets, as the pattern engine reads it (BLOCKS.md 4.3): the tokens between the matching brackets
# rejoined into one line of C6. Comments are layout to the meta-court and go; a rule that holds both quote marks cannot ride in the
# source of a court, so it is refused here
func StzuParseRule
	xT0 = StzuExpect("lbracket", "'[': a rule is written [ ... ]")
	nDepth = 1
	tOut = "["
	tPrevT = "lbracket"
	while nDepth > 0
		xT = StzuPeek()
		if xT[1] = "eof"
			StzuFail(xT0[3], "a rule is not closed: the '[' on line " + String(xT0[3]) + " has no ']'")
		end
		StzuAdvance()
		tT = xT[1]
		tText = xT[2]
		if tT = "string" tText = '"' + xT[2] + '"' end
		if tT = "lbracket" nDepth++ end
		if tT = "rbracket" nDepth-- end
		bTight = tT = "rbracket" or tT = "rparen" or tT = "comma" or tT = "colon" or tT = "question" or tT = "dot" or tPrevT = "lbracket" or tPrevT = "lparen" or tPrevT = "dot"
		if not bTight tOut += " " end
		tOut += tText
		tPrevT = tT
	end
	if SubStr(tOut, '"') > 0 and SubStr(tOut, "'") > 0
		StzuFail(xT0[3], "a rule that holds a double quote and a single quote cannot ride into a court: spell the string without the apostrophe")
	end
	return tOut
end
# v0.32: a seat named as declaration.seat
func StzuParsePath(tClause)
	xT1 = StzuExpect("ident", "a declaration name")
	if tClause = "FIELDS"
		# v0.34: the seat of the kind asked, then the seat of the declaration it refers to
		StzuExpect("dot", "'.' after the seat: FIELDS is written seat.seat")
	else
		StzuExpect("dot", "'.' after the declaration: OVER names a seat as declaration.seat")
	end
	xT2 = StzuExpect("ident", "a seat name after '.'")
	return xT1[2] + "." + xT2[2]
end
# a string list: [ "a", "b", ... ]   (v0.11)
func StzuParseStringList
	StzuExpect("lbracket", "'['")
	xOut = []
	while StzuPeek()[1] != "rbracket"
		xT = StzuExpect("string", "a string")
		xOut + xT[2]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return xOut
end
# v0.28: CITES is a list of cites or the word none (HARO-MENU-CITES-01). The word reads as the string
# "none" and a list as a list, so a record tells "cites nothing" from "cites these" without a flag
func StzuParseCiteList
	xT = StzuPeek()
	if xT[1] = "ident"
		StzuAdvance()
		if xT[2] != "none"
			StzuFail(xT[3], "CITES is a list of cites or the word none, not '" + xT[2] + "'")
		end
		return "none"
	end
	return StzuParseStringList()
end
# a pair is [key, word, line]: [ key: word, ... ]   (v0.10)
func StzuParsePairList
	StzuExpect("lbracket", "'['")
	vPairs = []
	while StzuPeek()[1] != "rbracket"
		xK = StzuExpect("ident", "a name")
		StzuExpect("colon", "':'")
		xV = StzuExpect("ident", "a name")
		vPairs + [xK[2], xV[2], xK[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ']' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	return vPairs
end
# a message is [seat, text, line]: [ seat: "text", ... ]   (v0.3)
func StzuParseMessageList
	StzuExpect("lbracket", "'['")
	xMsgs = []
	while StzuPeek()[1] != "rbracket"
		xS = StzuExpect("ident", "a seat name")
		StzuExpect("colon", "':'")
		xT = StzuExpect("string", "a message string")
		xMsgs + [xS[2], xT[2], xS[3]]
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rbracket"
			xNext = StzuPeek()
			StzuFail(xNext[3], "Expected ',' or ']' but found '" + xNext[2] + "'")
		end
	end
	StzuAdvance()
	return xMsgs
end
func ClauseValue(xClauses, tName)
	for i = 1 to Len(xClauses)
		if xClauses[i][1] = tName return xClauses[i][2] end
	end
	return ""
end
func HasClause(xClauses, tName)
	for i = 1 to Len(xClauses)
		if xClauses[i][1] = tName return true end
	end
	return false
end
# one DEFINE <KIND> <name> AS ( clauses ) RATIONALE "..."
# returns [kind, name, clauses, rationale, line]
func StzuParseDeclaration
	xT = StzuPeek()
	if xT[1] != "keyword" or xT[2] != "DEFINE"
		StzuFail(xT[3], "Unknown verb '" + xT[2] + "'. The stzu verb set is closed -- a language is declared, never programmed.")
	end
	nDeclLine = xT[3]
	StzuAdvance()
	xKind = StzuPeek()
	if xKind[1] != "keyword" or not StzuIsKind(xKind[2])
		StzuFail(xKind[3], "Unknown declaration 'DEFINE " + xKind[2] + "'. The stzu verb set is closed -- a language is declared, never programmed.")
	end
	tKind = StzuAdvance()[2]
	xName = StzuExpect("ident", "a lower_snake name")
	tName = xName[2]
	StzuExpectKeyword("AS")
	StzuExpect("lparen", "'('")
	xClauses = []
	while StzuPeek()[1] != "rparen"
		xCt = StzuPeek()
		if xCt[1] != "keyword"
			StzuFail(xCt[3], "Expected a clause name but found '" + xCt[2] + "'")
		end
		tShape = StzuClauseShape(tKind, xCt[2])
		if tShape = ""
			StzuFail(xCt[3], "Unknown clause '" + xCt[2] + "' in " + tKind + " -- allowed: " + StzuAllowedList(tKind))
		end
		if HasClause(xClauses, xCt[2])
			StzuFail(xCt[3], "clause " + xCt[2] + " given twice")
		end
		StzuAdvance()
		if tShape = "string"
			xTv = StzuExpect("string", "a string")
			xClauses + [xCt[2], xTv[2]]
		elseif tShape = "namelist"
			xClauses + [xCt[2], StzuParseNameList()]
		elseif tShape = "seatlist"
			xClauses + [xCt[2], StzuParseSeatList()]
		elseif tShape = "number"
			xTv = StzuExpect("number", "a number")
			xClauses + [xCt[2], xTv[2]]
		elseif tShape = "ident"
			xTv = StzuExpect("ident", "a lower_snake name")
			xClauses + [xCt[2], xTv[2]]
		elseif tShape = "typelist"
			xClauses + [xCt[2], StzuParseTypeList()]
		elseif tShape = "messagelist"
			xClauses + [xCt[2], StzuParseMessageList()]
		elseif tShape = "contextlist"
			xClauses + [xCt[2], StzuParseContextList()]
		elseif tShape = "pathlist"
			xClauses + [xCt[2], StzuParsePathList()]
		elseif tShape = "pairlist"
			xClauses + [xCt[2], StzuParsePairList()]
		elseif tShape = "citelist"
			xClauses + [xCt[2], StzuParseCiteList()]
		elseif tShape = "stringlist"
			xClauses + [xCt[2], StzuParseStringList()]
		elseif tShape = "rule"
			xClauses + [xCt[2], StzuParseRule()]
		elseif tShape = "path"
			xClauses + [xCt[2], StzuParsePath(xCt[2])]
		else
			xClauses + [xCt[2], StzuParsePointList()]
		end
		if StzuPeek()[1] = "comma"
			StzuAdvance()
		elseif StzuPeek()[1] != "rparen"
			xT = StzuPeek()
			StzuFail(xT[3], "Expected ',' or ')' but found '" + xT[2] + "'")
		end
	end
	StzuAdvance()
	xRt = StzuPeek()
	if xRt[1] != "keyword" or xRt[2] != "RATIONALE"
		StzuFail(xRt[3], "every stzu declaration carries its RATIONALE (the commons, 3.8)")
	end
	StzuAdvance()
	xTr = StzuExpect("string", "the rationale string")
	xReq = StzuRequired(tKind)
	for i = 1 to Len(xReq)
		if not HasClause(xClauses, xReq[i])
			StzuFail(nDeclLine, tKind + " requires the " + xReq[i] + " clause")
		end
	end
	return [tKind, tName, xClauses, xTr[2], nDeclLine]
end
# ---- the language record ------------------------------------------------------
#   name version grammar court extension rationale
#   declarations: [name, verb, seats, rationale, line, names, messages]
#                 (names "" or a MENU/FORMAT; messages [seat, text, line] per reference seat, v0.3)
#   unions:       [name, alternatives, message, line]            (an alternative [type, isList, line], v0.3)
#   forms:        [name, seats, rationale, line]
#   expressions:  [name, operators, operands, aggregates, variables, rationale, line, contexts,
#                  absent, division, equality]
#                 (a context [seat, [variables], line], v0.5; the three semantics words
#                  "" when not declared, v0.6: ABSENT zero|refuse, DIVISION calm|refuse,
#                  EQUALITY kind|value)
#   walks:        [name, of, steps, through, order, guards, compute, formula, fail, line]
#                 (guards a list of [path, line]; compute, formula, fail "" when absent, v0.6)
#   ask:          [name, from kinds, where, clauses, rationale, line] or NULL   (v0.7)
#   run:          [name, [[role, [kind, seat, ...]], ...], rationale, line] or NULL   (v0.9)
#   symbols:      [name, kind, ref, message, line, code, cites]   (a seat type resolved against the world, v0.10; v0.11 code, cites)
#   narrate:      [name, opens, ends, refuses, says [[kind, template, line]], rationale, line, tells] or NULL   (v0.13; tells [[event, template, line]], v0.16)
#   formset:      [name, fluent, passive, statement, params, family, rationale, line] or NULL
#                 (v0.12: params [[key, suffix, line]], family [kind, base seat, forms seat] or [])
#   (v0.11) declarations gain codes [[seat, code, line]] as their eighth element; refusals gain code,
#   codes and cites as their sixth to eighth; menus, ranges, formats, unions and constraints a code last
#                 and world gains publish: [[kind, symbolkind, line], ...] as its fifth element
#   refusals:     [name, message, rationale, line, named]          (named [word, text, line] per trespasser, v0.8)
#   menus:        [name, words, message, line]
#   ranges:       [name, min, max, message, line]
#   formats:      [name, shape, message, line, fold]            (fold "" or "case", v0.4)
#   sentences:    [name, of, language record, message, refused, line]   (v0.4)
#   views:        [name, on, one, named, where, line]            (on "" for the whole sentence, v0.4)
#   constraints:  [name, on, when, then, message, line]        (then "" when absent)
#   (v0.28) menus, ranges, formats and unions gain their cites after their code; a cites value is a list of
#   cites, or the string "none" (CITES none: the refusal cites nothing), on every element that cites
#   world:        [one, first, line, entry] or NULL             (one and entry lists, first "" or a name; entry v0.8)
#   refine:       [points, floors] or NULL                       (lists of [decl, seat, word, line])

func LangGet(xLang, tKey)
	for i = 1 to Len(xLang)
		if xLang[i][1] = tKey return xLang[i][2] end
	end
	return ""
end
func DeclaredKind(vDeclared, tName)
	for i = 1 to Len(vDeclared)
		if vDeclared[i][1] = tName return vDeclared[i][2] end
	end
	return ""
end
func StzuDeclare(tSrc)
	$xStzuToks = StzuTokenize(tSrc)
	$nStzuPos = 1
	$vStzuWarnings = []
	$vStzuNotes = []

	if StzuPeek()[1] = "eof"
		StzuFail(1, "an empty file declares nothing -- a .haro file opens with DEFINE LANGUAGE")
	end

	bHaveLang = false
	tLName = "" tLVersion = "" tLGrammar = "" tLCourt = "" tLExtension = "" tLRationale = ""
	# v0.40: the doors the language NEEDS (D51), or NULL when it says nothing -- and what each kind OPENS, [verb, word, by seat]
	xLNeeds = "" nLNeedsLine = 0
	vOpensOut = []
	xDeclarations = []
	vForms = []
	vExpressions = []
	vRefusals = []
	vMenus = []
	vRanges = []
	vFormats = []
	xConstraints = []
	vPatterns = []
	vUnions = []
	vSentences = []
	xViews = []
	vWalks = []
	xAsk = ""
	xRun = ""
	xFormset = ""
	xNarrate = ""
	xUnderstand = ""
	vSymbols = []
	xWorld = ""
	xRefine = ""
	xConstitution = ""
	vDeclared = []
	vVerbs = []
	nCount = 0

	while StzuPeek()[1] != "eof"
		nStart = $nStzuPos
		nCount++
		bParsed = false
		try
			xD = StzuParseDeclaration()
			bParsed = true
			tKind = xD[1] tName = xD[2] xClauses = xD[3] tRationale = xD[4] nLine = xD[5]
			$xStzuLastName = tName
			if nCount = 1 and tKind != "LANGUAGE"
				StzuFail(nLine, "the LANGUAGE declaration comes first")
			end
			if tKind = "LANGUAGE"
				if bHaveLang
					StzuFail(nLine, "a .haro file declares exactly one LANGUAGE")
				end
				bHaveLang = true
				tLName = tName
				tLVersion = ClauseValue(xClauses, "VERSION")
				tLGrammar = ClauseValue(xClauses, "GRAMMAR")
				tLCourt = ClauseValue(xClauses, "COURT")
				tLExtension = ClauseValue(xClauses, "EXTENSION")
				tLRationale = tRationale
				if HasClause(xClauses, "NEEDS")
					xLNeeds = ClauseValue(xClauses, "NEEDS")
					nLNeedsLine = nLine
				end
			elseif tKind = "WORLD"
				if not IsEmpty(xWorld)
					StzuFail(nLine, "a .haro file declares at most one WORLD")
				end
				xOne = []
				if HasClause(xClauses, "ONE") xOne = ClauseValue(xClauses, "ONE") end
				tFirst = ""
				if HasClause(xClauses, "FIRST") tFirst = ClauseValue(xClauses, "FIRST") end
				# v0.8: the ENTRY kinds -- the first declaration of one of them is
				# where `reachable` starts walking
				xEntry = []
				if HasClause(xClauses, "ENTRY") xEntry = ClauseValue(xClauses, "ENTRY") end
				# v0.10: PUBLISH -- which kinds a sentence contributes to the world,
				# and as which symbol kind
				xPublish = []
				if HasClause(xClauses, "PUBLISH") xPublish = ClauseValue(xClauses, "PUBLISH") end
				xWorld = [xOne, tFirst, nLine, xEntry, xPublish]
			elseif tKind = "REFINE"
				if not IsEmpty(xRefine)
					StzuFail(nLine, "a .haro file declares at most one REFINE")
				end
				xFloors = []
				if HasClause(xClauses, "FLOOR") xFloors = ClauseValue(xClauses, "FLOOR") end
				xRefine = [ClauseValue(xClauses, "POINTS"), xFloors, nLine]
			elseif tKind = "CONSTITUTION"
				# v0.23: the constitution -- the articles a world declares itself under (charter 2,
				# ratified 2026-11-01); judged once the whole file is read, below
				if not IsEmpty(xConstitution)
					StzuFail(nLine, "a .haro file declares at most one CONSTITUTION")
				end
				xCWeaves = []
				if HasClause(xClauses, "WEAVES") xCWeaves = ClauseValue(xClauses, "WEAVES") end
				tCRegime = ""
				if HasClause(xClauses, "REGIME") tCRegime = ClauseValue(xClauses, "REGIME") end
				# v0.24: the zone seats of organizational_sovereignty (5): the zone kind, who holds it, what it is entered through
				tCZone = ""
				if HasClause(xClauses, "ZONE") tCZone = ClauseValue(xClauses, "ZONE") end
				tCSov = ""
				if HasClause(xClauses, "SOVEREIGN") tCSov = ClauseValue(xClauses, "SOVEREIGN") end
				tCMov = ""
				if HasClause(xClauses, "MOVEMENT") tCMov = ClauseValue(xClauses, "MOVEMENT") end
				# v0.25: the PERSONAL seats the weaves govern, as paths decl.seat
				xCPersonal = []
				if HasClause(xClauses, "PERSONAL") xCPersonal = ClauseValue(xClauses, "PERSONAL") end
				# v0.27: SAFEGUARDS [ask: consent | anonymisation, voice: redaction] -- what each path out of the world declares
				xCSafe = []
				if HasClause(xClauses, "SAFEGUARDS") xCSafe = ClauseValue(xClauses, "SAFEGUARDS") end
				xConstitution = [tName, ClauseValue(xClauses, "ARTICLES"), xCWeaves, tCRegime, nLine, tRationale, tCZone, tCSov, tCMov, xCPersonal, xCSafe]
			else
				if DeclaredKind(vDeclared, tName) != ""
					StzuFail(nLine, "'" + tName + "' is already declared -- one namespace, one name, one meaning")
				end
				vDeclared + [tName, tKind]
				if tKind = "DECLARATION"
					tVerb = ClauseValue(xClauses, "VERB")
					if not IsUpperSnake(tVerb)
						StzuFail(nLine, "VERB '" + tVerb + "' must be UPPER_SNAKE")
					end
					if InStrList(tVerb, vVerbs)
						StzuFail(nLine, "verb '" + tVerb + "' is already declared")
					end
					vVerbs + tVerb
					tNames = ""
					if HasClause(xClauses, "NAMES") tNames = ClauseValue(xClauses, "NAMES") end
					xMsgs = []
					if HasClause(xClauses, "MESSAGES") xMsgs = ClauseValue(xClauses, "MESSAGES") end
					# v0.11: a code per seat, for the envelope
					xCodes = StzuCodesOf(xClauses, nLine, tName)
					# v0.33: INCLUDES [form, ...] -- the seats of the FORMs come first; resolved after the whole file is read (form_expand.haro)
					xInc = []
					if HasClause(xClauses, "INCLUDES") xInc = ClauseValue(xClauses, "INCLUDES") end
					# v0.35: a severity per reference seat -- judged after the whole file is read, beside MESSAGES
					xSevs = []
					if HasClause(xClauses, "SEVERITIES") xSevs = ClauseValue(xClauses, "SEVERITIES") end
					# v0.40: OPENS -- a capability, or a seat whose MENU lists capabilities; judged after the whole file is read
					tOpens = ""
					if HasClause(xClauses, "OPENS") tOpens = ClauseValue(xClauses, "OPENS") end
					xDeclarations + [tName, tVerb, ClauseValue(xClauses, "SEATS"), tRationale, nLine, tNames, xMsgs, xCodes, xInc, xSevs, tOpens]
				elseif tKind = "FORM"
					vForms + [tName, ClauseValue(xClauses, "SEATS"), tRationale, nLine]
				elseif tKind = "EXPRESSION"
					xOps = ClauseValue(xClauses, "OPERATORS")
					for i = 1 to Len(xOps)
						if not InStrList(xOps[i], StzuOperators())
							StzuFail(nLine, "'" + xOps[i] + "' is not in the closed operator menu -- an escape hatch is unexpressible, not forbidden")
						end
					end
					xOpd = ClauseValue(xClauses, "OPERANDS")
					for i = 1 to Len(xOpd)
						if not InStrList(xOpd[i], StzuOperands())
							StzuFail(nLine, "'" + xOpd[i] + "' is not in the closed operand menu -- an escape hatch is unexpressible, not forbidden")
						end
					end
					xAgg = ""
					if HasClause(xClauses, "AGGREGATES")
						xAgg = ClauseValue(xClauses, "AGGREGATES")
						for i = 1 to Len(xAgg)
							if not InStrList(xAgg[i], StzuAggregates())
								StzuFail(nLine, "'" + xAgg[i] + "' is not in the closed aggregate menu")
							end
						end
					end
					xVars = ""
					if HasClause(xClauses, "VARIABLES")
						xVars = ClauseValue(xClauses, "VARIABLES")
					end
					# v0.5: the seats a host offers the expression, each with the
					# VARIABLES it admits
					xCtx = []
					if HasClause(xClauses, "CONTEXTS")
						xCtx = ClauseValue(xClauses, "CONTEXTS")
						if IsEmpty(xVars) StzuFail(nLine, "CONTEXTS requires a VARIABLES clause: a seat is a choice among the variables") end
						for i = 1 to Len(xCtx)
							for j = 1 to i - 1
								if xCtx[j][1] = xCtx[i][1]
									StzuFail(xCtx[i][3], "context '" + xCtx[i][1] + "' is named twice")
								end
							end
							for j = 1 to Len(xCtx[i][2])
								if not InStrList(xCtx[i][2][j], xVars)
									StzuFail(xCtx[i][3], "'" + xCtx[i][2][j] + "' is not a VARIABLE of " + tName + " (its VARIABLES: " + StzuJoin(xVars, ", ") + ")")
								end
							end
						end
					end
					# v0.6: the semantics an evaluator needs, each a closed choice
					tAbsent = ""
					if HasClause(xClauses, "ABSENT")
						tAbsent = ClauseValue(xClauses, "ABSENT")
						if tAbsent != "zero" and tAbsent != "missing" and tAbsent != "refuse"
							StzuFail(nLine, "ABSENT takes zero, missing or refuse: what a reference to nothing reads as; '" + tAbsent + "' is none of them")
						end
					end
					tDivision = ""
					if HasClause(xClauses, "DIVISION")
						tDivision = ClauseValue(xClauses, "DIVISION")
						if tDivision != "calm" and tDivision != "refuse"
							StzuFail(nLine, "DIVISION takes calm or refuse: what a division by zero yields; '" + tDivision + "' is neither")
						end
					end
					tEquality = ""
					if HasClause(xClauses, "EQUALITY")
						tEquality = ClauseValue(xClauses, "EQUALITY")
						if tEquality != "kind" and tEquality != "value"
							StzuFail(nLine, "EQUALITY takes kind or value: whether a number and a text can be equal; '" + tEquality + "' is neither")
						end
					end
					vExpressions + [tName, xOps, xOpd, xAgg, xVars, tRationale, nLine, xCtx, tAbsent, tDivision, tEquality]
				elseif tKind = "REFUSAL"
					if not InStrList(tName, StzuRefusalCategories())
						StzuFail(nLine, "'" + tName + "' is not a refusal category")
					end
					# v0.8: NAMED gives a known trespasser its own message -- an author
					# who writes FLOW or INVOKED_BY is told which law they met
					xNamedMsgs = []
					if HasClause(xClauses, "NAMED")
						xNamedMsgs = ClauseValue(xClauses, "NAMED")
						if tName != "unknown_declaration" and tName != "unknown_seat"
							StzuFail(nLine, "NAMED belongs to unknown_declaration and unknown_seat, the refusals a trespasser meets; '" + tName + "' is neither")
						end
					end
					tRCode = StzuCodeOf(xClauses, nLine, tName)
					xRCodes = StzuCodesOf(xClauses, nLine, tName)
					for i = 1 to Len(xRCodes)
						bNamed = false
						for j = 1 to Len(xNamedMsgs)
							if xNamedMsgs[j][1] = xRCodes[i][1] bNamed = true end
						end
						if not bNamed StzuFail(xRCodes[i][3], "CODES: '" + xRCodes[i][1] + "' is not a NAMED word of " + tName) end
					end
					xRCites = StzuCitesOf(xClauses, nLine, tName)
					# v0.35: a NAMED kind may be a warning -- read past and said. An unknown verb stops the parse, an unknown clause has no
					# declaration to belong to, a dangling reference is the seat's: only unknown_declaration's NAMED words can be read past
					xRSevs = []
					if HasClause(xClauses, "SEVERITIES")
						if tName != "unknown_declaration"
							StzuFail(nLine, "SEVERITIES belongs to unknown_declaration: a NAMED kind can be read past and said; '" + tName + "' cannot be a warning")
						end
						xRSevs = ClauseValue(xClauses, "SEVERITIES")
						StzuWantSeverities(xRSevs, "a NAMED word")
						for i = 1 to Len(xRSevs)
							bNamed = false
							for j = 1 to Len(xNamedMsgs)
								if xNamedMsgs[j][1] = xRSevs[i][1] bNamed = true end
							end
							if not bNamed StzuFail(xRSevs[i][3], "SEVERITIES: '" + xRSevs[i][1] + "' is not a NAMED word of " + tName) end
						end
					end
					vRefusals + [tName, ClauseValue(xClauses, "MESSAGE"), tRationale, nLine, xNamedMsgs, tRCode, xRCodes, xRCites, xRSevs]
				elseif tKind = "MENU"
					xWords = ClauseValue(xClauses, "WORDS")
					if Len(xWords) = 0
						StzuFail(nLine, "a MENU names at least one word")
					end
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					vMenus + [tName, xWords, tMsg, nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName)]
				elseif tKind = "RANGE"
					nMin = Number(ClauseValue(xClauses, "MIN"))
					nMax = Number(ClauseValue(xClauses, "MAX"))
					if nMin > nMax
						StzuFail(nLine, "RANGE " + tName + " has MIN above MAX (" + ClauseValue(xClauses, "MIN") + " > " + ClauseValue(xClauses, "MAX") + ")")
					end
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					vRanges + [tName, ClauseValue(xClauses, "MIN"), ClauseValue(xClauses, "MAX"), tMsg, nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName)]
				elseif tKind = "FORMAT"
					tShape = ClauseValue(xClauses, "SHAPE")
					if not InStrList(tShape, StzuShapes())
						StzuFail(nLine, "'" + tShape + "' is not a shape: the menu is absolute_path, ipv4, cidr, mac, label, domain, hex64, hex64_lower, duration, landmark, deadline")
					end
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					tFold = ""
					if HasClause(xClauses, "FOLD") tFold = ClauseValue(xClauses, "FOLD") end
					if tFold != "" and tFold != "case"
						StzuFail(nLine, "FOLD takes case, the one folding a court knows; '" + tFold + "' is not it")
					end
					vFormats + [tName, tShape, tMsg, nLine, tFold, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName)]
				elseif tKind = "SENTENCE"
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					tRefused = ""
					if HasClause(xClauses, "REFUSED") tRefused = ClauseValue(xClauses, "REFUSED") end
					vSentences + [tName, ClauseValue(xClauses, "OF"), "", tMsg, tRefused, nLine]
				elseif tKind = "VIEW"
					tOn = ""
					if HasClause(xClauses, "ON") tOn = ClauseValue(xClauses, "ON") end
					tNamed = ""
					if HasClause(xClauses, "NAMED") tNamed = ClauseValue(xClauses, "NAMED") end
					tWhere = ""
					if HasClause(xClauses, "WHERE") tWhere = ClauseValue(xClauses, "WHERE") end
					xViews + [tName, tOn, ClauseValue(xClauses, "ONE"), tNamed, tWhere, nLine]
				elseif tKind = "SYMBOL"
					tSKind = ClauseValue(xClauses, "KIND")
					for i = 1 to Len(vSymbols)
						if vSymbols[i][2] = tSKind
							StzuFail(nLine, "SYMBOL " + tName + " already resolves to " + tSKind + " through " + vSymbols[i][1] + ": one name, one meaning")
						end
					end
					tRef = ""
					if HasClause(xClauses, "REF") tRef = ClauseValue(xClauses, "REF") end
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					vSymbols + [tName, tSKind, tRef, tMsg, nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName)]
				elseif tKind = "FORMS"
					# v0.12: a vocabulary's function-name grammar as data (principle 7)
					if not IsEmpty(xFormset)
						StzuFail(nLine, "a .haro file declares at most one FORMS: a vocabulary spells its families one way (" + xFormset[1] + " is it)")
					end
					tFluent = ""
					if HasClause(xClauses, "FLUENT") tFluent = ClauseValue(xClauses, "FLUENT") end
					tPassive = ""
					if HasClause(xClauses, "PASSIVE") tPassive = ClauseValue(xClauses, "PASSIVE") end
					tStmt = ""
					if HasClause(xClauses, "STATEMENT") tStmt = ClauseValue(xClauses, "STATEMENT") end
					xParams = ClauseValue(xClauses, "PARAMS")
					vSpelt = []
					if tFluent != ""
						StzuWantSuffix(tFluent, nLine, "FLUENT")
						vSpelt + ["FLUENT", tFluent]
					end
					if tPassive != ""
						StzuWantSuffix(tPassive, nLine, "PASSIVE")
						StzuWantOneMeaning(vSpelt, "PASSIVE", tPassive, nLine)
						vSpelt + ["PASSIVE", tPassive]
					end
					if tStmt != ""
						StzuWantSuffix(tStmt, nLine, "STATEMENT")
						StzuWantOneMeaning(vSpelt, "STATEMENT", tStmt, nLine)
						vSpelt + ["STATEMENT", tStmt]
					end
					for i = 1 to Len(xParams)
						if xParams[i][1] = "fluent" or xParams[i][1] = "passive"
							StzuFail(xParams[i][3], "PARAMS: '" + xParams[i][1] + "' is the " + Upper(xParams[i][1]) + " role's own word, not a parameter suffix")
						end
						StzuWantSuffix(xParams[i][2], xParams[i][3], "PARAMS." + xParams[i][1])
						StzuWantOneMeaning(vSpelt, xParams[i][1], xParams[i][2], xParams[i][3])
						vSpelt + [xParams[i][1], xParams[i][2]]
					end
					xFamily = []
					if HasClause(xClauses, "FAMILY")
						xFamily = ClauseValue(xClauses, "FAMILY")
						if Len(xFamily) != 3
							StzuFail(nLine, "FAMILY is [kind, base seat, forms seat]: the declaration kind that declares a family, its base-verb seat and its offered-forms seat")
						end
					end
					xFormset = [tName, tFluent, tPassive, tStmt, xParams, xFamily, tRationale, nLine]
				elseif tKind = "NARRATE"
					# v0.13: how a run of the language is narrated back -- a voice, never stored, never parsed back
					if not IsEmpty(xNarrate)
						StzuFail(nLine, "a .haro file declares at most one NARRATE: a language has one voice (" + xNarrate[1] + " is it)")
					end
					tOpens = ""
					if HasClause(xClauses, "OPENS") tOpens = ClauseValue(xClauses, "OPENS") end
					tEnds = ""
					if HasClause(xClauses, "ENDS") tEnds = ClauseValue(xClauses, "ENDS") end
					tRefuses = ""
					if HasClause(xClauses, "REFUSES") tRefuses = ClauseValue(xClauses, "REFUSES") end
					# v0.16: a voice SAYS what a sentence is, TELLS what a run did, or both; one that does neither narrates nothing
					if not HasClause(xClauses, "SAYS") and not HasClause(xClauses, "TELLS")
						StzuFail(nLine, "NARRATE requires the SAYS clause or the TELLS clause: a voice that says and tells nothing narrates nothing")
					end
					xSays = []
					if HasClause(xClauses, "SAYS") xSays = ClauseValue(xClauses, "SAYS") end
					xTells = []
					if HasClause(xClauses, "TELLS") xTells = ClauseValue(xClauses, "TELLS") end
					for i = 1 to Len(xSays)
						for j = 1 to i - 1
							if xSays[j][1] = xSays[i][1]
								StzuFail(xSays[i][3], "SAYS: '" + xSays[i][1] + "' is voiced twice")
							end
						end
					end
					for i = 1 to Len(xTells)
						for j = 1 to i - 1
							if xTells[j][1] = xTells[i][1]
								StzuFail(xTells[i][3], "TELLS: '" + xTells[i][1] + "' is told twice")
							end
						end
					end
					xNarrate = [tName, tOpens, tEnds, tRefuses, xSays, tRationale, nLine, xTells]
				elseif tKind = "RUN"
					if not IsEmpty(xRun)
						StzuFail(nLine, "a .haro file declares at most one RUN: a language runs one way (" + xRun[1] + " is it)")
					end
					xRoles = []
					vRoleNames = ["OF", "COMPUTE", "COLLECT", "GROUP", "BRANCH", "ITERATE"]
					for i = 1 to Len(vRoleNames)
						if HasClause(xClauses, vRoleNames[i]) xRoles + [vRoleNames[i], ClauseValue(xClauses, vRoleNames[i])] end
					end
					xRun = [tName, xRoles, tRationale, nLine]
				elseif tKind = "UNDERSTAND"
					# v0.17: how a human language reaches closed questions -- the kinds that play the eight roles of N
					if not IsEmpty(xUnderstand)
						StzuFail(nLine, "a .haro file declares at most one UNDERSTAND: a language is understood one way (" + xUnderstand[1] + " is it)")
					end
					xRoles = []
					vRoleNames = ["TONGUE", "MEANING", "ALIAS", "SURFACE", "STEP", "FRAME", "EXAMPLE", "COUNTEREXAMPLE"]
					for i = 1 to Len(vRoleNames)
						xRoles + [vRoleNames[i], ClauseValue(xClauses, vRoleNames[i])]
					end
					xUnderstand = [tName, xRoles, tRationale, nLine]
				elseif tKind = "ASK"
					if not IsEmpty(xAsk)
						StzuFail(nLine, "a .haro file declares at most one ASK: a language asks in one grammar (" + xAsk[1] + " is it)")
					end
					tWhere = ""
					if HasClause(xClauses, "WHERE") tWhere = ClauseValue(xClauses, "WHERE") end
					xCl = []
					if HasClause(xClauses, "CLAUSES") xCl = ClauseValue(xClauses, "CLAUSES") end
					tAskFields = ""
					if HasClause(xClauses, "FIELDS") tAskFields = ClauseValue(xClauses, "FIELDS") end
					xAsk = [tName, ClauseValue(xClauses, "FROM"), tWhere, xCl, tRationale, nLine, tAskFields]
				elseif tKind = "WALK"
					xGuards = []
					if HasClause(xClauses, "GUARDS") xGuards = ClauseValue(xClauses, "GUARDS") end
					tCompute = ""
					if HasClause(xClauses, "COMPUTE") tCompute = ClauseValue(xClauses, "COMPUTE") end
					tFormula = ""
					if HasClause(xClauses, "FORMULA") tFormula = ClauseValue(xClauses, "FORMULA") end
					tFailSeat = ""
					if HasClause(xClauses, "FAIL") tFailSeat = ClauseValue(xClauses, "FAIL") end
					vWalks + [tName, ClauseValue(xClauses, "OF"), ClauseValue(xClauses, "STEPS"), ClauseValue(xClauses, "THROUGH"),
					          ClauseValue(xClauses, "ORDER"), xGuards, tCompute, tFormula, tFailSeat, nLine]
				elseif tKind = "UNION"
					xAlts = ClauseValue(xClauses, "OF")
					if Len(xAlts) < 2
						StzuFail(nLine, "a UNION names at least two alternatives")
					end
					tMsg = ""
					if HasClause(xClauses, "MESSAGE") tMsg = ClauseValue(xClauses, "MESSAGE") end
					vUnions + [tName, xAlts, tMsg, nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName)]
				elseif tKind = "PATTERN"
					# v0.32: OVER kind.seat, MATCH [rule], SETS [kind.seat: set]; resolved after the whole file is read
					tOver = ClauseValue(xClauses, "OVER")
					nDotAt = SubStr(tOver, ".")
					tPSev = "error"
					if HasClause(xClauses, "SEVERITY") tPSev = ClauseValue(xClauses, "SEVERITY") end
					if tPSev != "error" and tPSev != "warning"
						StzuFail(nLine, "'" + tPSev + "' is not a SEVERITY of a PATTERN: error or warning")
					end
					xPSets = []
					if HasClause(xClauses, "SETS") xPSets = ClauseValue(xClauses, "SETS") end
					vPatterns + [tName, Left(tOver, nDotAt - 1), SubStr(tOver, nDotAt + 1), ClauseValue(xClauses, "MATCH"), xPSets, ClauseValue(xClauses, "MESSAGE"), nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName), tPSev]
				else
					# CONSTRAINT: resolved after the whole file is read
					tThen = ""
					if HasClause(xClauses, "THEN") tThen = ClauseValue(xClauses, "THEN") end
					# v0.23: CITES on a CONSTRAINT -- the pinned instruments the maker's own rule cites (stzzui's S2)
					# v0.25: SEVERITY -- error (the court refuses) or warning (the court speaks it after its verdict); stzzui's S1
					tCnSev = "error"
					if HasClause(xClauses, "SEVERITY") tCnSev = ClauseValue(xClauses, "SEVERITY") end
					if tCnSev != "error" and tCnSev != "warning"
						StzuFail(nLine, "'" + tCnSev + "' is not a SEVERITY of a CONSTRAINT: error or warning")
					end
					# v0.33: EXCEPT [kind, ...] -- the kinds a constraint ON a FORM is not made for (form_expand.haro)
					xCnExc = []
					if HasClause(xClauses, "EXCEPT") xCnExc = ClauseValue(xClauses, "EXCEPT") end
					xConstraints + [tName, ClauseValue(xClauses, "ON"), ClauseValue(xClauses, "WHEN"), tThen, ClauseValue(xClauses, "MESSAGE"), nLine, StzuCodeOf(xClauses, nLine, tName), StzuCitesOf(xClauses, nLine, tName), tCnSev, xCnExc]
				end
			end
		catch
			tErr = cCatchError
			# the first declaration unreadable: there is no language to judge the rest by
			if nCount = 1 Raise(tErr) end
			StzuNote(tErr)
			StzuBreak(bParsed, nStart, tErr)
		end
	end

	# v0.33: INCLUDES, ON a FORM and a quantifier over a FORM are sugar: resolved here, before any pass reads a kind's seats (form_expand.haro)
	xDeclarations = StzuExpandIncludes(xDeclarations, vForms, vDeclared)
	xFormTab = StzuFormTable(xDeclarations)
	xConstraints = StzuExpandConstraints(xConstraints, xFormTab, xDeclarations, vDeclared)
	xViews = StzuExpandViews(xViews, xFormTab, xDeclarations)

	# the resolution pass (order-free; a name resolving to nothing is refused now)
	$xStzuUnions = vUnions
	for i = 1 to Len(xDeclarations)
		try
			StzuResolveSeats(xDeclarations[i][3], vDeclared)
			tNames = xDeclarations[i][6]
			if tNames != ""
				tK = DeclaredKind(vDeclared, tNames)
				if tK = ""
					StzuFail(xDeclarations[i][5], "NAMES '" + tNames + "' resolves to nothing in this declaration")
				end
				if tK != "MENU" and tK != "FORMAT"
					StzuFail(xDeclarations[i][5], "NAMES must name a MENU or a FORMAT; '" + tNames + "' is a " + tK)
				end
			end
		catch
			StzuNote(cCatchError)
			$vStzuUnresolved + xDeclarations[i][1]
		end
	end
	for i = 1 to Len(vForms)
		try
			StzuResolveSeats(vForms[i][2], vDeclared)
		catch
			StzuNote(cCatchError)
			$vStzuUnresolved + vForms[i][1]
		end
	end
	# v0.6: a list of a FORM writes one value an item (a one-seat FORM) or a
	# name: value pair an item (a two-seat FORM whose first seat is a name)
	for i = 1 to Len(xDeclarations)
		try
			if not StzuSeatsTouchUnresolved(xDeclarations[i][3]) StzuCheckListForms(xDeclarations[i][3], vDeclared, vForms) end
		catch
			StzuNote(cCatchError)
		end
	end
	for i = 1 to Len(vForms)
		try
			if not StzuSeatsTouchUnresolved(vForms[i][2]) StzuCheckListForms(vForms[i][2], vDeclared, vForms) end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.3: a UNION's alternatives are value types, told apart by shape
	for i = 1 to Len(vUnions)
		try
			xU = vUnions[i]
			xAlts = xU[2]
			vShapes = []
			for j = 1 to Len(xAlts)
				tShape = StzuAltShape(xAlts[j], vDeclared, vForms, xU[4])
				for k = 1 to Len(vShapes)
					if vShapes[k] = tShape
						# v0.8: two DECLARATIONs share the shape "word" and are told
						# apart by the name's resolution, in one namespace
						if DeclaredKind(vDeclared, xAlts[k][1]) = "DECLARATION" and DeclaredKind(vDeclared, xAlts[j][1]) = "DECLARATION" loop end
						StzuFail(xU[4], "'" + xAlts[k][1] + "' and '" + xAlts[j][1] + "' have the same shape (" + tShape + "): a UNION's alternatives are told apart by shape")
					end
				end
				vShapes + tShape
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.13: a NARRATE voices declared kinds, and fills only placeholders it can fill
	if not IsEmpty(xNarrate)
		try
			xSays = xNarrate[5]
			for i = 1 to Len(xSays)
				xNK = ""
				for j = 1 to Len(xDeclarations)
					if xDeclarations[j][1] = xSays[i][1] xNK = xDeclarations[j] end
				end
				if IsEmpty(xNK) StzuFail(xSays[i][3], "SAYS: no declaration '" + xSays[i][1] + "' in " + tLName) end
				vOk = ["name", "verb", "rationale", "line"]
				for j = 1 to Len(xNK[3])
					vOk + xNK[3][j][1]
				end
				StzuCheckTemplate(xSays[i][2], vOk, xSays[i][3], "SAYS " + xSays[i][1])
			end
			# v0.16: TELLS names an event of a run or of a question, or a declaration that plays a construct of the RUN
			xTells = xNarrate[8]
			for i = 1 to Len(xTells)
				xOkT = StzuTellPlaceholders(xTells[i][1], xDeclarations, xRun, xAsk, tLName, xTells[i][3])
				StzuCheckTemplate(xTells[i][2], xOkT, xTells[i][3], "TELLS " + xTells[i][1])
			end
			if xNarrate[2] != "" StzuCheckTemplate(xNarrate[2], ["language", "file", "count"], xNarrate[7], "OPENS") end
			if xNarrate[3] != "" StzuCheckTemplate(xNarrate[3], ["language", "file", "count"], xNarrate[7], "ENDS") end
			if xNarrate[4] != "" StzuCheckTemplate(xNarrate[4], ["language", "file", "line", "code", "message", "cites"], xNarrate[7], "REFUSES") end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.12: a FORMS' FAMILY names a declared kind, a scalar base seat and a list forms seat
	if not IsEmpty(xFormset)
		try
			if Len(xFormset[6]) = 3
				xFam = xFormset[6]
				xFK = ""
				for i = 1 to Len(xDeclarations)
					if xDeclarations[i][1] = xFam[1] xFK = xDeclarations[i] end
				end
				if IsEmpty(xFK) StzuFail(xFormset[8], "FAMILY: no declaration '" + xFam[1] + "'") end
				xBS = StzuSeatNamed(xFK[3], xFam[2])
				if IsEmpty(xBS) StzuFail(xFormset[8], "FAMILY: no seat '" + xFam[2] + "' on " + xFam[1]) end
				if xBS[3] StzuFail(xFormset[8], "FAMILY: the base seat '" + xFam[2] + "' of " + xFam[1] + " is one verb, not a list") end
				xFS = StzuSeatNamed(xFK[3], xFam[3])
				if IsEmpty(xFS) StzuFail(xFormset[8], "FAMILY: no seat '" + xFam[3] + "' on " + xFam[1]) end
				if not xFS[3] StzuFail(xFormset[8], "FAMILY: the forms seat '" + xFam[3] + "' of " + xFam[1] + " is a list of the forms offered") end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.11: CODES name seats of the declaration
	for i = 1 to Len(xDeclarations)
		try
			xCd = xDeclarations[i][8]
			for j = 1 to Len(xCd)
				if IsEmpty(StzuSeatNamed(xDeclarations[i][3], xCd[j][1]))
					StzuFail(xCd[j][3], "CODES: no seat '" + xCd[j][1] + "' on " + xDeclarations[i][1])
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.35: SEVERITIES holds a reference seat at warning: a seat of the kind, named once, error or warning, and a REFERENCE -- only a
	# reference that resolves to nothing may be a warning; a value of the wrong shape never is
	for i = 1 to Len(xDeclarations)
		try
			if Len(xDeclarations[i]) < 10 loop end
			if StzuIsUnresolved(xDeclarations[i][1]) or StzuSeatsTouchUnresolved(xDeclarations[i][3]) loop end
			xSv = xDeclarations[i][10]
			StzuWantSeverities(xSv, "a seat")
			for j = 1 to Len(xSv)
				xSvSeat = StzuSeatNamed(xDeclarations[i][3], xSv[j][1])
				if IsEmpty(xSvSeat) StzuFail(xSv[j][3], "SEVERITIES: no seat '" + xSv[j][1] + "' on " + xDeclarations[i][1]) end
				if not StzuIsReferenceSeat(xSvSeat, vDeclared, vForms, vUnions)
					StzuFail(xSv[j][3], "SEVERITIES: '" + xSv[j][1] + "' of " + xDeclarations[i][1] + " is not a reference: only a reference that resolves to nothing may be a warning")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end
	# v0.40: NEEDS and OPENS (D51) -- the doors a language's worlds may open. NEEDS names words of the nine, each once; a kind OPENS a
	# capability the LANGUAGE NEEDS, or a seat whose MENU lists capabilities; a kind that OPENS in a language that NEEDS nothing is refused
	# (silence refuses); a NEEDS word no kind can open is refused (least authority) -- a word of an OPENS seat's MENU counts as one a kind
	# can open. A language with neither clause is exactly what it was.
	try
		if not IsEmpty(xLNeeds)
			for i = 1 to Len(xLNeeds)
				if not InStrList(xLNeeds[i], StzuCapabilities())
					StzuFail(nLNeedsLine, "NEEDS: '" + xLNeeds[i] + "' is not a capability; the nine are " + StzuCapabilityList())
				end
				for j = 1 to i - 1
					if xLNeeds[j] = xLNeeds[i] StzuFail(nLNeedsLine, "NEEDS: '" + xLNeeds[i] + "' is named twice") end
				end
			end
		end
	catch
		StzuNote(cCatchError)
	end
	vOpened = []
	for i = 1 to Len(xDeclarations)
		try
			if Len(xDeclarations[i]) < 11 loop end
			tOp = xDeclarations[i][11]
			if tOp = "" loop end
			tKn = xDeclarations[i][1]
			bBySeat = false
			if InStrList(tOp, StzuCapabilities())
				xCanOpen = [tOp]
			else
				xOs = StzuSeatNamed(xDeclarations[i][3], tOp)
				if IsEmpty(xOs) StzuFail(xDeclarations[i][5], "OPENS: '" + tOp + "' is neither a capability nor a seat of " + tKn) end
				xCanOpen = StzuMenuWords(vMenus, xOs[2])
				if IsEmpty(xCanOpen) StzuFail(xDeclarations[i][5], "OPENS: the seat '" + tOp + "' of " + tKn + " is not a MENU of capabilities") end
				for j = 1 to Len(xCanOpen)
					if not InStrList(xCanOpen[j], StzuCapabilities())
						StzuFail(xDeclarations[i][5], "OPENS: the seat '" + tOp + "' of " + tKn + " is a MENU holding '" + xCanOpen[j] + "', which is not a capability")
					end
				end
				bBySeat = true
			end
			if IsEmpty(xLNeeds)
				StzuFail(xDeclarations[i][5], tKn + " OPENS " + tOp + ", and the LANGUAGE " + tLName + " NEEDS nothing: a door a kind opens is NEEDED first")
			end
			if not bBySeat and not InStrList(tOp, xLNeeds)
				StzuFail(xDeclarations[i][5], tKn + " OPENS " + tOp + ", and the LANGUAGE " + tLName + " does not NEED it")
			end
			for j = 1 to Len(xCanOpen) vOpened + xCanOpen[j] end
			vOpensOut + [xDeclarations[i][2], tOp, bBySeat]
		catch
			StzuNote(cCatchError)
		end
	end
	try
		if not IsEmpty(xLNeeds)
			for i = 1 to Len(xLNeeds)
				if not InStrList(xLNeeds[i], vOpened) StzuFail(nLNeedsLine, "NEEDS " + xLNeeds[i] + ", and no kind OPENS it") end
			end
		end
	catch
		StzuNote(cCatchError)
	end
	# v0.3: MESSAGES speaks for a reference seat
	for i = 1 to Len(xDeclarations)
		try
			# v0.15: a seat whose type resolved to nothing is not yet a reference seat or a plain one, so what
			# MESSAGES says of it would be an echo of the refusal already made
			if StzuIsUnresolved(xDeclarations[i][1]) or StzuSeatsTouchUnresolved(xDeclarations[i][3]) loop end
			xMsgs = xDeclarations[i][7]
			xSeats = xDeclarations[i][3]
			for j = 1 to Len(xMsgs)
				xFound = ""
				for k = 1 to Len(xSeats)
					if xSeats[k][1] = xMsgs[j][1] xFound = xSeats[k] end
				end
				if IsEmpty(xFound)
					StzuFail(xMsgs[j][3], "MESSAGES: no seat '" + xMsgs[j][1] + "' on " + xDeclarations[i][1])
				end
				bRef = false
				if DeclaredKind(vDeclared, xFound[2]) = "DECLARATION" bRef = true end
				# v0.9: a list of references to several kinds
				if xFound[3] and DeclaredKind(vDeclared, xFound[2]) = "UNION" bRef = true end
				# v0.8: a list of pairs whose keys or values are references
				if xFound[3] and DeclaredKind(vDeclared, xFound[2]) = "FORM"
					for k = 1 to Len(vForms)
						if vForms[k][1] = xFound[2] and StzuIsPairForm(vForms[k][2], vDeclared)
							if StzuPairRefs(vForms[k][2], vDeclared) bRef = true end
						end
					end
				end
				bReq = true
				if xFound[3] or xFound[4] bReq = false end
				if not bRef and not bReq
					StzuFail(xMsgs[j][3], "MESSAGES speaks for a reference seat when its name resolves to nothing, or for a required seat when it is absent; '" + xMsgs[j][1] + "' is neither")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.15: a collecting meta-court judges the RELATIONS among declarations -- sentences, views, constraints,
	# walks, the ask, the run, the points -- only once every declaration reads and every type resolves. A
	# relation between declarations is undefined while one of them is not there to relate: what a view, a
	# constraint or a walk would say of it is an echo of the defect already found, not a second defect.
	# The parser and the checker of RingFlex stand on the same barrier. A run that is not collecting
	# never reaches this line having found anything, so its verdicts are what they were.
	if $bStzuCollect
		if Len($vStzuFound) > 0 return "" end
	end

	# v0.4: a SENTENCE names another language's declaration, read beside this
	# one and judged by this same meta-court; its record is kept for the paths
	# that read through it
	for i = 1 to Len(vSentences)
		try
			xS = vSentences[i]
			tPath = xS[2]
			if $tStzuDir != "" tPath = $tStzuDir + "/" + tPath end
			if not FExists(tPath)
				StzuFail(xS[6], "SENTENCE " + xS[1] + ": '" + xS[2] + "' cannot be read from beside this declaration")
			end
			tInnerSrc = Read(tPath)
			xSaveToks = $xStzuToks
			nSavePos = $nStzuPos
			tSaveDir = $tStzuDir
			$tStzuDir = StzuDirOf(tPath)
			tErr = ""
			xInner = ""
			bWas = $bStzuCollect
			$bStzuCollect = false
			try
				xInner = StzuDeclare(tInnerSrc)
			catch
				tErr = cCatchError
			end
			$bStzuCollect = bWas
			$xStzuToks = xSaveToks
			$nStzuPos = nSavePos
			$tStzuDir = tSaveDir
			if tErr != ""
				StzuFail(xS[6], "SENTENCE " + xS[1] + ": " + xS[2] + " is refused: " + tErr)
			end
			vSentences[i][3] = xInner
		catch
			StzuNote(cCatchError)
		end
	end

	# menu coherence, both ways
	for i = 1 to Len(vExpressions)
		try
			xE = vExpressions[i]
			bVar = false bAgg = false
			xOpd = xE[3]
			for j = 1 to Len(xOpd)
				if xOpd[j] = "var" bVar = true end
				if xOpd[j] = "agg" bAgg = true end
			end
			if bVar and IsEmpty(xE[5]) StzuFail(xE[7], "operand 'var' requires a VARIABLES clause") end
			if not IsEmpty(xE[5]) and not bVar StzuFail(xE[7], "a VARIABLES clause requires operand 'var'") end
			if bAgg and IsEmpty(xE[4]) StzuFail(xE[7], "operand 'agg' requires an AGGREGATES clause") end
			if not IsEmpty(xE[4]) and not bAgg StzuFail(xE[7], "an AGGREGATES clause requires operand 'agg'") end
		catch
			StzuNote(cCatchError)
		end
	end

	# the WORLD: ONE and FIRST name declarations
	xOneDecls = []
	if not IsEmpty(xWorld)
		try
			xOne = xWorld[1]
			for i = 1 to Len(xOne)
				tK = DeclaredKind(vDeclared, xOne[i])
				if tK = "" StzuFail(xWorld[3], "ONE: '" + xOne[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xWorld[3], "ONE must name a DECLARATION; '" + xOne[i] + "' is a " + tK) end
			end
			xOneDecls = xOne
			if xWorld[2] != ""
				tK = DeclaredKind(vDeclared, xWorld[2])
				if tK = "" StzuFail(xWorld[3], "FIRST: '" + xWorld[2] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xWorld[3], "FIRST must name a DECLARATION; '" + xWorld[2] + "' is a " + tK) end
			end
			xEntry = xWorld[4]
			for i = 1 to Len(xEntry)
				tK = DeclaredKind(vDeclared, xEntry[i])
				if tK = "" StzuFail(xWorld[3], "ENTRY: '" + xEntry[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xWorld[3], "ENTRY must name a DECLARATION; '" + xEntry[i] + "' is a " + tK) end
			end
			xPublish = xWorld[5]
			for i = 1 to Len(xPublish)
				tK = DeclaredKind(vDeclared, xPublish[i][1])
				if tK = "" StzuFail(xPublish[i][3], "PUBLISH: '" + xPublish[i][1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xPublish[i][3], "PUBLISH must name a DECLARATION; '" + xPublish[i][1] + "' is a " + tK) end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# the condition tables: this language and the languages its SENTENCEs name
	vRec = [ ["name", tLName], ["version", tLVersion], ["grammar", tLGrammar],
	         ["court", tLCourt], ["extension", tLExtension], ["rationale", tLRationale],
	         ["declarations", xDeclarations], ["forms", vForms],
	         ["expressions", vExpressions], ["refusals", vRefusals],
	         ["menus", vMenus], ["ranges", vRanges], ["formats", vFormats],
	         ["constraints", xConstraints], ["world", xWorld], ["refine", xRefine],
	         ["unions", vUnions], ["sentences", vSentences], ["views", xViews],
	         ["walks", vWalks], ["ask", xAsk], ["run", xRun], ["symbols", vSymbols],
	         ["formset", xFormset], ["narrate", xNarrate], ["understand", xUnderstand],
	         ["constitution", xConstitution], ["patterns", vPatterns],
	         ["needs", xLNeeds], ["opens", vOpensOut] ]
	$tCondLang = tLName
	$xCondLangs = StzuCondLangs(vRec, [])
	$xCondFormats = []
	for i = 1 to Len(vFormats)
		try
			$xCondFormats + [vFormats[i][1], vFormats[i][2]]
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.4: the VIEWs, in order (a VIEW reads the VIEWs declared before it)
	vViewEntries = []
	for i = 1 to Len(xViews)
		try
			xV = xViews[i]
			tOn = xV[2]
			if tOn != ""
				tK = DeclaredKind(vDeclared, tOn)
				if tK = "" StzuFail(xV[6], "ON: '" + tOn + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xV[6], "ON must name a DECLARATION; '" + tOn + "' is a " + tK) end
				if StzuHasSeat(xDeclarations, tOn, xV[1])
					StzuFail(xV[6], "VIEW '" + xV[1] + "' is already a seat of " + tOn + ": one name, one meaning")
				end
			end
			xOut = [""]
			tErr = ""
			tWhy = ""
			try
				tWhy = CondValidateView([xV[1], tOn, xV[3], xV[4], xV[5]], tLName, xOut)
			catch
				tErr = cCatchError
			end
			if tErr != "" StzuFail(xV[6], "VIEW " + xV[1] + ": " + tErr) end
			if tWhy != "" StzuFail(xV[6], "VIEW " + xV[1] + ": " + tWhy) end
			vViewEntries + [xV[1], tOn, xOut[1], xV[3], xV[4], xV[5]]
			$xCondLangs = StzuCondLangs(vRec, vViewEntries)
		catch
			StzuNote(cCatchError)
		end
	end

	# the CONSTRAINTs: ON names a declaration; every name a condition uses exists
	for i = 1 to Len(xConstraints)
		try
			xC = xConstraints[i]
			tK = DeclaredKind(vDeclared, xC[2])
			if tK = "" StzuFail(xC[6], "ON: '" + xC[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(xC[6], "ON must name a DECLARATION; '" + xC[2] + "' is a " + tK) end
			StzuCheckCondition(xC[3], xC[2], xOneDecls, xC[6])
			if xC[4] != ""
				StzuCheckCondition(xC[4], xC[2], xOneDecls, xC[6])
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.32: the PATTERNs. OVER and SETS name seats that exist; a set has one declaration and is neither a MENU nor a kind; the rules, taken
	# together, are judged by the pattern engine's own declaration -- the bound, the names, no recursion -- in its own words
	vSetSeen = []
	for i = 1 to Len(vPatterns)
		try
			xP = vPatterns[i]
			tK = DeclaredKind(vDeclared, xP[2])
			if tK = "" StzuFail(xP[7], "OVER: '" + xP[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(xP[7], "OVER must name a DECLARATION; '" + xP[2] + "' is a " + tK) end
			if IsEmpty(StzuSeatNamed(StzuSeatsOf(xDeclarations, xP[2]), xP[3]))
				StzuFail(xP[7], "OVER names a seat of " + xP[2] + "; '" + xP[3] + "' is not one")
			end
			xPS = xP[5]
			for j = 1 to Len(xPS)
				tK = DeclaredKind(vDeclared, xPS[j][1])
				if tK = "" StzuFail(xPS[j][4], "SETS: '" + xPS[j][1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(xPS[j][4], "SETS must name a DECLARATION; '" + xPS[j][1] + "' is a " + tK) end
				xSetSeat = StzuSeatNamed(StzuSeatsOf(xDeclarations, xPS[j][1]), xPS[j][2])
				if IsEmpty(xSetSeat)
					StzuFail(xPS[j][4], "SETS names a seat of " + xPS[j][1] + "; '" + xPS[j][2] + "' is not one")
				end
				if StzuIsPairListSeat(xSetSeat, vDeclared, vForms)
					StzuFail(xPS[j][4], "SETS: '" + xPS[j][1] + "." + xPS[j][2] + "' is a list of pairs; a set draws from words, strings and numbers")
				end
				tSK = DeclaredKind(vDeclared, xPS[j][3])
				if tSK != "" StzuFail(xPS[j][4], "set '" + xPS[j][3] + "' is already a " + tSK + ": one name, one meaning") end
				if InStrList(xPS[j][3], vSetSeen) StzuFail(xPS[j][4], "set '" + xPS[j][3] + "' is declared twice") end
				vSetSeen + xPS[j][3]
			end
		catch
			StzuNote(cCatchError)
		end
	end
	if Len(vPatterns) > 0
		vPN = []
		vPT = []
		vPSN = []
		vPSM = []
		for i = 1 to Len(vPatterns)
			vPN + vPatterns[i][1]
			vPT + vPatterns[i][4]
			for j = 1 to Len(vPatterns[i][5])
				vPSN + vPatterns[i][5][j][3]
				vPSM + []
			end
		end
		for i = 1 to Len(vMenus)
			vPSN + vMenus[i][1]
			vPSM + []
		end
		tPErr = ""
		try
			PatDeclare(vPN, vPT, vPSN, vPSM)
		catch
			tPErr = cCatchError
		end
		if tPErr != ""
			# the engine's words name the pattern first ("pattern NAME: ..." or "pattern NAME is recursive ..."): the finding stands at that pattern's line
			nPL = vPatterns[1][7]
			for i = 1 to Len(vPatterns)
				tHead = "pattern " + vPatterns[i][1]
				if Left(tPErr, Len(tHead) + 1) = tHead + ":" or Left(tPErr, Len(tHead) + 1) = tHead + " " nPL = vPatterns[i][7] end
			end
			try
				StzuFail(nPL, tPErr)
			catch
				StzuNote(cCatchError)
			end
		end
	end

	# v0.6: a WALK names the kind it walks, the kind of its steps, and the seats
	# of a step that carry its walk, its rank, its guards, its computed value
	# and its failure
	for i = 1 to Len(vWalks)
		try
			xW = vWalks[i]
			nL = xW[10]
			for j = 1 to i - 1
				if vWalks[j][2] = xW[2]
					StzuFail(nL, "'" + xW[2] + "' is already walked by " + vWalks[j][1] + ": a kind is walked once")
				end
			end
			tK = DeclaredKind(vDeclared, xW[2])
			if tK = "" StzuFail(nL, "OF: '" + xW[2] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(nL, "OF must name a DECLARATION; '" + xW[2] + "' is a " + tK) end
			tK = DeclaredKind(vDeclared, xW[3])
			if tK = "" StzuFail(nL, "STEPS: '" + xW[3] + "' resolves to nothing in this declaration") end
			if tK != "DECLARATION" StzuFail(nL, "STEPS must name a DECLARATION; '" + xW[3] + "' is a " + tK) end
			xStepSeats = StzuSeatsOf(xDeclarations, xW[3])
			xT = StzuSeatNamed(xStepSeats, xW[4])
			if IsEmpty(xT) or xT[2] != xW[2] or xT[3]
				StzuFail(nL, "THROUGH names a seat of " + xW[3] + " that refers to " + xW[2] + "; '" + xW[4] + "' is not one")
			end
			xO = StzuSeatNamed(xStepSeats, xW[5])
			if IsEmpty(xO) or xO[3] or not (xO[2] = "number" or DeclaredKind(vDeclared, xO[2]) = "RANGE")
				StzuFail(nL, "ORDER names a number seat of " + xW[3] + "; '" + xW[5] + "' is not one")
			end
			xG = xW[6]
			for j = 1 to Len(xG)
				tP = xG[j][1]
				nDot = SubStr(tP, ".")
				if nDot = 0
					xS = StzuSeatNamed(xStepSeats, tP)
					if IsEmpty(xS) StzuFail(xG[j][2], "GUARDS: no seat '" + tP + "' on " + xW[3]) end
					if xS[3] or DeclaredKind(vDeclared, xS[2]) != "EXPRESSION"
						StzuFail(xG[j][2], "GUARDS: '" + tP + "' is not an expression seat of " + xW[3])
					end
				else
					tHead = Left(tP, nDot - 1)
					tTail = SubStr(tP, nDot + 1)
					xS = StzuSeatNamed(xStepSeats, tHead)
					if IsEmpty(xS) StzuFail(xG[j][2], "GUARDS: no seat '" + tHead + "' on " + xW[3]) end
					if xS[3] or DeclaredKind(vDeclared, xS[2]) != "DECLARATION"
						StzuFail(xG[j][2], "GUARDS: '" + tHead + "' is not a reference seat of " + xW[3] + ", so '" + tP + "' reads through nothing")
					end
					xS2 = StzuSeatNamed(StzuSeatsOf(xDeclarations, xS[2]), tTail)
					if IsEmpty(xS2) or xS2[3] or DeclaredKind(vDeclared, xS2[2]) != "EXPRESSION"
						StzuFail(xG[j][2], "GUARDS: '" + tP + "' is not an expression seat (no expression seat '" + tTail + "' on " + xS[2] + ")")
					end
				end
			end
			if xW[7] != ""
				xS = StzuSeatNamed(xStepSeats, xW[7])
				if IsEmpty(xS) or xS[3] or not (xS[2] = "name" or xS[2] = "text")
					StzuFail(nL, "COMPUTE names a name or text seat of " + xW[3] + "; '" + xW[7] + "' is not one")
				end
			end
			if xW[8] != ""
				xS = StzuSeatNamed(xStepSeats, xW[8])
				if IsEmpty(xS) or xS[3] or DeclaredKind(vDeclared, xS[2]) != "EXPRESSION"
					StzuFail(nL, "FORMULA names an expression seat of " + xW[3] + "; '" + xW[8] + "' is not one")
				end
			end
			if (xW[7] = "") != (xW[8] = "")
				StzuFail(nL, "COMPUTE and FORMULA go together: the computed seat and the expression that fills it")
			end
			if xW[9] != ""
				xS = StzuSeatNamed(xStepSeats, xW[9])
				if IsEmpty(xS) or xS[3] or not (xS[2] = "name" or xS[2] = "text" or DeclaredKind(vDeclared, xS[2]) = "MENU")
					StzuFail(nL, "FAIL names a name, text or MENU seat of " + xW[3] + "; '" + xW[9] + "' is not one")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.7: the ASK names the kinds a question may ask, the expression its
	# condition is written in, and the optional clauses it admits
	if not IsEmpty(xAsk)
		try
			nL = xAsk[6]
			xFrom = xAsk[2]
			if Len(xFrom) = 0 StzuFail(nL, "FROM names at least one kind a question may ask") end
			for i = 1 to Len(xFrom)
				tK = DeclaredKind(vDeclared, xFrom[i])
				if tK = "" StzuFail(nL, "FROM: '" + xFrom[i] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, "FROM must name a DECLARATION; '" + xFrom[i] + "' is a " + tK) end
			end
			if xAsk[3] != ""
				tK = DeclaredKind(vDeclared, xAsk[3])
				if tK = "" StzuFail(nL, "WHERE: '" + xAsk[3] + "' resolves to nothing in this declaration") end
				if tK != "EXPRESSION" StzuFail(nL, "WHERE must name an EXPRESSION; '" + xAsk[3] + "' is a " + tK) end
			end
			xCl = xAsk[4]
			for i = 1 to Len(xCl)
				if not InStrList(xCl[i], ["where", "order", "limit"])
					StzuFail(nL, "'" + xCl[i] + "' is not a clause a question admits: where, order, limit")
				end
				for j = 1 to i - 1
					if xCl[j] = xCl[i] StzuFail(nL, "clause '" + xCl[i] + "' is named twice") end
				end
			end
			if InStrList("where", xCl) and xAsk[3] = ""
				StzuFail(nL, "CLAUSES admits where, so WHERE names the expression a condition is written in")
			end
			if xAsk[3] != "" and not InStrList("where", xCl)
				StzuFail(nL, "WHERE names an expression no clause admits: add where to CLAUSES, or drop WHERE")
			end
			# v0.34: FIELDS seat.seat -- where the schema of a kind asked lives: a seat of every kind asked that refers to ONE declaration, and a
			# list of name: type pairs of that declaration. The court then refuses a question that names a field the declaration does not declare
			if xAsk[7] != ""
				nFD = SubStr(xAsk[7], ".")
				tFS1 = Left(xAsk[7], nFD - 1)
				tFS2 = SubStr(xAsk[7], nFD + 1)
				for i = 1 to Len(xFrom)
					xFSeat = StzuSeatNamed(StzuSeatsOf(xDeclarations, xFrom[i]), tFS1)
					if IsEmpty(xFSeat) StzuFail(nL, "FIELDS: '" + tFS1 + "' is not a seat of " + xFrom[i]) end
					if xFSeat[3] StzuFail(nL, "FIELDS: '" + tFS1 + "' of " + xFrom[i] + " must be one reference to a declaration") end
					if DeclaredKind(vDeclared, xFSeat[2]) != "DECLARATION"
						StzuFail(nL, "FIELDS: '" + tFS1 + "' of " + xFrom[i] + " must refer to a declaration, not to '" + xFSeat[2] + "'")
					end
					xFSeat2 = StzuSeatNamed(StzuSeatsOf(xDeclarations, xFSeat[2]), tFS2)
					if IsEmpty(xFSeat2) StzuFail(nL, "FIELDS: '" + tFS2 + "' is not a seat of " + xFSeat[2]) end
					if not StzuIsPairListSeat(xFSeat2, vDeclared, vForms)
						StzuFail(nL, "FIELDS: '" + tFS2 + "' of " + xFSeat[2] + " is not a list of name: type pairs")
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.9: the RUN names the kind that runs and the kinds that play the five
	# constructs, each with its seats by role
	if not IsEmpty(xRun)
		try
			nL = xRun[4]
			xRoles = xRun[2]
			for i = 1 to Len(xRoles)
				tRole = xRoles[i][1]
				xNames = xRoles[i][2]
				vWant = []
				if tRole = "OF" vWant = ["steps", "result"] end
				if tRole = "COMPUTE" or tRole = "COLLECT" vWant = ["into", "value"] end
				if tRole = "GROUP" vWant = ["into", "by", "value"] end
				if tRole = "BRANCH" vWant = ["when", "then", "else"] end
				if tRole = "ITERATE" vWant = ["over", "as", "do"] end
				if Len(xNames) != Len(vWant) + 1
					tN = "two"
					if Len(vWant) = 3 tN = "three" end
					StzuFail(nL, tRole + " names a kind and " + tN + " seats: " + StzuJoin(vWant, ", ") + " -- " + String(Len(xNames)) + " name(s) given")
				end
				tK = DeclaredKind(vDeclared, xNames[1])
				if tK = "" StzuFail(nL, tRole + ": '" + xNames[1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, tRole + " must name a DECLARATION; '" + xNames[1] + "' is a " + tK) end
				xKS = StzuSeatsOf(xDeclarations, xNames[1])
				for j = 1 to Len(vWant)
					tRoleSeat = vWant[j]
					tSeat = xNames[j + 1]
					xS = StzuSeatNamed(xKS, tSeat)
					if IsEmpty(xS) StzuFail(nL, tRole + ": no seat '" + tSeat + "' on " + xNames[1]) end
					tSK = DeclaredKind(vDeclared, xS[2])
					if tRoleSeat = "value" or tRoleSeat = "when" or tRoleSeat = "by"
						if xS[3] or tSK != "EXPRESSION"
							StzuFail(nL, tRole + ": '" + tSeat + "' is not an expression seat of " + xNames[1])
						end
					elseif tRoleSeat = "into" or tRoleSeat = "over" or tRoleSeat = "as"
						if xS[3] or xS[2] != "name"
							StzuFail(nL, tRole + ": '" + tSeat + "' is not a name seat of " + xNames[1])
						end
					else
						# steps, result, then, else, do: a list seat
						if not xS[3]
							StzuFail(nL, tRole + ": '" + tSeat + "' is not a list seat of " + xNames[1])
						end
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.17: the UNDERSTAND names, for each of the eight roles, the one declaration of this language that plays it,
	# and that declaration has the seats the emitted court reads (no declaration plays two roles)
	if not IsEmpty(xUnderstand)
		try
			nL = xUnderstand[4]
			xRoles = xUnderstand[2]
			for i = 1 to Len(xRoles)
				tRole = xRoles[i][1]
				xNames = xRoles[i][2]
				vWant = []
				if tRole = "TONGUE" vWant = ["code", "ignores", "allows", "digits", "names", "joins", "refuses"] end
				if tRole = "MEANING" vWant = ["slot", "of", "from", "words"] end
				if tRole = "ALIAS" vWant = ["meaning", "entity", "words"] end
				if tRole = "SURFACE" vWant = ["kind", "grammar", "court", "world", "entities", "spells", "tells"] end
				if tRole = "STEP" vWant = ["target", "query", "binds"] end
				if tRole = "FRAME" vWant = ["shape", "target", "query", "steps", "answers", "empty"] end
				if tRole = "EXAMPLE" vWant = ["means", "asking"] end
				if tRole = "COUNTEREXAMPLE" vWant = ["asking", "refused"] end
				if Len(xNames) != 1
					StzuFail(nL, tRole + " names the one DECLARATION that plays it -- " + String(Len(xNames)) + " name(s) given")
				end
				tK = DeclaredKind(vDeclared, xNames[1])
				if tK = "" StzuFail(nL, tRole + ": '" + xNames[1] + "' resolves to nothing in this declaration") end
				if tK != "DECLARATION" StzuFail(nL, tRole + " must name a DECLARATION; '" + xNames[1] + "' is a " + tK) end
				for j = 1 to i - 1
					if xRoles[j][2][1] = xNames[1]
						StzuFail(nL, tRole + " and " + xRoles[j][1] + " name the same declaration '" + xNames[1] + "': a declaration plays one role")
					end
				end
				for j = 1 to Len(vWant)
					if not StzuHasSeat(xDeclarations, xNames[1], vWant[j])
						StzuFail(nL, tRole + ": no seat '" + vWant[j] + "' on " + xNames[1] + " -- the court of this language reads it")
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# the REFINE: every point is a seat of a declaration; kinds and floors are closed
	if not IsEmpty(xRefine)
		try
			xPoints = xRefine[1]
			for i = 1 to Len(xPoints)
				xP = xPoints[i]
				if not StzuHasSeat(xDeclarations, xP[1], xP[2])
					StzuFail(xP[4], "no such point '" + xP[1] + "." + xP[2] + "': a point is a seat of a declaration of this language")
				end
				if not InStrList(xP[3], StzuRefinementKinds())
					StzuFail(xP[4], "'" + xP[3] + "' is not a refinement kind: knob, field, symbol, policy, composite or pipeline")
				end
			end
			xFloors = xRefine[2]
			for i = 1 to Len(xFloors)
				xF = xFloors[i]
				if not InStrList(xF[3], StzuPostures())
					StzuFail(xF[4], "'" + xF[3] + "' is not a posture: trusted, external, sandboxed or llm")
				end
				bPoint = false
				for j = 1 to Len(xPoints)
					if xPoints[j][1] = xF[1] and xPoints[j][2] = xF[2] bPoint = true end
				end
				if not bPoint
					StzuFail(xF[4], "'" + xF[1] + "." + xF[2] + "' is not a declared point: a FLOOR stands on a POINT")
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	# v0.23: the CONSTITUTION (charter 2, ratified 2026-11-01). Each article is one of Zin's six,
	# named once. The four Haro judges are judged THROUGH the mechanisms the charter names and never
	# reimplemented, in ARTICLES' order: explainability (1) through RATIONALE, the C2 envelope and the
	# NARRATE -- a NARRATE is declared and every REFUSAL and CONSTRAINT carries a CODE; reversibility
	# (2) through refinement -- a REFINE is declared; predictable_authority (4) through the gate's
	# governance stage -- no policy point is floored llm; trust_hierarchy (6) through the trust
	# posture -- every point has a FLOOR. v0.24 (ZC3): visible_state (3) through the three access paths a
	# language declares -- every declaration kind is told (NARRATE SAYS), asked (ASK FROM) or published
	# (WORLD PUBLISH); organizational_sovereignty (5) through the zones a world declares -- the
	# CONSTITUTION names the ZONE kind, its SOVEREIGN seat (a MENU word or a text, never optional) and its
	# MOVEMENT seat (a declared kind, never optional). WEAVES and REGIME are carried, their words closed,
	# and refused by name (ZC4).
	if not IsEmpty(xConstitution)
		try
			nCL = xConstitution[5]
			xArts = xConstitution[2]
			if Len(xArts) = 0
				StzuFail(nCL, "ARTICLES names no article: a constitution is under at least one")
			end
			for i = 1 to Len(xArts)
				if not InStrList(xArts[i], StzuArticles())
					StzuFail(nCL, "'" + xArts[i] + "' is not an article: explainability (1), reversibility (2), visible_state (3), predictable_authority (4), organizational_sovereignty (5) or trust_hierarchy (6)")
				end
				for j = 1 to i - 1
					if xArts[j] = xArts[i]
						StzuFail(nCL, "'" + xArts[i] + "' is named twice in ARTICLES: a world is under an article once")
					end
				end
			end
			xWv = xConstitution[3]
			for i = 1 to Len(xWv)
				if not InStrList(xWv[i][1], StzuWeaves())
					StzuFail(xWv[i][3], "'" + xWv[i][1] + "' is not a weave: resilience (W1), observability (W2), sovereignty (W3), privacy (W4), temporal_integrity (W5), cost_awareness (W6), learnability (W7) or structural_integrity (W8)")
				end
				if not InStrList(xWv[i][2], StzuSeverities())
					StzuFail(xWv[i][3], "'" + xWv[i][2] + "' is not a severity: constitutional, governance or advisory")
				end
			end
			# v0.25: sovereignty (W3) and privacy (W4) are judged below. v0.29 (WC1): so are the rules of the six carried weaves that need no
			# new seat (StzuWeaveRules); a weave none of whose rules is judged or held is carried, and refused by name
			for i = 1 to Len(xWv)
				if xWv[i][1] != "sovereignty" and xWv[i][1] != "privacy"
					xWR = StzuWeaveRules(xWv[i][1])
					if Len(xWR[1]) + Len(xWR[2]) = 0
						StzuFail(xWv[i][3], "WEAVES names '" + String(xWv[i][1]) + "', and none of its " + String(Len(xWR[3])) + " rules is judged in Haro v0.29 -- they are Zin's design, carried, not built")
					end
				end
			end
			# v0.25: the PERSONAL seats: each a seat of a declared kind, and the weaves' to govern
			xPers = xConstitution[10]
			vMarks = []
			for i = 1 to Len(xPers)
				tPP = xPers[i][1]
				nPD = SubStr(tPP, ".")
				tPDecl = ""
				tPSeat = ""
				tPSub = ""
				if nPD > 0
					tPDecl = Left(tPP, nPD - 1)
					tPSeat = SubStr(tPP, nPD + 1)
					# v0.27: a three-part path decl.seat.mark names the form seat that marks a field
					nPS = SubStr(tPSeat, ".")
					if nPS > 0
						tPSub = SubStr(tPSeat, nPS + 1)
						tPSeat = Left(tPSeat, nPS - 1)
					end
				end
				if nPD = 0 or DeclaredKind(vDeclared, tPDecl) != "DECLARATION"
					StzuFail(xPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "' is not a declaration kind")
				end
				if not StzuHasSeat(xDeclarations, tPDecl, tPSeat)
					StzuFail(xPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "' has no seat '" + tPSeat + "'")
				end
				if tPSub != ""
					xMS = StzuSeatRec(xDeclarations, tPDecl, tPSeat)
					xMF = ""
					if xMS[3] xMF = StzuFormRec(vForms, xMS[2]) end
					if IsEmpty(xMF) or not StzuIsPairForm(xMF[2], vDeclared)
						StzuFail(xPers[i][2], "PERSONAL names '" + tPP + "', and '" + tPDecl + "." + tPSeat + "' is not a list of a pair form -- a mark lives on a form's seat")
					end
					xTS = ""
					for j = 1 to Len(xMF[2])
						if xMF[2][j][1] = tPSub xTS = xMF[2][j] end
					end
					if IsEmpty(xTS)
						StzuFail(xPers[i][2], "PERSONAL names '" + tPP + "', and the form '" + xMF[1] + "' of '" + tPDecl + "." + tPSeat + "' has no seat '" + tPSub + "'")
					end
					xTM = StzuMenuRec(vMenus, xTS[2])
					if IsEmpty(xTM) or not InStrList("personal", xTM[2])
						StzuFail(xPers[i][2], "PERSONAL names '" + tPP + "' as a mark, and the MENU '" + xTS[2] + "' has no word 'personal' -- a mark seat is a MENU that can say personal")
					end
					vMarks + [tPP, xPers[i][2]]
				end
			end
			# v0.27: the safeguards -- a path (ask, voice) and the word it declares: stzFieldTags' five words, each on its path
			xSafe = xConstitution[11]
			tSafeAsk = ""
			tSafeVoice = ""
			for i = 1 to Len(xSafe)
				tSP = xSafe[i][1]
				tSW = xSafe[i][2]
				if not InStrList(tSW, ["consent", "anonymisation", "retention", "redaction", "on_premise"])
					StzuFail(xSafe[i][3], "'" + tSW + "' is not a safeguard: consent, anonymisation, retention, redaction or on_premise")
				end
				if tSP = "ask"
					if not InStrList(tSW, ["consent", "anonymisation"])
						StzuFail(xSafe[i][3], "'" + tSW + "' is not a safeguard of the ask path: consent or anonymisation")
					end
					tSafeAsk = tSW
				elseif tSP = "voice"
					if tSW != "redaction"
						StzuFail(xSafe[i][3], "'" + tSW + "' is not a safeguard of the voice path: redaction")
					end
					tSafeVoice = tSW
				else
					StzuFail(xSafe[i][3], "'" + tSP + "' is not a path Haro's weaves govern here: ask or voice -- the model path is stzlib's and HaroBase's (D35)")
				end
			end
			tSevPrivacy = ""
			tSevSovereignty = ""
			for i = 1 to Len(xWv)
				if xWv[i][1] = "privacy" tSevPrivacy = xWv[i][2] end
				if xWv[i][1] = "sovereignty" tSevSovereignty = xWv[i][2] end
			end
			if Len(xPers) > 0 and tSevPrivacy = "" and tSevSovereignty = ""
				StzuFail(nCL, "PERSONAL is named and neither privacy (W4) nor sovereignty (W3) is among WEAVES -- the personal seats are the weaves' to govern")
			end
			if Len(xSafe) > 0 and tSevPrivacy = ""
				StzuFail(nCL, "SAFEGUARDS is named and privacy (W4) is not among WEAVES -- a safeguard is a weave's escape")
			end
			# v0.25: a regime is read by the weaves' refusals; without a weave it is accepted by nothing
			if xConstitution[4] != "" and Len(xWv) = 0
				StzuFail(nCL, "REGIME is named and no weave is among WEAVES -- a regime is read by the weaves' refusals")
			end
			# v0.24: the zone seats are the sovereignty article's; named without it they are refused, not accepted by silence
			if xConstitution[7] != "" or xConstitution[8] != "" or xConstitution[9] != ""
				if not InStrList("organizational_sovereignty", xArts)
					StzuFail(nCL, "ZONE is named and organizational_sovereignty is not among ARTICLES -- the zone seats are the sovereignty article's")
				end
			end
			for i = 1 to Len(xArts)
				tArt = xArts[i]
				if tArt = "explainability"
					if IsEmpty(xNarrate)
						StzuFail(nCL, "Art. 1 explainability: '" + tLName + "' declares no NARRATE -- a world under explainability tells every run and every refusal in its own voice")
					end
					for j = 1 to Len(vRefusals)
						if vRefusals[j][6] = ""
							StzuFail(vRefusals[j][4], "Art. 1 explainability: REFUSAL '" + vRefusals[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
					for j = 1 to Len(xConstraints)
						if xConstraints[j][7] = ""
							StzuFail(xConstraints[j][6], "Art. 1 explainability: CONSTRAINT '" + xConstraints[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
					# v0.32: a PATTERN refuses as a CONSTRAINT does, so it is traceable the same way
					for j = 1 to Len(vPatterns)
						if vPatterns[j][8] = ""
							StzuFail(vPatterns[j][7], "Art. 1 explainability: PATTERN '" + vPatterns[j][1] + "' carries no CODE -- a refusal under explainability is traceable by its stable identifier (C2 2.1)")
						end
					end
				elseif tArt = "reversibility"
					if IsEmpty(xRefine)
						StzuFail(nCL, "Art. 2 reversibility: '" + tLName + "' declares no REFINE -- a world under reversibility changes only by refinement, whose inverse is computed before it lands and whose revert is an event (charter 6.5)")
					end
				elseif tArt = "visible_state"
					# v0.24: every declaration kind is reached by a declared path -- told, asked or published
					for j = 1 to Len(xDeclarations)
						tVK = xDeclarations[j][1]
						bReached = false
						if not IsEmpty(xNarrate)
							for k = 1 to Len(xNarrate[5])
								if xNarrate[5][k][1] = tVK bReached = true end
							end
						end
						if not IsEmpty(xAsk)
							if InStrList(tVK, xAsk[2]) bReached = true end
						end
						if not IsEmpty(xWorld)
							if Len(xWorld) >= 5
								for k = 1 to Len(xWorld[5])
									if xWorld[5][k][1] = tVK bReached = true end
								end
							end
						end
						if not bReached
							StzuFail(xDeclarations[j][5], "Art. 3 visible_state: kind '" + tVK + "' is reached by no declared path -- not told (NARRATE SAYS), not asked (ASK FROM), not published (WORLD PUBLISH): a state nothing can read is hidden")
						end
					end
				elseif tArt = "predictable_authority"
					if not IsEmpty(xRefine)
						xPts = xRefine[1]
						xFls = xRefine[2]
						for j = 1 to Len(xPts)
							if xPts[j][3] = "policy"
								for k = 1 to Len(xFls)
									if xFls[k][1] = xPts[j][1] and xFls[k][2] = xPts[j][2] and xFls[k][3] = "llm"
										StzuFail(xFls[k][4], "Art. 4 predictable_authority: policy point '" + xPts[j][1] + "." + xPts[j][2] + "' has FLOOR llm -- a rule is refined by no model-composed proposal, by construction (charter 6.4)")
									end
								end
							end
						end
					end
				elseif tArt = "organizational_sovereignty"
					# v0.24: the world names its zone kind, who holds a zone (never optional; a MENU word or a
					# text) and what a zone is entered through (never optional; a declared kind, the flow)
					tZ = xConstitution[7]
					tSv = xConstitution[8]
					tMv = xConstitution[9]
					if tZ = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: '" + tLName + "' names no ZONE -- a world under sovereignty says which of its kinds holds its data (ZONE), who holds each (SOVEREIGN) and through which declared flow a record enters it (MOVEMENT)")
					end
					if DeclaredKind(vDeclared, tZ) != "DECLARATION"
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' is not a declaration kind of '" + tLName + "'")
					end
					if tSv = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' has no SOVEREIGN seat named -- a zone is held by someone, never by silence")
					end
					xSS = StzuSeatRec(xDeclarations, tZ, tSv)
					if IsEmpty(xSS)
						StzuFail(nCL, "Art. 5 organizational_sovereignty: SOVEREIGN '" + tSv + "' is not a seat of '" + tZ + "'")
					end
					if xSS[4]
						StzuFail(xSS[5], "Art. 5 organizational_sovereignty: SOVEREIGN seat '" + tSv + "' of '" + tZ + "' is optional -- a zone's holder is never silent")
					end
					if xSS[2] != "text" and DeclaredKind(vDeclared, xSS[2]) != "MENU"
						StzuFail(xSS[5], "Art. 5 organizational_sovereignty: SOVEREIGN seat '" + tSv + "' of '" + tZ + "' is typed '" + xSS[2] + "' -- a holder is a word of a MENU of organizations, or a text")
					end
					if tMv = ""
						StzuFail(nCL, "Art. 5 organizational_sovereignty: ZONE '" + tZ + "' has no MOVEMENT seat named -- a record enters a zone through a declared flow, or not at all")
					end
					xMS = StzuSeatRec(xDeclarations, tZ, tMv)
					if IsEmpty(xMS)
						StzuFail(nCL, "Art. 5 organizational_sovereignty: MOVEMENT '" + tMv + "' is not a seat of '" + tZ + "'")
					end
					if xMS[4]
						StzuFail(xMS[5], "Art. 5 organizational_sovereignty: MOVEMENT seat '" + tMv + "' of '" + tZ + "' is optional -- an entry that may be silent is ungoverned")
					end
					if DeclaredKind(vDeclared, xMS[2]) != "DECLARATION"
						StzuFail(xMS[5], "Art. 5 organizational_sovereignty: MOVEMENT seat '" + tMv + "' of '" + tZ + "' is typed '" + xMS[2] + "' -- it names a declared kind, the flow a record walks in")
					end
				elseif tArt = "trust_hierarchy"
					if not IsEmpty(xRefine)
						xPts = xRefine[1]
						xFls = xRefine[2]
						for j = 1 to Len(xPts)
							bFl = false
							for k = 1 to Len(xFls)
								if xFls[k][1] = xPts[j][1] and xFls[k][2] = xPts[j][2] bFl = true end
							end
							if not bFl
								StzuFail(xPts[j][4], "Art. 6 trust_hierarchy: point '" + xPts[j][1] + "." + xPts[j][2] + "' has no FLOOR -- a trust requirement is declared, never implied: silence refuses")
							end
						end
					end
				end
			end
			# v0.25: the weaves over the PERSONAL seats, at the declared severity, the regime named.
			# Three paths a language declares: the voice (W4.4, a log), the ask (W4.2, analytics),
			# the published world (W3.1, a movement out of its zone); the model path is stzlib's and
			# HaroBase's, the same rung.
			tRg = xConstitution[4]
			for i = 1 to Len(xPers)
				tPP = xPers[i][1]
				nPD = SubStr(tPP, ".")
				tPDecl = Left(tPP, nPD - 1)
				tPSeat = SubStr(tPP, nPD + 1)
				# v0.27: a mark path (decl.seat.mark) is judged below, on the paths records take; a published schema moves no datum
				if SubStr(tPSeat, ".") > 0 loop end
				if tSevPrivacy != ""
					if not IsEmpty(xNarrate)
						for k = 1 to Len(xNarrate[5])
							if xNarrate[5][k][1] = tPDecl
								if SubStr(xNarrate[5][k][2], "{" + tPSeat + "}") > 0
									StzuWeave(tSevPrivacy, xNarrate[5][k][3], "W4.4 privacy: personal seat '" + tPP + "' is told by the voice -- a log carries no personal datum unredacted" + StzuRegimeTail(tRg, "W4.4"))
								end
							end
						end
					end
					if not IsEmpty(xAsk)
						if InStrList(tPDecl, xAsk[2])
							StzuWeave(tSevPrivacy, xAsk[6], "W4.2 privacy: kind '" + tPDecl + "' holds the personal seat '" + tPSeat + "' and is asked (ASK FROM) -- usage over personal data is analytics, which needs consent" + StzuRegimeTail(tRg, "W4.2"))
						end
					end
				end
				if tSevSovereignty != ""
					if not IsEmpty(xWorld)
						if Len(xWorld) >= 5
							for k = 1 to Len(xWorld[5])
								if xWorld[5][k][1] = tPDecl
									StzuWeave(tSevSovereignty, xWorld[5][k][3], "W3.1 sovereignty: kind '" + tPDecl + "' holds the personal seat '" + tPSeat + "' and is published to the world -- personal data stays in its declared zone" + StzuRegimeTail(tRg, "W3.1"))
								end
							end
						end
					end
				end
			end
			# v0.27: the weaves over the marks, on the two paths records take out of the world: the ask (W4.2) needs
			# consent or anonymisation, the voice telling rows (W4.4) needs redaction; the court applies what it can
			if tSevPrivacy != ""
				for i = 1 to Len(vMarks)
					if not IsEmpty(xAsk) and tSafeAsk = ""
						StzuWeave(tSevPrivacy, xAsk[6], "W4.2 privacy: the fields marked by '" + vMarks[i][1] + "' may be asked (ASK " + xAsk[1] + ") and no safeguard is declared for the ask path -- usage over personal data is analytics, which needs consent or anonymisation" + StzuRegimeTail(tRg, "W4.2"))
					end
					if not IsEmpty(xNarrate) and tSafeVoice = ""
						xTls = xNarrate[8]
						for k = 1 to Len(xTls)
							if SubStr(xTls[k][2], "{rows}") > 0
								StzuWeave(tSevPrivacy, xTls[k][3], "W4.4 privacy: the fields marked by '" + vMarks[i][1] + "' are told by the voice ('" + xTls[k][1] + "' tells {rows}) and no redaction is declared for the voice path -- a log carries no personal datum unredacted" + StzuRegimeTail(tRg, "W4.4"))
							end
						end
					end
				end
			end
			# v0.29 (WC1): the six carried weaves, as far as the court judges them with no new seat. Each rule is an article's condition read at
			# the WEAVE's severity (ZIN-WEAVES-INVENTORY.md): where the world stands under the article, the article's own refusal came first
			# above, constitutional, and the weave does not say it twice. W1.2 and W7.1 hold by construction and judge nothing.
			xAn = StzuArticles()
			for i = 1 to Len(xWv)
				tWN = xWv[i][1]
				tWS = xWv[i][2]
				if tWN = "resilience"
					# W1.5: a degradation preserves the invariants -- a CONSTRAINT held at warning that cites an article the world stands under
					for j = 1 to Len(xConstraints)
						if xConstraints[j][9] = "warning" and IsList(xConstraints[j][8])
							xCts = xConstraints[j][8]
							for k = 1 to Len(xCts)
								nCA = StzuCitedArticle(xCts[k])
								if nCA > 0
									if InStrList(xAn[nCA], xArts)
										StzuWeave(tWS, xConstraints[j][6], "W1.5 resilience: CONSTRAINT '" + xConstraints[j][1] + "' is SEVERITY warning and cites " + xCts[k] + ", and the world stands under " + xAn[nCA] + " -- a degradation must not pass a law the world declares" + StzuArtTail(nCA))
									end
								end
							end
						end
					end
				end
				if tWN = "observability"
					# W2.2 and W2.3: a model's proposal and a gate's denial are traced by the audit chain, which is Art. 3's
					if not IsEmpty(xRefine) and not InStrList("visible_state", xArts)
						xFlO = xRefine[2]
						for j = 1 to Len(xFlO)
							if xFlO[j][3] = "llm"
								StzuWeave(tWS, xFlO[j][4], "W2.2 observability: point '" + xFlO[j][1] + "." + xFlO[j][2] + "' has FLOOR llm -- a model may propose it -- and visible_state is not among ARTICLES: no chain keeps the model's proposal or its refusal" + StzuArtTail(3))
							end
						end
						StzuWeave(tWS, xRefine[3], "W2.3 observability: '" + tLName + "' declares a REFINE, whose gate denies, and visible_state is not among ARTICLES: a denial enters no audit chain" + StzuArtTail(3))
					end
				end
				if tWN = "temporal_integrity"
					# W5.2: the changes of points that have a history are versioned by the numbered chain, which is Art. 3's
					if not IsEmpty(xRefine) and not InStrList("visible_state", xArts)
						StzuWeave(tWS, xRefine[3], "W5.2 temporal_integrity: '" + tLName + "' declares a REFINE, which changes points that have a history, and visible_state is not among ARTICLES: no numbered chain versions the changes" + StzuArtTail(3))
					end
				end
				if tWN = "learnability"
					# W7.4: a denial is explained -- told by a voice and met by a stable identifier, Art. 1's two conditions
					nDen = Len(vRefusals) + Len(xConstraints)
					if nDen > 0 and IsEmpty(xNarrate)
						nDL = xConstraints[1][6]
						if Len(vRefusals) > 0
							nDL = vRefusals[1][4]
						end
						StzuWeave(tWS, nDL, "W7.4 learnability: '" + tLName + "' declares " + String(nDen) + " denial(s) (CONSTRAINT or REFUSAL) and no NARRATE -- a denial no voice tells is not explained" + StzuArtTail(1))
					end
					for j = 1 to Len(vRefusals)
						if vRefusals[j][6] = ""
							StzuWeave(tWS, vRefusals[j][4], "W7.4 learnability: REFUSAL '" + vRefusals[j][1] + "' carries no CODE -- a denial is explained to its reader by a stable identifier (C2 2.1)" + StzuArtTail(1))
						end
					end
					for j = 1 to Len(xConstraints)
						if xConstraints[j][7] = ""
							StzuWeave(tWS, xConstraints[j][6], "W7.4 learnability: CONSTRAINT '" + xConstraints[j][1] + "' carries no CODE -- a denial is explained to its reader by a stable identifier (C2 2.1)" + StzuArtTail(1))
						end
					end
				end
				if tWN = "structural_integrity"
					# W8.5: synthesis never overrides what the court proved -- a policy point a model may propose, Art. 4's condition
					if not IsEmpty(xRefine)
						xPts = xRefine[1]
						xFls = xRefine[2]
						for j = 1 to Len(xPts)
							if xPts[j][3] = "policy"
								for k = 1 to Len(xFls)
									if xFls[k][1] = xPts[j][1] and xFls[k][2] = xPts[j][2] and xFls[k][3] = "llm"
										StzuWeave(tWS, xFls[k][4], "W8.5 structural_integrity: policy point '" + xPts[j][1] + "." + xPts[j][2] + "' has FLOOR llm -- a model-composed proposal could replace a rule the court proved" + StzuArtTail(4))
									end
								end
							end
						end
					end
				end
			end
		catch
			StzuNote(cCatchError)
		end
	end

	return vRec
end
# v0.29 (WC1): the rules of the six carried weaves, as the court judges them -- [judged, held by construction, carried]. Judged: a
# refusal exists at the weave's severity. Held: nothing can fail (W1.2: the gate writes a change's inverse before the change lands;
# W7.1: a declaration without a RATIONALE is refused whatever the weaves say). Carried: Zin's design, not judged. The rule ids are
# Zin's (ZIN_CONSTITUTIONAL_WEAVES.md); a weave with no rule judged or held is refused by name
func StzuWeaveRules(tWeave)
	if tWeave = "resilience"
		return [["W1.5"], ["W1.2"], ["W1.1", "W1.3", "W1.4", "W1.6", "W1.7"]]
	elseif tWeave = "observability"
		return [["W2.2", "W2.3"], [], ["W2.1", "W2.4", "W2.5", "W2.6"]]
	elseif tWeave = "temporal_integrity"
		return [["W5.2"], [], ["W5.1", "W5.3", "W5.4", "W5.5"]]
	elseif tWeave = "cost_awareness"
		return [[], [], ["W6.1", "W6.2", "W6.3", "W6.4", "W6.5", "W6.6", "W6.7", "W6.8", "W6.9", "W6.10", "W6.11", "W6.12", "W6.13"]]
	elseif tWeave = "learnability"
		return [["W7.4"], ["W7.1"], ["W7.2", "W7.3", "W7.5", "W7.6"]]
	elseif tWeave = "structural_integrity"
		return [["W8.5"], [], ["W8.1", "W8.2", "W8.3", "W8.4"]]
	end
	return [[], [], []]
end
# the number of the article a cite names, `article:3` or `article:visible_state`, and 0 for any other cite
func StzuCitedArticle(tCite)
	if Left(tCite, 8) != "article:" return 0 end
	tV = SubStr(tCite, 9)
	xAn = StzuArticles()
	for i = 1 to Len(xAn)
		if tV = xAn[i] or tV = String(i) return i end
	end
	return 0
end
# the article a weave refusal serves, in the form the articles' own refusals use
func StzuArtTail(nArt)
	xAn = StzuArticles()
	return " [Art. " + String(nArt) + " " + String(xAn[nArt]) + "]"
end
# a comma-joined list with more words added to it
func StzuAppendWords(tList, xWords)
	for i = 1 to Len(xWords)
		if tList != "" tList += "," end
		tList += xWords[i]
	end
	return tList
end
# v0.25: a weave's verdict at its declared severity -- constitutional refuses, governance warns,
# advisory notes; the warnings and notes are printed after the structural fields
func StzuWeave(tSev, nLine, tMsg)
	if tSev = "constitutional"
		StzuFail(nLine, tMsg)
	elseif tSev = "governance"
		$vStzuWarnings + tMsg
	else
		$vStzuNotes + tMsg
	end
end
# v0.25: the regime's own article beside the constitution's, in a weave refusal -- the declared
# regime, never a default: gdpr's articles, Niger Law 2017-28 as Zin's African companion names it,
# a regime Haro has no table for named as declared, and "no regime declared" where there is none
func StzuRegimeTail(tRegime, tRule)
	tTail = ""
	if tRegime = ""
		tTail = "no regime declared"
	elseif tRegime = "gdpr"
		tTail = "gdpr: " + StzuGdprArticle(tRule)
	elseif tRegime = "niger_2017_28"
		tTail = "Niger Law 2017-28"
	else
		tTail = "regime '" + tRegime + "' as declared, which Haro v0.25 has no article table for"
	end
	return " [Art. 5 organizational_sovereignty; " + tTail + "]"
end
func StzuGdprArticle(tRule)
	if tRule = "W4.4" return "Article 5(1)(e)" end
	if tRule = "W4.2" return "Article 7" end
	if tRule = "W3.1" return "Chapter V" end
	return "Article 5"
end
# the value shape of a UNION's alternative, or the refusal (v0.3)
func StzuAltShape(xAlt, vDeclared, vForms, nLine)
	tOf = xAlt[1]
	tK = DeclaredKind(vDeclared, tOf)
	if xAlt[2]
		if tK = ""
			StzuFail(nLine, "alternative '" + tOf + "' resolves to nothing in this declaration")
		end
		if tK != "FORM"
			StzuFail(nLine, "'" + tOf + "' cannot be an alternative of a UNION as a list: a list alternative is a list of a FORM")
		end
		for i = 1 to Len(vForms)
			if vForms[i][1] = tOf
				xFS = vForms[i][2]
				if Len(xFS) > 0
					if xFS[1][2] = "text" return "stringlist" end
					if DeclaredKind(vDeclared, xFS[1][2]) = "FORMAT" return "stringlist" end
				end
			end
		end
		return "namelist"
	end
	if tOf = "text" return "string" end
	if tOf = "number" return "number" end
	if InStrList(tOf, StzuPrimitives()) return "word" end
	if tK = ""
		StzuFail(nLine, "alternative '" + tOf + "' resolves to nothing in this declaration")
	end
	if tK = "MENU" return "word" end
	if tK = "RANGE" return "number" end
	if tK = "FORMAT" return "string" end
	if tK = "DECLARATION" return "word" end
	StzuFail(nLine, "'" + tOf + "' cannot be an alternative of a UNION: an alternative is a MENU, a RANGE, a FORMAT, a primitive, a DECLARATION or a list of a FORM, not a " + tK)
end
func StzuSeatsOf(xDeclarations, tDecl)
	for i = 1 to Len(xDeclarations)
		if xDeclarations[i][1] = tDecl return xDeclarations[i][3] end
	end
	return []
end
func StzuSeatNamed(xSeats, tSeat)
	for i = 1 to Len(xSeats)
		if xSeats[i][1] = tSeat return xSeats[i] end
	end
	return ""
end
# v0.6: a list seat whose element is a FORM of exactly two seats, the first a
# name and the second a scalar, is written as name: value pairs; every other
# FORM keeps v0.1's reading (its items follow the form's first seat), because
# the pinned judge lists a six-seat FORM and v0.6 refuses nothing v0.5 accepted
# v0.32: a seat that is a list of a FORM whose seats make a pair (name: value), which the court reads as a pair list
func StzuIsPairListSeat(xSeat, vDeclared, vForms)
	if not xSeat[3] return false end
	if DeclaredKind(vDeclared, xSeat[2]) != "FORM" return false end
	for i = 1 to Len(vForms)
		if vForms[i][1] = xSeat[2] return StzuIsPairForm(vForms[i][2], vDeclared) end
	end
	return false
end
func StzuIsPairForm(xFS, vDeclared)
	# v0.27: a pair form may carry a third, optional seat typed by a MENU -- the mark, written after the value
	if Len(xFS) != 2 and not StzuHasMarkSeat(xFS, vDeclared) return false end
	if xFS[1][3] or xFS[2][3] return false end
	tK1 = DeclaredKind(vDeclared, xFS[1][2])
	if xFS[1][2] != "name" and tK1 != "MENU" and tK1 != "DECLARATION" return false end
	return true
end
# v0.27: the mark seat of a pair form -- third, optional, a MENU
func StzuHasMarkSeat(xFS, vDeclared)
	if Len(xFS) != 3 return false end
	if xFS[3][3] or not xFS[3][4] return false end
	return DeclaredKind(vDeclared, xFS[3][2]) = "MENU"
end
# a pair form whose key or value is a reference (v0.8)
func StzuPairRefs(xFS, vDeclared)
	tK1 = DeclaredKind(vDeclared, xFS[1][2])
	tK2 = DeclaredKind(vDeclared, xFS[2][2])
	return tK1 = "DECLARATION" or tK2 = "DECLARATION" or tK2 = "UNION"
end
func StzuCheckListForms(xSeats, vDeclared, vForms)
	for i = 1 to Len(xSeats)
		xS = xSeats[i]
		if not xS[3] loop end
		if DeclaredKind(vDeclared, xS[2]) != "FORM" loop end
		for j = 1 to Len(vForms)
			if vForms[j][1] != xS[2] loop end
			xFS = vForms[j][2]
			if StzuIsPairForm(xFS, vDeclared)
				# the pair's value is a scalar of the second seat's type: a
				# primitive, a MENU, a RANGE, a FORMAT, or (v0.8) a reference --
				# a DECLARATION or a UNION of declarations
				tK2 = DeclaredKind(vDeclared, xFS[2][2])
				if not (InStrList(xFS[2][2], StzuPrimitives()) or tK2 = "MENU" or tK2 = "RANGE" or tK2 = "FORMAT" or tK2 = "DECLARATION" or tK2 = "UNION")
					StzuFail(xS[5], "a list of a FORM writes key: value pairs when the FORM is a key and a scalar; the second seat of '" + xS[2] + "' is a " + tK2 + ", which a pair cannot hold")
				end
			end
		end
	end
end
func StzuHasSeat(xDeclarations, tDecl, tSeat)
	for i = 1 to Len(xDeclarations)
		if xDeclarations[i][1] = tDecl
			xS = xDeclarations[i][3]
			for j = 1 to Len(xS)
				if xS[j][1] = tSeat return true end
			end
		end
	end
	return false
end
# v0.24: the seat record [name, of, isList, optional, line] of a declaration's seat, or NULL
func StzuSeatRec(xDeclarations, tDecl, tSeat)
	for i = 1 to Len(xDeclarations)
		if xDeclarations[i][1] = tDecl
			xS = xDeclarations[i][3]
			for j = 1 to Len(xS)
				if xS[j][1] = tSeat return xS[j] end
			end
		end
	end
	return ""
end
# v0.27: a FORM's record by name, a MENU's record by name, or NULL
func StzuFormRec(vForms, tName)
	for i = 1 to Len(vForms)
		if vForms[i][1] = tName return vForms[i] end
	end
	return ""
end
func StzuMenuRec(vMenus, tName)
	for i = 1 to Len(vMenus)
		if vMenus[i][1] = tName return vMenus[i] end
	end
	return ""
end
func StzuCheckCondition(tCond, tOn, xOneDecls, nLine)
	xAst = ""
	tErr = ""
	try
		xAst = CondParse(tCond)
	catch
		tErr = cCatchError
	end
	if tErr != ""
		StzuFail(nLine, tErr + " -- in '" + tCond + "'")
	end
	tWhy = CondValidate(xAst, tOn, xOneDecls, "")
	if tWhy != ""
		StzuFail(nLine, tWhy + " -- in '" + tCond + "'")
	end
end
# a seat type resolves to a primitive, a FORM, an EXPRESSION, a MENU, a RANGE,
# a FORMAT or a DECLARATION (a reference); a list seat's element is a FORM, a
# DECLARATION or a MENU
func StzuResolveSeats(xSeats, vDeclared)
	xUnionsRef = $xStzuUnions
	for i = 1 to Len(xSeats)
		xS = xSeats[i]
		tOf = xS[2]
		if xS[3]
			tK = DeclaredKind(vDeclared, tOf)
			if tK = ""
				StzuFail(xS[5], "seat type '" + tOf + "' resolves to nothing in this declaration")
			end
			if tK = "UNION"
				# v0.9: a list of references to several kinds -- a step list
				xUAlts = ""
				xUL = xUnionsRef
				for k = 1 to Len(xUL)
					if xUL[k][1] = tOf xUAlts = xUL[k][2] end
				end
				if not IsEmpty(xUAlts)
					for k = 1 to Len(xUAlts)
						if DeclaredKind(vDeclared, xUAlts[k][1]) != "DECLARATION"
							StzuFail(xS[5], "a list seat's element UNION is a UNION of DECLARATIONs; '" + tOf + "' holds '" + xUAlts[k][1] + "'")
						end
					end
				end
				loop
			end
			if tK != "FORM" and tK != "DECLARATION" and tK != "MENU"
				StzuFail(xS[5], "a list seat's element must be a declared FORM, DECLARATION, MENU or a UNION of declarations; '" + tOf + "' is not")
			end
		elseif not InStrList(tOf, StzuPrimitives())
			tK = DeclaredKind(vDeclared, tOf)
			if tK = ""
				StzuFail(xS[5], "seat type '" + tOf + "' resolves to nothing in this declaration")
			end
			if tK != "FORM" and tK != "EXPRESSION" and tK != "MENU" and tK != "RANGE" and tK != "FORMAT" and tK != "DECLARATION" and tK != "UNION" and tK != "SENTENCE" and tK != "SYMBOL"
				StzuFail(xS[5], "seat type '" + tOf + "' must name a FORM, an EXPRESSION, a MENU, a RANGE, a FORMAT, a DECLARATION, a UNION, a SENTENCE or a SYMBOL, not a " + tK)
			end
		end
	end
end
# ---- the printed verdict ----------------------------------------------------

func StzuPrintLanguage(xLang)
	? "ok"
	? "language " + LangGet(xLang, "name")
	? "version " + LangGet(xLang, "version")
	? "grammar " + LangGet(xLang, "grammar")
	? "court " + LangGet(xLang, "court")
	? "extension " + LangGet(xLang, "extension")
	? "rationale " + LangGet(xLang, "rationale")
	? "declarations " + String(Len(LangGet(xLang, "declarations")))
	? "forms " + String(Len(LangGet(xLang, "forms")))
	? "expressions " + String(Len(LangGet(xLang, "expressions")))
	? "refusals " + String(Len(LangGet(xLang, "refusals")))
	? "menus " + String(Len(LangGet(xLang, "menus")))
	? "ranges " + String(Len(LangGet(xLang, "ranges")))
	? "formats " + String(Len(LangGet(xLang, "formats")))
	? "unions " + String(Len(LangGet(xLang, "unions")))
	? "sentences " + String(Len(LangGet(xLang, "sentences")))
	? "views " + String(Len(LangGet(xLang, "views")))
	? "constraints " + String(Len(LangGet(xLang, "constraints")))
	# v0.32: printed only where there is one, so a language without a PATTERN prints the bytes it printed
	xPaL = LangGet(xLang, "patterns")
	if not IsEmpty(xPaL)
		if Len(xPaL) > 0 ? "patterns " + String(Len(xPaL)) end
	end
	nCtx = 0
	xE = LangGet(xLang, "expressions")
	for i = 1 to Len(xE)
		if Len(xE[i]) >= 8 nCtx += Len(xE[i][8]) end
	end
	? "contexts " + String(nCtx)
	? "walks " + String(Len(LangGet(xLang, "walks")))
	nAsks = 0
	if not IsEmpty(LangGet(xLang, "ask")) nAsks = 1 end
	? "asks " + String(nAsks)
	nRuns = 0
	if not IsEmpty(LangGet(xLang, "run")) nRuns = 1 end
	? "runs " + String(nRuns)
	xSy = LangGet(xLang, "symbols")
	nSy = 0
	if not IsEmpty(xSy) nSy = Len(xSy) end
	? "symbols " + String(nSy)
	nFs = 0
	if not IsEmpty(LangGet(xLang, "formset")) nFs = 1 end
	? "formsets " + String(nFs)
	nNr = 0
	if not IsEmpty(LangGet(xLang, "narrate")) nNr = 1 end
	? "narrates " + String(nNr)
	nUn = 0
	if not IsEmpty(LangGet(xLang, "understand")) nUn = 1 end
	? "understands " + String(nUn)
	nWorld = 0
	if not IsEmpty(LangGet(xLang, "world")) nWorld = 1 end
	? "world " + String(nWorld)
	nPoints = 0
	xR = LangGet(xLang, "refine")
	if not IsEmpty(xR) nPoints = Len(xR[1]) end
	? "points " + String(nPoints)
	# v0.23: the constitution, and its articles in the declared order
	xCs = LangGet(xLang, "constitution")
	nCs = 0
	tArts = ""
	if not IsEmpty(xCs)
		nCs = 1
		for i = 1 to Len(xCs[2])
			if i > 1 tArts += "," end
			tArts += xCs[2][i]
		end
	end
	? "constitution " + String(nCs)
	? "articles " + tArts
	# v0.24: the zone kind of organizational_sovereignty, empty under none
	tZone = ""
	if not IsEmpty(xCs)
		if Len(xCs) >= 7 tZone = xCs[7] end
	end
	? "zone " + tZone
	# v0.25: the regime, the weaves with their severities, the personal seats
	tRegime = ""
	tWeaves = ""
	tPersonal = ""
	if not IsEmpty(xCs)
		if Len(xCs) >= 10
			tRegime = xCs[4]
			for i = 1 to Len(xCs[3])
				if i > 1 tWeaves += "," end
				tWeaves += xCs[3][i][1] + ":" + xCs[3][i][2]
			end
			for i = 1 to Len(xCs[10])
				if i > 1 tPersonal += "," end
				tPersonal += xCs[10][i][1]
			end
		end
	end
	# v0.27: the safeguards, as path:word, comma-joined
	tSafeg = ""
	if not IsEmpty(xCs)
		if Len(xCs) >= 11
			for i = 1 to Len(xCs[11])
				if i > 1 tSafeg += "," end
				tSafeg += xCs[11][i][1] + ":" + xCs[11][i][2]
			end
		end
	end
	? "regime " + tRegime
	? "weaves " + tWeaves
	? "personal " + tPersonal
	? "safeguards " + tSafeg
	# v0.29: the rules of the six carried weaves a constitution names -- judged, held by construction, carried -- printed only when one is named
	tJudged = ""
	tHeld = ""
	tCarried = ""
	bSix = false
	if not IsEmpty(xCs)
		for i = 1 to Len(xCs[3])
			tWn = xCs[3][i][1]
			if tWn != "sovereignty" and tWn != "privacy"
				bSix = true
				xWr = StzuWeaveRules(tWn)
				tJudged = StzuAppendWords(tJudged, xWr[1])
				tHeld = StzuAppendWords(tHeld, xWr[2])
				tCarried = StzuAppendWords(tCarried, xWr[3])
			end
		end
	end
	if bSix
		? "judged " + tJudged
		? "held " + tHeld
		? "carried " + tCarried
	end
	# v0.40: the doors, printed only for a language that NEEDS -- so every other verdict keeps its bytes
	xDoors = LangGet(xLang, "needs")
	if not IsEmpty(xDoors)
		tNd = ""
		for i = 1 to Len(xDoors)
			if i > 1 tNd += "," end
			tNd += xDoors[i]
		end
		? "needs " + tNd
		xOpn = LangGet(xLang, "opens")
		tOpn = ""
		for i = 1 to Len(xOpn)
			if i > 1 tOpn += "," end
			tOpn += xOpn[i][1] + ":" + xOpn[i][2]
		end
		? "opens " + tOpn
	end
	xD = LangGet(xLang, "declarations")
	xV = []
	for i = 1 to Len(xD)
		xV + xD[i][2]
	end
	xV = Sort(xV)
	tV = ""
	for i = 1 to Len(xV)
		if i > 1 tV += "," end
		tV += xV[i]
	end
	? "verbs " + tV
	# v0.25: a weave's warnings and notes, after the fields
	for i = 1 to Len($vStzuWarnings)
		? "warning " + $vStzuWarnings[i]
	end
	for i = 1 to Len($vStzuNotes)
		? "note " + $vStzuNotes[i]
	end
end
