root ::= ws decl (ws decl)* ws
decl ::= decl_FLEET | decl_MEMBER | decl_RETIREMENT
decl_FLEET ::= "DEFINE" sp "FLEET" sp ident sp "AS" ws "(" ws (clause_FLEET (ws "," ws clause_FLEET)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_FLEET ::= "LINK" sp ident
