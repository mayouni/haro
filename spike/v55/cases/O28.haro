f(3)
oQ = new Q
oQ.g()
/* a comment
across lines */
func f(iN)
	for iI = 1 to iN
		if iI = 1
			loop
		elseif iI = 3 and not false
			exit
		else
			FWrite(stdout, "i")
			? iI
		end
	end
	switch iN
	case 1
		? "one"
	else
		? 'other "n"'
	end
	try
		Raise("x")
	catch
		? "caught"
	end
end
class P
	nX = 1
end
class Q from P
	def g
		oP = new P {
			nX = 5
			? ClassName(self)
		}
		? ClassName(this)  # this is the method's object
		? oP.nX
	end
end
