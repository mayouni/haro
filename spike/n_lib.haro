# n_lib.haro -- the dynamic half of N, the natural letter, in pure core Ring (the seventeenth rung).
#
# Loaded by a court FORGED from a letter that declares an UNDERSTAND (forge.haro), and only by one. It
# reads the sentence the court has already parsed -- the court's own declaration records, never a second
# parser -- through the eight roles the UNDERSTAND names ($aCourtUnderstand), so it knows no kind by its
# spelling: a letter that plays the roles with other declarations is understood the same way.
#
#   NatCheckRules(aDecls)    the rules of v17/GRAMMAR.md section 4b, raised through the court's own CtFailC
#   NatMain(cVerb)           tokens, understand, ask, vocabulary, examples -- one JSON object on stdout
#
# The algorithm is v17/n_model.py's, ported and judged against it (v17/n_check.py): gate, separators, case
# folding, each token ignored, a word of a meaning, a generated entity or alias word, or digits (1 to 12);
# the meanings, in order, against each frame's SHAPE; the template filled. Nothing a question says is
# evaluated. Case is folded for ASCII and for Latin-1 (the two-byte letters U+00C0 to U+00DE), and for no
# other script: a tongue whose script has case needs the court to learn it, in the open.
#
# A context aN is built once per verb from the declaration records:
#   1 the records  2 the worlds [surface, [[s, p, o], ...], read?, path]  3 tongues  4 meanings  5 aliases
#   6 surfaces  7 steps  8 frames  9 examples  10 counterexamples
# A result of understand/ask is ["ok", frame, slots [[name, value]], surface, query, steps [[surface, query,
# binds]], answer, answered?, told, query2, runs [[surface, court, world, query]]] or ["refused", kind, what,
# message, tongue].
#
# Functions only, and no global of its own beyond the two the forge emits ($aCourtUnderstand, $bNSurfaces).

# ---- bytes and words ---------------------------------------------------------------------------------

func NatFold(tS)
	tOut = ""
	nLen = Len(tS)
	nI = 1
	while nI <= nLen
		tC = tS[nI]
		nA = Ascii(tC)
		if nA >= 65 and nA <= 90
			tOut += Char(nA + 32)
			nI++
		elseif nA = 195 and nI < nLen
			nB = Ascii(tS[nI + 1])
			if nB >= 128 and nB <= 158 and nB != 151
				tOut += tC + Char(nB + 32)
			else
				tOut += tC + tS[nI + 1]
			end
			nI += 2
		else
			tOut += tC
			nI++
		end
	end
	return tOut
end
func NatUpperFirst(tS)
	if Len(tS) = 0 return tS end
	nA = Ascii(tS[1])
	if nA >= 97 and nA <= 122
		if Len(tS) = 1 return Char(nA - 32) end
		return Char(nA - 32) + SubStr(tS, 2)
	end
	return tS
end
func NatSpell(tEnt, tHow)
	if tHow = "upper_first" return NatUpperFirst(tEnt) end
	return tEnt
end
# the words of a text: split on a space, a tab, a line feed or a carriage return
func NatWords(tS)
	xOut = []
	tWord = ""
	for i = 1 to Len(tS)
		tC = tS[i]
		if tC = " " or tC = Char(9) or tC = Char(10) or tC = Char(13)
			if Len(tWord) > 0
				xOut + tWord
				tWord = ""
			end
		else
			tWord += tC
		end
	end
	if Len(tWord) > 0 xOut + tWord end
	return xOut
end
func NatTrim(tS)
	nFrom = 1
	nTo = Len(tS)
	while nFrom <= nTo and NatIsSpace(tS[nFrom])
		nFrom++
	end
	while nTo >= nFrom and NatIsSpace(tS[nTo])
		nTo--
	end
	if nTo < nFrom return "" end
	return SubStr(tS, nFrom, nTo - nFrom + 1)
end
func NatIsSpace(tC)
	nA = Ascii(tC)
	return nA = 32 or nA = 9 or nA = 10 or nA = 13
end
func NatIsDigits(tS)
	if Len(tS) = 0 return false end
	for i = 1 to Len(tS)
		nA = Ascii(tS[i])
		if nA < 48 or nA > 57 return false end
	end
	return true
end
func NatIsWordChar(tC)
	nA = Ascii(tC)
	return (nA >= 48 and nA <= 57) or (nA >= 65 and nA <= 90) or (nA >= 97 and nA <= 122) or nA = 95 or nA >= 128
end
func NatLess(tA, tB)
	nMin = Len(tA)
	if Len(tB) < nMin nMin = Len(tB) end
	for i = 1 to nMin
		nX = Ascii(tA[i])
		nY = Ascii(tB[i])
		if nX < nY return true end
		if nX > nY return false end
	end
	return Len(tA) < Len(tB)
end
func NatLines(tS)
	xOut = []
	tLine = ""
	for i = 1 to Len(tS)
		tC = tS[i]
		if tC = Char(10)
			xOut + tLine
			tLine = ""
		elseif tC != Char(13)
			tLine += tC
		end
	end
	xOut + tLine
	return xOut
end
# the fields of a line separated by |, each trimmed
func NatSplitBar(tS)
	xOut = []
	tField = ""
	for i = 1 to Len(tS)
		if tS[i] = "|"
			xOut + NatTrim(tField)
			tField = ""
		else
			tField += tS[i]
		end
	end
	xOut + NatTrim(tField)
	return xOut
end
func NatCount(tS, tCh)
	nN = 0
	for i = 1 to Len(tS)
		if tS[i] = tCh nN++ end
	end
	return nN
end
# every {name} of a template, in order
func NatPlaceholders(tS)
	xOut = []
	nLen = Len(tS)
	nI = 1
	while nI <= nLen
		if tS[nI] = "{"
			nJ = nI + 1
			while nJ <= nLen and NatIsWordChar(tS[nJ])
				nJ++
			end
			if nJ > nI + 1 and nJ <= nLen and tS[nJ] = "}"
				xOut + SubStr(tS, nI + 1, nJ - nI - 1)
				nI = nJ + 1
			else
				nI++
			end
		else
			nI++
		end
	end
	return xOut
end
func NatHex(nN)
	nHi = Floor(nN / 16)
	nLo = nN - nHi * 16
	return SubStr("0123456789abcdef", nHi + 1, 1) + SubStr("0123456789abcdef", nLo + 1, 1)
end
# a JSON string
func NatQ(tS)
	tOut = ""
	for i = 1 to Len(tS)
		tC = tS[i]
		nA = Ascii(tC)
		if tC = Char(34)
			tOut += Char(92) + Char(34)
		elseif tC = Char(92)
			tOut += Char(92) + Char(92)
		elseif nA = 10
			tOut += Char(92) + "n"
		elseif nA = 13
			tOut += Char(92) + "r"
		elseif nA = 9
			tOut += Char(92) + "t"
		elseif nA < 32
			tOut += Char(92) + "u00" + NatHex(nA)
		else
			tOut += tC
		end
	end
	return Char(34) + tOut + Char(34)
end
func NatQList(xL)
	tOut = "["
	for i = 1 to Len(xL)
		if i > 1 tOut += ", " end
		tOut += NatQ(xL[i])
	end
	return tOut + "]"
end
func NatSameList(xA, xB)
	if Len(xA) != Len(xB) return false end
	for i = 1 to Len(xA)
		if xA[i] != xB[i] return false end
	end
	return true
end
# ---- the declaration records, read by seat -----------------------------------------------------------------

# the clause of a seat, [NAME, line, value, start, end], or NULL
func NatClause(xD, tSeat)
	tU = Upper(tSeat)
	xC = xD[4]
	for i = 1 to Len(xC)
		if xC[i][1] = tU return xC[i] end
	end
	return ""
end
func NatHas(xD, tSeat)
	return not IsEmpty(NatClause(xD, tSeat))
end
# a word or a string, else ""
func NatText(xD, tSeat)
	xC = NatClause(xD, tSeat)
	if IsEmpty(xC) return "" end
	if xC[3][1] = "word" or xC[3][1] = "string" return xC[3][2] end
	return ""
end
# a list of words, else []
func NatNames(xD, tSeat)
	xC = NatClause(xD, tSeat)
	if IsEmpty(xC) return [] end
	if xC[3][1] = "namelist" return xC[3][2] end
	return []
end
# name: value pairs as [[name, value], ...], else []
func NatPairs(xD, tSeat)
	xOut = []
	xC = NatClause(xD, tSeat)
	if IsEmpty(xC) return xOut end
	if xC[3][1] != "pairlist" return xOut end
	xP = xC[3][2]
	for i = 1 to Len(xP)
		xOut + [xP[i][1], xP[i][2]]
	end
	return xOut
end
# the value of a key in a list of pairs, or ""; the second answer is whether the key is there
func NatPairValue(vPairs, tKey)
	for i = 1 to Len(vPairs)
		if vPairs[i][1] = tKey return vPairs[i][2] end
	end
	return ""
end
func NatHasKey(vPairs, tKey)
	for i = 1 to Len(vPairs)
		if vPairs[i][1] = tKey return true end
	end
	return false
end
# the verb of the declaration kind that plays a role of the UNDERSTAND
func NatVerbOf(tRole)
	xR = $xCourtUnderstand[2]
	for i = 1 to Len(xR)
		if xR[i][1] = tRole
			xK = CtKindByDeclName(xR[i][2])
			if not IsEmpty(xK) return xK[1] end
		end
	end
	return ""
end
func NatOf(xDecls, tRole)
	tV = NatVerbOf(tRole)
	xOut = []
	for i = 1 to Len(xDecls)
		if xDecls[i][1] = tV xOut + xDecls[i] end
	end
	return xOut
end
func NatFind(xList, tName)
	for i = 1 to Len(xList)
		if xList[i][2] = tName return xList[i] end
	end
	return ""
end
# ---- the world: a surface's versioned artifact (facts `s | p | o` under a `facts` line) -------------------

func NatPath(tRel)
	if $tCourtDir = "" return tRel end
	return $tCourtDir + "/" + tRel
end
# [read?, [[s, p, o], ...]]
func NatReadWorld(tPath)
	if not FExists(tPath) return [false, []] end
	xLines = NatLines(Read(tPath))
	tSection = ""
	vTriples = []
	for i = 1 to Len(xLines)
		tT = NatTrim(xLines[i])
		if tT = "facts" or tT = "ontology"
			tSection = tT
		elseif tSection = "facts" and NatCount(tT, "|") = 2
			xP = NatSplitBar(tT)
			vTriples + [xP[1], xP[2], xP[3]]
		end
	end
	return [true, vTriples]
end
func NatBuild(xDecls)
	vWorlds = []
	xSurf = NatOf(xDecls, "SURFACE")
	for i = 1 to Len(xSurf)
		tW = NatText(xSurf[i], "world")
		if tW != ""
			xR = NatReadWorld(NatPath(tW))
			vWorlds + [xSurf[i][2], xR[2], xR[1], NatPath(tW)]
		end
	end
	return [xDecls, vWorlds, NatOf(xDecls, "TONGUE"), NatOf(xDecls, "MEANING"), NatOf(xDecls, "ALIAS"), xSurf,
	        NatOf(xDecls, "STEP"), NatOf(xDecls, "FRAME"), NatOf(xDecls, "EXAMPLE"), NatOf(xDecls, "COUNTEREXAMPLE")]
end
func NatTriples(xN, tSurface)
	xW = xN[2]
	for i = 1 to Len(xW)
		if xW[i][1] = tSurface return xW[i][2] end
	end
	return []
end
# the ids a surface enumerates for the entity kind a meaning is OF
func NatEntities(xN, xMeaning)
	xOut = []
	if NatText(xMeaning, "slot") != "entity" return xOut end
	tFrom = NatText(xMeaning, "from")
	tOf = NatText(xMeaning, "of")
	if tFrom = "" or tOf = "" return xOut end
	xT = NatTriples(xN, tFrom)
	for i = 1 to Len(xT)
		if xT[i][2] = "is-a" and xT[i][3] = tOf xOut + xT[i][1] end
	end
	return xOut
end
# ---- the lexicon of a tongue: [ignored, [[word, meaning, entity], ...], [[word, meaning, meaning], ...]] ------

func NatAddWord(xWords, vClash, tWord, tMeaning, tEnt)
	tKey = NatFold(tWord)
	for i = 1 to Len(xWords)
		if xWords[i][1] = tKey
			if not (xWords[i][2] = tMeaning and xWords[i][3] = tEnt)
				vClash + [tKey, xWords[i][2], tMeaning]
			end
			xWords[i][2] = tMeaning
			xWords[i][3] = tEnt
			return
		end
	end
	xWords + [tKey, tMeaning, tEnt]
end
func NatLexicon(xN, tTongue)
	xT = NatFind(xN[3], tTongue)
	vIgnored = []
	xIg = NatWords(NatText(xT, "ignores"))
	for i = 1 to Len(xIg)
		vIgnored + NatFold(xIg[i])
	end
	xWords = []
	vClash = []
	xM = xN[4]
	for i = 1 to Len(xM)
		xP = NatPairs(xM[i], "words")
		for j = 1 to Len(xP)
			if xP[j][1] = tTongue
				xTx = NatWords(xP[j][2])
				for k = 1 to Len(xTx)
					NatAddWord(xWords, vClash, xTx[k], xM[i][2], "")
				end
			end
		end
		if NatText(xM[i], "slot") = "entity"
			xE = NatEntities(xN, xM[i])
			for j = 1 to Len(xE)
				NatAddWord(xWords, vClash, xE[j], xM[i][2], xE[j])
			end
		end
	end
	xA = xN[5]
	for i = 1 to Len(xA)
		xP = NatPairs(xA[i], "words")
		for j = 1 to Len(xP)
			if xP[j][1] = tTongue
				xTx = NatWords(xP[j][2])
				for k = 1 to Len(xTx)
					NatAddWord(xWords, vClash, xTx[k], NatText(xA[i], "meaning"), NatText(xA[i], "entity"))
				end
			end
		end
	end
	return [vIgnored, xWords, vClash]
end
# the word an answer is told in: an alias's first word, else the tongue's own spelling of a name
func NatCanonical(xN, tTongue, tEnt)
	xA = xN[5]
	for i = 1 to Len(xA)
		if NatText(xA[i], "entity") = tEnt
			xP = NatPairs(xA[i], "words")
			for j = 1 to Len(xP)
				if xP[j][1] = tTongue
					xTx = NatWords(xP[j][2])
					if Len(xTx) > 0 return xTx[1] end
				end
			end
		end
	end
	tHow = NatText(NatFind(xN[3], tTongue), "names")
	if tHow = "" tHow = "as_is" end
	return NatSpell(tEnt, tHow)
end
# the one meaning that captures digits: the only text of a question a query may hold
func NatNumMeaning(xN)
	xM = xN[4]
	for i = 1 to Len(xM)
		if NatText(xM[i], "slot") = "number" return xM[i][2] end
	end
	return ""
end
# ---- the gate and the tokens ------------------------------------------------------------------------------------

# "" when every character passes; else the one refused, a control character by its code
func NatGate(xT, tText)
	tAllows = NatText(xT, "allows")
	for i = 1 to Len(tText)
		tC = tText[i]
		nA = Ascii(tC)
		bOk = false
		if nA >= 128 or nA = 32 or (nA >= 48 and nA <= 57) or (nA >= 65 and nA <= 90) or (nA >= 97 and nA <= 122)
			bOk = true
		end
		if not bOk
			for j = 1 to Len(tAllows)
				if tAllows[j] = tC bOk = true end
			end
		end
		if not bOk
			if nA < 32 or nA = 127 return "(control character " + String(nA) + ")" end
			return tC
		end
	end
	return ""
end
func NatRefuse(xN, tTongue, tKind, tWhat)
	tMsg = tKind + ": " + tWhat
	xR = NatPairs(NatFind(xN[3], tTongue), "refuses")
	if NatHasKey(xR, tKind) tMsg = CtReplace(NatPairValue(xR, tKind), "{what}", tWhat) end
	return ["refused", tKind, tWhat, tMsg, tTongue]
end
# ["refused", kind, what] or ["ok", [[meaning, entity, raw], ...], [ignored raw words]]
func NatTokens(xN, tTongue, tText)
	xT = NatFind(xN[3], tTongue)
	tBad = NatGate(xT, tText)
	if tBad != "" return ["refused", "character", tBad] end
	xLex = NatLexicon(xN, tTongue)
	tNorm = tText
	tSeps = "'?,."
	for i = 1 to Len(tSeps)
		tNorm = CtReplace(tNorm, tSeps[i], " ")
	end
	tNum = NatNumMeaning(xN)
	xToks = []
	vSkipped = []
	xRaw = NatWords(tNorm)
	for i = 1 to Len(xRaw)
		tKey = NatFold(xRaw[i])
		if CtInList(tKey, xLex[1])
			vSkipped + xRaw[i]
			loop
		end
		nAt = 0
		for j = 1 to Len(xLex[2])
			if xLex[2][j][1] = tKey nAt = j end
		end
		if nAt > 0
			xToks + [xLex[2][nAt][2], xLex[2][nAt][3], xRaw[i]]
		elseif tNum != "" and NatIsDigits(tKey) and Len(tKey) <= 12
			xToks + [tNum, tKey, xRaw[i]]
		else
			return ["refused", "word", xRaw[i]]
		end
	end
	return ["ok", xToks, vSkipped]
end
# ---- understand ---------------------------------------------------------------------------------------------------

# a template with its slots filled: an entity spelled the way the target surface spells its kind
func NatFill(xN, tTemplate, vSlots, tSurface)
	tOut = tTemplate
	xSpells = NatPairs(NatFind(xN[6], tSurface), "spells")
	for i = 1 to Len(vSlots)
		tVal = vSlots[i][2]
		xM = NatFind(xN[4], vSlots[i][1])
		if not IsEmpty(xM)
			if NatText(xM, "slot") = "entity"
				tHow = "as_is"
				if NatHasKey(xSpells, NatText(xM, "of")) tHow = NatPairValue(xSpells, NatText(xM, "of")) end
				tVal = NatSpell(tVal, tHow)
			end
		end
		tOut = CtReplace(tOut, "{" + vSlots[i][1] + "}", tVal)
	end
	return tOut
end
func NatSetSlot(vSlots, tName, tVal)
	for i = 1 to Len(vSlots)
		if vSlots[i][1] = tName
			vSlots[i][2] = tVal
			return
		end
	end
	vSlots + [tName, tVal]
end
func NatUnderstand(xN, tTongue, tText)
	xTk = NatTokens(xN, tTongue, tText)
	if xTk[1] = "refused" return NatRefuse(xN, tTongue, xTk[2], xTk[3]) end
	xToks = xTk[2]
	xShape = []
	for i = 1 to Len(xToks)
		xShape + xToks[i][1]
	end
	xFrames = xN[8]
	for i = 1 to Len(xFrames)
		xF = xFrames[i]
		if not NatSameList(NatNames(xF, "shape"), xShape) loop end
		vSlots = []
		for j = 1 to Len(xToks)
			xM = NatFind(xN[4], xToks[j][1])
			tSlot = NatText(xM, "slot")
			if tSlot = "number" or tSlot = "entity" NatSetSlot(vSlots, xToks[j][1], xToks[j][2]) end
		end
		# a sentence under construction may name a surface or a step nobody declared: a finding of the rules,
		# never a crash of the court
		bLawful = false
		if NatHas(xF, "steps")
			bLawful = true
			xSn = NatNames(xF, "steps")
			for j = 1 to Len(xSn)
				xS = NatFind(xN[7], xSn[j])
				if IsEmpty(xS)
					bLawful = false
				else
					if IsEmpty(NatFind(xN[6], NatText(xS, "target"))) bLawful = false end
				end
			end
		else
			if not IsEmpty(NatFind(xN[6], NatText(xF, "target"))) and NatHas(xF, "query") bLawful = true end
		end
		if not bLawful return NatRefuse(xN, tTongue, "surface", xF[2]) end
		tSurface = NatText(xF, "target")
		tQuery = ""
		xSteps = []
		if NatHas(xF, "steps")
			tSurface = "plan"
			xSn = NatNames(xF, "steps")
			for j = 1 to Len(xSn)
				xS = NatFind(xN[7], xSn[j])
				tQ = NatFill(xN, NatText(xS, "query"), vSlots, NatText(xS, "target"))
				xSteps + [NatText(xS, "target"), tQ, NatText(xS, "binds")]
			end
		else
			tQuery = NatFill(xN, NatText(xF, "query"), vSlots, tSurface)
		end
		return ["ok", xF[2], vSlots, tSurface, tQuery, xSteps, [], false, "", "", []]
	end
	return NatRefuse(xN, tTongue, "shape", NatJoinNames(xShape))
end
func NatJoinNames(xL)
	return CtJoin(xL, " ")
end
# ---- ask: a pattern surface answered, and told --------------------------------------------------------------------

# [ran?, [answer terms]]: a triple pattern over the surface's facts, `?x` a variable
func NatRunPattern(xN, tSurface, tQuery)
	xTerms = NatWords(tQuery)
	if Len(xTerms) != 3 return [false, []] end
	xT = NatTriples(xN, tSurface)
	xAns = []
	for i = 1 to Len(xT)
		bAll = true
		for j = 1 to 3
			if Left(xTerms[j], 1) != "?" and xTerms[j] != xT[i][j] bAll = false end
		end
		if bAll
			for j = 1 to 3
				if Left(xTerms[j], 1) = "?" xAns + xT[i][j] end
			end
		end
	end
	return [true, xAns]
end
# the answer told by the frame's own template in the tongue, or "" when the frame has none
func NatTell(xN, tTongue, xF, xAnswer, vSlots)
	tKey = "answers"
	if Len(xAnswer) = 0 tKey = "empty" end
	xP = NatPairs(xF, tKey)
	if not NatHasKey(xP, tTongue) return "" end
	tTpl = NatPairValue(xP, tTongue)
	xNames = []
	for i = 1 to Len(xAnswer)
		xNames + NatCanonical(xN, tTongue, xAnswer[i])
	end
	tConj = NatText(NatFind(xN[3], tTongue), "joins")
	if tConj = "" tConj = "and" end
	tJoined = ""
	if Len(xNames) = 1
		tJoined = xNames[1]
	elseif Len(xNames) > 1
		for i = 1 to Len(xNames) - 1
			if i > 1 tJoined += ", " end
			tJoined += xNames[i]
		end
		tJoined += " " + tConj + " " + xNames[Len(xNames)]
	end
	tOut = CtReplace(tTpl, "{answer}", tJoined)
	for i = 1 to Len(vSlots)
		tVal = vSlots[i][2]
		xM = NatFind(xN[4], vSlots[i][1])
		if not IsEmpty(xM)
			if NatText(xM, "slot") = "entity" tVal = NatCanonical(xN, tTongue, tVal) end
		end
		tOut = CtReplace(tOut, "{" + vSlots[i][1] + "}", tVal)
	end
	return tOut
end
func NatRunOf(xN, tSurface, tQuery)
	xSf = NatFind(xN[6], tSurface)
	return [tSurface, NatText(xSf, "court"), NatText(xSf, "world"), tQuery]
end
func NatAsk(xN, tTongue, tText)
	xU = NatUnderstand(xN, tTongue, tText)
	if xU[1] = "refused" return xU end
	xF = NatFind(xN[8], xU[2])
	if xU[4] = "plan"
		xSn = NatNames(xF, "steps")
		xS1 = NatFind(xN[7], xSn[1])
		tT1 = NatText(xS1, "target")
		tQ1 = NatFill(xN, NatText(xS1, "query"), xU[3], tT1)
		if NatText(NatFind(xN[6], tT1), "kind") != "pattern"
			xU[11] + NatRunOf(xN, tT1, tQ1)
			return xU
		end
		xRun = NatRunPattern(xN, tT1, tQ1)
		if not xRun[1] return NatRefuse(xN, tTongue, "surface", tQ1) end
		xAns = xRun[2]
		if Len(xAns) > 1 return NatRefuse(xN, tTongue, "ambiguous", NatJoinNames(xAns)) end
		xU[7] = xAns
		xU[8] = true
		xU[9] = NatTell(xN, tTongue, xF, xAns, xU[3])
		if Len(xAns) = 1 and Len(xSn) > 1
			xS2 = NatFind(xN[7], xSn[2])
			xSl = xU[3]
			if NatText(xS1, "binds") != "" NatSetSlot(xSl, NatText(xS1, "binds"), xAns[1]) end
			xU[10] = NatFill(xN, NatText(xS2, "query"), xSl, NatText(xS2, "target"))
			if NatText(NatFind(xN[6], NatText(xS2, "target")), "kind") != "pattern"
				xU[11] + NatRunOf(xN, NatText(xS2, "target"), xU[10])
			end
		end
		return xU
	end
	if NatText(NatFind(xN[6], xU[4]), "kind") = "pattern"
		xRun = NatRunPattern(xN, xU[4], xU[5])
		if not xRun[1] return NatRefuse(xN, tTongue, "surface", xU[5]) end
		xU[7] = xRun[2]
		xU[8] = true
		xU[9] = NatTell(xN, tTongue, xF, xRun[2], xU[3])
	else
		xU[11] + NatRunOf(xN, xU[4], xU[5])
	end
	return xU
end
# ---- the answers, as JSON ---------------------------------------------------------------------------------------

func NatJsonRefusal(xR)
	return '{"refused": {"kind": ' + NatQ(xR[2]) + ', "code": ' + NatQ("N_" + Upper(xR[2])) + ', "what": ' + NatQ(xR[3]) +
	       ', "tongue": ' + NatQ(xR[5]) + ', "message": ' + NatQ(xR[4]) + '}}'
end
func NatJsonResult(xR)
	if xR[1] = "refused" return NatJsonRefusal(xR) end
	tOut = '{"frame": ' + NatQ(xR[2]) + ', "surface": ' + NatQ(xR[4])
	if xR[4] != "plan" tOut += ', "query": ' + NatQ(xR[5]) end
	tOut += ', "slots": {'
	for i = 1 to Len(xR[3])
		if i > 1 tOut += ", " end
		tOut += NatQ(xR[3][i][1]) + ": " + NatQ(xR[3][i][2])
	end
	tOut += "}"
	if Len(xR[6]) > 0
		tOut += ', "steps": ['
		for i = 1 to Len(xR[6])
			if i > 1 tOut += ", " end
			tOut += '{"surface": ' + NatQ(xR[6][i][1]) + ', "query": ' + NatQ(xR[6][i][2])
			if xR[6][i][3] != "" tOut += ', "binds": ' + NatQ(xR[6][i][3]) end
			tOut += "}"
		end
		tOut += "]"
	end
	if xR[8] tOut += ', "answer": ' + NatQList(xR[7]) end
	if xR[9] != "" tOut += ', "told": ' + NatQ(xR[9]) end
	if xR[10] != "" tOut += ', "query2": ' + NatQ(xR[10]) end
	if Len(xR[11]) > 0
		tOut += ', "run": ['
		for i = 1 to Len(xR[11])
			if i > 1 tOut += ", " end
			tOut += '{"surface": ' + NatQ(xR[11][i][1]) + ', "court": ' + NatQ(xR[11][i][2]) + ', "world": ' + NatQ(xR[11][i][3]) + ', "query": ' + NatQ(xR[11][i][4]) + "}"
		end
		tOut += "]"
	end
	return tOut + "}"
end
func NatJsonTokens(xN, tTongue, tText)
	xTk = NatTokens(xN, tTongue, tText)
	if xTk[1] = "refused" return NatJsonRefusal(NatRefuse(xN, tTongue, xTk[2], xTk[3])) end
	tOut = '{"tongue": ' + NatQ(tTongue) + ', "tokens": ['
	for i = 1 to Len(xTk[2])
		if i > 1 tOut += ", " end
		tOut += '{"meaning": ' + NatQ(xTk[2][i][1]) + ', "word": ' + NatQ(xTk[2][i][3])
		if xTk[2][i][2] != "" tOut += ', "slot": ' + NatQ(xTk[2][i][2]) end
		tOut += "}"
	end
	return tOut + '], "ignored": ' + NatQList(xTk[3]) + "}"
end
func NatJsonVocabulary(xN, tTongue)
	xLex = NatLexicon(xN, tTongue)
	tOut = '{"tongue": ' + NatQ(tTongue) + ', "ignored": ' + NatQList(xLex[1]) + ', "words": ['
	for i = 1 to Len(xLex[2])
		if i > 1 tOut += ", " end
		tOut += '{"word": ' + NatQ(xLex[2][i][1]) + ', "meaning": ' + NatQ(xLex[2][i][2])
		if xLex[2][i][3] != "" tOut += ', "entity": ' + NatQ(xLex[2][i][3]) end
		tOut += "}"
	end
	tOut += '], "uncovered": ['
	nSeen = 0
	xM = xN[4]
	for i = 1 to Len(xM)
		if NatText(xM[i], "slot") = "none" and not NatHasKey(NatPairs(xM[i], "words"), tTongue)
			if nSeen > 0 tOut += ", " end
			tOut += NatQ(xM[i][2])
			nSeen++
		end
	end
	tOut += '], "clashes": ['
	for i = 1 to Len(xLex[3])
		if i > 1 tOut += ", " end
		tOut += '{"word": ' + NatQ(xLex[3][i][1]) + ', "meanings": ' + NatQList([xLex[3][i][2], xLex[3][i][3]]) + "}"
	end
	return tOut + "]}"
end
# the sentence's own conformance, counted
func NatJsonExamples(xN)
	nTexts = 0
	nUnderstood = 0
	nFailed = 0
	nDiverging = 0
	xEx = xN[9]
	for i = 1 to Len(xEx)
		tMeans = NatText(xEx[i], "means")
		xP = NatPairs(xEx[i], "asking")
		xQ = []
		for j = 1 to Len(xP)
			if IsEmpty(NatFind(xN[3], xP[j][1])) loop end
			nTexts++
			xU = NatUnderstand(xN, xP[j][1], xP[j][2])
			if xU[1] = "ok" and xU[2] = tMeans
				nUnderstood++
				if not CtInList(xU[4] + " " + xU[5] + NatStepsText(xU[6]), xQ) xQ + (xU[4] + " " + xU[5] + NatStepsText(xU[6])) end
			else
				nFailed++
			end
		end
		if Len(xQ) > 1 nDiverging++ end
	end
	nCTexts = 0
	nRefused = 0
	nCFailed = 0
	xCe = xN[10]
	for i = 1 to Len(xCe)
		tWant = NatText(xCe[i], "refused")
		xP = NatPairs(xCe[i], "asking")
		for j = 1 to Len(xP)
			if IsEmpty(NatFind(xN[3], xP[j][1])) loop end
			nCTexts++
			xU = NatUnderstand(xN, xP[j][1], xP[j][2])
			if xU[1] = "refused" and xU[2] = tWant
				nRefused++
			else
				nCFailed++
			end
		end
	end
	return '{"examples": {"declared": ' + String(Len(xEx)) + ', "texts": ' + String(nTexts) + ', "understood": ' + String(nUnderstood) + ', "failed": ' + String(nFailed) +
	       ', "diverging": ' + String(nDiverging) + '}, "counterexamples": {"declared": ' + String(Len(xCe)) + ', "texts": ' + String(nCTexts) +
	       ', "refused": ' + String(nRefused) + ', "failed": ' + String(nCFailed) + "}}"
end
# a plan's queries as one text: two tongues compile to the SAME plan when this is the same
func NatStepsText(xSteps)
	tOut = ""
	for i = 1 to Len(xSteps)
		tOut += " => " + xSteps[i][1] + " " + xSteps[i][2]
	end
	return tOut
end
# ---- the rules of v17/GRAMMAR.md section 4b ---------------------------------------------------------------------

# the safe set of punctuation: a tongue may allow a subset of it, never more
func NatSafeSet
	return "-'?,."
end
func NatAdd(xF, tCode, nLine, tMsg)
	xF + [tCode, nLine, tMsg]
end
# the sample a surface is asked about: a number is 1, an entity is Sample, a slot nobody declared stays
func NatSampleFill(xN, tTemplate)
	tOut = tTemplate
	xPh = NatPlaceholders(tTemplate)
	for i = 1 to Len(xPh)
		xM = NatFind(xN[4], xPh[i])
		if not IsEmpty(xM)
			tSv = "x"
			if NatText(xM, "slot") = "number" tSv = "1" end
			if NatText(xM, "slot") = "entity" tSv = "Sample" end
			tOut = CtReplace(tOut, "{" + xPh[i] + "}", tSv)
		end
	end
	return tOut
end
# a temporary file beside the user's own temporary folder
func NatTempFile
	tDir = SysGet("TEMP")
	if tDir = "" tDir = "." end
	return tDir + "/nat_" + String(Clock()) + "_" + String(Random(99999)) + ".txt"
end
func NatQuote(tS)
	return Char(34) + tS + Char(34)
end
# a surface's court that is a court FILE is a sibling of this court: a bare name ending in _court.haro, never a path.
# `check ... surfaces` RUNS it, so what a sentence may name there is a door, and the door is one folder wide
func NatCourtIsSibling(tFile)
	if Len(tFile) <= 11 return false end
	if Right(tFile, 11) != "_court.haro" return false end
	for i = 1 to Len(tFile)
		tC = tFile[i]
		if tC = "/" or tC = Char(92) or tC = ":" return false end
	end
	if SubStr(tFile, "..") > 0 return false end
	return true
end
# [ok?, why]: a surface judges a query of its grammar WITHOUT data. `triples` is three terms, judged here; a
# surface whose COURT is a court file is asked as the Q letter's court is -- its own `ask` over no rows answers
# [] for a lawful question and refuses the rest -- and only when the check was asked to reach the surfaces
func NatSurfaceCheck(xN, xSf, tQuery)
	if NatText(xSf, "grammar") = "triples"
		if Len(NatWords(tQuery)) = 3 return [true, ""] end
		return [false, "a triple pattern is three terms"]
	end
	if not $bNSurfaces return [true, ""] end
	xCw = NatWords(NatText(xSf, "court"))
	if Len(xCw) < 2 return [true, ""] end
	if Right(xCw[1], 5) != ".haro" return [true, ""] end
	if not NatCourtIsSibling(xCw[1]) return [true, ""] end
	if NatText(xSf, "world") = "" return [true, ""] end
	tCourt = xCw[1]
	tDir = CtDirOf(sysargv[2])
	if tDir != "" tCourt = tDir + "/" + tCourt end
	tVerbs = ""
	for i = 2 to Len(xCw)
		if i > 2 tVerbs += " " end
		tVerbs += xCw[i]
	end
	tTmp = NatTempFile()
	# the surface's answer is what it writes to its stdout; what a runtime says of itself on stderr is not an answer
	tNoErr = " 2>/dev/null"
	if IsWindows() tNoErr = " 2>NUL" end
	tInner = NatQuote(ExeFileName()) + " " + NatQuote(tCourt) + " " + tVerbs + " " + NatQuote(NatPath(NatText(xSf, "world"))) + " " + NatQuote(tQuery) + " [] > " + NatQuote(tTmp) + tNoErr
	System(NatQuote(tInner))
	tOut = ""
	if FExists(tTmp)
		tOut = NatTrim(Read(tTmp))
		Remove(tTmp)
	end
	if Left(tOut, 1) = "[" return [true, ""] end
	nNl = SubStr(tOut, Char(10))
	if nNl > 0 tOut = Left(tOut, nNl - 1) end
	return [false, Left(tOut, 200)]
end
func NatRules(xN)
	xF = []
	xMeanings = xN[4]
	xFrames = xN[8]
	xTongues = xN[3]
	# a surface whose world is not there cannot be judged
	xSurf = xN[6]
	for i = 1 to Len(xSurf)
		if NatText(xSurf[i], "world") != ""
			bRead = false
			for j = 1 to Len(xN[2])
				if xN[2][j][1] = xSurf[i][2] bRead = xN[2][j][3] end
			end
			if not bRead
				NatAdd(xF, "N_WORLD_UNREAD", xSurf[i][3], "SURFACE " + xSurf[i][2] + " reads the world '" + NatText(xSurf[i], "world") + "', which cannot be read from the sentence's folder")
			end
		end
	end
	for i = 1 to Len(xSurf)
		xCw = NatWords(NatText(xSurf[i], "court"))
		if Len(xCw) > 0
			if Right(xCw[1], 5) = ".haro" and not NatCourtIsSibling(xCw[1])
				NatAdd(xF, "N_SURFACE_COURT", xSurf[i][3], "SURFACE " + xSurf[i][2] + " names the court file '" + xCw[1] + "': a surface's court is a court beside this one, a bare name ending in _court.haro and never a path, because `check ... surfaces` runs it")
			end
		end
	end
	for i = 1 to Len(xFrames)
		xFr = xFrames[i]
		xShape = NatNames(xFr, "shape")
		vSlots = []
		for j = 1 to Len(xShape)
			xM = NatFind(xMeanings, xShape[j])
			if not IsEmpty(xM)
				tSl = NatText(xM, "slot")
				if tSl = "number" or tSl = "entity" vSlots + xShape[j] end
			end
		end
		for j = 1 to Len(vSlots)
			nTimes = 0
			for k = 1 to Len(vSlots)
				if vSlots[k] = vSlots[j] nTimes++ end
			end
			if nTimes > 1
				NatAdd(xF, "N_SLOT_REPEATED", xFr[3], "FRAME " + xFr[2] + " names a slot meaning twice in its SHAPE: '" + vSlots[j] + "'")
				exit
			end
		end
		bHasQ = NatHas(xFr, "target") and NatHas(xFr, "query")
		bHasS = NatHas(xFr, "steps")
		if bHasQ = bHasS
			NatAdd(xF, "N_FRAME_TARGET", xFr[3], "FRAME " + xFr[2] + " must have either a TARGET and a QUERY or STEPS, and not both nor neither")
		end
		vAvail = []
		for j = 1 to Len(vSlots)
			vAvail + vSlots[j]
		end
		if bHasS
			xSn = NatNames(xFr, "steps")
			for j = 1 to Len(xSn)
				xSt = NatFind(xN[7], xSn[j])
				if IsEmpty(xSt) loop end
				xPh = NatPlaceholders(NatText(xSt, "query"))
				for k = 1 to Len(xPh)
					if not CtInList(xPh[k], vAvail)
						NatAdd(xF, "N_SLOT_UNKNOWN", xSt[3], "STEP " + xSt[2] + " uses {" + xPh[k] + "}, which is neither a slot of FRAME " + xFr[2] + "'s SHAPE nor bound by an earlier step")
					end
				end
				if NatText(xSt, "binds") != "" vAvail + NatText(xSt, "binds") end
			end
		elseif bHasQ
			xPh = NatPlaceholders(NatText(xFr, "query"))
			for k = 1 to Len(xPh)
				if not CtInList(xPh[k], vAvail)
					NatAdd(xF, "N_SLOT_UNKNOWN", xFr[3], "FRAME " + xFr[2] + " QUERY uses {" + xPh[k] + "}, which is not a slot of its SHAPE")
				end
			end
		end
		for nKey = 1 to 2
			tKey = "answers"
			if nKey = 2 tKey = "empty" end
			xP = NatPairs(xFr, tKey)
			for j = 1 to Len(xP)
				xPh = NatPlaceholders(xP[j][2])
				for k = 1 to Len(xPh)
					if not CtInList(xPh[k], vSlots) and not (xPh[k] = "answer" and tKey = "answers") and not CtInList(xPh[k], vAvail)
						NatAdd(xF, "N_SLOT_UNKNOWN", xFr[3], "FRAME " + xFr[2] + " " + Upper(tKey) + " in " + xP[j][1] + " uses {" + xPh[k] + "}, which is not a slot of its SHAPE")
					end
				end
			end
		end
		# the query is judged by its surface, here, without data
		vTargets = []
		if bHasQ
			vTargets + [NatText(xFr, "target"), NatText(xFr, "query")]
		else
			xSn = NatNames(xFr, "steps")
			for j = 1 to Len(xSn)
				xSt = NatFind(xN[7], xSn[j])
				if not IsEmpty(xSt) vTargets + [NatText(xSt, "target"), NatText(xSt, "query")] end
			end
		end
		for j = 1 to Len(vTargets)
			xSf = NatFind(xN[6], vTargets[j][1])
			if IsEmpty(xSf) or vTargets[j][2] = "" loop end
			xVd = NatSurfaceCheck(xN, xSf, NatSampleFill(xN, vTargets[j][2]))
			if not xVd[1]
				NatAdd(xF, "N_QUERY_REFUSED", xFr[3], "FRAME " + xFr[2] + ": the surface '" + vTargets[j][1] + "' refuses the query '" + vTargets[j][2] + "': " + xVd[2])
			end
		end
		# every tongue can tell the answer: by the frame's template, or by the surface's own voice
		tTgt = NatText(xFr, "target")
		if tTgt = "" and bHasS
			xSn = NatNames(xFr, "steps")
			if Len(xSn) > 0
				xLast = NatFind(xN[7], xSn[Len(xSn)])
				if not IsEmpty(xLast) tTgt = NatText(xLast, "target") end
			end
		end
		xTells = []
		xSfT = NatFind(xN[6], tTgt)
		if not IsEmpty(xSfT) xTells = NatNames(xSfT, "tells") end
		xAnsP = NatPairs(xFr, "answers")
		xEmpP = NatPairs(xFr, "empty")
		for j = 1 to Len(xTongues)
			tTn = xTongues[j][2]
			bHave = NatHasKey(xAnsP, tTn)
			bEmpty = NatHasKey(xEmpP, tTn)
			if bHave and not bEmpty
				NatAdd(xF, "N_TELL_UNCOVERED", xFr[3], "FRAME " + xFr[2] + " has ANSWERS in " + tTn + " but no EMPTY: an answer may be nobody")
			end
			if bHasS
				if not bHave
					NatAdd(xF, "N_TELL_UNCOVERED", xFr[3], "FRAME " + xFr[2] + " has no ANSWERS in " + tTn + " for its first step")
				end
				if not CtInList(tTn, xTells)
					NatAdd(xF, "N_TELL_UNCOVERED", xFr[3], "FRAME " + xFr[2] + " cannot tell its last step in " + tTn + ": the surface '" + tTgt + "' does not tell in " + tTn)
				end
			elseif not bHave and not CtInList(tTn, xTells)
				NatAdd(xF, "N_TELL_UNCOVERED", xFr[3], "FRAME " + xFr[2] + " cannot be told in " + tTn + ": no ANSWERS in " + tTn + " and the surface '" + tTgt + "' does not tell in " + tTn)
			end
		end
	end
	xKinds = ["character", "word", "shape", "ambiguous", "surface"]
	for i = 1 to Len(xTongues)
		xT = xTongues[i]
		xRp = NatPairs(xT, "refuses")
		vMiss = []
		for j = 1 to Len(xKinds)
			if not NatHasKey(xRp, xKinds[j]) vMiss + xKinds[j] end
		end
		if Len(vMiss) > 0
			NatAdd(xF, "N_REFUSAL_UNCOVERED", xT[3], "TONGUE " + xT[2] + " does not say how it refuses: " + CtJoin(vMiss, ", "))
		end
		tAllows = NatText(xT, "allows")
		for j = 1 to Len(tAllows)
			if SubStr(NatSafeSet(), tAllows[j]) = 0
				NatAdd(xF, "N_GATE_WIDENED", xT[3], "TONGUE " + xT[2] + " ALLOWS '" + tAllows[j] + "', outside the court's safe set " + NatSafeSet() + ": a tongue cannot widen the gate")
				exit
			end
		end
		xLex = NatLexicon(xN, xT[2])
		for j = 1 to Len(xLex[3])
			NatAdd(xF, "N_WORD_AMBIGUOUS", xT[3], "in " + xT[2] + " the word '" + xLex[3][j][1] + "' means both " + xLex[3][j][2] + " and " + xLex[3][j][3])
		end
		vShown = []
		for j = 1 to Len(xLex[1])
			for k = 1 to Len(xLex[2])
				if xLex[2][k][1] = xLex[1][j] and not CtInList(xLex[1][j], vShown)
					vShown + xLex[1][j]
					NatAdd(xF, "N_WORD_IGNORED", xT[3], "in " + xT[2] + " the word '" + xLex[1][j] + "' is both ignored and a word of " + xLex[2][k][2])
				end
			end
		end
	end
	for i = 1 to Len(xMeanings)
		xM = xMeanings[i]
		tSl = NatText(xM, "slot")
		if tSl = "none"
			xWp = NatPairs(xM, "words")
			for j = 1 to Len(xTongues)
				if not NatHasKey(xWp, xTongues[j][2])
					NatAdd(xF, "N_TONGUE_UNCOVERED", xM[3], "MEANING " + xM[2] + " has no words in " + xTongues[j][2])
				end
			end
		end
		if tSl = "entity"
			xSf = NatFind(xN[6], NatText(xM, "from"))
			if NatText(xM, "of") = "" or NatText(xM, "from") = ""
				NatAdd(xF, "N_ENTITY_UNKNOWN", xM[3], "MEANING " + xM[2] + " is an entity and needs both OF and FROM")
			elseif not IsEmpty(xSf) and not CtInList(NatText(xM, "of"), NatNames(xSf, "entities"))
				NatAdd(xF, "N_ENTITY_UNKNOWN", xM[3], "MEANING " + xM[2] + " is of '" + NatText(xM, "of") + "', which the surface '" + NatText(xM, "from") + "' does not enumerate")
			end
		end
	end
	xEx = xN[9]
	for i = 1 to Len(xEx)
		tMeans = NatText(xEx[i], "means")
		if IsEmpty(NatFind(xFrames, tMeans)) loop end
		xP = NatPairs(xEx[i], "asking")
		xGot = []
		for j = 1 to Len(xP)
			if IsEmpty(NatFind(xTongues, xP[j][1])) loop end
			xU = NatUnderstand(xN, xP[j][1], xP[j][2])
			if xU[1] = "ok" and xU[2] = tMeans
				tShape = xU[4] + " " + xU[5] + NatStepsText(xU[6])
				if not CtInList(tShape, xGot) xGot + tShape end
			else
				tWas = "refused as " + xU[2]
				if xU[1] = "ok" tWas = "understood as " + xU[2] end
				NatAdd(xF, "N_EXAMPLE_FAILED", xEx[i][3], "EXAMPLE " + xEx[i][2] + " in " + xP[j][1] + " ('" + xP[j][2] + "') is " + tWas + ", not as " + tMeans)
			end
		end
		if Len(xGot) > 1
			NatAdd(xF, "N_EXAMPLE_DIVERGES", xEx[i][3], "EXAMPLE " + xEx[i][2] + " compiles to different queries in different tongues: " + CtJoin(xGot, " | "))
		end
	end
	xCe = xN[10]
	for i = 1 to Len(xCe)
		tWant = NatText(xCe[i], "refused")
		xP = NatPairs(xCe[i], "asking")
		for j = 1 to Len(xP)
			if IsEmpty(NatFind(xTongues, xP[j][1])) loop end
			xU = NatUnderstand(xN, xP[j][1], xP[j][2])
			if not (xU[1] = "refused" and xU[2] = tWant)
				tWas = "refused as " + xU[2]
				if xU[1] = "ok" tWas = "understood as " + xU[2] end
				NatAdd(xF, "N_COUNTEREXAMPLE_FAILED", xCe[i][3], "COUNTEREXAMPLE " + xCe[i][2] + " in " + xP[j][1] + " ('" + xP[j][2] + "') was " + tWas + ", not refused as " + tWant)
			end
		end
	end
	return NatSort(xF)
end
# findings [code, line, message], by line and then by code, stable
func NatSort(xF)
	xOut = []
	for i = 1 to Len(xF)
		nAt = Len(xOut) + 1
		for j = Len(xOut) to 1 step -1
			if xOut[j][2] > xF[i][2] or (xOut[j][2] = xF[i][2] and NatLess(xF[i][1], xOut[j][1]))
				nAt = j
			else
				exit
			end
		end
		Insert(xOut, nAt - 1, xF[i])
	end
	return xOut
end
# the court's own refusal path: each finding is a refusal with its code and its cite; `check` raises the first,
# `diagnose` notes them all
func NatCheckRules(xDecls)
	xN = NatBuild(xDecls)
	xF = NatRules(xN)
	for i = 1 to Len(xF)
		try
			CtFailC(xF[i][2], xF[i][1], ["rule:" + Lower(xF[i][1])], xF[i][3])
		catch
			CtNote(cCatchError)
		end
	end
end
# ---- the verbs ------------------------------------------------------------------------------------------------------

func NatMain(tVerb)
	nNeed = 6
	if tVerb = "vocabulary" nNeed = 5 end
	if tVerb = "examples" nNeed = 4 end
	if Len(sysargv) < nNeed
		tUse = "usage: <court>.haro " + tVerb + " <file" + $tCourtExt + ">"
		if nNeed >= 5 tUse += " <tongue>" end
		if nNeed = 6 tUse += " <text>" end
		? tUse
		return
	end
	try
		xDecls = CtDeclare(Read(sysargv[4]))
		xN = NatBuild(xDecls)
		if tVerb = "examples"
			? NatJsonExamples(xN)
		else
			tTongue = sysargv[5]
			if IsEmpty(NatFind(xN[3], tTongue)) CtFail(1, "the sentence declares no tongue '" + tTongue + "'") end
			if tVerb = "vocabulary"
				? NatJsonVocabulary(xN, tTongue)
			elseif tVerb = "tokens"
				? NatJsonTokens(xN, tTongue, sysargv[6])
			elseif tVerb = "understand"
				? NatJsonResult(NatUnderstand(xN, tTongue, sysargv[6]))
			else
				? NatJsonResult(NatAsk(xN, tTongue, sysargv[6]))
			end
		end
	catch
		? cCatchError
	end
end
