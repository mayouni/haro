# cond_lib.haro -- the condition language of stzu's CONSTRAINT and VIEW (v0.2,
# grown in v0.3 and v0.4), in pure core Ring.
#
# Closed and total: a condition is read, never run. The grammar is in
# haro/spike/v04/GRAMMAR.md (v0.3's in v03/, v0.2's in v02/). One
# parser, two readers: the meta-court VALIDATES a condition against the
# declarations' seats (every name it uses must exist, by type) and the forged
# court EVALUATES it on a sentence's declarations.
#
#   cond   = term { ("and" | "or") term }       -- and binds tighter than or
#   term   = [ "not" ] atom
#   atom   = "(" cond ")"
#          | "exists" decl
#          | ("some" | "all" | "earlier") path [ "named" (value | path) ] [ "where" cond ]
#          | path "=" (value | path) | path "!=" (value | path)
#          | path ">" number | path "<" number
#          | path "present" | path "absent" | path "contains" value
#          | path "empty" | path "nonempty" | path "unique" | path "distinct"
#          | path ("within" | "host_of" | "under" | "covers") (path | value)
#          | path "cyclic" | path "matches" format
#          | "self" "is" view                                              (v0.4)
#          | "self" "reachable" | "self" "referenced" | path "keyed_by" path (v0.8)
#   path   = seg { "." seg } ;  seg = IDENT | "self" | "this"            (v0.4)
#            the head is self, this (the ON declaration, inside a quantifier or a
#            VIEW's WHERE), a VIEW, a seat, a ONE kind or a kind; each step is a
#            seat of a declaration, or a kind inside a SENTENCE seat
#   a quantifier's "where" runs to the closing parenthesis or the end;
#   on the right of = and != a bare word is a value, a dotted name or this/self a place;
#   on the right of a relation a bare word is a seat (v0.3's rule)
#
# The AST: ["or", a, b]  ["and", a, b]  ["not", a]  ["exists", decl]
#   ["path", [segs]]                 a place;  ["val", text] a value
#   ["cmp", op, path, right]         op in = != > <; right a path or a val
#   ["has", test, path]              test in present absent empty nonempty unique distinct
#   ["contains", path, value]
#   ["rel", name, path, right]       name in within host_of under covers
#   ["cyclic", path]  ["matches", path, format]  ["is", view]
#   ["quant", some|all|earlier, path, named, cond]   named NULL, a val or a path; cond or NULL
#
# TYPES (the meta-court) and CURSORS (the court) walk a path the same way:
#   ["decl", lang, d]      one declaration     (cursor: ["decl", lang, aDecl, pool])
#   ["set", lang, d]       declarations of a kind (cursor: ["set", lang, [decls], pool])
#   ["sentence", lang]     a SENTENCE seat's file (cursor: ["sentence", lang, decls])
#   ["value", seat]        a scalar or list value (cursor: ["value", text | list | NULL])
#   ["list", seat]         (types only; a cursor carries the list as a value)
#   ["none"]               (cursors only: a VIEW or a ONE kind that resolves to nothing)
#
# Tables. $aCondLangs: one entry per language, [lang, declseats, onedecls, views,
# verbof], where declseats is [[declname, [[seat, of, isList, kind, targetlang],
# ...]], ...] (kind in prim form expr menu range format decl union sentence),
# onedecls the names in WORLD's ONE, views [[name, on, resulttype, onepath, named,
# where], ...] and verbof [[declname, VERB], ...]. $aCondFormats: [[name, shape],
# ...] of the language being validated. The court also sets $cCondLang (the
# top language), $aCondDecls (its declarations), $aCourtSentences ([ownerlang,
# VERB, name, seat, path, decls, lang] per judged SENTENCE seat), $cCondOther,
# $bCondUnread (a reference that resolves to nothing was read: the condition
# says nothing and the reference's own refusal speaks).
# Functions only.

func CondIsWordChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 65 and nN <= 90) or nN = 95 or (nN >= 48 and nN <= 57)
end
func CondIsDigit(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)
end
# tokens: [type, text]; types: word number string eq ne gt lt lparen rparen dot eof
func CondTokenize(tS)
	aT = []
	nN = Len(tS)
	nI = 1
	while nI <= nN
		tC = tS[nI]
		if tC = " " or tC = Char(9)
			nI++
		elseif tC = "'"
			nJ = nI + 1
			while nJ <= nN and tS[nJ] != "'"
				nJ++
			end
			if nJ > nN Raise("condition: unterminated quote in '" + tS + "'") end
			aT + ["string", SubStr(tS, nI + 1, nJ - nI - 1)]
			nI = nJ + 1
		elseif CondIsDigit(tC)
			nJ = nI
			while nJ <= nN and CondIsDigit(tS[nJ])
				nJ++
			end
			aT + ["number", SubStr(tS, nI, nJ - nI)]
			nI = nJ
		elseif CondIsWordChar(tC)
			nJ = nI
			while nJ <= nN and CondIsWordChar(tS[nJ])
				nJ++
			end
			aT + ["word", SubStr(tS, nI, nJ - nI)]
			nI = nJ
		elseif tC = "!" and nI < nN and tS[nI+1] = "="
			aT + ["ne", "!="]
			nI += 2
		elseif tC = "="
			aT + ["eq", "="]
			nI++
		elseif tC = ">"
			aT + ["gt", ">"]
			nI++
		elseif tC = "<"
			aT + ["lt", "<"]
			nI++
		elseif tC = "("
			aT + ["lparen", "("]
			nI++
		elseif tC = ")"
			aT + ["rparen", ")"]
			nI++
		elseif tC = "."
			aT + ["dot", "."]
			nI++
		else
			Raise("condition: the character '" + tC + "' is not part of the condition language")
		end
	end
	aT + ["eof", ""]
	return aT
end
func CondPeek
	return $aCondToks[$nCondPos]
end
func CondNext
	aT = $aCondToks[$nCondPos]
	if aT[1] != "eof" $nCondPos++ end
	return aT
end
func CondParse(tS)
	$aCondToks = CondTokenize(tS)
	$nCondPos = 1
	aAst = CondOr()
	if CondPeek()[1] != "eof"
		Raise("condition: unexpected '" + CondPeek()[2] + "' in '" + tS + "'")
	end
	return aAst
end
# a path on its own (a VIEW's ONE), from its text
func CondParsePathText(tS)
	$aCondToks = CondTokenize(tS)
	$nCondPos = 1
	aT = CondNext()
	if aT[1] != "word" Raise("path: expected a name, found '" + aT[2] + "'") end
	aP = CondParsePath(aT)
	if CondPeek()[1] != "eof" Raise("path: unexpected '" + CondPeek()[2] + "' in '" + tS + "'") end
	return aP
end
# a value or a path on its own (a VIEW's NAMED), from its text
func CondParseRightText(tS)
	$aCondToks = CondTokenize(tS)
	$nCondPos = 1
	aR = CondCmpRight()
	if CondPeek()[1] != "eof" Raise("named: unexpected '" + CondPeek()[2] + "' in '" + tS + "'") end
	return aR
end
# A node is built in a fresh variable and assigned after: `aL = ["or", aL,
# aR]` puts the variable being assigned inside the list assigned to it, and
# on Ring the copy taken of aL dangles once aL is replaced -- an R2 at the
# next read (Ring, Judged by the Record, 4.4). haro ran the one-line form
# correctly; the oracle named it (HF-36).
func CondOr
	aL = CondAnd()
	while CondPeek()[1] = "word" and CondPeek()[2] = "or"
		CondNext()
		aR = CondAnd()
		aNode = ["or", aL, aR]
		aL = aNode
	end
	return aL
end
func CondAnd
	aL = CondTerm()
	while CondPeek()[1] = "word" and CondPeek()[2] = "and"
		CondNext()
		aR = CondTerm()
		aNode = ["and", aL, aR]
		aL = aNode
	end
	return aL
end
func CondTerm
	if CondPeek()[1] = "word" and CondPeek()[2] = "not"
		CondNext()
		return ["not", CondTerm()]
	end
	return CondAtom()
end
func CondValue
	aT = CondNext()
	if aT[1] = "word" or aT[1] = "number" or aT[1] = "string" return aT[2] end
	Raise("condition: expected a value, found '" + aT[2] + "'")
end
# a path, its first word already consumed as t
func CondParsePath(xT)
	aSegs = [xT[2]]
	while CondPeek()[1] = "dot"
		CondNext()
		aS = CondNext()
		if aS[1] != "word" Raise("condition: expected a name after '.'") end
		aSegs + aS[2]
	end
	return ["path", aSegs]
end
# the right of = and !=, and a quantifier's named: a quoted or numeric value,
# a dotted name or this/self as a place, a bare word as a value
func CondCmpRight
	aT = CondNext()
	if aT[1] = "string" or aT[1] = "number" return ["val", aT[2]] end
	if aT[1] != "word" Raise("condition: expected a value or a place, found '" + aT[2] + "'") end
	if CondPeek()[1] = "dot" or aT[2] = "this" or aT[2] = "self" return CondParsePath(aT) end
	return ["val", aT[2]]
end
# the right of a relation: a quoted or numeric value, or a place (a bare word
# is a seat)
func CondRelRight
	aT = CondNext()
	if aT[1] = "string" or aT[1] = "number" return ["val", aT[2]] end
	if aT[1] != "word" Raise("condition: expected a seat or a value, found '" + aT[2] + "'") end
	return CondParsePath(aT)
end
func CondAtom
	aT = CondNext()
	if aT[1] = "lparen"
		aC = CondOr()
		if CondNext()[1] != "rparen" Raise("condition: expected ')'") end
		return aC
	end
	if aT[1] != "word"
		Raise("condition: expected a seat, found '" + aT[2] + "'")
	end
	if aT[2] = "exists"
		aD = CondNext()
		if aD[1] != "word" Raise("condition: exists names a declaration") end
		return ["exists", aD[2]]
	end
	if aT[2] = "some" or aT[2] = "all" or aT[2] = "earlier"
		aD = CondNext()
		if aD[1] != "word" Raise("condition: " + aT[2] + " names a declaration kind or a list of references") end
		aTarget = CondParsePath(aD)
		aNamed = ""
		if CondPeek()[1] = "word" and CondPeek()[2] = "named"
			CondNext()
			aNamed = CondCmpRight()
		end
		aCond = ""
		if CondPeek()[1] = "word" and CondPeek()[2] = "where"
			CondNext()
			aCond = CondOr()
		end
		return ["quant", aT[2], aTarget, aNamed, aCond]
	end
	aPath = CondParsePath(aT)
	if CondPeek()[1] = "word" and CondPeek()[2] = "is"
		CondNext()
		aV = CondNext()
		if aV[1] != "word" Raise("condition: is names a VIEW") end
		if Len(aPath[2]) != 1 or aPath[2][1] != "self"
			Raise("condition: is asks whether self is a VIEW's declaration; write self is " + aV[2])
		end
		return ["is", aV[2]]
	end
	aOp = CondNext()
	if aOp[1] = "eq" or aOp[1] = "ne"
		return ["cmp", aOp[2], aPath, CondCmpRight()]
	end
	if aOp[1] = "gt" or aOp[1] = "lt"
		aV = CondValue()
		if not CondIsNumberText(aV)
			Raise("condition: " + aOp[2] + " compares numbers, and '" + aV + "' is not one")
		end
		return ["cmp", aOp[2], aPath, ["val", aV]]
	end
	if aOp[1] = "word"
		if aOp[2] = "present" or aOp[2] = "absent" or aOp[2] = "empty" or aOp[2] = "nonempty" or aOp[2] = "unique" or aOp[2] = "distinct"
			return ["has", aOp[2], aPath]
		end
		if aOp[2] = "contains"
			return ["contains", aPath, CondValue()]
		end
		if aOp[2] = "within" or aOp[2] = "host_of" or aOp[2] = "under" or aOp[2] = "covers"
			return ["rel", aOp[2], aPath, CondRelRight()]
		end
		if aOp[2] = "cyclic"
			return ["cyclic", aPath]
		end
		# v0.8: three closed relations F needs
		if aOp[2] = "reachable"
			return ["reach", aPath]
		end
		if aOp[2] = "referenced"
			return ["refd", aPath]
		end
		if aOp[2] = "keyed_by"
			return ["keyed", aPath, CondRelRight()]
		end
		if aOp[2] = "matches"
			aF = CondNext()
			if aF[1] != "word" Raise("condition: matches names a FORMAT") end
			return ["matches", aPath, aF[2]]
		end
	end
	Raise("condition: '" + aOp[2] + "' is not an operator of the condition language")
end
func CondIsNumberText(xV)
	if Len(xV) = 0 return false end
	for i = 1 to Len(xV)
		if not CondIsDigit(xV[i]) return false end
	end
	return true
end
func CondPathText(aP)
	tOut = ""
	for i = 1 to Len(aP[2])
		if i > 1 tOut += "." end
		tOut += aP[2][i]
	end
	return tOut
end
func CondInList(tS, aL)
	for i = 1 to Len(aL)
		if aL[i] = tS return true end
	end
	return false
end
# ---- the language tables, read by both readers --------------------------------------

func CondLang(tLang)
	for i = 1 to Len($aCondLangs)
		if $aCondLangs[i][1] = tLang return $aCondLangs[i] end
	end
	return ""
end
# the seats of a declaration kind of a language, or NULL when no such kind
func CondSeatsIn(tLang, tDecl)
	aL = CondLang(tLang)
	if IsEmpty(aL) return "" end
	aD = aL[2]
	for i = 1 to Len(aD)
		if aD[i][1] = tDecl return aD[i][2] end
	end
	return ""
end
func CondSeatInfoIn(tLang, tDecl, tSeat)
	aS = CondSeatsIn(tLang, tDecl)
	if IsEmpty(aS) return "" end
	for i = 1 to Len(aS)
		if aS[i][1] = tSeat return aS[i] end
	end
	return ""
end
# v0.8: the WORLD's ENTRY kinds and the forms of a language
func CondEntryIn(tLang)
	aL = CondLang(tLang)
	if IsEmpty(aL) return [] end
	if Len(aL) < 6 return [] end
	return aL[6]
end
func CondFormIn(tLang, tName)
	aL = CondLang(tLang)
	if IsEmpty(aL) return "" end
	if Len(aL) < 7 return "" end
	for i = 1 to Len(aL[7])
		if aL[7][i][1] = tName return aL[7][i] end
	end
	return ""
end
# a form's seat infos [[seat, of, kind], ...] describe a pair when there are two
# scalar seats and the first is a name, a MENU or a DECLARATION
func CondIsPairFormInfo(aInfo)
	if Len(aInfo) != 2 return false end
	tK1 = aInfo[1][3]
	if not ((aInfo[1][2] = "name" and tK1 = "prim") or tK1 = "menu" or tK1 = "decl") return false end
	return true
end
func CondIsOneIn(tLang, tDecl)
	aL = CondLang(tLang)
	if IsEmpty(aL) return false end
	return CondInList(tDecl, aL[3])
end
func CondViewIn(tLang, tName)
	aL = CondLang(tLang)
	if IsEmpty(aL) return "" end
	aV = aL[4]
	for i = 1 to Len(aV)
		if aV[i][1] = tName return aV[i] end
	end
	return ""
end
func CondVerbIn(tLang, tDecl)
	aL = CondLang(tLang)
	if IsEmpty(aL) return "" end
	aV = aL[5]
	for i = 1 to Len(aV)
		if aV[i][1] = tDecl return aV[i][2] end
	end
	return ""
end
func CondDeclNameIn(tLang, tVerb)
	aL = CondLang(tLang)
	if IsEmpty(aL) return "" end
	aV = aL[5]
	for i = 1 to Len(aV)
		if aV[i][2] = tVerb return aV[i][1] end
	end
	return ""
end
func CondFormatShape(tName)
	for i = 1 to Len($aCondFormats)
		if $aCondFormats[i][1] = tName return $aCondFormats[i][2] end
	end
	return ""
end
# ---- validation (the meta-court) ------------------------------------------------------
# The context is [onLang, on, inLang, in]: the ON declaration (on "" for a
# VIEW of the whole sentence) and the quantified declaration (in "" outside
# a quantifier). The current declaration is `in` when set, else `on`. A
# function returns "" or the refusal text; the type walkers return a type
# (a list) or the refusal text (a string).

func CondCtxCur(aCtx)
	if aCtx[4] != "" return [aCtx[3], aCtx[4]] end
	return [aCtx[1], aCtx[2]]
end
# the type a seat gives, read from a declaration of a language
func CondSeatType(aInfo, tLang)
	if aInfo[4] = "decl"
		if aInfo[3] return ["set", tLang, aInfo[2]] end
		return ["decl", tLang, aInfo[2]]
	end
	if aInfo[4] = "sentence" return ["sentence", aInfo[5]] end
	if aInfo[3] return ["list", aInfo[1]] end
	return ["value", aInfo[1]]
end
func CondTypeHead(tSeg, aCtx)
	aCur = CondCtxCur(aCtx)
	tLang = aCur[1]
	tDecl = aCur[2]
	if tSeg = "self"
		if tDecl = "" return "self is read on a declaration, and this VIEW has no ON" end
		return ["decl", tLang, tDecl]
	end
	if tSeg = "this"
		if aCtx[4] = "" return "this." + " is read inside some or all, where a bare seat is the quantified declaration's" end
		if aCtx[2] = "" return "this has no declaration here: this VIEW has no ON" end
		return ["decl", aCtx[1], aCtx[2]]
	end
	if tDecl != ""
		aV = CondViewIn(tLang, tSeg)
		if not IsEmpty(aV)
			if aV[2] = "" or aV[2] = tDecl return aV[3] end
		end
		aInfo = CondSeatInfoIn(tLang, tDecl, tSeg)
		if not IsEmpty(aInfo) return CondSeatType(aInfo, tLang) end
	else
		aV = CondViewIn(tLang, tSeg)
		if not IsEmpty(aV)
			if aV[2] = "" return aV[3] end
		end
	end
	if not IsEmpty(CondSeatsIn(tLang, tSeg))
		if CondIsOneIn(tLang, tSeg) return ["decl", tLang, tSeg] end
		return ["set", tLang, tSeg]
	end
	# inside a quantifier over another language's declarations, a KIND or a
	# whole-sentence VIEW of the ON declaration's language is still in reach
	# (fleet.link from a peer); a seat of the ON declaration is this.SEAT
	if aCtx[4] != "" and aCtx[1] != tLang
		aV = CondViewIn(aCtx[1], tSeg)
		if not IsEmpty(aV)
			if aV[2] = "" return aV[3] end
		end
		if not IsEmpty(CondSeatsIn(aCtx[1], tSeg))
			if CondIsOneIn(aCtx[1], tSeg) return ["decl", aCtx[1], tSeg] end
			return ["set", aCtx[1], tSeg]
		end
	end
	if tDecl != "" return "no seat '" + tSeg + "' on " + tDecl end
	return "'" + tSeg + "' is neither a kind nor a VIEW of " + tLang
end
func CondTypeStep(aT, tPrev, tSeg, aCtx)
	tK = aT[1]
	if tK = "decl"
		aInfo = CondSeatInfoIn(aT[2], aT[3], tSeg)
		if not IsEmpty(aInfo) return CondSeatType(aInfo, aT[2]) end
		# a VIEW on that declaration's kind reads as one of its seats
		aV = CondViewIn(aT[2], tSeg)
		if not IsEmpty(aV)
			if aV[2] = aT[3] return aV[3] end
		end
		return "no seat '" + tSeg + "' on " + aT[3]
	end
	if tK = "sentence"
		if IsEmpty(CondSeatsIn(aT[2], tSeg))
			return "'" + tSeg + "' is neither a seat nor a kind of " + aT[2]
		end
		if CondIsOneIn(aT[2], tSeg) return ["decl", aT[2], tSeg] end
		return ["set", aT[2], tSeg]
	end
	aCur = CondCtxCur(aCtx)
	if tK = "set"
		return "'" + tPrev + "' is not a ONE kind, and neither a reference seat of " + aCur[2] + ": only the one declaration of a ONE kind can be read from a condition, and a set of declarations is quantified over"
	end
	return "'" + tPrev + "' is a value, not a declaration: neither a reference seat of " + aCur[2] + " nor a ONE kind, and a path does not continue through a value"
end
# a path's type, or the refusal text
func CondTypePath(aP, aCtx)
	aSegs = aP[2]
	aT = CondTypeHead(aSegs[1], aCtx)
	if IsString(aT) return aT end
	for i = 2 to Len(aSegs)
		aT = CondTypeStep(aT, aSegs[i-1], aSegs[i], aCtx)
		if IsString(aT) return aT end
	end
	return aT
end
# the type of the right side of a comparison or a relation
func CondTypeRight(aR, aCtx)
	if aR[1] = "val" return ["value", ""] end
	return CondTypePath(aR, aCtx)
end
func CondValidate(aAst, tOn, aOneDecls, tInner)
	# v0.2/v0.3 callers: the ON and the quantified kind are of the language
	# being validated ($cCondLang); aOneDecls is carried in the tables now
	return CondValidateIn(aAst, [$tCondLang, tOn, $tCondLang, tInner])
end
func CondValidateIn(aAst, aCtx)
	tK = aAst[1]
	aCur = CondCtxCur(aCtx)
	if tK = "and" or tK = "or"
		xE = CondValidateIn(aAst[2], aCtx)
		if xE != "" return xE end
		return CondValidateIn(aAst[3], aCtx)
	elseif tK = "not"
		return CondValidateIn(aAst[2], aCtx)
	elseif tK = "exists"
		if IsEmpty(CondSeatsIn(aCur[1], aAst[2]))
			return "'" + aAst[2] + "' resolves to nothing: exists names a declaration of this language"
		end
		return ""
	elseif tK = "cmp"
		aT = CondTypePath(aAst[3], aCtx)
		if IsString(aT) return aT end
		if aT[1] = "set" return "'" + CondPathText(aAst[3]) + "' is a set of declarations, and = compares one value" end
		if aT[1] = "sentence" return "'" + CondPathText(aAst[3]) + "' is a file, and = compares one value" end
		aR = CondTypeRight(aAst[4], aCtx)
		if IsString(aR) return aR end
		if aR[1] = "set" or aR[1] = "sentence" return "'" + CondPathText(aAst[4]) + "' is not one value" end
		return ""
	elseif tK = "has"
		aT = CondTypePath(aAst[3], aCtx)
		if IsString(aT) return aT end
		tTest = aAst[2]
		if tTest = "empty" or tTest = "nonempty" or tTest = "distinct"
			# a list of values, a list of references (a set), or a UNION seat one
			# of whose shapes is a list
			if not CondTypeIsListish(aT, aCtx) return tTest + " reads a list seat, and '" + CondPathText(aAst[3]) + "' is not one" end
		end
		if tTest = "unique"
			if aT[1] != "value" and aT[1] != "sentence" return "unique reads a scalar seat, and '" + CondPathText(aAst[3]) + "' is not one" end
			if Len(aAst[3][2]) != 1 return "unique reads a seat of this declaration, and '" + CondPathText(aAst[3]) + "' is a path" end
		end
		return ""
	elseif tK = "contains"
		aT = CondTypePath(aAst[2], aCtx)
		if IsString(aT) return aT end
		if not CondTypeIsListish(aT, aCtx) return "contains reads a list seat, and '" + CondPathText(aAst[2]) + "' is not one" end
		return ""
	elseif tK = "rel"
		aT = CondTypePath(aAst[3], aCtx)
		if IsString(aT) return aT end
		if aAst[2] = "covers"
			# a list seat, or a UNION seat (one of whose alternatives may be a
			# list; a word written there covers nothing)
			if not CondTypeIsListish(aT, aCtx) return "covers takes a list seat on its left, and '" + CondPathText(aAst[3]) + "' is not one" end
		else
			if aT[1] != "value" return aAst[2] + " reads a scalar seat, and '" + CondPathText(aAst[3]) + "' is not one" end
		end
		aR = CondTypeRight(aAst[4], aCtx)
		if IsString(aR) return aR end
		return ""
	elseif tK = "cyclic"
		aSegs = aAst[2][2]
		bOk = false
		if Len(aSegs) = 1
			aInfo = CondSeatInfoIn(aCur[1], aCur[2], aSegs[1])
			if not IsEmpty(aInfo)
				if aInfo[3] and aInfo[4] = "decl" and aInfo[2] = aCur[2] bOk = true end
			end
		end
		if not bOk return "cyclic follows a list of references to the declaration's own kind, and '" + CondPathText(aAst[2]) + "' is not one" end
		return ""
	elseif tK = "reach" or tK = "refd"
		tWord = "reachable"
		if tK = "refd" tWord = "referenced" end
		aSegs = aAst[2][2]
		if Len(aSegs) != 1 or aSegs[1] != "self"
			return tWord + " asks whether self is " + tWord + "; write self " + tWord
		end
		if tK = "reach" and Len(CondEntryIn(aCur[1])) = 0
			return "reachable walks from the WORLD's ENTRY kinds, and none are declared"
		end
		return ""
	elseif tK = "keyed"
		aSegs = aAst[2][2]
		bPairs = false
		if Len(aSegs) = 1
			aInfo = CondSeatInfoIn(aCur[1], aCur[2], aSegs[1])
			if not IsEmpty(aInfo)
				if aInfo[3] and aInfo[4] = "form"
					aF = CondFormIn(aCur[1], aInfo[2])
					if not IsEmpty(aF) and CondIsPairFormInfo(aF[2]) bPairs = true end
				end
			end
		end
		if not bPairs return "keyed_by reads a list of pairs on its left, and '" + CondPathText(aAst[2]) + "' is not one" end
		aR = aAst[3]
		bList = false
		if aR[1] = "path" and Len(aR[2]) = 1
			aInfo = CondSeatInfoIn(aCur[1], aCur[2], aR[2][1])
			if not IsEmpty(aInfo)
				if aInfo[3] bList = true end
			end
		end
		if not bList return "keyed_by reads a list of names on its right, and '" + CondPathText(aR) + "' is not one" end
		return ""
	elseif tK = "matches"
		aT = CondTypePath(aAst[2], aCtx)
		if IsString(aT) return aT end
		if aT[1] != "value" and aT[1] != "decl" return "matches reads a value, and '" + CondPathText(aAst[2]) + "' is not one" end
		if CondFormatShape(aAst[3]) = "" return "'" + aAst[3] + "' must name a FORMAT of this language: matches tests a shape" end
		return ""
	elseif tK = "is"
		if IsEmpty(CondViewIn(aCur[1], aAst[2])) return "'" + aAst[2] + "' must name a VIEW: is asks whether self is the VIEW's declaration" end
		return ""
	elseif tK = "quant"
		tQ = aAst[2]
		aSegs = aAst[3][2]
		if tQ = "earlier"
			if Len(aSegs) != 1 or IsEmpty(CondSeatsIn(aCur[1], aSegs[1]))
				return "earlier quantifies over a kind of this language, the declarations before this one, and '" + CondPathText(aAst[3]) + "' is not one"
			end
			aT = ["set", aCur[1], aSegs[1]]
		else
			# a quantifier wants a set, so one name that is both a seat and a kind
			# (a RETIREMENT's member, the kind member) is the kind here
			if Len(aSegs) = 1 and not IsEmpty(CondSeatsIn(aCur[1], aSegs[1]))
				aT = ["set", aCur[1], aSegs[1]]
			else
				aT = CondTypePath(aAst[3], aCtx)
				if IsString(aT)
					if Len(aSegs) = 1 return "'" + aSegs[1] + "' names neither a declaration kind nor a list of references: some and all quantify over a declaration kind or a list of references" end
					return aT
				end
				if aT[1] != "set" return "'" + CondPathText(aAst[3]) + "' is not a set of declarations: some and all quantify over a declaration kind, a list of references, or a kind inside a SENTENCE" end
			end
		end
		if not IsEmpty(aAst[4])
			if Len(aSegs) = 1
				aInfo = CondSeatInfoIn(aCur[1], aCur[2], aSegs[1])
				if not IsEmpty(aInfo)
					if aInfo[4] = "decl" and aInfo[3] return "named goes with a kind, and '" + aSegs[1] + "' is a list of references, already named" end
				end
			end
			aR = CondTypeRight(aAst[4], aCtx)
			if IsString(aR) return aR end
		end
		if not IsEmpty(aAst[5])
			return CondValidateIn(aAst[5], [aCtx[1], aCtx[2], aT[2], aT[3]])
		end
		return ""
	end
	return "'" + tK + "' is not a condition"
end
# a VIEW: [name, on, onepath (text), named (text or ""), where (text or "")];
# returns "" or the refusal, and the view's result type through aOut[1]
func CondValidateView(aView, tLang, aOut)
	tOn = aView[2]
	aCtx = [tLang, tOn, tLang, ""]
	aP = CondParsePathText(aView[3])
	aT = CondTypePath(aP, aCtx)
	if IsString(aT) return aT end
	if aT[1] != "set" return "ONE names a set of declarations, and '" + aView[3] + "' is " + CondTypeWord(aT) end
	if aView[4] != ""
		aR = CondParseRightText(aView[4])
		aRT = CondTypeRight(aR, aCtx)
		if IsString(aRT) return aRT end
	end
	if aView[5] != ""
		aC = CondParse(aView[5])
		xE = CondValidateIn(aC, [tLang, tOn, aT[2], aT[3]])
		if xE != "" return xE end
	end
	aOut[1] = ["decl", aT[2], aT[3]]
	return ""
end
func CondTypeWord(aT)
	if aT[1] = "decl" return "one declaration" end
	if aT[1] = "sentence" return "a file" end
	return "a value"
end
# a list of values, a set of declarations, or a UNION seat (one of whose shapes
# may be a list; a word written there is an empty list to these tests)
func CondTypeIsListish(aT, aCtx)
	if aT[1] = "list" or aT[1] = "set" return true end
	if aT[1] = "value"
		aCur = CondCtxCur(aCtx)
		aInfo = CondSeatInfoIn(aCur[1], aCur[2], aT[2])
		if not IsEmpty(aInfo)
			if aInfo[4] = "union" return true end
		end
	end
	return false
end
# ---- evaluation (the forged court) ----------------------------------------------------
# A declaration is the court's [VERB, name, line, clauses, rationale] with a
# clause [NAME, line, [shape, payload, start, end]]; the seat's clause name
# is upper(seat). A cursor carries the language and the pool (the declarations
# of the sentence the declaration stands in), so a kind, `earlier` and
# `unique` are read against the right pool.

func CondClauseOf(aDecl, tSeat)
	aC = aDecl[4]
	tN = Upper(tSeat)
	for i = 1 to Len(aC)
		if aC[i][1] = tN return aC[i] end
	end
	return ""
end
# the text of a scalar value, or NULL when the seat is absent or a list
func CondScalar(aDecl, tSeat)
	aC = CondClauseOf(aDecl, tSeat)
	if IsEmpty(aC) return "" end
	tShape = aC[3][1]
	if tShape = "word" or tShape = "string" or tShape = "number" return aC[3][2] end
	return ""
end
func CondListOf(aDecl, tSeat)
	aC = CondClauseOf(aDecl, tSeat)
	if IsEmpty(aC) return "" end
	tShape = aC[3][1]
	if tShape = "namelist" or tShape = "stringlist" return aC[3][2] end
	if tShape = "pairlist"
		# v0.6: a list of name: value pairs reads as its names
		aNames = []
		for i = 1 to Len(aC[3][2])
			aNames + aC[3][2][i][1]
		end
		return aNames
	end
	return ""
end
func CondSameText(xA, xB)
	return xA = xB
end
func CondSameDecl(xA, xB)
	return xA[1] = xB[1] and xA[2] = xB[2] and xA[3] = xB[3]
end
func CondCur(aOuter, aInner)
	if IsEmpty(aInner) return aOuter end
	return aInner
end
func CondPoolOf(aC)
	if IsEmpty(aC) return $aCondDecls end
	return aC[4]
end
func CondLangOf(aC)
	if IsEmpty(aC) return $tCondLang end
	return aC[2]
end
# the declarations of a kind in a pool
func CondOfKind(tLang, tDecl, aPool)
	tVerb = CondVerbIn(tLang, tDecl)
	aOut = []
	for i = 1 to Len(aPool)
		if aPool[i][1] = tVerb aOut + aPool[i] end
	end
	return aOut
end
func CondFindIn(tLang, tDecl, tName, aPool)
	tVerb = CondVerbIn(tLang, tDecl)
	for i = 1 to Len(aPool)
		if aPool[i][1] = tVerb and aPool[i][2] = tName return aPool[i] end
	end
	return ""
end
# the judged file of a SENTENCE seat: [ownerlang, VERB, name, seat, path, decls, lang]
func CondSentenceOf(tLang, aDecl, tSeat)
	for i = 1 to Len($aCourtSentences)
		aS = $aCourtSentences[i]
		if aS[1] = tLang and aS[2] = aDecl[1] and aS[3] = aDecl[2] and aS[4] = tSeat return aS end
	end
	return ""
end
# a seat of a declaration cursor, as a cursor; NULL raises $bCondUnread
func CondSeatCursor(aC, tSeat)
	tLang = aC[2]
	aDecl = aC[3]
	tDeclName = CondDeclNameIn(tLang, aDecl[1])
	aInfo = CondSeatInfoIn(tLang, tDeclName, tSeat)
	if IsEmpty(aInfo) return ["none"] end
	if aInfo[4] = "decl"
		if aInfo[3]
			aL = CondListOf(aDecl, tSeat)
			if IsEmpty(aL) aL = [] end
			aOut = []
			for i = 1 to Len(aL)
				aT = CondFindIn(tLang, aInfo[2], aL[i], aC[4])
				if not IsEmpty(aT) aOut + aT end
			end
			return ["set", tLang, aOut, aC[4]]
		end
		xV = CondScalar(aDecl, tSeat)
		if IsEmpty(xV)
			$bCondUnread = true
			return ""
		end
		aT = CondFindIn(tLang, aInfo[2], xV, aC[4])
		if IsEmpty(aT)
			$bCondUnread = true
			return ""
		end
		return ["decl", tLang, aT, aC[4]]
	end
	if aInfo[4] = "sentence"
		aS = CondSentenceOf(tLang, aDecl, tSeat)
		if IsEmpty(aS) return ["none"] end
		return ["sentence", aS[7], aS[6]]
	end
	if aInfo[3]
		return ["value", CondListOf(aDecl, tSeat)]
	end
	return ["value", CondScalar(aDecl, tSeat)]
end
func CondHeadCursor(tSeg, aOuter, aInner)
	aCur = CondCur(aOuter, aInner)
	if tSeg = "self"
		if IsEmpty(aCur)
			$bCondUnread = true
			return ""
		end
		return aCur
	end
	if tSeg = "this"
		if IsEmpty(aOuter)
			$bCondUnread = true
			return ""
		end
		return aOuter
	end
	tLang = CondLangOf(aCur)
	aV = CondViewIn(tLang, tSeg)
	if not IsEmpty(aV)
		return CondViewCursor(aV, aCur)
	end
	if not IsEmpty(aCur)
		tDeclName = CondDeclNameIn(tLang, aCur[3][1])
		if not IsEmpty(CondSeatInfoIn(tLang, tDeclName, tSeg))
			return CondSeatCursor(aCur, tSeg)
		end
	end
	aPool = CondPoolOf(aCur)
	if not IsEmpty(CondSeatsIn(tLang, tSeg))
		aK = CondOfKind(tLang, tSeg, aPool)
		if CondIsOneIn(tLang, tSeg)
			if Len(aK) = 0 return ["none"] end
			return ["decl", tLang, aK[1], aPool]
		end
		return ["set", tLang, aK, aPool]
	end
	# inside a quantifier over another language's declarations, a KIND or a
	# whole-sentence VIEW of the ON declaration's language is still in reach
	if not IsEmpty(aInner) and not IsEmpty(aOuter)
		if aOuter[2] != tLang
			tOL = aOuter[2]
			aV = CondViewIn(tOL, tSeg)
			if not IsEmpty(aV)
				if aV[2] = "" return CondViewCursor(aV, aOuter) end
			end
			if not IsEmpty(CondSeatsIn(tOL, tSeg))
				aPoolO = aOuter[4]
				aK = CondOfKind(tOL, tSeg, aPoolO)
				if CondIsOneIn(tOL, tSeg)
					if Len(aK) = 0 return ["none"] end
					return ["decl", tOL, aK[1], aPoolO]
				end
				return ["set", tOL, aK, aPoolO]
			end
		end
	end
	return ["none"]
end
func CondStepCursor(aC, tSeg)
	if IsEmpty(aC) return "" end
	tK = aC[1]
	if tK = "decl"
		tDeclName = CondDeclNameIn(aC[2], aC[3][1])
		if not IsEmpty(CondSeatInfoIn(aC[2], tDeclName, tSeg)) return CondSeatCursor(aC, tSeg) end
		aV = CondViewIn(aC[2], tSeg)
		if not IsEmpty(aV)
			if aV[2] = tDeclName return CondViewCursor(aV, aC) end
		end
		return ["none"]
	end
	if tK = "sentence"
		tLang = aC[2]
		aK = CondOfKind(tLang, tSeg, aC[3])
		if CondIsOneIn(tLang, tSeg)
			if Len(aK) = 0 return ["none"] end
			return ["decl", tLang, aK[1], aC[3]]
		end
		return ["set", tLang, aK, aC[3]]
	end
	return ["none"]
end
# a path's cursor: NULL (unread), ["none"], or a cursor
func CondWalk(aP, aOuter, aInner)
	aSegs = aP[2]
	aC = CondHeadCursor(aSegs[1], aOuter, aInner)
	for i = 2 to Len(aSegs)
		if IsEmpty(aC) return "" end
		if aC[1] = "none" return aC end
		aC = CondStepCursor(aC, aSegs[i])
	end
	return aC
end
# a path's text value: a declaration's name, a scalar's text; NULL otherwise
func CondPathScalar(aP, aOuter, aInner)
	aC = CondWalk(aP, aOuter, aInner)
	if IsEmpty(aC) return "" end
	if aC[1] = "decl" return aC[3][2] end
	if aC[1] = "value"
		if IsEmpty(aC[2]) return "" end
		if IsList(aC[2]) return "" end
		return aC[2]
	end
	return ""
end
# a path's list: a list seat's items as written (so a list of references reads
# its names, resolved or not), or the names of a set reached along a path
func CondPathList(aP, aOuter, aInner)
	aSegs = aP[2]
	aCur = CondCur(aOuter, aInner)
	if Len(aSegs) = 1 and not IsEmpty(aCur)
		if aSegs[1] != "self" and aSegs[1] != "this"
			tDeclName = CondDeclNameIn(aCur[2], aCur[3][1])
			if not IsEmpty(CondSeatInfoIn(aCur[2], tDeclName, aSegs[1]))
				return CondListOf(aCur[3], aSegs[1])
			end
		end
	end
	aC = CondWalk(aP, aOuter, aInner)
	if IsEmpty(aC) return "" end
	if aC[1] = "value"
		if IsEmpty(aC[2]) return "" end
		if IsList(aC[2]) return aC[2] end
		return ""
	end
	if aC[1] = "set"
		aOut = []
		for i = 1 to Len(aC[3])
			aOut + aC[3][i][2]
		end
		return aOut
	end
	return ""
end
func CondRightText(aR, aOuter, aInner)
	if aR[1] = "val"
		if aR[2] = "self"
			aCur = CondCur(aOuter, aInner)
			if IsEmpty(aCur) return "" end
			return aCur[3][2]
		end
		return aR[2]
	end
	return CondPathScalar(aR, aOuter, aInner)
end
# a VIEW's declaration for a cursor: ["decl", ...] or ["none"]
func CondViewCursor(aV, aCur)
	tOn = aV[2]
	aOuter = aCur
	if tOn = ""
		aOuter = ""
	else
		if IsEmpty(aCur) return ["none"] end
		if CondDeclNameIn(aCur[2], aCur[3][1]) != tOn return ["none"] end
	end
	aP = CondParsePathText(aV[4])
	aSet = CondWalk(aP, aOuter, "")
	if IsEmpty(aSet) return ["none"] end
	if aSet[1] != "set" return ["none"] end
	tNamed = ""
	if aV[5] != ""
		tNamed = CondRightText(CondParseRightText(aV[5]), aOuter, "")
		if IsEmpty(tNamed) return ["none"] end
	end
	aWhere = ""
	if aV[6] != "" aWhere = CondParse(aV[6]) end
	for i = 1 to Len(aSet[3])
		aD = aSet[3][i]
		if not IsEmpty(tNamed)
			if aD[2] != tNamed loop end
		end
		aIn = ["decl", aSet[2], aD, aSet[4]]
		if not IsEmpty(aWhere)
			if not CondEvalIn(aWhere, aOuter, aIn) loop end
		end
		return aIn
	end
	return ["none"]
end
func CondEval(aAst, aDecl)
	return CondEvalIn(aAst, ["decl", $tCondLang, aDecl, $aCondDecls], "")
end
func CondEvalIn(aAst, aOuter, aInner)
	aCur = CondCur(aOuter, aInner)
	tK = aAst[1]
	if tK = "and"
		if not CondEvalIn(aAst[2], aOuter, aInner) return false end
		return CondEvalIn(aAst[3], aOuter, aInner)
	elseif tK = "or"
		if CondEvalIn(aAst[2], aOuter, aInner) return true end
		return CondEvalIn(aAst[3], aOuter, aInner)
	elseif tK = "not"
		return not CondEvalIn(aAst[2], aOuter, aInner)
	elseif tK = "exists"
		return Len(CondOfKind(CondLangOf(aCur), aAst[2], CondPoolOf(aCur))) > 0
	elseif tK = "cmp"
		xOp = aAst[2]
		xV = CondPathScalar(aAst[3], aOuter, aInner)
		if IsEmpty(xV) return false end
		tW = CondRightText(aAst[4], aOuter, aInner)
		if IsEmpty(tW) return false end
		if xOp = "="  return CondSameText(xV, tW) end
		if xOp = "!=" return not CondSameText(xV, tW) end
		if not CondIsNumberText(xV) return false end
		if xOp = ">" return Number(xV) > Number(tW) end
		return Number(xV) < Number(tW)
	elseif tK = "contains"
		aL = CondPathList(aAst[2], aOuter, aInner)
		if IsEmpty(aL) return false end
		tW = aAst[3]
		if tW = "self"
			if IsEmpty(aCur) return false end
			tW = aCur[3][2]
		end
		for i = 1 to Len(aL)
			if aL[i] = tW return true end
		end
		return false
	elseif tK = "rel"
		tRel = aAst[2]
		if tRel = "covers"
			aL = CondPathList(aAst[3], aOuter, aInner)
			if IsEmpty(aL) return false end
			tR = CondRightText(aAst[4], aOuter, aInner)
			if IsEmpty(tR) return false end
			return CondCovers(aL, tR)
		end
		xV = CondPathScalar(aAst[3], aOuter, aInner)
		if IsEmpty(xV) return false end
		tR = CondRightText(aAst[4], aOuter, aInner)
		if IsEmpty(tR) return false end
		if tRel = "within" return CondWithin(xV, tR) end
		if tRel = "host_of" return CondHostOf(xV, tR) end
		return CondUnder(xV, tR)
	elseif tK = "reach"
		aCur = CondCur(aOuter, aInner)
		if IsEmpty(aCur) return false end
		return CondReachable(aCur)
	elseif tK = "refd"
		aCur = CondCur(aOuter, aInner)
		if IsEmpty(aCur) return false end
		return CondReferenced(aCur)
	elseif tK = "keyed"
		aCur = CondCur(aOuter, aInner)
		if IsEmpty(aCur) return false end
		return CondKeyedBy(aCur, aAst[2][2][1], aAst[3][2][1])
	elseif tK = "cyclic"
		if IsEmpty(aCur) return false end
		return CondCyclic(aCur, aAst[2][2][1])
	elseif tK = "matches"
		xV = CondPathScalar(aAst[2], aOuter, aInner)
		if IsEmpty(xV) return false end
		return CondHasShape(xV, CondFormatShape(aAst[3]))
	elseif tK = "is"
		if IsEmpty(aCur) return false end
		aV = CondViewIn(CondLangOf(aCur), aAst[2])
		if IsEmpty(aV) return false end
		aD = CondViewCursor(aV, aCur)
		if aD[1] != "decl" return false end
		return CondSameDecl(aD[3], aCur[3])
	elseif tK = "quant"
		return CondQuant(aAst, aOuter, aInner)
	else
		# has
		tTest = aAst[2]
		if tTest = "unique"
			# against the declarations BEFORE this one, so the later of two
			# is the one refused and {other} names the earlier ("already a's");
			# the clause's own text, so a SENTENCE seat's path counts too
			if IsEmpty(aCur) return true end
			tSeat = aAst[3][2][1]
			aD = aCur[3]
			xV = CondScalar(aD, tSeat)
			if IsEmpty(xV) return true end
			aPool = aCur[4]
			for i = 1 to Len(aPool)
				aO = aPool[i]
				if CondSameDecl(aO, aD) exit end
				if aO[1] = aD[1]
					tW = CondScalar(aO, tSeat)
					if not IsEmpty(tW) and tW = xV
						$tCondOther = aO[2]
						return false
					end
				end
			end
			return true
		end
		if tTest = "empty" or tTest = "nonempty" or tTest = "distinct"
			# the list as written: a list of references reads its names, resolved or not
			aL = CondPathList(aAst[3], aOuter, aInner)
			if tTest = "empty"
				if IsEmpty(aL) return false end
				return Len(aL) = 0
			end
			if tTest = "nonempty"
				if IsEmpty(aL) return false end
				return Len(aL) > 0
			end
			if IsEmpty(aL) return true end
			for i = 1 to Len(aL)
				for j = 1 to i - 1
					if aL[i] = aL[j]
						$tCondOther = aL[i]
						return false
					end
				end
			end
			return true
		end
		# present and absent on a seat of this declaration ask whether the
		# clause is WRITTEN (a list of references is present when written, even
		# empty or unresolved); on a view or a kind, whether it resolves
		aSegs = aAst[3][2]
		if Len(aSegs) = 1 and not IsEmpty(aCur)
			if aSegs[1] != "self" and aSegs[1] != "this"
				tDeclName = CondDeclNameIn(aCur[2], aCur[3][1])
				if not IsEmpty(CondSeatInfoIn(aCur[2], tDeclName, aSegs[1]))
					bWritten = not IsEmpty(CondClauseOf(aCur[3], aSegs[1]))
					if tTest = "present" return bWritten end
					return not bWritten
				end
			end
		end
		aC = CondWalk(aAst[3], aOuter, aInner)
		if IsEmpty(aC) return false end
		if aC[1] = "none"
			return tTest = "absent"
		end
		if aC[1] = "decl" or aC[1] = "sentence"
			if tTest = "present" return true end
			return false
		end
		if aC[1] = "set"
			if tTest = "present" return Len(aC[3]) > 0 end
			if tTest = "absent" return Len(aC[3]) = 0 end
			return false
		end
		xV = aC[2]
		if tTest = "present" return not IsEmpty(xV) end
		if tTest = "absent" return IsEmpty(xV) end
		return false
	end
end
# some, all and earlier over the declarations a path names (a kind, a list
# of references, a kind inside a SENTENCE), narrowed by named; some and
# earlier record the one found, all the first failure, in {other}
# ---- v0.8: reachable, referenced, keyed_by -----------------------------------------

# the names a declaration refers to through its reference seats: a scalar
# DECLARATION or UNION seat, a list of references, a pair list's keys when
# they are declarations and its values when they are declarations or unions
func CondRefNames(tLang, aDecl)
	aOut = []
	tDeclName = CondDeclNameIn(tLang, aDecl[1])
	aSeats = CondSeatsIn(tLang, tDeclName)
	if IsEmpty(aSeats) return aOut end
	for i = 1 to Len(aSeats)
		aInfo = aSeats[i]
		aC = CondClauseOf(aDecl, aInfo[1])
		if IsEmpty(aC) loop end
		tShape = aC[3][1]
		if aInfo[4] = "decl" or aInfo[4] = "union"
			if tShape = "word" aOut + aC[3][2] end
			if tShape = "namelist"
				for j = 1 to Len(aC[3][2]) aOut + aC[3][2][j] end
			end
		elseif aInfo[4] = "form" and tShape = "pairlist"
			aF = CondFormIn(tLang, aInfo[2])
			if IsEmpty(aF) loop end
			bKey = aF[2][1][3] = "decl"
			bVal = aF[2][2][3] = "decl" or aF[2][2][3] = "union"
			for j = 1 to Len(aC[3][2])
				if bKey aOut + aC[3][2][j][1] end
				if bVal aOut + aC[3][2][j][2] end
			end
		end
	end
	return aOut
end
# self is reachable from the entry -- the first declaration of one of the
# WORLD's ENTRY kinds -- through the reference seats of the ENTRY kinds'
# declarations (a step's arrows), never through an ending's
func CondReachable(aCur)
	tLang = aCur[2]
	aPool = aCur[4]
	aEntry = CondEntryIn(tLang)
	aVerbs = []
	for i = 1 to Len(aEntry)
		aVerbs + CondVerbIn(tLang, aEntry[i])
	end
	tStart = ""
	for i = 1 to Len(aPool)
		if CondInList(aPool[i][1], aVerbs)
			tStart = aPool[i][2]
			exit
		end
	end
	if tStart = "" return false end
	aSeen = [tStart]
	nN = 1
	while nN <= Len(aSeen)
		tCur = aSeen[nN]
		nN++
		for i = 1 to Len(aPool)
			if aPool[i][2] != tCur loop end
			if not CondInList(aPool[i][1], aVerbs) loop end
			aNames = CondRefNames(tLang, aPool[i])
			for j = 1 to Len(aNames)
				if not CondInList(aNames[j], aSeen) aSeen + aNames[j] end
			end
		end
	end
	return CondInList(aCur[3][2], aSeen)
end
# self is named by a reference seat of some declaration of the sentence
func CondReferenced(aCur)
	tLang = aCur[2]
	aPool = aCur[4]
	tMe = aCur[3][2]
	for i = 1 to Len(aPool)
		aNames = CondRefNames(tLang, aPool[i])
		if CondInList(tMe, aNames) return true end
	end
	return false
end
# the keys of a pair list are exactly the names of a list, as sets; the first
# key with no name, or name with no key, is {other}
func CondKeyedBy(aCur, tPairs, tNames)
	aKeys = CondListOf(aCur[3], tPairs)
	aNames = CondListOf(aCur[3], tNames)
	if IsEmpty(aKeys) aKeys = [] end
	if IsEmpty(aNames) aNames = [] end
	for i = 1 to Len(aKeys)
		if not CondInList(aKeys[i], aNames)
			$tCondOther = aKeys[i]
			return false
		end
	end
	for i = 1 to Len(aNames)
		if not CondInList(aNames[i], aKeys)
			$tCondOther = aNames[i]
			return false
		end
	end
	return true
end
func CondQuant(aAst, aOuter, aInner)
	aCur = CondCur(aOuter, aInner)
	tQ = aAst[2]
	aItems = []
	if tQ = "earlier"
		if IsEmpty(aCur) return false end
		aPool = aCur[4]
		tVerb = CondVerbIn(aCur[2], aAst[3][2][1])
		for i = 1 to Len(aPool)
			if CondSameDecl(aPool[i], aCur[3]) exit end
			if aPool[i][1] = tVerb aItems + ["decl", aCur[2], aPool[i], aPool] end
		end
	else
		aSegs = aAst[3][2]
		aSet = ""
		if Len(aSegs) = 1 and not IsEmpty(aCur)
			# a name that is both a seat and a kind is the kind to a quantifier
			if not IsEmpty(CondSeatsIn(aCur[2], aSegs[1]))
				aSet = ["set", aCur[2], CondOfKind(aCur[2], aSegs[1], aCur[4]), aCur[4]]
			end
		end
		if IsEmpty(aSet) aSet = CondWalk(aAst[3], aOuter, aInner) end
		if IsEmpty(aSet) return false end
		if aSet[1] != "set" return false end
		for i = 1 to Len(aSet[3])
			aItems + ["decl", aSet[2], aSet[3][i], aSet[4]]
		end
	end
	tNamed = ""
	if not IsEmpty(aAst[4])
		tNamed = CondRightText(aAst[4], aOuter, aInner)
		if IsEmpty(tNamed) return false end
	end
	aCond = aAst[5]
	if tQ = "all"
		for i = 1 to Len(aItems)
			if not IsEmpty(tNamed)
				if aItems[i][3][2] != tNamed loop end
			end
			if not IsEmpty(aCond)
				if not CondEvalIn(aCond, aOuter, aItems[i])
					$tCondOther = aItems[i][3][2]
					return false
				end
			end
		end
		return true
	end
	for i = 1 to Len(aItems)
		if not IsEmpty(tNamed)
			if aItems[i][3][2] != tNamed loop end
		end
		if IsEmpty(aCond)
			$tCondOther = aItems[i][3][2]
			return true
		end
		if CondEvalIn(aCond, aOuter, aItems[i])
			$tCondOther = aItems[i][3][2]
			return true
		end
	end
	return false
end
# ---- the relations, each total ---------------------------------------------------

func CondSplit(tS, tSep)
	aOut = []
	tCur = ""
	for i = 1 to Len(tS)
		if tS[i] = tSep
			aOut + tCur
			tCur = ""
		else
			tCur += tS[i]
		end
	end
	aOut + tCur
	return aOut
end
func CondIsHexChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57) or (nN >= 97 and nN <= 102) or (nN >= 65 and nN <= 70)
end
func CondIsLowerHexChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57) or (nN >= 97 and nN <= 102)
end
func CondIsLabelChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 48 and nN <= 57) or nN = 45
end
func CondIsIpv4(tS)
	aParts = CondSplit(tS, ".")
	if Len(aParts) != 4 return false end
	for i = 1 to 4
		xP = aParts[i]
		if Len(xP) = 0 or Len(xP) > 3 return false end
		for j = 1 to Len(xP)
			if not CondIsDigit(xP[j]) return false end
		end
		if Number(xP) > 255 return false end
	end
	return true
end
func CondIsLabel(tS)
	if Len(tS) = 0 return false end
	for i = 1 to Len(tS)
		if not CondIsLabelChar(tS[i]) return false end
	end
	if tS[1] = "-" return false end
	if tS[Len(tS)] = "-" return false end
	return true
end
# a duration is a number and a unit: seconds, minutes, hours, days, working
# day, working days (RingFlex grammar-v0.md 5.4); a landmark is the one form
# v0 knows, "the Nth working day of next month"; a deadline is either (v0.8)
func CondWordsOf(tS)
	aW = []
	tCur = ""
	for i = 1 to Len(tS)
		if tS[i] = " " or tS[i] = Char(9)
			if tCur != "" aW + tCur end
			tCur = ""
		else
			tCur += tS[i]
		end
	end
	if tCur != "" aW + tCur end
	return aW
end
func CondIsAllDigits(tS)
	if Len(tS) = 0 return false end
	for i = 1 to Len(tS)
		if not CondIsDigit(tS[i]) return false end
	end
	return true
end
func CondIsDuration(tS)
	aW = CondWordsOf(tS)
	if Len(aW) < 2 return false end
	if not CondIsAllDigits(aW[1]) return false end
	if Len(aW) = 2
		return CondInList(aW[2], ["seconds", "minutes", "hours", "days"])
	end
	if Len(aW) = 3
		return aW[2] = "working" and (aW[3] = "day" or aW[3] = "days")
	end
	return false
end
func CondIsLandmark(tS)
	aW = CondWordsOf(tS)
	if Len(aW) != 7 return false end
	if aW[1] != "the" or aW[3] != "working" or aW[4] != "day" or aW[5] != "of" or aW[6] != "next" or aW[7] != "month" return false end
	tOrd = aW[2]
	if Len(tOrd) < 3 return false end
	tSuffix = Right(tOrd, 2)
	if not CondInList(tSuffix, ["st", "nd", "rd", "th"]) return false end
	return CondIsAllDigits(Left(tOrd, Len(tOrd) - 2))
end
# the shapes of a FORMAT: absolute_path, ipv4, cidr, mac, label, domain,
# hex64, hex64_lower (v0.4); duration, landmark, deadline (v0.8)
func CondHasShape(tS, tShape)
	if tShape = "duration" return CondIsDuration(tS) end
	if tShape = "landmark" return CondIsLandmark(tS) end
	if tShape = "deadline" return CondIsDuration(tS) or CondIsLandmark(tS) end
	if tShape = "absolute_path"
		if Len(tS) = 0 return false end
		return tS[1] = "/"
	elseif tShape = "ipv4"
		return CondIsIpv4(tS)
	elseif tShape = "cidr"
		aP = CondSplit(tS, "/")
		if Len(aP) != 2 return false end
		if not CondIsIpv4(aP[1]) return false end
		if Len(aP[2]) = 0 or Len(aP[2]) > 2 return false end
		for j = 1 to Len(aP[2])
			if not CondIsDigit(aP[2][j]) return false end
		end
		return Number(aP[2]) <= 32
	elseif tShape = "mac"
		aP = CondSplit(tS, ":")
		if Len(aP) != 6 return false end
		for i = 1 to 6
			if Len(aP[i]) != 2 return false end
			if not (CondIsHexChar(aP[i][1]) and CondIsHexChar(aP[i][2])) return false end
		end
		return true
	elseif tShape = "label"
		return CondIsLabel(tS)
	elseif tShape = "domain"
		aP = CondSplit(tS, ".")
		for i = 1 to Len(aP)
			if not CondIsLabel(aP[i]) return false end
		end
		return true
	elseif tShape = "hex64"
		if Len(tS) != 64 return false end
		for i = 1 to 64
			if not CondIsHexChar(tS[i]) return false end
		end
		return true
	elseif tShape = "hex64_lower"
		if Len(tS) != 64 return false end
		for i = 1 to 64
			if not CondIsLowerHexChar(tS[i]) return false end
		end
		return true
	end
	return true
end
# an address as a number (0..4294967295), or -1
func CondIpNum(tS)
	if not CondIsIpv4(tS) return -1 end
	aP = CondSplit(tS, ".")
	return ((Number(aP[1])) * 16777216) + ((Number(aP[2])) * 65536) + ((Number(aP[3])) * 256) + (Number(aP[4]))
end
func CondBlock(nBits)
	nN = 1
	for i = 1 to nBits
		nN *= 2
	end
	return nN
end
# a prefix as [first, last], or NULL
func CondCidrRange(tS)
	if not CondHasShape(tS, "cidr") return "" end
	aP = CondSplit(tS, "/")
	nIp = CondIpNum(aP[1])
	nBlock = CondBlock(32 - (Number(aP[2])))
	nLo = nIp - (nIp % nBlock)
	return [nLo, nLo + nBlock - 1]
end
func CondWithin(tIp, tCidr)
	xN = CondIpNum(tIp)
	if xN < 0 return false end
	aR = CondCidrRange(tCidr)
	if IsEmpty(aR) return false end
	return xN >= aR[1] and xN <= aR[2]
end
func CondHostOf(tIp, tCidr)
	xN = CondIpNum(tIp)
	if xN < 0 return false end
	if not CondHasShape(tCidr, "cidr") return false end
	aP = CondSplit(tCidr, "/")
	return xN = CondIpNum(aP[1])
end
# a path under a directory: the directory itself, or a path that continues
# past it at a slash; "/" keeps every absolute path (harb's rule)
func CondUnder(tPath, tDir)
	if Len(tDir) = 0 return false end
	if tDir = "/"
		if Len(tPath) = 0 return false end
		return tPath[1] = "/"
	end
	if tPath = tDir return true end
	if Len(tPath) <= Len(tDir) return false end
	if Left(tPath, Len(tDir)) != tDir return false end
	return tPath[Len(tDir) + 1] = "/"
end
# a list of prefixes covers a prefix when their ranges, taken together, hold
# every address of it: sweep the ranges in order of their first address
func CondCovers(aList, tCidr)
	aT = CondCidrRange(tCidr)
	if IsEmpty(aT) return false end
	aR = []
	for i = 1 to Len(aList)
		xR = CondCidrRange(aList[i])
		if not IsEmpty(xR)
			nAt = Len(aR) + 1
			for j = 1 to Len(aR)
				if aR[j][1] > xR[1]
					nAt = j
					exit
				end
			end
			Insert(aR, nAt - 1, xR)
		end
	end
	nCur = aT[1]
	for i = 1 to Len(aR)
		if aR[i][1] <= nCur and aR[i][2] >= nCur
			nCur = aR[i][2] + 1
			if nCur > aT[2] return true end
		end
	end
	return nCur > aT[2]
end
# the references of a list seat, followed through declarations of the same
# kind in the cursor's pool, return to the declaration they started from
func CondCyclic(aC, tSeat)
	tLang = aC[2]
	aDecl = aC[3]
	tDeclName = CondDeclNameIn(tLang, aDecl[1])
	aInfo = CondSeatInfoIn(tLang, tDeclName, tSeat)
	if IsEmpty(aInfo) return false end
	aSeen = []
	return CondReaches(aDecl, tSeat, aDecl[2], tLang, aInfo[2], aC[4], aSeen)
end
func CondReaches(aFrom, tSeat, tStart, tLang, tTargetKind, aPool, aSeen)
	aL = CondListOf(aFrom, tSeat)
	if IsEmpty(aL) return false end
	for i = 1 to Len(aL)
		if aL[i] = tStart return true end
		if CondInList(aL[i], aSeen) loop end
		aSeen + aL[i]
		aT = CondFindIn(tLang, tTargetKind, aL[i], aPool)
		if IsEmpty(aT) loop end
		if CondReaches(aT, tSeat, tStart, tLang, tTargetKind, aPool, aSeen) return true end
	end
	return false
end
