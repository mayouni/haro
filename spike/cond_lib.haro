# cond_lib.haro -- the condition language of stzu's CONSTRAINT and VIEW (v0.2,
# grown in v0.3 and v0.4), in pure core Ring.
#
# Closed and total: a condition is read, never run. The grammar is in
# haro/spike/v04/GRAMMAR.md (v0.3's in v03/, v0.2's in v02/). One
# parser, two readers: the meta-court VALIDATES a condition against the
# declarations' seats (every name it uses must exist, by type) and the forged
# court EVALUATES it on a sentence's declarations.
#
#   cond   = term { ("and" | "or") term }       -- and binds tighter than or
#   term   = [ "not" ] atom
#   atom   = "(" cond ")"
#          | "exists" decl
#          | ("some" | "all" | "earlier") path [ "named" (value | path) ] [ "where" cond ]
#          | path "=" (value | path) | path "!=" (value | path)
#          | path ">" number | path "<" number
#          | path "present" | path "absent" | path "contains" value
#          | path "empty" | path "nonempty" | path "unique" | path "distinct"
#          | path ("within" | "host_of" | "under" | "covers") (path | value)
#          | path "cyclic" | path "matches" format
#          | "self" "is" view                                              (v0.4)
#          | "self" "reachable" | "self" "referenced" | path "keyed_by" path (v0.8)
#   path   = seg { "." seg } ;  seg = IDENT | "self" | "this"            (v0.4)
#            the head is self, this (the ON declaration, inside a quantifier or a
#            VIEW's WHERE), a VIEW, a seat, a ONE kind or a kind; each step is a
#            seat of a declaration, or a kind inside a SENTENCE seat
#   a quantifier's "where" runs to the closing parenthesis or the end;
#   on the right of = and != a bare word is a value, a dotted name or this/self a place;
#   on the right of a relation a bare word is a seat (v0.3's rule)
#
# The AST: ["or", a, b]  ["and", a, b]  ["not", a]  ["exists", decl]
#   ["path", [segs]]                 a place;  ["val", text] a value
#   ["cmp", op, path, right]         op in = != > <; right a path or a val
#   ["has", test, path]              test in present absent empty nonempty unique distinct
#   ["contains", path, value]
#   ["rel", name, path, right]       name in within host_of under covers
#   ["cyclic", path]  ["matches", path, format]  ["is", view]
#   ["quant", some|all|earlier, path, named, cond]   named NULL, a val or a path; cond or NULL
#
# TYPES (the meta-court) and CURSORS (the court) walk a path the same way:
#   ["decl", lang, d]      one declaration     (cursor: ["decl", lang, aDecl, pool])
#   ["set", lang, d]       declarations of a kind (cursor: ["set", lang, [decls], pool])
#   ["sentence", lang]     a SENTENCE seat's file (cursor: ["sentence", lang, decls])
#   ["value", seat]        a scalar or list value (cursor: ["value", text | list | NULL])
#   ["list", seat]         (types only; a cursor carries the list as a value)
#   ["none"]               (cursors only: a VIEW or a ONE kind that resolves to nothing)
#
# Tables. $aCondLangs: one entry per language, [lang, declseats, onedecls, views,
# verbof], where declseats is [[declname, [[seat, of, isList, kind, targetlang],
# ...]], ...] (kind in prim form expr menu range format decl union sentence),
# onedecls the names in WORLD's ONE, views [[name, on, resulttype, onepath, named,
# where], ...] and verbof [[declname, VERB], ...]. $aCondFormats: [[name, shape],
# ...] of the language being validated. The court also sets $cCondLang (the
# top language), $aCondDecls (its declarations), $aCourtSentences ([ownerlang,
# VERB, name, seat, path, decls, lang] per judged SENTENCE seat), $cCondOther,
# $bCondUnread (a reference that resolves to nothing was read: the condition
# says nothing and the reference's own refusal speaks).
# Functions only.

func CondIsWordChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 65 and nN <= 90) or nN = 95 or (nN >= 48 and nN <= 57)
end
func CondIsDigit(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)
end
# tokens: [type, text]; types: word number string eq ne gt lt lparen rparen dot eof
func CondTokenize(tS)
	xT = []
	nN = Len(tS)
	nI = 1
	while nI <= nN
		tC = tS[nI]
		if tC = " " or tC = Char(9)
			nI++
		elseif tC = "'"
			nJ = nI + 1
			while nJ <= nN and tS[nJ] != "'"
				nJ++
			end
			if nJ > nN Raise("condition: unterminated quote in '" + tS + "'") end
			xT + ["string", SubStr(tS, nI + 1, nJ - nI - 1)]
			nI = nJ + 1
		elseif CondIsDigit(tC)
			nJ = nI
			while nJ <= nN and CondIsDigit(tS[nJ])
				nJ++
			end
			xT + ["number", SubStr(tS, nI, nJ - nI)]
			nI = nJ
		elseif CondIsWordChar(tC)
			nJ = nI
			while nJ <= nN and CondIsWordChar(tS[nJ])
				nJ++
			end
			xT + ["word", SubStr(tS, nI, nJ - nI)]
			nI = nJ
		elseif tC = "!" and nI < nN and tS[nI+1] = "="
			xT + ["ne", "!="]
			nI += 2
		elseif tC = "="
			xT + ["eq", "="]
			nI++
		elseif tC = ">"
			xT + ["gt", ">"]
			nI++
		elseif tC = "<"
			xT + ["lt", "<"]
			nI++
		elseif tC = "("
			xT + ["lparen", "("]
			nI++
		elseif tC = ")"
			xT + ["rparen", ")"]
			nI++
		elseif tC = "."
			xT + ["dot", "."]
			nI++
		else
			Raise("condition: the character '" + tC + "' is not part of the condition language")
		end
	end
	xT + ["eof", ""]
	return xT
end
func CondPeek
	return $xCondToks[$nCondPos]
end
func CondNext
	xT = $xCondToks[$nCondPos]
	if xT[1] != "eof" $nCondPos++ end
	return xT
end
func CondParse(tS)
	$xCondToks = CondTokenize(tS)
	$nCondPos = 1
	xAst = CondOr()
	if CondPeek()[1] != "eof"
		Raise("condition: unexpected '" + CondPeek()[2] + "' in '" + tS + "'")
	end
	return xAst
end
# a path on its own (a VIEW's ONE), from its text
func CondParsePathText(tS)
	$xCondToks = CondTokenize(tS)
	$nCondPos = 1
	xT = CondNext()
	if xT[1] != "word" Raise("path: expected a name, found '" + xT[2] + "'") end
	xP = CondParsePath(xT)
	if CondPeek()[1] != "eof" Raise("path: unexpected '" + CondPeek()[2] + "' in '" + tS + "'") end
	return xP
end
# a value or a path on its own (a VIEW's NAMED), from its text
func CondParseRightText(tS)
	$xCondToks = CondTokenize(tS)
	$nCondPos = 1
	xR = CondCmpRight()
	if CondPeek()[1] != "eof" Raise("named: unexpected '" + CondPeek()[2] + "' in '" + tS + "'") end
	return xR
end
# A node is built in a fresh variable and assigned after: `aL = ["or", aL,
# aR]` puts the variable being assigned inside the list assigned to it, and
# on Ring the copy taken of aL dangles once aL is replaced -- an R2 at the
# next read (Ring, Judged by the Record, 4.4). haro ran the one-line form
# correctly; the oracle named it (HF-36).
func CondOr
	xL = CondAnd()
	while CondPeek()[1] = "word" and CondPeek()[2] = "or"
		CondNext()
		xR = CondAnd()
		xNode = ["or", xL, xR]
		xL = xNode
	end
	return xL
end
func CondAnd
	xL = CondTerm()
	while CondPeek()[1] = "word" and CondPeek()[2] = "and"
		CondNext()
		xR = CondTerm()
		xNode = ["and", xL, xR]
		xL = xNode
	end
	return xL
end
func CondTerm
	if CondPeek()[1] = "word" and CondPeek()[2] = "not"
		CondNext()
		return ["not", CondTerm()]
	end
	return CondAtom()
end
func CondValue
	xT = CondNext()
	if xT[1] = "word" or xT[1] = "number" or xT[1] = "string" return xT[2] end
	Raise("condition: expected a value, found '" + xT[2] + "'")
end
# a path, its first word already consumed as t
func CondParsePath(xT)
	xSegs = [xT[2]]
	while CondPeek()[1] = "dot"
		CondNext()
		xS = CondNext()
		if xS[1] != "word" Raise("condition: expected a name after '.'") end
		xSegs + xS[2]
	end
	return ["path", xSegs]
end
# the right of = and !=, and a quantifier's named: a quoted or numeric value,
# a dotted name or this/self as a place, a bare word as a value
func CondCmpRight
	xT = CondNext()
	if xT[1] = "string" or xT[1] = "number" return ["val", xT[2]] end
	if xT[1] != "word" Raise("condition: expected a value or a place, found '" + xT[2] + "'") end
	if CondPeek()[1] = "dot" or xT[2] = "this" or xT[2] = "self" return CondParsePath(xT) end
	return ["val", xT[2]]
end
# the right of a relation: a quoted or numeric value, or a place (a bare word
# is a seat)
func CondRelRight
	xT = CondNext()
	if xT[1] = "string" or xT[1] = "number" return ["val", xT[2]] end
	if xT[1] != "word" Raise("condition: expected a seat or a value, found '" + xT[2] + "'") end
	return CondParsePath(xT)
end
func CondAtom
	xT = CondNext()
	if xT[1] = "lparen"
		xC = CondOr()
		if CondNext()[1] != "rparen" Raise("condition: expected ')'") end
		return xC
	end
	if xT[1] != "word"
		Raise("condition: expected a seat, found '" + xT[2] + "'")
	end
	if xT[2] = "exists"
		xD = CondNext()
		if xD[1] != "word" Raise("condition: exists names a declaration") end
		return ["exists", xD[2]]
	end
	if xT[2] = "some" or xT[2] = "all" or xT[2] = "earlier"
		xD = CondNext()
		if xD[1] != "word" Raise("condition: " + xT[2] + " names a declaration kind or a list of references") end
		xTarget = CondParsePath(xD)
		xNamed = ""
		if CondPeek()[1] = "word" and CondPeek()[2] = "named"
			CondNext()
			xNamed = CondCmpRight()
		end
		xCond = ""
		if CondPeek()[1] = "word" and CondPeek()[2] = "where"
			CondNext()
			xCond = CondOr()
		end
		return ["quant", xT[2], xTarget, xNamed, xCond]
	end
	xPath = CondParsePath(xT)
	if CondPeek()[1] = "word" and CondPeek()[2] = "is"
		CondNext()
		xV = CondNext()
		if xV[1] != "word" Raise("condition: is names a VIEW") end
		if Len(xPath[2]) != 1 or xPath[2][1] != "self"
			Raise("condition: is asks whether self is a VIEW's declaration; write self is " + xV[2])
		end
		return ["is", xV[2]]
	end
	xOp = CondNext()
	if xOp[1] = "eq" or xOp[1] = "ne"
		return ["cmp", xOp[2], xPath, CondCmpRight()]
	end
	if xOp[1] = "gt" or xOp[1] = "lt"
		xV = CondValue()
		if not CondIsNumberText(xV)
			Raise("condition: " + xOp[2] + " compares numbers, and '" + xV + "' is not one")
		end
		return ["cmp", xOp[2], xPath, ["val", xV]]
	end
	if xOp[1] = "word"
		if xOp[2] = "present" or xOp[2] = "absent" or xOp[2] = "empty" or xOp[2] = "nonempty" or xOp[2] = "unique" or xOp[2] = "distinct"
			return ["has", xOp[2], xPath]
		end
		if xOp[2] = "contains"
			return ["contains", xPath, CondValue()]
		end
		if xOp[2] = "within" or xOp[2] = "host_of" or xOp[2] = "under" or xOp[2] = "covers"
			return ["rel", xOp[2], xPath, CondRelRight()]
		end
		if xOp[2] = "cyclic"
			return ["cyclic", xPath]
		end
		# v0.8: three closed relations F needs
		if xOp[2] = "reachable"
			return ["reach", xPath]
		end
		if xOp[2] = "referenced"
			return ["refd", xPath]
		end
		if xOp[2] = "keyed_by"
			return ["keyed", xPath, CondRelRight()]
		end
		if xOp[2] = "matches"
			xF = CondNext()
			if xF[1] != "word" Raise("condition: matches names a FORMAT") end
			return ["matches", xPath, xF[2]]
		end
	end
	Raise("condition: '" + xOp[2] + "' is not an operator of the condition language")
end
func CondIsNumberText(xV)
	if Len(xV) = 0 return false end
	for i = 1 to Len(xV)
		if not CondIsDigit(xV[i]) return false end
	end
	return true
end
func CondPathText(xP)
	tOut = ""
	for i = 1 to Len(xP[2])
		if i > 1 tOut += "." end
		tOut += xP[2][i]
	end
	return tOut
end
func CondInList(tS, xL)
	for i = 1 to Len(xL)
		if xL[i] = tS return true end
	end
	return false
end
# ---- the language tables, read by both readers --------------------------------------

func CondLang(tLang)
	for i = 1 to Len($xCondLangs)
		if $xCondLangs[i][1] = tLang return $xCondLangs[i] end
	end
	return ""
end
# the seats of a declaration kind of a language, or NULL when no such kind
func CondSeatsIn(tLang, tDecl)
	xL = CondLang(tLang)
	if IsEmpty(xL) return "" end
	xD = xL[2]
	for i = 1 to Len(xD)
		if xD[i][1] = tDecl return xD[i][2] end
	end
	return ""
end
func CondSeatInfoIn(tLang, tDecl, tSeat)
	xS = CondSeatsIn(tLang, tDecl)
	if IsEmpty(xS) return "" end
	for i = 1 to Len(xS)
		if xS[i][1] = tSeat return xS[i] end
	end
	return ""
end
# v0.8: the WORLD's ENTRY kinds and the forms of a language
func CondEntryIn(tLang)
	xL = CondLang(tLang)
	if IsEmpty(xL) return [] end
	if Len(xL) < 6 return [] end
	return xL[6]
end
func CondFormIn(tLang, tName)
	xL = CondLang(tLang)
	if IsEmpty(xL) return "" end
	if Len(xL) < 7 return "" end
	for i = 1 to Len(xL[7])
		if xL[7][i][1] = tName return xL[7][i] end
	end
	return ""
end
# a form's seat infos [[seat, of, kind], ...] describe a pair when there are two
# scalar seats and the first is a name, a MENU or a DECLARATION
func CondIsPairFormInfo(xInfo)
	if Len(xInfo) != 2 return false end
	tK1 = xInfo[1][3]
	if not ((xInfo[1][2] = "name" and tK1 = "prim") or tK1 = "menu" or tK1 = "decl") return false end
	return true
end
func CondIsOneIn(tLang, tDecl)
	xL = CondLang(tLang)
	if IsEmpty(xL) return false end
	return CondInList(tDecl, xL[3])
end
func CondViewIn(tLang, tName)
	xL = CondLang(tLang)
	if IsEmpty(xL) return "" end
	xV = xL[4]
	for i = 1 to Len(xV)
		if xV[i][1] = tName return xV[i] end
	end
	return ""
end
func CondVerbIn(tLang, tDecl)
	xL = CondLang(tLang)
	if IsEmpty(xL) return "" end
	xV = xL[5]
	for i = 1 to Len(xV)
		if xV[i][1] = tDecl return xV[i][2] end
	end
	return ""
end
func CondDeclNameIn(tLang, tVerb)
	xL = CondLang(tLang)
	if IsEmpty(xL) return "" end
	xV = xL[5]
	for i = 1 to Len(xV)
		if xV[i][2] = tVerb return xV[i][1] end
	end
	return ""
end
func CondFormatShape(tName)
	for i = 1 to Len($xCondFormats)
		if $xCondFormats[i][1] = tName return $xCondFormats[i][2] end
	end
	return ""
end
# ---- validation (the meta-court) ------------------------------------------------------
# The context is [onLang, on, inLang, in]: the ON declaration (on "" for a
# VIEW of the whole sentence) and the quantified declaration (in "" outside
# a quantifier). The current declaration is `in` when set, else `on`. A
# function returns "" or the refusal text; the type walkers return a type
# (a list) or the refusal text (a string).

func CondCtxCur(xCtx)
	if xCtx[4] != "" return [xCtx[3], xCtx[4]] end
	return [xCtx[1], xCtx[2]]
end
# the type a seat gives, read from a declaration of a language
func CondSeatType(xInfo, tLang)
	if xInfo[4] = "decl"
		if xInfo[3] return ["set", tLang, xInfo[2]] end
		return ["decl", tLang, xInfo[2]]
	end
	if xInfo[4] = "sentence" return ["sentence", xInfo[5]] end
	if xInfo[3] return ["list", xInfo[1]] end
	return ["value", xInfo[1]]
end
func CondTypeHead(tSeg, xCtx)
	xCur = CondCtxCur(xCtx)
	tLang = xCur[1]
	tDecl = xCur[2]
	if tSeg = "self"
		if tDecl = "" return "self is read on a declaration, and this VIEW has no ON" end
		return ["decl", tLang, tDecl]
	end
	if tSeg = "this"
		if xCtx[4] = "" return "this." + " is read inside some or all, where a bare seat is the quantified declaration's" end
		if xCtx[2] = "" return "this has no declaration here: this VIEW has no ON" end
		return ["decl", xCtx[1], xCtx[2]]
	end
	if tDecl != ""
		xV = CondViewIn(tLang, tSeg)
		if not IsEmpty(xV)
			if xV[2] = "" or xV[2] = tDecl return xV[3] end
		end
		xInfo = CondSeatInfoIn(tLang, tDecl, tSeg)
		if not IsEmpty(xInfo) return CondSeatType(xInfo, tLang) end
	else
		xV = CondViewIn(tLang, tSeg)
		if not IsEmpty(xV)
			if xV[2] = "" return xV[3] end
		end
	end
	if not IsEmpty(CondSeatsIn(tLang, tSeg))
		if CondIsOneIn(tLang, tSeg) return ["decl", tLang, tSeg] end
		return ["set", tLang, tSeg]
	end
	# inside a quantifier over another language's declarations, a KIND or a
	# whole-sentence VIEW of the ON declaration's language is still in reach
	# (fleet.link from a peer); a seat of the ON declaration is this.SEAT
	if xCtx[4] != "" and xCtx[1] != tLang
		xV = CondViewIn(xCtx[1], tSeg)
		if not IsEmpty(xV)
			if xV[2] = "" return xV[3] end
		end
		if not IsEmpty(CondSeatsIn(xCtx[1], tSeg))
			if CondIsOneIn(xCtx[1], tSeg) return ["decl", xCtx[1], tSeg] end
			return ["set", xCtx[1], tSeg]
		end
	end
	if tDecl != "" return "no seat '" + tSeg + "' on " + tDecl end
	return "'" + tSeg + "' is neither a kind nor a VIEW of " + tLang
end
func CondTypeStep(xT, tPrev, tSeg, xCtx)
	tK = xT[1]
	if tK = "decl"
		xInfo = CondSeatInfoIn(xT[2], xT[3], tSeg)
		if not IsEmpty(xInfo) return CondSeatType(xInfo, xT[2]) end
		# a VIEW on that declaration's kind reads as one of its seats
		xV = CondViewIn(xT[2], tSeg)
		if not IsEmpty(xV)
			if xV[2] = xT[3] return xV[3] end
		end
		return "no seat '" + tSeg + "' on " + xT[3]
	end
	if tK = "sentence"
		if IsEmpty(CondSeatsIn(xT[2], tSeg))
			return "'" + tSeg + "' is neither a seat nor a kind of " + xT[2]
		end
		if CondIsOneIn(xT[2], tSeg) return ["decl", xT[2], tSeg] end
		return ["set", xT[2], tSeg]
	end
	xCur = CondCtxCur(xCtx)
	if tK = "set"
		return "'" + tPrev + "' is not a ONE kind, and neither a reference seat of " + xCur[2] + ": only the one declaration of a ONE kind can be read from a condition, and a set of declarations is quantified over"
	end
	return "'" + tPrev + "' is a value, not a declaration: neither a reference seat of " + xCur[2] + " nor a ONE kind, and a path does not continue through a value"
end
# a path's type, or the refusal text
func CondTypePath(xP, xCtx)
	xSegs = xP[2]
	xT = CondTypeHead(xSegs[1], xCtx)
	if IsString(xT) return xT end
	for i = 2 to Len(xSegs)
		xT = CondTypeStep(xT, xSegs[i-1], xSegs[i], xCtx)
		if IsString(xT) return xT end
	end
	return xT
end
# the type of the right side of a comparison or a relation
func CondTypeRight(xR, xCtx)
	if xR[1] = "val" return ["value", ""] end
	return CondTypePath(xR, xCtx)
end
func CondValidate(xAst, tOn, xOneDecls, tInner)
	# v0.2/v0.3 callers: the ON and the quantified kind are of the language
	# being validated ($cCondLang); aOneDecls is carried in the tables now
	return CondValidateIn(xAst, [$tCondLang, tOn, $tCondLang, tInner])
end
func CondValidateIn(xAst, xCtx)
	tK = xAst[1]
	xCur = CondCtxCur(xCtx)
	if tK = "and" or tK = "or"
		xE = CondValidateIn(xAst[2], xCtx)
		if xE != "" return xE end
		return CondValidateIn(xAst[3], xCtx)
	elseif tK = "not"
		return CondValidateIn(xAst[2], xCtx)
	elseif tK = "exists"
		if IsEmpty(CondSeatsIn(xCur[1], xAst[2]))
			return "'" + xAst[2] + "' resolves to nothing: exists names a declaration of this language"
		end
		return ""
	elseif tK = "cmp"
		xT = CondTypePath(xAst[3], xCtx)
		if IsString(xT) return xT end
		if xT[1] = "set" return "'" + CondPathText(xAst[3]) + "' is a set of declarations, and = compares one value" end
		if xT[1] = "sentence" return "'" + CondPathText(xAst[3]) + "' is a file, and = compares one value" end
		xR = CondTypeRight(xAst[4], xCtx)
		if IsString(xR) return xR end
		if xR[1] = "set" or xR[1] = "sentence" return "'" + CondPathText(xAst[4]) + "' is not one value" end
		return ""
	elseif tK = "has"
		xT = CondTypePath(xAst[3], xCtx)
		if IsString(xT) return xT end
		tTest = xAst[2]
		if tTest = "empty" or tTest = "nonempty" or tTest = "distinct"
			# a list of values, a list of references (a set), or a UNION seat one
			# of whose shapes is a list
			if not CondTypeIsListish(xT, xCtx) return tTest + " reads a list seat, and '" + CondPathText(xAst[3]) + "' is not one" end
		end
		if tTest = "unique"
			if xT[1] != "value" and xT[1] != "sentence" return "unique reads a scalar seat, and '" + CondPathText(xAst[3]) + "' is not one" end
			if Len(xAst[3][2]) != 1 return "unique reads a seat of this declaration, and '" + CondPathText(xAst[3]) + "' is a path" end
		end
		return ""
	elseif tK = "contains"
		xT = CondTypePath(xAst[2], xCtx)
		if IsString(xT) return xT end
		if not CondTypeIsListish(xT, xCtx) return "contains reads a list seat, and '" + CondPathText(xAst[2]) + "' is not one" end
		return ""
	elseif tK = "rel"
		xT = CondTypePath(xAst[3], xCtx)
		if IsString(xT) return xT end
		if xAst[2] = "covers"
			# a list seat, or a UNION seat (one of whose alternatives may be a
			# list; a word written there covers nothing)
			if not CondTypeIsListish(xT, xCtx) return "covers takes a list seat on its left, and '" + CondPathText(xAst[3]) + "' is not one" end
		else
			if xT[1] != "value" return xAst[2] + " reads a scalar seat, and '" + CondPathText(xAst[3]) + "' is not one" end
		end
		xR = CondTypeRight(xAst[4], xCtx)
		if IsString(xR) return xR end
		return ""
	elseif tK = "cyclic"
		xSegs = xAst[2][2]
		bOk = false
		if Len(xSegs) = 1
			xInfo = CondSeatInfoIn(xCur[1], xCur[2], xSegs[1])
			if not IsEmpty(xInfo)
				if xInfo[3] and xInfo[4] = "decl" and xInfo[2] = xCur[2] bOk = true end
			end
		end
		if not bOk return "cyclic follows a list of references to the declaration's own kind, and '" + CondPathText(xAst[2]) + "' is not one" end
		return ""
	elseif tK = "reach" or tK = "refd"
		tWord = "reachable"
		if tK = "refd" tWord = "referenced" end
		xSegs = xAst[2][2]
		if Len(xSegs) != 1 or xSegs[1] != "self"
			return tWord + " asks whether self is " + tWord + "; write self " + tWord
		end
		if tK = "reach" and Len(CondEntryIn(xCur[1])) = 0
			return "reachable walks from the WORLD's ENTRY kinds, and none are declared"
		end
		return ""
	elseif tK = "keyed"
		xSegs = xAst[2][2]
		bPairs = false
		if Len(xSegs) = 1
			xInfo = CondSeatInfoIn(xCur[1], xCur[2], xSegs[1])
			if not IsEmpty(xInfo)
				if xInfo[3] and xInfo[4] = "form"
					xF = CondFormIn(xCur[1], xInfo[2])
					if not IsEmpty(xF) and CondIsPairFormInfo(xF[2]) bPairs = true end
				end
			end
		end
		if not bPairs return "keyed_by reads a list of pairs on its left, and '" + CondPathText(xAst[2]) + "' is not one" end
		xR = xAst[3]
		bList = false
		if xR[1] = "path" and Len(xR[2]) = 1
			xInfo = CondSeatInfoIn(xCur[1], xCur[2], xR[2][1])
			if not IsEmpty(xInfo)
				if xInfo[3] bList = true end
			end
		end
		if not bList return "keyed_by reads a list of names on its right, and '" + CondPathText(xR) + "' is not one" end
		return ""
	elseif tK = "matches"
		xT = CondTypePath(xAst[2], xCtx)
		if IsString(xT) return xT end
		if xT[1] != "value" and xT[1] != "decl" return "matches reads a value, and '" + CondPathText(xAst[2]) + "' is not one" end
		if CondFormatShape(xAst[3]) = "" return "'" + xAst[3] + "' must name a FORMAT of this language: matches tests a shape" end
		return ""
	elseif tK = "is"
		if IsEmpty(CondViewIn(xCur[1], xAst[2])) return "'" + xAst[2] + "' must name a VIEW: is asks whether self is the VIEW's declaration" end
		return ""
	elseif tK = "quant"
		tQ = xAst[2]
		xSegs = xAst[3][2]
		if tQ = "earlier"
			if Len(xSegs) != 1 or IsEmpty(CondSeatsIn(xCur[1], xSegs[1]))
				return "earlier quantifies over a kind of this language, the declarations before this one, and '" + CondPathText(xAst[3]) + "' is not one"
			end
			xT = ["set", xCur[1], xSegs[1]]
		else
			# a quantifier wants a set, so one name that is both a seat and a kind
			# (a RETIREMENT's member, the kind member) is the kind here
			if Len(xSegs) = 1 and not IsEmpty(CondSeatsIn(xCur[1], xSegs[1]))
				xT = ["set", xCur[1], xSegs[1]]
			else
				xT = CondTypePath(xAst[3], xCtx)
				if IsString(xT)
					if Len(xSegs) = 1 return "'" + xSegs[1] + "' names neither a declaration kind nor a list of references: some and all quantify over a declaration kind or a list of references" end
					return xT
				end
				if xT[1] != "set" return "'" + CondPathText(xAst[3]) + "' is not a set of declarations: some and all quantify over a declaration kind, a list of references, or a kind inside a SENTENCE" end
			end
		end
		if not IsEmpty(xAst[4])
			if Len(xSegs) = 1
				xInfo = CondSeatInfoIn(xCur[1], xCur[2], xSegs[1])
				if not IsEmpty(xInfo)
					if xInfo[4] = "decl" and xInfo[3] return "named goes with a kind, and '" + xSegs[1] + "' is a list of references, already named" end
				end
			end
			xR = CondTypeRight(xAst[4], xCtx)
			if IsString(xR) return xR end
		end
		if not IsEmpty(xAst[5])
			return CondValidateIn(xAst[5], [xCtx[1], xCtx[2], xT[2], xT[3]])
		end
		return ""
	end
	return "'" + tK + "' is not a condition"
end
# a VIEW: [name, on, onepath (text), named (text or ""), where (text or "")];
# returns "" or the refusal, and the view's result type through aOut[1]
func CondValidateView(xView, tLang, xOut)
	tOn = xView[2]
	xCtx = [tLang, tOn, tLang, ""]
	xP = CondParsePathText(xView[3])
	xT = CondTypePath(xP, xCtx)
	if IsString(xT) return xT end
	if xT[1] != "set" return "ONE names a set of declarations, and '" + xView[3] + "' is " + CondTypeWord(xT) end
	if xView[4] != ""
		xR = CondParseRightText(xView[4])
		xRT = CondTypeRight(xR, xCtx)
		if IsString(xRT) return xRT end
	end
	if xView[5] != ""
		xC = CondParse(xView[5])
		xE = CondValidateIn(xC, [tLang, tOn, xT[2], xT[3]])
		if xE != "" return xE end
	end
	xOut[1] = ["decl", xT[2], xT[3]]
	return ""
end
func CondTypeWord(xT)
	if xT[1] = "decl" return "one declaration" end
	if xT[1] = "sentence" return "a file" end
	return "a value"
end
# a list of values, a set of declarations, or a UNION seat (one of whose shapes
# may be a list; a word written there is an empty list to these tests)
func CondTypeIsListish(xT, xCtx)
	if xT[1] = "list" or xT[1] = "set" return true end
	if xT[1] = "value"
		xCur = CondCtxCur(xCtx)
		xInfo = CondSeatInfoIn(xCur[1], xCur[2], xT[2])
		if not IsEmpty(xInfo)
			if xInfo[4] = "union" return true end
		end
	end
	return false
end
# ---- evaluation (the forged court) ----------------------------------------------------
# A declaration is the court's [VERB, name, line, clauses, rationale] with a
# clause [NAME, line, [shape, payload, start, end]]; the seat's clause name
# is upper(seat). A cursor carries the language and the pool (the declarations
# of the sentence the declaration stands in), so a kind, `earlier` and
# `unique` are read against the right pool.

func CondClauseOf(xDecl, tSeat)
	xC = xDecl[4]
	tN = Upper(tSeat)
	for i = 1 to Len(xC)
		if xC[i][1] = tN return xC[i] end
	end
	return ""
end
# the text of a scalar value, or NULL when the seat is absent or a list
func CondScalar(xDecl, tSeat)
	xC = CondClauseOf(xDecl, tSeat)
	if IsEmpty(xC) return "" end
	tShape = xC[3][1]
	if tShape = "word" or tShape = "string" or tShape = "number" return xC[3][2] end
	return ""
end
func CondListOf(xDecl, tSeat)
	xC = CondClauseOf(xDecl, tSeat)
	if IsEmpty(xC) return "" end
	tShape = xC[3][1]
	if tShape = "namelist" or tShape = "stringlist" return xC[3][2] end
	if tShape = "pairlist"
		# v0.6: a list of name: value pairs reads as its names
		xNames = []
		for i = 1 to Len(xC[3][2])
			xNames + xC[3][2][i][1]
		end
		return xNames
	end
	return ""
end
func CondSameText(xA, xB)
	return xA = xB
end
func CondSameDecl(xA, xB)
	return xA[1] = xB[1] and xA[2] = xB[2] and xA[3] = xB[3]
end
func CondCur(xOuter, xInner)
	if IsEmpty(xInner) return xOuter end
	return xInner
end
func CondPoolOf(xC)
	if IsEmpty(xC) return $xCondDecls end
	return xC[4]
end
func CondLangOf(xC)
	if IsEmpty(xC) return $tCondLang end
	return xC[2]
end
# the declarations of a kind in a pool
func CondOfKind(tLang, tDecl, xPool)
	tVerb = CondVerbIn(tLang, tDecl)
	xOut = []
	for i = 1 to Len(xPool)
		if xPool[i][1] = tVerb xOut + xPool[i] end
	end
	return xOut
end
func CondFindIn(tLang, tDecl, tName, xPool)
	tVerb = CondVerbIn(tLang, tDecl)
	for i = 1 to Len(xPool)
		if xPool[i][1] = tVerb and xPool[i][2] = tName return xPool[i] end
	end
	return ""
end
# the judged file of a SENTENCE seat: [ownerlang, VERB, name, seat, path, decls, lang]
func CondSentenceOf(tLang, xDecl, tSeat)
	for i = 1 to Len($vCourtSentences)
		xS = $vCourtSentences[i]
		if xS[1] = tLang and xS[2] = xDecl[1] and xS[3] = xDecl[2] and xS[4] = tSeat return xS end
	end
	return ""
end
# a seat of a declaration cursor, as a cursor; NULL raises $bCondUnread
func CondSeatCursor(xC, tSeat)
	tLang = xC[2]
	xDecl = xC[3]
	tDeclName = CondDeclNameIn(tLang, xDecl[1])
	xInfo = CondSeatInfoIn(tLang, tDeclName, tSeat)
	if IsEmpty(xInfo) return ["none"] end
	if xInfo[4] = "decl"
		if xInfo[3]
			xL = CondListOf(xDecl, tSeat)
			if IsEmpty(xL) xL = [] end
			xOut = []
			for i = 1 to Len(xL)
				xT = CondFindIn(tLang, xInfo[2], xL[i], xC[4])
				if not IsEmpty(xT) xOut + xT end
			end
			return ["set", tLang, xOut, xC[4]]
		end
		xV = CondScalar(xDecl, tSeat)
		if IsEmpty(xV)
			$bCondUnread = true
			return ""
		end
		xT = CondFindIn(tLang, xInfo[2], xV, xC[4])
		if IsEmpty(xT)
			$bCondUnread = true
			return ""
		end
		return ["decl", tLang, xT, xC[4]]
	end
	if xInfo[4] = "sentence"
		xS = CondSentenceOf(tLang, xDecl, tSeat)
		if IsEmpty(xS) return ["none"] end
		return ["sentence", xS[7], xS[6]]
	end
	if xInfo[3]
		return ["value", CondListOf(xDecl, tSeat)]
	end
	return ["value", CondScalar(xDecl, tSeat)]
end
func CondHeadCursor(tSeg, xOuter, xInner)
	xCur = CondCur(xOuter, xInner)
	if tSeg = "self"
		if IsEmpty(xCur)
			$bCondUnread = true
			return ""
		end
		return xCur
	end
	if tSeg = "this"
		if IsEmpty(xOuter)
			$bCondUnread = true
			return ""
		end
		return xOuter
	end
	tLang = CondLangOf(xCur)
	xV = CondViewIn(tLang, tSeg)
	if not IsEmpty(xV)
		return CondViewCursor(xV, xCur)
	end
	if not IsEmpty(xCur)
		tDeclName = CondDeclNameIn(tLang, xCur[3][1])
		if not IsEmpty(CondSeatInfoIn(tLang, tDeclName, tSeg))
			return CondSeatCursor(xCur, tSeg)
		end
	end
	xPool = CondPoolOf(xCur)
	if not IsEmpty(CondSeatsIn(tLang, tSeg))
		xK = CondOfKind(tLang, tSeg, xPool)
		if CondIsOneIn(tLang, tSeg)
			if Len(xK) = 0 return ["none"] end
			return ["decl", tLang, xK[1], xPool]
		end
		return ["set", tLang, xK, xPool]
	end
	# inside a quantifier over another language's declarations, a KIND or a
	# whole-sentence VIEW of the ON declaration's language is still in reach
	if not IsEmpty(xInner) and not IsEmpty(xOuter)
		if xOuter[2] != tLang
			tOL = xOuter[2]
			xV = CondViewIn(tOL, tSeg)
			if not IsEmpty(xV)
				if xV[2] = "" return CondViewCursor(xV, xOuter) end
			end
			if not IsEmpty(CondSeatsIn(tOL, tSeg))
				xPoolO = xOuter[4]
				xK = CondOfKind(tOL, tSeg, xPoolO)
				if CondIsOneIn(tOL, tSeg)
					if Len(xK) = 0 return ["none"] end
					return ["decl", tOL, xK[1], xPoolO]
				end
				return ["set", tOL, xK, xPoolO]
			end
		end
	end
	return ["none"]
end
func CondStepCursor(xC, tSeg)
	if IsEmpty(xC) return "" end
	tK = xC[1]
	if tK = "decl"
		tDeclName = CondDeclNameIn(xC[2], xC[3][1])
		if not IsEmpty(CondSeatInfoIn(xC[2], tDeclName, tSeg)) return CondSeatCursor(xC, tSeg) end
		xV = CondViewIn(xC[2], tSeg)
		if not IsEmpty(xV)
			if xV[2] = tDeclName return CondViewCursor(xV, xC) end
		end
		return ["none"]
	end
	if tK = "sentence"
		tLang = xC[2]
		xK = CondOfKind(tLang, tSeg, xC[3])
		if CondIsOneIn(tLang, tSeg)
			if Len(xK) = 0 return ["none"] end
			return ["decl", tLang, xK[1], xC[3]]
		end
		return ["set", tLang, xK, xC[3]]
	end
	return ["none"]
end
# a path's cursor: NULL (unread), ["none"], or a cursor
func CondWalk(xP, xOuter, xInner)
	xSegs = xP[2]
	xC = CondHeadCursor(xSegs[1], xOuter, xInner)
	for i = 2 to Len(xSegs)
		if IsEmpty(xC) return "" end
		if xC[1] = "none" return xC end
		xC = CondStepCursor(xC, xSegs[i])
	end
	return xC
end
# a path's text value: a declaration's name, a scalar's text; NULL otherwise
func CondPathScalar(xP, xOuter, xInner)
	xC = CondWalk(xP, xOuter, xInner)
	if IsEmpty(xC) return "" end
	if xC[1] = "decl" return xC[3][2] end
	if xC[1] = "value"
		if IsEmpty(xC[2]) return "" end
		if IsList(xC[2]) return "" end
		return xC[2]
	end
	return ""
end
# a path's list: a list seat's items as written (so a list of references reads
# its names, resolved or not), or the names of a set reached along a path
func CondPathList(xP, xOuter, xInner)
	xSegs = xP[2]
	xCur = CondCur(xOuter, xInner)
	if Len(xSegs) = 1 and not IsEmpty(xCur)
		if xSegs[1] != "self" and xSegs[1] != "this"
			tDeclName = CondDeclNameIn(xCur[2], xCur[3][1])
			if not IsEmpty(CondSeatInfoIn(xCur[2], tDeclName, xSegs[1]))
				return CondListOf(xCur[3], xSegs[1])
			end
		end
	end
	xC = CondWalk(xP, xOuter, xInner)
	if IsEmpty(xC) return "" end
	if xC[1] = "value"
		if IsEmpty(xC[2]) return "" end
		if IsList(xC[2]) return xC[2] end
		return ""
	end
	if xC[1] = "set"
		xOut = []
		for i = 1 to Len(xC[3])
			xOut + xC[3][i][2]
		end
		return xOut
	end
	return ""
end
func CondRightText(xR, xOuter, xInner)
	if xR[1] = "val"
		if xR[2] = "self"
			xCur = CondCur(xOuter, xInner)
			if IsEmpty(xCur) return "" end
			return xCur[3][2]
		end
		return xR[2]
	end
	return CondPathScalar(xR, xOuter, xInner)
end
# a VIEW's declaration for a cursor: ["decl", ...] or ["none"]
func CondViewCursor(xV, xCur)
	tOn = xV[2]
	xOuter = xCur
	if tOn = ""
		xOuter = ""
	else
		if IsEmpty(xCur) return ["none"] end
		if CondDeclNameIn(xCur[2], xCur[3][1]) != tOn return ["none"] end
	end
	xP = CondParsePathText(xV[4])
	xSet = CondWalk(xP, xOuter, "")
	if IsEmpty(xSet) return ["none"] end
	if xSet[1] != "set" return ["none"] end
	tNamed = ""
	if xV[5] != ""
		tNamed = CondRightText(CondParseRightText(xV[5]), xOuter, "")
		if IsEmpty(tNamed) return ["none"] end
	end
	xWhere = ""
	if xV[6] != "" xWhere = CondParse(xV[6]) end
	for i = 1 to Len(xSet[3])
		xD = xSet[3][i]
		if not IsEmpty(tNamed)
			if xD[2] != tNamed loop end
		end
		vIn = ["decl", xSet[2], xD, xSet[4]]
		if not IsEmpty(xWhere)
			if not CondEvalIn(xWhere, xOuter, vIn) loop end
		end
		return vIn
	end
	return ["none"]
end
func CondEval(xAst, xDecl)
	return CondEvalIn(xAst, ["decl", $tCondLang, xDecl, $xCondDecls], "")
end
func CondEvalIn(xAst, xOuter, xInner)
	xCur = CondCur(xOuter, xInner)
	tK = xAst[1]
	if tK = "and"
		if not CondEvalIn(xAst[2], xOuter, xInner) return false end
		return CondEvalIn(xAst[3], xOuter, xInner)
	elseif tK = "or"
		if CondEvalIn(xAst[2], xOuter, xInner) return true end
		return CondEvalIn(xAst[3], xOuter, xInner)
	elseif tK = "not"
		return not CondEvalIn(xAst[2], xOuter, xInner)
	elseif tK = "exists"
		return Len(CondOfKind(CondLangOf(xCur), xAst[2], CondPoolOf(xCur))) > 0
	elseif tK = "cmp"
		xOp = xAst[2]
		xV = CondPathScalar(xAst[3], xOuter, xInner)
		if IsEmpty(xV) return false end
		tW = CondRightText(xAst[4], xOuter, xInner)
		if IsEmpty(tW) return false end
		if xOp = "="  return CondSameText(xV, tW) end
		if xOp = "!=" return not CondSameText(xV, tW) end
		if not CondIsNumberText(xV) return false end
		if xOp = ">" return Number(xV) > Number(tW) end
		return Number(xV) < Number(tW)
	elseif tK = "contains"
		xL = CondPathList(xAst[2], xOuter, xInner)
		if IsEmpty(xL) return false end
		tW = xAst[3]
		if tW = "self"
			if IsEmpty(xCur) return false end
			tW = xCur[3][2]
		end
		for i = 1 to Len(xL)
			if xL[i] = tW return true end
		end
		return false
	elseif tK = "rel"
		tRel = xAst[2]
		if tRel = "covers"
			xL = CondPathList(xAst[3], xOuter, xInner)
			if IsEmpty(xL) return false end
			tR = CondRightText(xAst[4], xOuter, xInner)
			if IsEmpty(tR) return false end
			return CondCovers(xL, tR)
		end
		xV = CondPathScalar(xAst[3], xOuter, xInner)
		if IsEmpty(xV) return false end
		tR = CondRightText(xAst[4], xOuter, xInner)
		if IsEmpty(tR) return false end
		if tRel = "within" return CondWithin(xV, tR) end
		if tRel = "host_of" return CondHostOf(xV, tR) end
		return CondUnder(xV, tR)
	elseif tK = "reach"
		xCur = CondCur(xOuter, xInner)
		if IsEmpty(xCur) return false end
		return CondReachable(xCur)
	elseif tK = "refd"
		xCur = CondCur(xOuter, xInner)
		if IsEmpty(xCur) return false end
		return CondReferenced(xCur)
	elseif tK = "keyed"
		xCur = CondCur(xOuter, xInner)
		if IsEmpty(xCur) return false end
		return CondKeyedBy(xCur, xAst[2][2][1], xAst[3][2][1])
	elseif tK = "cyclic"
		if IsEmpty(xCur) return false end
		return CondCyclic(xCur, xAst[2][2][1])
	elseif tK = "matches"
		xV = CondPathScalar(xAst[2], xOuter, xInner)
		if IsEmpty(xV) return false end
		return CondHasShape(xV, CondFormatShape(xAst[3]))
	elseif tK = "is"
		if IsEmpty(xCur) return false end
		xView = CondViewIn(CondLangOf(xCur), xAst[2])
		if IsEmpty(xView) return false end
		xD = CondViewCursor(xView, xCur)
		if xD[1] != "decl" return false end
		return CondSameDecl(xD[3], xCur[3])
	elseif tK = "quant"
		return CondQuant(xAst, xOuter, xInner)
	else
		# has
		tTest = xAst[2]
		if tTest = "unique"
			# against the declarations BEFORE this one, so the later of two
			# is the one refused and {other} names the earlier ("already a's");
			# the clause's own text, so a SENTENCE seat's path counts too
			if IsEmpty(xCur) return true end
			tSeat = xAst[3][2][1]
			xD = xCur[3]
			xV = CondScalar(xD, tSeat)
			if IsEmpty(xV) return true end
			xPool = xCur[4]
			for i = 1 to Len(xPool)
				xO = xPool[i]
				if CondSameDecl(xO, xD) exit end
				if xO[1] = xD[1]
					tW = CondScalar(xO, tSeat)
					if not IsEmpty(tW) and tW = xV
						$tCondOther = xO[2]
						return false
					end
				end
			end
			return true
		end
		if tTest = "empty" or tTest = "nonempty" or tTest = "distinct"
			# the list as written: a list of references reads its names, resolved or not
			xL = CondPathList(xAst[3], xOuter, xInner)
			if tTest = "empty"
				if IsEmpty(xL) return false end
				return Len(xL) = 0
			end
			if tTest = "nonempty"
				if IsEmpty(xL) return false end
				return Len(xL) > 0
			end
			if IsEmpty(xL) return true end
			for i = 1 to Len(xL)
				for j = 1 to i - 1
					if xL[i] = xL[j]
						$tCondOther = xL[i]
						return false
					end
				end
			end
			return true
		end
		# present and absent on a seat of this declaration ask whether the
		# clause is WRITTEN (a list of references is present when written, even
		# empty or unresolved); on a view or a kind, whether it resolves
		xSegs = xAst[3][2]
		if Len(xSegs) = 1 and not IsEmpty(xCur)
			if xSegs[1] != "self" and xSegs[1] != "this"
				tDeclName = CondDeclNameIn(xCur[2], xCur[3][1])
				if not IsEmpty(CondSeatInfoIn(xCur[2], tDeclName, xSegs[1]))
					bWritten = not IsEmpty(CondClauseOf(xCur[3], xSegs[1]))
					if tTest = "present" return bWritten end
					return not bWritten
				end
			end
		end
		xC = CondWalk(xAst[3], xOuter, xInner)
		if IsEmpty(xC) return false end
		if xC[1] = "none"
			return tTest = "absent"
		end
		if xC[1] = "decl" or xC[1] = "sentence"
			if tTest = "present" return true end
			return false
		end
		if xC[1] = "set"
			if tTest = "present" return Len(xC[3]) > 0 end
			if tTest = "absent" return Len(xC[3]) = 0 end
			return false
		end
		xV = xC[2]
		if tTest = "present" return not IsEmpty(xV) end
		if tTest = "absent" return IsEmpty(xV) end
		return false
	end
end
# some, all and earlier over the declarations a path names (a kind, a list
# of references, a kind inside a SENTENCE), narrowed by named; some and
# earlier record the one found, all the first failure, in {other}
# ---- v0.8: reachable, referenced, keyed_by -----------------------------------------

# the names a declaration refers to through its reference seats: a scalar
# DECLARATION or UNION seat, a list of references, a pair list's keys when
# they are declarations and its values when they are declarations or unions
func CondRefNames(tLang, xDecl)
	xOut = []
	tDeclName = CondDeclNameIn(tLang, xDecl[1])
	xSeats = CondSeatsIn(tLang, tDeclName)
	if IsEmpty(xSeats) return xOut end
	for i = 1 to Len(xSeats)
		xInfo = xSeats[i]
		xC = CondClauseOf(xDecl, xInfo[1])
		if IsEmpty(xC) loop end
		tShape = xC[3][1]
		if xInfo[4] = "decl" or xInfo[4] = "union"
			if tShape = "word" xOut + xC[3][2] end
			if tShape = "namelist"
				for j = 1 to Len(xC[3][2]) xOut + xC[3][2][j] end
			end
		elseif xInfo[4] = "form" and tShape = "pairlist"
			xF = CondFormIn(tLang, xInfo[2])
			if IsEmpty(xF) loop end
			bKey = xF[2][1][3] = "decl"
			bVal = xF[2][2][3] = "decl" or xF[2][2][3] = "union"
			for j = 1 to Len(xC[3][2])
				if bKey xOut + xC[3][2][j][1] end
				if bVal xOut + xC[3][2][j][2] end
			end
		end
	end
	return xOut
end
# self is reachable from the entry -- the first declaration of one of the
# WORLD's ENTRY kinds -- through the reference seats of the ENTRY kinds'
# declarations (a step's arrows), never through an ending's
func CondReachable(xCur)
	tLang = xCur[2]
	xPool = xCur[4]
	xEntry = CondEntryIn(tLang)
	vVerbs = []
	for i = 1 to Len(xEntry)
		vVerbs + CondVerbIn(tLang, xEntry[i])
	end
	tStart = ""
	for i = 1 to Len(xPool)
		if CondInList(xPool[i][1], vVerbs)
			tStart = xPool[i][2]
			exit
		end
	end
	if tStart = "" return false end
	vSeen = [tStart]
	nN = 1
	while nN <= Len(vSeen)
		tCur = vSeen[nN]
		nN++
		for i = 1 to Len(xPool)
			if xPool[i][2] != tCur loop end
			if not CondInList(xPool[i][1], vVerbs) loop end
			xNames = CondRefNames(tLang, xPool[i])
			for j = 1 to Len(xNames)
				if not CondInList(xNames[j], vSeen) vSeen + xNames[j] end
			end
		end
	end
	return CondInList(xCur[3][2], vSeen)
end
# self is named by a reference seat of some declaration of the sentence
func CondReferenced(xCur)
	tLang = xCur[2]
	xPool = xCur[4]
	tMe = xCur[3][2]
	for i = 1 to Len(xPool)
		xNames = CondRefNames(tLang, xPool[i])
		if CondInList(tMe, xNames) return true end
	end
	return false
end
# the keys of a pair list are exactly the names of a list, as sets; the first
# key with no name, or name with no key, is {other}
func CondKeyedBy(xCur, tPairs, tNames)
	xKeys = CondListOf(xCur[3], tPairs)
	xNames = CondListOf(xCur[3], tNames)
	if IsEmpty(xKeys) xKeys = [] end
	if IsEmpty(xNames) xNames = [] end
	for i = 1 to Len(xKeys)
		if not CondInList(xKeys[i], xNames)
			$tCondOther = xKeys[i]
			return false
		end
	end
	for i = 1 to Len(xNames)
		if not CondInList(xNames[i], xKeys)
			$tCondOther = xNames[i]
			return false
		end
	end
	return true
end
func CondQuant(xAst, xOuter, xInner)
	xCur = CondCur(xOuter, xInner)
	tQ = xAst[2]
	xItems = []
	if tQ = "earlier"
		if IsEmpty(xCur) return false end
		xPool = xCur[4]
		tVerb = CondVerbIn(xCur[2], xAst[3][2][1])
		for i = 1 to Len(xPool)
			if CondSameDecl(xPool[i], xCur[3]) exit end
			if xPool[i][1] = tVerb xItems + ["decl", xCur[2], xPool[i], xPool] end
		end
	else
		xSegs = xAst[3][2]
		xSet = ""
		if Len(xSegs) = 1 and not IsEmpty(xCur)
			# a name that is both a seat and a kind is the kind to a quantifier
			if not IsEmpty(CondSeatsIn(xCur[2], xSegs[1]))
				xSet = ["set", xCur[2], CondOfKind(xCur[2], xSegs[1], xCur[4]), xCur[4]]
			end
		end
		if IsEmpty(xSet) xSet = CondWalk(xAst[3], xOuter, xInner) end
		if IsEmpty(xSet) return false end
		if xSet[1] != "set" return false end
		for i = 1 to Len(xSet[3])
			xItems + ["decl", xSet[2], xSet[3][i], xSet[4]]
		end
	end
	tNamed = ""
	if not IsEmpty(xAst[4])
		tNamed = CondRightText(xAst[4], xOuter, xInner)
		if IsEmpty(tNamed) return false end
	end
	xCond = xAst[5]
	if tQ = "all"
		for i = 1 to Len(xItems)
			if not IsEmpty(tNamed)
				if xItems[i][3][2] != tNamed loop end
			end
			if not IsEmpty(xCond)
				if not CondEvalIn(xCond, xOuter, xItems[i])
					$tCondOther = xItems[i][3][2]
					return false
				end
			end
		end
		return true
	end
	for i = 1 to Len(xItems)
		if not IsEmpty(tNamed)
			if xItems[i][3][2] != tNamed loop end
		end
		if IsEmpty(xCond)
			$tCondOther = xItems[i][3][2]
			return true
		end
		if CondEvalIn(xCond, xOuter, xItems[i])
			$tCondOther = xItems[i][3][2]
			return true
		end
	end
	return false
end
# ---- the relations, each total ---------------------------------------------------

func CondSplit(tS, tSep)
	xOut = []
	tCur = ""
	for i = 1 to Len(tS)
		if tS[i] = tSep
			xOut + tCur
			tCur = ""
		else
			tCur += tS[i]
		end
	end
	xOut + tCur
	return xOut
end
func CondIsHexChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57) or (nN >= 97 and nN <= 102) or (nN >= 65 and nN <= 70)
end
func CondIsLowerHexChar(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57) or (nN >= 97 and nN <= 102)
end
func CondIsLabelChar(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 48 and nN <= 57) or nN = 45
end
func CondIsIpv4(tS)
	xParts = CondSplit(tS, ".")
	if Len(xParts) != 4 return false end
	for i = 1 to 4
		xP = xParts[i]
		if Len(xP) = 0 or Len(xP) > 3 return false end
		for j = 1 to Len(xP)
			if not CondIsDigit(xP[j]) return false end
		end
		if Number(xP) > 255 return false end
	end
	return true
end
func CondIsLabel(tS)
	if Len(tS) = 0 return false end
	for i = 1 to Len(tS)
		if not CondIsLabelChar(tS[i]) return false end
	end
	if tS[1] = "-" return false end
	if tS[Len(tS)] = "-" return false end
	return true
end
# a duration is a number and a unit: seconds, minutes, hours, days, working
# day, working days (RingFlex grammar-v0.md 5.4); a landmark is the one form
# v0 knows, "the Nth working day of next month"; a deadline is either (v0.8)
func CondWordsOf(tS)
	xW = []
	tCur = ""
	for i = 1 to Len(tS)
		if tS[i] = " " or tS[i] = Char(9)
			if tCur != "" xW + tCur end
			tCur = ""
		else
			tCur += tS[i]
		end
	end
	if tCur != "" xW + tCur end
	return xW
end
func CondIsAllDigits(tS)
	if Len(tS) = 0 return false end
	for i = 1 to Len(tS)
		if not CondIsDigit(tS[i]) return false end
	end
	return true
end
func CondIsDuration(tS)
	xW = CondWordsOf(tS)
	if Len(xW) < 2 return false end
	if not CondIsAllDigits(xW[1]) return false end
	if Len(xW) = 2
		return CondInList(xW[2], ["seconds", "minutes", "hours", "days"])
	end
	if Len(xW) = 3
		return xW[2] = "working" and (xW[3] = "day" or xW[3] = "days")
	end
	return false
end
func CondIsLandmark(tS)
	xW = CondWordsOf(tS)
	if Len(xW) != 7 return false end
	if xW[1] != "the" or xW[3] != "working" or xW[4] != "day" or xW[5] != "of" or xW[6] != "next" or xW[7] != "month" return false end
	tOrd = xW[2]
	if Len(tOrd) < 3 return false end
	tSuffix = Right(tOrd, 2)
	if not CondInList(tSuffix, ["st", "nd", "rd", "th"]) return false end
	return CondIsAllDigits(Left(tOrd, Len(tOrd) - 2))
end
# the shapes of a FORMAT: absolute_path, ipv4, cidr, mac, label, domain,
# hex64, hex64_lower (v0.4); duration, landmark, deadline (v0.8)
func CondHasShape(tS, tShape)
	if tShape = "duration" return CondIsDuration(tS) end
	if tShape = "landmark" return CondIsLandmark(tS) end
	if tShape = "deadline" return CondIsDuration(tS) or CondIsLandmark(tS) end
	if tShape = "absolute_path"
		if Len(tS) = 0 return false end
		return tS[1] = "/"
	elseif tShape = "ipv4"
		return CondIsIpv4(tS)
	elseif tShape = "cidr"
		xP = CondSplit(tS, "/")
		if Len(xP) != 2 return false end
		if not CondIsIpv4(xP[1]) return false end
		if Len(xP[2]) = 0 or Len(xP[2]) > 2 return false end
		for j = 1 to Len(xP[2])
			if not CondIsDigit(xP[2][j]) return false end
		end
		return Number(xP[2]) <= 32
	elseif tShape = "mac"
		xP = CondSplit(tS, ":")
		if Len(xP) != 6 return false end
		for i = 1 to 6
			if Len(xP[i]) != 2 return false end
			if not (CondIsHexChar(xP[i][1]) and CondIsHexChar(xP[i][2])) return false end
		end
		return true
	elseif tShape = "label"
		return CondIsLabel(tS)
	elseif tShape = "domain"
		xP = CondSplit(tS, ".")
		for i = 1 to Len(xP)
			if not CondIsLabel(xP[i]) return false end
		end
		return true
	elseif tShape = "hex64"
		if Len(tS) != 64 return false end
		for i = 1 to 64
			if not CondIsHexChar(tS[i]) return false end
		end
		return true
	elseif tShape = "hex64_lower"
		if Len(tS) != 64 return false end
		for i = 1 to 64
			if not CondIsLowerHexChar(tS[i]) return false end
		end
		return true
	end
	return true
end
# an address as a number (0..4294967295), or -1
func CondIpNum(tS)
	if not CondIsIpv4(tS) return -1 end
	xP = CondSplit(tS, ".")
	return ((Number(xP[1])) * 16777216) + ((Number(xP[2])) * 65536) + ((Number(xP[3])) * 256) + (Number(xP[4]))
end
func CondBlock(nBits)
	nN = 1
	for i = 1 to nBits
		nN *= 2
	end
	return nN
end
# a prefix as [first, last], or NULL
func CondCidrRange(tS)
	if not CondHasShape(tS, "cidr") return "" end
	xP = CondSplit(tS, "/")
	nIp = CondIpNum(xP[1])
	nBlock = CondBlock(32 - (Number(xP[2])))
	nLo = nIp - (nIp % nBlock)
	return [nLo, nLo + nBlock - 1]
end
func CondWithin(tIp, tCidr)
	xN = CondIpNum(tIp)
	if xN < 0 return false end
	xR = CondCidrRange(tCidr)
	if IsEmpty(xR) return false end
	return xN >= xR[1] and xN <= xR[2]
end
func CondHostOf(tIp, tCidr)
	xN = CondIpNum(tIp)
	if xN < 0 return false end
	if not CondHasShape(tCidr, "cidr") return false end
	xP = CondSplit(tCidr, "/")
	return xN = CondIpNum(xP[1])
end
# a path under a directory: the directory itself, or a path that continues
# past it at a slash; "/" keeps every absolute path (harb's rule)
func CondUnder(tPath, tDir)
	if Len(tDir) = 0 return false end
	if tDir = "/"
		if Len(tPath) = 0 return false end
		return tPath[1] = "/"
	end
	if tPath = tDir return true end
	if Len(tPath) <= Len(tDir) return false end
	if Left(tPath, Len(tDir)) != tDir return false end
	return tPath[Len(tDir) + 1] = "/"
end
# a list of prefixes covers a prefix when their ranges, taken together, hold
# every address of it: sweep the ranges in order of their first address
func CondCovers(xList, tCidr)
	xT = CondCidrRange(tCidr)
	if IsEmpty(xT) return false end
	vR = []
	for i = 1 to Len(xList)
		xR = CondCidrRange(xList[i])
		if not IsEmpty(xR)
			nAt = Len(vR) + 1
			for j = 1 to Len(vR)
				if vR[j][1] > xR[1]
					nAt = j
					exit
				end
			end
			Insert(vR, nAt - 1, xR)
		end
	end
	nCur = xT[1]
	for i = 1 to Len(vR)
		if vR[i][1] <= nCur and vR[i][2] >= nCur
			nCur = vR[i][2] + 1
			if nCur > xT[2] return true end
		end
	end
	return nCur > xT[2]
end
# the references of a list seat, followed through declarations of the same
# kind in the cursor's pool, return to the declaration they started from
func CondCyclic(xC, tSeat)
	tLang = xC[2]
	xDecl = xC[3]
	tDeclName = CondDeclNameIn(tLang, xDecl[1])
	xInfo = CondSeatInfoIn(tLang, tDeclName, tSeat)
	if IsEmpty(xInfo) return false end
	vSeen = []
	return CondReaches(xDecl, tSeat, xDecl[2], tLang, xInfo[2], xC[4], vSeen)
end
func CondReaches(xFrom, tSeat, tStart, tLang, tTargetKind, xPool, vSeen)
	xL = CondListOf(xFrom, tSeat)
	if IsEmpty(xL) return false end
	for i = 1 to Len(xL)
		if xL[i] = tStart return true end
		if CondInList(xL[i], vSeen) loop end
		vSeen + xL[i]
		xT = CondFindIn(tLang, tTargetKind, xL[i], xPool)
		if IsEmpty(xT) loop end
		if CondReaches(xT, tSeat, tStart, tLang, tTargetKind, xPool, vSeen) return true end
	end
	return false
end
