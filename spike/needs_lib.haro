# needs_lib.haro -- D51's declared half in a forged court (Haro v0.40, v40/GRAMMAR.md): the doors a language's worlds may open. Loaded by a
# forged court only where a language it carries NEEDS a door, so every other court keeps its bytes and its cold compile.
#
#   the language entry's 25th element   [[needs, ...], [[verb, word, by seat], ...]]
#
# A kind that OPENS a capability opens that door in each of its declarations; a kind that OPENS a seat opens what that seat lists. The meta-court
# proved the first is NEEDED; the second the court judges here, sentence by sentence (CAPABILITY_NOT_NEEDED). Enforcement is the consumer's: the
# world rows publish what each declaration opens, and Haro claims nothing about a door it does not run.
#
# Functions only; the globals are the generated court's.

# the doors a declaration opens, in the order written; NULL for a kind that opens nothing
func NdOpens(aDoors, aD)
	for i = 1 to Len(aDoors[2])
		if aDoors[2][i][1] != aD[1] loop end
		if not aDoors[2][i][3] return [aDoors[2][i][2]] end
		aOut = []
		for j = 1 to Len(aD[4])
			if aD[4][j][1] != Upper(aDoors[2][i][2]) loop end
			aV = aD[4][j][3]
			if aV[1] = "namelist"
				for k = 1 to Len(aV[2]) aOut + aV[2][k] end
			else
				aOut + aV[2]
			end
		end
		return aOut
	end
	return ""
end
# a declaration whose OPENS seat lists a door the language does not NEED is refused
func NdCheck(aDecls, aDoors)
	for i = 1 to Len(aDecls)
		aD = aDecls[i]
		for k = 1 to Len(aDoors[2])
			if aDoors[2][k][1] != aD[1] or not aDoors[2][k][3] loop end
			for j = 1 to Len(aD[4])
				if aD[4][j][1] != Upper(aDoors[2][k][2]) loop end
				aV = aD[4][j][3]
				aW = []
				if aV[1] = "namelist" aW = aV[2] else aW = [aV[2]] end
				for m = 1 to Len(aW)
					bNeeded = false
					for n = 1 to Len(aDoors[1])
						if aDoors[1][n] = aW[m] bNeeded = true end
					end
					if not bNeeded
						try
							CtFailC(aD[4][j][2], "CAPABILITY_NOT_NEEDED", [], aD[1] + " " + aD[2] + " opens '" + aW[m] + "', and the language " + $tCourtLang + " does not NEED it")
						catch
							CtNote(cCatchError)
						end
					end
				end
			end
		end
	end
end
# the world rows: each declaration of a kind that opens, with what it opens -- [] when it lists nothing
func NdRows(aDecls, aDoors, tFile)
	aRows = []
	for i = 1 to Len(aDecls)
		aD = aDecls[i]
		aO = NdOpens(aDoors, aD)
		if IsEmpty(aO) loop end
		aRows + [ExObjMark(), ["verb", aD[1]], ["name", aD[2]], ["opens", aO], ["span", [ExObjMark(), ["file", tFile], ["line", aD[3]]]]]
	end
	return aRows
end
