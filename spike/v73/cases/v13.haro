load "doors.haro"
sDoors = doors'DEFINE COMMAND show AS (ITSELF yes, TAKES [word, text, text, text]) RATIONALE "this haro, printing what it is given"'
hCall = sDoors.Invocation("show", ["echo.haro", "a", "b", "c"])
try
    hCall.vArgv = ["cmd", "/c", "dir"]
    print "written"
catch e
    print e.Code()
end
print hCall
