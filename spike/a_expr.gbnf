# a_expr.gbnf -- GENERATED by forge.haro from the a declaration (Haro v0.5, grown in v0.6).
# W's shape: or < and < not < comparison < additive < multiplicative < unary < primary;
# each level is present when the declaration admits its operators.

root ::= ws or_expr ws
or_expr ::= and_expr (sp "or" sp and_expr)*
and_expr ::= not_expr (sp "and" sp not_expr)*
not_expr ::= ("not" sp)? comparison
comparison ::= additive (ws cmpop ws additive)?
cmpop ::= ">=" | "<=" | "!=" | "<>" | "=" | ">" | "<"
additive ::= multiplicative (ws ("+" | "-") ws multiplicative)*
multiplicative ::= unary (ws ("*" | "/" | "%") ws unary)*
unary ::= ("-" ws)? primary
primary ::= number | string | aggregate | reference | "ROUND" ws "(" ws or_expr ws ")" | "(" ws or_expr ws ")"
aggregate ::= ("SUM" | "COUNT" | "AVG" | "MIN" | "MAX") ws "(" ws reference ws ")"
reference ::= [a-z_] [a-z0-9_]* ("." [a-z_] [a-z0-9_]*)*
number ::= [0-9]+ ("." [0-9]+)?
string ::= "'" [^']* "'" | "\"" [^"]* "\""
sp ::= [ \t]+
ws ::= [ \t]*
