# pattern_judge.haro -- a court judges the PATTERNs of its language (Haro v0.32; BLOCKS.md 4.3).
#
# The generated court loads this file, with pattern_lib.haro, only where a language it carries declares a PATTERN -- as expr_lib.haro
# rides along only for an EXPRESSION -- so the court library every court loads does not grow for a language that has none (HF-49,
# D42). CtDeclare calls CtCheckPatterns when the language entry has a 24th element. Functions only.

# v0.32: the PATTERNs of the language (the language entry's 24th element; a court whose language declares none is not here), each on every
# declaration of its OVER kind that writes the seat: the value AS WRITTEN, read by the one LOAD and matched by the pattern engine
# (pattern_lib.haro, which the generated court loads only for such a language). The sets MEMBER draws from are collected here, from the
# sentence's own declarations and the language's menus -- data, never code. A seat the sentence does not write is not judged. The
# finding stands at the line of the seat's clause, and it refuses, or warns, as a CONSTRAINT's does
func CtCheckPatterns(xDecls, tSrc)
	xE = CtLangEntry($tCourtLang)
	if IsEmpty(xE) return end
	if Len(xE) < 24 return end
	xPats = xE[24]
	xNames = []
	vTexts = []
	vSetN = []
	vSetM = []
	for i = 1 to Len(xPats)
		xNames + xPats[i][1]
		vTexts + xPats[i][4]
		for j = 1 to Len(xPats[i][5])
			vSetN + xPats[i][5][j][3]
			vSetM + CtSetMembers(xDecls, xPats[i][5][j][1], xPats[i][5][j][2])
		end
	end
	for i = 1 to Len($xCourtMenus)
		vSetN + $xCourtMenus[i][1]
		vSetM + $xCourtMenus[i][2]
	end
	PatDeclare(xNames, vTexts, vSetN, vSetM)
	for i = 1 to Len(xPats)
		xP = xPats[i]
		xK = CtKindByDeclName(xP[2])
		if IsEmpty(xK) loop end
		tClause = Upper(xP[3])
		for j = 1 to Len(xDecls)
			xD = xDecls[j]
			if xD[1] != xK[1] loop end
			if CtIsBroken(j) loop end
			xCl = CtClauseNamed(xD, tClause)
			if IsEmpty(xCl) loop end
			tText = SubStr(tSrc, xCl[3][3], xCl[3][4] - xCl[3][3])
			bHolds = false
			try
				xR = PatRun(xP[1], tText)
				bHolds = xR[1]
			catch
				bHolds = false
			end
			if bHolds loop end
			xCC = CtElementCode(xP[8], "PATTERN", xP[1])
			if IsString(xP[9])
				xCC[2] = []
			elseif Len(xP[9]) > 0
				xCC[2] = xP[9]
			end
			if xP[10] = "warning"
				$vCourtWarnings + [xCC[1], xCC[2], xCl[2], CtFill(xP[6], xD, "")]
			else
				try
					CtFailC(xCl[2], xCC[1], xCC[2], CtFill(xP[6], xD, ""))
				catch
					CtNote(cCatchError)
				end
			end
		end
	end
end
func CtClauseNamed(xD, tClause)
	for i = 1 to Len(xD[4])
		if xD[4][i][1] = tClause return xD[4][i] end
	end
	return ""
end
# the values of a seat across every declaration of a kind: a word, a string or a number is one, a list its items (a list of pairs is refused by the meta-court)
func CtSetMembers(xDecls, tDecl, tSeat)
	xOut = []
	xK = CtKindByDeclName(tDecl)
	if IsEmpty(xK) return xOut end
	tClause = Upper(tSeat)
	for j = 1 to Len(xDecls)
		if xDecls[j][1] != xK[1] loop end
		if CtIsBroken(j) loop end
		xCl = CtClauseNamed(xDecls[j], tClause)
		if IsEmpty(xCl) loop end
		tShape = xCl[3][1]
		xPay = xCl[3][2]
		if tShape = "word" or tShape = "string" or tShape = "number"
			xOut + xPay
		else
			for k = 1 to Len(xPay)
				xOut + xPay[k]
			end
		end
	end
	return xOut
end
