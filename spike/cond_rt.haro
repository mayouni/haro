# cond_rt.haro -- the round trip of the condition printer (Haro v0.33), in one process:
#
#   haro cond_rt.haro <file>        one condition a line; for each, parse -> print -> parse must give the same tree, and print -> parse -> print the same text
#
# A line is `ok <the canonical text>` when the printer loses nothing a second reading can see, `DIFFERS <condition> => <printed>` when it does, and
# `unreadable <condition>` when the condition language refuses the text (a condition written to be refused). The meta-court prints a condition back only
# where it expanded a quantifier over a FORM, so the printer is a risk only there; this court proves it on every condition the repository holds.

load "cond_lib.haro"
load "form_expand.haro"

$aCondToks = []
$nCondPos = 1

if Len(sysargv) < 3
	? "usage: cond_rt.haro <file>"
else
	CondRtRun(Read(sysargv[3]))
ok

func CondRtRun(tBody)
	aLines = Str2List(tBody)
	for i = 1 to Len(aLines)
		tLine = aLines[i]
		if Len(tLine) > 0 and tLine[Len(tLine)] = Char(13) tLine = Left(tLine, Len(tLine) - 1) ok
		if Len(tLine) = 0 loop ok
		tOne = ""
		try
			aA = CondParse(tLine)
			tP = CondPrint(aA)
			aB = CondParse(tP)
			tP2 = CondPrint(aB)
			if CondDump(aA) = CondDump(aB) and tP = tP2
				tOne = "ok " + tP
			else
				tOne = "DIFFERS " + tLine + " => " + tP
			ok
		catch
			tOne = "unreadable " + tLine
		done
		? tOne
	next
