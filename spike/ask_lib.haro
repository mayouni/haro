# ask_lib.haro -- the Q letter: a declared language's question grammar, judged
# and answered (Haro v0.7), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds an ASK loads this file
# beside court_lib.haro and expr_lib.haro, and carries the ASK as
# $aCourtAsk = [name, from kinds, where expression, clauses] (v0.34: a fifth, FIELDS seat.seat, where a language declares one). The question
# grammar is ZQL's SELECT (StzZql GRAMMAR.md 6; zing cli/src/zql.zig
# parseQuery and query_cmd.zig), the one question shape the estate pins:
#
#   SELECT * FROM name [WHERE expr] [ORDER BY field [ASC | DESC]] [LIMIT n]
#
# FROM names a declaration of one of the ASK's kinds (a name that resolves
# to nothing is refused here, where zing answers no rows -- HF-51). WHERE is
# written in the ASK's expression and must be a CONDITION: a comparison,
# and, or, not, a flag; an arithmetic node has no boolean meaning (zql.zig
# evalExpr), and zing refuses "WHERE amount" as well. ORDER BY orders by a
# field of the records: numeric when both can be numbers, by bytes
# otherwise, a missing field first (zql.zig orderValues), ties in the
# records' own order. LIMIT keeps the first n. The keywords are the
# upper-case words, as zing reads them; a lower-case `order` is a field.
# The clauses the ASK does not admit (CLAUSES) are refused by name.
#
#   <court>.ring ask <file> "<question>" <rows json>
#
# answers the matching records as a JSON list, in order. The rows are the
# harness's: the declared altitude holds no store, so the records that
# walked the FROM declaration are handed in, as zing hands its ledger's. A
# question never writes.
#
# Functions only; the globals are the generated court's.

func AskIsSpace(tC)
	return tC = " " or tC = Char(9) or tC = Char(13) or tC = Char(10)

# the word starting at i is exactly cKw, bounded by the text's edges or spaces
func AskWordAt(tQ, nI, tKw)
	nN = Len(tKw)
	if nI + nN - 1 > Len(tQ) return false ok
	if SubStr(tQ, nI, nN) != tKw return false ok
	if nI > 1 and not AskIsSpace(tQ[nI - 1]) return false ok
	if nI + nN <= Len(tQ) and not AskIsSpace(tQ[nI + nN]) return false ok
	return true

func AskTrim(tS)
	nI = 1
	nJ = Len(tS)
	while nI <= nJ and AskIsSpace(tS[nI])
		nI++
	end
	while nJ >= nI and AskIsSpace(tS[nJ])
		nJ--
	end
	if nJ < nI return "" ok
	return SubStr(tS, nI, nJ - nI + 1)

# the words of a text, split on spaces
func AskWords(tS)
	aW = []
	tCur = ""
	for i = 1 to Len(tS)
		if AskIsSpace(tS[i])
			if tCur != "" aW + tCur ok
			tCur = ""
		else
			tCur += tS[i]
		ok
	next
	if tCur != "" aW + tCur ok
	return aW

func AskIsName(tW)
	if Len(tW) = 0 return false ok
	for i = 1 to Len(tW)
		if not (CtIsLowerish(tW[i]) or CtIsDigit(tW[i]) or tW[i] = "_") return false ok
	next
	return true

func AskIsField(tW)
	if Len(tW) = 0 return false ok
	for i = 1 to Len(tW)
		if not (CtIsLowerish(tW[i]) or CtIsDigit(tW[i]) or tW[i] = "_" or tW[i] = ".") return false ok
	next
	return true

func AskIsNumber(tW)
	if Len(tW) = 0 return false ok
	for i = 1 to Len(tW)
		if not CtIsDigit(tW[i]) return false ok
	next
	return true

func AskFail(tMsg)
	CtFail(1, tMsg)

# the parsed question: [from, where node or NULL, order field, descending, limit or -1]
func AskParse(aDecls, tQ)
	aAsk = $aCourtAsk
	if IsNull(aAsk) AskFail("this language declares no ASK, so it answers no question") ok
	nN = Len(tQ)
	# the frame keywords, at depth 0 and outside quotes
	nWhere = 0
	nOrder = 0
	nLimit = 0
	nI = 1
	nDepth = 0
	tQuote = ""
	while nI <= nN
		tC = tQ[nI]
		if tQuote != ""
			if tC = tQuote tQuote = "" ok
			nI++
			loop
		ok
		if tC = "'" or tC = '"'
			tQuote = tC
			nI++
			loop
		ok
		if tC = "(" nDepth++ ok
		if tC = ")" nDepth-- ok
		if nDepth = 0 and (nI = 1 or AskIsSpace(tQ[nI - 1]))
			if nWhere = 0 and AskWordAt(tQ, nI, "WHERE") nWhere = nI ok
			if nOrder = 0 and AskWordAt(tQ, nI, "ORDER") nOrder = nI ok
			if nLimit = 0 and AskWordAt(tQ, nI, "LIMIT") nLimit = nI ok
		ok
		nI++
	end
	# the segments, in textual order
	aSeg = []
	if nWhere > 0 aSeg + [nWhere, "WHERE"] ok
	if nOrder > 0 aSeg + [nOrder, "ORDER"] ok
	if nLimit > 0 aSeg + [nLimit, "LIMIT"] ok
	for a = 1 to Len(aSeg)
		for b = a + 1 to Len(aSeg)
			if aSeg[b][1] < aSeg[a][1]
				aT = aSeg[a]
				aSeg[a] = aSeg[b]
				aSeg[b] = aT
			ok
		next
	next
	nHeadEnd = nN + 1
	if Len(aSeg) > 0 nHeadEnd = aSeg[1][1] ok
	tHead = ""
	if nHeadEnd > 1 tHead = AskTrim(SubStr(tQ, 1, nHeadEnd - 1)) ok
	aW = AskWords(tHead)
	if Len(aW) = 0 or aW[1] != "SELECT"
		tVerb = ""
		if Len(aW) > 0 tVerb = aW[1] ok
		tMsg = CtRefusalMessage("unknown_verb")
		if tMsg = "" tMsg = "a question opens with SELECT" ok
		AskFail("Unknown verb '" + tVerb + "': " + tMsg)
	ok
	if Len(aW) < 2 or aW[2] != "*"
		tFound = ""
		if Len(aW) >= 2 tFound = aW[2] ok
		AskFail("Expected '*' after SELECT: a question asks for whole records (SELECT * only), found '" + tFound + "'")
	ok
	if Len(aW) < 3 or aW[3] != "FROM"
		tFound = ""
		if Len(aW) >= 3 tFound = aW[3] ok
		AskFail("Expected FROM after SELECT *, found '" + tFound + "'")
	ok
	if Len(aW) < 4 AskFail("Expected a name after FROM") ok
	tFrom = aW[4]
	if not AskIsName(tFrom) AskFail("FROM takes a lower_snake name, found '" + tFrom + "'") ok
	if Len(aW) > 4 AskFail("Unexpected '" + aW[5] + "' after the question") ok
	# FROM resolves to a declaration of one of the ASK's kinds
	aVerbs = []
	aFromDecl = null
	for k = 1 to Len(aAsk[2])
		aK = CtKindByDeclName(aAsk[2][k])
		if IsNull(aK) loop ok
		aVerbs + aK[1]
		for d = 1 to Len(aDecls)
			if aDecls[d][1] = aK[1] and aDecls[d][2] = tFrom aFromDecl = aDecls[d] ok
		next
	next
	if IsNull(aFromDecl)
		tMsg = CtRefusalMessage("dangling_reference")
		tOut = "FROM '" + tFrom + "' resolves to nothing: no such " + CtJoin(aVerbs, " or ")
		if tMsg != "" tOut += " -- " + tMsg ok
		AskFail(tOut)
	ok
	aWhere = null
	tField = ""
	bDesc = false
	nLim = -1
	nSeen = 0
	for s = 1 to Len(aSeg)
		nStart = aSeg[s][1]
		nEnd = nN
		if s < Len(aSeg) nEnd = aSeg[s + 1][1] - 1 ok
		tText = AskTrim(SubStr(tQ, nStart, nEnd - nStart + 1))
		tKind = aSeg[s][2]
		nRank = 1
		if tKind = "ORDER" nRank = 2 ok
		if tKind = "LIMIT" nRank = 3 ok
		if nRank <= nSeen AskFail("Unexpected '" + tKind + "' after the question") ok
		nSeen = nRank
		if not CtInList(Lower(tKind), aAsk[4])
			AskFail(tKind + " is not a clause of " + aAsk[1] + " (its clauses: " + CtJoin(aAsk[4], ", ") + ")")
		ok
		if tKind = "WHERE"
			tExpr = AskTrim(SubStr(tText, 6))
			aE = CtExprByName(aAsk[3])
			if IsNull(aE) AskFail("the court carries no EXPRESSION called '" + aAsk[3] + "'") ok
			CtExprUse(aE)
			tErr = ""
			try
				aWhere = ExParse(tExpr, [])
			catch
				tErr = cCatchError
			done
			if tErr != "" AskFail("WHERE: " + tErr) ok
			if not ExIsCondition(aWhere)
				AskFail("WHERE is not a condition: a comparison, and, or, not -- '" + tExpr + "' computes a value")
			ok
		but tKind = "ORDER"
			aOW = AskWords(tText)
			if Len(aOW) < 2 or aOW[2] != "BY" AskFail("Expected BY after ORDER") ok
			if Len(aOW) < 3 AskFail("Expected a field after ORDER BY") ok
			tField = aOW[3]
			if not AskIsField(tField) AskFail("ORDER BY takes a field name, found '" + tField + "'") ok
			if Len(aOW) >= 4
				if aOW[4] = "DESC"
					bDesc = true
				but aOW[4] = "ASC"
					bDesc = false
				else
					AskFail("Unexpected '" + aOW[4] + "' after the question")
				ok
			ok
			if Len(aOW) > 4 AskFail("Unexpected '" + aOW[5] + "' after the question") ok
		else
			aLW = AskWords(tText)
			if Len(aLW) < 2 AskFail("Expected a number after LIMIT") ok
			if not AskIsNumber(aLW[2]) AskFail("LIMIT takes a number, found '" + aLW[2] + "'") ok
			nLim = Number(aLW[2])
			if Len(aLW) > 2 AskFail("Unexpected '" + String(aLW[3]) + "' after the question") ok
		ok
	next
	AskCheckFields(aDecls, aFromDecl, aWhere, tField)
	return [tFrom, aWhere, tField, bDesc, nLim]

# v0.34 (COMPASS-KERN-03): the field names a question may use for a declaration, read from the schema the language declares (the ASK's FIELDS
# seat.seat) -- the keys of that pair list in the declaration the first seat refers to, then the names the walk's steps COMPUTE into a record of
# the declaration. [] when no schema is declared (the language has no FIELDS, or this declaration does not write the seat): a missing field is
# then missing, as zing reads it, and nothing is checked. NULL is never returned.
func AskSchemaNames(aDecls, aFromDecl)
	aAsk = $aCourtAsk
	if Len(aAsk) < 5 return [] ok
	nDot = SubStr(aAsk[5], ".")
	tSeat1 = Upper(Left(aAsk[5], nDot - 1))
	tSeat2 = Upper(SubStr(aAsk[5], nDot + 1))
	tEntity = ""
	aC = aFromDecl[4]
	for i = 1 to Len(aC)
		if aC[i][1] = tSeat1 tEntity = aC[i][3][2] ok
	next
	if tEntity = "" return [] ok
	aNames = []
	for d = 1 to Len(aDecls)
		if aDecls[d][2] != tEntity loop ok
		aEC = aDecls[d][4]
		for i = 1 to Len(aEC)
			if aEC[i][1] != tSeat2 or aEC[i][3][1] != "pairlist" loop ok
			aItems = aEC[i][3][2]
			for j = 1 to Len(aItems)
				if not CtInList(aItems[j][1], aNames) aNames + aItems[j][1] ok
			next
		next
	next
	# what the steps of the flow compute into its records: a record of the flow has the name, as zing overlays a computed value by name
	for w = 1 to Len($aCourtWalks)
		aKS = CtKindByDeclName($aCourtWalks[w][3])
		if IsNull(aKS) loop ok
		tThr = Upper($aCourtWalks[w][4])
		tCmp = Upper($aCourtWalks[w][7])
		if tCmp = "" loop ok
		for d = 1 to Len(aDecls)
			if aDecls[d][1] != aKS[1] loop ok
			bThis = false
			tComputed = ""
			aSC = aDecls[d][4]
			for i = 1 to Len(aSC)
				if aSC[i][1] = tThr and aSC[i][3][2] = aFromDecl[2] bThis = true ok
				if aSC[i][1] = tCmp tComputed = aSC[i][3][2] ok
			next
			if bThis and tComputed != "" and not CtInList(tComputed, aNames) aNames + tComputed ok
		next
	next
	return aNames

# every field a condition names, in the order the text names them
func AskRefsOf(aNode)
	if not IsList(aNode) return false ok
	if Len(aNode) = 0 or not IsString(aNode[1]) return false ok
	if aNode[1] = "ref" and Len(aNode) >= 2
		$aAskRefsFound + aNode[2]
		return false
	ok
	if aNode[1] = "agg" and Len(aNode) >= 3
		$aAskRefsFound + aNode[3]
		return false
	ok
	for i = 2 to Len(aNode)
		AskRefsOf(aNode[i])
	next

# the head of a dotted name: member.first names member
func AskHead(tPath)
	nDot = SubStr(tPath, ".")
	if nDot = 0 return tPath ok
	return Left(tPath, nDot - 1)

func AskCheckFields(aDecls, aFromDecl, aWhere, tField)
	aNames = AskSchemaNames(aDecls, aFromDecl)
	if Len(aNames) = 0 return ok
	$aAskRefsFound = []
	AskRefsOf(aWhere)
	aRefs = $aAskRefsFound
	for i = 1 to Len(aRefs)
		if not CtInList(AskHead(aRefs[i]), aNames) AskFieldFail("WHERE", AskHead(aRefs[i]), aFromDecl[2], aNames) ok
	next
	if tField != "" and not CtInList(AskHead(tField), aNames) AskFieldFail("ORDER BY", AskHead(tField), aFromDecl[2], aNames) ok

func AskFieldFail(tClause, tName, tDecl, aNames)
	tOut = tClause + " names '" + tName + "', which " + tDecl + " does not declare (its fields: " + CtJoin(aNames, ", ") + ")"
	tMsg = CtRefusalMessage("unknown_seat")
	if tMsg != "" tOut += " -- " + tMsg ok
	AskFail(tOut)

# the order of two records on a field: -1, 0, 1 (zql.zig orderValues)
func AskOrder(aA, aB, tField)
	ExSetRecord(aA)
	xVa = ExRefGet(tField)
	ExSetRecord(aB)
	xVb = ExRefGet(tField)
	if not xVa[1] and not xVb[1] return 0 ok
	if not xVa[1] return -1 ok
	if not xVb[1] return 1 ok
	xNa = ExNumOf(xVa[2])
	xNb = ExNumOf(xVb[2])
	if xNa[1] and xNb[1]
		if xNa[2] < xNb[2] return -1 ok
		if xNa[2] > xNb[2] return 1 ok
		return 0
	ok
	return ExStrOrder(ExStr(xVa[2]), ExStr(xVb[2]))

# v0.16: what a question did, recorded as it ran and only when a narration asked: [event, [[key, text], ...]]
func AskNote(tEvent, aVals)
	$aAskTrace + [tEvent, aVals]

func AskRun(aDecls, tQ, aRows)
	aQ = AskParse(aDecls, tQ)
	if not IsList(aRows) or ExIsObj(aRows) AskFail("the rows are a JSON list of records") ok
	if $bAskTrace AskNote("ask", [["question", tQ], ["from", aQ[1]]]) ok
	aOut = []
	for i = 1 to Len(aRows)
		if not ExIsObj(aRows[i]) AskFail("row " + String(i) + " is not a JSON object") ok
		if not IsNull(aQ[2])
			ExSetRecord(aRows[i])
			if not ExBool(aQ[2], []) loop ok
		ok
		aOut + aRows[i]
	next
	if $bAskTrace AskNote("matched", [["count", String(Len(aOut))], ["total", String(Len(aRows))], ["from", aQ[1]]]) ok
	if aQ[3] != ""
		# a stable insertion: a record goes after every one it does not precede
		aSorted = []
		for i = 1 to Len(aOut)
			nAt = Len(aSorted) + 1
			for j = 1 to Len(aSorted)
				nCmp = AskOrder(aOut[i], aSorted[j], aQ[3])
				if aQ[4] nCmp = -nCmp ok
				if nCmp < 0
					nAt = j
					exit
				ok
			next
			if nAt > Len(aSorted)
				aSorted + aOut[i]
			else
				# Ring's insert() puts the item AFTER the index: before j is after j-1 (HF-52)
				Insert(aSorted, nAt - 1, aOut[i])
			ok
		next
		aOut = aSorted
	ok
	if $bAskTrace and aQ[3] != ""
		tDir = "ASC"
		if aQ[4] tDir = "DESC" ok
		AskNote("ordered", [["field", aQ[3]], ["direction", tDir]])
	ok
	if aQ[5] >= 0 and Len(aOut) > aQ[5]
		# told only when the limit DROPPED rows: "only the first 5 are kept" over three matches would be untrue
		if $bAskTrace AskNote("cut", [["limit", String(aQ[5])], ["dropped", String(Len(aOut) - aQ[5])], ["count", String(aQ[5])]]) ok
		aCut = []
		for i = 1 to aQ[5]
			aCut + aOut[i]
		next
		aOut = aCut
	ok
	# v0.27: the rows themselves, not their JSON -- the voice renders them, redacted under its safeguard
	if $bAskTrace AskNote("answer", [["count", String(Len(aOut))], ["rows", aOut]]) ok
	return aOut
