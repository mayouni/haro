# ask_lib.haro -- the Q letter: a declared language's question grammar, judged
# and answered (Haro v0.7), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds an ASK loads this file
# beside court_lib.haro and expr_lib.haro, and carries the ASK as
# $aCourtAsk = [name, from kinds, where expression, clauses] (v0.34: a fifth, FIELDS seat.seat, where a language declares one). The question
# grammar is ZQL's SELECT (StzZql GRAMMAR.md 6; zing cli/src/zql.zig
# parseQuery and query_cmd.zig), the one question shape the estate pins:
#
#   SELECT * FROM name [WHERE expr] [ORDER BY field [ASC | DESC]] [LIMIT n]
#
# FROM names a declaration of one of the ASK's kinds (a name that resolves
# to nothing is refused here, where zing answers no rows -- HF-51). WHERE is
# written in the ASK's expression and must be a CONDITION: a comparison,
# and, or, not, a flag; an arithmetic node has no boolean meaning (zql.zig
# evalExpr), and zing refuses "WHERE amount" as well. ORDER BY orders by a
# field of the records: numeric when both can be numbers, by bytes
# otherwise, a missing field first (zql.zig orderValues), ties in the
# records' own order. LIMIT keeps the first n. The keywords are the
# upper-case words, as zing reads them; a lower-case `order` is a field.
# The clauses the ASK does not admit (CLAUSES) are refused by name.
#
#   <court>.ring ask <file> "<question>" <rows json>
#
# answers the matching records as a JSON list, in order. The rows are the
# harness's: the declared altitude holds no store, so the records that
# walked the FROM declaration are handed in, as zing hands its ledger's. A
# question never writes.
#
# Functions only; the globals are the generated court's.

func AskIsSpace(tC)
	return tC = " " or tC = Char(9) or tC = Char(13) or tC = Char(10)
end
# the word starting at i is exactly cKw, bounded by the text's edges or spaces
func AskWordAt(tQ, nI, tKw)
	nN = Len(tKw)
	if nI + nN - 1 > Len(tQ) return false end
	if SubStr(tQ, nI, nN) != tKw return false end
	if nI > 1 and not AskIsSpace(tQ[nI - 1]) return false end
	if nI + nN <= Len(tQ) and not AskIsSpace(tQ[nI + nN]) return false end
	return true
end
func AskTrim(tS)
	nI = 1
	nJ = Len(tS)
	while nI <= nJ and AskIsSpace(tS[nI])
		nI++
	end
	while nJ >= nI and AskIsSpace(tS[nJ])
		nJ--
	end
	if nJ < nI return "" end
	return SubStr(tS, nI, nJ - nI + 1)
end
# the words of a text, split on spaces
func AskWords(tS)
	xW = []
	tCur = ""
	for i = 1 to Len(tS)
		if AskIsSpace(tS[i])
			if tCur != "" xW + tCur end
			tCur = ""
		else
			tCur += tS[i]
		end
	end
	if tCur != "" xW + tCur end
	return xW
end
func AskIsName(tW)
	if Len(tW) = 0 return false end
	for i = 1 to Len(tW)
		if not (CtIsLowerish(tW[i]) or CtIsDigit(tW[i]) or tW[i] = "_") return false end
	end
	return true
end
func AskIsField(tW)
	if Len(tW) = 0 return false end
	for i = 1 to Len(tW)
		if not (CtIsLowerish(tW[i]) or CtIsDigit(tW[i]) or tW[i] = "_" or tW[i] = ".") return false end
	end
	return true
end
func AskIsNumber(tW)
	if Len(tW) = 0 return false end
	for i = 1 to Len(tW)
		if not CtIsDigit(tW[i]) return false end
	end
	return true
end
func AskFail(tMsg)
	CtFail(1, tMsg)
end
# the parsed question: [from, where node or NULL, order field, descending, limit or -1]
func AskParse(xDecls, tQ)
	xAsk = $xCourtAsk
	if IsEmpty(xAsk) AskFail("this language declares no ASK, so it answers no question") end
	nN = Len(tQ)
	# the frame keywords, at depth 0 and outside quotes
	nWhere = 0
	nOrder = 0
	nLimit = 0
	nI = 1
	nDepth = 0
	tQuote = ""
	while nI <= nN
		tC = tQ[nI]
		if tQuote != ""
			if tC = tQuote tQuote = "" end
			nI++
			loop
		end
		if tC = "'" or tC = '"'
			tQuote = tC
			nI++
			loop
		end
		if tC = "(" nDepth++ end
		if tC = ")" nDepth-- end
		if nDepth = 0 and (nI = 1 or AskIsSpace(tQ[nI - 1]))
			if nWhere = 0 and AskWordAt(tQ, nI, "WHERE") nWhere = nI end
			if nOrder = 0 and AskWordAt(tQ, nI, "ORDER") nOrder = nI end
			if nLimit = 0 and AskWordAt(tQ, nI, "LIMIT") nLimit = nI end
		end
		nI++
	end
	# the segments, in textual order
	vSeg = []
	if nWhere > 0 vSeg + [nWhere, "WHERE"] end
	if nOrder > 0 vSeg + [nOrder, "ORDER"] end
	if nLimit > 0 vSeg + [nLimit, "LIMIT"] end
	for a = 1 to Len(vSeg)
		for b = a + 1 to Len(vSeg)
			if vSeg[b][1] < vSeg[a][1]
				xT = vSeg[a]
				vSeg[a] = vSeg[b]
				vSeg[b] = xT
			end
		end
	end
	nHeadEnd = nN + 1
	if Len(vSeg) > 0 nHeadEnd = vSeg[1][1] end
	tHead = ""
	if nHeadEnd > 1 tHead = AskTrim(SubStr(tQ, 1, nHeadEnd - 1)) end
	xW = AskWords(tHead)
	if Len(xW) = 0 or xW[1] != "SELECT"
		tVerb = ""
		if Len(xW) > 0 tVerb = xW[1] end
		tMsg = CtRefusalMessage("unknown_verb")
		if tMsg = "" tMsg = "a question opens with SELECT" end
		AskFail("Unknown verb '" + tVerb + "': " + tMsg)
	end
	if Len(xW) < 2 or xW[2] != "*"
		tFound = ""
		if Len(xW) >= 2 tFound = xW[2] end
		AskFail("Expected '*' after SELECT: a question asks for whole records (SELECT * only), found '" + tFound + "'")
	end
	if Len(xW) < 3 or xW[3] != "FROM"
		tFound = ""
		if Len(xW) >= 3 tFound = xW[3] end
		AskFail("Expected FROM after SELECT *, found '" + tFound + "'")
	end
	if Len(xW) < 4 AskFail("Expected a name after FROM") end
	tFrom = xW[4]
	if not AskIsName(tFrom) AskFail("FROM takes a lower_snake name, found '" + tFrom + "'") end
	if Len(xW) > 4 AskFail("Unexpected '" + xW[5] + "' after the question") end
	# FROM resolves to a declaration of one of the ASK's kinds
	vVerbs = []
	xFromDecl = ""
	for k = 1 to Len(xAsk[2])
		xK = CtKindByDeclName(xAsk[2][k])
		if IsEmpty(xK) loop end
		vVerbs + xK[1]
		for d = 1 to Len(xDecls)
			if xDecls[d][1] = xK[1] and xDecls[d][2] = tFrom xFromDecl = xDecls[d] end
		end
	end
	if IsEmpty(xFromDecl)
		tMsg = CtRefusalMessage("dangling_reference")
		tOut = "FROM '" + tFrom + "' resolves to nothing: no such " + CtJoin(vVerbs, " or ")
		if tMsg != "" tOut += " -- " + tMsg end
		AskFail(tOut)
	end
	xWhere = ""
	tField = ""
	bDesc = false
	nLim = -1
	nSeen = 0
	for s = 1 to Len(vSeg)
		nStart = vSeg[s][1]
		nEnd = nN
		if s < Len(vSeg) nEnd = vSeg[s + 1][1] - 1 end
		tText = AskTrim(SubStr(tQ, nStart, nEnd - nStart + 1))
		tKind = vSeg[s][2]
		nRank = 1
		if tKind = "ORDER" nRank = 2 end
		if tKind = "LIMIT" nRank = 3 end
		if nRank <= nSeen AskFail("Unexpected '" + tKind + "' after the question") end
		nSeen = nRank
		if not CtInList(Lower(tKind), xAsk[4])
			AskFail(tKind + " is not a clause of " + xAsk[1] + " (its clauses: " + CtJoin(xAsk[4], ", ") + ")")
		end
		if tKind = "WHERE"
			tExpr = AskTrim(SubStr(tText, 6))
			xE = CtExprByName(xAsk[3])
			if IsEmpty(xE) AskFail("the court carries no EXPRESSION called '" + xAsk[3] + "'") end
			CtExprUse(xE)
			tErr = ""
			try
				xWhere = ExParse(tExpr, [])
			catch
				tErr = cCatchError
			end
			if tErr != "" AskFail("WHERE: " + tErr) end
			if not ExIsCondition(xWhere)
				AskFail("WHERE is not a condition: a comparison, and, or, not -- '" + tExpr + "' computes a value")
			end
		elseif tKind = "ORDER"
			xOW = AskWords(tText)
			if Len(xOW) < 2 or xOW[2] != "BY" AskFail("Expected BY after ORDER") end
			if Len(xOW) < 3 AskFail("Expected a field after ORDER BY") end
			tField = xOW[3]
			if not AskIsField(tField) AskFail("ORDER BY takes a field name, found '" + tField + "'") end
			if Len(xOW) >= 4
				if xOW[4] = "DESC"
					bDesc = true
				elseif xOW[4] = "ASC"
					bDesc = false
				else
					AskFail("Unexpected '" + xOW[4] + "' after the question")
				end
			end
			if Len(xOW) > 4 AskFail("Unexpected '" + xOW[5] + "' after the question") end
		else
			xLW = AskWords(tText)
			if Len(xLW) < 2 AskFail("Expected a number after LIMIT") end
			if not AskIsNumber(xLW[2]) AskFail("LIMIT takes a number, found '" + xLW[2] + "'") end
			nLim = Number(xLW[2])
			if Len(xLW) > 2 AskFail("Unexpected '" + String(xLW[3]) + "' after the question") end
		end
	end
	AskCheckFields(xDecls, xFromDecl, xWhere, tField)
	return [tFrom, xWhere, tField, bDesc, nLim]
end
# v0.34 (COMPASS-KERN-03): the field names a question may use for a declaration, read from the schema the language declares (the ASK's FIELDS
# seat.seat) -- the keys of that pair list in the declaration the first seat refers to, then the names the walk's steps COMPUTE into a record of
# the declaration. [] when no schema is declared (the language has no FIELDS, or this declaration does not write the seat): a missing field is
# then missing, as zing reads it, and nothing is checked. NULL is never returned.
func AskSchemaNames(xDecls, xFromDecl)
	xAsk = $xCourtAsk
	if Len(xAsk) < 5 return [] end
	nDot = SubStr(xAsk[5], ".")
	tSeat1 = Upper(Left(xAsk[5], nDot - 1))
	tSeat2 = Upper(SubStr(xAsk[5], nDot + 1))
	tEntity = ""
	xC = xFromDecl[4]
	for i = 1 to Len(xC)
		if xC[i][1] = tSeat1 tEntity = xC[i][3][2] end
	end
	if tEntity = "" return [] end
	xNames = []
	for d = 1 to Len(xDecls)
		if xDecls[d][2] != tEntity loop end
		xEC = xDecls[d][4]
		for i = 1 to Len(xEC)
			if xEC[i][1] != tSeat2 or xEC[i][3][1] != "pairlist" loop end
			xItems = xEC[i][3][2]
			for j = 1 to Len(xItems)
				if not CtInList(xItems[j][1], xNames) xNames + xItems[j][1] end
			end
		end
	end
	# what the steps of the flow compute into its records: a record of the flow has the name, as zing overlays a computed value by name
	for w = 1 to Len($xCourtWalks)
		xKS = CtKindByDeclName($xCourtWalks[w][3])
		if IsEmpty(xKS) loop end
		tThr = Upper($xCourtWalks[w][4])
		tCmp = Upper($xCourtWalks[w][7])
		if tCmp = "" loop end
		for d = 1 to Len(xDecls)
			if xDecls[d][1] != xKS[1] loop end
			bThis = false
			tComputed = ""
			xSC = xDecls[d][4]
			for i = 1 to Len(xSC)
				if xSC[i][1] = tThr and xSC[i][3][2] = xFromDecl[2] bThis = true end
				if xSC[i][1] = tCmp tComputed = xSC[i][3][2] end
			end
			if bThis and tComputed != "" and not CtInList(tComputed, xNames) xNames + tComputed end
		end
	end
	return xNames
end
# every field a condition names, in the order the text names them
func AskRefsOf(xNode)
	if not IsList(xNode) return false end
	if Len(xNode) = 0 or not IsString(xNode[1]) return false end
	if xNode[1] = "ref" and Len(xNode) >= 2
		$vAskRefsFound + xNode[2]
		return false
	end
	if xNode[1] = "agg" and Len(xNode) >= 3
		$vAskRefsFound + xNode[3]
		return false
	end
	for i = 2 to Len(xNode)
		AskRefsOf(xNode[i])
	end
end
# the head of a dotted name: member.first names member
func AskHead(tPath)
	nDot = SubStr(tPath, ".")
	if nDot = 0 return tPath end
	return Left(tPath, nDot - 1)
end
func AskCheckFields(xDecls, xFromDecl, xWhere, tField)
	xNames = AskSchemaNames(xDecls, xFromDecl)
	if Len(xNames) = 0 return end
	$vAskRefsFound = []
	AskRefsOf(xWhere)
	xRefs = $vAskRefsFound
	for i = 1 to Len(xRefs)
		if not CtInList(AskHead(xRefs[i]), xNames) AskFieldFail("WHERE", AskHead(xRefs[i]), xFromDecl[2], xNames) end
	end
	if tField != "" and not CtInList(AskHead(tField), xNames) AskFieldFail("ORDER BY", AskHead(tField), xFromDecl[2], xNames) end
end
func AskFieldFail(tClause, tName, tDecl, xNames)
	tOut = tClause + " names '" + tName + "', which " + tDecl + " does not declare (its fields: " + CtJoin(xNames, ", ") + ")"
	tMsg = CtRefusalMessage("unknown_seat")
	if tMsg != "" tOut += " -- " + tMsg end
	AskFail(tOut)
end
# the order of two records on a field: -1, 0, 1 (zql.zig orderValues)
func AskOrder(xA, xB, tField)
	ExSetRecord(xA)
	xVa = ExRefGet(tField)
	ExSetRecord(xB)
	xVb = ExRefGet(tField)
	if not xVa[1] and not xVb[1] return 0 end
	if not xVa[1] return -1 end
	if not xVb[1] return 1 end
	xNa = ExNumOf(xVa[2])
	xNb = ExNumOf(xVb[2])
	if xNa[1] and xNb[1]
		if xNa[2] < xNb[2] return -1 end
		if xNa[2] > xNb[2] return 1 end
		return 0
	end
	return ExStrOrder(ExStr(xVa[2]), ExStr(xVb[2]))
end
# v0.16: what a question did, recorded as it ran and only when a narration asked: [event, [[key, text], ...]]
func AskNote(tEvent, vVals)
	$vAskTrace + [tEvent, vVals]
end
func AskRun(xDecls, tQ, xRows)
	xQ = AskParse(xDecls, tQ)
	if not IsList(xRows) or ExIsObj(xRows) AskFail("the rows are a JSON list of records") end
	if $bAskTrace AskNote("ask", [["question", tQ], ["from", xQ[1]]]) end
	xOut = []
	for i = 1 to Len(xRows)
		if not ExIsObj(xRows[i]) AskFail("row " + String(i) + " is not a JSON object") end
		if not IsEmpty(xQ[2])
			ExSetRecord(xRows[i])
			if not ExBool(xQ[2], []) loop end
		end
		xOut + xRows[i]
	end
	if $bAskTrace AskNote("matched", [["count", String(Len(xOut))], ["total", String(Len(xRows))], ["from", xQ[1]]]) end
	if xQ[3] != ""
		# a stable insertion: a record goes after every one it does not precede
		vSorted = []
		for i = 1 to Len(xOut)
			nAt = Len(vSorted) + 1
			for j = 1 to Len(vSorted)
				nCmp = AskOrder(xOut[i], vSorted[j], xQ[3])
				if xQ[4] nCmp = -nCmp end
				if nCmp < 0
					nAt = j
					exit
				end
			end
			if nAt > Len(vSorted)
				vSorted + xOut[i]
			else
				# Ring's insert() puts the item AFTER the index: before j is after j-1 (HF-52)
				Insert(vSorted, nAt - 1, xOut[i])
			end
		end
		xOut = vSorted
	end
	if $bAskTrace and xQ[3] != ""
		tDir = "ASC"
		if xQ[4] tDir = "DESC" end
		AskNote("ordered", [["field", xQ[3]], ["direction", tDir]])
	end
	if xQ[5] >= 0 and Len(xOut) > xQ[5]
		# told only when the limit DROPPED rows: "only the first 5 are kept" over three matches would be untrue
		if $bAskTrace AskNote("cut", [["limit", String(xQ[5])], ["dropped", String(Len(xOut) - xQ[5])], ["count", String(xQ[5])]]) end
		vCut = []
		for i = 1 to xQ[5]
			vCut + xOut[i]
		end
		xOut = vCut
	end
	# v0.27: the rows themselves, not their JSON -- the voice renders them, redacted under its safeguard
	if $bAskTrace AskNote("answer", [["count", String(Len(xOut))], ["rows", xOut]]) end
	return xOut
end
