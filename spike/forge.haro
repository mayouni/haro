# forge.haro -- `haro forge.haro <file.haro> <out dir>`: the forge's smallest act.
#
# Reads a language declaration with the stzu meta-court (haro_lib.haro) and
# EMITS, into <out dir>:
#   <lang>_court.haro   a court for the declared language: this generated
#                       program loads court_lib.haro and carries the
#                       declaration as tables; `haro <lang>_court.haro check
#                       <file>` judges a sentence of the language
#   <lang>.gbnf         the language's grammar for the engine's constrained
#                       decoder (contract C9), in the llama.cpp dialect
#                       gbnf_machine.zig reads
# Pure core Ring; runs on rnx and on the oracle alike.

load "haro_lib.haro"

$aStzuToks = []
$aStzuUnions = []
$nStzuPos = 1
$aCondToks = []
$nCondPos = 1
$aCondDeclSeats = []
$aCondDecls = []
$aCondVerbOf = []
$tCondOther = ""
$aCondRefSeats = []
$aCondFormats = []
$bCondUnread = false
$aCondLangs = []
$tCondLang = ""
$aCourtSentences = []
$tStzuDir = ""
$bStzuCollect = false
$aStzuFound = []
$aStzuBroken = []
$aStzuLastName = ""
$aStzuUnresolved = []
$aStzuWarnings = []
$aStzuNotes = []

# The top level's names are its own (cInPath, cOutDir, ...): on Ring a
# function's bare assignment to a name that exists as a global WRITES THE
# GLOBAL (Ring, Judged by the Record, 2.7; Rule A's hazard), and the first
# version of this file lost its output directory to a helper's `cOut`
# while haro, under Rule A, ran it correctly (HF-33).
if Len(sysargv) < 4
	? "usage: forge.haro <file.haro> <out dir>"
else
	tInPath = sysargv[3]
	tOutDir = sysargv[4]
	tStzuText = Read(tInPath)
	$tStzuDir = StzuDirOf(tInPath)
	try
		aForgedLang = StzuDeclare(tStzuText)
		tLangName = LangGet(aForgedLang, "name")
		tForgedWhat = ""
		if Len(LangGet(aForgedLang, "declarations")) > 0 or Len(LangGet(aForgedLang, "expressions")) = 0
			tCourtText = ForgeCourt(aForgedLang)
			tGbnfText = ForgeGbnf(aForgedLang)
			Write(tOutDir + "/" + tLangName + "_court.haro", tCourtText)
			Write(tOutDir + "/" + tLangName + ".gbnf", tGbnfText)
			# a string first: a number on the left of + would read the string as a number (R41)
			tForgedWhat = String(Len(LangGet(aForgedLang, "declarations"))) + " kinds, " +
			  String(Len(LangGet(aForgedLang, "forms"))) + " forms, " + String(Len(LangGet(aForgedLang, "refusals"))) + " refusals -> " +
			  tLangName + "_court.haro, " + tLangName + ".gbnf"
		end
		# v0.5: an EXPRESSION language is forged whole -- its court and its
		# evaluator -- into <lang>_expr.haro, and its grammar into <lang>_expr.gbnf
		if Len(LangGet(aForgedLang, "expressions")) > 0
			Write(tOutDir + "/" + tLangName + "_expr.haro", ForgeExprCourt(aForgedLang))
			Write(tOutDir + "/" + tLangName + "_expr.gbnf", ForgeExprGbnf(aForgedLang))
			if tForgedWhat != "" tForgedWhat += "; " end
			tForgedWhat += String(Len(LangGet(aForgedLang, "expressions"))) + " expression(s) -> " + tLangName + "_expr.haro, " + tLangName + "_expr.gbnf"
		end
		# v0.7: an ASK's question grammar, for the decoder
		if not IsEmpty(LangGet(aForgedLang, "ask"))
			Write(tOutDir + "/" + tLangName + "_ask.gbnf", ForgeAskGbnf(aForgedLang))
			if tForgedWhat != "" tForgedWhat += "; " end
			tForgedWhat += "1 ask -> " + tLangName + "_ask.gbnf"
		end
		? "forged " + tLangName + ": " + tForgedWhat
	catch
		? cCatchError
	end
end

# ---- the court, as Ring source -----------------------------------------------

func RingStr(tS)
	# a Ring string literal; the Commons allows no escapes and no double
	# quote inside a string, so double quotes are safe delimiters unless the
	# text holds one, in which case single quotes are used
	if SubStr(tS, '"') > 0 return "'" + tS + "'" end
	return '"' + tS + '"'
end
# what a seat's type name resolves to in the language: prim form expr menu range
# format decl union sentence -- the meta-court's own answer (haro_lib.haro)
func TypeKindOf(aLang, tOf)
	return StzuTypeKindOf(aLang, tOf)
end
func UnionOf(aLang, tName)
	aU = LangGet(aLang, "unions")
	for i = 1 to Len(aU)
		if aU[i][1] = tName return aU[i] end
	end
	return ""
end
# a declaration's MESSAGES as [[seat, text], ...]
func MessagesSource(aMsgs)
	tBuf = "["
	for i = 1 to Len(aMsgs)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(aMsgs[i][1]) + ", " + RingStr(aMsgs[i][2]) + "]"
	end
	return tBuf + "]"
end
# a union's alternatives as [[of, isList, typeKind], ...]
func AltsSource(aLang, aAlts)
	tBuf = "["
	for i = 1 to Len(aAlts)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(aAlts[i][1]) + ", " + String(aAlts[i][2]) + ", " + RingStr(TypeKindOf(aLang, aAlts[i][1])) + "]"
	end
	return tBuf + "]"
end
# a seat in the court's table is [name, of, isList, optional, typeKind]
func SeatsSource(aLang, aSeats)
	tBuf = "["
	for i = 1 to Len(aSeats)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(aSeats[i][1]) + ", " + RingStr(aSeats[i][2]) + ", " + String(aSeats[i][3]) + ", " + String(aSeats[i][4]) + ", " + RingStr(TypeKindOf(aLang, aSeats[i][2])) + "]"
	end
	return tBuf + "]"
end
func NamesSource(aNames)
	tBuf = "["
	for i = 1 to Len(aNames)
		if i > 1 tBuf += ", " end
		tBuf += RingStr(aNames[i])
	end
	return tBuf + "]"
end
# v0.28 (HARO-MENU-CITES-01): a cites value as Ring source -- the word none as the string "none", a list as a list
func CitesSource(xCites)
	if IsString(xCites) return RingStr(xCites) end
	return NamesSource(xCites)
end
# v0.28: the CITES a MENU, RANGE, FORMAT or UNION declares rides into the court after its code, and only
# when declared, so a language that declares none forges the bytes it forged before
func CitesTail(aRec, nN)
	if Len(aRec) < nN return "" end
	xC = aRec[nN]
	if IsString(xC) return ", " + RingStr(xC) end
	if Len(xC) = 0 return "" end
	return ", " + NamesSource(xC)
end
func PointsSource(aPoints)
	tBuf = "["
	for i = 1 to Len(aPoints)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(aPoints[i][1] + "." + aPoints[i][2]) + ", " + RingStr(aPoints[i][3]) + "]"
	end
	return tBuf + "]"
end
# a table of rows as a Ring list literal, one row a line; fnRow is applied by the
# caller, so this takes the rows' texts
# v0.27: rows joined on one line
func JoinRows(aRows)
	tC = ""
	for i = 1 to Len(aRows)
		if i > 1 tC += ", " end
		tC += aRows[i]
	end
	return tC
end
func RowsSource(aRows, xNl)
	xC = "[" + xNl
	for i = 1 to Len(aRows)
		xC += "      " + aRows[i]
		if i < Len(aRows) xC += "," end
		xC += xNl
	end
	return xC + "    ]"
end
# an EXPRESSION's tables as the court reads them (v0.6): [name, ops, opds,
# aggs, vars, contexts, absent, division, equality]
func ExprSource(aE)
	aAgg = aE[4]
	if IsEmpty(aAgg) aAgg = [] end
	aVars = aE[5]
	if IsEmpty(aVars) aVars = [] end
	aCtx = []
	if Len(aE) >= 8 aCtx = aE[8] end
	tCtx = "["
	for i = 1 to Len(aCtx)
		if i > 1 tCtx += ", " end
		tCtx += "[" + RingStr(aCtx[i][1]) + ", " + NamesSource(aCtx[i][2]) + "]"
	end
	tCtx += "]"
	tAbsent = "" tDivision = "" tEquality = ""
	if Len(aE) >= 11
		tAbsent = aE[9]
		tDivision = aE[10]
		tEquality = aE[11]
	end
	return "[" + RingStr(aE[1]) + ", " + NamesSource(aE[2]) + ", " + NamesSource(aE[3]) + ", " + NamesSource(aAgg) + ", " +
	       NamesSource(aVars) + ", " + tCtx + ", " + RingStr(tAbsent) + ", " + RingStr(tDivision) + ", " + RingStr(tEquality) + "]"
end
# a WALK as the court reads it (v0.6): [name, of, steps, through, order,
# guards, compute, formula, fail]
func WalkSource(aW)
	aPaths = []
	for i = 1 to Len(aW[6])
		aPaths + aW[6][i][1]
	end
	return "[" + RingStr(aW[1]) + ", " + RingStr(aW[2]) + ", " + RingStr(aW[3]) + ", " + RingStr(aW[4]) + ", " + RingStr(aW[5]) + ", " +
	       NamesSource(aPaths) + ", " + RingStr(aW[7]) + ", " + RingStr(aW[8]) + ", " + RingStr(aW[9]) + "]"
end
# one language's record, as the court reads it (v0.4, grown in v0.6 and v0.7):
# [name, ext, kinds, forms, refusals, menus, ranges, formats, unions,
# constraints, world, points, floors, views, sentences, expressions, walks, ask, run, symbols]
func LangSource(aLang)
	tNl = Char(10)
	aRows = []
	aD = LangGet(aLang, "declarations")
	for i = 1 to Len(aD)
		aCodes = []
		if Len(aD[i]) >= 8 aCodes = aD[i][8] end
		# v0.35: the seat severities, a 7th element only where declared -- so every other court keeps its bytes
		tSevs = ""
		if Len(aD[i]) >= 10
			if Len(aD[i][10]) > 0 tSevs = ", " + MessagesSource(aD[i][10]) end
		end
		aRows + ("[" + RingStr(aD[i][2]) + ", " + RingStr(aD[i][1]) + ", " + SeatsSource(aLang, aD[i][3]) + ", " + RingStr(aD[i][6]) + ", " + MessagesSource(aD[i][7]) + ", " + MessagesSource(aCodes) + tSevs + "]")
	end
	tKinds = RowsSource(aRows, tNl)
	aRows = []
	aF = LangGet(aLang, "forms")
	for i = 1 to Len(aF)
		aRows + ("[" + RingStr(aF[i][1]) + ", " + SeatsSource(aLang, aF[i][2]) + "]")
	end
	tForms = RowsSource(aRows, tNl)
	aRows = []
	aR = LangGet(aLang, "refusals")
	for i = 1 to Len(aR)
		aNamed = []
		if Len(aR[i]) >= 5 aNamed = aR[i][5] end
		tRCode = ""
		aRCodes = []
		aRCites = []
		if Len(aR[i]) >= 8
			tRCode = aR[i][6]
			aRCodes = aR[i][7]
			aRCites = aR[i][8]
		end
		tRSevs = ""
		if Len(aR[i]) >= 9
			if Len(aR[i][9]) > 0 tRSevs = ", " + MessagesSource(aR[i][9]) end
		end
		aRows + ("[" + RingStr(aR[i][1]) + ", " + RingStr(aR[i][2]) + ", " + MessagesSource(aNamed) + ", " + RingStr(tRCode) + ", " + MessagesSource(aRCodes) + ", " + CitesSource(aRCites) + tRSevs + "]")
	end
	tRefusals = RowsSource(aRows, tNl)
	aRows = []
	aM = LangGet(aLang, "menus")
	for i = 1 to Len(aM)
		tMC = ""
		if Len(aM[i]) >= 5 tMC = aM[i][5] end
		aRows + ("[" + RingStr(aM[i][1]) + ", " + NamesSource(aM[i][2]) + ", " + RingStr(aM[i][3]) + ", " + RingStr(tMC) + CitesTail(aM[i], 6) + "]")
	end
	tMenus = RowsSource(aRows, tNl)
	aRows = []
	aRg = LangGet(aLang, "ranges")
	for i = 1 to Len(aRg)
		tRgC = ""
		if Len(aRg[i]) >= 6 tRgC = aRg[i][6] end
		aRows + ("[" + RingStr(aRg[i][1]) + ", " + aRg[i][2] + ", " + aRg[i][3] + ", " + RingStr(aRg[i][4]) + ", " + RingStr(tRgC) + CitesTail(aRg[i], 7) + "]")
	end
	tRanges = RowsSource(aRows, tNl)
	aRows = []
	aFm = LangGet(aLang, "formats")
	for i = 1 to Len(aFm)
		tFold = ""
		if Len(aFm[i]) >= 5 tFold = aFm[i][5] end
		tFmC = ""
		if Len(aFm[i]) >= 6 tFmC = aFm[i][6] end
		aRows + ("[" + RingStr(aFm[i][1]) + ", " + RingStr(aFm[i][2]) + ", " + RingStr(aFm[i][3]) + ", " + RingStr(tFold) + ", " + RingStr(tFmC) + CitesTail(aFm[i], 7) + "]")
	end
	tFormats = RowsSource(aRows, tNl)
	aRows = []
	aU = LangGet(aLang, "unions")
	for i = 1 to Len(aU)
		tUC = ""
		if Len(aU[i]) >= 5 tUC = aU[i][5] end
		aRows + ("[" + RingStr(aU[i][1]) + ", " + AltsSource(aLang, aU[i][2]) + ", " + RingStr(aU[i][3]) + ", " + RingStr(tUC) + CitesTail(aU[i], 6) + "]")
	end
	tUnions = RowsSource(aRows, tNl)
	aRows = []
	aC = LangGet(aLang, "constraints")
	for i = 1 to Len(aC)
		tCC = ""
		if Len(aC[i]) >= 7 tCC = aC[i][7] end
		# v0.23: the CITES a CONSTRAINT declares ride into the court beside its CODE
		aCCites = []
		if Len(aC[i]) >= 8 aCCites = aC[i][8] end
		# v0.25: the SEVERITY (error or warning) rides along as the eighth element
		tCSev = "error"
		if Len(aC[i]) >= 9 tCSev = aC[i][9] end
		aRows + ("[" + RingStr(aC[i][1]) + ", " + RingStr(aC[i][2]) + ", " + RingStr(aC[i][3]) + ", " + RingStr(aC[i][4]) + ", " + RingStr(aC[i][5]) + ", " + RingStr(tCC) + ", " + CitesSource(aCCites) + ", " + RingStr(tCSev) + "]")
	end
	tConstraints = RowsSource(aRows, tNl)
	# v0.32: the PATTERNs [name, over kind, over seat, rule, sets, message, line, code, cites, severity], the language entry's 24th element,
	# present only where the language declares one -- so a court without a pattern is the court it was
	tPatterns = ""
	aPt = LangGet(aLang, "patterns")
	if not IsEmpty(aPt)
		if Len(aPt) > 0
			aRows = []
			for i = 1 to Len(aPt)
				aSetRows = []
				for j = 1 to Len(aPt[i][5])
					aSetRows + ("[" + RingStr(aPt[i][5][j][1]) + ", " + RingStr(aPt[i][5][j][2]) + ", " + RingStr(aPt[i][5][j][3]) + ", " + String(aPt[i][5][j][4]) + "]")
				end
				tSets = "[]"
				if Len(aSetRows) > 0
					tSets = "["
					for j = 1 to Len(aSetRows)
						if j > 1 tSets += ", " end
						tSets += aSetRows[j]
					end
					tSets += "]"
				end
				aRows + ("[" + RingStr(aPt[i][1]) + ", " + RingStr(aPt[i][2]) + ", " + RingStr(aPt[i][3]) + ", " + RingStr(aPt[i][4]) + ", " + tSets + ", " + RingStr(aPt[i][6]) + ", " + String(aPt[i][7]) + ", " + RingStr(aPt[i][8]) + ", " + CitesSource(aPt[i][9]) + ", " + RingStr(aPt[i][10]) + "]")
			end
			tPatterns = RowsSource(aRows, tNl)
		end
	end
	aW = LangGet(aLang, "world")
	tWorld = "[[], " + '""' + ", [], []]"
	if not IsEmpty(aW)
		aEntry = []
		if Len(aW) >= 4 aEntry = aW[4] end
		aPublish = []
		if Len(aW) >= 5 aPublish = aW[5] end
		tPub = "["
		for i = 1 to Len(aPublish)
			if i > 1 tPub += ", " end
			tPub += "[" + RingStr(aPublish[i][1]) + ", " + RingStr(aPublish[i][2]) + "]"
		end
		tPub += "]"
		tWorld = "[" + NamesSource(aW[1]) + ", " + RingStr(aW[2]) + ", " + NamesSource(aEntry) + ", " + tPub + "]"
	end
	aSy = LangGet(aLang, "symbols")
	if IsEmpty(aSy) aSy = [] end
	tSymbols = "["
	for i = 1 to Len(aSy)
		if i > 1 tSymbols += ", " end
		tSyC = ""
		aSyCites = []
		if Len(aSy[i]) >= 7
			tSyC = aSy[i][6]
			aSyCites = aSy[i][7]
		end
		tSymbols += "[" + RingStr(aSy[i][1]) + ", " + RingStr(aSy[i][2]) + ", " + RingStr(aSy[i][3]) + ", " + RingStr(aSy[i][4]) + ", " + RingStr(tSyC) + ", " + CitesSource(aSyCites) + "]"
	end
	tSymbols += "]"
	aRf = LangGet(aLang, "refine")
	tPoints = "[]"
	tFloors = "[]"
	if not IsEmpty(aRf)
		tPoints = PointsSource(aRf[1])
		tFloors = PointsSource(aRf[2])
	end
	aRows = []
	aV = LangGet(aLang, "views")
	for i = 1 to Len(aV)
		aRows + ("[" + RingStr(aV[i][1]) + ", " + RingStr(aV[i][2]) + ", " + RingStr(aV[i][3]) + ", " + RingStr(aV[i][4]) + ", " + RingStr(aV[i][5]) + "]")
	end
	tViews = RowsSource(aRows, tNl)
	aRows = []
	aS = LangGet(aLang, "sentences")
	for i = 1 to Len(aS)
		tInner = ""
		if not IsEmpty(aS[i][3]) tInner = LangGet(aS[i][3], "name") end
		aRows + ("[" + RingStr(aS[i][1]) + ", " + RingStr(tInner) + ", " + RingStr(aS[i][4]) + ", " + RingStr(aS[i][5]) + "]")
	end
	tSentences = RowsSource(aRows, tNl)
	aRows = []
	aE = LangGet(aLang, "expressions")
	for i = 1 to Len(aE)
		aRows + ExprSource(aE[i])
	end
	tExprs = RowsSource(aRows, tNl)
	aRows = []
	aWk = LangGet(aLang, "walks")
	if IsEmpty(aWk) aWk = [] end
	for i = 1 to Len(aWk)
		aRows + WalkSource(aWk[i])
	end
	tWalks = RowsSource(aRows, tNl)
	aAsk = LangGet(aLang, "ask")
	tAsk = '""'
	if not IsEmpty(aAsk)
		tAsk = "[" + RingStr(aAsk[1]) + ", " + NamesSource(aAsk[2]) + ", " + RingStr(aAsk[3]) + ", " + NamesSource(aAsk[4])
		# v0.34: the schema path, only where one is declared -- so a court forged from a language without FIELDS keeps the bytes it had
		if aAsk[7] != "" tAsk += ", " + RingStr(aAsk[7]) end
		tAsk += "]"
	end
	aRun = LangGet(aLang, "run")
	tRun = '""'
	if not IsEmpty(aRun)
		tRun = "["
		for i = 1 to Len(aRun[2])
			if i > 1 tRun += ", " end
			tRun += "[" + RingStr(aRun[2][i][1]) + ", " + NamesSource(aRun[2][i][2]) + "]"
		end
		tRun += "]"
	end
	# v0.12: the FORMS [name, fluent, passive, statement, [[key, suffix], ...], [kind, base, forms]], or NULL
	aFs = LangGet(aLang, "formset")
	tFormset = '""'
	if not IsEmpty(aFs)
		tFormset = "[" + RingStr(aFs[1]) + ", " + RingStr(aFs[2]) + ", " + RingStr(aFs[3]) + ", " + RingStr(aFs[4]) + ", " + MessagesSource(aFs[5]) + ", " + NamesSource(aFs[6]) + "]"
	end
	# v0.13: the NARRATE [name, opens, ends, refuses, [[kind, template], ...]], or NULL
	aNr = LangGet(aLang, "narrate")
	tNarrate = '""'
	if not IsEmpty(aNr)
		tNarrate = "[" + RingStr(aNr[1]) + ", " + RingStr(aNr[2]) + ", " + RingStr(aNr[3]) + ", " + RingStr(aNr[4]) + ", " + MessagesSource(aNr[5]) + ", " + MessagesSource(aNr[8]) + "]"
	end
	# v0.17: the UNDERSTAND [name, [[role, kind], ...]], or NULL
	aUn = LangGet(aLang, "understand")
	tUnderstand = '""'
	if not IsEmpty(aUn)
		tUnderstand = "[" + RingStr(aUn[1]) + ", ["
		for i = 1 to Len(aUn[2])
			if i > 1 tUnderstand += ", " end
			tUnderstand += "[" + RingStr(aUn[2][i][1]) + ", " + RingStr(aUn[2][i][2][1]) + "]"
		end
		tUnderstand += "]]"
	end
	tC = "  [" + RingStr(LangGet(aLang, "name")) + ", " + RingStr(LangGet(aLang, "extension")) + "," + tNl
	tC += "    " + tKinds + "," + tNl
	tC += "    " + tForms + "," + tNl
	tC += "    " + tRefusals + "," + tNl
	tC += "    " + tMenus + "," + tNl
	tC += "    " + tRanges + "," + tNl
	tC += "    " + tFormats + "," + tNl
	tC += "    " + tUnions + "," + tNl
	tC += "    " + tConstraints + "," + tNl
	tC += "    " + tWorld + "," + tNl
	tC += "    " + tPoints + "," + tNl
	tC += "    " + tFloors + "," + tNl
	tC += "    " + tViews + "," + tNl
	tC += "    " + tSentences + "," + tNl
	tC += "    " + tExprs + "," + tNl
	tC += "    " + tWalks + "," + tNl
	tC += "    " + tAsk + "," + tNl
	tC += "    " + tRun + "," + tNl
	tC += "    " + tSymbols + "," + tNl
	tC += "    " + tFormset + "," + tNl
	tC += "    " + tNarrate + "," + tNl
	# v0.40: the doors -- a 25th element only where the language NEEDS, after the patterns (written empty when it has none), so every other
	# court keeps its bytes: [[needs...], [[verb, word, by seat], ...]]
	tNeeds = ""
	aDoors = LangGet(aLang, "needs")
	if not IsEmpty(aDoors)
		aOpn = LangGet(aLang, "opens")
		aOpRows = []
		for i = 1 to Len(aOpn)
			aOpRows + ("[" + RingStr(aOpn[i][1]) + ", " + RingStr(aOpn[i][2]) + ", " + String(aOpn[i][3]) + "]")
		end
		tNeeds = "[" + NamesSource(aDoors) + ", " + RowsSource(aOpRows, tNl) + "]"
		if tPatterns = "" tPatterns = "[]" end
	end
	if tPatterns = ""
		tC += "    " + tUnderstand + tNl
	elseif tNeeds = ""
		tC += "    " + tUnderstand + "," + tNl + "    " + tPatterns + tNl
	else
		tC += "    " + tUnderstand + "," + tNl + "    " + tPatterns + "," + tNl + "    " + tNeeds + tNl
	end
	tC += "  ]"
	return tC
end
# the language and, recursively, every language its SENTENCEs name, each once
func ForgeLangRecords(aLang, aSeen)
	aOut = []
	tName = LangGet(aLang, "name")
	if InStrList(tName, aSeen) return aOut end
	aSeen + tName
	aOut + aLang
	aS = LangGet(aLang, "sentences")
	for i = 1 to Len(aS)
		if not IsEmpty(aS[i][3])
			aMore = ForgeLangRecords(aS[i][3], aSeen)
			for j = 1 to Len(aMore)
				aOut + aMore[j]
			end
		end
	end
	return aOut
end
func ForgeCourt(aLang)
	tForgeName = LangGet(aLang, "name")
	tNl = Char(10)
	tC = "# " + tForgeName + "_court.haro -- GENERATED by forge.haro from the " + tForgeName + " declaration; do not edit." + tNl
	tC += "# `haro " + tForgeName + "_court.haro check <file" + LangGet(aLang, "extension") + ">` judges one sentence of the language;" + tNl
	tC += "# `... refine <file> <file.rfn>` judges one refinement. What the declaration says is judged" + tNl
	tC += "# by court_lib.haro over the records below, one per language -- this one first, then" + tNl
	tC += "# every language a SENTENCE seat names: kinds [VERB, name, seats, names, messages]," + tNl
	tC += "# forms, refusals, menus, ranges, formats, unions, constraints, world, points, floors," + tNl
	tC += "# views, sentences, expressions, walks and the ask." + tNl + tNl
	tC += 'load "court_lib.haro"' + tNl
	# v0.6: the expression library rides along only when an EXPRESSION is declared
	# (v0.7: or an ASK, whose rows are JSON); the question library only with an ASK
	bAsk = not IsEmpty(LangGet(aLang, "ask"))
	bRun = not IsEmpty(LangGet(aLang, "run"))
	bFormset = not IsEmpty(LangGet(aLang, "formset"))
	bNarrate = not IsEmpty(LangGet(aLang, "narrate"))
	bUnderstand = not IsEmpty(LangGet(aLang, "understand"))
	aSyL = LangGet(aLang, "symbols")
	bSym = false
	if not IsEmpty(aSyL)
		if Len(aSyL) > 0 bSym = true end
	end
	if not IsEmpty(LangGet(aLang, "world"))
		if Len(LangGet(aLang, "world")) >= 5
			if Len(LangGet(aLang, "world")[5]) > 0 bSym = true end
		end
	end
	# v0.40: a language that NEEDS publishes the doors its declarations open in its world rows, a world or not (D51)
	bDoors = not IsEmpty(LangGet(aLang, "needs"))
	# v0.10: a world is JSON, read and written with expr_lib's reader
	if Len(LangGet(aLang, "expressions")) > 0 or bAsk or bRun or bSym or bDoors
		tC += 'load "expr_lib.haro"' + tNl
	end
	# v0.14: the world functions load only where the language declares a world; a stub stands elsewhere
	if bSym or bDoors
		tC += 'load "world_lib.haro"' + tNl
	else
		tC += 'load "world_stub.haro"' + tNl
	end
	if bAsk
		tC += 'load "ask_lib.haro"' + tNl
	end
	if bRun
		tC += 'load "run_lib.haro"' + tNl
	end
	if bFormset
		tC += 'load "forms_lib.haro"' + tNl
	end
	if bNarrate
		tC += 'load "narrate_lib.haro"' + tNl
	end
	if bUnderstand
		tC += 'load "n_lib.haro"' + tNl
	end
	# v0.32: the pattern engine rides along only where a language the court carries declares a PATTERN
	bPattern = false
	aPatRecs = ForgeLangRecords(aLang, [])
	for i = 1 to Len(aPatRecs)
		aPatsOf = LangGet(aPatRecs[i], "patterns")
		if not IsEmpty(aPatsOf)
			if Len(aPatsOf) > 0 bPattern = true end
		end
	end
	if bPattern
		tC += 'load "pattern_lib.haro"' + tNl
		tC += 'load "pattern_judge.haro"' + tNl
	end
	# v0.35: the severity library rides along only where a language the court carries holds a seat or a NAMED word at a severity
	bSev = false
	for i = 1 to Len(aPatRecs)
		aSvD = LangGet(aPatRecs[i], "declarations")
		for j = 1 to Len(aSvD)
			if Len(aSvD[j]) >= 10
				if Len(aSvD[j][10]) > 0 bSev = true end
			end
		end
		aSvR = LangGet(aPatRecs[i], "refusals")
		for j = 1 to Len(aSvR)
			if Len(aSvR[j]) >= 9
				if Len(aSvR[j][9]) > 0 bSev = true end
			end
		end
	end
	if bSev tC += 'load "severity_lib.haro"' + tNl end
	# v0.40: the doors library rides along only where a language the court carries NEEDS a door (D51)
	bNeeds = false
	for i = 1 to Len(aPatRecs)
		if not IsEmpty(LangGet(aPatRecs[i], "needs")) bNeeds = true end
	end
	if bNeeds tC += 'load "needs_lib.haro"' + tNl end
	tC += tNl
	tC += "$tCourtLang = " + '""' + tNl + "$tCourtExt = " + '""' + tNl + "$tCourtDir = " + '""' + tNl
	tC += "$aCourtToks = []" + tNl + "$nCourtPos = 1" + tNl
	tC += "$aCondToks = []" + tNl + "$nCondPos = 1" + tNl + "$aCondDeclSeats = []" + tNl
	tC += "$aCondDecls = []" + tNl + "$aCondVerbOf = []" + tNl + "$tCondOther = " + '""' + tNl
	tC += "$aCondRefSeats = []" + tNl + "$aCondFormats = []" + tNl + "$bCondUnread = false" + tNl
	tC += "$aCondLangs = []" + tNl + "$tCondLang = " + '""' + tNl + "$aCourtSentences = []" + tNl
	tC += "$aCourtKinds = []" + tNl + "$aCourtForms = []" + tNl + "$aCourtRefusals = []" + tNl + "$aCourtMenus = []" + tNl
	tC += "$aCourtRanges = []" + tNl + "$aCourtFormats = []" + tNl + "$aCourtUnions = []" + tNl + "$aCourtConstraints = []" + tNl
	tC += "$aCourtWorld = [[], " + '""' + ", [], []]" + tNl + "$aCourtPoints = []" + tNl + "$aCourtFloors = []" + tNl
	tC += "$aCourtViews = []" + tNl + "$aCourtSentenceKinds = []" + tNl
	tC += "$aCourtExprs = []" + tNl + "$aCourtWalks = []" + tNl + '$aCourtAsk = ""' + tNl + '$aCourtRun = ""' + tNl
	tC += "$aCourtSymbols = []" + tNl + '$aCourtWorldFile = ""' + tNl
	tC += "$tCourtCode = " + RingStr("PARSE") + tNl + "$aCourtCites = []" + tNl
	tC += '$aCourtFormset = ""' + tNl + '$aCourtNarrate = ""' + tNl
	tC += '$aCourtUnderstand = ""' + tNl + "$bNSurfaces = false" + tNl
	tC += "$aCourtConstitution = []" + tNl
	# v0.24: the zone of organizational_sovereignty, and the audit chain of visible_state
	tC += "$aCourtZone = []" + tNl + "$tCourtAuditFile = " + '""' + tNl + "$aCourtAuditProposal = []" + tNl
	# v0.25: the personal seats the chain redacts, and the warnings a court speaks after its verdict
	tC += "$aCourtPersonal = []" + tNl + "$aCourtWarnings = []" + tNl
	tC += "$aCourtMarks = []" + tNl + "$aCourtSafeguards = []" + tNl
	tC += "$bCourtCollect = false" + tNl + "$aCourtFound = []" + tNl + "$aCourtBroken = []" + tNl
	tC += "$bRunTrace = false" + tNl + "$aRunTrace = []" + tNl + "$nRunDepth = 0" + tNl + "$bAskTrace = false" + tNl + "$aAskTrace = []" + tNl
	tC += ExprGlobals()
	tC += "$aCourtLangs = [" + tNl
	aRecs = ForgeLangRecords(aLang, [])
	for i = 1 to Len(aRecs)
		tC += LangSource(aRecs[i])
		if i < Len(aRecs) tC += "," end
		tC += tNl
	end
	tC += "]" + tNl
	tC += "CtUseLanguage(" + RingStr(tForgeName) + ")" + tNl
	tC += "CtBuildCondLangs()" + tNl
	# v0.23: the articles the language declares itself under (its CONSTITUTION), read by the
	# court's refusals through CtUnderArticle; a language under none leaves the list empty
	aCst = LangGet(aLang, "constitution")
	if not IsEmpty(aCst)
		tC += "$aCourtConstitution = " + NamesSource(aCst[2]) + tNl
		# v0.24: the zone kind, its sovereign seat and its movement seat, read by the court's refusals
		if Len(aCst) >= 9
			if aCst[7] != ""
				tC += "$aCourtZone = [" + RingStr(aCst[7]) + ", " + RingStr(aCst[8]) + ", " + RingStr(aCst[9]) + "]" + tNl
			end
		end
		# v0.25: the personal seats, as point names decl.seat, which the chain redacts
		if Len(aCst) >= 10
			if Len(aCst[10]) > 0
				aPersNames = []
				aMarkRows = []
				for i = 1 to Len(aCst[10])
					tPth = aCst[10][i][1]
					nN1 = SubStr(tPth, ".")
					tRest = SubStr(tPth, nN1 + 1)
					nN2 = SubStr(tRest, ".")
					if nN2 > 0
						# v0.27: a three-part path is a mark -- [kind, seat, markSeat]
						aMarkRows + ("[" + RingStr(Left(tPth, nN1 - 1)) + ", " + RingStr(Left(tRest, nN2 - 1)) + ", " + RingStr(SubStr(tRest, nN2 + 1)) + "]")
					else
						aPersNames + tPth
					end
				end
				if Len(aPersNames) > 0 tC += "$aCourtPersonal = " + NamesSource(aPersNames) + tNl end
				if Len(aMarkRows) > 0 tC += "$aCourtMarks = [" + JoinRows(aMarkRows) + "]" + tNl end
			end
		end
		# v0.27: the safeguards, [path, word]
		if Len(aCst) >= 11
			if Len(aCst[11]) > 0
				aSgRows = []
				for i = 1 to Len(aCst[11])
					aSgRows + ("[" + RingStr(aCst[11][i][1]) + ", " + RingStr(aCst[11][i][2]) + "]")
				end
				tC += "$aCourtSafeguards = [" + JoinRows(aSgRows) + "]" + tNl
			end
		end
	end
	tC += tNl + "CtMain()" + tNl
	return tC
end
# the globals expr_lib.haro reads, born empty at a court's top level (v0.6)
func ExprGlobals
	tNl = Char(10)
	tC = "$tExprLang = " + '""' + tNl + "$aExprOperators = []" + tNl + "$aExprOperands = []" + tNl
	tC += "$aExprAggregates = []" + tNl + "$aExprVariables = []" + tNl + "$aExprContexts = []" + tNl
	tC += "$tExprAbsent = " + '""' + tNl + "$tExprDivision = " + '""' + tNl + "$tExprEquality = " + '""' + tNl
	tC += "$aExprToks = []" + tNl + "$nExprPos = 1" + tNl + "$aExprAllowed = []" + tNl
	tC += "$aExprRecord = []" + tNl + "$aExprOverlay = []" + tNl
	return tC
end
# ---- the expression court, as Ring source (v0.5) -------------------------------
# One EXPRESSION per language is forged whole: the first declared one. Its
# operators, operands, variables and contexts become the tables expr_lib.haro
# reads; the court checks and evaluates an expression in a named seat.

func ForgeExprCourt(aLang)
	tNl = Char(10)
	tName = LangGet(aLang, "name")
	aE = LangGet(aLang, "expressions")[1]
	tC = "# " + tName + "_expr.haro -- GENERATED by forge.haro from the " + tName + " declaration; do not edit." + tNl
	tC += "# `haro " + tName + "_expr.haro check <seat> <expr>` judges one expression of the language in a seat;" + tNl
	tC += "# `... eval <seat> <expr> [input] [init]` evaluates it. What the declaration says is judged" + tNl
	tC += "# by expr_lib.haro over the tables below: the operator and operand menus, the" + tNl
	tC += "# variables, and the seats with the variables each admits." + tNl + tNl
	tC += 'load "expr_lib.haro"' + tNl + tNl
	tC += "$tExprLang = " + RingStr(tName) + tNl
	tC += "$aExprOperators = " + NamesSource(aE[2]) + tNl
	tC += "$aExprOperands = " + NamesSource(aE[3]) + tNl
	aAgg = aE[4]
	if IsEmpty(aAgg) aAgg = [] end
	tC += "$aExprAggregates = " + NamesSource(aAgg) + tNl
	aVars = aE[5]
	if IsEmpty(aVars) aVars = [] end
	tC += "$aExprVariables = " + NamesSource(aVars) + tNl
	tC += "$aExprContexts = ["
	aCtx = []
	if Len(aE) >= 8 aCtx = aE[8] end
	for i = 1 to Len(aCtx)
		if i > 1 tC += ", " end
		tC += "[" + RingStr(aCtx[i][1]) + ", " + NamesSource(aCtx[i][2]) + "]"
	end
	tC += "]" + tNl
	tAbsent = "" tDivision = "" tEquality = ""
	if Len(aE) >= 11
		tAbsent = aE[9]
		tDivision = aE[10]
		tEquality = aE[11]
	end
	tC += "$tExprAbsent = " + RingStr(tAbsent) + tNl + "$tExprDivision = " + RingStr(tDivision) + tNl + "$tExprEquality = " + RingStr(tEquality) + tNl
	tC += "$aExprToks = []" + tNl + "$nExprPos = 1" + tNl + "$aExprAllowed = []" + tNl
	tC += "$aExprRecord = []" + tNl + "$aExprOverlay = []" + tNl
	tC += tNl + "ExMain()" + tNl
	return tC
end
# the expression's grammar for the decoder, from its menus: a rule per
# precedence level, present when its operators are, the operands it admits,
# and its variables by name
func ForgeExprGbnf(aLang)
	return ForgeExprGbnfOf(aLang, LangGet(aLang, "expressions")[1])
end
func ForgeExprGbnfOf(aLang, aE)
	tNl = Char(10)
	tName = LangGet(aLang, "name")
	aOps = aE[2]
	aOpd = aE[3]
	aVars = aE[5]
	if IsEmpty(aVars) aVars = [] end
	tQ = Char(34)
	tBs = Char(92)
	aAgg = aE[4]
	if IsEmpty(aAgg) aAgg = [] end
	tG = "# " + tName + "_expr.gbnf -- GENERATED by forge.haro from the " + tName + " declaration (Haro v0.5, grown in v0.6)." + tNl
	tG += "# W's shape: or < and < not < comparison < additive < multiplicative < unary < primary;" + tNl
	tG += "# each level is present when the declaration admits its operators." + tNl + tNl
	tG += "root ::= ws or_expr ws" + tNl
	# a word operator is set off by at least one space (sp), or `not1` and
	# `@itemand` would be one word to the tokenizer
	if InStrList("or", aOps)
		tG += "or_expr ::= and_expr (sp " + tQ + "or" + tQ + " sp and_expr)*" + tNl
	else
		tG += "or_expr ::= and_expr" + tNl
	end
	if InStrList("and", aOps)
		tG += "and_expr ::= not_expr (sp " + tQ + "and" + tQ + " sp not_expr)*" + tNl
	else
		tG += "and_expr ::= not_expr" + tNl
	end
	if InStrList("not", aOps)
		tG += "not_expr ::= (" + tQ + "not" + tQ + " sp)? comparison" + tNl
	else
		tG += "not_expr ::= comparison" + tNl
	end
	bCmp = InStrList("cmp", aOps)
	bContains = InStrList("contains", aOps)
	if bCmp and bContains
		tG += "comparison ::= additive (ws cmpop ws additive | sp " + tQ + "CONTAINS" + tQ + " sp additive)?" + tNl
	elseif bCmp
		tG += "comparison ::= additive (ws cmpop ws additive)?" + tNl
	elseif bContains
		tG += "comparison ::= additive (sp " + tQ + "CONTAINS" + tQ + " sp additive)?" + tNl
	else
		tG += "comparison ::= additive" + tNl
	end
	if bCmp
		tG += "cmpop ::= " + tQ + ">=" + tQ + " | " + tQ + "<=" + tQ + " | " + tQ + "!=" + tQ + " | " + tQ + "<>" + tQ + " | " + tQ + "=" + tQ + " | " + tQ + ">" + tQ + " | " + tQ + "<" + tQ + tNl
	end
	aAdd = []
	if InStrList("add", aOps) aAdd + (tQ + "+" + tQ) end
	if InStrList("sub", aOps) aAdd + (tQ + "-" + tQ) end
	if Len(aAdd) > 0
		tG += "additive ::= multiplicative (ws (" + StzuJoin(aAdd, " | ") + ") ws multiplicative)*" + tNl
	else
		tG += "additive ::= multiplicative" + tNl
	end
	aMul = []
	if InStrList("mul", aOps) aMul + (tQ + "*" + tQ) end
	if InStrList("div", aOps) aMul + (tQ + "/" + tQ) end
	if InStrList("mod", aOps) aMul + (tQ + "%" + tQ) end
	if Len(aMul) > 0
		tG += "multiplicative ::= unary (ws (" + StzuJoin(aMul, " | ") + ") ws unary)*" + tNl
	else
		tG += "multiplicative ::= unary" + tNl
	end
	if InStrList("neg", aOps)
		tG += "unary ::= (" + tQ + "-" + tQ + " ws)? primary" + tNl
	else
		tG += "unary ::= primary" + tNl
	end
	aPrim = []
	if InStrList("number", aOpd) aPrim + "number" end
	if InStrList("text", aOpd) aPrim + "string" end
	if InStrList("flag", aOpd) aPrim + "flag" end
	if InStrList("var", aOpd) and Len(aVars) > 0 aPrim + "variable" end
	if InStrList("agg", aOpd) and Len(aAgg) > 0 aPrim + "aggregate" end
	if InStrList("ref", aOpd) aPrim + "reference" end
	if InStrList("round", aOps) aPrim + (tQ + "ROUND" + tQ + " ws " + tQ + "(" + tQ + " ws or_expr ws " + tQ + ")" + tQ) end
	aPrim + (tQ + "(" + tQ + " ws or_expr ws " + tQ + ")" + tQ)
	tG += "primary ::= " + StzuJoin(aPrim, " | ") + tNl
	if InStrList("flag", aOpd)
		tG += "flag ::= " + tQ + "true" + tQ + " | " + tQ + "false" + tQ + tNl
	end
	if InStrList("agg", aOpd) and Len(aAgg) > 0
		aA = []
		for i = 1 to Len(aAgg)
			aA + (tQ + Upper(aAgg[i]) + tQ)
		end
		tG += "aggregate ::= (" + StzuJoin(aA, " | ") + ") ws " + tQ + "(" + tQ + " ws reference ws " + tQ + ")" + tQ + tNl
	end
	if InStrList("ref", aOpd) or (InStrList("agg", aOpd) and Len(aAgg) > 0)
		tG += "reference ::= [a-z_] [a-z0-9_]* (" + tQ + "." + tQ + " [a-z_] [a-z0-9_]*)*" + tNl
	end
	tG += "number ::= [0-9]+ (" + tQ + "." + tQ + " [0-9]+)?" + tNl
	tG += "string ::= " + tQ + "'" + tQ + " [^']* " + tQ + "'" + tQ + " | " + tQ + tBs + tQ + tQ + " [^" + tQ + "]* " + tQ + tBs + tQ + tQ + tNl
	if Len(aVars) > 0
		aV = []
		for i = 1 to Len(aVars)
			aV + (tQ + aVars[i] + tQ)
		end
		tG += "variable ::= " + tQ + "@" + tQ + " (" + StzuJoin(aV, " | ") + ")" + tNl
	end
	tG += "sp ::= [ " + tBs + "t]+" + tNl
	tG += "ws ::= [ " + tBs + "t]*" + tNl
	return tG
end
# ---- the question grammar, for the decoder (v0.7) ------------------------------
# the ASK's frame -- SELECT * FROM name, then the clauses it admits -- over the
# WHERE expression's own grammar, its root renamed where_expr
func ForgeAskGbnf(aLang)
	tNl = Char(10)
	tQ = Char(34)
	tName = LangGet(aLang, "name")
	aAsk = LangGet(aLang, "ask")
	aCl = aAsk[4]
	tG = "# " + tName + "_ask.gbnf -- GENERATED by forge.haro from the " + tName + " declaration (Haro v0.7)." + tNl
	tG += "# The Q letter: SELECT * FROM name, then the clauses the ASK admits, in this order." + tNl + tNl
	tRoot = "root ::= ws " + tQ + "SELECT" + tQ + " sp " + tQ + "*" + tQ + " sp " + tQ + "FROM" + tQ + " sp ident"
	if InStrList("where", aCl) tRoot += " (sp " + tQ + "WHERE" + tQ + " sp where_expr)?" end
	if InStrList("order", aCl) tRoot += " (sp " + tQ + "ORDER" + tQ + " sp " + tQ + "BY" + tQ + " sp reference (sp (" + tQ + "ASC" + tQ + " | " + tQ + "DESC" + tQ + "))?)?" end
	if InStrList("limit", aCl) tRoot += " (sp " + tQ + "LIMIT" + tQ + " sp number)?" end
	tG += tRoot + " ws" + tNl
	tG += "ident ::= [a-z_] [a-z0-9_]*" + tNl
	tBody = ""
	if aAsk[3] != ""
		aE = ""
		aEs = LangGet(aLang, "expressions")
		for i = 1 to Len(aEs)
			if aEs[i][1] = aAsk[3] aE = aEs[i] end
		end
		tExpr = ForgeExprGbnfOf(aLang, aE)
		# keep the rules, drop the header and the root
		nAt = SubStr(tExpr, "root ::= ws or_expr ws" + tNl)
		if nAt > 0 tBody = SubStr(tExpr, nAt + Len("root ::= ws or_expr ws" + tNl)) end
		tG += "where_expr ::= or_expr" + tNl + tBody
	end
	if SubStr(tBody, "reference ::=") = 0
		tG += "reference ::= [a-z_] [a-z0-9_]* (" + tQ + "." + tQ + " [a-z_] [a-z0-9_]*)*" + tNl
	end
	if SubStr(tBody, "number ::=") = 0 tG += "number ::= [0-9]+" + tNl end
	if SubStr(tBody, "sp ::=") = 0 tG += "sp ::= [ " + Char(92) + "t]+" + tNl end
	if SubStr(tBody, "ws ::=") = 0 tG += "ws ::= [ " + Char(92) + "t]*" + tNl end
	return tG
end
# ---- the grammar, for the decoder --------------------------------------------
# One rule per kind, one alternative per clause with the clause's own value
# shape, so a derivation is well-typed; a clause given twice or a required
# seat absent are the court's, not the grammar's (a context-free grammar
# cannot say "at most once" without enumerating orders).

func GbnfShape(aSeat, aLang)
	tOf = aSeat[2]
	tK = TypeKindOf(aLang, tOf)
	if tK = "union"
		# one alternative per shape, in the union's order (v0.3)
		aU = UnionOf(aLang, tOf)
		tOut = "("
		for i = 1 to Len(aU[2])
			if i > 1 tOut += " | " end
			tOut += GbnfShape([aU[2][i][1], aU[2][i][1], aU[2][i][2], 0], aLang)
		end
		return tOut + ")"
	end
	if aSeat[3]
		if tK = "form"
			aF = FormOf(aLang, tOf)
			aFS = aF[2]
			aDeclaredK = []
			aDL = LangGet(aLang, "declarations")
			for i = 1 to Len(aDL) aDeclaredK + [aDL[i][1], "DECLARATION"] end
			aML = LangGet(aLang, "menus")
			for i = 1 to Len(aML) aDeclaredK + [aML[i][1], "MENU"] end
			if StzuIsPairForm(aFS, aDeclaredK) return "pairlist" end
			if Len(aFS) > 0 and (aFS[1][2] = "text" or TypeKindOf(aLang, aFS[1][2]) = "format") return "stringlist" end
		end
		return "namelist"
	end
	if tOf = "text" or tK = "format" or tK = "sentence" or tK = "expr" return "string" end
	if tOf = "number" or tK = "range" return "number" end
	return "ident"   # a name, a flag, a MENU word, a reference, a SYMBOL
end
func FormOf(aLang, tName)
	aF = LangGet(aLang, "forms")
	for i = 1 to Len(aF)
		if aF[i][1] = tName return aF[i] end
	end
	return ""
end
func ForgeGbnf(aLang)
	tNl = Char(10)
	tName = LangGet(aLang, "name")
	aD = LangGet(aLang, "declarations")
	tG = "# " + tName + ".gbnf -- GENERATED by forge.haro from the " + tName + " declaration (stzu v0.1)." + tNl
	tG += "# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords," + tNl
	tG += "# lower_snake identifiers, trailing commas. A clause given twice and a required seat" + tNl
	tG += "# absent are the court's to refuse; the decoder holds the shape." + tNl + tNl
	tG += "root ::= ws decl (ws decl)* ws" + tNl
	tG += "decl ::= "
	for i = 1 to Len(aD)
		if i > 1 tG += " | " end
		tG += "decl_" + aD[i][2]
	end
	tG += tNl
	# Ring has no string escapes (F-55): the grammar's own quotes and
	# backslashes are spelled with char(), never with \" or \n
	tQ = Char(34)
	tBs = Char(92)
	for i = 1 to Len(aD)
		tK = aD[i][2]
		aS = aD[i][3]
		# a declaration is [name, verb, seats, rationale, line]: the VERB is spoken
		tG += "decl_" + tK + ' ::= "DEFINE" sp "' + tK + '" sp ident sp "AS" ws "(" ws (clause_' + tK + ' (ws "," ws clause_' + tK + ')* (ws ",")?)? ws ")" ws "RATIONALE" sp string' + tNl
		tG += "clause_" + tK + " ::= "
		if Len(aS) = 0
			tG += '"NOTHING"'
		end
		for j = 1 to Len(aS)
			if j > 1 tG += " | " end
			tG += '"' + Upper(aS[j][1]) + '" sp ' + GbnfShape(aS[j], aLang)
		end
		tG += tNl
	end
	tG += tNl
	tG += 'ident ::= [a-z_] [a-z0-9_]*' + tNl
	tG += "string ::= " + tQ + tBs + tQ + tQ + " [^" + tQ + "]* " + tQ + tBs + tQ + tQ + tNl
	tG += 'number ::= [0-9]+' + tNl
	tG += 'namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"' + tNl
	tG += 'stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"' + tNl
	# v0.6: a pair list, emitted when a kind writes one
	bPairs = false
	for i = 1 to Len(aD)
		aS = aD[i][3]
		for j = 1 to Len(aS)
			if GbnfShape(aS[j], aLang) = "pairlist" bPairs = true end
		end
	end
	if bPairs
		tG += 'pairlist ::= "[" ws (pair (ws "," ws pair)* (ws ",")?)? ws "]"' + tNl
		# v0.27: a pair form with a mark seat writes the mark after the value
		bMark = false
		aDeclaredM = []
		aDLm = LangGet(aLang, "declarations")
		for i = 1 to Len(aDLm) aDeclaredM + [aDLm[i][1], "DECLARATION"] end
		aMLm = LangGet(aLang, "menus")
		for i = 1 to Len(aMLm) aDeclaredM + [aMLm[i][1], "MENU"] end
		aFm = LangGet(aLang, "forms")
		for i = 1 to Len(aFm)
			if StzuHasMarkSeat(aFm[i][2], aDeclaredM) bMark = true end
		end
		if bMark
			tG += 'pair ::= ident ws ":" ws (ident | string | number) (sp ident)?' + tNl
		else
			tG += 'pair ::= ident ws ":" ws (ident | string | number)' + tNl
		end
	end
	tG += "sp ::= [ " + tBs + "t]+" + tNl
	tG += "ws ::= ([ " + tBs + "t" + tBs + "r" + tBs + "n] | " + tQ + "--" + tQ + " [^" + tBs + "n]* " + tQ + tBs + "n" + tQ + ")*" + tNl
	return tG
end
