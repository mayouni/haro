# forge.haro -- `haro forge.haro <file.haro> <out dir>`: the forge's smallest act.
#
# Reads a language declaration with the stzu meta-court (haro_lib.haro) and
# EMITS, into <out dir>:
#   <lang>_court.haro   a court for the declared language: this generated
#                       program loads court_lib.haro and carries the
#                       declaration as tables; `haro <lang>_court.haro check
#                       <file>` judges a sentence of the language
#   <lang>.gbnf         the language's grammar for the engine's constrained
#                       decoder (contract C9), in the llama.cpp dialect
#                       gbnf_machine.zig reads
# Pure core Ring; runs on rnx and on the oracle alike.

load "haro_lib.haro"

$xStzuToks = []
$xStzuUnions = []
$nStzuPos = 1
$xCondToks = []
$nCondPos = 1
$vCondDeclSeats = []
$xCondDecls = []
$vCondVerbOf = []
$tCondOther = ""
$vCondRefSeats = []
$xCondFormats = []
$bCondUnread = false
$xCondLangs = []
$tCondLang = ""
$vCourtSentences = []
$tStzuDir = ""
$bStzuCollect = false
$vStzuFound = []
$vStzuBroken = []
$xStzuLastName = ""
$vStzuUnresolved = []
$vStzuWarnings = []
$vStzuNotes = []

# The top level's names are its own (cInPath, cOutDir, ...): on Ring a
# function's bare assignment to a name that exists as a global WRITES THE
# GLOBAL (Ring, Judged by the Record, 2.7; Rule A's hazard), and the first
# version of this file lost its output directory to a helper's `cOut`
# while haro, under Rule A, ran it correctly (HF-33).
if Len(sysargv) < 4
	? "usage: forge.haro <file.haro> <out dir>"
else
	tInPath = sysargv[3]
	tOutDir = sysargv[4]
	tStzuText = Read(tInPath)
	$tStzuDir = StzuDirOf(tInPath)
	try
		xForgedLang = StzuDeclare(tStzuText)
		tLangName = LangGet(xForgedLang, "name")
		tForgedWhat = ""
		if Len(LangGet(xForgedLang, "declarations")) > 0 or Len(LangGet(xForgedLang, "expressions")) = 0
			tCourtText = ForgeCourt(xForgedLang)
			tGbnfText = ForgeGbnf(xForgedLang)
			Write(tOutDir + "/" + tLangName + "_court.haro", tCourtText)
			Write(tOutDir + "/" + tLangName + ".gbnf", tGbnfText)
			# a string first: a number on the left of + would read the string as a number (R41)
			tForgedWhat = String(Len(LangGet(xForgedLang, "declarations"))) + " kinds, " +
			  String(Len(LangGet(xForgedLang, "forms"))) + " forms, " + String(Len(LangGet(xForgedLang, "refusals"))) + " refusals -> " +
			  tLangName + "_court.haro, " + tLangName + ".gbnf"
		end
		# v0.5: an EXPRESSION language is forged whole -- its court and its
		# evaluator -- into <lang>_expr.haro, and its grammar into <lang>_expr.gbnf
		if Len(LangGet(xForgedLang, "expressions")) > 0
			Write(tOutDir + "/" + tLangName + "_expr.haro", ForgeExprCourt(xForgedLang))
			Write(tOutDir + "/" + tLangName + "_expr.gbnf", ForgeExprGbnf(xForgedLang))
			if tForgedWhat != "" tForgedWhat += "; " end
			tForgedWhat += String(Len(LangGet(xForgedLang, "expressions"))) + " expression(s) -> " + tLangName + "_expr.haro, " + tLangName + "_expr.gbnf"
		end
		# v0.7: an ASK's question grammar, for the decoder
		if not IsEmpty(LangGet(xForgedLang, "ask"))
			Write(tOutDir + "/" + tLangName + "_ask.gbnf", ForgeAskGbnf(xForgedLang))
			if tForgedWhat != "" tForgedWhat += "; " end
			tForgedWhat += "1 ask -> " + tLangName + "_ask.gbnf"
		end
		? "forged " + tLangName + ": " + tForgedWhat
	catch
		? cCatchError
	end
end

# ---- the court, as Ring source -----------------------------------------------

func RingStr(tS)
	# a Ring string literal; the Commons allows no escapes and no double
	# quote inside a string, so double quotes are safe delimiters unless the
	# text holds one, in which case single quotes are used
	if SubStr(tS, '"') > 0 return "'" + tS + "'" end
	return '"' + tS + '"'
end
# what a seat's type name resolves to in the language: prim form expr menu range
# format decl union sentence -- the meta-court's own answer (haro_lib.haro)
func TypeKindOf(xLang, tOf)
	return StzuTypeKindOf(xLang, tOf)
end
func UnionOf(xLang, tName)
	xU = LangGet(xLang, "unions")
	for i = 1 to Len(xU)
		if xU[i][1] = tName return xU[i] end
	end
	return ""
end
# a declaration's MESSAGES as [[seat, text], ...]
func MessagesSource(xMsgs)
	tBuf = "["
	for i = 1 to Len(xMsgs)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(xMsgs[i][1]) + ", " + RingStr(xMsgs[i][2]) + "]"
	end
	return tBuf + "]"
end
# a union's alternatives as [[of, isList, typeKind], ...]
func AltsSource(xLang, xAlts)
	tBuf = "["
	for i = 1 to Len(xAlts)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(xAlts[i][1]) + ", " + String(xAlts[i][2]) + ", " + RingStr(TypeKindOf(xLang, xAlts[i][1])) + "]"
	end
	return tBuf + "]"
end
# a seat in the court's table is [name, of, isList, optional, typeKind]
func SeatsSource(xLang, xSeats)
	tBuf = "["
	for i = 1 to Len(xSeats)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(xSeats[i][1]) + ", " + RingStr(xSeats[i][2]) + ", " + String(xSeats[i][3]) + ", " + String(xSeats[i][4]) + ", " + RingStr(TypeKindOf(xLang, xSeats[i][2])) + "]"
	end
	return tBuf + "]"
end
func NamesSource(xNames)
	tBuf = "["
	for i = 1 to Len(xNames)
		if i > 1 tBuf += ", " end
		tBuf += RingStr(xNames[i])
	end
	return tBuf + "]"
end
# v0.28 (HARO-MENU-CITES-01): a cites value as Ring source -- the word none as the string "none", a list as a list
func CitesSource(xCites)
	if IsString(xCites) return RingStr(xCites) end
	return NamesSource(xCites)
end
# v0.28: the CITES a MENU, RANGE, FORMAT or UNION declares rides into the court after its code, and only
# when declared, so a language that declares none forges the bytes it forged before
func CitesTail(vRec, nN)
	if Len(vRec) < nN return "" end
	xC = vRec[nN]
	if IsString(xC) return ", " + RingStr(xC) end
	if Len(xC) = 0 return "" end
	return ", " + NamesSource(xC)
end
func PointsSource(xPoints)
	tBuf = "["
	for i = 1 to Len(xPoints)
		if i > 1 tBuf += ", " end
		tBuf += "[" + RingStr(xPoints[i][1] + "." + xPoints[i][2]) + ", " + RingStr(xPoints[i][3]) + "]"
	end
	return tBuf + "]"
end
# a table of rows as a Ring list literal, one row a line; fnRow is applied by the
# caller, so this takes the rows' texts
# v0.27: rows joined on one line
func JoinRows(xRows)
	tC = ""
	for i = 1 to Len(xRows)
		if i > 1 tC += ", " end
		tC += xRows[i]
	end
	return tC
end
func RowsSource(xRows, xNl)
	xC = "[" + xNl
	for i = 1 to Len(xRows)
		xC += "      " + xRows[i]
		if i < Len(xRows) xC += "," end
		xC += xNl
	end
	return xC + "    ]"
end
# an EXPRESSION's tables as the court reads them (v0.6): [name, ops, opds,
# aggs, vars, contexts, absent, division, equality]
func ExprSource(xE)
	xAgg = xE[4]
	if IsEmpty(xAgg) xAgg = [] end
	xVars = xE[5]
	if IsEmpty(xVars) xVars = [] end
	xCtx = []
	if Len(xE) >= 8 xCtx = xE[8] end
	tCtx = "["
	for i = 1 to Len(xCtx)
		if i > 1 tCtx += ", " end
		tCtx += "[" + RingStr(xCtx[i][1]) + ", " + NamesSource(xCtx[i][2]) + "]"
	end
	tCtx += "]"
	tAbsent = "" tDivision = "" tEquality = ""
	if Len(xE) >= 11
		tAbsent = xE[9]
		tDivision = xE[10]
		tEquality = xE[11]
	end
	return "[" + RingStr(xE[1]) + ", " + NamesSource(xE[2]) + ", " + NamesSource(xE[3]) + ", " + NamesSource(xAgg) + ", " +
	       NamesSource(xVars) + ", " + tCtx + ", " + RingStr(tAbsent) + ", " + RingStr(tDivision) + ", " + RingStr(tEquality) + "]"
end
# a WALK as the court reads it (v0.6): [name, of, steps, through, order,
# guards, compute, formula, fail]
func WalkSource(xW)
	vPaths = []
	for i = 1 to Len(xW[6])
		vPaths + xW[6][i][1]
	end
	return "[" + RingStr(xW[1]) + ", " + RingStr(xW[2]) + ", " + RingStr(xW[3]) + ", " + RingStr(xW[4]) + ", " + RingStr(xW[5]) + ", " +
	       NamesSource(vPaths) + ", " + RingStr(xW[7]) + ", " + RingStr(xW[8]) + ", " + RingStr(xW[9]) + "]"
end
# one language's record, as the court reads it (v0.4, grown in v0.6 and v0.7):
# [name, ext, kinds, forms, refusals, menus, ranges, formats, unions,
# constraints, world, points, floors, views, sentences, expressions, walks, ask, run, symbols]
func LangSource(xLang)
	tNl = Char(10)
	xRows = []
	xD = LangGet(xLang, "declarations")
	for i = 1 to Len(xD)
		xCodes = []
		if Len(xD[i]) >= 8 xCodes = xD[i][8] end
		# v0.35: the seat severities, a 7th element only where declared -- so every other court keeps its bytes
		tSevs = ""
		if Len(xD[i]) >= 10
			if Len(xD[i][10]) > 0 tSevs = ", " + MessagesSource(xD[i][10]) end
		end
		xRows + ("[" + RingStr(xD[i][2]) + ", " + RingStr(xD[i][1]) + ", " + SeatsSource(xLang, xD[i][3]) + ", " + RingStr(xD[i][6]) + ", " + MessagesSource(xD[i][7]) + ", " + MessagesSource(xCodes) + tSevs + "]")
	end
	tKinds = RowsSource(xRows, tNl)
	xRows = []
	xF = LangGet(xLang, "forms")
	for i = 1 to Len(xF)
		xRows + ("[" + RingStr(xF[i][1]) + ", " + SeatsSource(xLang, xF[i][2]) + "]")
	end
	tForms = RowsSource(xRows, tNl)
	xRows = []
	xR = LangGet(xLang, "refusals")
	for i = 1 to Len(xR)
		xNamed = []
		if Len(xR[i]) >= 5 xNamed = xR[i][5] end
		tRCode = ""
		xRCodes = []
		xRCites = []
		if Len(xR[i]) >= 8
			tRCode = xR[i][6]
			xRCodes = xR[i][7]
			xRCites = xR[i][8]
		end
		tRSevs = ""
		if Len(xR[i]) >= 9
			if Len(xR[i][9]) > 0 tRSevs = ", " + MessagesSource(xR[i][9]) end
		end
		xRows + ("[" + RingStr(xR[i][1]) + ", " + RingStr(xR[i][2]) + ", " + MessagesSource(xNamed) + ", " + RingStr(tRCode) + ", " + MessagesSource(xRCodes) + ", " + CitesSource(xRCites) + tRSevs + "]")
	end
	tRefusals = RowsSource(xRows, tNl)
	xRows = []
	xM = LangGet(xLang, "menus")
	for i = 1 to Len(xM)
		tMC = ""
		if Len(xM[i]) >= 5 tMC = xM[i][5] end
		xRows + ("[" + RingStr(xM[i][1]) + ", " + NamesSource(xM[i][2]) + ", " + RingStr(xM[i][3]) + ", " + RingStr(tMC) + CitesTail(xM[i], 6) + "]")
	end
	tMenus = RowsSource(xRows, tNl)
	xRows = []
	xRg = LangGet(xLang, "ranges")
	for i = 1 to Len(xRg)
		tRgC = ""
		if Len(xRg[i]) >= 6 tRgC = xRg[i][6] end
		xRows + ("[" + RingStr(xRg[i][1]) + ", " + xRg[i][2] + ", " + xRg[i][3] + ", " + RingStr(xRg[i][4]) + ", " + RingStr(tRgC) + CitesTail(xRg[i], 7) + "]")
	end
	tRanges = RowsSource(xRows, tNl)
	xRows = []
	xFm = LangGet(xLang, "formats")
	for i = 1 to Len(xFm)
		tFold = ""
		if Len(xFm[i]) >= 5 tFold = xFm[i][5] end
		tFmC = ""
		if Len(xFm[i]) >= 6 tFmC = xFm[i][6] end
		xRows + ("[" + RingStr(xFm[i][1]) + ", " + RingStr(xFm[i][2]) + ", " + RingStr(xFm[i][3]) + ", " + RingStr(tFold) + ", " + RingStr(tFmC) + CitesTail(xFm[i], 7) + "]")
	end
	tFormats = RowsSource(xRows, tNl)
	xRows = []
	xU = LangGet(xLang, "unions")
	for i = 1 to Len(xU)
		tUC = ""
		if Len(xU[i]) >= 5 tUC = xU[i][5] end
		xRows + ("[" + RingStr(xU[i][1]) + ", " + AltsSource(xLang, xU[i][2]) + ", " + RingStr(xU[i][3]) + ", " + RingStr(tUC) + CitesTail(xU[i], 6) + "]")
	end
	tUnions = RowsSource(xRows, tNl)
	xRows = []
	xC = LangGet(xLang, "constraints")
	for i = 1 to Len(xC)
		tCC = ""
		if Len(xC[i]) >= 7 tCC = xC[i][7] end
		# v0.23: the CITES a CONSTRAINT declares ride into the court beside its CODE
		xCCites = []
		if Len(xC[i]) >= 8 xCCites = xC[i][8] end
		# v0.25: the SEVERITY (error or warning) rides along as the eighth element
		tCSev = "error"
		if Len(xC[i]) >= 9 tCSev = xC[i][9] end
		xRows + ("[" + RingStr(xC[i][1]) + ", " + RingStr(xC[i][2]) + ", " + RingStr(xC[i][3]) + ", " + RingStr(xC[i][4]) + ", " + RingStr(xC[i][5]) + ", " + RingStr(tCC) + ", " + CitesSource(xCCites) + ", " + RingStr(tCSev) + "]")
	end
	tConstraints = RowsSource(xRows, tNl)
	# v0.32: the PATTERNs [name, over kind, over seat, rule, sets, message, line, code, cites, severity], the language entry's 24th element,
	# present only where the language declares one -- so a court without a pattern is the court it was
	tPatterns = ""
	xPt = LangGet(xLang, "patterns")
	if not IsEmpty(xPt)
		if Len(xPt) > 0
			xRows = []
			for i = 1 to Len(xPt)
				vSetRows = []
				for j = 1 to Len(xPt[i][5])
					vSetRows + ("[" + RingStr(xPt[i][5][j][1]) + ", " + RingStr(xPt[i][5][j][2]) + ", " + RingStr(xPt[i][5][j][3]) + ", " + String(xPt[i][5][j][4]) + "]")
				end
				tSets = "[]"
				if Len(vSetRows) > 0
					tSets = "["
					for j = 1 to Len(vSetRows)
						if j > 1 tSets += ", " end
						tSets += vSetRows[j]
					end
					tSets += "]"
				end
				xRows + ("[" + RingStr(xPt[i][1]) + ", " + RingStr(xPt[i][2]) + ", " + RingStr(xPt[i][3]) + ", " + RingStr(xPt[i][4]) + ", " + tSets + ", " + RingStr(xPt[i][6]) + ", " + String(xPt[i][7]) + ", " + RingStr(xPt[i][8]) + ", " + CitesSource(xPt[i][9]) + ", " + RingStr(xPt[i][10]) + "]")
			end
			tPatterns = RowsSource(xRows, tNl)
		end
	end
	xW = LangGet(xLang, "world")
	tWorld = "[[], " + '""' + ", [], []]"
	if not IsEmpty(xW)
		xEntry = []
		if Len(xW) >= 4 xEntry = xW[4] end
		xPublish = []
		if Len(xW) >= 5 xPublish = xW[5] end
		tPub = "["
		for i = 1 to Len(xPublish)
			if i > 1 tPub += ", " end
			tPub += "[" + RingStr(xPublish[i][1]) + ", " + RingStr(xPublish[i][2]) + "]"
		end
		tPub += "]"
		tWorld = "[" + NamesSource(xW[1]) + ", " + RingStr(xW[2]) + ", " + NamesSource(xEntry) + ", " + tPub + "]"
	end
	xSy = LangGet(xLang, "symbols")
	if IsEmpty(xSy) xSy = [] end
	tSymbols = "["
	for i = 1 to Len(xSy)
		if i > 1 tSymbols += ", " end
		tSyC = ""
		xSyCites = []
		if Len(xSy[i]) >= 7
			tSyC = xSy[i][6]
			xSyCites = xSy[i][7]
		end
		tSymbols += "[" + RingStr(xSy[i][1]) + ", " + RingStr(xSy[i][2]) + ", " + RingStr(xSy[i][3]) + ", " + RingStr(xSy[i][4]) + ", " + RingStr(tSyC) + ", " + CitesSource(xSyCites) + "]"
	end
	tSymbols += "]"
	xRf = LangGet(xLang, "refine")
	tPoints = "[]"
	tFloors = "[]"
	if not IsEmpty(xRf)
		tPoints = PointsSource(xRf[1])
		tFloors = PointsSource(xRf[2])
	end
	xRows = []
	xV = LangGet(xLang, "views")
	for i = 1 to Len(xV)
		xRows + ("[" + RingStr(xV[i][1]) + ", " + RingStr(xV[i][2]) + ", " + RingStr(xV[i][3]) + ", " + RingStr(xV[i][4]) + ", " + RingStr(xV[i][5]) + "]")
	end
	tViews = RowsSource(xRows, tNl)
	xRows = []
	xS = LangGet(xLang, "sentences")
	for i = 1 to Len(xS)
		tInner = ""
		if not IsEmpty(xS[i][3]) tInner = LangGet(xS[i][3], "name") end
		xRows + ("[" + RingStr(xS[i][1]) + ", " + RingStr(tInner) + ", " + RingStr(xS[i][4]) + ", " + RingStr(xS[i][5]) + "]")
	end
	tSentences = RowsSource(xRows, tNl)
	xRows = []
	xE = LangGet(xLang, "expressions")
	for i = 1 to Len(xE)
		xRows + ExprSource(xE[i])
	end
	tExprs = RowsSource(xRows, tNl)
	xRows = []
	xWk = LangGet(xLang, "walks")
	if IsEmpty(xWk) xWk = [] end
	for i = 1 to Len(xWk)
		xRows + WalkSource(xWk[i])
	end
	tWalks = RowsSource(xRows, tNl)
	xAsk = LangGet(xLang, "ask")
	tAsk = '""'
	if not IsEmpty(xAsk)
		tAsk = "[" + RingStr(xAsk[1]) + ", " + NamesSource(xAsk[2]) + ", " + RingStr(xAsk[3]) + ", " + NamesSource(xAsk[4])
		# v0.34: the schema path, only where one is declared -- so a court forged from a language without FIELDS keeps the bytes it had
		if xAsk[7] != "" tAsk += ", " + RingStr(xAsk[7]) end
		tAsk += "]"
	end
	xRun = LangGet(xLang, "run")
	tRun = '""'
	if not IsEmpty(xRun)
		tRun = "["
		for i = 1 to Len(xRun[2])
			if i > 1 tRun += ", " end
			tRun += "[" + RingStr(xRun[2][i][1]) + ", " + NamesSource(xRun[2][i][2]) + "]"
		end
		tRun += "]"
	end
	# v0.12: the FORMS [name, fluent, passive, statement, [[key, suffix], ...], [kind, base, forms]], or NULL
	xFs = LangGet(xLang, "formset")
	tFormset = '""'
	if not IsEmpty(xFs)
		tFormset = "[" + RingStr(xFs[1]) + ", " + RingStr(xFs[2]) + ", " + RingStr(xFs[3]) + ", " + RingStr(xFs[4]) + ", " + MessagesSource(xFs[5]) + ", " + NamesSource(xFs[6]) + "]"
	end
	# v0.13: the NARRATE [name, opens, ends, refuses, [[kind, template], ...]], or NULL
	xNr = LangGet(xLang, "narrate")
	tNarrate = '""'
	if not IsEmpty(xNr)
		tNarrate = "[" + RingStr(xNr[1]) + ", " + RingStr(xNr[2]) + ", " + RingStr(xNr[3]) + ", " + RingStr(xNr[4]) + ", " + MessagesSource(xNr[5]) + ", " + MessagesSource(xNr[8]) + "]"
	end
	# v0.17: the UNDERSTAND [name, [[role, kind], ...]], or NULL
	xUn = LangGet(xLang, "understand")
	tUnderstand = '""'
	if not IsEmpty(xUn)
		tUnderstand = "[" + RingStr(xUn[1]) + ", ["
		for i = 1 to Len(xUn[2])
			if i > 1 tUnderstand += ", " end
			tUnderstand += "[" + RingStr(xUn[2][i][1]) + ", " + RingStr(xUn[2][i][2][1]) + "]"
		end
		tUnderstand += "]]"
	end
	tC = "  [" + RingStr(LangGet(xLang, "name")) + ", " + RingStr(LangGet(xLang, "extension")) + "," + tNl
	tC += "    " + tKinds + "," + tNl
	tC += "    " + tForms + "," + tNl
	tC += "    " + tRefusals + "," + tNl
	tC += "    " + tMenus + "," + tNl
	tC += "    " + tRanges + "," + tNl
	tC += "    " + tFormats + "," + tNl
	tC += "    " + tUnions + "," + tNl
	tC += "    " + tConstraints + "," + tNl
	tC += "    " + tWorld + "," + tNl
	tC += "    " + tPoints + "," + tNl
	tC += "    " + tFloors + "," + tNl
	tC += "    " + tViews + "," + tNl
	tC += "    " + tSentences + "," + tNl
	tC += "    " + tExprs + "," + tNl
	tC += "    " + tWalks + "," + tNl
	tC += "    " + tAsk + "," + tNl
	tC += "    " + tRun + "," + tNl
	tC += "    " + tSymbols + "," + tNl
	tC += "    " + tFormset + "," + tNl
	tC += "    " + tNarrate + "," + tNl
	# v0.40: the doors -- a 25th element only where the language NEEDS, after the patterns (written empty when it has none), so every other
	# court keeps its bytes: [[needs...], [[verb, word, by seat], ...]]
	tNeeds = ""
	xDoors = LangGet(xLang, "needs")
	if not IsEmpty(xDoors)
		xOpn = LangGet(xLang, "opens")
		vOpRows = []
		for i = 1 to Len(xOpn)
			vOpRows + ("[" + RingStr(xOpn[i][1]) + ", " + RingStr(xOpn[i][2]) + ", " + String(xOpn[i][3]) + "]")
		end
		tNeeds = "[" + NamesSource(xDoors) + ", " + RowsSource(vOpRows, tNl) + "]"
		if tPatterns = "" tPatterns = "[]" end
	end
	if tPatterns = ""
		tC += "    " + tUnderstand + tNl
	elseif tNeeds = ""
		tC += "    " + tUnderstand + "," + tNl + "    " + tPatterns + tNl
	else
		tC += "    " + tUnderstand + "," + tNl + "    " + tPatterns + "," + tNl + "    " + tNeeds + tNl
	end
	tC += "  ]"
	return tC
end
# the language and, recursively, every language its SENTENCEs name, each once
func ForgeLangRecords(xLang, vSeen)
	xOut = []
	tName = LangGet(xLang, "name")
	if InStrList(tName, vSeen) return xOut end
	vSeen + tName
	xOut + xLang
	xS = LangGet(xLang, "sentences")
	for i = 1 to Len(xS)
		if not IsEmpty(xS[i][3])
			xMore = ForgeLangRecords(xS[i][3], vSeen)
			for j = 1 to Len(xMore)
				xOut + xMore[j]
			end
		end
	end
	return xOut
end
func ForgeCourt(xLang)
	tForgeName = LangGet(xLang, "name")
	tNl = Char(10)
	tC = "# " + tForgeName + "_court.haro -- GENERATED by forge.haro from the " + tForgeName + " declaration; do not edit." + tNl
	tC += "# `haro " + tForgeName + "_court.haro check <file" + LangGet(xLang, "extension") + ">` judges one sentence of the language;" + tNl
	tC += "# `... refine <file> <file.rfn>` judges one refinement. What the declaration says is judged" + tNl
	tC += "# by court_lib.haro over the records below, one per language -- this one first, then" + tNl
	tC += "# every language a SENTENCE seat names: kinds [VERB, name, seats, names, messages]," + tNl
	tC += "# forms, refusals, menus, ranges, formats, unions, constraints, world, points, floors," + tNl
	tC += "# views, sentences, expressions, walks and the ask." + tNl + tNl
	tC += 'load "court_lib.haro"' + tNl
	# v0.6: the expression library rides along only when an EXPRESSION is declared
	# (v0.7: or an ASK, whose rows are JSON); the question library only with an ASK
	bAsk = not IsEmpty(LangGet(xLang, "ask"))
	bRun = not IsEmpty(LangGet(xLang, "run"))
	bFormset = not IsEmpty(LangGet(xLang, "formset"))
	bNarrate = not IsEmpty(LangGet(xLang, "narrate"))
	bUnderstand = not IsEmpty(LangGet(xLang, "understand"))
	xSyL = LangGet(xLang, "symbols")
	bSym = false
	if not IsEmpty(xSyL)
		if Len(xSyL) > 0 bSym = true end
	end
	if not IsEmpty(LangGet(xLang, "world"))
		if Len(LangGet(xLang, "world")) >= 5
			if Len(LangGet(xLang, "world")[5]) > 0 bSym = true end
		end
	end
	# v0.40: a language that NEEDS publishes the doors its declarations open in its world rows, a world or not (D51)
	bDoors = not IsEmpty(LangGet(xLang, "needs"))
	# v0.10: a world is JSON, read and written with expr_lib's reader
	if Len(LangGet(xLang, "expressions")) > 0 or bAsk or bRun or bSym or bDoors
		tC += 'load "expr_lib.haro"' + tNl
	end
	# v0.14: the world functions load only where the language declares a world; a stub stands elsewhere
	if bSym or bDoors
		tC += 'load "world_lib.haro"' + tNl
	else
		tC += 'load "world_stub.haro"' + tNl
	end
	if bAsk
		tC += 'load "ask_lib.haro"' + tNl
	end
	if bRun
		tC += 'load "run_lib.haro"' + tNl
	end
	if bFormset
		tC += 'load "forms_lib.haro"' + tNl
	end
	if bNarrate
		tC += 'load "narrate_lib.haro"' + tNl
	end
	if bUnderstand
		tC += 'load "n_lib.haro"' + tNl
	end
	# v0.32: the pattern engine rides along only where a language the court carries declares a PATTERN
	bPattern = false
	xPatRecs = ForgeLangRecords(xLang, [])
	for i = 1 to Len(xPatRecs)
		xPatsOf = LangGet(xPatRecs[i], "patterns")
		if not IsEmpty(xPatsOf)
			if Len(xPatsOf) > 0 bPattern = true end
		end
	end
	if bPattern
		tC += 'load "pattern_lib.haro"' + tNl
		tC += 'load "pattern_judge.haro"' + tNl
	end
	# v0.35: the severity library rides along only where a language the court carries holds a seat or a NAMED word at a severity
	bSev = false
	for i = 1 to Len(xPatRecs)
		xSvD = LangGet(xPatRecs[i], "declarations")
		for j = 1 to Len(xSvD)
			if Len(xSvD[j]) >= 10
				if Len(xSvD[j][10]) > 0 bSev = true end
			end
		end
		xSvR = LangGet(xPatRecs[i], "refusals")
		for j = 1 to Len(xSvR)
			if Len(xSvR[j]) >= 9
				if Len(xSvR[j][9]) > 0 bSev = true end
			end
		end
	end
	if bSev tC += 'load "severity_lib.haro"' + tNl end
	# v0.40: the doors library rides along only where a language the court carries NEEDS a door (D51)
	bNeeds = false
	for i = 1 to Len(xPatRecs)
		if not IsEmpty(LangGet(xPatRecs[i], "needs")) bNeeds = true end
	end
	if bNeeds tC += 'load "needs_lib.haro"' + tNl end
	tC += tNl
	tC += "$tCourtLang = " + '""' + tNl + "$tCourtExt = " + '""' + tNl + "$tCourtDir = " + '""' + tNl
	tC += "$xCourtToks = []" + tNl + "$nCourtPos = 1" + tNl
	tC += "$xCondToks = []" + tNl + "$nCondPos = 1" + tNl + "$vCondDeclSeats = []" + tNl
	tC += "$xCondDecls = []" + tNl + "$vCondVerbOf = []" + tNl + "$tCondOther = " + '""' + tNl
	tC += "$vCondRefSeats = []" + tNl + "$xCondFormats = []" + tNl + "$bCondUnread = false" + tNl
	tC += "$xCondLangs = []" + tNl + "$tCondLang = " + '""' + tNl + "$vCourtSentences = []" + tNl
	tC += "$xCourtKinds = []" + tNl + "$xCourtForms = []" + tNl + "$xCourtRefusals = []" + tNl + "$xCourtMenus = []" + tNl
	tC += "$xCourtRanges = []" + tNl + "$xCourtFormats = []" + tNl + "$xCourtUnions = []" + tNl + "$xCourtConstraints = []" + tNl
	tC += "$xCourtWorld = [[], " + '""' + ", [], []]" + tNl + "$xCourtPoints = []" + tNl + "$xCourtFloors = []" + tNl
	tC += "$xCourtViews = []" + tNl + "$xCourtSentenceKinds = []" + tNl
	tC += "$xCourtExprs = []" + tNl + "$xCourtWalks = []" + tNl + '$xCourtAsk = ""' + tNl + '$xCourtRun = ""' + tNl
	tC += "$xCourtSymbols = []" + tNl + '$xCourtWorldFile = ""' + tNl
	tC += "$tCourtCode = " + RingStr("PARSE") + tNl + "$xCourtCites = []" + tNl
	tC += '$xCourtFormset = ""' + tNl + '$xCourtNarrate = ""' + tNl
	tC += '$xCourtUnderstand = ""' + tNl + "$bNSurfaces = false" + tNl
	tC += "$vCourtConstitution = []" + tNl
	# v0.24: the zone of organizational_sovereignty, and the audit chain of visible_state
	tC += "$vCourtZone = []" + tNl + "$tCourtAuditFile = " + '""' + tNl + "$vCourtAuditProposal = []" + tNl
	# v0.25: the personal seats the chain redacts, and the warnings a court speaks after its verdict
	tC += "$vCourtPersonal = []" + tNl + "$vCourtWarnings = []" + tNl
	tC += "$vCourtMarks = []" + tNl + "$vCourtSafeguards = []" + tNl
	tC += "$bCourtCollect = false" + tNl + "$vCourtFound = []" + tNl + "$vCourtBroken = []" + tNl
	tC += "$bRunTrace = false" + tNl + "$vRunTrace = []" + tNl + "$nRunDepth = 0" + tNl + "$bAskTrace = false" + tNl + "$vAskTrace = []" + tNl
	tC += ExprGlobals()
	tC += "$vCourtLangs = [" + tNl
	xRecs = ForgeLangRecords(xLang, [])
	for i = 1 to Len(xRecs)
		tC += LangSource(xRecs[i])
		if i < Len(xRecs) tC += "," end
		tC += tNl
	end
	tC += "]" + tNl
	tC += "CtUseLanguage(" + RingStr(tForgeName) + ")" + tNl
	tC += "CtBuildCondLangs()" + tNl
	# v0.23: the articles the language declares itself under (its CONSTITUTION), read by the
	# court's refusals through CtUnderArticle; a language under none leaves the list empty
	xCst = LangGet(xLang, "constitution")
	if not IsEmpty(xCst)
		tC += "$vCourtConstitution = " + NamesSource(xCst[2]) + tNl
		# v0.24: the zone kind, its sovereign seat and its movement seat, read by the court's refusals
		if Len(xCst) >= 9
			if xCst[7] != ""
				tC += "$vCourtZone = [" + RingStr(xCst[7]) + ", " + RingStr(xCst[8]) + ", " + RingStr(xCst[9]) + "]" + tNl
			end
		end
		# v0.25: the personal seats, as point names decl.seat, which the chain redacts
		if Len(xCst) >= 10
			if Len(xCst[10]) > 0
				vPersNames = []
				vMarkRows = []
				for i = 1 to Len(xCst[10])
					tPth = xCst[10][i][1]
					nN1 = SubStr(tPth, ".")
					tRest = SubStr(tPth, nN1 + 1)
					nN2 = SubStr(tRest, ".")
					if nN2 > 0
						# v0.27: a three-part path is a mark -- [kind, seat, markSeat]
						vMarkRows + ("[" + RingStr(Left(tPth, nN1 - 1)) + ", " + RingStr(Left(tRest, nN2 - 1)) + ", " + RingStr(SubStr(tRest, nN2 + 1)) + "]")
					else
						vPersNames + tPth
					end
				end
				if Len(vPersNames) > 0 tC += "$vCourtPersonal = " + NamesSource(vPersNames) + tNl end
				if Len(vMarkRows) > 0 tC += "$vCourtMarks = [" + JoinRows(vMarkRows) + "]" + tNl end
			end
		end
		# v0.27: the safeguards, [path, word]
		if Len(xCst) >= 11
			if Len(xCst[11]) > 0
				vSgRows = []
				for i = 1 to Len(xCst[11])
					vSgRows + ("[" + RingStr(xCst[11][i][1]) + ", " + RingStr(xCst[11][i][2]) + "]")
				end
				tC += "$vCourtSafeguards = [" + JoinRows(vSgRows) + "]" + tNl
			end
		end
	end
	tC += tNl + "CtMain()" + tNl
	return tC
end
# the globals expr_lib.haro reads, born empty at a court's top level (v0.6)
func ExprGlobals
	tNl = Char(10)
	tC = "$tExprLang = " + '""' + tNl + "$xExprOperators = []" + tNl + "$xExprOperands = []" + tNl
	tC += "$xExprAggregates = []" + tNl + "$xExprVariables = []" + tNl + "$xExprContexts = []" + tNl
	tC += "$tExprAbsent = " + '""' + tNl + "$tExprDivision = " + '""' + tNl + "$tExprEquality = " + '""' + tNl
	tC += "$xExprToks = []" + tNl + "$nExprPos = 1" + tNl + "$xExprAllowed = []" + tNl
	tC += "$xExprRecord = []" + tNl + "$vExprOverlay = []" + tNl
	return tC
end
# ---- the expression court, as Ring source (v0.5) -------------------------------
# One EXPRESSION per language is forged whole: the first declared one. Its
# operators, operands, variables and contexts become the tables expr_lib.haro
# reads; the court checks and evaluates an expression in a named seat.

func ForgeExprCourt(xLang)
	tNl = Char(10)
	tName = LangGet(xLang, "name")
	xE = LangGet(xLang, "expressions")[1]
	tC = "# " + tName + "_expr.haro -- GENERATED by forge.haro from the " + tName + " declaration; do not edit." + tNl
	tC += "# `haro " + tName + "_expr.haro check <seat> <expr>` judges one expression of the language in a seat;" + tNl
	tC += "# `... eval <seat> <expr> [input] [init]` evaluates it. What the declaration says is judged" + tNl
	tC += "# by expr_lib.haro over the tables below: the operator and operand menus, the" + tNl
	tC += "# variables, and the seats with the variables each admits." + tNl + tNl
	tC += 'load "expr_lib.haro"' + tNl + tNl
	tC += "$tExprLang = " + RingStr(tName) + tNl
	tC += "$xExprOperators = " + NamesSource(xE[2]) + tNl
	tC += "$xExprOperands = " + NamesSource(xE[3]) + tNl
	xAgg = xE[4]
	if IsEmpty(xAgg) xAgg = [] end
	tC += "$xExprAggregates = " + NamesSource(xAgg) + tNl
	xVars = xE[5]
	if IsEmpty(xVars) xVars = [] end
	tC += "$xExprVariables = " + NamesSource(xVars) + tNl
	tC += "$xExprContexts = ["
	xCtx = []
	if Len(xE) >= 8 xCtx = xE[8] end
	for i = 1 to Len(xCtx)
		if i > 1 tC += ", " end
		tC += "[" + RingStr(xCtx[i][1]) + ", " + NamesSource(xCtx[i][2]) + "]"
	end
	tC += "]" + tNl
	tAbsent = "" tDivision = "" tEquality = ""
	if Len(xE) >= 11
		tAbsent = xE[9]
		tDivision = xE[10]
		tEquality = xE[11]
	end
	tC += "$tExprAbsent = " + RingStr(tAbsent) + tNl + "$tExprDivision = " + RingStr(tDivision) + tNl + "$tExprEquality = " + RingStr(tEquality) + tNl
	tC += "$xExprToks = []" + tNl + "$nExprPos = 1" + tNl + "$xExprAllowed = []" + tNl
	tC += "$xExprRecord = []" + tNl + "$vExprOverlay = []" + tNl
	tC += tNl + "ExMain()" + tNl
	return tC
end
# the expression's grammar for the decoder, from its menus: a rule per
# precedence level, present when its operators are, the operands it admits,
# and its variables by name
func ForgeExprGbnf(xLang)
	return ForgeExprGbnfOf(xLang, LangGet(xLang, "expressions")[1])
end
func ForgeExprGbnfOf(xLang, xE)
	tNl = Char(10)
	tName = LangGet(xLang, "name")
	xOps = xE[2]
	xOpd = xE[3]
	xVars = xE[5]
	if IsEmpty(xVars) xVars = [] end
	tQ = Char(34)
	tBs = Char(92)
	xAgg = xE[4]
	if IsEmpty(xAgg) xAgg = [] end
	tG = "# " + tName + "_expr.gbnf -- GENERATED by forge.haro from the " + tName + " declaration (Haro v0.5, grown in v0.6)." + tNl
	tG += "# W's shape: or < and < not < comparison < additive < multiplicative < unary < primary;" + tNl
	tG += "# each level is present when the declaration admits its operators." + tNl + tNl
	tG += "root ::= ws or_expr ws" + tNl
	# a word operator is set off by at least one space (sp), or `not1` and
	# `@itemand` would be one word to the tokenizer
	if InStrList("or", xOps)
		tG += "or_expr ::= and_expr (sp " + tQ + "or" + tQ + " sp and_expr)*" + tNl
	else
		tG += "or_expr ::= and_expr" + tNl
	end
	if InStrList("and", xOps)
		tG += "and_expr ::= not_expr (sp " + tQ + "and" + tQ + " sp not_expr)*" + tNl
	else
		tG += "and_expr ::= not_expr" + tNl
	end
	if InStrList("not", xOps)
		tG += "not_expr ::= (" + tQ + "not" + tQ + " sp)? comparison" + tNl
	else
		tG += "not_expr ::= comparison" + tNl
	end
	bCmp = InStrList("cmp", xOps)
	bContains = InStrList("contains", xOps)
	if bCmp and bContains
		tG += "comparison ::= additive (ws cmpop ws additive | sp " + tQ + "CONTAINS" + tQ + " sp additive)?" + tNl
	elseif bCmp
		tG += "comparison ::= additive (ws cmpop ws additive)?" + tNl
	elseif bContains
		tG += "comparison ::= additive (sp " + tQ + "CONTAINS" + tQ + " sp additive)?" + tNl
	else
		tG += "comparison ::= additive" + tNl
	end
	if bCmp
		tG += "cmpop ::= " + tQ + ">=" + tQ + " | " + tQ + "<=" + tQ + " | " + tQ + "!=" + tQ + " | " + tQ + "<>" + tQ + " | " + tQ + "=" + tQ + " | " + tQ + ">" + tQ + " | " + tQ + "<" + tQ + tNl
	end
	vAdd = []
	if InStrList("add", xOps) vAdd + (tQ + "+" + tQ) end
	if InStrList("sub", xOps) vAdd + (tQ + "-" + tQ) end
	if Len(vAdd) > 0
		tG += "additive ::= multiplicative (ws (" + StzuJoin(vAdd, " | ") + ") ws multiplicative)*" + tNl
	else
		tG += "additive ::= multiplicative" + tNl
	end
	vMul = []
	if InStrList("mul", xOps) vMul + (tQ + "*" + tQ) end
	if InStrList("div", xOps) vMul + (tQ + "/" + tQ) end
	if InStrList("mod", xOps) vMul + (tQ + "%" + tQ) end
	if Len(vMul) > 0
		tG += "multiplicative ::= unary (ws (" + StzuJoin(vMul, " | ") + ") ws unary)*" + tNl
	else
		tG += "multiplicative ::= unary" + tNl
	end
	if InStrList("neg", xOps)
		tG += "unary ::= (" + tQ + "-" + tQ + " ws)? primary" + tNl
	else
		tG += "unary ::= primary" + tNl
	end
	vPrim = []
	if InStrList("number", xOpd) vPrim + "number" end
	if InStrList("text", xOpd) vPrim + "string" end
	if InStrList("flag", xOpd) vPrim + "flag" end
	if InStrList("var", xOpd) and Len(xVars) > 0 vPrim + "variable" end
	if InStrList("agg", xOpd) and Len(xAgg) > 0 vPrim + "aggregate" end
	if InStrList("ref", xOpd) vPrim + "reference" end
	if InStrList("round", xOps) vPrim + (tQ + "ROUND" + tQ + " ws " + tQ + "(" + tQ + " ws or_expr ws " + tQ + ")" + tQ) end
	vPrim + (tQ + "(" + tQ + " ws or_expr ws " + tQ + ")" + tQ)
	tG += "primary ::= " + StzuJoin(vPrim, " | ") + tNl
	if InStrList("flag", xOpd)
		tG += "flag ::= " + tQ + "true" + tQ + " | " + tQ + "false" + tQ + tNl
	end
	if InStrList("agg", xOpd) and Len(xAgg) > 0
		xA = []
		for i = 1 to Len(xAgg)
			xA + (tQ + Upper(xAgg[i]) + tQ)
		end
		tG += "aggregate ::= (" + StzuJoin(xA, " | ") + ") ws " + tQ + "(" + tQ + " ws reference ws " + tQ + ")" + tQ + tNl
	end
	if InStrList("ref", xOpd) or (InStrList("agg", xOpd) and Len(xAgg) > 0)
		tG += "reference ::= [a-z_] [a-z0-9_]* (" + tQ + "." + tQ + " [a-z_] [a-z0-9_]*)*" + tNl
	end
	tG += "number ::= [0-9]+ (" + tQ + "." + tQ + " [0-9]+)?" + tNl
	tG += "string ::= " + tQ + "'" + tQ + " [^']* " + tQ + "'" + tQ + " | " + tQ + tBs + tQ + tQ + " [^" + tQ + "]* " + tQ + tBs + tQ + tQ + tNl
	if Len(xVars) > 0
		xV = []
		for i = 1 to Len(xVars)
			xV + (tQ + xVars[i] + tQ)
		end
		tG += "variable ::= " + tQ + "@" + tQ + " (" + StzuJoin(xV, " | ") + ")" + tNl
	end
	tG += "sp ::= [ " + tBs + "t]+" + tNl
	tG += "ws ::= [ " + tBs + "t]*" + tNl
	return tG
end
# ---- the question grammar, for the decoder (v0.7) ------------------------------
# the ASK's frame -- SELECT * FROM name, then the clauses it admits -- over the
# WHERE expression's own grammar, its root renamed where_expr
func ForgeAskGbnf(xLang)
	tNl = Char(10)
	tQ = Char(34)
	tName = LangGet(xLang, "name")
	xAsk = LangGet(xLang, "ask")
	xCl = xAsk[4]
	tG = "# " + tName + "_ask.gbnf -- GENERATED by forge.haro from the " + tName + " declaration (Haro v0.7)." + tNl
	tG += "# The Q letter: SELECT * FROM name, then the clauses the ASK admits, in this order." + tNl + tNl
	tRoot = "root ::= ws " + tQ + "SELECT" + tQ + " sp " + tQ + "*" + tQ + " sp " + tQ + "FROM" + tQ + " sp ident"
	if InStrList("where", xCl) tRoot += " (sp " + tQ + "WHERE" + tQ + " sp where_expr)?" end
	if InStrList("order", xCl) tRoot += " (sp " + tQ + "ORDER" + tQ + " sp " + tQ + "BY" + tQ + " sp reference (sp (" + tQ + "ASC" + tQ + " | " + tQ + "DESC" + tQ + "))?)?" end
	if InStrList("limit", xCl) tRoot += " (sp " + tQ + "LIMIT" + tQ + " sp number)?" end
	tG += tRoot + " ws" + tNl
	tG += "ident ::= [a-z_] [a-z0-9_]*" + tNl
	tBody = ""
	if xAsk[3] != ""
		xE = ""
		xEs = LangGet(xLang, "expressions")
		for i = 1 to Len(xEs)
			if xEs[i][1] = xAsk[3] xE = xEs[i] end
		end
		tExpr = ForgeExprGbnfOf(xLang, xE)
		# keep the rules, drop the header and the root
		nAt = SubStr(tExpr, "root ::= ws or_expr ws" + tNl)
		if nAt > 0 tBody = SubStr(tExpr, nAt + Len("root ::= ws or_expr ws" + tNl)) end
		tG += "where_expr ::= or_expr" + tNl + tBody
	end
	if SubStr(tBody, "reference ::=") = 0
		tG += "reference ::= [a-z_] [a-z0-9_]* (" + tQ + "." + tQ + " [a-z_] [a-z0-9_]*)*" + tNl
	end
	if SubStr(tBody, "number ::=") = 0 tG += "number ::= [0-9]+" + tNl end
	if SubStr(tBody, "sp ::=") = 0 tG += "sp ::= [ " + Char(92) + "t]+" + tNl end
	if SubStr(tBody, "ws ::=") = 0 tG += "ws ::= [ " + Char(92) + "t]*" + tNl end
	return tG
end
# ---- the grammar, for the decoder --------------------------------------------
# One rule per kind, one alternative per clause with the clause's own value
# shape, so a derivation is well-typed; a clause given twice or a required
# seat absent are the court's, not the grammar's (a context-free grammar
# cannot say "at most once" without enumerating orders).

func GbnfShape(xSeat, xLang)
	tOf = xSeat[2]
	tK = TypeKindOf(xLang, tOf)
	if tK = "union"
		# one alternative per shape, in the union's order (v0.3)
		xU = UnionOf(xLang, tOf)
		tOut = "("
		for i = 1 to Len(xU[2])
			if i > 1 tOut += " | " end
			tOut += GbnfShape([xU[2][i][1], xU[2][i][1], xU[2][i][2], 0], xLang)
		end
		return tOut + ")"
	end
	if xSeat[3]
		if tK = "form"
			xF = FormOf(xLang, tOf)
			xFS = xF[2]
			vDeclaredK = []
			xDL = LangGet(xLang, "declarations")
			for i = 1 to Len(xDL) vDeclaredK + [xDL[i][1], "DECLARATION"] end
			xML = LangGet(xLang, "menus")
			for i = 1 to Len(xML) vDeclaredK + [xML[i][1], "MENU"] end
			if StzuIsPairForm(xFS, vDeclaredK) return "pairlist" end
			if Len(xFS) > 0 and (xFS[1][2] = "text" or TypeKindOf(xLang, xFS[1][2]) = "format") return "stringlist" end
		end
		return "namelist"
	end
	if tOf = "text" or tK = "format" or tK = "sentence" or tK = "expr" return "string" end
	if tOf = "number" or tK = "range" return "number" end
	return "ident"   # a name, a flag, a MENU word, a reference, a SYMBOL
end
func FormOf(xLang, tName)
	xF = LangGet(xLang, "forms")
	for i = 1 to Len(xF)
		if xF[i][1] = tName return xF[i] end
	end
	return ""
end
func ForgeGbnf(xLang)
	tNl = Char(10)
	tName = LangGet(xLang, "name")
	xD = LangGet(xLang, "declarations")
	tG = "# " + tName + ".gbnf -- GENERATED by forge.haro from the " + tName + " declaration (stzu v0.1)." + tNl
	tG += "# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords," + tNl
	tG += "# lower_snake identifiers, trailing commas. A clause given twice and a required seat" + tNl
	tG += "# absent are the court's to refuse; the decoder holds the shape." + tNl + tNl
	tG += "root ::= ws decl (ws decl)* ws" + tNl
	tG += "decl ::= "
	for i = 1 to Len(xD)
		if i > 1 tG += " | " end
		tG += "decl_" + xD[i][2]
	end
	tG += tNl
	# Ring has no string escapes (F-55): the grammar's own quotes and
	# backslashes are spelled with char(), never with \" or \n
	tQ = Char(34)
	tBs = Char(92)
	for i = 1 to Len(xD)
		tK = xD[i][2]
		xS = xD[i][3]
		# a declaration is [name, verb, seats, rationale, line]: the VERB is spoken
		tG += "decl_" + tK + ' ::= "DEFINE" sp "' + tK + '" sp ident sp "AS" ws "(" ws (clause_' + tK + ' (ws "," ws clause_' + tK + ')* (ws ",")?)? ws ")" ws "RATIONALE" sp string' + tNl
		tG += "clause_" + tK + " ::= "
		if Len(xS) = 0
			tG += '"NOTHING"'
		end
		for j = 1 to Len(xS)
			if j > 1 tG += " | " end
			tG += '"' + Upper(xS[j][1]) + '" sp ' + GbnfShape(xS[j], xLang)
		end
		tG += tNl
	end
	tG += tNl
	tG += 'ident ::= [a-z_] [a-z0-9_]*' + tNl
	tG += "string ::= " + tQ + tBs + tQ + tQ + " [^" + tQ + "]* " + tQ + tBs + tQ + tQ + tNl
	tG += 'number ::= [0-9]+' + tNl
	tG += 'namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"' + tNl
	tG += 'stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"' + tNl
	# v0.6: a pair list, emitted when a kind writes one
	bPairs = false
	for i = 1 to Len(xD)
		xS = xD[i][3]
		for j = 1 to Len(xS)
			if GbnfShape(xS[j], xLang) = "pairlist" bPairs = true end
		end
	end
	if bPairs
		tG += 'pairlist ::= "[" ws (pair (ws "," ws pair)* (ws ",")?)? ws "]"' + tNl
		# v0.27: a pair form with a mark seat writes the mark after the value
		bMark = false
		vDeclaredM = []
		xDLm = LangGet(xLang, "declarations")
		for i = 1 to Len(xDLm) vDeclaredM + [xDLm[i][1], "DECLARATION"] end
		xMLm = LangGet(xLang, "menus")
		for i = 1 to Len(xMLm) vDeclaredM + [xMLm[i][1], "MENU"] end
		xFm = LangGet(xLang, "forms")
		for i = 1 to Len(xFm)
			if StzuHasMarkSeat(xFm[i][2], vDeclaredM) bMark = true end
		end
		if bMark
			tG += 'pair ::= ident ws ":" ws (ident | string | number) (sp ident)?' + tNl
		else
			tG += 'pair ::= ident ws ":" ws (ident | string | number)' + tNl
		end
	end
	tG += "sp ::= [ " + tBs + "t]+" + tNl
	tG += "ws ::= ([ " + tBs + "t" + tBs + "r" + tBs + "n] | " + tQ + "--" + tQ + " [^" + tBs + "n]* " + tQ + tBs + "n" + tQ + ")*" + tNl
	return tG
end
