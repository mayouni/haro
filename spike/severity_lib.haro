# severity_lib.haro -- the per-seat severity (Haro v0.35, v35/GRAMMAR.md): a reference that resolves to nothing, and a kind a REFUSAL
# names, may be a WARNING. Loaded by a forged court only where a language it carries holds a seat or a NAMED word at a severity, so every
# other court keeps its bytes and its cold compile.
#
# A warning is a refusal DEMOTED and nothing else: the same code, the same cites, the same line and the same words its refusal would have
# carried (the twin, v35/panel_errors.haro, pins it); the verdict stays ok and the warning is spoken after it, as a CONSTRAINT's of SEVERITY
# warning is (v0.25), and enters the envelope as "warning". Only a reference may be one: a value of the wrong shape is refused before the
# references pass, and this library is never reached for it.
#
#   the kind row's 7th element    [[seat, severity], ...]   SEVERITIES of a DECLARATION
#   the refusal row's 7th element [[word, severity], ...]   SEVERITIES of unknown_declaration, its NAMED words
#
# Functions only; the globals are the generated court's.

# the severity a kind holds a seat at: "warning", "error", or "" (an error, as every seat is)
func SevSeatIs(xKind, tSeat)
	if Len(xKind) < 7 return "" end
	for i = 1 to Len(xKind[7])
		if xKind[7][i][1] = tSeat return xKind[7][i][2] end
	end
	return ""
end
# a reference clause of a seat held at warning: each element that resolves to nothing is spoken, one warning per element, in the order
# written -- where the refusal stops at the first, a warning has no reason to
func SevWarnClause(xDecl, xSeat, xClause)
	xV = xClause[3]
	if xV[1] = "namelist" or xV[1] = "pairlist" or xV[1] = "stringlist"
		for i = 1 to Len(xV[2])
			vSubV = [xV[1], [xV[2][i]], xV[3], xV[4]]
			SevWarnOne(xDecl, xSeat, [xClause[1], xClause[2], vSubV, xClause[4], xClause[5]])
		end
	else
		SevWarnOne(xDecl, xSeat, xClause)
	end
end
func SevWarnOne(xDecl, xSeat, xClause)
	CtSetCode("PARSE", [])
	tWhy = CtCheckSeatValue(xDecl, xSeat, xClause, true)
	if tWhy != "" $vCourtWarnings + [$tCourtCode, $xCourtCites, xClause[2], tWhy] end
	CtSetCode("PARSE", [])
end
# a NAMED kind held at warning: its declaration is read past -- the name, AS, a body whose parentheses balance, RATIONALE and its string --
# and said in the NAMED words, with the refusal's code and cites. 1 when read past; 0 leaves the refusal to the court. What is read past is
# not declared: it counts nowhere and a reference to it resolves to nothing
func SevSkipNamed(vRow, xK)
	tWord = Lower(CtShown(xK))
	tSev = ""
	for i = 1 to Len(vRow[7])
		if vRow[7][i][1] = tWord tSev = vRow[7][i][2] end
	end
	if tSev != "warning" return false end
	tNamed = CtRefusalNamed("unknown_declaration", tWord)
	xCC = CtRefusalCode("unknown_declaration", tWord, "UNKNOWN_KIND")
	xName = CtExpect("ident", "a lower_snake name")
	xAs = CtNext()
	if not (xAs[1] = "keyword" and xAs[2] = "AS")
		CtFail(xAs[3], "Expected AS after the name, found '" + CtShown(xAs) + "'")
	end
	CtExpect("lparen", "'('")
	nDepth = 1
	while nDepth > 0
		xT = CtNext()
		if xT[1] = "eof"
			CtFail(xK[3], Upper(tWord) + " " + xName[2] + " opens '(' and never closes it: a kind read past is still a declaration")
		end
		if xT[1] = "lparen" nDepth++ end
		if xT[1] = "rparen" nDepth-- end
	end
	xR = CtNext()
	if not (xR[1] = "keyword" and xR[2] = "RATIONALE")
		CtFail(xR[3], "RATIONALE is mandatory on every declaration (" + Upper(tWord) + " " + xName[2] + " has none)")
	end
	CtExpect("string", "the RATIONALE string")
	$vCourtWarnings + [xCC[1], xCC[2], xK[3], tNamed]
	return true
end
