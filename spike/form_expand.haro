# form_expand.haro -- INCLUDES, ON a FORM and a quantifier over a FORM, resolved by the meta-court (Haro v0.33; Central's item 4, stzzui's S5, and S14).
#
# All three are SUGAR with a definition: the court, the forge and cond_lib.haro never see them, and the court forged from a language written with them is
# byte-identical to the one forged from the same language written out by hand (haro_forge.py --stage=38 compares the two). This file is loaded by the
# meta-court only (haro_lib.haro), so the court library every court loads does not grow.
#
#   INCLUDES [form, ...]  on a DECLARATION: the seats of the FORMs first, in order, then the kind's own SEATS; a seat may come once
#   ON form               on a CONSTRAINT: made once for each kind that includes the FORM, named <constraint>_<kind>
#   some | all | earlier | exists FORM  in a condition: the `or` (`and` for all) of the quantifier over each kind that includes the FORM; a name that is already a seat of
#                         the constraint's kind keeps its meaning, so no reading that existed changes
#
# The expansion of a condition is made on its parse and printed back by CondPrint, the canonical text: tokens joined by single spaces, a quantifier always in
# parentheses, an `or` under an `and` (or either under a `not`) in parentheses. A condition with nothing to expand is never parsed or printed: it is stored as written.
# Functions only. $bFormChanged is born by StzuExpandCond.

# ---- the canonical text of a condition ----------------------------------------------------------------------------------------

func CondIsBareWord(tV)
	if Len(tV) = 0 return false end
	for i = 1 to Len(tV)
		if not CondIsWordChar(tV[i]) return false end
	end
	return true
end
# a value: a number, or a bare word where a bare word is a value (the right of = and != and a quantifier's named, and after contains), else quoted
func CondPrintVal(tV, bBare)
	if CondIsNumberText(tV) return tV end
	if bBare and CondIsBareWord(tV) and tV != "this" and tV != "self" return tV end
	return "'" + tV + "'"
end
func CondPrintRight(xR, bBare)
	if xR[1] = "path" return CondPathText(xR) end
	return CondPrintVal(xR[2], bBare)
end
func CondPrint(xAst)
	return CondPrintP(xAst, 0)
end
# nCtx is the precedence the context needs: or 1, and 2, not 3, an atom 4; a node of lower precedence is parenthesised
func CondPrintP(xAst, nCtx)
	xK = xAst[1]
	if xK = "or"
		tC = CondPrintP(xAst[2], 1) + " or " + CondPrintP(xAst[3], 2)
		if nCtx > 1 return "(" + tC + ")" end
		return tC
	end
	if xK = "and"
		tC = CondPrintP(xAst[2], 2) + " and " + CondPrintP(xAst[3], 3)
		if nCtx > 2 return "(" + tC + ")" end
		return tC
	end
	if xK = "not" return "not " + CondPrintP(xAst[2], 3) end
	if xK = "exists" return "exists " + xAst[2] end
	if xK = "quant"
		tC = "(" + xAst[2] + " " + CondPathText(xAst[3])
		if not IsEmpty(xAst[4]) tC += " named " + CondPrintRight(xAst[4], true) end
		if not IsEmpty(xAst[5]) tC += " where " + CondPrintP(xAst[5], 0) end
		return tC + ")"
	end
	if xK = "cmp"
		if xAst[2] = ">" or xAst[2] = "<" return CondPathText(xAst[3]) + " " + xAst[2] + " " + xAst[4][2] end
		return CondPathText(xAst[3]) + " " + xAst[2] + " " + CondPrintRight(xAst[4], true)
	end
	if xK = "has" return CondPathText(xAst[3]) + " " + xAst[2] end
	if xK = "contains" return CondPathText(xAst[2]) + " contains " + CondPrintVal(xAst[3], true) end
	if xK = "rel" return CondPathText(xAst[3]) + " " + xAst[2] + " " + CondPrintRight(xAst[4], false) end
	if xK = "cyclic" return CondPathText(xAst[2]) + " cyclic" end
	if xK = "matches" return CondPathText(xAst[2]) + " matches " + xAst[3] end
	if xK = "is" return "self is " + xAst[2] end
	if xK = "reach" return CondPathText(xAst[2]) + " reachable" end
	if xK = "refd" return CondPathText(xAst[2]) + " referenced" end
	if xK = "keyed" return CondPathText(xAst[2]) + " keyed_by " + CondPrintRight(xAst[3], false) end
	Raise("condition: no printing for a node of kind '" + xK + "'")
end
# a parsed condition as one line, every string length-free and quoted: two conditions are one when their dumps are
func CondDump(xX)
	if IsEmpty(xX) return "NULL" end
	if IsString(xX) return '"' + xX + '"' end
	tOut = "["
	for i = 1 to Len(xX)
		if i > 1 tOut += " " end
		tOut += CondDump(xX[i])
	end
	return tOut + "]"
end
# ---- the kinds that include a FORM ---------------------------------------------------------------------------------------------

# [[form, [kind, ...]], ...] in the order the kinds are declared; only a FORM some kind includes is in it (a name that is no FORM is a finding of INCLUDES, and the language is refused)
func StzuFormTable(xDecls)
	vTab = []
	for i = 1 to Len(xDecls)
		if Len(xDecls[i]) < 9 loop end
		xInc = xDecls[i][9]
		for j = 1 to Len(xInc)
			nAt = StzuFormAt(vTab, xInc[j])
			if nAt = 0
				xNew = [xInc[j], [xDecls[i][1]]]
				vTab + xNew
			else
				vTab[nAt][2] + xDecls[i][1]
			end
		end
	end
	return vTab
end
func StzuFormAt(vTab, tName)
	for i = 1 to Len(vTab)
		if vTab[i][1] = tName return i end
	end
	return 0
end
# ---- INCLUDES -----------------------------------------------------------------------------------------------------------------

func StzuSeatSource(tForm)
	if tForm = "" return "its own SEATS" end
	return "the FORM '" + tForm + "'"
end
# each declaration that includes FORMs gets the seats of the FORMs first, then its own; a refusal marks the declaration unresolved
func StzuExpandIncludes(xDecls, vForms, vDeclared)
	for i = 1 to Len(xDecls)
		if Len(xDecls[i]) < 9 loop end
		xInc = xDecls[i][9]
		if Len(xInc) = 0 loop end
		try
			xNew = []
			vSrc = []
			for j = 1 to Len(xInc)
				tF = xInc[j]
				tK = DeclaredKind(vDeclared, tF)
				if tK = "" StzuFail(xDecls[i][5], "INCLUDES: '" + tF + "' resolves to nothing in this declaration") end
				if tK != "FORM" StzuFail(xDecls[i][5], "INCLUDES must name a FORM; '" + tF + "' is a " + tK) end
				for m = 1 to j - 1
					if xInc[m] = tF StzuFail(xDecls[i][5], "INCLUDES names '" + tF + "' twice") end
				end
				xFS = []
				for m = 1 to Len(vForms)
					if vForms[m][1] = tF xFS = vForms[m][2] end
				end
				for m = 1 to Len(xFS)
					for q = 1 to Len(xNew)
						if xNew[q][1] = xFS[m][1]
							StzuFail(xDecls[i][5], "seat '" + xFS[m][1] + "' of " + xDecls[i][1] + " comes twice: from " + StzuSeatSource(vSrc[q]) + " and from " + StzuSeatSource(tF))
						end
					end
					xNew + xFS[m]
					vSrc + tF
				end
			end
			xOwn = xDecls[i][3]
			for m = 1 to Len(xOwn)
				for q = 1 to Len(xNew)
					if xNew[q][1] = xOwn[m][1]
						StzuFail(xDecls[i][5], "seat '" + xOwn[m][1] + "' of " + xDecls[i][1] + " comes twice: from " + StzuSeatSource(vSrc[q]) + " and from " + StzuSeatSource(""))
					end
				end
				xNew + xOwn[m]
				vSrc + ""
			end
			xDecls[i][3] = xNew
		catch
			StzuNote(cCatchError)
			$vStzuUnresolved + xDecls[i][1]
		end
	end
	return xDecls
end
# ---- a quantifier over a FORM, and ON a FORM -----------------------------------------------------------------------------------

# the fold of one node per kind: or (and, for all) in the order the kinds are declared
func StzuFoldNodes(tOp, vNodes)
	xR = vNodes[1]
	for j = 2 to Len(vNodes)
		xN = [tOp, xR, vNodes[j]]
		xR = xN
	end
	return xR
end
func StzuFormAst(xAst, tOn, vTab, xDecls)
	xK = xAst[1]
	if xK = "or" or xK = "and"
		xL = StzuFormAst(xAst[2], tOn, vTab, xDecls)
		xR = StzuFormAst(xAst[3], tOn, vTab, xDecls)
		xN = [xK, xL, xR]
		return xN
	end
	if xK = "not"
		xC = StzuFormAst(xAst[2], tOn, vTab, xDecls)
		xN = ["not", xC]
		return xN
	end
	if xK = "exists"
		nF = StzuFormAt(vTab, xAst[2])
		if nF > 0
			$bFormChanged = true
			vNodes = []
			for j = 1 to Len(vTab[nF][2])
				xE = ["exists", vTab[nF][2][j]]
				vNodes + xE
			end
			return StzuFoldNodes("or", vNodes)
		end
		return xAst
	end
	if xK = "quant"
		xCond = xAst[5]
		if not IsEmpty(xCond) xCond = StzuFormAst(xCond, tOn, vTab, xDecls) end
		tHead = ""
		if Len(xAst[3][2]) = 1 tHead = xAst[3][2][1] end
		nF = 0
		if tHead != "" nF = StzuFormAt(vTab, tHead) end
		# a name that is a seat of the constraint's kind keeps the meaning it had
		if nF > 0 and tOn != ""
			if not IsEmpty(StzuSeatNamed(StzuSeatsOf(xDecls, tOn), tHead)) nF = 0 end
		end
		if nF > 0
			$bFormChanged = true
			vNodes = []
			for j = 1 to Len(vTab[nF][2])
				xP = ["path", [vTab[nF][2][j]]]
				xQ = ["quant", xAst[2], xP, xAst[4], xCond]
				vNodes + xQ
			end
			tOp = "or"
			if xAst[2] = "all" tOp = "and" end
			return StzuFoldNodes(tOp, vNodes)
		end
		xQ = ["quant", xAst[2], xAst[3], xAst[4], xCond]
		return xQ
	end
	return xAst
end
# a condition as written, or its expansion in the canonical text when it quantifies over a FORM some kind includes
func StzuExpandCond(tCond, tOn, vTab, xDecls)
	if Len(vTab) = 0 return tCond end
	$bFormChanged = false
	xAst = ""
	tErr = ""
	try
		xAst = CondParse(tCond)
	catch
		tErr = cCatchError
	end
	# an unreadable condition is the validator's to speak of, in its own words
	if tErr != "" return tCond end
	xNew = StzuFormAst(xAst, tOn, vTab, xDecls)
	if not $bFormChanged return tCond end
	return CondPrint(xNew)
end
func StzuNameIn(tName, xRecs)
	for i = 1 to Len(xRecs)
		if xRecs[i][1] = tName return true end
	end
	return false
end
# the CONSTRAINTs, each ON a FORM made once for each including kind, every condition expanded
func StzuExpandConstraints(xCons, vTab, xDecls, vDeclared)
	if Len(vTab) = 0 return xCons end
	xOut = []
	for i = 1 to Len(xCons)
		xC = xCons[i]
		xExc = []
		if Len(xC) >= 10 xExc = xC[10] end
		nF = StzuFormAt(vTab, xC[2])
		tOnKind = DeclaredKind(vDeclared, xC[2])
		if nF > 0
			xKinds = vTab[nF][2]
			# EXCEPT: the kinds the constraint is not made for, each a kind that includes the FORM, named once, and not all of them
			bErr = false
			xKept = []
			try
				for e = 1 to Len(xExc)
					if DeclaredKind(vDeclared, xExc[e]) = "" StzuFail(xC[6], "EXCEPT: '" + xExc[e] + "' resolves to nothing in this declaration") end
					if not InStrList(xExc[e], xKinds) StzuFail(xC[6], "EXCEPT names '" + xExc[e] + "', which does not include the FORM '" + xC[2] + "'") end
					for m = 1 to e - 1
						if xExc[m] = xExc[e] StzuFail(xC[6], "EXCEPT names '" + xExc[e] + "' twice") end
					end
				end
				for k = 1 to Len(xKinds)
					if not InStrList(xKinds[k], xExc) xKept + xKinds[k] end
				end
				if Len(xKept) = 0 StzuFail(xC[6], "EXCEPT leaves no kind for ON " + xC[2]) end
			catch
				bErr = true
				StzuNote(cCatchError)
			end
			if bErr loop end
			xKinds = xKept
			for k = 1 to Len(xKinds)
				tNm = xC[1] + "_" + xKinds[k]
				if DeclaredKind(vDeclared, tNm) != "" or StzuNameIn(tNm, xOut)
					try
						StzuFail(xC[6], "the constraint '" + tNm + "' that ON " + xC[2] + " makes for " + xKinds[k] + " is already declared -- one namespace, one name, one meaning")
					catch
						StzuNote(cCatchError)
					end
					loop
				end
				xR = xC
				xR[1] = tNm
				xR[2] = xKinds[k]
				xR[3] = StzuExpandCond(xC[3], xKinds[k], vTab, xDecls)
				if xC[4] != "" xR[4] = StzuExpandCond(xC[4], xKinds[k], vTab, xDecls) end
				xOut + xR
			end
		else
			# EXCEPT has something to except only ON a FORM some kind includes; ON anything else it is refused (an unknown ON is the ON check's to speak of)
			if Len(xExc) > 0 and tOnKind != ""
				tWhy = "and '" + xC[2] + "' is a " + tOnKind
				if tOnKind = "FORM" tWhy = "and no DECLARATION includes '" + xC[2] + "'" end
				try
					StzuFail(xC[6], "EXCEPT belongs to a constraint ON a FORM, " + tWhy)
				catch
					StzuNote(cCatchError)
				end
			end
			xR = xC
			xR[3] = StzuExpandCond(xC[3], xC[2], vTab, xDecls)
			if xC[4] != "" xR[4] = StzuExpandCond(xC[4], xC[2], vTab, xDecls) end
			xOut + xR
		end
	end
	return xOut
end
# the VIEWs' WHERE, [name, on, one, named, where, line]
func StzuExpandViews(xViews, vTab, xDecls)
	if Len(vTab) = 0 return xViews end
	for i = 1 to Len(xViews)
		if xViews[i][5] != ""
			xViews[i][5] = StzuExpandCond(xViews[i][5], xViews[i][2], vTab, xDecls)
		end
	end
	return xViews
end
