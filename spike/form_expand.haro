# form_expand.haro -- INCLUDES, ON a FORM and a quantifier over a FORM, resolved by the meta-court (Haro v0.33; Central's item 4, stzzui's S5, and S14).
#
# All three are SUGAR with a definition: the court, the forge and cond_lib.haro never see them, and the court forged from a language written with them is
# byte-identical to the one forged from the same language written out by hand (haro_forge.py --stage=38 compares the two). This file is loaded by the
# meta-court only (haro_lib.haro), so the court library every court loads does not grow.
#
#   INCLUDES [form, ...]  on a DECLARATION: the seats of the FORMs first, in order, then the kind's own SEATS; a seat may come once
#   ON form               on a CONSTRAINT: made once for each kind that includes the FORM, named <constraint>_<kind>
#   some | all | earlier | exists FORM  in a condition: the `or` (`and` for all) of the quantifier over each kind that includes the FORM; a name that is already a seat of
#                         the constraint's kind keeps its meaning, so no reading that existed changes
#
# The expansion of a condition is made on its parse and printed back by CondPrint, the canonical text: tokens joined by single spaces, a quantifier always in
# parentheses, an `or` under an `and` (or either under a `not`) in parentheses. A condition with nothing to expand is never parsed or printed: it is stored as written.
# Functions only. $bFormChanged is born by StzuExpandCond.

# ---- the canonical text of a condition ----------------------------------------------------------------------------------------

func CondIsBareWord(tV)
	if Len(tV) = 0 return false ok
	for i = 1 to Len(tV)
		if not CondIsWordChar(tV[i]) return false ok
	next
	return true

# a value: a number, or a bare word where a bare word is a value (the right of = and != and a quantifier's named, and after contains), else quoted
func CondPrintVal(tV, bBare)
	if CondIsNumberText(tV) return tV ok
	if bBare and CondIsBareWord(tV) and tV != "this" and tV != "self" return tV ok
	return "'" + tV + "'"

func CondPrintRight(aR, bBare)
	if aR[1] = "path" return CondPathText(aR) ok
	return CondPrintVal(aR[2], bBare)

func CondPrint(aAst)
	return CondPrintP(aAst, 0)

# nCtx is the precedence the context needs: or 1, and 2, not 3, an atom 4; a node of lower precedence is parenthesised
func CondPrintP(aAst, nCtx)
	xK = aAst[1]
	if xK = "or"
		tC = CondPrintP(aAst[2], 1) + " or " + CondPrintP(aAst[3], 2)
		if nCtx > 1 return "(" + tC + ")" ok
		return tC
	ok
	if xK = "and"
		tC = CondPrintP(aAst[2], 2) + " and " + CondPrintP(aAst[3], 3)
		if nCtx > 2 return "(" + tC + ")" ok
		return tC
	ok
	if xK = "not" return "not " + CondPrintP(aAst[2], 3) ok
	if xK = "exists" return "exists " + aAst[2] ok
	if xK = "quant"
		tC = "(" + aAst[2] + " " + CondPathText(aAst[3])
		if not IsNull(aAst[4]) tC += " named " + CondPrintRight(aAst[4], true) ok
		if not IsNull(aAst[5]) tC += " where " + CondPrintP(aAst[5], 0) ok
		return tC + ")"
	ok
	if xK = "cmp"
		if aAst[2] = ">" or aAst[2] = "<" return CondPathText(aAst[3]) + " " + aAst[2] + " " + aAst[4][2] ok
		return CondPathText(aAst[3]) + " " + aAst[2] + " " + CondPrintRight(aAst[4], true)
	ok
	if xK = "has" return CondPathText(aAst[3]) + " " + aAst[2] ok
	if xK = "contains" return CondPathText(aAst[2]) + " contains " + CondPrintVal(aAst[3], true) ok
	if xK = "rel" return CondPathText(aAst[3]) + " " + aAst[2] + " " + CondPrintRight(aAst[4], false) ok
	if xK = "cyclic" return CondPathText(aAst[2]) + " cyclic" ok
	if xK = "matches" return CondPathText(aAst[2]) + " matches " + aAst[3] ok
	if xK = "is" return "self is " + aAst[2] ok
	if xK = "reach" return CondPathText(aAst[2]) + " reachable" ok
	if xK = "refd" return CondPathText(aAst[2]) + " referenced" ok
	if xK = "keyed" return CondPathText(aAst[2]) + " keyed_by " + CondPrintRight(aAst[3], false) ok
	Raise("condition: no printing for a node of kind '" + xK + "'")

# a parsed condition as one line, every string length-free and quoted: two conditions are one when their dumps are
func CondDump(xX)
	if IsNull(xX) return "NULL" ok
	if IsString(xX) return '"' + xX + '"' ok
	tOut = "["
	for i = 1 to Len(xX)
		if i > 1 tOut += " " ok
		tOut += CondDump(xX[i])
	next
	return tOut + "]"

# ---- the kinds that include a FORM ---------------------------------------------------------------------------------------------

# [[form, [kind, ...]], ...] in the order the kinds are declared; only a FORM some kind includes is in it (a name that is no FORM is a finding of INCLUDES, and the language is refused)
func StzuFormTable(aDecls)
	aTab = []
	for i = 1 to Len(aDecls)
		if Len(aDecls[i]) < 9 loop ok
		aInc = aDecls[i][9]
		for j = 1 to Len(aInc)
			nAt = StzuFormAt(aTab, aInc[j])
			if nAt = 0
				aNew = [aInc[j], [aDecls[i][1]]]
				aTab + aNew
			else
				aTab[nAt][2] + aDecls[i][1]
			ok
		next
	next
	return aTab

func StzuFormAt(aTab, tName)
	for i = 1 to Len(aTab)
		if aTab[i][1] = tName return i ok
	next
	return 0

# ---- INCLUDES -----------------------------------------------------------------------------------------------------------------

func StzuSeatSource(tForm)
	if tForm = "" return "its own SEATS" ok
	return "the FORM '" + tForm + "'"

# each declaration that includes FORMs gets the seats of the FORMs first, then its own; a refusal marks the declaration unresolved
func StzuExpandIncludes(aDecls, aForms, aDeclared)
	for i = 1 to Len(aDecls)
		if Len(aDecls[i]) < 9 loop ok
		aInc = aDecls[i][9]
		if Len(aInc) = 0 loop ok
		try
			aNew = []
			aSrc = []
			for j = 1 to Len(aInc)
				tF = aInc[j]
				tK = DeclaredKind(aDeclared, tF)
				if tK = "" StzuFail(aDecls[i][5], "INCLUDES: '" + tF + "' resolves to nothing in this declaration") ok
				if tK != "FORM" StzuFail(aDecls[i][5], "INCLUDES must name a FORM; '" + tF + "' is a " + tK) ok
				for m = 1 to j - 1
					if aInc[m] = tF StzuFail(aDecls[i][5], "INCLUDES names '" + tF + "' twice") ok
				next
				aFS = []
				for m = 1 to Len(aForms)
					if aForms[m][1] = tF aFS = aForms[m][2] ok
				next
				for m = 1 to Len(aFS)
					for q = 1 to Len(aNew)
						if aNew[q][1] = aFS[m][1]
							StzuFail(aDecls[i][5], "seat '" + aFS[m][1] + "' of " + aDecls[i][1] + " comes twice: from " + StzuSeatSource(aSrc[q]) + " and from " + StzuSeatSource(tF))
						ok
					next
					aNew + aFS[m]
					aSrc + tF
				next
			next
			aOwn = aDecls[i][3]
			for m = 1 to Len(aOwn)
				for q = 1 to Len(aNew)
					if aNew[q][1] = aOwn[m][1]
						StzuFail(aDecls[i][5], "seat '" + aOwn[m][1] + "' of " + aDecls[i][1] + " comes twice: from " + StzuSeatSource(aSrc[q]) + " and from " + StzuSeatSource(""))
					ok
				next
				aNew + aOwn[m]
				aSrc + ""
			next
			aDecls[i][3] = aNew
		catch
			StzuNote(cCatchError)
			$aStzuUnresolved + aDecls[i][1]
		done
	next
	return aDecls

# ---- a quantifier over a FORM, and ON a FORM -----------------------------------------------------------------------------------

# the fold of one node per kind: or (and, for all) in the order the kinds are declared
func StzuFoldNodes(tOp, aNodes)
	aR = aNodes[1]
	for j = 2 to Len(aNodes)
		aN = [tOp, aR, aNodes[j]]
		aR = aN
	next
	return aR

func StzuFormAst(aAst, tOn, aTab, aDecls)
	xK = aAst[1]
	if xK = "or" or xK = "and"
		aL = StzuFormAst(aAst[2], tOn, aTab, aDecls)
		aR = StzuFormAst(aAst[3], tOn, aTab, aDecls)
		aN = [xK, aL, aR]
		return aN
	ok
	if xK = "not"
		aC = StzuFormAst(aAst[2], tOn, aTab, aDecls)
		aN = ["not", aC]
		return aN
	ok
	if xK = "exists"
		nF = StzuFormAt(aTab, aAst[2])
		if nF > 0
			$bFormChanged = true
			aNodes = []
			for j = 1 to Len(aTab[nF][2])
				aE = ["exists", aTab[nF][2][j]]
				aNodes + aE
			next
			return StzuFoldNodes("or", aNodes)
		ok
		return aAst
	ok
	if xK = "quant"
		aCond = aAst[5]
		if not IsNull(aCond) aCond = StzuFormAst(aCond, tOn, aTab, aDecls) ok
		tHead = ""
		if Len(aAst[3][2]) = 1 tHead = aAst[3][2][1] ok
		nF = 0
		if tHead != "" nF = StzuFormAt(aTab, tHead) ok
		# a name that is a seat of the constraint's kind keeps the meaning it had
		if nF > 0 and tOn != ""
			if not IsNull(StzuSeatNamed(StzuSeatsOf(aDecls, tOn), tHead)) nF = 0 ok
		ok
		if nF > 0
			$bFormChanged = true
			aNodes = []
			for j = 1 to Len(aTab[nF][2])
				aP = ["path", [aTab[nF][2][j]]]
				aQ = ["quant", aAst[2], aP, aAst[4], aCond]
				aNodes + aQ
			next
			tOp = "or"
			if aAst[2] = "all" tOp = "and" ok
			return StzuFoldNodes(tOp, aNodes)
		ok
		aQ = ["quant", aAst[2], aAst[3], aAst[4], aCond]
		return aQ
	ok
	return aAst

# a condition as written, or its expansion in the canonical text when it quantifies over a FORM some kind includes
func StzuExpandCond(tCond, tOn, aTab, aDecls)
	if Len(aTab) = 0 return tCond ok
	$bFormChanged = false
	aAst = null
	tErr = ""
	try
		aAst = CondParse(tCond)
	catch
		tErr = cCatchError
	done
	# an unreadable condition is the validator's to speak of, in its own words
	if tErr != "" return tCond ok
	aNew = StzuFormAst(aAst, tOn, aTab, aDecls)
	if not $bFormChanged return tCond ok
	return CondPrint(aNew)

func StzuNameIn(tName, aRecs)
	for i = 1 to Len(aRecs)
		if aRecs[i][1] = tName return true ok
	next
	return false

# the CONSTRAINTs, each ON a FORM made once for each including kind, every condition expanded
func StzuExpandConstraints(aCons, aTab, aDecls, aDeclared)
	if Len(aTab) = 0 return aCons ok
	aOut = []
	for i = 1 to Len(aCons)
		aC = aCons[i]
		aExc = []
		if Len(aC) >= 10 aExc = aC[10] ok
		nF = StzuFormAt(aTab, aC[2])
		tOnKind = DeclaredKind(aDeclared, aC[2])
		if nF > 0
			aKinds = aTab[nF][2]
			# EXCEPT: the kinds the constraint is not made for, each a kind that includes the FORM, named once, and not all of them
			bErr = false
			aKept = []
			try
				for e = 1 to Len(aExc)
					if DeclaredKind(aDeclared, aExc[e]) = "" StzuFail(aC[6], "EXCEPT: '" + aExc[e] + "' resolves to nothing in this declaration") ok
					if not InStrList(aExc[e], aKinds) StzuFail(aC[6], "EXCEPT names '" + aExc[e] + "', which does not include the FORM '" + aC[2] + "'") ok
					for m = 1 to e - 1
						if aExc[m] = aExc[e] StzuFail(aC[6], "EXCEPT names '" + aExc[e] + "' twice") ok
					next
				next
				for k = 1 to Len(aKinds)
					if not InStrList(aKinds[k], aExc) aKept + aKinds[k] ok
				next
				if Len(aKept) = 0 StzuFail(aC[6], "EXCEPT leaves no kind for ON " + aC[2]) ok
			catch
				bErr = true
				StzuNote(cCatchError)
			done
			if bErr loop ok
			aKinds = aKept
			for k = 1 to Len(aKinds)
				tNm = aC[1] + "_" + aKinds[k]
				if DeclaredKind(aDeclared, tNm) != "" or StzuNameIn(tNm, aOut)
					try
						StzuFail(aC[6], "the constraint '" + tNm + "' that ON " + aC[2] + " makes for " + aKinds[k] + " is already declared -- one namespace, one name, one meaning")
					catch
						StzuNote(cCatchError)
					done
					loop
				ok
				aR = aC
				aR[1] = tNm
				aR[2] = aKinds[k]
				aR[3] = StzuExpandCond(aC[3], aKinds[k], aTab, aDecls)
				if aC[4] != "" aR[4] = StzuExpandCond(aC[4], aKinds[k], aTab, aDecls) ok
				aOut + aR
			next
		else
			# EXCEPT has something to except only ON a FORM some kind includes; ON anything else it is refused (an unknown ON is the ON check's to speak of)
			if Len(aExc) > 0 and tOnKind != ""
				tWhy = "and '" + aC[2] + "' is a " + tOnKind
				if tOnKind = "FORM" tWhy = "and no DECLARATION includes '" + aC[2] + "'" ok
				try
					StzuFail(aC[6], "EXCEPT belongs to a constraint ON a FORM, " + tWhy)
				catch
					StzuNote(cCatchError)
				done
			ok
			aR = aC
			aR[3] = StzuExpandCond(aC[3], aC[2], aTab, aDecls)
			if aC[4] != "" aR[4] = StzuExpandCond(aC[4], aC[2], aTab, aDecls) ok
			aOut + aR
		ok
	next
	return aOut

# the VIEWs' WHERE, [name, on, one, named, where, line]
func StzuExpandViews(aViews, aTab, aDecls)
	if Len(aTab) = 0 return aViews ok
	for i = 1 to Len(aViews)
		if aViews[i][5] != ""
			aViews[i][5] = StzuExpandCond(aViews[i][5], aViews[i][2], aTab, aDecls)
		ok
	next
	return aViews
