# pattern_lib.haro -- pattern rules over blocks (COMPASS-REBOL-07, step 2 of BLOCKS.md 3.5; Haro v0.31).
#
# A rule is C6 text -- a list -- read by the one LOAD (block_lib.haro), so a grammar is data. PatDeclare compiles a set of named
# rules and either refuses it, naming why, or yields rules that are TOTAL by construction:
#   no recursion            the named rules form a DAG
#   every repetition moves  ANY, SOME and TO over a rule that can match nothing are refused (a nullable analysis)
#   no host                 a group in a rule, WHILE DO EVAL IF, and the editing words CHANGE INSERT REMOVE are refused
#   INTO descends           into a strictly smaller value, so depth is bounded by the input's
# PatRun matches by PEG (ordered choice that commits, greedy repetition) with a packrat memo: a (node, sequence, position) is
# computed once, so a match costs at most (rule nodes x input positions) steps. The reference is study/rebol/pattern.py; the
# judge is v31/fixtures.json, written first; the court runs both and refuses a difference by name (D43).
#
# Nodes live in $aPatNodes as [kind, a, b, c]; a sequence of values is an id into $aPatSeq*; the engine passes integer ids,
# never lists, because a list assigned is a list copied. Functions only: the globals are born in the root file (pattern.haro).
#   $aPatNodes $nPatNodes   $aPatNames $aPatRoots $aPatNull $aPatState   $aPatSetNames $aPatSetMembers
#   $aPatSeqVals $aPatSeqKinds $aPatSeqLen $aPatSeqBase $aPatSeqKids   $aPatMemo $nPatMemoTop $nPatSteps

load "block_lib.haro"

func PatFail(tMsg)
	Raise(tMsg)

func PatReset
	$aPatNodes = []
	$nPatNodes = 0
	$aPatNames = []
	$aPatRoots = []
	$aPatNull = []
	$aPatState = []
	$aPatSetNames = []
	$aPatSetMembers = []
	$aPatSeqVals = []
	$aPatSeqKinds = []
	$aPatSeqLen = []
	$aPatSeqBase = []
	$aPatSeqKids = []
	$aPatMemo = []
	$nPatMemoTop = 0
	$nPatSteps = 0

# ---- the words ---------------------------------------------------------------------------------------------------------

# the value kind a type word matches; "*" is SKIP (any one value); "" is no type word
func PatTypeOf(tW)
	if tW = "WORD" return "word" end
	if tW = "STRING" return "str" end
	if tW = "NUMBER" return "num" end
	if tW = "KEYWORD" return "kw" end
	if tW = "PATH" return "path" end
	if tW = "PAIR" return "pair" end
	if tW = "LIST" return "list" end
	if tW = "GROUP" return "group" end
	if tW = "ROW" return "row" end
	if tW = "OPTIONAL" return "opt" end
	if tW = "SKIP" return "*" end
	return ""

func PatRefusedMsg(tW)
	if tW = "WHILE" return "WHILE is refused: a pattern rule is total, and WHILE is how Parse loops without consuming" end
	if tW = "DO" return "DO is refused: a pattern rule runs nothing" end
	if tW = "EVAL" return "EVAL is refused: a pattern rule runs nothing" end
	if tW = "IF" return "IF is refused: a condition is a rule, never host code" end
	if tW = "CHANGE" return "CHANGE is refused: a pattern judges and never edits" end
	if tW = "INSERT" return "INSERT is refused: a pattern judges and never edits" end
	if tW = "REMOVE" return "REMOVE is refused: a pattern judges and never edits" end
	return ""

func PatIsUnary(tW)
	return tW = "OPT" or tW = "ANY" or tW = "SOME" or tW = "NOT" or tW = "AHEAD" or tW = "INTO" or tW = "TO" or tW = "THRU" or tW = "COLLECT" or tW = "KEEP"

func PatNew(tKind, xA, xB, xC)
	$aPatNodes + [tKind, xA, xB, xC]
	$nPatNodes++
	return $nPatNodes

# ---- compiling a rule --------------------------------------------------------------------------------------------------

# a list's items, the rows spread into their values and the comments dropped
func PatFlat(aItems)
	aOut = []
	for i = 1 to Len(aItems)
		xV = aItems[i]
		if xV[1] = "row"
			for j = 1 to Len(xV[2])
				aOut + xV[2][j]
			end
		elseif xV[1] != "comment"
			aOut + xV
		end
	end
	return aOut

func PatCount(tText, tWhere)
	bOk = Len(tText) > 0
	for i = 1 to Len(tText)
		if not BlkIsDigit(tText[i]) bOk = false end
	end
	if not bOk
		PatFail("pattern " + tWhere + ": REPEAT takes a whole count of zero or more, found " + tText)
	end
	return Number(tText)

func PatCompileRule(tText, tWhere)
	aAll = BlkLoad(tText)
	aVals = []
	for i = 1 to Len(aAll)
		if aAll[i][1] != "comment" aVals + aAll[i] end
	end
	if Len(aVals) != 1 or aVals[1][1] != "list"
		PatFail("pattern " + tWhere + " is not a list: a rule is written [ ... ]")
	end
	return PatAlt(PatFlat(aVals[1][2]), tWhere)

func PatAlt(aSeq, tWhere)
	aBranches = []
	aCur = []
	for i = 1 to Len(aSeq)
		xV = aSeq[i]
		if xV[1] = "kw" and xV[2] = "OR"
			aBranches + aCur
			aCur = []
		else
			aCur + xV
		end
	end
	aBranches + aCur
	if Len(aBranches) > 1
		for i = 1 to Len(aBranches)
			if Len(aBranches[i]) = 0
				PatFail("pattern " + tWhere + ": OR needs a rule on each side")
			end
		end
	end
	aNodes = []
	for i = 1 to Len(aBranches)
		aNodes + PatSequence(aBranches[i], tWhere)
	end
	if Len(aNodes) = 1 return aNodes[1] end
	return PatNew("alt", aNodes, 0, 0)

func PatSequence(aSeq, tWhere)
	aOut = []
	nPos = 1
	while true
		aR = PatItem(aSeq, nPos, tWhere)
		if aR[1] = 0 exit end
		aOut + aR[1]
		nPos = aR[2]
	end
	return PatNew("seq", aOut, 0, 0)

# one item of a sequence: [node id, the next position], or [0, ...] when the sequence is spent
func PatItem(aSeq, nPos, tWhere)
	if nPos > Len(aSeq) return [0, nPos] end
	xV = aSeq[nPos]
	nPos++
	tK = xV[1]
	if tK = "kw"
		tW = xV[2]
		tT = PatTypeOf(tW)
		if tT != "" return [PatNew("type", tT, 0, 0), nPos] end
		if tW = "END" return [PatNew("end", 0, 0, 0), nPos] end
		tMsg = PatRefusedMsg(tW)
		if tMsg != ""
			PatFail("pattern " + tWhere + ": " + tMsg)
		end
		if PatIsUnary(tW)
			aX = PatItem(aSeq, nPos, tWhere)
			if aX[1] = 0
				PatFail("pattern " + tWhere + ": " + tW + " takes a rule")
			end
			return [PatNew(Lower(tW), aX[1], 0, 0), aX[2]]
		end
		if tW = "REPEAT"
			if nPos > Len(aSeq)
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			if aSeq[nPos][1] != "num"
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			nMin = PatCount(aSeq[nPos][2], tWhere)
			nPos++
			nMax = nMin
			if nPos <= Len(aSeq)
				if aSeq[nPos][1] = "num"
					nMax = PatCount(aSeq[nPos][2], tWhere)
					nPos++
				end
			end
			if nMax < nMin
				PatFail("pattern " + tWhere + ": REPEAT " + String(nMin) + " " + String(nMax) + ": its minimum is above its maximum")
			end
			aX = PatItem(aSeq, nPos, tWhere)
			if aX[1] = 0
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			return [PatNew("repeat", nMin, nMax, aX[1]), aX[2]]
		end
		if tW = "RULE" or tW = "MEMBER"
			if nPos > Len(aSeq)
				PatFail("pattern " + tWhere + ": " + tW + " takes a name")
			end
			if aSeq[nPos][1] != "word"
				PatFail("pattern " + tWhere + ": " + tW + " takes a name")
			end
			tName = aSeq[nPos][2]
			nPos++
			if tW = "RULE" return [PatNew("ref", tName, 0, 0), nPos] end
			return [PatNew("member", tName, 0, 0), nPos]
		end
		if tW = "LIT"
			if nPos > Len(aSeq)
				PatFail("pattern " + tWhere + ": LIT takes a value")
			end
			xX = aSeq[nPos]
			nPos++
			return [PatNew("lit", xX, 0, 0), nPos]
		end
		PatFail("pattern " + tWhere + ": " + tW + " is not a pattern word")
	end
	if tK = "list"
		return [PatNew("sub", PatAlt(PatFlat(xV[2]), tWhere), 0, 0), nPos]
	end
	if tK = "group"
		PatFail("pattern " + tWhere + ": ( ) in a rule would run the host (Parse's paren!): refused")
	end
	return [PatNew("lit", xV, 0, 0), nPos]

# ---- declaring a set of rules: the bound is checked here, once, never at match time -------------------------------------------

func PatChildren(nNode)
	aN = $aPatNodes[nNode]
	tK = aN[1]
	if tK = "seq" or tK = "alt" return aN[2] end
	if tK = "sub" return [aN[2]] end
	if tK = "repeat" return [aN[4]] end
	if PatIsUnary(Upper(tK)) return [aN[2]] end
	return []

# the names a node refers to, as RULE (cWhat "ref") or as MEMBER ("member"), in the order the reference finds them
func PatNamesIn(nNode, tWhat)
	aOut = []
	aN = $aPatNodes[nNode]
	if aN[1] = tWhat aOut + aN[2] end
	aKids = PatChildren(nNode)
	for i = 1 to Len(aKids)
		aMore = PatNamesIn(aKids[i], tWhat)
		for j = 1 to Len(aMore)
			aOut + aMore[j]
		end
	end
	return aOut

func PatNullable(nNode)
	aN = $aPatNodes[nNode]
	tK = aN[1]
	if tK = "type" or tK = "lit" or tK = "member" or tK = "into" return false end
	if tK = "end" or tK = "opt" or tK = "any" or tK = "not" or tK = "ahead" or tK = "to" return true end
	if tK = "some" or tK = "thru" or tK = "collect" or tK = "keep" or tK = "sub" return PatNullable(aN[2]) end
	if tK = "repeat"
		if aN[2] = 0 return true end
		return PatNullable(aN[4])
	end
	if tK = "seq"
		for i = 1 to Len(aN[2])
			if not PatNullable(aN[2][i]) return false end
		end
		return true
	end
	if tK = "alt"
		for i = 1 to Len(aN[2])
			if PatNullable(aN[2][i]) return true end
		end
		return false
	end
	if tK = "ref"
		nR = Find($aPatNames, aN[2])
		if $aPatNull[nR] = 0
			if PatNullable($aPatRoots[nR])
				$aPatNull[nR] = 1
			else
				$aPatNull[nR] = 2
			end
		end
		return $aPatNull[nR] = 1
	end
	return false

func PatCheck(nNode, tName)
	aN = $aPatNodes[nNode]
	tK = aN[1]
	if tK = "any" or tK = "some" or tK = "to"
		if PatNullable(aN[2])
			PatFail("pattern " + tName + ": " + Upper(tK) + " over a rule that can match nothing: it would never move, so it is refused")
		end
	end
	aKids = PatChildren(nNode)
	for i = 1 to Len(aKids)
		PatCheck(aKids[i], tName)
	end

func PatVisit(nRule, aPath)
	if $aPatState[nRule] = 1
		tName = $aPatNames[nRule]
		nAt = Find(aPath, tName)
		aCyc = []
		for i = nAt to Len(aPath)
			aCyc + aPath[i]
		end
		aCyc + tName
		tJoin = BlkJoin(aCyc, " -> ")
		PatFail("pattern " + aCyc[1] + " is recursive (" + tJoin + "): a pattern rule refers only to rules that end")
	end
	if $aPatState[nRule] = 2 return end
	$aPatState[nRule] = 1
	aRefs = PatNamesIn($aPatRoots[nRule], "ref")
	aNext = aPath
	aNext + $aPatNames[nRule]
	for i = 1 to Len(aRefs)
		PatVisit(Find($aPatNames, aRefs[i]), aNext)
	end
	$aPatState[nRule] = 2

# aNames and aTexts are the rules in declaration order; aSetNames and aSetMembers the sets the court collected
func PatDeclare(aNames, aTexts, aSetNames, aSetMembers)
	PatReset()
	$aPatSetNames = aSetNames
	$aPatSetMembers = aSetMembers
	for i = 1 to Len(aNames)
		$aPatNames + aNames[i]
		$aPatRoots + PatCompileRule(aTexts[i], aNames[i])
		$aPatNull + 0
		$aPatState + 0
	end
	for i = 1 to Len(aNames)
		aRefs = PatNamesIn($aPatRoots[i], "ref")
		for j = 1 to Len(aRefs)
			if Find($aPatNames, aRefs[j]) = 0
				PatFail("pattern " + aNames[i] + ": RULE " + aRefs[j] + " names no pattern")
			end
		end
		aMems = PatNamesIn($aPatRoots[i], "member")
		for j = 1 to Len(aMems)
			if Find($aPatSetNames, aMems[j]) = 0
				PatFail("pattern " + aNames[i] + ": MEMBER " + aMems[j] + " names no set")
			end
		end
	end
	for i = 1 to Len(aNames)
		PatVisit(i, [])
	end
	for i = 1 to Len(aNames)
		PatCheck($aPatRoots[i], aNames[i])
	end

# ---- matching: PEG with a packrat memo ---------------------------------------------------------------------------------------

# a sequence of values becomes an id; its memo is a block of (length + 1) x nodes slots in $aPatMemo
func PatNewSeq(aValues)
	nN = Len(aValues)
	aKinds = []
	for i = 1 to nN
		aKinds + aValues[i][1]
	end
	$aPatSeqVals + aValues
	$aPatSeqKinds + aKinds
	$aPatSeqLen + nN
	$aPatSeqBase + $nPatMemoTop
	if nN > 0
		$aPatSeqKids + List(nN)
	else
		$aPatSeqKids + []
	end
	$nPatMemoTop += (nN + 1) * $nPatNodes
	return Len($aPatSeqLen)

func PatExtend(aKept, aMore)
	for i = 1 to Len(aMore)
		aKept + aMore[i]
	end
	return aKept

func PatPositions(aVals)
	nTotal = 1
	for i = 1 to Len(aVals)
		xV = aVals[i]
		tK = xV[1]
		if tK != "comment"
			nTotal++
			if tK = "list" or tK = "group" or tK = "row"
				nTotal += PatPositions(xV[2])
			elseif tK = "pair"
				nTotal += PatPositions([xV[2], xV[3]])
			elseif tK = "opt"
				nTotal += PatPositions([xV[2]])
			end
		end
	end
	return nTotal

func PatM(nNode, nSeq, nI)
	nIdx = $aPatSeqBase[nSeq] + nI * $nPatNodes + nNode
	aMemo = $aPatMemo[nIdx]
	if IsList(aMemo) return aMemo end
	$nPatSteps++
	aR = PatBody(nNode, nSeq, nI)
	$aPatMemo[nIdx] = aR
	return aR

func PatBody(nNode, nSeq, nI)
	aN = $aPatNodes[nNode]
	tK = aN[1]
	nLen = $aPatSeqLen[nSeq]
	if tK = "seq"
		aKept = []
		nJ = nI
		for c = 1 to Len(aN[2])
			aR = PatM(aN[2][c], nSeq, nJ)
			if not aR[1] return [false, nI, []] end
			nJ = aR[2]
			aKept = PatExtend(aKept, aR[3])
		end
		return [true, nJ, aKept]
	end
	if tK = "type"
		if nI < nLen
			if aN[2] = "*" or $aPatSeqKinds[nSeq][nI + 1] = aN[2] return [true, nI + 1, []] end
		end
		return [false, nI, []]
	end
	if tK = "ref"
		return PatM($aPatRoots[Find($aPatNames, aN[2])], nSeq, nI)
	end
	if tK = "lit"
		if nI < nLen
			if $aPatSeqKinds[nSeq][nI + 1] = aN[2][1]
				if BlkDump($aPatSeqVals[nSeq][nI + 1]) = BlkDump(aN[2]) return [true, nI + 1, []] end
			end
		end
		return [false, nI, []]
	end
	if tK = "alt"
		for c = 1 to Len(aN[2])
			aR = PatM(aN[2][c], nSeq, nI)
			if aR[1] return aR end
		end
		return [false, nI, []]
	end
	if tK = "sub"
		return PatM(aN[2], nSeq, nI)
	end
	if tK = "any" or tK = "some"
		aKept = []
		nJ = nI
		nCount = 0
		while true
			aR = PatM(aN[2], nSeq, nJ)
			if not aR[1] exit end
			if aR[2] = nJ exit end
			aKept = PatExtend(aKept, aR[3])
			nJ = aR[2]
			nCount++
		end
		if tK = "some" and nCount = 0 return [false, nI, []] end
		return [true, nJ, aKept]
	end
	if tK = "into"
		if nI >= nLen return [false, nI, []] end
		tKind = $aPatSeqKinds[nSeq][nI + 1]
		if not (tKind = "list" or tKind = "group" or tKind = "row" or tKind = "pair" or tKind = "opt") return [false, nI, []] end
		nKid = $aPatSeqKids[nSeq][nI + 1]
		if nKid = 0
			xV = $aPatSeqVals[nSeq][nI + 1]
			aInner = []
			if tKind = "list" or tKind = "group"
				for q = 1 to Len(xV[2])
					if xV[2][q][1] != "comment" aInner + xV[2][q] end
				end
			elseif tKind = "row"
				aInner = xV[2]
			elseif tKind = "pair"
				aInner = [xV[2], xV[3]]
			else
				aInner = [xV[2]]
			end
			nKid = PatNewSeq(aInner)
			$aPatSeqKids[nSeq][nI + 1] = nKid
		end
		aR = PatM(aN[2], nKid, 0)
		if aR[1] and aR[2] = $aPatSeqLen[nKid] return [true, nI + 1, aR[3]] end
		return [false, nI, []]
	end
	if tK = "end"
		if nI = nLen return [true, nI, []] end
		return [false, nI, []]
	end
	if tK = "member"
		if nI < nLen
			tKind = $aPatSeqKinds[nSeq][nI + 1]
			if tKind = "word" or tKind = "str" or tKind = "kw" or tKind = "num"
				nSet = Find($aPatSetNames, aN[2])
				if Find($aPatSetMembers[nSet], $aPatSeqVals[nSeq][nI + 1][2]) > 0 return [true, nI + 1, []] end
			end
		end
		return [false, nI, []]
	end
	if tK = "opt"
		aR = PatM(aN[2], nSeq, nI)
		if aR[1] return aR end
		return [true, nI, []]
	end
	if tK = "repeat"
		aKept = []
		nJ = nI
		nCount = 0
		while nCount < aN[3]
			aR = PatM(aN[4], nSeq, nJ)
			if not aR[1] exit end
			aKept = PatExtend(aKept, aR[3])
			nJ = aR[2]
			nCount++
		end
		if nCount >= aN[2] return [true, nJ, aKept] end
		return [false, nI, []]
	end
	if tK = "not"
		aR = PatM(aN[2], nSeq, nI)
		if aR[1] return [false, nI, []] end
		return [true, nI, []]
	end
	if tK = "ahead"
		aR = PatM(aN[2], nSeq, nI)
		if aR[1] return [true, nI, []] end
		return [false, nI, []]
	end
	if tK = "to" or tK = "thru"
		for p = nI to nLen
			aR = PatM(aN[2], nSeq, p)
			if aR[1]
				if tK = "to" return [true, p, []] end
				return [true, aR[2], aR[3]]
			end
		end
		return [false, nI, []]
	end
	if tK = "keep"
		aR = PatM(aN[2], nSeq, nI)
		if not aR[1] return [false, nI, []] end
		aKept = []
		for p = nI + 1 to aR[2]
			aKept + $aPatSeqVals[nSeq][p]
		end
		return [true, aR[2], aKept]
	end
	if tK = "collect"
		aR = PatM(aN[2], nSeq, nI)
		if not aR[1] return [false, nI, []] end
		return [true, aR[2], [["list", aR[3]]]]
	end
	PatFail("pattern: no node of kind " + tK)

# match the text against the rule named cStart (the rules declared by PatDeclare); returns
# [whole, [the values kept], steps, bound]
func PatRun(tStart, tText)
	nRule = Find($aPatNames, tStart)
	if nRule = 0
		PatFail("pattern " + tStart + " names no pattern")
	end
	aAll = BlkLoad(tText)
	aVals = []
	for i = 1 to Len(aAll)
		if aAll[i][1] != "comment" aVals + aAll[i] end
	end
	nBound = $nPatNodes * PatPositions(aVals)
	$aPatMemo = List(nBound)
	$aPatSeqVals = []
	$aPatSeqKinds = []
	$aPatSeqLen = []
	$aPatSeqBase = []
	$aPatSeqKids = []
	$nPatMemoTop = 0
	$nPatSteps = 0
	nSeq = PatNewSeq(aVals)
	nRoot = $aPatRoots[nRule]
	aR = PatM(nRoot, nSeq, 0)
	bWhole = aR[1] and aR[2] = Len(aVals)
	aKept = aR[3]
	aRoot = $aPatNodes[nRoot]
	if bWhole and aRoot[1] = "seq" and Len(aRoot[2]) = 1 and Len(aKept) = 1
		if $aPatNodes[aRoot[2][1]][1] = "collect"
			aKept = aKept[1][2]
		end
	end
	return [bWhole, aKept, $nPatSteps, nBound]

func PatPrintKept(aKept)
	aP = []
	for i = 1 to Len(aKept)
		aP + BlkPrint(aKept[i], 0)
	end
	return BlkJoin(aP, Char(9))
