# pattern_lib.haro -- pattern rules over blocks (COMPASS-REBOL-07, step 2 of BLOCKS.md 3.5; Haro v0.31).
#
# A rule is C6 text -- a list -- read by the one LOAD (block_lib.haro), so a grammar is data. PatDeclare compiles a set of named
# rules and either refuses it, naming why, or yields rules that are TOTAL by construction:
#   no recursion            the named rules form a DAG
#   every repetition moves  ANY, SOME and TO over a rule that can match nothing are refused (a nullable analysis)
#   no host                 a group in a rule, WHILE DO EVAL IF, and the editing words CHANGE INSERT REMOVE are refused
#   INTO descends           into a strictly smaller value, so depth is bounded by the input's
# PatRun matches by PEG (ordered choice that commits, greedy repetition) with a packrat memo: a (node, sequence, position) is
# computed once, so a match costs at most (rule nodes x input positions) steps. The reference is study/rebol/pattern.py; the
# judge is v31/fixtures.json, written first; the court runs both and refuses a difference by name (D43).
#
# Nodes live in $aPatNodes as [kind, a, b, c]; a sequence of values is an id into $aPatSeq*; the engine passes integer ids,
# never lists, because a list assigned is a list copied. Functions only: the globals are born in the root file (pattern.haro).
#   $aPatNodes $nPatNodes   $aPatNames $aPatRoots $aPatNull $aPatState   $aPatSetNames $aPatSetMembers
#   $aPatSeqVals $aPatSeqKinds $aPatSeqLen $aPatSeqBase $aPatSeqKids   $aPatMemo $nPatMemoTop $nPatSteps

load "block_lib.haro"

func PatFail(tMsg)
	Raise(tMsg)
end
func PatReset
	$vPatNodes = []
	$nPatNodes = 0
	$vPatNames = []
	$vPatRoots = []
	$vPatNull = []
	$vPatState = []
	$xPatSetNames = []
	$xPatSetMembers = []
	$vPatSeqVals = []
	$vPatSeqKinds = []
	$vPatSeqLen = []
	$vPatSeqBase = []
	$vPatSeqKids = []
	$xPatMemo = []
	$nPatMemoTop = 0
	$nPatSteps = 0
end
# ---- the words ---------------------------------------------------------------------------------------------------------

# the value kind a type word matches; "*" is SKIP (any one value); "" is no type word
func PatTypeOf(tW)
	if tW = "WORD" return "word" end
	if tW = "STRING" return "str" end
	if tW = "NUMBER" return "num" end
	if tW = "KEYWORD" return "kw" end
	if tW = "PATH" return "path" end
	if tW = "PAIR" return "pair" end
	if tW = "LIST" return "list" end
	if tW = "GROUP" return "group" end
	if tW = "ROW" return "row" end
	if tW = "OPTIONAL" return "opt" end
	if tW = "SKIP" return "*" end
	return ""
end
func PatRefusedMsg(tW)
	if tW = "WHILE" return "WHILE is refused: a pattern rule is total, and WHILE is how Parse loops without consuming" end
	if tW = "DO" return "DO is refused: a pattern rule runs nothing" end
	if tW = "EVAL" return "EVAL is refused: a pattern rule runs nothing" end
	if tW = "IF" return "IF is refused: a condition is a rule, never host code" end
	if tW = "CHANGE" return "CHANGE is refused: a pattern judges and never edits" end
	if tW = "INSERT" return "INSERT is refused: a pattern judges and never edits" end
	if tW = "REMOVE" return "REMOVE is refused: a pattern judges and never edits" end
	return ""
end
func PatIsUnary(tW)
	return tW = "OPT" or tW = "ANY" or tW = "SOME" or tW = "NOT" or tW = "AHEAD" or tW = "INTO" or tW = "TO" or tW = "THRU" or tW = "COLLECT" or tW = "KEEP"
end
func PatNew(tKind, xA, xB, xC)
	$vPatNodes + [tKind, xA, xB, xC]
	$nPatNodes++
	return $nPatNodes
end
# ---- compiling a rule --------------------------------------------------------------------------------------------------

# a list's items, the rows spread into their values and the comments dropped
func PatFlat(xItems)
	xOut = []
	for i = 1 to Len(xItems)
		xV = xItems[i]
		if xV[1] = "row"
			for j = 1 to Len(xV[2])
				xOut + xV[2][j]
			end
		elseif xV[1] != "comment"
			xOut + xV
		end
	end
	return xOut
end
func PatCount(tText, tWhere)
	bOk = Len(tText) > 0
	for i = 1 to Len(tText)
		if not BlkIsDigit(tText[i]) bOk = false end
	end
	if not bOk
		PatFail("pattern " + tWhere + ": REPEAT takes a whole count of zero or more, found " + tText)
	end
	return Number(tText)
end
func PatCompileRule(tText, tWhere)
	xAll = BlkLoad(tText)
	vVals = []
	for i = 1 to Len(xAll)
		if xAll[i][1] != "comment" vVals + xAll[i] end
	end
	if Len(vVals) != 1 or vVals[1][1] != "list"
		PatFail("pattern " + tWhere + " is not a list: a rule is written [ ... ]")
	end
	return PatAlt(PatFlat(vVals[1][2]), tWhere)
end
func PatAlt(xSeq, tWhere)
	vBranches = []
	xCur = []
	for i = 1 to Len(xSeq)
		xV = xSeq[i]
		if xV[1] = "kw" and xV[2] = "OR"
			vBranches + xCur
			xCur = []
		else
			xCur + xV
		end
	end
	vBranches + xCur
	if Len(vBranches) > 1
		for i = 1 to Len(vBranches)
			if Len(vBranches[i]) = 0
				PatFail("pattern " + tWhere + ": OR needs a rule on each side")
			end
		end
	end
	vNodes = []
	for i = 1 to Len(vBranches)
		vNodes + PatSequence(vBranches[i], tWhere)
	end
	if Len(vNodes) = 1 return vNodes[1] end
	return PatNew("alt", vNodes, 0, 0)
end
func PatSequence(xSeq, tWhere)
	xOut = []
	nPos = 1
	while true
		xR = PatItem(xSeq, nPos, tWhere)
		if xR[1] = 0 exit end
		xOut + xR[1]
		nPos = xR[2]
	end
	return PatNew("seq", xOut, 0, 0)
end
# one item of a sequence: [node id, the next position], or [0, ...] when the sequence is spent
func PatItem(xSeq, nPos, tWhere)
	if nPos > Len(xSeq) return [0, nPos] end
	xV = xSeq[nPos]
	nPos++
	tK = xV[1]
	if tK = "kw"
		tW = xV[2]
		tT = PatTypeOf(tW)
		if tT != "" return [PatNew("type", tT, 0, 0), nPos] end
		if tW = "END" return [PatNew("end", 0, 0, 0), nPos] end
		tMsg = PatRefusedMsg(tW)
		if tMsg != ""
			PatFail("pattern " + tWhere + ": " + tMsg)
		end
		if PatIsUnary(tW)
			xItem = PatItem(xSeq, nPos, tWhere)
			if xItem[1] = 0
				PatFail("pattern " + tWhere + ": " + tW + " takes a rule")
			end
			return [PatNew(Lower(tW), xItem[1], 0, 0), xItem[2]]
		end
		if tW = "REPEAT"
			if nPos > Len(xSeq)
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			if xSeq[nPos][1] != "num"
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			nMin = PatCount(xSeq[nPos][2], tWhere)
			nPos++
			nMax = nMin
			if nPos <= Len(xSeq)
				if xSeq[nPos][1] = "num"
					nMax = PatCount(xSeq[nPos][2], tWhere)
					nPos++
				end
			end
			if nMax < nMin
				PatFail("pattern " + tWhere + ": REPEAT " + String(nMin) + " " + String(nMax) + ": its minimum is above its maximum")
			end
			xItem = PatItem(xSeq, nPos, tWhere)
			if xItem[1] = 0
				PatFail("pattern " + tWhere + ": REPEAT takes a count, then a rule")
			end
			return [PatNew("repeat", nMin, nMax, xItem[1]), xItem[2]]
		end
		if tW = "RULE" or tW = "MEMBER"
			if nPos > Len(xSeq)
				PatFail("pattern " + tWhere + ": " + tW + " takes a name")
			end
			if xSeq[nPos][1] != "word"
				PatFail("pattern " + tWhere + ": " + tW + " takes a name")
			end
			tName = xSeq[nPos][2]
			nPos++
			if tW = "RULE" return [PatNew("ref", tName, 0, 0), nPos] end
			return [PatNew("member", tName, 0, 0), nPos]
		end
		if tW = "LIT"
			if nPos > Len(xSeq)
				PatFail("pattern " + tWhere + ": LIT takes a value")
			end
			xX = xSeq[nPos]
			nPos++
			return [PatNew("lit", xX, 0, 0), nPos]
		end
		PatFail("pattern " + tWhere + ": " + tW + " is not a pattern word")
	end
	if tK = "list"
		return [PatNew("sub", PatAlt(PatFlat(xV[2]), tWhere), 0, 0), nPos]
	end
	if tK = "group"
		PatFail("pattern " + tWhere + ": ( ) in a rule would run the host (Parse's paren!): refused")
	end
	return [PatNew("lit", xV, 0, 0), nPos]
end
# ---- declaring a set of rules: the bound is checked here, once, never at match time -------------------------------------------

func PatChildren(nNode)
	xN = $vPatNodes[nNode]
	tK = xN[1]
	if tK = "seq" or tK = "alt" return xN[2] end
	if tK = "sub" return [xN[2]] end
	if tK = "repeat" return [xN[4]] end
	if PatIsUnary(Upper(tK)) return [xN[2]] end
	return []
end
# the names a node refers to, as RULE (cWhat "ref") or as MEMBER ("member"), in the order the reference finds them
func PatNamesIn(nNode, tWhat)
	xOut = []
	xN = $vPatNodes[nNode]
	if xN[1] = tWhat xOut + xN[2] end
	xKids = PatChildren(nNode)
	for i = 1 to Len(xKids)
		xMore = PatNamesIn(xKids[i], tWhat)
		for j = 1 to Len(xMore)
			xOut + xMore[j]
		end
	end
	return xOut
end
func PatNullable(nNode)
	xN = $vPatNodes[nNode]
	tK = xN[1]
	if tK = "type" or tK = "lit" or tK = "member" or tK = "into" return false end
	if tK = "end" or tK = "opt" or tK = "any" or tK = "not" or tK = "ahead" or tK = "to" return true end
	if tK = "some" or tK = "thru" or tK = "collect" or tK = "keep" or tK = "sub" return PatNullable(xN[2]) end
	if tK = "repeat"
		if xN[2] = 0 return true end
		return PatNullable(xN[4])
	end
	if tK = "seq"
		for i = 1 to Len(xN[2])
			if not PatNullable(xN[2][i]) return false end
		end
		return true
	end
	if tK = "alt"
		for i = 1 to Len(xN[2])
			if PatNullable(xN[2][i]) return true end
		end
		return false
	end
	if tK = "ref"
		nR = Find($vPatNames, xN[2])
		if $vPatNull[nR] = 0
			if PatNullable($vPatRoots[nR])
				$vPatNull[nR] = 1
			else
				$vPatNull[nR] = 2
			end
		end
		return $vPatNull[nR] = 1
	end
	return false
end
func PatCheck(nNode, tName)
	xN = $vPatNodes[nNode]
	tK = xN[1]
	if tK = "any" or tK = "some" or tK = "to"
		if PatNullable(xN[2])
			PatFail("pattern " + tName + ": " + Upper(tK) + " over a rule that can match nothing: it would never move, so it is refused")
		end
	end
	xKids = PatChildren(nNode)
	for i = 1 to Len(xKids)
		PatCheck(xKids[i], tName)
	end
end
func PatVisit(nRule, xPath)
	if $vPatState[nRule] = 1
		tName = $vPatNames[nRule]
		nAt = Find(xPath, tName)
		vCyc = []
		for i = nAt to Len(xPath)
			vCyc + xPath[i]
		end
		vCyc + tName
		tJoin = BlkJoin(vCyc, " -> ")
		PatFail("pattern " + vCyc[1] + " is recursive (" + tJoin + "): a pattern rule refers only to rules that end")
	end
	if $vPatState[nRule] = 2 return end
	$vPatState[nRule] = 1
	xRefs = PatNamesIn($vPatRoots[nRule], "ref")
	xNext = xPath
	xNext + $vPatNames[nRule]
	for i = 1 to Len(xRefs)
		PatVisit(Find($vPatNames, xRefs[i]), xNext)
	end
	$vPatState[nRule] = 2
end
# aNames and aTexts are the rules in declaration order; aSetNames and aSetMembers the sets the court collected
func PatDeclare(xNames, vTexts, xSetNames, xSetMembers)
	PatReset()
	$xPatSetNames = xSetNames
	$xPatSetMembers = xSetMembers
	for i = 1 to Len(xNames)
		$vPatNames + xNames[i]
		$vPatRoots + PatCompileRule(vTexts[i], xNames[i])
		$vPatNull + 0
		$vPatState + 0
	end
	for i = 1 to Len(xNames)
		xRefs = PatNamesIn($vPatRoots[i], "ref")
		for j = 1 to Len(xRefs)
			if Find($vPatNames, xRefs[j]) = 0
				PatFail("pattern " + xNames[i] + ": RULE " + xRefs[j] + " names no pattern")
			end
		end
		xMems = PatNamesIn($vPatRoots[i], "member")
		for j = 1 to Len(xMems)
			if Find($xPatSetNames, xMems[j]) = 0
				PatFail("pattern " + xNames[i] + ": MEMBER " + xMems[j] + " names no set")
			end
		end
	end
	for i = 1 to Len(xNames)
		PatVisit(i, [])
	end
	for i = 1 to Len(xNames)
		PatCheck($vPatRoots[i], xNames[i])
	end
end
# ---- matching: PEG with a packrat memo ---------------------------------------------------------------------------------------

# a sequence of values becomes an id; its memo is a block of (length + 1) x nodes slots in $aPatMemo
func PatNewSeq(xValues)
	nN = Len(xValues)
	xKinds = []
	for i = 1 to nN
		xKinds + xValues[i][1]
	end
	$vPatSeqVals + xValues
	$vPatSeqKinds + xKinds
	$vPatSeqLen + nN
	$vPatSeqBase + $nPatMemoTop
	if nN > 0
		$vPatSeqKids + List(nN)
	else
		$vPatSeqKids + []
	end
	$nPatMemoTop += (nN + 1) * $nPatNodes
	return Len($vPatSeqLen)
end
func PatExtend(xKept, xMore)
	for i = 1 to Len(xMore)
		xKept + xMore[i]
	end
	return xKept
end
func PatPositions(vVals)
	nTotal = 1
	for i = 1 to Len(vVals)
		xV = vVals[i]
		tK = xV[1]
		if tK != "comment"
			nTotal++
			if tK = "list" or tK = "group" or tK = "row"
				nTotal += PatPositions(xV[2])
			elseif tK = "pair"
				nTotal += PatPositions([xV[2], xV[3]])
			elseif tK = "opt"
				nTotal += PatPositions([xV[2]])
			end
		end
	end
	return nTotal
end
func PatM(nNode, nSeq, nI)
	nIdx = $vPatSeqBase[nSeq] + nI * $nPatNodes + nNode
	xMemo = $xPatMemo[nIdx]
	if IsList(xMemo) return xMemo end
	$nPatSteps++
	xR = PatBody(nNode, nSeq, nI)
	$xPatMemo[nIdx] = xR
	return xR
end
func PatBody(nNode, nSeq, nI)
	xN = $vPatNodes[nNode]
	tK = xN[1]
	nLen = $vPatSeqLen[nSeq]
	if tK = "seq"
		xKept = []
		nJ = nI
		for c = 1 to Len(xN[2])
			xR = PatM(xN[2][c], nSeq, nJ)
			if not xR[1] return [false, nI, []] end
			nJ = xR[2]
			xKept = PatExtend(xKept, xR[3])
		end
		return [true, nJ, xKept]
	end
	if tK = "type"
		if nI < nLen
			if xN[2] = "*" or $vPatSeqKinds[nSeq][nI + 1] = xN[2] return [true, nI + 1, []] end
		end
		return [false, nI, []]
	end
	if tK = "ref"
		return PatM($vPatRoots[Find($vPatNames, xN[2])], nSeq, nI)
	end
	if tK = "lit"
		if nI < nLen
			if $vPatSeqKinds[nSeq][nI + 1] = xN[2][1]
				if BlkDump($vPatSeqVals[nSeq][nI + 1]) = BlkDump(xN[2]) return [true, nI + 1, []] end
			end
		end
		return [false, nI, []]
	end
	if tK = "alt"
		for c = 1 to Len(xN[2])
			xR = PatM(xN[2][c], nSeq, nI)
			if xR[1] return xR end
		end
		return [false, nI, []]
	end
	if tK = "sub"
		return PatM(xN[2], nSeq, nI)
	end
	if tK = "any" or tK = "some"
		xKept = []
		nJ = nI
		nCount = 0
		while true
			xR = PatM(xN[2], nSeq, nJ)
			if not xR[1] exit end
			if xR[2] = nJ exit end
			xKept = PatExtend(xKept, xR[3])
			nJ = xR[2]
			nCount++
		end
		if tK = "some" and nCount = 0 return [false, nI, []] end
		return [true, nJ, xKept]
	end
	if tK = "into"
		if nI >= nLen return [false, nI, []] end
		tKind = $vPatSeqKinds[nSeq][nI + 1]
		if not (tKind = "list" or tKind = "group" or tKind = "row" or tKind = "pair" or tKind = "opt") return [false, nI, []] end
		nKid = $vPatSeqKids[nSeq][nI + 1]
		if nKid = 0
			xV = $vPatSeqVals[nSeq][nI + 1]
			xInner = []
			if tKind = "list" or tKind = "group"
				for q = 1 to Len(xV[2])
					if xV[2][q][1] != "comment" xInner + xV[2][q] end
				end
			elseif tKind = "row"
				xInner = xV[2]
			elseif tKind = "pair"
				xInner = [xV[2], xV[3]]
			else
				xInner = [xV[2]]
			end
			nKid = PatNewSeq(xInner)
			$vPatSeqKids[nSeq][nI + 1] = nKid
		end
		xR = PatM(xN[2], nKid, 0)
		if xR[1] and xR[2] = $vPatSeqLen[nKid] return [true, nI + 1, xR[3]] end
		return [false, nI, []]
	end
	if tK = "end"
		if nI = nLen return [true, nI, []] end
		return [false, nI, []]
	end
	if tK = "member"
		if nI < nLen
			tKind = $vPatSeqKinds[nSeq][nI + 1]
			if tKind = "word" or tKind = "str" or tKind = "kw" or tKind = "num"
				nSet = Find($xPatSetNames, xN[2])
				if Find($xPatSetMembers[nSet], $vPatSeqVals[nSeq][nI + 1][2]) > 0 return [true, nI + 1, []] end
			end
		end
		return [false, nI, []]
	end
	if tK = "opt"
		xR = PatM(xN[2], nSeq, nI)
		if xR[1] return xR end
		return [true, nI, []]
	end
	if tK = "repeat"
		xKept = []
		nJ = nI
		nCount = 0
		while nCount < xN[3]
			xR = PatM(xN[4], nSeq, nJ)
			if not xR[1] exit end
			xKept = PatExtend(xKept, xR[3])
			nJ = xR[2]
			nCount++
		end
		if nCount >= xN[2] return [true, nJ, xKept] end
		return [false, nI, []]
	end
	if tK = "not"
		xR = PatM(xN[2], nSeq, nI)
		if xR[1] return [false, nI, []] end
		return [true, nI, []]
	end
	if tK = "ahead"
		xR = PatM(xN[2], nSeq, nI)
		if xR[1] return [true, nI, []] end
		return [false, nI, []]
	end
	if tK = "to" or tK = "thru"
		for p = nI to nLen
			xR = PatM(xN[2], nSeq, p)
			if xR[1]
				if tK = "to" return [true, p, []] end
				return [true, xR[2], xR[3]]
			end
		end
		return [false, nI, []]
	end
	if tK = "keep"
		xR = PatM(xN[2], nSeq, nI)
		if not xR[1] return [false, nI, []] end
		xKept = []
		for p = nI + 1 to xR[2]
			xKept + $vPatSeqVals[nSeq][p]
		end
		return [true, xR[2], xKept]
	end
	if tK = "collect"
		xR = PatM(xN[2], nSeq, nI)
		if not xR[1] return [false, nI, []] end
		return [true, xR[2], [["list", xR[3]]]]
	end
	PatFail("pattern: no node of kind " + tK)
end
# match the text against the rule named cStart (the rules declared by PatDeclare); returns
# [whole, [the values kept], steps, bound]
func PatRun(tStart, tText)
	nRule = Find($vPatNames, tStart)
	if nRule = 0
		PatFail("pattern " + tStart + " names no pattern")
	end
	xAll = BlkLoad(tText)
	vVals = []
	for i = 1 to Len(xAll)
		if xAll[i][1] != "comment" vVals + xAll[i] end
	end
	nBound = $nPatNodes * PatPositions(vVals)
	$xPatMemo = List(nBound)
	$vPatSeqVals = []
	$vPatSeqKinds = []
	$vPatSeqLen = []
	$vPatSeqBase = []
	$vPatSeqKids = []
	$nPatMemoTop = 0
	$nPatSteps = 0
	nSeq = PatNewSeq(vVals)
	nRoot = $vPatRoots[nRule]
	xR = PatM(nRoot, nSeq, 0)
	bWhole = xR[1] and xR[2] = Len(vVals)
	xKept = xR[3]
	xRoot = $vPatNodes[nRoot]
	if bWhole and xRoot[1] = "seq" and Len(xRoot[2]) = 1 and Len(xKept) = 1
		if $vPatNodes[xRoot[2][1]][1] = "collect"
			xKept = xKept[1][2]
		end
	end
	return [bWhole, xKept, $nPatSteps, nBound]
end
func PatPrintKept(xKept)
	xP = []
	for i = 1 to Len(xKept)
		xP + BlkPrint(xKept[i], 0)
	end
	return BlkJoin(xP, Char(9))
end
