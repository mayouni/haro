load "doors.haro"
sDoors = doors'DEFINE PEER github AS (HOST "api.github.com", SCHEMES [https]) RATIONALE "where releases are read from"'
vTexts = ["https://evil.org/", "https://api.github.com.evil.org/", "https://evilapi.github.com/", "https://uploads.api.github.com/", "https://github.com/", "https://api.github.com./", "https://140.82.112.5/"]
for i = 1 to Len(vTexts)
    try
        hAny = sDoors.Endpoint("github", vTexts[i])
        print "judged"
    catch e
        print e.Code()
    end
end
try
    hAny = sDoors.Endpoint("github", "https://api.github.com.evil.org/")
catch e
    print e.Message()
end
