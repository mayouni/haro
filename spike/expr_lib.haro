# expr_lib.haro -- the generic court AND evaluator of a declared EXPRESSION
# language (Haro v0.5, grown in v0.6), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds an EXPRESSION loads this
# file and fills its tables (see forge.haro): the language's name, its
# OPERATORS and OPERANDS (words of the closed menus), its AGGREGATES, its
# VARIABLES, its CONTEXTS -- the seats a host offers the expression, each
# with the variables it admits -- and, since v0.6, the three semantics an
# evaluator needs and the declaration says: ABSENT (what a reference to
# nothing reads as: zero; missing, zql's -- 0 to arithmetic, the empty
# text to a comparison; or refuse), DIVISION (what a division by zero
# yields: calm, 0, or refuse), EQUALITY (kind: a number and a text are never
# equal, W's rule; value: a numeric text and its number are one value,
# ZQL's). The grammar is W's (stz/declarative/w/GRAMMAR.md), the one
# expression shape the estate declares: or < and < not < comparison <
# additive < multiplicative < unary < primary -- with v0.6's operands and
# operators where the menu admits them: a bare name is a reference into the
# record (ref, dotted for a path), SUM(path) and its kin an aggregate (agg),
# ROUND(x) an operator, CONTAINS a comparison, true and false flags. What
# the declaration does NOT admit is refused at compile time, by name, never
# answered nil.
#
#   <court>.ring check <seat> "<expr>"                  ok | refused: why
#   <court>.ring eval  <seat> "<expr>" [input] [init]    the value, as JSON
#
# The seats a host gives a list expression -- eval, map, filter, count,
# partition, groupby, reduce, reduce_noinit -- are the harness's operations
# (stz's list face, experiment/run_w.luau), implemented here once so the
# forged evaluator can be judged by W's own fixtures unadapted. Numbers are
# the host's numbers (Ring's doubles); a comparison answers 1 or 0; a string
# is always true, as on the Luau host. A record (a JSON object) is the list
# [ExObjMark(), [key, value], ...]; a sentence court sets it with
# ExSetRecord() before evaluating a seat's expression on it (court_lib.haro,
# the eval and walk verbs), and FORMULA results overlay it by name, as
# zing's runner does (cli/src/zql.zig, EvalCtx.overlay).
#
# Functions only. Globals ($cExprLang, $aExprOperators, $aExprOperands,
# $aExprAggregates, $aExprVariables, $aExprContexts, $cExprAbsent,
# $cExprDivision, $cExprEquality, $aExprToks, $nExprPos, $aExprAllowed,
# $aExprRecord, $aExprOverlay) are born in the generated court, at its top
# level, for both runtimes' sake.

func ExInList(tS, xL)
	for i = 1 to Len(xL)
		if xL[i] = tS return true end
	end
	return false
end
func ExFail(tMsg)
	Raise($tExprLang + ": " + tMsg)
end
# ---- character classes by byte code (HF-30) ----------------------------------

func ExIsDigit(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)
end
func ExIsAlpha(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 65 and nN <= 90)
end
func ExIsNameChar(tC)
	return ExIsAlpha(tC) or ExIsDigit(tC) or tC = "_"
end
# ---- tokenizer: [type, text]; types: num str var ref flag fn and or not cmp op lparen rparen
func ExTokenize(tS)
	xT = []
	nN = Len(tS)
	nI = 1
	while nI <= nN
		tC = tS[nI]
		if tC = " " or tC = Char(9) or tC = Char(13) or tC = Char(10)
			nI++
		elseif ExIsDigit(tC)
			nJ = nI
			while nJ <= nN and (ExIsDigit(tS[nJ]) or tS[nJ] = ".")
				nJ++
			end
			tNum = SubStr(tS, nI, nJ - nI)
			nDots = 0
			for nK = 1 to Len(tNum)
				if tNum[nK] = "." nDots++ end
			end
			if nDots > 1 or tNum[Len(tNum)] = "." ExFail("bad number '" + tNum + "'") end
			xT + ["num", tNum]
			nI = nJ
		elseif tC = "'" or tC = '"'
			nJ = nI + 1
			while nJ <= nN and tS[nJ] != tC
				nJ++
			end
			if nJ > nN ExFail("unterminated string starting at '" + SubStr(tS, nI) + "'") end
			xT + ["str", SubStr(tS, nI + 1, nJ - nI - 1)]
			nI = nJ + 1
		elseif tC = "@"
			nJ = nI + 1
			if nJ > nN or not ExIsAlpha(tS[nJ]) ExFail("'@' must be followed by a variable name") end
			while nJ <= nN and ExIsNameChar(tS[nJ])
				nJ++
			end
			xT + ["var", Lower(SubStr(tS, nI + 1, nJ - nI - 1))]
			nI = nJ
		elseif ExIsAlpha(tC)
			nJ = nI
			while nJ <= nN and ExIsNameChar(tS[nJ])
				nJ++
			end
			tW = SubStr(tS, nI, nJ - nI)
			tL = Lower(tW)
			# the word's meaning is fixed by what follows and by the menus,
			# never by its case: AND and and are one word
			nK = nJ
			while nK <= nN and (tS[nK] = " " or tS[nK] = Char(9))
				nK++
			end
			bCall = false
			if nK <= nN and tS[nK] = "(" bCall = true end
			if tL = "and" or tL = "or" or tL = "not"
				xT + [tL, tL]
			elseif tL = "contains"
				xT + ["cmp", "contains"]
			elseif tL = "true" or tL = "false"
				xT + ["flag", tL]
			elseif bCall and (tL = "round" or tL = "sum" or tL = "count" or tL = "avg" or tL = "min" or tL = "max")
				xT + ["fn", tL]
			elseif ExInList("ref", $xExprOperands)
				# a bare name is a reference into the record; a dotted one a path
				while nJ < nN and tS[nJ] = "." and ExIsAlpha(tS[nJ + 1])
					nJ++
					while nJ <= nN and ExIsNameChar(tS[nJ])
						nJ++
					end
				end
				xT + ["ref", SubStr(tS, nI, nJ - nI)]
			else
				ExFail("'" + tW + "' is not part of the " + $tExprLang + " grammar -- no calls, no host names")
			end
			nI = nJ
		else
			tTwo = ""
			if nI < nN tTwo = SubStr(tS, nI, 2) end
			if tTwo = ">=" or tTwo = "<=" or tTwo = "!=" or tTwo = "<>"
				if tTwo = "<>" tTwo = "!=" end
				xT + ["cmp", tTwo]
				nI += 2
			elseif tC = "=" or tC = ">" or tC = "<"
				xT + ["cmp", tC]
				nI++
			elseif tC = "+" or tC = "-" or tC = "*" or tC = "/" or tC = "%"
				xT + ["op", tC]
				nI++
			elseif tC = "("
				xT + ["lparen", tC]
				nI++
			elseif tC = ")"
				xT + ["rparen", tC]
				nI++
			else
				ExFail("character '" + tC + "' is not part of the " + $tExprLang + " grammar")
			end
		end
	end
	xT + ["eof", ""]
	return xT
end
func ExPeek
	return $xExprToks[$nExprPos]
end
func ExTake
	xT = $xExprToks[$nExprPos]
	if xT[1] != "eof" $nExprPos++ end
	return xT
end
# the menu word an operator token stands for, and whether the menu admits it
func ExWantOperator(tMenuWord, tShown)
	if not ExInList(tMenuWord, $xExprOperators)
		ExFail("'" + tShown + "' is not an operator of " + $tExprLang + " (its menu: " + ExJoin($xExprOperators, ", ") + ")")
	end
end
func ExWantOperand(tMenuWord, tShown)
	if not ExInList(tMenuWord, $xExprOperands)
		ExFail("'" + tShown + "' is not an operand of " + $tExprLang + " (its menu: " + ExJoin($xExprOperands, ", ") + ")")
	end
end
func ExJoin(xL, tSep)
	tOut = ""
	for i = 1 to Len(xL)
		if i > 1 tOut += tSep end
		tOut += xL[i]
	end
	return tOut
end
# ---- parser: one function per grammar rule; nodes are lists --------------------
#   ["num", n] ["str", s] ["var", name] ["ref", path] ["flag", 1|0]
#   ["agg", kind, path] ["round", l] ["neg", l] ["arith", op, l, r]
#   ["cmp", op, l, r] ["not", l] ["and", l, r] ["or", l, r]
# A node is built in a fresh variable and assigned after (HF-36).

func ExParse(tS, xAllowed)
	$xExprToks = ExTokenize(tS)
	$nExprPos = 1
	$xExprAllowed = xAllowed
	if ExPeek()[1] = "eof" ExFail("empty expression") end
	xRoot = ExOr()
	if ExPeek()[1] != "eof"
		ExFail("trailing input from '" + ExPeek()[2] + "'")
	end
	return xRoot
end
func ExPrimary
	xT = ExPeek()
	if xT[1] = "eof" ExFail("expression ends where a value was expected") end
	if xT[1] = "num"
		ExTake()
		ExWantOperand("number", xT[2])
		return ["num", Number(xT[2])]
	end
	if xT[1] = "str"
		ExTake()
		ExWantOperand("text", "'" + xT[2] + "'")
		return ["str", xT[2]]
	end
	if xT[1] = "var"
		ExTake()
		ExWantOperand("var", "@" + xT[2])
		if not ExInList(xT[2], $xExprAllowed)
			ExFail("unknown variable @" + xT[2] + " in this seat")
		end
		return ["var", xT[2]]
	end
	if xT[1] = "ref"
		ExTake()
		ExWantOperand("ref", xT[2])
		return ["ref", xT[2]]
	end
	if xT[1] = "flag"
		ExTake()
		ExWantOperand("flag", xT[2])
		if xT[2] = "true" return ["flag", 1] end
		return ["flag", 0]
	end
	if xT[1] = "fn"
		ExTake()
		if ExPeek()[1] != "lparen" ExFail(Upper(xT[2]) + " is followed by '('") end
		ExTake()
		if xT[2] = "round"
			ExWantOperator("round", "ROUND")
			xInner = ExOr()
			if ExPeek()[1] != "rparen" ExFail("unclosed '(' after ROUND") end
			ExTake()
			xNode = ["round", xInner]
			return xNode
		end
		ExWantOperand("agg", Upper(xT[2]) + "(...)")
		if not ExInList(xT[2], $xExprAggregates)
			ExFail("'" + Upper(xT[2]) + "' is not an aggregate of " + $tExprLang + " (its menu: " + ExJoin($xExprAggregates, ", ") + ")")
		end
		xP = ExPeek()
		if xP[1] != "ref" ExFail(Upper(xT[2]) + " takes a field name, found '" + xP[2] + "'") end
		ExTake()
		if ExPeek()[1] != "rparen" ExFail("unclosed '(' after " + Upper(xT[2])) end
		ExTake()
		xNode = ["agg", xT[2], xP[2]]
		return xNode
	end
	if xT[1] = "lparen"
		ExTake()
		xInner = ExOr()
		if ExPeek()[1] != "rparen" ExFail("unclosed '('") end
		ExTake()
		return xInner
	end
	ExFail("unexpected '" + xT[2] + "'")
end
func ExUnary
	xT = ExPeek()
	if xT[1] = "op" and xT[2] = "-"
		ExTake()
		ExWantOperator("neg", "-")
		xInner = ExUnary()
		xNode = ["neg", xInner]
		return xNode
	end
	return ExPrimary()
end
func ExMul
	xL = ExUnary()
	while true
		xT = ExPeek()
		if xT[1] != "op" exit end
		if xT[2] != "*" and xT[2] != "/" and xT[2] != "%" exit end
		ExTake()
		tWord = "mul"
		if xT[2] = "/" tWord = "div" end
		if xT[2] = "%" tWord = "mod" end
		ExWantOperator(tWord, xT[2])
		xR = ExUnary()
		xNode = ["arith", xT[2], xL, xR]
		xL = xNode
	end
	return xL
end
func ExAdd
	xL = ExMul()
	while true
		xT = ExPeek()
		if xT[1] != "op" exit end
		if xT[2] != "+" and xT[2] != "-" exit end
		ExTake()
		tWord = "add"
		if xT[2] = "-" tWord = "sub" end
		ExWantOperator(tWord, xT[2])
		xR = ExMul()
		xNode = ["arith", xT[2], xL, xR]
		xL = xNode
	end
	return xL
end
func ExComparison
	xL = ExAdd()
	xT = ExPeek()
	if xT[1] = "cmp"
		ExTake()
		if xT[2] = "contains"
			ExWantOperator("contains", "CONTAINS")
		else
			ExWantOperator("cmp", xT[2])
		end
		xR = ExAdd()
		xNode = ["cmp", xT[2], xL, xR]
		return xNode
	end
	return xL
end
func ExNot
	xT = ExPeek()
	if xT[1] = "not"
		ExTake()
		ExWantOperator("not", "not")
		xInner = ExNot()
		xNode = ["not", xInner]
		return xNode
	end
	return ExComparison()
end
func ExAnd
	xL = ExNot()
	while ExPeek()[1] = "and"
		ExTake()
		ExWantOperator("and", "and")
		xR = ExNot()
		xNode = ["and", xL, xR]
		xL = xNode
	end
	return xL
end
func ExOr
	xL = ExAnd()
	while ExPeek()[1] = "or"
		ExTake()
		ExWantOperator("or", "or")
		xR = ExAnd()
		xNode = ["or", xL, xR]
		xL = xNode
	end
	return xL
end
# ---- the record (v0.6): a JSON object, read by path ----------------------------
# an object is [ExObjMark(), [key, value], ...]; JSON null is ExNullMark()

func ExObjMark
	return Char(1) + "obj"
end
func ExNullMark
	return Char(1) + "null"
end
func ExIsObj(xV)
	if not IsList(xV) return false end
	if Len(xV) = 0 return false end
	if not IsString(xV[1]) return false end
	return xV[1] = ExObjMark()
end
func ExIsNull(xV)
	if not IsString(xV) return false end
	return xV = ExNullMark()
end
func ExObjGet(vObj, tKey)
	for i = 2 to Len(vObj)
		if vObj[i][1] = tKey return [true, vObj[i][2]] end
	end
	return [false, 0]
end
func ExSetRecord(xRecord)
	$xExprRecord = xRecord
	$vExprOverlay = []
end
func ExSplitPath(tPath)
	xOut = []
	tCur = ""
	for i = 1 to Len(tPath)
		if tPath[i] = "."
			xOut + tCur
			tCur = ""
		else
			tCur += tPath[i]
		end
	end
	xOut + tCur
	return xOut
end
# a reference, read first from the overlay (a FORMULA's results, by the name
# as written) and then by path through the record: [found, value]
func ExRefGet(tPath)
	for i = 1 to Len($vExprOverlay)
		if $vExprOverlay[i][1] = tPath return [true, $vExprOverlay[i][2]] end
	end
	xSegs = ExSplitPath(tPath)
	xV = $xExprRecord
	for i = 1 to Len(xSegs)
		if not ExIsObj(xV) return [false, 0] end
		xGot = ExObjGet(xV, xSegs[i])
		if not xGot[1] return [false, 0] end
		xV = xGot[2]
	end
	if ExIsNull(xV) return [false, 0] end
	return [true, xV]
end
# ---- numbers and texts under EQUALITY value (zql.zig's asNum and asStr) ------------

# a value as a number: [ok, n] -- a number, a numeric text (digits, a point,
# an exponent; no spaces, as parseFloat reads it), a flag; never a list
func ExNumOf(xV)
	if IsNumber(xV) return [true, xV] end
	if not IsString(xV) return [false, 0] end
	nN = Len(xV)
	if nN = 0 return [false, 0] end
	nI = 1
	if xV[nI] = "-" or xV[nI] = "+" nI++ end
	nDigits = 0
	while nI <= nN and ExIsDigit(xV[nI])
		nI++
		nDigits++
	end
	if nI <= nN and xV[nI] = "."
		nI++
		while nI <= nN and ExIsDigit(xV[nI])
			nI++
			nDigits++
		end
	end
	if nDigits = 0 return [false, 0] end
	if nI <= nN and (xV[nI] = "e" or xV[nI] = "E")
		nI++
		if nI <= nN and (xV[nI] = "-" or xV[nI] = "+") nI++ end
		nExp = 0
		while nI <= nN and ExIsDigit(xV[nI])
			nI++
			nExp++
		end
		if nExp = 0 return [false, 0] end
	end
	if nI <= nN return [false, 0] end
	return [true, Number(xV)]
end
# a value as a number for arithmetic: what cannot be one is 0
func ExNum(xV)
	xA = ExNumOf(xV)
	if xA[1] return xA[2] end
	return 0
end
func ExStr(xV)
	if IsNumber(xV) return ExNumText(xV) end
	if IsString(xV)
		if ExIsNull(xV) return "" end
		return xV
	end
	return ""
end
# byte order of two texts, -1 0 1, by hand: Ring's own < on two strings is R41 (HF-30)
func ExStrOrder(xA, xB)
	nN = Len(xA)
	if Len(xB) < nN nN = Len(xB) end
	for i = 1 to nN
		nX = Ascii(xA[i])
		nY = Ascii(xB[i])
		if nX < nY return -1 end
		if nX > nY return 1 end
	end
	if Len(xA) < Len(xB) return -1 end
	if Len(xA) > Len(xB) return 1 end
	return 0
end
func ExContains(tHay, tNeedle)
	if Len(tNeedle) = 0 return true end
	return SubStr(Lower(tHay), Lower(tNeedle)) > 0
end
# ---- evaluator: env is [[name, value], ...]; a comparison answers 1 or 0 --------

func ExTruthy(xV)
	# v0.43: a comparison of Haro's own is a boolean (ExCompareValue answers one); W's are its numbers 1 and 0
	if Type(xV) = "BOOLEAN" return xV end
	if IsNumber(xV) return xV != 0 end
	if IsString(xV) return true end
	if IsList(xV) return true end
	return false
end
func ExEnvGet(xEnv, tName)
	for i = 1 to Len(xEnv)
		if xEnv[i][1] = tName return xEnv[i][2] end
	end
	return 0
end
func ExEval(xNode, xEnv)
	tK = xNode[1]
	if tK = "num" or tK = "str" or tK = "flag" return xNode[2] end
	if tK = "var" return ExEnvGet(xEnv, xNode[2]) end
	if tK = "ref"
		xGot = ExRefGet(xNode[2])
		if xGot[1] return xGot[2] end
		if $tExprAbsent = "zero" return 0 end
		# missing (zql.zig's .missing): 0 to arithmetic, "" to a comparison
		if $tExprAbsent = "missing" return ExNullMark() end
		ExFail("'" + xNode[2] + "' is absent from the record")
	end
	if tK = "agg" return ExAggregate(xNode[2], xNode[3]) end
	if tK = "round" return ExRound(ExNum(ExEval(xNode[2], xEnv))) end
	if tK = "neg" return -ExEval(xNode[2], xEnv) end
	if tK = "arith"
		xA = ExEval(xNode[3], xEnv)
		xB = ExEval(xNode[4], xEnv)
		if $tExprEquality = "value"
			# calm arithmetic: a value that is not a number counts as 0
			xA = ExNum(xA)
			xB = ExNum(xB)
		end
		xOp = xNode[2]
		if xOp = "+" return xA + xB end
		if xOp = "-" return xA - xB end
		if xOp = "*" return xA * xB end
		if xOp = "/"
			if $tExprDivision = "calm" and xB = 0 return 0 end
			if $tExprDivision = "refuse" and xB = 0 ExFail("division by zero") end
			return xA / xB
		end
		return xA % xB
	end
	if tK = "cmp"
		xA = ExEval(xNode[3], xEnv)
		xB = ExEval(xNode[4], xEnv)
		xOp = xNode[2]
		if xOp = "contains"
			if ExContains(ExStr(xA), ExStr(xB)) return 1 end
			return 0
		end
		if $tExprEquality = "value" return ExCompareValue(xOp, xA, xB) end
		if xOp = "="
			if ExSame(xA, xB) return 1 end
			return 0
		end
		if xOp = "!="
			if ExSame(xA, xB) return 0 end
			return 1
		end
		if xOp = ">"
			if xA > xB return 1 end
			return 0
		end
		if xOp = "<"
			if xA < xB return 1 end
			return 0
		end
		if xOp = ">="
			if xA >= xB return 1 end
			return 0
		end
		if xA <= xB return 1 end
		return 0
	end
	if tK = "not"
		if ExTruthy(ExEval(xNode[2], xEnv)) return 0 end
		return 1
	end
	if tK = "and"
		if not ExTruthy(ExEval(xNode[2], xEnv)) return 0 end
		if ExTruthy(ExEval(xNode[3], xEnv)) return 1 end
		return 0
	end
	if tK = "or"
		if ExTruthy(ExEval(xNode[2], xEnv)) return 1 end
		if ExTruthy(ExEval(xNode[3], xEnv)) return 1 end
		return 0
	end
	ExFail("internal -- unknown node kind " + tK)
end
# a condition's truth (v0.6/v0.7, zql.zig evalExpr): a comparison, and, or,
# not and a flag have a truth; an arithmetic node, a reference or a text has
# none and reads false -- `WHERE amount` matches nothing
func ExIsCondition(xNode)
	tK = xNode[1]
	return tK = "cmp" or tK = "and" or tK = "or" or tK = "not" or tK = "flag"
end
# a condition's truth under the declared EQUALITY: value (zql) -- a boolean
# shape or nothing; kind (W) -- the value's own truth (v0.9)
func ExCondition(xNode, xEnv)
	if $tExprEquality = "value" return ExBool(xNode, xEnv) end
	return ExTruthy(ExEval(xNode, xEnv))
end
func ExBool(xNode, xEnv)
	tK = xNode[1]
	if tK = "cmp" return ExTruthy(ExEval(xNode, xEnv)) end
	if tK = "flag" return ExTruthy(xNode[2]) end
	if tK = "not"
		if ExBool(xNode[2], xEnv) return false end
		return true
	end
	if tK = "and"
		if not ExBool(xNode[2], xEnv) return false end
		return ExBool(xNode[3], xEnv)
	end
	if tK = "or"
		if ExBool(xNode[2], xEnv) return true end
		return ExBool(xNode[3], xEnv)
	end
	return false
end
# equality by value and by kind: a number and a string are never equal (W's
# rule on the Luau host), whatever the host's own = would say
func ExSame(xA, xB)
	if IsNumber(xA) and IsNumber(xB) return xA = xB end
	if IsString(xA) and IsString(xB) return xA = xB end
	return false
end
# EQUALITY value: numeric when both sides can be numbers, by text otherwise
# (zql.zig's compareOperands, zql.js's _compare)
func ExCompareValue(xOp, xA, xB)
	xNa = ExNumOf(xA)
	xNb = ExNumOf(xB)
	if xNa[1] and xNb[1]
		xX = xNa[2]
		xY = xNb[2]
		if xOp = "=" return xX = xY end
		if xOp = "!=" return xX != xY end
		if xOp = ">" return xX > xY end
		if xOp = "<" return xX < xY end
		if xOp = ">=" return xX >= xY end
		return xX <= xY
	end
	xN = ExStrOrder(ExStr(xA), ExStr(xB))
	if xOp = "=" return xN = 0 end
	if xOp = "!=" return xN != 0 end
	if xOp = ">" return xN > 0 end
	if xOp = "<" return xN < 0 end
	if xOp = ">=" return xN >= 0 end
	return xN <= 0
end
# ROUND: half away from zero, as C's round() and zql.zig's @round
func ExRound(xX)
	if xX >= 0 return Floor(xX + 0.5) end
	return -Floor(-xX + 0.5)
end
# an aggregate over the list a path names: the numeric items count, a path
# that names no list answers 0 (zql.zig's resolveCtx .agg)
func ExAggregate(tKind, tPath)
	xGot = ExRefGet(tPath)
	if not xGot[1] return 0 end
	xL = xGot[2]
	if not IsList(xL) or ExIsObj(xL) return 0 end
	nSum = 0
	nCount = 0
	nMin = 0
	nMax = 0
	for i = 1 to Len(xL)
		xA = ExNumOf(xL[i])
		if not xA[1] loop end
		xV = xA[2]
		if nCount = 0
			nMin = xV
			nMax = xV
		else
			if xV < nMin nMin = xV end
			if xV > nMax nMax = xV end
		end
		nSum += xV
		nCount++
	end
	if tKind = "sum" return nSum end
	if tKind = "count" return nCount end
	if tKind = "min" return nMin end
	if tKind = "max" return nMax end
	if nCount = 0 return 0 end
	return nSum / nCount
end
# ---- the seats -------------------------------------------------------------------

# the variables a seat admits: its CONTEXTS entry, or every VARIABLE when the
# declaration names no contexts
func ExAllowedIn(tSeat)
	if Len($xExprContexts) = 0 return $xExprVariables end
	for i = 1 to Len($xExprContexts)
		if $xExprContexts[i][1] = tSeat return $xExprContexts[i][2] end
	end
	ExFail("no seat '" + tSeat + "' in " + $tExprLang + " (its seats: " + ExJoin(ExSeatNames(), ", ") + ")")
end
func ExSeatNames
	xN = []
	for i = 1 to Len($xExprContexts)
		xN + $xExprContexts[i][1]
	end
	return xN
end
# ---- JSON, the harness's exchange form ---------------------------------------------

func ExNumText(nN)
	tS = String(nN)
	if SubStr(tS, ".") > 0
		while Len(tS) > 1 and tS[Len(tS)] = "0"
			tS = Left(tS, Len(tS) - 1)
		end
		if tS[Len(tS)] = "." tS = Left(tS, Len(tS) - 1) end
	end
	return tS
end
func ExJson(xV)
	if IsNumber(xV) return ExNumText(xV) end
	if IsString(xV)
		if ExIsNull(xV) return "null" end
		return '"' + xV + '"'
	end
	if IsList(xV)
		if ExIsObj(xV)
			tOut = "{"
			for i = 2 to Len(xV)
				if i > 2 tOut += ", " end
				tOut += '"' + xV[i][1] + '": ' + ExJson(xV[i][2])
			end
			return tOut + "}"
		end
		tOut = "["
		for i = 1 to Len(xV)
			if i > 1 tOut += ", " end
			tOut += ExJson(xV[i])
		end
		return tOut + "]"
	end
	return "null"
end
# a small reader: numbers, strings, lists, objects, true/false/null;
# $aExprToks/$nExprPos reused as the cursor
func ExJsonParse(tS)
	$xExprToks = tS
	$nExprPos = 1
	xV = ExJsonValue()
	ExJsonWs()
	if $nExprPos <= Len(tS) ExFail("input: trailing text at " + $nExprPos) end
	return xV
end
func ExJsonWs
	while $nExprPos <= Len($xExprToks) and ($xExprToks[$nExprPos] = " " or $xExprToks[$nExprPos] = Char(9) or $xExprToks[$nExprPos] = Char(10) or $xExprToks[$nExprPos] = Char(13))
		$nExprPos++
	end
end
func ExJsonString
	tS = $xExprToks
	nJ = $nExprPos + 1
	while nJ <= Len(tS) and tS[nJ] != '"'
		nJ++
	end
	if nJ > Len(tS) ExFail("input: unterminated string") end
	tV = SubStr(tS, $nExprPos + 1, nJ - $nExprPos - 1)
	$nExprPos = nJ + 1
	return tV
end
func ExJsonValue
	ExJsonWs()
	tS = $xExprToks
	if $nExprPos > Len(tS) ExFail("input: a value was expected") end
	tC = tS[$nExprPos]
	if tC = "["
		$nExprPos++
		xOut = []
		ExJsonWs()
		if $nExprPos <= Len(tS) and tS[$nExprPos] = "]"
			$nExprPos++
			return xOut
		end
		while true
			xOut + ExJsonValue()
			ExJsonWs()
			if $nExprPos > Len(tS) ExFail("input: unclosed '['") end
			if tS[$nExprPos] = ","
				$nExprPos++
			elseif tS[$nExprPos] = "]"
				$nExprPos++
				return xOut
			else
				ExFail("input: expected ',' or ']'")
			end
		end
	end
	if tC = "{"
		$nExprPos++
		vObj = [ExObjMark()]
		ExJsonWs()
		if $nExprPos <= Len(tS) and tS[$nExprPos] = "}"
			$nExprPos++
			return vObj
		end
		while true
			ExJsonWs()
			if $nExprPos > Len(tS) or tS[$nExprPos] != '"' ExFail("input: a key was expected in an object") end
			tKey = ExJsonString()
			ExJsonWs()
			if $nExprPos > Len(tS) or tS[$nExprPos] != ":" ExFail("input: ':' was expected after a key") end
			$nExprPos++
			xVal = ExJsonValue()
			vPair = [tKey, xVal]
			vObj + vPair
			ExJsonWs()
			if $nExprPos > Len(tS) ExFail("input: unclosed '{'") end
			if tS[$nExprPos] = ","
				$nExprPos++
			elseif tS[$nExprPos] = "}"
				$nExprPos++
				return vObj
			else
				ExFail("input: expected ',' or '}'")
			end
		end
	end
	if tC = '"' return ExJsonString() end
	if ExIsAlpha(tC)
		nJ = $nExprPos
		while nJ <= Len(tS) and ExIsAlpha(tS[nJ])
			nJ++
		end
		tW = SubStr(tS, $nExprPos, nJ - $nExprPos)
		$nExprPos = nJ
		if tW = "true" return 1 end
		if tW = "false" return 0 end
		if tW = "null" return ExNullMark() end
		ExFail("input: unexpected '" + tW + "'")
	end
	nJ = $nExprPos
	if tS[nJ] = "-" nJ++ end
	while nJ <= Len(tS) and (ExIsDigit(tS[nJ]) or tS[nJ] = ".")
		nJ++
	end
	if nJ <= Len(tS) and (tS[nJ] = "e" or tS[nJ] = "E")
		nJ++
		if nJ <= Len(tS) and (tS[nJ] = "-" or tS[nJ] = "+") nJ++ end
		while nJ <= Len(tS) and ExIsDigit(tS[nJ])
			nJ++
		end
	end
	if nJ = $nExprPos ExFail("input: unexpected '" + tC + "'") end
	nV = Number(SubStr(tS, $nExprPos, nJ - $nExprPos))
	$nExprPos = nJ
	return nV
end
# ---- the command: check <seat> "<expr>" | eval <seat> "<expr>" [input] [init] ------

func ExRun(tSeat, tExpr, xInput, xInit, bHasInit)
	xAllowed = ExAllowedIn(tSeat)
	xAst = ExParse(tExpr, xAllowed)
	# an object as the input is the RECORD the references read (v0.6)
	if ExIsObj(xInput) ExSetRecord(xInput) end
	if tSeat = "eval" return ExEval(xAst, []) end
	if tSeat = "map"
		xOut = []
		for i = 1 to Len(xInput)
			xOut + ExEval(xAst, [["item", xInput[i]]])
		end
		return xOut
	end
	if tSeat = "filter"
		xOut = []
		for i = 1 to Len(xInput)
			if ExTruthy(ExEval(xAst, [["item", xInput[i]]])) xOut + xInput[i] end
		end
		return xOut
	end
	if tSeat = "count"
		nN = 0
		for i = 1 to Len(xInput)
			if ExTruthy(ExEval(xAst, [["item", xInput[i]]])) nN++ end
		end
		return nN
	end
	if tSeat = "partition"
		vYes = []
		vNo = []
		for i = 1 to Len(xInput)
			if ExTruthy(ExEval(xAst, [["item", xInput[i]]]))
				vYes + xInput[i]
			else
				vNo + xInput[i]
			end
		end
		return [vYes, vNo]
	end
	if tSeat = "groupby"
		xGroups = []
		for i = 1 to Len(xInput)
			xK = ExEval(xAst, [["item", xInput[i]]])
			tKey = String(xK)
			if IsNumber(xK) tKey = ExNumText(xK) end
			nAt = 0
			for j = 1 to Len(xGroups)
				if xGroups[j][1] = tKey nAt = j end
			end
			if nAt = 0
				xGroups + [tKey, [xInput[i]]]
			else
				xGroups[nAt][2] + xInput[i]
			end
		end
		return xGroups
	end
	if tSeat = "reduce" or tSeat = "reduce_noinit"
		nStart = 1
		xAcc = xInit
		if not bHasInit
			if Len(xInput) = 0 ExFail("reduce without an initial value needs one item") end
			xAcc = xInput[1]
			nStart = 2
		end
		for i = nStart to Len(xInput)
			xAcc = ExEval(xAst, [["accumulator", xAcc], ["item", xInput[i]]])
		end
		return xAcc
	end
	# a seat the declaration names and this harness has no operation for:
	# judged, and evaluated once with no variable bound
	return ExEval(xAst, [])
end
func ExMain
	if Len(sysargv) < 5
		? "usage: <court>.haro check <seat> <expr> | eval <seat> <expr> [input] [init]"
		return
	end
	tVerb = sysargv[3]
	tSeat = sysargv[4]
	tExpr = sysargv[5]
	try
		if tVerb = "check"
			ExParse(tExpr, ExAllowedIn(tSeat))
			? "ok"
		elseif tVerb = "eval"
			xInput = []
			if Len(sysargv) >= 6 xInput = ExJsonParse(sysargv[6]) end
			xInit = 0
			bHasInit = false
			if Len(sysargv) >= 7
				xInit = ExJsonParse(sysargv[7])
				bHasInit = true
			end
			? ExJson(ExRun(tSeat, tExpr, xInput, xInit, bHasInit))
		else
			? "unknown verb '" + tVerb + "'; this court answers: check, eval"
		end
	catch
		? "refused: " + cCatchError
	end
end
