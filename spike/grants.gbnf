# grants.gbnf -- GENERATED by forge.haro from the grants declaration (stzu v0.1).
# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords,
# lower_snake identifiers, trailing commas. A clause given twice and a required seat
# absent are the court's to refuse; the decoder holds the shape.

root ::= ws decl (ws decl)* ws
decl ::= decl_ZONE | decl_USE
decl_ZONE ::= "DEFINE" sp "ZONE" sp ident sp "AS" ws "(" ws (clause_ZONE (ws "," ws clause_ZONE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_ZONE ::= "RIGHTS" sp namelist | "PRIMARY" sp ident
decl_USE ::= "DEFINE" sp "USE" sp ident sp "AS" ws "(" ws (clause_USE (ws "," ws clause_USE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_USE ::= "WANTS" sp namelist | "PRIMARY" sp ident | "VIA" sp namelist

ident ::= [a-z_] [a-z0-9_]*
string ::= "\"" [^"]* "\""
number ::= [0-9]+
namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"
stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"
sp ::= [ \t]+
ws ::= ([ \t\r\n] | "--" [^\n]* "\n")*
