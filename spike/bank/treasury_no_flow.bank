-- treasury_no_flow.bank -- a vault entered through a flow nothing declares: refused under
-- Art. 5, in the kind's own words.

DEFINE ACCOUNT main AS (
  HOLDER "the treasury", CURRENCY xof, CEILING 5000000
) RATIONALE "The bank's own account, where the day's cash lands"

DEFINE FLOW nightly_posting AS () RATIONALE "The day's postings, walked at close"

DEFINE VAULT ghost_vault AS (
  HELD_BY the_bank, ENTERED_THROUGH nowhere
) RATIONALE "A vault entered through a flow that does not exist, which the bank refuses"
