# judge_lib.haro -- a program that judges (Haro v0.70, TYPES.md T7, D83).
#
# A program that loads a language's declaration holds that language's court: the forge's own output, loaded as it is, with
# court_lib.haro beside it. This file is what stands between the program and the court:
#
#   HaroLanguageLoaded(name, version)   called once a forged court has been loaded: keeps its tables under the language's name
#   HaroJudge(name, text)               the court's verdict on a text: a sentence, or the court's first refusal raised
#   HaroSentence                        what a sentence is: its language, the language's version, its text, the court's warnings
#   HaroLang(name)                      the language as a program names it: its Judge(text) is HaroJudge(name, text)
#   HaroPlaceOf(doors, root, text)      v0.72: a place beneath a root a sentence of doors declares; HaroPlace is what a place is
#   HaroInvocationOf(doors, command, arguments)   v0.73: a command of a sentence of doors with its arguments judged; HaroInvocation
#
# Loaded before any court, it says so: a court's main does nothing when $bHaroJudges exists (court_lib.haro, CtMain).

$bHaroJudges = true
$vHaroLanguages = []

func HaroLanguageLoaded(ptName, ptVersion)
	$vHaroLanguages + [ptName, ptVersion, $vCourtLangs]
end

func HaroLanguageEntry(ptName)
	for i = 1 to Len($vHaroLanguages)
		if $vHaroLanguages[i][1] = ptName return $vHaroLanguages[i] end
	end
	Raise("no language called '" + ptName + "' is loaded")
end

# the court of ptName judges ptText: every table of that language is put back first, since each court's load leaves its own
func HaroJudge(ptName, ptText)
	vEntry = HaroLanguageEntry(ptName)
	$vCourtLangs = vEntry[3]
	CtUseLanguage(ptName)
	CtBuildCondLangs()
	$tCourtDir = ""
	$xCourtWorldFile = ""
	vFound = CtDiagnoseText(ptText, ptName, "")
	vWarnings = []
	for i = 1 to Len(vFound)
		if vFound[i][2] = "error"
			HaroRefuse(vFound[i][1], vFound[i][3])
		end
		vWarnings + vFound[i]
	end
	return new HaroSentence(ptName, vEntry[2], ptText, vWarnings)
end

# what a language's name reads as in a program that loads its declaration: `signal.Judge(tText)` is HaroLang("signal").Judge(tText)
func HaroLang(ptName)
	return new HaroLanguage(ptName)
end

# v0.71, `of`: what the lift writes where a definition's header names a language (lift.zig, findOf).
func HaroIsSentence(pxValue)
	return IsObject(pxValue) and ClassName(pxValue) = "harosentence"
end

# a parameter `psName of language`, where the body begins: a sentence of another language is refused (a value that is no
# sentence never reaches here -- the letter s refused it at the entry)
func HaroOfGiven(pxValue, ptLanguage, ptName)
	if HaroIsSentence(pxValue)
		if pxValue.Language() != ptLanguage
			Raise("Error (SENTENCE_OF_ANOTHER) : `" + ptName + "` is a sentence of " + ptLanguage + ", and is given a sentence of " + pxValue.Language())
		end
	end
end

# a definition `... of language`, around what each return gives: a sentence of that language, or nothing at all
func HaroOfAnswer(pxValue, ptLanguage, ptName)
	if HaroIsSentence(pxValue)
		if pxValue.Language() != ptLanguage
			Raise("Error (SENTENCE_OF_ANOTHER) : `" + ptName + "` answers a sentence of " + ptLanguage + ", and answers a sentence of " + pxValue.Language())
		end
		return pxValue
	end
	if IsString(pxValue)
		if pxValue = "" return pxValue end
		Raise("Error (SENTENCE_EXPECTED) : `" + ptName + "` answers a sentence of " + ptLanguage + ", and answers a text")
	end
	Raise("Error (SENTENCE_EXPECTED) : `" + ptName + "` answers a sentence of " + ptLanguage + ", and answers no sentence")
end

# the court's refusal, raised as the VM raises a coded error: `Error (CODE) : message`, so Code() answers the court's code
func HaroRefuse(ptCode, ptMessage)
	Raise("Error (" + ptCode + ") : " + ptMessage)
end

# The VM knows this class by its name and its attributes by their order (vm/src/main.zig, sentenceClass): the third is the text a
# sentence prints as, and the fifth says it is made -- from then on a write into it is refused (SENTENCE_FIXED). Keep the order.
class HaroSentence
	tLanguage = ""
	tVersion = ""
	tText = ""
	vWarnings = []
	bFixed = false

	def init(ptLanguage, ptVersion, ptText, pvWarnings)
		tLanguage = ptLanguage
		tVersion = ptVersion
		tText = ptText
		vWarnings = pvWarnings
		bFixed = true
	end

	def Language
		return tLanguage
	end

	def Version
		return tVersion
	end

	def Text
		return tText
	end

	def Warnings
		return vWarnings
	end

	# v0.72: a sentence of doors judges a place beneath one of the roots it declares
	def Place(ptRoot, ptText)
		return HaroPlaceOf(this, ptRoot, ptText)
	end

	# v0.73: a sentence of doors judges the arguments of one of the commands it declares
	def Invocation(ptCommand, pxArguments)
		return HaroInvocationOf(this, ptCommand, pxArguments)
	end
end

class HaroLanguage
	tName = ""

	def init(ptName)
		tName = ptName
	end

	def Judge(ptText)
		return HaroJudge(tName, ptText)
	end
end

# ---- v0.72: the place (doc/DOORS.md rung 1) -----------------------------------------------------------------------------------
#
# A sentence of Haro's standard language of doors declares roots. HaroPlaceOf judges an outside text against one of them and answers
# a place -- the root's name, its folder, the path made plain, what the root allows -- or raises its refusal:
#   ROOT_UNKNOWN     the sentence declares no root of that name
#   PLACE_ESCAPES    the text leaves the root: a step back out of it, a rooted path, a drive, a share, a scheme
#   PLACE_NAME       a name no place can hold: nothing, a control byte, a device, a trailing dot or blank, a colon, a wildcard
# A root that says ANYWHERE has no folder to leave: it takes a rooted path and a drive, and allows read alone.

func HaroPlaceOf(psDoors, ptRoot, ptText)
	if psDoors.Language() != "doors"
		Raise("Error (PLACE_NO_DOORS) : a place is judged by a sentence of doors, and this is a sentence of " + psDoors.Language())
	end
	xDecls = HaroDoorsDeclared(psDoors)
	tAt = ""
	bAnywhere = false
	bFound = false
	vAllows = []
	tNames = ""
	for i = 1 to Len(xDecls)
		if xDecls[i][1] != "ROOT" loop end
		if tNames != "" tNames = tNames + ", " end
		tNames = tNames + xDecls[i][2]
		if xDecls[i][2] != ptRoot loop end
		bFound = true
		xClauses = xDecls[i][4]
		for k = 1 to Len(xClauses)
			tKey = Lower(xClauses[k][1])
			if tKey = "at" tAt = xClauses[k][3][2] end
			if tKey = "anywhere" bAnywhere = (xClauses[k][3][2] = "yes") end
			if tKey = "allows" vAllows = xClauses[k][3][2] end
		end
	end
	if not bFound
		Raise("Error (ROOT_UNKNOWN) : no root called `" + ptRoot + "` is declared here; the roots are " + tNames)
	end
	# a root that lists nothing reads; a root ANYWHERE lists nothing (its court: ROOT_ANYWHERE_READS)
	if Len(vAllows) = 0 vAllows = ["read"] end
	tPlain = HaroPlainPath(ptText, ptRoot, bAnywhere)
	tPath = tPlain
	if not bAnywhere
		tFolder = HaroTrimSlash(tAt)
		if tPlain = ""
			tPath = tFolder
		else
			tPath = tFolder + "/" + tPlain
		end
	end
	return new HaroPlace(ptRoot, tAt, tPath, vAllows)
end

# what a sentence of doors declares, read through its own court: [verb, name, ?, clauses, rationale] each, a clause [NAME, ?, [shape, value]]
func HaroDoorsDeclared(psDoors)
	vEntry = HaroLanguageEntry("doors")
	$vCourtLangs = vEntry[3]
	CtUseLanguage("doors")
	CtBuildCondLangs()
	return CtDeclare(psDoors.Text())
end

func HaroTrimSlash(ptFolder)
	tOut = ""
	for i = 1 to Len(ptFolder)
		if Ascii(ptFolder[i]) = 92
			tOut = tOut + "/"
		else
			tOut = tOut + ptFolder[i]
		end
	end
	while Len(tOut) > 1 and Right(tOut, 1) = "/"
		tOut = Left(tOut, Len(tOut) - 1)
	end
	return tOut
end

func HaroEscapes(ptText, ptRoot)
	Raise("Error (PLACE_ESCAPES) : `" + ptText + "` leaves the root `" + ptRoot + "`")
end

func HaroNoName(ptText)
	Raise("Error (PLACE_NAME) : `" + ptText + "` is no name a place can hold")
end

# the text as a path made plain: either slash read as one, `.` dropped, `..` taken where it stays inside
func HaroPlainPath(ptText, ptRoot, pbAnywhere)
	if ptText = "" HaroNoName(ptText) end
	tAll = ""
	for i = 1 to Len(ptText)
		nByte = Ascii(ptText[i])
		if nByte < 32 or nByte = 127 HaroNoName(ptText) end
		if nByte = 92
			tAll = tAll + "/"
		else
			tAll = tAll + ptText[i]
		end
	end
	# a scheme is no path of a root; with no folder to leave, its colon makes it no name of a file (below)
	if SubStr(tAll, "://") > 0 and not pbAnywhere HaroEscapes(ptText, ptRoot) end
	tHead = ""
	tRest = tAll
	if Len(tAll) >= 2 and tAll[2] = ":" and IsAlpha(tAll[1])
		# a drive
		if not pbAnywhere HaroEscapes(ptText, ptRoot) end
		if Len(tAll) < 3 or tAll[3] != "/" HaroNoName(ptText) end
		tHead = Left(tAll, 2) + "/"
		tRest = SubStr(tAll, 4, Len(tAll) - 3)
		if Len(tAll) = 3 tRest = "" end
	elseif Left(tAll, 1) = "/"
		# a rooted path, a share
		if not pbAnywhere HaroEscapes(ptText, ptRoot) end
		tHead = "/"
		if Left(tAll, 2) = "//" tHead = "//" end
		tRest = SubStr(tAll, Len(tHead) + 1, Len(tAll) - Len(tHead))
		if Len(tAll) = Len(tHead) tRest = "" end
	end
	vSegs = []
	tSeg = ""
	tRest = tRest + "/"
	for i = 1 to Len(tRest)
		if tRest[i] != "/"
			tSeg = tSeg + tRest[i]
			loop
		end
		if tSeg = "" or tSeg = "."
			tSeg = ""
			loop
		end
		if tSeg = ".."
			if Len(vSegs) > 0 and vSegs[Len(vSegs)] != ".."
				Del(vSegs, Len(vSegs))
			elseif not pbAnywhere
				HaroEscapes(ptText, ptRoot)
			elseif tHead = ""
				vSegs + ".."
			end
			tSeg = ""
			loop
		end
		HaroNameHolds(tSeg, ptText)
		vSegs + tSeg
		tSeg = ""
	end
	tOut = tHead
	for i = 1 to Len(vSegs)
		if i > 1 tOut = tOut + "/" end
		tOut = tOut + vSegs[i]
	end
	return tOut
end

# one name of a path: what a platform reads otherwise is refused
func HaroNameHolds(ptSeg, ptText)
	tLast = Right(ptSeg, 1)
	if tLast = "." or tLast = " " HaroNoName(ptText) end
	tBad = ":<>|?*" + Char(34)
	for i = 1 to Len(ptSeg)
		if SubStr(tBad, ptSeg[i]) > 0 HaroNoName(ptText) end
	end
	tBase = Lower(ptSeg)
	nDot = SubStr(tBase, ".")
	if nDot > 0 tBase = Left(tBase, nDot - 1) end
	vDevices = ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]
	for i = 1 to Len(vDevices)
		if tBase = vDevices[i] HaroNoName(ptText) end
	end
end

# The VM knows this class by its name and its attributes by their order, as it knows a sentence's (vm/src/main.zig): the second is
# the root's folder (the empty text for a root ANYWHERE), the third the path a place prints as and a door opens, the fourth what
# the root allows, the fifth says it is made -- from then on a write into it is refused (PLACE_FIXED). Keep the order.
class HaroPlace
	tRoot = ""
	tAt = ""
	tPath = ""
	vAllows = []
	bFixed = false

	def init(ptRoot, ptAt, ptPath, pvAllows)
		tRoot = ptRoot
		tAt = ptAt
		tPath = ptPath
		vAllows = pvAllows
		bFixed = true
	end

	def Root
		return tRoot
	end

	def Path
		return tPath
	end

	def Allows
		return vAllows
	end
end

# ---- v0.73: the invocation (doc/DOORS.md rung 2) ---------------------------------------------------------------------------------
#
# A sentence of doors declares commands: a program and the shapes of the arguments it may be given. HaroInvocationOf judges the
# arguments of one of them and answers an invocation -- the command's name, whether it is quiet, the line it prints as, and the
# vector a door starts it from: the program, then each argument as a text -- or raises its refusal:
#   COMMAND_UNKNOWN     the sentence declares no command of that name
#   COMMAND_SHELL       the command runs a shell, or a file a shell reads: a command is a program and its arguments
#   COMMAND_WORDS       the command takes `words` twice, which has no one reading
#   COMMAND_IN          the command runs IN a root that has no folder
#   INVOCATION_COUNT    the arguments are not as many as the command takes
#   INVOCATION_SHAPE    an argument is not the shape declared for its place
# No shell reads an invocation: a door starts the program from the vector, and each argument arrives as it is.

func HaroInvocationOf(psDoors, ptCommand, pxArguments)
	if psDoors.Language() != "doors"
		Raise("Error (INVOCATION_NO_DOORS) : an invocation is judged by a sentence of doors, and this is a sentence of " + psDoors.Language())
	end
	xDecls = HaroDoorsDeclared(psDoors)
	tRuns = ""
	bItself = false
	bQuiet = false
	bFound = false
	vTakes = []
	tIn = ""
	tNames = ""
	for i = 1 to Len(xDecls)
		if xDecls[i][1] != "COMMAND" loop end
		if tNames != "" tNames = tNames + ", " end
		tNames = tNames + xDecls[i][2]
		if xDecls[i][2] != ptCommand loop end
		bFound = true
		xClauses = xDecls[i][4]
		for k = 1 to Len(xClauses)
			tKey = Lower(xClauses[k][1])
			if tKey = "runs" tRuns = xClauses[k][3][2] end
			if tKey = "itself" bItself = (xClauses[k][3][2] = "yes") end
			if tKey = "quiet" bQuiet = (xClauses[k][3][2] = "yes") end
			if tKey = "takes" vTakes = xClauses[k][3][2] end
			if tKey = "in" tIn = xClauses[k][3][2] end
		end
	end
	if not bFound
		Raise("Error (COMMAND_UNKNOWN) : no command called `" + ptCommand + "` is declared here; the commands are " + tNames)
	end
	tProgram = tRuns
	if bItself
		tProgram = ExeFileName()
	else
		HaroNoShell(ptCommand, tRuns)
	end
	# IN a root: the child stands in the root's folder. The court holds that the root is declared (DANGLING); a root with no
	# folder is refused here
	tFolder = ""
	if tIn != ""
		for i = 1 to Len(xDecls)
			if xDecls[i][1] != "ROOT" or xDecls[i][2] != tIn loop end
			xClauses = xDecls[i][4]
			for k = 1 to Len(xClauses)
				if Lower(xClauses[k][1]) = "at" tFolder = HaroTrimSlash(xClauses[k][3][2]) end
			end
		end
		if tFolder = ""
			Raise("Error (COMMAND_IN) : the command `" + ptCommand + "` runs in the root `" + tIn + "`, which has no folder")
		end
	end
	iRuns = 0
	for k = 1 to Len(vTakes)
		if vTakes[k] = "words" iRuns = iRuns + 1 end
	end
	if iRuns > 1
		Raise("Error (COMMAND_WORDS) : the command `" + ptCommand + "` takes words twice: one run of words has a place")
	end
	if not IsList(pxArguments)
		Raise("Error (INVOCATION_SHAPE) : the arguments of `" + ptCommand + "` are given as a vector")
	end
	iGiven = Len(pxArguments)
	iTakes = Len(vTakes)
	if iRuns = 0 and iGiven != iTakes
		Raise("Error (INVOCATION_COUNT) : `" + ptCommand + "` takes " + String(iTakes) + " arguments, and is given " + String(iGiven))
	end
	if iRuns = 1 and iGiven < iTakes
		Raise("Error (INVOCATION_COUNT) : `" + ptCommand + "` takes at least " + String(iTakes) + " arguments, and is given " + String(iGiven))
	end
	vArgv = [tProgram]
	tLine = ptCommand
	iAt = 1
	for k = 1 to iTakes
		tShape = vTakes[k]
		iTimes = 1
		if tShape = "words" iTimes = 1 + iGiven - iTakes end
		for r = 1 to iTimes
			tArgument = HaroArgument(ptCommand, iAt, tShape, pxArguments[iAt])
			# a child that stands in another folder is given a place whole
			if tShape = "place" and tFolder != "" tArgument = HaroWholePath(tArgument) end
			vArgv + tArgument
			tLine = tLine + " " + HaroShown(tArgument)
			iAt = iAt + 1
		end
	end
	return new HaroInvocation(ptCommand, bQuiet, tLine, vArgv, tIn, tFolder)
end

# a path from where this program stands, made whole: either slash read as one
func HaroWholePath(ptPath)
	if Left(ptPath, 1) = "/" return ptPath end
	if Len(ptPath) >= 2 and ptPath[2] = ":" return ptPath end
	return HaroTrimSlash(CurrentDir()) + "/" + ptPath
end

# one argument, judged by its shape: the text the program is given, or the refusal
func HaroArgument(ptCommand, piAt, ptShape, pxValue)
	tNo = "Error (INVOCATION_SHAPE) : argument " + String(piAt) + " of `" + ptCommand + "` is no "
	if ptShape = "number"
		if not IsNumber(pxValue) Raise(tNo + "number") end
		return String(pxValue)
	end
	if ptShape = "place"
		if not HaroIsPlace(pxValue) Raise(tNo + "place") end
		return pxValue.Path()
	end
	if ptShape = "word" or ptShape = "words"
		if not IsString(pxValue) Raise(tNo + "word") end
		if not HaroIsWord(pxValue) Raise(tNo + "word") end
		return pxValue
	end
	if ptShape = "option"
		if not IsString(pxValue) Raise(tNo + "option") end
		tRest = pxValue
		if Left(tRest, 2) = "--"
			tRest = SubStr(tRest, 3, Len(tRest) - 2)
			if Len(pxValue) = 2 tRest = "" end
		elseif Left(tRest, 1) = "-"
			tRest = SubStr(tRest, 2, Len(tRest) - 1)
			if Len(pxValue) = 1 tRest = "" end
		else
			Raise(tNo + "option")
		end
		if not HaroIsWord(tRest) Raise(tNo + "option") end
		return pxValue
	end
	# a text: any text a program can be given as one argument, that no program reads as an option
	if not IsString(pxValue) Raise(tNo + "text") end
	if Left(pxValue, 1) = "-" Raise(tNo + "text") end
	for i = 1 to Len(pxValue)
		iByte = Ascii(pxValue[i])
		if iByte < 32 or iByte = 127 Raise(tNo + "text") end
	end
	return pxValue
end

# a word: letters, digits and _ - . , = with no blank, and no dash first
func HaroIsWord(ptWord)
	if Len(ptWord) = 0 return false end
	if ptWord[1] = "-" return false end
	for i = 1 to Len(ptWord)
		if IsAlnum(ptWord[i]) loop end
		if SubStr("_-.,=", ptWord[i]) > 0 loop end
		return false
	end
	return true
end

func HaroIsPlace(pxValue)
	if not IsObject(pxValue) return false end
	return Lower(ClassName(pxValue)) = "haroplace"
end

# an argument as an invocation prints it: in quotes where it is empty or holds a blank or a quote
func HaroShown(ptArgument)
	tQuote = Char(34)
	if ptArgument = "" or SubStr(ptArgument, " ") > 0 or SubStr(ptArgument, tQuote) > 0
		return tQuote + ptArgument + tQuote
	end
	return ptArgument
end

# D88 (d), no shell: a command names a program; a shell, or a file a shell reads, is none
func HaroNoShell(ptCommand, ptRuns)
	tBase = Lower(ptRuns)
	for i = Len(tBase) to 1 step -1
		if tBase[i] = "/" or Ascii(tBase[i]) = 92
			tBase = SubStr(tBase, i + 1, Len(tBase) - i)
			exit
		end
	end
	tKind = ""
	for i = Len(tBase) to 1 step -1
		if tBase[i] = "."
			tKind = SubStr(tBase, i + 1, Len(tBase) - i)
			tBase = Left(tBase, i - 1)
			exit
		end
	end
	bShell = false
	vKinds = ["bat", "cmd", "ps1", "sh"]
	for i = 1 to Len(vKinds)
		if tKind = vKinds[i] bShell = true end
	end
	vShells = ["cmd", "command", "powershell", "pwsh", "sh", "bash", "zsh", "dash", "ksh", "csh", "tcsh", "fish"]
	for i = 1 to Len(vShells)
		if tBase = vShells[i] bShell = true end
	end
	if bShell
		Raise("Error (COMMAND_SHELL) : the command `" + ptCommand + "` runs a shell, `" + ptRuns + "`: a command is a program and its arguments")
	end
end

# The VM knows this class by its name and its attributes by their order, as it knows a sentence's and a place's (vm/src/main.zig):
# the second says whether the child's standard error is dropped, the third is the line an invocation prints as, the fourth the
# vector a door starts the program from, the fifth says it is made -- from then on a write into it is refused (INVOCATION_FIXED),
# the sixth is the folder the child stands in, the empty text for where this program stands. Keep the order.
class HaroInvocation
	tCommand = ""
	bQuiet = false
	tLine = ""
	vArgv = []
	bFixed = false
	tFolder = ""
	tIn = ""

	def init(ptCommand, pbQuiet, ptLine, pvArgv, ptIn, ptFolder)
		tCommand = ptCommand
		bQuiet = pbQuiet
		tLine = ptLine
		vArgv = pvArgv
		tIn = ptIn
		tFolder = ptFolder
		bFixed = true
	end

	# the root the child stands in, by its name; the empty text when it stands where this program does
	def In
		return tIn
	end

	def Command
		return tCommand
	end

	def Program
		return vArgv[1]
	end

	def Arguments
		vOut = []
		for i = 2 to Len(vArgv)
			vOut + vArgv[i]
		end
		return vOut
	end

	def Quiet
		return bQuiet
	end
end
