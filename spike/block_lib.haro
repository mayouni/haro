# block_lib.haro -- the one reader of C6 and its canonical printer (COMPASS-REBOL-06, step 1; Haro v0.30).
#
# One lexer for the whole family: the meta-court (haro_lib.haro) and every forged court (court_lib.haro) tokenise
# through BlkTokenize, where each had its own; the block loader (BlkLoad) reads the tokens into a BLOCK -- a sequence
# of typed values -- and BlkPrintC6 prints a block in the one canonical spelling. The reference is
# study/rebol/block.py (the Python model BLOCKS.md was measured with); the judge is v30/fixtures.json, written first.
#
# A token is [type, text, line, start, end]: start the index of its first byte, end the index after its last (the
# refinement gate splices a value's span). Types: ident keyword string number lparen rparen lbracket rbracket comma
# colon question dot comment eof. When the text cannot be read the LAST token is
#   [error, category, line, text]   category: unterminated_string | doubled_quote | single_quote | mixed_case |
#                                             number_glued | unexpected_character
# and the lexer stops there. The lexer refuses nothing itself: each reader composes its refusal from the error token
# in its own words (the meta-court's, a court's, the block loader's), so every court prints the bytes it printed.
#
# A value of a block is a list whose first item names its kind:
#   ["word", text]  ["kw", text]  ["str", text]  ["num", text]  ["path", [parts]]
#   ["pair", key, value]      the key a word, a keyword or a path (a string key waits for C6's amendment: Q-B2)
#   ["list", [items]]  ["group", [items]]  ["row", [values]]  ["comment", text]  ["opt", value]   (Haro's `?`: Q-B1)
# A list or a group holds ITEMS separated by commas: an item of one value is that value, an item of several is a ROW.
# A comment is a value in the sequence that holds it; a comment inside a row moves after the row (the one named
# loss besides layout).
#
# Functions only. The loader's two globals, $aBlkToks and $nBlkPos, are born in the root file that calls BlkLoad
# (block.haro, haro.haro); the courts call only the lexer.

# ---- the lexer -----------------------------------------------------------------------------------------------------

func BlkIsDigit(tC)
	nN = Ascii(tC)
	return (nN >= 48 and nN <= 57)

func BlkIsLower(tC)
	nN = Ascii(tC)
	return (nN >= 97 and nN <= 122)

func BlkIsUpper(tC)
	nN = Ascii(tC)
	return (nN >= 65 and nN <= 90)

func BlkIsWordChar(tC)
	return BlkIsLower(tC) or BlkIsUpper(tC) or BlkIsDigit(tC) or Ascii(tC) = 95

func BlkTrim(tS)
	nA = 1
	nB = Len(tS)
	while nA <= nB and (tS[nA] = " " or tS[nA] = Char(9) or tS[nA] = Char(13))
		nA++
	end
	while nB >= nA and (tS[nB] = " " or tS[nB] = Char(9) or tS[nB] = Char(13))
		nB--
	end
	if nB < nA return "" end
	return SubStr(tS, nA, nB - nA + 1)

func BlkTokenize(tSrc)
	aToks = []
	nN = Len(tSrc)
	nI = 1
	nLine = 1
	# a byte-order mark at the start of the text is layout (C6 3.10)
	if nN >= 3 and Ascii(tSrc[1]) = 239 and Ascii(tSrc[2]) = 187 and Ascii(tSrc[3]) = 191 nI = 4 end
	while nI <= nN
		tC = tSrc[nI]
		if tC = Char(10)
			nLine++
			nI++
		elseif tC = " " or tC = Char(9) or tC = Char(13)
			nI++
		elseif tC = "-" and nI < nN and tSrc[nI+1] = "-"
			# a comment runs to the line's end; it is a value of the block, in its place
			nJ = nI + 2
			while nJ <= nN and tSrc[nJ] != Char(10)
				nJ++
			end
			aToks + ["comment", BlkTrim(SubStr(tSrc, nI + 2, nJ - nI - 2)), nLine, nI, nJ]
			nI = nJ
		elseif tC = '"'
			# C6 3.2: a continuation line's leading whitespace folds to one space; what stands before the
			# newline is kept, and \r is dropped (block.py and the courts' reading; the meta-court's old lexer
			# also dropped the whitespace before the newline -- HF-135)
			nStart = nLine
			nBeg = nI
			tBuf = ""
			nI++
			bClosed = false
			while nI <= nN
				tD = tSrc[nI]
				if tD = '"'
					bClosed = true
					nI++
					exit
				end
				if tD = Char(10)
					nLine++
					nI++
					while nI <= nN and (tSrc[nI] = " " or tSrc[nI] = Char(9) or tSrc[nI] = Char(13))
						nI++
					end
					tBuf += " "
					loop
				end
				if tD = Char(13)
					nI++
					loop
				end
				tBuf += tD
				nI++
			end
			if not bClosed
				aToks + ["error", "unterminated_string", nStart, ""]
				return aToks
			end
			# Q-B2 (ruled 2026-11-02): a doubled quote inside a string is a C6 amendment Ringua writes. Until its
			# text lands, a quote that closes one string and opens the next at once is refused by name, so the
			# old reading (two adjacent strings) never stands in for the amendment
			if nI <= nN and tSrc[nI] = '"'
				aToks + ["error", "doubled_quote", nStart, ""]
				return aToks
			end
			aToks + ["string", tBuf, nStart, nBeg, nI]
		elseif tC = "'"
			aToks + ["error", "single_quote", nLine, tC]
			return aToks
		elseif BlkIsDigit(tC) or (tC = "-" and nI < nN and BlkIsDigit(tSrc[nI+1]))
			# C6 3.3: an optional sign, digits, an optional fraction
			nJ = nI
			if tSrc[nJ] = "-" nJ++ end
			while nJ <= nN and BlkIsDigit(tSrc[nJ])
				nJ++
			end
			if nJ < nN and tSrc[nJ] = "." and BlkIsDigit(tSrc[nJ+1])
				nJ++
				while nJ <= nN and BlkIsDigit(tSrc[nJ])
					nJ++
				end
			end
			if nJ <= nN and BlkIsWordChar(tSrc[nJ])
				while nJ <= nN and BlkIsWordChar(tSrc[nJ])
					nJ++
				end
				aToks + ["error", "number_glued", nLine, SubStr(tSrc, nI, nJ - nI)]
				return aToks
			end
			aToks + ["number", SubStr(tSrc, nI, nJ - nI), nLine, nI, nJ]
			nI = nJ
		elseif BlkIsWordChar(tC)
			# C6 3.4, 3.5: a lower_snake word or an UPPER_SNAKE keyword; case is meaning, and mixed case is neither
			nJ = nI
			while nJ <= nN and BlkIsWordChar(tSrc[nJ])
				nJ++
			end
			tW = SubStr(tSrc, nI, nJ - nI)
			bLower = true
			bUpper = true
			for k = 1 to Len(tW)
				if BlkIsLower(tW[k]) bUpper = false end
				if BlkIsUpper(tW[k]) bLower = false end
			end
			if bLower
				aToks + ["ident", tW, nLine, nI, nJ]
			elseif bUpper
				aToks + ["keyword", tW, nLine, nI, nJ]
			else
				aToks + ["error", "mixed_case", nLine, tW]
				return aToks
			end
			nI = nJ
		else
			tT = ""
			if tC = "(" tT = "lparen"
			elseif tC = ")" tT = "rparen"
			elseif tC = "[" tT = "lbracket"
			elseif tC = "]" tT = "rbracket"
			elseif tC = "," tT = "comma"
			elseif tC = ":" tT = "colon"
			elseif tC = "?" tT = "question"
			elseif tC = "." tT = "dot"
			end
			if tT = ""
				aToks + ["error", "unexpected_character", nLine, tC]
				return aToks
			end
			aToks + [tT, tC, nLine, nI, nI + 1]
			nI++
		end
	end
	aToks + ["eof", "", nLine, nN + 1, nN + 1]
	return aToks

# the last token, when it is an error; NULL otherwise
func BlkLexError(aToks)
	aT = aToks[Len(aToks)]
	if aT[1] = "error" return aT end
	return null

# the tokens without their comments: what a court's parser reads (a comment is layout to a court, a value to the block)
func BlkWithoutComments(aToks)
	aOut = []
	for i = 1 to Len(aToks)
		if aToks[i][1] != "comment" aOut + aToks[i] end
	end
	return aOut

# ---- the block loader --------------------------------------------------------------------------------------------------

func BlkFail(nLine, tMsg)
	Raise("block (line " + String(nLine) + "): " + tMsg)

func BlkLexMessage(xT)
	tCat = xT[2]
	if tCat = "unterminated_string" return "a string opened and not closed" end
	if tCat = "doubled_quote" return "a doubled quote inside a string waits for C6's amendment (Q-B2): Ringua writes it; today a C6 string has no escape" end
	if tCat = "single_quote" return "a single quote; C6 strings are double-quoted (.zql's D-ZQL-1 is a divergence)" end
	if tCat = "mixed_case" return "'" + xT[4] + "' is neither a lower_snake identifier nor an UPPER_SNAKE keyword" end
	if tCat = "number_glued" return "'" + xT[4] + "' is neither a number nor a word" end
	return "the character '" + xT[4] + "' is not part of C6"

func BlkPeek
	return $aBlkToks[$nBlkPos]

func BlkPeekAt(nK)
	nJ = $nBlkPos + nK
	if nJ > Len($aBlkToks) return $aBlkToks[Len($aBlkToks)] end
	return $aBlkToks[nJ]

# C6 text -> the top-level sequence of values
func BlkLoad(tSrc)
	$aBlkToks = BlkTokenize(tSrc)
	aE = BlkLexError($aBlkToks)
	if not IsNull(aE) BlkFail(aE[3], BlkLexMessage(aE)) end
	$nBlkPos = 1
	aOut = []
	while BlkPeek()[1] != "eof"
		if BlkPeek()[1] = "comment"
			aOut + ["comment", BlkPeek()[2]]
			$nBlkPos++
		else
			aOut + BlkValue()
		end
	end
	return aOut

# a name is a word or a keyword, or a path: words joined by dots with no space between (deposit.amount)
func BlkName
	aT = BlkPeek()
	$nBlkPos++
	aParts = [aT[2]]
	nEnd = aT[5]
	while BlkPeek()[1] = "dot" and BlkPeek()[4] = nEnd and BlkPeekAt(1)[1] = "ident" and BlkPeekAt(1)[4] = BlkPeek()[5]
		$nBlkPos++
		aT2 = BlkPeek()
		$nBlkPos++
		aParts + aT2[2]
		nEnd = aT2[5]
	end
	if Len(aParts) > 1 return ["path", aParts] end
	if aT[1] = "keyword" return ["kw", aT[2]] end
	return ["word", aT[2]]

func BlkNameText(xV)
	if xV[1] = "path" return BlkJoin(xV[2], ".") end
	return xV[2]

func BlkValue
	aV = BlkValue1()
	while BlkPeek()[1] = "question"
		$nBlkPos++
		aV = ["opt", aV]
	end
	return aV

func BlkValue1
	aT = BlkPeek()
	if aT[1] = "ident" or aT[1] = "keyword"
		xKey = BlkName()
		if BlkPeek()[1] = "colon"
			$nBlkPos++
			tNx = BlkPeek()[1]
			if tNx = "comma" or tNx = "rparen" or tNx = "rbracket" or tNx = "eof"
				BlkFail(aT[3], "a pair with no value after " + BlkNameText(xKey) + ":")
			end
			return ["pair", xKey, BlkValue()]
		end
		return xKey
	end
	if aT[1] = "string"
		$nBlkPos++
		if BlkPeek()[1] = "colon"
			# Q-B2 (ruled 2026-11-02): a string as a pair's key is a C6 amendment Ringua writes; refused by name until its text lands
			BlkFail(aT[3], "a string as a pair's key waits for C6's amendment (Q-B2): Ringua writes it; today a key is a word, a keyword or a path")
		end
		return ["str", aT[2]]
	end
	if aT[1] = "number"
		$nBlkPos++
		return ["num", aT[2]]
	end
	if aT[1] = "lbracket"
		$nBlkPos++
		return ["list", BlkContainer("rbracket", "list", aT[3])]
	end
	if aT[1] = "lparen"
		$nBlkPos++
		return ["group", BlkContainer("rparen", "group", aT[3])]
	end
	if aT[1] = "comma" BlkFail(aT[3], "a comma outside a list or a group") end
	if aT[1] = "eof" BlkFail(aT[3], "the text ends inside a value") end
	if aT[1] = "dot" BlkFail(aT[3], "unexpected '.': a dot joins the words of a path, with no space on either side") end
	if aT[1] = "question" BlkFail(aT[3], "unexpected '?': the mark stands after the value it makes optional, and nothing stands before this one") end
	BlkFail(aT[3], "unexpected '" + aT[2] + "'")

func BlkCountValues(aSeg)
	nN = 0
	for i = 1 to Len(aSeg)
		if aSeg[i][1] != "comment" nN++ end
	end
	return nN

# one item of a container, closed by a comma or the closing bracket: its comments before the first value lead,
# the ones after follow; one value is that value, several are a row
func BlkFlush(aItems, aSeg)
	aVals = []
	aLead = []
	aTrail = []
	bSeen = false
	for i = 1 to Len(aSeg)
		xV = aSeg[i]
		if xV[1] = "comment"
			if bSeen
				aTrail + xV
			else
				aLead + xV
			end
		else
			bSeen = true
			aVals + xV
		end
	end
	for i = 1 to Len(aLead)
		aItems + aLead[i]
	end
	if Len(aVals) = 1
		aItems + aVals[1]
	elseif Len(aVals) > 1
		aItems + ["row", aVals]
	end
	for i = 1 to Len(aTrail)
		aItems + aTrail[i]
	end
	return aItems

func BlkContainer(tClose, tWhat, nLine0)
	aItems = []
	aSeg = []
	while true
		aT = BlkPeek()
		if aT[1] = "eof"
			BlkFail(nLine0, "a " + tWhat + " not closed")
		end
		if aT[1] = tClose
			$nBlkPos++
			aItems = BlkFlush(aItems, aSeg)
			return aItems
		end
		if aT[1] = "comma"
			$nBlkPos++
			if BlkCountValues(aSeg) = 0
				BlkFail(aT[3], "an empty item before a comma")
			end
			aItems = BlkFlush(aItems, aSeg)
			aSeg = []
			loop
		end
		if aT[1] = "comment"
			$nBlkPos++
			aSeg + ["comment", aT[2]]
			loop
		end
		aSeg + BlkValue()
	end

# ---- equality: one spelling of a block, for comparing two ------------------------------------------------------------

func BlkJoin(aParts, tSep)
	tOut = ""
	for i = 1 to Len(aParts)
		if i > 1 tOut += tSep end
		tOut += aParts[i]
	end
	return tOut

# a block dumped as one line: every kind tagged, every text length-prefixed, so two blocks are equal exactly when
# their dumps are. `block.haro load` prints it; `same` compares it
func BlkDump(xV)
	xK = xV[1]
	if xK = "word" or xK = "kw" or xK = "num" or xK = "str" or xK = "comment"
		return "(" + String(xK) + " " + String(Len(xV[2])) + ":" + String(xV[2]) + ")"
	end
	if xK = "path" return "(path " + BlkJoin(xV[2], ".") + ")" end
	if xK = "pair" return "(pair " + BlkDump(xV[2]) + " " + BlkDump(xV[3]) + ")" end
	if xK = "opt" return "(opt " + BlkDump(xV[2]) + ")" end
	tOut = "(" + xK
	for i = 1 to Len(xV[2])
		tOut += " " + BlkDump(xV[2][i])
	end
	return tOut + ")"

func BlkDumpAll(aVals)
	tOut = ""
	for i = 1 to Len(aVals)
		if i > 1 tOut += " " end
		tOut += BlkDump(aVals[i])
	end
	return tOut

# ---- the canonical printing (BLOCKS.md 3.2) ----------------------------------------------------------------------------
# One spelling per block: a declaration a paragraph and a blank line between them; a group's items one a line, two
# spaces deeper, a comma after each but the last; a list inline unless it holds a comment or a group; a string on one
# line; a comment on its own line.

func BlkHoldsCommentOrGroup(aItems)
	for i = 1 to Len(aItems)
		if aItems[i][1] = "comment" or aItems[i][1] = "group" return true end
	end
	return false

func BlkPrint(xV, nInd)
	xK = xV[1]
	if xK = "word" or xK = "kw" or xK = "num" return xV[2] end
	if xK = "str"
		for i = 1 to Len(xV[2])
			if xV[2][i] = '"' BlkFail(0, "a string holding a double quote has no C6 printing (C6 strings have no escape)") end
		end
		return '"' + xV[2] + '"'
	end
	if xK = "path" return BlkJoin(xV[2], ".") end
	if xK = "pair" return BlkPrint(xV[2], nInd) + ": " + BlkPrint(xV[3], nInd) end
	if xK = "row"
		aP = []
		for i = 1 to Len(xV[2])
			aP + BlkPrint(xV[2][i], nInd)
		end
		return BlkJoin(aP, " ")
	end
	if xK = "opt" return BlkPrint(xV[2], nInd) + "?" end
	if xK = "comment"
		if xV[2] = "" return "--" end
		return "-- " + xV[2]
	end
	if xK = "list"
		if Len(xV[2]) = 0 return "[]" end
		if BlkHoldsCommentOrGroup(xV[2]) return "[" + BlkLines(xV[2], nInd) + "]" end
		aP = []
		for i = 1 to Len(xV[2])
			aP + BlkPrint(xV[2][i], nInd)
		end
		return "[" + BlkJoin(aP, ", ") + "]"
	end
	if xK = "group"
		if Len(xV[2]) = 0 return "()" end
		return "(" + BlkLines(xV[2], nInd) + ")"
	end
	BlkFail(0, "no printing for a value of kind '" + xK + "'")

func BlkSpaces(nN)
	tOut = ""
	for i = 1 to nN
		tOut += " "
	end
	return tOut

func BlkLines(aItems, nInd)
	tPad = BlkSpaces(nInd + 2)
	nLastReal = 0
	for j = 1 to Len(aItems)
		if aItems[j][1] != "comment" nLastReal = j end
	end
	tOut = Char(10)
	for j = 1 to Len(aItems)
		tComma = ""
		if aItems[j][1] != "comment" and j != nLastReal tComma = "," end
		tOut += tPad + BlkPrint(aItems[j], nInd + 2) + tComma + Char(10)
	end
	return tOut + BlkSpaces(nInd)

# the whole text: a paragraph per declaration (each DEFINE opens one), a comment on a line of its own, a blank line
# between paragraphs
func BlkPrintC6(aVals)
	aParas = []
	aCur = []
	for i = 1 to Len(aVals)
		xV = aVals[i]
		if xV[1] = "kw" and xV[2] = "DEFINE" and Len(aCur) > 0
			aParas + aCur
			aCur = []
		end
		if xV[1] = "comment"
			if Len(aCur) > 0
				aParas + aCur
				aCur = []
			end
			aParas + [xV]
			loop
		end
		aCur + xV
	end
	if Len(aCur) > 0 aParas + aCur end
	tOut = ""
	for p = 1 to Len(aParas)
		if p > 1 tOut += Char(10) end
		aP = []
		for i = 1 to Len(aParas[p])
			aP + BlkPrint(aParas[p][i], 0)
		end
		tOut += BlkJoin(aP, " ") + Char(10)
	end
	return tOut
