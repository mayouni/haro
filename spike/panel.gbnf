# lower_snake identifiers, trailing commas. A clause given twice and a required seat
# absent are the court's to refuse; the decoder holds the shape.

root ::= ws decl (ws decl)* ws
decl ::= decl_INTENT_FLOW | decl_FORM | decl_WORLD_VIEW | decl_INTERACTION
decl_INTENT_FLOW ::= "DEFINE" sp "INTENT_FLOW" sp ident sp "AS" ws "(" ws (clause_INTENT_FLOW (ws "," ws clause_INTENT_FLOW)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_INTENT_FLOW ::= "SATISFIES" sp namelist
decl_FORM ::= "DEFINE" sp "FORM" sp ident sp "AS" ws "(" ws (clause_FORM (ws "," ws clause_FORM)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_FORM ::= "SATISFIES" sp namelist | "INTENT_FLOW" sp ident | "NEXT" sp ident | "ALSO" sp namelist
decl_WORLD_VIEW ::= "DEFINE" sp "WORLD_VIEW" sp ident sp "AS" ws "(" ws (clause_WORLD_VIEW (ws "," ws clause_WORLD_VIEW)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
