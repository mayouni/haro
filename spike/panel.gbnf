decl_INTERACTION ::= "DEFINE" sp "INTERACTION" sp ident sp "AS" ws "(" ws (clause_INTERACTION (ws "," ws clause_INTERACTION)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_INTERACTION ::= "ROLE" sp ident

ident ::= [a-z_] [a-z0-9_]*
string ::= "\"" [^"]* "\""
number ::= [0-9]+
namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"
stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"
sp ::= [ \t]+
ws ::= ([ \t\r\n] | "--" [^\n]* "\n")*
