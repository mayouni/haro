oZip = zip_openfile("slip.zip", "w")
zip_entry_open(oZip, "../evil.txt")
zip_entry_write(oZip, "x", 1)
zip_entry_close(oZip)
zip_entry_open(oZip, "ok.txt")
zip_entry_write(oZip, "y", 1)
zip_entry_close(oZip)
zip_close(oZip)
zip_extract_allfiles("slip.zip", "out")
? fexists("evil.txt")
? fexists("out/ok.txt")
