oZip = zip_openfile("dup.zip", "w")
zip_entry_open(oZip, "a.txt")
zip_entry_write(oZip, "first", 5)
zip_entry_close(oZip)
zip_entry_open(oZip, "a.txt")
zip_entry_write(oZip, "second", 6)
zip_entry_close(oZip)
zip_entry_open(oZip, "b.txt")
zip_entry_write(oZip, "bee", 3)
zip_entry_close(oZip)
zip_close(oZip)
? zip_extract_allfiles("dup.zip", "out")
? read("out/a.txt")
? read("out/b.txt")
