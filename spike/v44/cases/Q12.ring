oZip = zip_openfile("two.zip", "w")
zip_entry_open(oZip, "a.txt")
zip_entry_write(oZip, "one", 3)
zip_entry_close(oZip)
zip_close(oZip)
oZip = zip_openfile("two.zip", "a")
zip_entry_open(oZip, "b.txt")
zip_entry_write(oZip, "two", 3)
zip_entry_close(oZip)
zip_close(oZip)
oZip = zip_openfile("two.zip", "r")
? zip_filescount(oZip)
zip_close(oZip)
