# forms_lib.haro -- FORMS: a vocabulary's function-name grammar as data
# (Haro v0.12, principle 7 of haro/PRINCIPLES.md), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a FORMS loads this file
# beside court_lib.haro and carries the FORMS as
#   $aCourtFormset = [name, fluent, passive, statement, [[key, suffix], ...],
#                     [kind, base seat, forms seat]]
# The grammar is the forms document's (stzlib base/doc/narrations/
# stz-functions-as-linguistic-expressions.md) under the rule principle 7
# ruled (H-7): a name is a BASE (CamelCase words, never judged here) followed
# by parameter SUFFIXES, each spelt once, then the FLUENT form, then the
# STATEMENT form -- `RemoveManyCS`, `FindNextSTCS`, `ReplaceAllCSQ`,
# `AllNumbersInQX`. Suffix order is parameter order and is free (point 3);
# a suffix twice, the fluent form not last, or a trailing run of capitals no
# suffix spells is a disagreement (point 7, the FF clash); a fluent name
# requires its plain twin in the same list (point 2); a name whose base is a
# declared FAMILY's must be one of the members that family generates (point
# 6). The PASSIVE inflection is applied only when a family is GENERATED
# (Replace -> Replaced, Spacify -> Spacified): no dictionary can invert it,
# so a name is never read as passive.
#
#   <court>.ring family <file>               every FAMILY's members, generated
#   <court>.ring spellings <file> <names>    one verdict per name, then a summary
#
# Functions only; the globals are the generated court's.

func FormsFail(nLine, tMsg)
	CtFailC(nLine, "FORMS", ["rule:forms"], tMsg)
end
func FormsKindByName(tName)
	for i = 1 to Len($xCourtKinds)
		if $xCourtKinds[i][2] = tName return $xCourtKinds[i] end
	end
	return ""
end
func FormsIsUpper(tC)
	return Ascii(tC) >= 65 and Ascii(tC) <= 90
end
func FormsIsVowel(tC)
	return InStrListCs(Lower(tC), ["a", "e", "i", "o", "u"])
end
func InStrListCs(tS, xL)
	for i = 1 to Len(xL)
		if xL[i] = tS return true end
	end
	return false
end
func FormsEndsWith(tS, tSuf)
	if Len(tSuf) = 0 return false end
	if Len(tS) < Len(tSuf) return false end
	return Right(tS, Len(tSuf)) = tSuf
end
func FormsSuffixOf(tKey)
	xP = $xCourtFormset[5]
	for i = 1 to Len(xP)
		if xP[i][1] = tKey return xP[i][2] end
	end
	return ""
end
# the words a FAMILY may offer: every PARAMS key, and fluent / passive when declared
func FormsOffered
	xOut = []
	xF = $xCourtFormset
	for i = 1 to Len(xF[5])
		xOut + xF[5][i][1]
	end
	if xF[2] != "" xOut + "fluent" end
	if xF[3] != "" xOut + "passive" end
	return xOut
end
# the FAMILY declarations of a sentence, as [name, base, offered words, line]
func FormsFamilies(xDecls)
	xOut = []
	xF = $xCourtFormset
	if Len(xF) < 6 return xOut end
	if Len(xF[6]) < 3 return xOut end
	xKind = FormsKindByName(xF[6][1])
	if IsEmpty(xKind) return xOut end
	for i = 1 to Len(xDecls)
		xD = xDecls[i]
		if xD[1] != xKind[1] loop end
		tBase = ""
		xWords = []
		xC = xD[4]
		for j = 1 to Len(xC)
			if Lower(xC[j][1]) = xF[6][2] and (xC[j][3][1] = "string" or xC[j][3][1] = "word") tBase = xC[j][3][2] end
			if Lower(xC[j][1]) = xF[6][3] and xC[j][3][1] = "namelist" xWords = xC[j][3][2] end
		end
		xOut + [xD[2], tBase, xWords, xD[3]]
	end
	return xOut
end
# a collecting court has already refused this word on this line, through the menu that types
# the seat: the FORMS pass is the second guard and says nothing twice (v0.14)
func FormsAlreadySaid(nLine, tWord)
	if not $bCourtCollect return false end
	for i = 1 to Len($vCourtFound)
		if $vCourtFound[i][3] = nLine and $vCourtFound[i][1] = "FORMS" and SubStr($vCourtFound[i][4], "'" + tWord + "'") > 0 return true end
	end
	return false
end
# at check: a family offers only forms the FORMS declares, each once
func FormsCheck(xDecls)
	xFam = FormsFamilies(xDecls)
	xOffered = FormsOffered()
	for i = 1 to Len(xFam)
		vSeen = []
		for j = 1 to Len(xFam[i][3])
			tW = xFam[i][3][j]
			if not InStrListCs(tW, xOffered) and not FormsAlreadySaid(xFam[i][4], tW)
				FormsFail(xFam[i][4], "FAMILY " + xFam[i][1] + " offers '" + tW + "', which the FORMS " + $xCourtFormset[1] + " declares no form for: it declares " + CtJoin(xOffered, ", "))
			end
			if InStrListCs(tW, vSeen)
				FormsFail(xFam[i][4], "FAMILY " + xFam[i][1] + " offers '" + tW + "' twice")
			end
			vSeen + tW
		end
		if xFam[i][2] = ""
			FormsFail(xFam[i][4], "FAMILY " + xFam[i][1] + " has no base verb")
		end
	end
end
# the passive inflection of a base verb: Replace -> Replaced, Spacify -> Spacified, Find -> Finded
func FormsPassive(tBase)
	tInf = $xCourtFormset[3]
	if tInf != "ed" return tBase + tInf end
	nN = Len(tBase)
	if nN = 0 return tBase end
	tLast = tBase[nN]
	if tLast = "e" return tBase + "d" end
	if tLast = "y" and nN >= 2
		if not FormsIsVowel(tBase[nN - 1]) return Left(tBase, nN - 1) + "ied" end
	end
	return tBase + "ed"
end
# every member a family generates: each subset of its parameter forms, in the
# order offered, as the plain name, then the fluent name, then the passive name
func FormsMembers(tBase, xWords)
	xKeys = []
	bFluent = false
	bPassive = false
	for i = 1 to Len(xWords)
		if xWords[i] = "fluent"
			bFluent = true
		elseif xWords[i] = "passive"
			bPassive = true
		else
			xKeys + xWords[i]
		end
	end
	nCombos = 1
	for i = 1 to Len(xKeys)
		nCombos = nCombos * 2
	end
	xOut = []
	for m = 0 to nCombos - 1
		tSuf = ""
		nV = m
		for i = 1 to Len(xKeys)
			if nV % 2 = 1 tSuf += FormsSuffixOf(xKeys[i]) end
			nV = Floor(nV / 2)
		end
		xOut + (tBase + tSuf)
		if bFluent xOut + (tBase + tSuf + $xCourtFormset[2]) end
		if bPassive xOut + (FormsPassive(tBase) + tSuf) end
	end
	return xOut
end
func FormsPrintFamilies(xDecls)
	xFam = FormsFamilies(xDecls)
	for i = 1 to Len(xFam)
		xM = FormsMembers(xFam[i][2], xFam[i][3])
		? "family " + String(xFam[i][1]) + ": " + String(xFam[i][2]) + " offering [" + CtJoin(xFam[i][3], ", ") + "], " + String(Len(xM)) + " members"
		for j = 1 to Len(xM)
			? "  " + xM[j]
		end
	end
	if Len(xFam) = 0 ? "no family declared" end
end
# a name split under the FORMS: [base, keys, fluent, statement, why]; why "" when it parses
func FormsSplit(tName)
	xF = $xCourtFormset
	tRest = tName
	bStmt = false
	if FormsEndsWith(tRest, xF[4])
		tRest = Left(tRest, Len(tRest) - Len(xF[4]))
		bStmt = true
	end
	bFluent = false
	if FormsEndsWith(tRest, xF[2])
		tRest = Left(tRest, Len(tRest) - Len(xF[2]))
		bFluent = true
	end
	xKeys = []
	while true
		tBest = ""
		tBestKey = ""
		for nI = 1 to Len(xF[5])
			tSuf = xF[5][nI][2]
			if FormsEndsWith(tRest, tSuf) and Len(tSuf) > Len(tBest)
				tBest = tSuf
				tBestKey = xF[5][nI][1]
			end
		end
		if tBest = "" exit end
		if InStrListCs(tBestKey, xKeys)
			return [tRest, xKeys, bFluent, bStmt, "the suffix " + tBest + " appears twice"]
		end
		tRest = Left(tRest, Len(tRest) - Len(tBest))
		Insert(xKeys, 0, tBestKey)
		if Len(tRest) = 0
			return [tRest, xKeys, bFluent, bStmt, "nothing is left of the name but suffixes"]
		end
	end
	if FormsEndsWith(tRest, xF[2])
		return [tRest, xKeys, bFluent, bStmt, "the fluent form " + xF[2] + " is not last"]
	end
	if FormsEndsWith(tRest, xF[4])
		return [tRest, xKeys, bFluent, bStmt, "the statement form " + xF[4] + " is not outermost"]
	end
	nN = Len(tRest)
	nI = nN
	while nI >= 1
		if not FormsIsUpper(tRest[nI]) exit end
		nI--
	end
	if nI < nN and nI >= 1
		tRun = SubStr(tRest, nI + 1)
		if Len(tRun) >= 2
			return [tRest, xKeys, bFluent, bStmt, "ends in '" + tRun + "', which no declared suffix spells"]
		end
	end
	return [tRest, xKeys, bFluent, bStmt, ""]
end
# the plain twin of a fluent name: the name with the fluent form removed
func FormsPlainTwin(xSplit)
	tOut = xSplit[1]
	for i = 1 to Len(xSplit[2])
		tOut += FormsSuffixOf(xSplit[2][i])
	end
	if xSplit[4] tOut += $xCourtFormset[4] end
	return tOut
end
func FormsReadNames(tPath)
	if not FExists(tPath) CtFail(1, "no names file at '" + tPath + "'") end
	tText = Read(tPath)
	xOut = []
	tL = ""
	for i = 1 to Len(tText)
		tC = tText[i]
		if tC = Char(10)
			FormsTakeName(xOut, tL)
			tL = ""
		else
			tL += tC
		end
	end
	FormsTakeName(xOut, tL)
	return xOut
end
func FormsTakeName(xOut, tRaw)
	tL = FormsTrim(tRaw)
	if Len(tL) = 0 return end
	if tL[1] = "#" return end
	xOut + tL
end
func FormsTrim(tS)
	nI = 1
	nN = Len(tS)
	while nI <= nN
		tC = tS[nI]
		if tC != " " and tC != Char(9) and tC != Char(13) exit end
		nI++
	end
	nJ = nN
	while nJ >= nI
		tC = tS[nJ]
		if tC != " " and tC != Char(9) and tC != Char(13) exit end
		nJ--
	end
	if nJ < nI return "" end
	return SubStr(tS, nI, nJ - nI + 1)
end
func FormsPrintSpellings(xDecls, xNames)
	xFam = FormsFamilies(xDecls)
	vMembers = []
	for i = 1 to Len(xFam)
		vMembers + FormsMembers(xFam[i][2], xFam[i][3])
	end
	nAgree = 0
	nDis = 0
	for i = 1 to Len(xNames)
		tName = xNames[i]
		xS = FormsSplit(tName)
		tWhy = xS[5]
		tOf = ""
		if tWhy = "" and xS[3]
			tTwin = FormsPlainTwin(xS)
			if not InStrListCs(tTwin, xNames)
				tWhy = tName + " requires " + tTwin + ": the fluent form stands beside its plain twin"
			end
		end
		if tWhy = ""
			for j = 1 to Len(xFam)
				tBase = xFam[j][2]
				bOfFamily = false
				if InStrListCs(tName, vMembers[j])
					bOfFamily = true
				elseif xS[1] = tBase
					bOfFamily = true
				elseif Len(xFam[j][3]) > 0
					if InStrListCs("passive", xFam[j][3]) and xS[1] = FormsPassive(tBase) bOfFamily = true end
				end
				if bOfFamily
					if InStrListCs(tName, vMembers[j])
						tOf = " member of " + xFam[j][1]
					else
						tWhy = "the family " + xFam[j][1] + " offers [" + CtJoin(xFam[j][3], ", ") + "] and not the forms of " + tName
					end
					exit
				end
			end
		end
		if tWhy = ""
			nAgree++
			tLine = "agree " + tName + " base=" + xS[1] + " forms=[" + CtJoin(xS[2], ", ") + "]"
			if xS[3] tLine += " fluent" end
			if xS[4] tLine += " statement" end
			? tLine + tOf
		else
			nDis++
			? "disagree " + tName + ": " + tWhy
		end
	end
	nMissing = 0
	for i = 1 to Len(xFam)
		for j = 1 to Len(vMembers[i])
			if not InStrListCs(vMembers[i][j], xNames)
				nMissing++
				? "missing " + vMembers[i][j] + " (family " + xFam[i][1] + ")"
			end
		end
	end
	? "spellings: " + String(nAgree) + " agree, " + String(nDis) + " disagree of " + String(Len(xNames)) + "; " + String(nMissing) + " declared members missing"
end
