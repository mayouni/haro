# forms_lib.haro -- FORMS: a vocabulary's function-name grammar as data
# (Haro v0.12, principle 7 of haro/PRINCIPLES.md), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a FORMS loads this file
# beside court_lib.haro and carries the FORMS as
#   $aCourtFormset = [name, fluent, passive, statement, [[key, suffix], ...],
#                     [kind, base seat, forms seat]]
# The grammar is the forms document's (stzlib base/doc/narrations/
# stz-functions-as-linguistic-expressions.md) under the rule principle 7
# ruled (H-7): a name is a BASE (CamelCase words, never judged here) followed
# by parameter SUFFIXES, each spelt once, then the FLUENT form, then the
# STATEMENT form -- `RemoveManyCS`, `FindNextSTCS`, `ReplaceAllCSQ`,
# `AllNumbersInQX`. Suffix order is parameter order and is free (point 3);
# a suffix twice, the fluent form not last, or a trailing run of capitals no
# suffix spells is a disagreement (point 7, the FF clash); a fluent name
# requires its plain twin in the same list (point 2); a name whose base is a
# declared FAMILY's must be one of the members that family generates (point
# 6). The PASSIVE inflection is applied only when a family is GENERATED
# (Replace -> Replaced, Spacify -> Spacified): no dictionary can invert it,
# so a name is never read as passive.
#
#   <court>.ring family <file>               every FAMILY's members, generated
#   <court>.ring spellings <file> <names>    one verdict per name, then a summary
#
# Functions only; the globals are the generated court's.

func FormsFail(nLine, tMsg)
	CtFailC(nLine, "FORMS", ["rule:forms"], tMsg)

func FormsKindByName(tName)
	for i = 1 to Len($aCourtKinds)
		if $aCourtKinds[i][2] = tName return $aCourtKinds[i] ok
	next
	return null

func FormsIsUpper(tC)
	return Ascii(tC) >= 65 and Ascii(tC) <= 90

func FormsIsVowel(tC)
	return InStrListCs(Lower(tC), ["a", "e", "i", "o", "u"])

func InStrListCs(tS, aL)
	for i = 1 to Len(aL)
		if aL[i] = tS return true ok
	next
	return false

func FormsEndsWith(tS, tSuf)
	if Len(tSuf) = 0 return false ok
	if Len(tS) < Len(tSuf) return false ok
	return Right(tS, Len(tSuf)) = tSuf

func FormsSuffixOf(tKey)
	aP = $aCourtFormset[5]
	for i = 1 to Len(aP)
		if aP[i][1] = tKey return aP[i][2] ok
	next
	return ""

# the words a FAMILY may offer: every PARAMS key, and fluent / passive when declared
func FormsOffered()
	aOut = []
	aF = $aCourtFormset
	for i = 1 to Len(aF[5])
		aOut + aF[5][i][1]
	next
	if aF[2] != "" aOut + "fluent" ok
	if aF[3] != "" aOut + "passive" ok
	return aOut

# the FAMILY declarations of a sentence, as [name, base, offered words, line]
func FormsFamilies(aDecls)
	aOut = []
	aF = $aCourtFormset
	if Len(aF) < 6 return aOut ok
	if Len(aF[6]) < 3 return aOut ok
	aKind = FormsKindByName(aF[6][1])
	if IsNull(aKind) return aOut ok
	for i = 1 to Len(aDecls)
		aD = aDecls[i]
		if aD[1] != aKind[1] loop ok
		tBase = ""
		aWords = []
		aC = aD[4]
		for j = 1 to Len(aC)
			if Lower(aC[j][1]) = aF[6][2] and (aC[j][3][1] = "string" or aC[j][3][1] = "word") tBase = aC[j][3][2] ok
			if Lower(aC[j][1]) = aF[6][3] and aC[j][3][1] = "namelist" aWords = aC[j][3][2] ok
		next
		aOut + [aD[2], tBase, aWords, aD[3]]
	next
	return aOut

# a collecting court has already refused this word on this line, through the menu that types
# the seat: the FORMS pass is the second guard and says nothing twice (v0.14)
func FormsAlreadySaid(nLine, tWord)
	if not $bCourtCollect return false ok
	for i = 1 to Len($aCourtFound)
		if $aCourtFound[i][3] = nLine and $aCourtFound[i][1] = "FORMS" and SubStr($aCourtFound[i][4], "'" + tWord + "'") > 0 return true ok
	next
	return false

# at check: a family offers only forms the FORMS declares, each once
func FormsCheck(aDecls)
	aFam = FormsFamilies(aDecls)
	aOffered = FormsOffered()
	for i = 1 to Len(aFam)
		aSeen = []
		for j = 1 to Len(aFam[i][3])
			tW = aFam[i][3][j]
			if not InStrListCs(tW, aOffered) and not FormsAlreadySaid(aFam[i][4], tW)
				FormsFail(aFam[i][4], "FAMILY " + aFam[i][1] + " offers '" + tW + "', which the FORMS " + $aCourtFormset[1] + " declares no form for: it declares " + CtJoin(aOffered, ", "))
			ok
			if InStrListCs(tW, aSeen)
				FormsFail(aFam[i][4], "FAMILY " + aFam[i][1] + " offers '" + tW + "' twice")
			ok
			aSeen + tW
		next
		if aFam[i][2] = ""
			FormsFail(aFam[i][4], "FAMILY " + aFam[i][1] + " has no base verb")
		ok
	next

# the passive inflection of a base verb: Replace -> Replaced, Spacify -> Spacified, Find -> Finded
func FormsPassive(tBase)
	tInf = $aCourtFormset[3]
	if tInf != "ed" return tBase + tInf ok
	nN = Len(tBase)
	if nN = 0 return tBase ok
	tLast = tBase[nN]
	if tLast = "e" return tBase + "d" ok
	if tLast = "y" and nN >= 2
		if not FormsIsVowel(tBase[nN - 1]) return Left(tBase, nN - 1) + "ied" ok
	ok
	return tBase + "ed"

# every member a family generates: each subset of its parameter forms, in the
# order offered, as the plain name, then the fluent name, then the passive name
func FormsMembers(tBase, aWords)
	aKeys = []
	bFluent = false
	bPassive = false
	for i = 1 to Len(aWords)
		if aWords[i] = "fluent"
			bFluent = true
		but aWords[i] = "passive"
			bPassive = true
		else
			aKeys + aWords[i]
		ok
	next
	nCombos = 1
	for i = 1 to Len(aKeys)
		nCombos = nCombos * 2
	next
	aOut = []
	for m = 0 to nCombos - 1
		tSuf = ""
		nV = m
		for i = 1 to Len(aKeys)
			if nV % 2 = 1 tSuf += FormsSuffixOf(aKeys[i]) ok
			nV = Floor(nV / 2)
		next
		aOut + (tBase + tSuf)
		if bFluent aOut + (tBase + tSuf + $aCourtFormset[2]) ok
		if bPassive aOut + (FormsPassive(tBase) + tSuf) ok
	next
	return aOut

func FormsPrintFamilies(aDecls)
	aFam = FormsFamilies(aDecls)
	for i = 1 to Len(aFam)
		aM = FormsMembers(aFam[i][2], aFam[i][3])
		? "family " + String(aFam[i][1]) + ": " + String(aFam[i][2]) + " offering [" + CtJoin(aFam[i][3], ", ") + "], " + String(Len(aM)) + " members"
		for j = 1 to Len(aM)
			? "  " + aM[j]
		next
	next
	if Len(aFam) = 0 ? "no family declared" ok

# a name split under the FORMS: [base, keys, fluent, statement, why]; why "" when it parses
func FormsSplit(tName)
	aF = $aCourtFormset
	tRest = tName
	bStmt = false
	if FormsEndsWith(tRest, aF[4])
		tRest = Left(tRest, Len(tRest) - Len(aF[4]))
		bStmt = true
	ok
	bFluent = false
	if FormsEndsWith(tRest, aF[2])
		tRest = Left(tRest, Len(tRest) - Len(aF[2]))
		bFluent = true
	ok
	aKeys = []
	while true
		tBest = ""
		tBestKey = ""
		for nI = 1 to Len(aF[5])
			tSuf = aF[5][nI][2]
			if FormsEndsWith(tRest, tSuf) and Len(tSuf) > Len(tBest)
				tBest = tSuf
				tBestKey = aF[5][nI][1]
			ok
		next
		if tBest = "" exit ok
		if InStrListCs(tBestKey, aKeys)
			return [tRest, aKeys, bFluent, bStmt, "the suffix " + tBest + " appears twice"]
		ok
		tRest = Left(tRest, Len(tRest) - Len(tBest))
		Insert(aKeys, 0, tBestKey)
		if Len(tRest) = 0
			return [tRest, aKeys, bFluent, bStmt, "nothing is left of the name but suffixes"]
		ok
	end
	if FormsEndsWith(tRest, aF[2])
		return [tRest, aKeys, bFluent, bStmt, "the fluent form " + aF[2] + " is not last"]
	ok
	if FormsEndsWith(tRest, aF[4])
		return [tRest, aKeys, bFluent, bStmt, "the statement form " + aF[4] + " is not outermost"]
	ok
	nN = Len(tRest)
	nI = nN
	while nI >= 1
		if not FormsIsUpper(tRest[nI]) exit ok
		nI--
	end
	if nI < nN and nI >= 1
		tRun = SubStr(tRest, nI + 1)
		if Len(tRun) >= 2
			return [tRest, aKeys, bFluent, bStmt, "ends in '" + tRun + "', which no declared suffix spells"]
		ok
	ok
	return [tRest, aKeys, bFluent, bStmt, ""]

# the plain twin of a fluent name: the name with the fluent form removed
func FormsPlainTwin(aSplit)
	tOut = aSplit[1]
	for i = 1 to Len(aSplit[2])
		tOut += FormsSuffixOf(aSplit[2][i])
	next
	if aSplit[4] tOut += $aCourtFormset[4] ok
	return tOut

func FormsReadNames(tPath)
	if not FExists(tPath) CtFail(1, "no names file at '" + tPath + "'") ok
	tText = Read(tPath)
	aOut = []
	tL = ""
	for i = 1 to Len(tText)
		tC = tText[i]
		if tC = Char(10)
			FormsTakeName(aOut, tL)
			tL = ""
		else
			tL += tC
		ok
	next
	FormsTakeName(aOut, tL)
	return aOut

func FormsTakeName(aOut, tRaw)
	tL = FormsTrim(tRaw)
	if Len(tL) = 0 return ok
	if tL[1] = "#" return ok
	aOut + tL

func FormsTrim(tS)
	nI = 1
	nN = Len(tS)
	while nI <= nN
		tC = tS[nI]
		if tC != " " and tC != Char(9) and tC != Char(13) exit ok
		nI++
	end
	nJ = nN
	while nJ >= nI
		tC = tS[nJ]
		if tC != " " and tC != Char(9) and tC != Char(13) exit ok
		nJ--
	end
	if nJ < nI return "" ok
	return SubStr(tS, nI, nJ - nI + 1)

func FormsPrintSpellings(aDecls, aNames)
	aFam = FormsFamilies(aDecls)
	aMembers = []
	for i = 1 to Len(aFam)
		aMembers + FormsMembers(aFam[i][2], aFam[i][3])
	next
	nAgree = 0
	nDis = 0
	for i = 1 to Len(aNames)
		tName = aNames[i]
		aS = FormsSplit(tName)
		tWhy = aS[5]
		tOf = ""
		if tWhy = "" and aS[3]
			tTwin = FormsPlainTwin(aS)
			if not InStrListCs(tTwin, aNames)
				tWhy = tName + " requires " + tTwin + ": the fluent form stands beside its plain twin"
			ok
		ok
		if tWhy = ""
			for j = 1 to Len(aFam)
				tBase = aFam[j][2]
				bOfFamily = false
				if InStrListCs(tName, aMembers[j])
					bOfFamily = true
				but aS[1] = tBase
					bOfFamily = true
				but Len(aFam[j][3]) > 0
					if InStrListCs("passive", aFam[j][3]) and aS[1] = FormsPassive(tBase) bOfFamily = true ok
				ok
				if bOfFamily
					if InStrListCs(tName, aMembers[j])
						tOf = " member of " + aFam[j][1]
					else
						tWhy = "the family " + aFam[j][1] + " offers [" + CtJoin(aFam[j][3], ", ") + "] and not the forms of " + tName
					ok
					exit
				ok
			next
		ok
		if tWhy = ""
			nAgree++
			tLine = "agree " + tName + " base=" + aS[1] + " forms=[" + CtJoin(aS[2], ", ") + "]"
			if aS[3] tLine += " fluent" ok
			if aS[4] tLine += " statement" ok
			? tLine + tOf
		else
			nDis++
			? "disagree " + tName + ": " + tWhy
		ok
	next
	nMissing = 0
	for i = 1 to Len(aFam)
		for j = 1 to Len(aMembers[i])
			if not InStrListCs(aMembers[i][j], aNames)
				nMissing++
				? "missing " + aMembers[i][j] + " (family " + aFam[i][1] + ")"
			ok
		next
	next
	? "spellings: " + String(nAgree) + " agree, " + String(nDis) + " disagree of " + String(Len(aNames)) + "; " + String(nMissing) + " declared members missing"
