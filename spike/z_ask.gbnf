# z_ask.gbnf -- GENERATED by forge.ring from the z declaration (Haro v0.7).
# The Q letter: SELECT * FROM name, then the clauses the ASK admits, in this order.

root ::= ws "SELECT" sp "*" sp "FROM" sp ident (sp "WHERE" sp where_expr)? (sp "ORDER" sp "BY" sp reference (sp ("ASC" | "DESC"))?)? (sp "LIMIT" sp number)? ws
ident ::= [a-z_] [a-z0-9_]*
where_expr ::= or_expr
or_expr ::= and_expr (sp "or" sp and_expr)*
and_expr ::= not_expr (sp "and" sp not_expr)*
not_expr ::= ("not" sp)? comparison
comparison ::= additive (ws cmpop ws additive | sp "CONTAINS" sp additive)?
cmpop ::= ">=" | "<=" | "!=" | "<>" | "=" | ">" | "<"
additive ::= multiplicative (ws ("+" | "-") ws multiplicative)*
multiplicative ::= unary (ws ("*" | "/") ws unary)*
unary ::= ("-" ws)? primary
primary ::= number | string | flag | aggregate | reference | "ROUND" ws "(" ws or_expr ws ")" | "(" ws or_expr ws ")"
flag ::= "true" | "false"
aggregate ::= ("SUM" | "COUNT") ws "(" ws reference ws ")"
reference ::= [a-z_] [a-z0-9_]* ("." [a-z_] [a-z0-9_]*)*
number ::= [0-9]+ ("." [0-9]+)?
string ::= "'" [^']* "'" | "\"" [^"]* "\""
sp ::= [ \t]+
ws ::= [ \t]*
