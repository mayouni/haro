# door.gbnf -- GENERATED by forge.haro from the door declaration (stzu v0.1).
# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords,
# lower_snake identifiers, trailing commas. A clause given twice and a required seat
# absent are the court's to refuse; the decoder holds the shape.

root ::= ws decl (ws decl)* ws
decl ::= decl_LISTENER | decl_SERVICE | decl_NOTE
decl_LISTENER ::= "DEFINE" sp "LISTENER" sp ident sp "AS" ws "(" ws (clause_LISTENER (ws "," ws clause_LISTENER)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_LISTENER ::= "HOST" sp string
decl_SERVICE ::= "DEFINE" sp "SERVICE" sp ident sp "AS" ws "(" ws (clause_SERVICE (ws "," ws clause_SERVICE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_SERVICE ::= "HOST" sp string | "NEEDS" sp namelist
decl_NOTE ::= "DEFINE" sp "NOTE" sp ident sp "AS" ws "(" ws (clause_NOTE (ws "," ws clause_NOTE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_NOTE ::= "TEXT" sp string

ident ::= [a-z_] [a-z0-9_]*
string ::= "\"" [^"]* "\""
number ::= [0-9]+
namelist ::= "[" ws (ident (ws "," ws ident)* (ws ",")?)? ws "]"
stringlist ::= "[" ws (string (ws "," ws string)* (ws ",")?)? ws "]"
sp ::= [ \t]+
ws ::= ([ \t\r\n] | "--" [^\n]* "\n")*
