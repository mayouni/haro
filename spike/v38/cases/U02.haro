f()
func f
	using oA = new OnlyClose
		? "body a"
	end
	using oB = new DestroyAndClose
		? "body b"
	end
	using oC = new Child
		? "body c"
	end
	using oD = new All
		? "body d"
	end
end
class OnlyClose
	def close
		? "close"
	end
end
class DestroyAndClose
	def Close
		? "close (wrong)"
	end
	def DESTROY
		? "destroy"
	end
end
class Base
	def release
		? "release (inherited)"
	end
end
class Child from Base
	def close
		? "close (wrong)"
	end
end
class All
	def close
		? "close (wrong)"
	end
	def destroy
		? "destroy (wrong)"
	end
	def Release
		? "release"
	end
end
