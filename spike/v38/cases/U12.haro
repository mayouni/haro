f()
func f
	eval("using oRes = new Res(" + char(34) + "e" + char(34) + ")" + nl + "? " + char(34) + "in eval " + char(34) + " + oRes.tName" + nl + "done")
	$tG = "a"
	eval("within $tG = " + char(34) + "b" + char(34) + nl + "? $tG" + nl + "done")
	? $tG
class Res
	tName = ""
	func init tN
		tName = tN
	func release
		? "release " + tName
