$nG = 0
try
	within $nG = 1
		within $nG = 2
			? "inner " + String($nG)
		done
		? "outer " + String($nG)
	done
	Raise("go")
catch
	within $nG = 3
		try
			? "in catch " + String($nG)
			Raise("again")
		catch
			? "nested catch " + String($nG)
		done
	done
	? "after catch block " + String($nG)
done
? "end " + String($nG)
