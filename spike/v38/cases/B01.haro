$nG = 0
try
	within $nG = 1
		within $nG = 2
			? "inner " + String($nG)
		end
		? "outer " + String($nG)
	end
	Raise("go")
catch
	within $nG = 3
		try
			? "in catch " + String($nG)
			Raise("again")
		catch
			? "nested catch " + String($nG)
		end
	end
	? "after catch block " + String($nG)
end
? "end " + String($nG)
