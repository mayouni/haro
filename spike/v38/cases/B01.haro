$nG = 0
try
	within $nG = 1
		within $nG = 2
			? "inner " + string($nG)
		done
		? "outer " + string($nG)
	done
	raise("go")
catch
	within $nG = 3
		try
			? "in catch " + string($nG)
			raise("again")
		catch
			? "nested catch " + string($nG)
		done
	done
	? "after catch block " + string($nG)
done
? "end " + string($nG)
