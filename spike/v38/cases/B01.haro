$g = 0
try
	within $g = 1
		within $g = 2
			? "inner " + string($g)
		done
		? "outer " + string($g)
	done
	raise("go")
catch
	within $g = 3
		try
			? "in catch " + string($g)
			raise("again")
		catch
			? "nested catch " + string($g)
		done
	done
	? "after catch block " + string($g)
done
? "end " + string($g)
