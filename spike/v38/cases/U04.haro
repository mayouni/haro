? g()
h()
? "end"
func g
	using oO = new Res("g")
		return "returned " + oO.tName
	end
end
func h
	for i = 1 to 3
		using oO = new Res("i" + String(i))
			if i = 1 loop end
			if i = 3 exit end
			? "body " + String(i)
		end
	end
end
class Res
	tName = ""
	def init(tN)
		tName = tN
	end
	def release
		? "release " + tName
	end
end
