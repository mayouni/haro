? g()
h()
? "end"
func g
	using oO = new Res("g")
		return "returned " + oO.tName
	done
func h
	for i = 1 to 3
		using oO = new Res("i" + string(i))
			if i = 1 loop ok
			if i = 3 exit ok
			? "body " + string(i)
		done
	next
class Res
	tName = ""
	func init tN
		tName = tN
	func release
		? "release " + tName
