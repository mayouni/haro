# world_lib.haro -- the world a court reads and writes (Haro v0.10): a SYMBOL seat resolved
# against a C1 world.json, and the sentence's own C1 rows. MOVED OUT of court_lib.haro in v0.14,
# because court_lib.haro is compiled by every court on every run (HF-49): the forge loads this
# file only where the language declares a SYMBOL or a PUBLISH, and world_stub.haro -- what a
# language with no world has of one -- everywhere else. Functions only; the globals are the
# generated court's.

# ---- v0.10: the world ------------------------------------------------------------------
# A C1 world is JSON: {"world", "contract", "symbols": [{kind, name, span, rationale}],
# "refs": [{from, to, kind, span}]}; read with expr_lib's reader, matched case-blind
# (C1 3.1). $aCourtWorldFile is NULL (no world handed in) or the loaded world's
# symbols; a SYMBOL seat resolves against it in the court's last pass.

func CtSymbolByName(tName)
	for i = 1 to Len($aCourtSymbols)
		if $aCourtSymbols[i][1] = tName return $aCourtSymbols[i] end
	end
	return ""
end
func CtWorldLoad(tPath)
	if not FExists(tPath) CtFail(1, "no world artifact at '" + tPath + "'") end
	aW = ExJsonParse(Read(tPath))
	if not ExIsObj(aW) CtFail(1, "'" + tPath + "' is not a C1 world: not a JSON object") end
	aGot = ExObjGet(aW, "symbols")
	if not aGot[1] CtFail(1, "'" + tPath + "' has no symbols table; it is not a C1 world") end
	return aGot[2]
end
func CtWorldHas(aSymbols, tKind, tName)
	for i = 1 to Len(aSymbols)
		aK = ExObjGet(aSymbols[i], "kind")
		aN = ExObjGet(aSymbols[i], "name")
		if aK[1] and aN[1]
			if Lower(String(aK[2])) = Lower(tKind) and Lower(String(aN[2])) = Lower(tName) return true end
		end
	end
	return false
end
# every SYMBOL seat of the sentence, as [decl, seat, value, line]
func CtSymbolSites(aDecls)
	aOut = []
	for i = 1 to Len(aDecls)
		aD = aDecls[i]
		aKind = CtKindByVerb(aD[1])
		aC = aD[4]
		for j = 1 to Len(aC)
			aSeat = CtSeatByClause(aKind, aC[j][1])
			if IsEmpty(aSeat) loop end
			if CtTypeKind(aSeat) != "symbol" loop end
			if aC[j][3][1] != "word" loop end
			aOut + [aD, aSeat, aC[j][3][2], aC[j][2]]
		end
	end
	return aOut
end
# C3 3.2: every SYMBOL seat resolves to its KIND in the world; the first that
# does not is refused in the SYMBOL's own words
func CtResolveWorld(aDecls)
	aSites = CtSymbolSites(aDecls)
	for i = 1 to Len(aSites)
		aSy = CtSymbolByName(aSites[i][2][2])
		if IsEmpty(aSy) loop end
		if CtWorldHas($aCourtWorldFile, aSy[2], aSites[i][3]) loop end
		tMsg = aSy[4]
		if tMsg = "" tMsg = "{VERB} {name} names '{value}', and the world declares no " + aSy[2] + ":{value}" end
		aCC = CtSymbolCode(aSy)
		# v0.35: a SYMBOL seat held at warning is spoken after the verdict (severity_lib.haro)
		aKW = CtKindByVerb(aSites[i][1][1])
		if Len(aKW) >= 7
			if SevSeatIs(aKW, aSites[i][2][1]) = "warning"
				$aCourtWarnings + [aCC[1], aCC[2], aSites[i][4], CtFill(tMsg, aSites[i][1], aSites[i][3])]
				loop
			end
		end
		try
			CtFailC(aSites[i][4], aCC[1], aCC[2], CtFill(tMsg, aSites[i][1], aSites[i][3]))
		catch
			CtNote(cCatchError)
		end
	end
end
# a SYMBOL's code (its CODE, else UNRESOLVED) and cites (its CITES, else rule:<name>)
func CtSymbolCode(aSy)
	tCode = "UNRESOLVED"
	aCites = ["rule:" + aSy[1]]
	if Len(aSy) >= 6
		if aSy[5] != "" tCode = aSy[5] end
		# v0.28: CITES none -- the row's "none" -- cites nothing
		if IsString(aSy[6])
			aCites = []
		elseif Len(aSy[6]) > 0
			aCites = aSy[6]
		end
	end
	return [tCode, aCites]
end
func CtWorldStem(tPath)
	tName = tPath
	for i = Len(tPath) to 1 step -1
		if tPath[i] = "/" or tPath[i] = Char(92)
			tName = SubStr(tPath, i + 1)
			exit
		end
	end
	nN = 0
	for i = 1 to Len(tName)
		if tName[i] = "." nN = i end
	end
	if nN > 1 tName = Left(tName, nN - 1) end
	return tName
end
# the sentence's own C1 rows: a symbol per declaration of a PUBLISH kind, a ref
# per SYMBOL seat from the FIRST published declaration (the process) to the
# symbol it names -- and nothing else: a court emits only what it can prove
func CtWorldRows(aDecls, tFile)
	aPublish = []
	if Len($aCourtWorld) >= 4 aPublish = $aCourtWorld[4] end
	aSymbols = []
	tFrom = ""
	for i = 1 to Len(aDecls)
		aD = aDecls[i]
		for j = 1 to Len(aPublish)
			aK = CtKindByDeclName(aPublish[j][1])
			if IsEmpty(aK) or aK[1] != aD[1] loop end
			aRow = [ExObjMark(), ["kind", aPublish[j][2]], ["name", aD[2]], ["span", [ExObjMark(), ["file", tFile], ["line", aD[3]]]], ["rationale", aD[5]]]
			aSymbols + aRow
			if tFrom = "" tFrom = aPublish[j][2] + ":" + aD[2] end
		end
	end
	if tFrom = "" tFrom = $tCourtLang + ":" + CtWorldStem(tFile) end
	aRefs = []
	aSites = CtSymbolSites(aDecls)
	for i = 1 to Len(aSites)
		aSy = CtSymbolByName(aSites[i][2][2])
		if IsEmpty(aSy) loop end
		tRef = aSy[3]
		if tRef = "" tRef = "cites" end
		aRow = [ExObjMark(), ["from", tFrom], ["to", aSy[2] + ":" + aSites[i][3]], ["kind", tRef], ["span", [ExObjMark(), ["file", tFile], ["line", aSites[i][4]]]]]
		aRefs + aRow
	end
	return [ExObjMark(), ["world", CtWorldStem(tFile)], ["contract", "1.0"], ["symbols", aSymbols], ["refs", aRefs]]
end
