# world_lib.haro -- the world a court reads and writes (Haro v0.10): a SYMBOL seat resolved
# against a C1 world.json, and the sentence's own C1 rows. MOVED OUT of court_lib.haro in v0.14,
# because court_lib.haro is compiled by every court on every run (HF-49): the forge loads this
# file only where the language declares a SYMBOL or a PUBLISH, and world_stub.haro -- what a
# language with no world has of one -- everywhere else. Functions only; the globals are the
# generated court's.

# ---- v0.10: the world ------------------------------------------------------------------
# A C1 world is JSON: {"world", "contract", "symbols": [{kind, name, span, rationale}],
# "refs": [{from, to, kind, span}]}; read with expr_lib's reader, matched case-blind
# (C1 3.1). $aCourtWorldFile is NULL (no world handed in) or the loaded world's
# symbols; a SYMBOL seat resolves against it in the court's last pass.

func CtSymbolByName(tName)
	for i = 1 to Len($xCourtSymbols)
		if $xCourtSymbols[i][1] = tName return $xCourtSymbols[i] end
	end
	return ""
end
func CtWorldLoad(tPath)
	if not FExists(tPath) CtFail(1, "no world artifact at '" + tPath + "'") end
	xW = ExJsonParse(Read(tPath))
	if not ExIsObj(xW) CtFail(1, "'" + tPath + "' is not a C1 world: not a JSON object") end
	xGot = ExObjGet(xW, "symbols")
	if not xGot[1] CtFail(1, "'" + tPath + "' has no symbols table; it is not a C1 world") end
	return xGot[2]
end
func CtWorldHas(vSymbols, tKind, tName)
	for i = 1 to Len(vSymbols)
		xK = ExObjGet(vSymbols[i], "kind")
		xN = ExObjGet(vSymbols[i], "name")
		if xK[1] and xN[1]
			if Lower(String(xK[2])) = Lower(tKind) and Lower(String(xN[2])) = Lower(tName) return true end
		end
	end
	return false
end
# every SYMBOL seat of the sentence, as [decl, seat, value, line]
func CtSymbolSites(xDecls)
	xOut = []
	for i = 1 to Len(xDecls)
		xD = xDecls[i]
		xKind = CtKindByVerb(xD[1])
		xC = xD[4]
		for j = 1 to Len(xC)
			xSeat = CtSeatByClause(xKind, xC[j][1])
			if IsEmpty(xSeat) loop end
			if CtTypeKind(xSeat) != "symbol" loop end
			if xC[j][3][1] != "word" loop end
			xOut + [xD, xSeat, xC[j][3][2], xC[j][2]]
		end
	end
	return xOut
end
# C3 3.2: every SYMBOL seat resolves to its KIND in the world; the first that
# does not is refused in the SYMBOL's own words
func CtResolveWorld(xDecls)
	xSites = CtSymbolSites(xDecls)
	for i = 1 to Len(xSites)
		xSy = CtSymbolByName(xSites[i][2][2])
		if IsEmpty(xSy) loop end
		if CtWorldHas($xCourtWorldFile, xSy[2], xSites[i][3]) loop end
		tMsg = xSy[4]
		if tMsg = "" tMsg = "{VERB} {name} names '{value}', and the world declares no " + xSy[2] + ":{value}" end
		xCC = CtSymbolCode(xSy)
		# v0.35: a SYMBOL seat held at warning is spoken after the verdict (severity_lib.haro)
		xKW = CtKindByVerb(xSites[i][1][1])
		if Len(xKW) >= 7
			if SevSeatIs(xKW, xSites[i][2][1]) = "warning"
				$vCourtWarnings + [xCC[1], xCC[2], xSites[i][4], CtFill(tMsg, xSites[i][1], xSites[i][3])]
				loop
			end
		end
		try
			CtFailC(xSites[i][4], xCC[1], xCC[2], CtFill(tMsg, xSites[i][1], xSites[i][3]))
		catch
			CtNote(cCatchError)
		end
	end
end
# a SYMBOL's code (its CODE, else UNRESOLVED) and cites (its CITES, else rule:<name>)
func CtSymbolCode(xSy)
	tCode = "UNRESOLVED"
	xCites = ["rule:" + xSy[1]]
	if Len(xSy) >= 6
		if xSy[5] != "" tCode = xSy[5] end
		# v0.28: CITES none -- the row's "none" -- cites nothing
		if IsString(xSy[6])
			xCites = []
		elseif Len(xSy[6]) > 0
			xCites = xSy[6]
		end
	end
	return [tCode, xCites]
end
func CtWorldStem(tPath)
	tName = tPath
	for i = Len(tPath) to 1 step -1
		if tPath[i] = "/" or tPath[i] = Char(92)
			tName = SubStr(tPath, i + 1)
			exit
		end
	end
	nN = 0
	for i = 1 to Len(tName)
		if tName[i] = "." nN = i end
	end
	if nN > 1 tName = Left(tName, nN - 1) end
	return tName
end
# the sentence's own C1 rows: a symbol per declaration of a PUBLISH kind, a ref
# per SYMBOL seat from the FIRST published declaration (the process) to the
# symbol it names -- and nothing else: a court emits only what it can prove
func CtWorldRows(xDecls, tFile)
	xPublish = []
	if Len($xCourtWorld) >= 4 xPublish = $xCourtWorld[4] end
	vSymbols = []
	tFrom = ""
	for i = 1 to Len(xDecls)
		xD = xDecls[i]
		for j = 1 to Len(xPublish)
			xK = CtKindByDeclName(xPublish[j][1])
			if IsEmpty(xK) or xK[1] != xD[1] loop end
			vRow = [ExObjMark(), ["kind", xPublish[j][2]], ["name", xD[2]], ["span", [ExObjMark(), ["file", tFile], ["line", xD[3]]]], ["rationale", xD[5]]]
			vSymbols + vRow
			if tFrom = "" tFrom = xPublish[j][2] + ":" + xD[2] end
		end
	end
	if tFrom = "" tFrom = $tCourtLang + ":" + CtWorldStem(tFile) end
	xRefs = []
	xSites = CtSymbolSites(xDecls)
	for i = 1 to Len(xSites)
		xSy = CtSymbolByName(xSites[i][2][2])
		if IsEmpty(xSy) loop end
		tRef = xSy[3]
		if tRef = "" tRef = "cites" end
		vRow = [ExObjMark(), ["from", tFrom], ["to", xSy[2] + ":" + xSites[i][3]], ["kind", tRef], ["span", [ExObjMark(), ["file", tFile], ["line", xSites[i][4]]]]]
		xRefs + vRow
	end
	return [ExObjMark(), ["world", CtWorldStem(tFile)], ["contract", "1.0"], ["symbols", vSymbols], ["refs", xRefs]]
end
