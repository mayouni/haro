decl_USER ::= "DEFINE" sp "USER" sp ident sp "AS" ws "(" ws (clause_USER (ws "," ws clause_USER)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_USER ::= "UID" sp number | "GID" sp number
