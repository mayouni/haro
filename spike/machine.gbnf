clause_MOUNT ::= "AT" sp string | "FS" sp ident | "DEVICE" sp string | "OPTIONS" sp namelist
decl_SERVICE ::= "DEFINE" sp "SERVICE" sp ident sp "AS" ws "(" ws (clause_SERVICE (ws "," ws clause_SERVICE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_SERVICE ::= "RUN" sp stringlist | "RESTART" sp ident | "AFTER" sp namelist | "NEEDS" sp namelist | "READY" sp string | "HEALTH" sp number | "MEMORY" sp number | "CPU" sp number | "TASKS" sp number | "USER" sp ident | "SEES" sp namelist
decl_NETWORK ::= "DEFINE" sp "NETWORK" sp ident sp "AS" ws "(" ws (clause_NETWORK (ws "," ws clause_NETWORK)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
