clause_MACHINE ::= "PROFILE" sp ident | "ARCH" sp ident | "KERNEL" sp ident | "LIBC" sp ident | "BOARD" sp ident | "CONSOLE" sp string | "SLOTS" sp string | "IDENTITY" sp string | "JOURNAL" sp string
decl_CAPABILITY ::= "DEFINE" sp "CAPABILITY" sp ident sp "AS" ws "(" ws (clause_CAPABILITY (ws "," ws clause_CAPABILITY)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
