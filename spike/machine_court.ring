      ["sees_once", "service", "not sees distinct", "", "{other} is already named in {name}'s SEES: saying it twice says nothing the once did not", ""],
      ["mounts_are_not_touch", "mount", "box.profile = touch", "", "The touch profile owns no mounts: Android's init does ({name})", ""],
      ["edge_filesystems", "mount", "box.profile = edge and not (fs = littlefs or fs = vfat or fs = tmpfs)", "", "{fs} is not a filesystem of the edge profile (littlefs, vfat, tmpfs)", ""],
      ["block_filesystems_need_a_device", "mount", "(fs = ext4 or fs = vfat) and device absent", "", "MOUNT {name} on {fs} needs a DEVICE", ""],
      ["pins_need_gpio", "pin", "not some capability named gpio", "", "PIN {name} needs gpio, and no declaration grants gpio", ""],
      ["pins_need_gpio_granted", "pin", "some capability named gpio where grant = no", "", "PIN {name} needs gpio, which is declared and refused (GRANT no)", ""],
      ["network_is_granted", "network", "not some capability named network", "", "NETWORK {name} needs network, which no declaration grants", ""],
      ["network_is_granted_yes", "network", "some capability named network where grant = no", "", "NETWORK {name} needs network, which is declared and refused (GRANT no)", ""],
      ["dhcp_learns_its_gateway", "network", "address = dhcp and gateway present", "", "a dhcp network learns its gateway; GATEWAY is for a static ADDRESS", ""],
      ["egress_none_no_gateway", "network", "gateway present and egress = none", "", "a gateway is a way out, and EGRESS none says there is none: declare one or the other", ""],
      ["egress_names_a_perimeter", "network", "egress present and egress empty", "", "an empty EGRESS is not a declaration: a list names where the machine may go, and the word none says it goes nowhere", ""],
      ["egress_is_a_perimeter", "network", "egress covers '0.0.0.0/0'", "", "EGRESS names a perimeter, and these destinations together cover every address there is: a machine that may go anywhere says so by declaring no EGRESS at all, so that a list never reads as a perimeter it is not", ""],
      ["serving_link_is_static", "network", "address = dhcp and domain present", "", "{name} asks for its own address by dhcp, and a machine that asks for its own address is not the one that hands them out: a serving link declares a static ADDRESS", ""],
      ["one_network_per_interface", "network", "not interface unique", "", "{interface} already has a network ({other}); one network per interface", ""],
      ["peers_need_a_domain", "peer", "network.domain absent", "", "PEER {name} is on {network}, and {network} declares no DOMAIN: a machine that does not serve a link has no addresses to give out on it and no names to answer for", ""],
      ["a_wire_name", "peer", "not self matches wire_label", "", "'{name}' cannot be a name on {network.domain}: a name on the wire is lowercase letters, digits and the hyphen, not at either end", ""],
      ["peers_on_a_served_link", "peer", "network.address = dhcp", "", "PEER {name} is on {network}, which asks for its own address", ""],
      ["peer_on_the_link", "peer", "not address within network.address", "", "{address} is not on {network} ({network.address}): a machine hands out addresses on its own link and nowhere else", ""],
      ["not_the_boxs_address", "peer", "address host_of network.address", "", "{address} is the machine's own address on {network}: the one address on this link it cannot give away", ""],
      ["one_address_one_peer", "peer", "not address unique", "", "{address} is already {other}'s: one address, one peer, or the name does not mean anything", ""]
