      ["health_needs_ready", "service", "health present and ready absent", "", "HEALTH is measured on the READY path, and {name} declares none: a world with nothing to refresh cannot be found wedged", ""],
      ["health_window", "service", "health = 0", "", "HEALTH 0 is not a window: a world that never has to refresh is a world that can stop serving unnoticed", ""],
      ["health_under_an_hour", "service", "health > 3600", "", "HEALTH {health} is longer than an hour: a window nobody would wait out is a promise the watchdog cannot keep", ""],
      ["memory_ceiling", "service", "memory = 0", "", "MEMORY 0 is not a ceiling: a world that may hold nothing cannot run at all", ""],
      ["cpu_runs", "service", "cpu = 0", "", "CPU 0 is a service that cannot run: the number is a percentage of ONE core, and 100 is that core", ""],
      ["cpu_ceiling", "service", "cpu > 1600", "", "CPU {cpu} is more than sixteen cores' worth; 1600 is the ceiling this grammar admits", ""],
      ["tasks_run", "service", "tasks = 0", "", "TASKS 0 is a world that may hold no task at all, and a world with no task cannot run", ""],
      ["tasks_ceiling", "service", "tasks > 4096", "", "TASKS {tasks}: the number counts tasks -- processes and threads together -- and four thousand is more than this grammar admits for one world", ""],
      ["sees_needs_filesystem", "service", "sees present and not needs contains filesystem", "", "{name} SEES a mount and needs filesystem for it: a world cannot choose sight of storage it never asked to touch, and SEES narrows that grant rather than making one", ""],
      ["sees_needs_a_mount", "service", "sees present and not exists mount", "", "{name} SEES a mount and this machine declares no MOUNT: there is no sight to apportion", ""],
