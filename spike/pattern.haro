# pattern.haro -- the pattern engine at the command line (Haro v0.31, step 2 of COMPASS-REBOL-06/07):
#
#   haro pattern.haro cases <file>      judge every case of a case file, one process for the lot, one line a case
#
# A case file is lines; a case opens with `case <id>` and holds, in any order:
#   rule <name> <rule text>      a named rule, in declaration order, the text one line
#   set <name> <member> ...      a set MEMBER may draw from, its members words without spaces
#   start <name>                 the rule to match from (default main)
#   input <text>                 the text to match (the rest of the line, possibly empty)
#   file <path>                  the text to match, read from a file
# A case with neither input nor file only declares. One line comes back for each case:
#   <id> declared                          the rules are accepted
#   <id> refused <message>                 the rules or the text are refused, in the engine's words
#   <id> match 1|0 steps N bound B kept <the values kept, tab-separated, as C6 prints them>
# The same program runs on the Haro VM and on its checked build and must print the same bytes (D41). The Python reference
# (study/rebol/pattern.py) prints the same lines for the same cases: the court refuses a difference by name (D43).

load "pattern_lib.haro"

$aBlkToks = []
$nBlkPos = 1
$aPatNodes = []
$nPatNodes = 0
$aPatNames = []
$aPatRoots = []
$aPatNull = []
$aPatState = []
$aPatSetNames = []
$aPatSetMembers = []
$aPatSeqVals = []
$aPatSeqKinds = []
$aPatSeqLen = []
$aPatSeqBase = []
$aPatSeqKids = []
$aPatMemo = []
$nPatMemoTop = 0
$nPatSteps = 0

if len(sysargv) < 4
	? "usage: pattern.haro cases <file>"
else
	if sysargv[3] = "cases"
		PatCases(read(sysargv[4]))
	else
		? "usage: pattern.haro cases <file>"
	ok
ok

# the first word of a line and the rest after one space
func PatSplit1(tLine)
	nN = len(tLine)
	nI = 1
	while nI <= nN and tLine[nI] != " "
		nI++
	end
	if nI > nN return [tLine, ""] ok
	return [left(tLine, nI - 1), substr(tLine, nI + 1)]

func PatWords(tText)
	aOut = []
	tW = ""
	for i = 1 to len(tText)
		if tText[i] = " "
			if len(tW) > 0
				aOut + tW
				tW = ""
			ok
		else
			tW += tText[i]
		ok
	next
	if len(tW) > 0 aOut + tW ok
	return aOut

func PatCases(tBody)
	aLines = str2list(tBody)
	tId = ""
	aNames = []
	aTexts = []
	aSetN = []
	aSetM = []
	tStart = "main"
	nInput = 0
	tInput = ""
	tFile = ""
	bOpen = false
	for i = 1 to len(aLines)
		tLine = aLines[i]
		if len(tLine) > 0 and tLine[len(tLine)] = char(13)
			tLine = left(tLine, len(tLine) - 1)
		ok
		aP = PatSplit1(tLine)
		tCmd = aP[1]
		if tCmd = "case"
			if bOpen PatOneCase(tId, aNames, aTexts, aSetN, aSetM, tStart, nInput, tInput, tFile) ok
			bOpen = true
			tId = aP[2]
			aNames = []
			aTexts = []
			aSetN = []
			aSetM = []
			tStart = "main"
			nInput = 0
			tInput = ""
			tFile = ""
		but tCmd = "rule"
			aQ = PatSplit1(aP[2])
			aNames + aQ[1]
			aTexts + aQ[2]
		but tCmd = "set"
			aW = PatWords(aP[2])
			aSetN + aW[1]
			aMem = []
			for k = 2 to len(aW)
				aMem + aW[k]
			next
			aSetM + aMem
		but tCmd = "start"
			tStart = aP[2]
		but tCmd = "input"
			nInput = 1
			tInput = aP[2]
		but tCmd = "file"
			nInput = 2
			tFile = aP[2]
		ok
	next
	if bOpen PatOneCase(tId, aNames, aTexts, aSetN, aSetM, tStart, nInput, tInput, tFile) ok

func PatOneCase(tId, aNames, aTexts, aSetN, aSetM, tStart, nInput, tInput, tFile)
	try
		PatDeclare(aNames, aTexts, aSetN, aSetM)
		if nInput = 0
			? tId + " declared"
		else
			if nInput = 2 tInput = read(tFile) ok
			aR = PatRun(tStart, tInput)
			tWhole = "0"
			if aR[1] tWhole = "1" ok
			? tId + " match " + tWhole + " steps " + string(aR[3]) + " bound " + string(aR[4]) + " kept " + PatPrintKept(aR[2])
		ok
	catch
		? tId + " refused " + cCatchError
	done
