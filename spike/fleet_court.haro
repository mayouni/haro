      ["journal_is_kept", "box", "journal present and not some mount where (fs = ext4 or fs = vfat) and this.journal under at", "", "JOURNAL {journal} is where the record lives, and no declared MOUNT keeps it: a record that dies with the power is not a record", "", [], "error"],
      ["qemu_pc_consoles", "box", "console present and (board = qemu_pc or (board absent and arch = x86_64 and profile = hosted)) and not (console = '/dev/ttyS0' or console = '/dev/ttyS1' or console = '/dev/ttyS2' or console = '/dev/ttyS3')", "", "CONSOLE {console} is not a console of BOARD qemu_pc: its consoles are /dev/ttyS0, /dev/ttyS1, /dev/ttyS2, /dev/ttyS3", "", [], "error"],
