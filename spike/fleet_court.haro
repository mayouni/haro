      ["pins_need_gpio", "pin", "not some capability named gpio", "", "PIN {name} needs gpio, and no declaration grants gpio", "", [], "error"],
      ["pins_need_gpio_granted", "pin", "some capability named gpio where grant = no", "", "PIN {name} needs gpio, which is declared and refused (GRANT no)", "", [], "error"],
      ["network_is_granted", "network", "not some capability named network", "", "NETWORK {name} needs network, which no declaration grants", "", [], "error"],
