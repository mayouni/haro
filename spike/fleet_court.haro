      ["no_root", "user", "uid = 0", "", "uid 0 is the machine itself; a service that must be root declares no USER rather than a root one", "", [], "error"],
      ["one_uid_one_identity", "user", "not uid unique", "", "uid {uid} is already {other}'s; one number, one identity", "", [], "error"],
      ["users_are_hosted", "user", "box.profile != hosted", "", "USER is a hosted machine's declaration; a machine of PROFILE {box.profile} runs one program and has no one to be", "", [], "error"],
