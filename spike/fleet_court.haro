      ["health_needs_ready", "service", "health present and ready absent", "", "HEALTH is measured on the READY path, and {name} declares none: a world with nothing to refresh cannot be found wedged", "", [], "error"],
      ["health_window", "service", "health = 0", "", "HEALTH 0 is not a window: a world that never has to refresh is a world that can stop serving unnoticed", "", [], "error"],
      ["health_under_an_hour", "service", "health > 3600", "", "HEALTH {health} is longer than an hour: a window nobody would wait out is a promise the watchdog cannot keep", "", [], "error"],
      ["memory_ceiling", "service", "memory = 0", "", "MEMORY 0 is not a ceiling: a world that may hold nothing cannot run at all", "", [], "error"],
      ["cpu_runs", "service", "cpu = 0", "", "CPU 0 is a service that cannot run: the number is a percentage of ONE core, and 100 is that core", "", [], "error"],
