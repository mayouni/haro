      ["tasks_run", "service", "tasks = 0", "", "TASKS 0 is a world that may hold no task at all, and a world with no task cannot run", "", [], "error"],
      ["tasks_ceiling", "service", "tasks > 4096", "", "TASKS {tasks}: the number counts tasks -- processes and threads together -- and four thousand is more than this grammar admits for one world", "", [], "error"],
      ["sees_needs_filesystem", "service", "sees present and not needs contains filesystem", "", "{name} SEES a mount and needs filesystem for it: a world cannot choose sight of storage it never asked to touch, and SEES narrows that grant rather than making one", "", [], "error"],
      ["sees_needs_a_mount", "service", "sees present and not exists mount", "", "{name} SEES a mount and this machine declares no MOUNT: there is no sight to apportion", "", [], "error"],
      ["sees_something", "service", "sees present and sees empty", "", "an empty SEES is not a declaration: a world that wants no storage declares no filesystem, and a world that wants all of it says nothing", "", [], "error"],
