# run_lib.haro -- the A letter: a declared language's structured steps, run
# (Haro v0.9), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a RUN loads this file
# beside court_lib.haro and expr_lib.haro, and carries the RUN as $aCourtRun
# = [[role, [kind, seat, ...]], ...] -- OF [run kind, steps seat, result seat],
# COMPUTE [kind, into, value], COLLECT [kind, into, value], GROUP [kind, into,
# by, value], BRANCH [kind, when, then, else], ITERATE [kind, over, as, do].
# The five constructs are Zcd's names for what Zex runs and VizCode composes
# (SEQUENCE is the step list itself); the law is the alphabet's totality
# doctrine: iteration is over a collection the record holds, over a SNAPSHOT
# of it, so a COLLECT into the same list cannot lengthen the walk; a step
# list that re-enters a step on the way down is refused at `check`
# (RunCheckAcyclic) and again at `run`; there is no call and no recursion.
#
#   <court>.ring run <file> <algorithm> <record json>
#
# answers the algorithm's result as JSON: the value of its one result name,
# or the list of several. A name read before it is written is refused by
# name (the expression's ABSENT), never answered nil.
#
# Functions only; the globals are the generated court's.

func RunRole(tRole)
	for i = 1 to Len($xCourtRun)
		if $xCourtRun[i][1] = tRole return $xCourtRun[i][2] end
	end
	return ""
end
func RunFail(tMsg)
	CtFail(1, tMsg)
end
# the construct a declaration plays: COMPUTE COLLECT GROUP BRANCH ITERATE, or ""
func RunConstructOf(xDecl)
	xKind = CtKindByVerb(xDecl[1])
	if IsEmpty(xKind) return "" end
	xRoles = ["COMPUTE", "COLLECT", "GROUP", "BRANCH", "ITERATE"]
	for i = 1 to Len(xRoles)
		xR = RunRole(xRoles[i])
		if not IsEmpty(xR)
			if xR[1] = xKind[2] return xRoles[i] end
		end
	end
	return ""
end
# the names a step list seat of a declaration holds, as written
func RunStepsOf(xDecl, tSeat)
	xL = CondListOf(xDecl, tSeat)
	if IsEmpty(xL) return [] end
	return xL
end
# the step lists a declaration owns: its construct's list seats
func RunChildLists(xDecl)
	tC = RunConstructOf(xDecl)
	xOut = []
	if tC = "BRANCH"
		xR = RunRole("BRANCH")
		xOut + RunStepsOf(xDecl, xR[3])
		xOut + RunStepsOf(xDecl, xR[4])
	elseif tC = "ITERATE"
		xR = RunRole("ITERATE")
		xOut + RunStepsOf(xDecl, xR[4])
	end
	return xOut
end
# ---- the check: every algorithm's step tree is a tree ----------------------------------

func RunCheckAcyclic(xDecls)
	xOf = RunRole("OF")
	if IsEmpty(xOf) return end
	xK = CtKindByDeclName(xOf[1])
	if IsEmpty(xK) return end
	for i = 1 to Len(xDecls)
		if xDecls[i][1] != xK[1] loop end
		xSteps = RunStepsOf(xDecls[i], xOf[2])
		for j = 1 to Len(xSteps)
			RunWalkCheck(xDecls, xSteps[j], [xDecls[i][2]])
		end
	end
end
func RunWalkCheck(xDecls, tName, xPath)
	if CtInList(tName, xPath)
		CtSetCode("CYCLE", ["rule:run"])
		RunFail("step '" + tName + "' re-enters itself through " + CtJoin(xPath, " > ") + ": an algorithm's steps form a tree, and no step may lead back to one on the way down")
	end
	xD = CtDeclNamed(xDecls, tName)
	if IsEmpty(xD) return end
	xLists = RunChildLists(xD)
	xNext = []
	for i = 1 to Len(xPath) xNext + xPath[i] end
	xNext + tName
	for i = 1 to Len(xLists)
		for j = 1 to Len(xLists[i])
			RunWalkCheck(xDecls, xLists[i][j], xNext)
		end
	end
end
# ---- the run --------------------------------------------------------------------------------

func RunExprNode(xDecl, tSeat)
	return CtExprNode(xDecl, tSeat)
end
# the record is $aExprRecord; a name is set in place
func RunSet(tName, xV)
	for i = 2 to Len($xExprRecord)
		if $xExprRecord[i][1] = tName
			$xExprRecord[i][2] = xV
			return
		end
	end
	vPair = [tName, xV]
	$xExprRecord + vPair
end
func RunGet(tName)
	return ExRefGet(tName)
end
# v0.16: what a step did, recorded as it runs and only when a narration asked: [depth, name, value, key, taken, count]
func RunNote(tName, tValue, tKey, tTaken, tCount)
	$vRunTrace + [$nRunDepth, tName, tValue, tKey, tTaken, tCount]
end
func RunDepth(nN)
	$nRunDepth = $nRunDepth + nN
end
func RunSteps(xDecls, xSteps, xPath)
	for i = 1 to Len(xSteps)
		RunStep(xDecls, xSteps[i], xPath)
	end
end
func RunStep(xDecls, tName, xPath)
	if CtInList(tName, xPath) RunFail("step '" + tName + "' re-enters itself") end
	xD = CtDeclNamed(xDecls, tName)
	if IsEmpty(xD) RunFail("step '" + tName + "' is not declared") end
	tC = RunConstructOf(xD)
	if tC = "" RunFail(xD[1] + " " + tName + " is not a step: it plays no construct of this language") end
	xNext = []
	for i = 1 to Len(xPath) xNext + xPath[i] end
	xNext + tName
	if tC = "COMPUTE"
		xR = RunRole("COMPUTE")
		tInto = CondScalar(xD, xR[2])
		xNode = RunExprNode(xD, xR[3])
		xC = ExEval(xNode, [])
		RunSet(tInto, xC)
		if $bRunTrace RunNote(tName, ExJson(xC), "", "", "") end
	elseif tC = "COLLECT"
		xR = RunRole("COLLECT")
		tInto = CondScalar(xD, xR[2])
		xNode = RunExprNode(xD, xR[3])
		xV = ExEval(xNode, [])
		xGot = RunGet(tInto)
		xList = []
		if xGot[1]
			if not IsList(xGot[2]) or ExIsObj(xGot[2]) RunFail("COLLECT " + tName + " into '" + tInto + "', which is not a list") end
			xList = xGot[2]
		end
		xList + xV
		RunSet(tInto, xList)
		if $bRunTrace RunNote(tName, ExJson(xV), "", "", "") end
	elseif tC = "GROUP"
		xR = RunRole("GROUP")
		tInto = CondScalar(xD, xR[2])
		xK = ExEval(RunExprNode(xD, xR[3]), [])
		xV = ExEval(RunExprNode(xD, xR[4]), [])
		tKey = String(xK)
		if IsNumber(xK) tKey = ExNumText(xK) end
		xGot = RunGet(tInto)
		xGroups = []
		if xGot[1]
			if not IsList(xGot[2]) or ExIsObj(xGot[2]) RunFail("GROUP " + tName + " into '" + tInto + "', which is not a list of groups") end
			xGroups = xGot[2]
		end
		nAt = 0
		for j = 1 to Len(xGroups)
			if xGroups[j][1] = tKey nAt = j end
		end
		if nAt = 0
			xEntry = [tKey, [xV]]
			xGroups + xEntry
		else
			xGroups[nAt][2] + xV
		end
		RunSet(tInto, xGroups)
		if $bRunTrace RunNote(tName, ExJson(xV), tKey, "", "") end
	elseif tC = "BRANCH"
		xR = RunRole("BRANCH")
		xNode = RunExprNode(xD, xR[2])
		bThen = ExCondition(xNode, [])
		tTook = "else"
		if bThen tTook = "then" end
		if $bRunTrace RunNote(tName, "", "", tTook, "") end
		RunDepth(1)
		if bThen
			RunSteps(xDecls, RunStepsOf(xD, xR[3]), xNext)
		else
			RunSteps(xDecls, RunStepsOf(xD, xR[4]), xNext)
		end
		RunDepth(-1)
	elseif tC = "ITERATE"
		xR = RunRole("ITERATE")
		tOver = CondScalar(xD, xR[2])
		tAs = CondScalar(xD, xR[3])
		xGot = RunGet(tOver)
		if not xGot[1] RunFail("ITERATE " + tName + " over '" + tOver + "', which the record does not hold") end
		if not IsList(xGot[2]) or ExIsObj(xGot[2]) RunFail("ITERATE " + tName + " over '" + tOver + "', which is not a list") end
		# a snapshot: the walk is as long as the list was when it began
		xSnap = []
		for j = 1 to Len(xGot[2]) xSnap + xGot[2][j] end
		xBody = RunStepsOf(xD, xR[4])
		if $bRunTrace RunNote(tName, "", "", "", String(Len(xSnap))) end
		RunDepth(1)
		for j = 1 to Len(xSnap)
			RunSet(tAs, xSnap[j])
			RunSteps(xDecls, xBody, xNext)
		end
		RunDepth(-1)
	end
end
func RunAlgorithm(xDecls, tName, xRecord)
	xOf = RunRole("OF")
	if IsEmpty(xOf) RunFail("this language declares no RUN, so nothing in it runs") end
	xD = CtDeclNamed(xDecls, tName)
	if IsEmpty(xD) RunFail("no declaration named '" + tName + "' in this file") end
	xK = CtKindByDeclName(xOf[1])
	if IsEmpty(xK) or xD[1] != xK[1] RunFail(xD[1] + " " + tName + " is not an " + xK[1] + ", and only an " + xK[1] + " runs") end
	if not ExIsObj(xRecord) RunFail("the record is a JSON object") end
	ExSetRecord(xRecord)
	RunSteps(xDecls, RunStepsOf(xD, xOf[2]), [tName])
	xNames = RunStepsOf(xD, xOf[3])
	if Len(xNames) = 0 return $xExprRecord end
	vVals = []
	for i = 1 to Len(xNames)
		xGot = RunGet(xNames[i])
		if not xGot[1] RunFail("the result '" + xNames[i] + "' was never computed") end
		vVals + xGot[2]
	end
	if Len(vVals) = 1 return vVals[1] end
	return vVals
end
