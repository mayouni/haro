# run_lib.haro -- the A letter: a declared language's structured steps, run
# (Haro v0.9), in pure core Ring.
#
# A court FORGED from a .haro declaration that holds a RUN loads this file
# beside court_lib.haro and expr_lib.haro, and carries the RUN as $aCourtRun
# = [[role, [kind, seat, ...]], ...] -- OF [run kind, steps seat, result seat],
# COMPUTE [kind, into, value], COLLECT [kind, into, value], GROUP [kind, into,
# by, value], BRANCH [kind, when, then, else], ITERATE [kind, over, as, do].
# The five constructs are Zcd's names for what Zex runs and VizCode composes
# (SEQUENCE is the step list itself); the law is the alphabet's totality
# doctrine: iteration is over a collection the record holds, over a SNAPSHOT
# of it, so a COLLECT into the same list cannot lengthen the walk; a step
# list that re-enters a step on the way down is refused at `check`
# (RunCheckAcyclic) and again at `run`; there is no call and no recursion.
#
#   <court>.ring run <file> <algorithm> <record json>
#
# answers the algorithm's result as JSON: the value of its one result name,
# or the list of several. A name read before it is written is refused by
# name (the expression's ABSENT), never answered nil.
#
# Functions only; the globals are the generated court's.

func RunRole(tRole)
	for i = 1 to Len($aCourtRun)
		if $aCourtRun[i][1] = tRole return $aCourtRun[i][2] end
	end
	return null

func RunFail(tMsg)
	CtFail(1, tMsg)

# the construct a declaration plays: COMPUTE COLLECT GROUP BRANCH ITERATE, or ""
func RunConstructOf(aDecl)
	aKind = CtKindByVerb(aDecl[1])
	if IsNull(aKind) return "" end
	aRoles = ["COMPUTE", "COLLECT", "GROUP", "BRANCH", "ITERATE"]
	for i = 1 to Len(aRoles)
		aR = RunRole(aRoles[i])
		if not IsNull(aR)
			if aR[1] = aKind[2] return aRoles[i] end
		end
	end
	return ""

# the names a step list seat of a declaration holds, as written
func RunStepsOf(aDecl, tSeat)
	aL = CondListOf(aDecl, tSeat)
	if IsNull(aL) return [] end
	return aL

# the step lists a declaration owns: its construct's list seats
func RunChildLists(aDecl)
	tC = RunConstructOf(aDecl)
	aOut = []
	if tC = "BRANCH"
		aR = RunRole("BRANCH")
		aOut + RunStepsOf(aDecl, aR[3])
		aOut + RunStepsOf(aDecl, aR[4])
	elseif tC = "ITERATE"
		aR = RunRole("ITERATE")
		aOut + RunStepsOf(aDecl, aR[4])
	end
	return aOut

# ---- the check: every algorithm's step tree is a tree ----------------------------------

func RunCheckAcyclic(aDecls)
	aOf = RunRole("OF")
	if IsNull(aOf) return end
	aK = CtKindByDeclName(aOf[1])
	if IsNull(aK) return end
	for i = 1 to Len(aDecls)
		if aDecls[i][1] != aK[1] loop end
		aSteps = RunStepsOf(aDecls[i], aOf[2])
		for j = 1 to Len(aSteps)
			RunWalkCheck(aDecls, aSteps[j], [aDecls[i][2]])
		end
	end

func RunWalkCheck(aDecls, tName, aPath)
	if CtInList(tName, aPath)
		CtSetCode("CYCLE", ["rule:run"])
		RunFail("step '" + tName + "' re-enters itself through " + CtJoin(aPath, " > ") + ": an algorithm's steps form a tree, and no step may lead back to one on the way down")
	end
	aD = CtDeclNamed(aDecls, tName)
	if IsNull(aD) return end
	aLists = RunChildLists(aD)
	aNext = []
	for i = 1 to Len(aPath) aNext + aPath[i] end
	aNext + tName
	for i = 1 to Len(aLists)
		for j = 1 to Len(aLists[i])
			RunWalkCheck(aDecls, aLists[i][j], aNext)
		end
	end

# ---- the run --------------------------------------------------------------------------------

func RunExprNode(aDecl, tSeat)
	return CtExprNode(aDecl, tSeat)

# the record is $aExprRecord; a name is set in place
func RunSet(tName, xV)
	for i = 2 to Len($aExprRecord)
		if $aExprRecord[i][1] = tName
			$aExprRecord[i][2] = xV
			return
		end
	end
	aPair = [tName, xV]
	$aExprRecord + aPair

func RunGet(tName)
	return ExRefGet(tName)

# v0.16: what a step did, recorded as it runs and only when a narration asked: [depth, name, value, key, taken, count]
func RunNote(tName, tValue, tKey, tTaken, tCount)
	$aRunTrace + [$nRunDepth, tName, tValue, tKey, tTaken, tCount]

func RunDepth(nN)
	$nRunDepth = $nRunDepth + nN

func RunSteps(aDecls, aSteps, aPath)
	for i = 1 to Len(aSteps)
		RunStep(aDecls, aSteps[i], aPath)
	end

func RunStep(aDecls, tName, aPath)
	if CtInList(tName, aPath) RunFail("step '" + tName + "' re-enters itself") end
	aD = CtDeclNamed(aDecls, tName)
	if IsNull(aD) RunFail("step '" + tName + "' is not declared") end
	tC = RunConstructOf(aD)
	if tC = "" RunFail(aD[1] + " " + tName + " is not a step: it plays no construct of this language") end
	aNext = []
	for i = 1 to Len(aPath) aNext + aPath[i] end
	aNext + tName
	if tC = "COMPUTE"
		aR = RunRole("COMPUTE")
		tInto = CondScalar(aD, aR[2])
		aNode = RunExprNode(aD, aR[3])
		xC = ExEval(aNode, [])
		RunSet(tInto, xC)
		if $bRunTrace RunNote(tName, ExJson(xC), "", "", "") end
	elseif tC = "COLLECT"
		aR = RunRole("COLLECT")
		tInto = CondScalar(aD, aR[2])
		aNode = RunExprNode(aD, aR[3])
		xV = ExEval(aNode, [])
		aGot = RunGet(tInto)
		aList = []
		if aGot[1]
			if not IsList(aGot[2]) or ExIsObj(aGot[2]) RunFail("COLLECT " + tName + " into '" + tInto + "', which is not a list") end
			aList = aGot[2]
		end
		aList + xV
		RunSet(tInto, aList)
		if $bRunTrace RunNote(tName, ExJson(xV), "", "", "") end
	elseif tC = "GROUP"
		aR = RunRole("GROUP")
		tInto = CondScalar(aD, aR[2])
		xK = ExEval(RunExprNode(aD, aR[3]), [])
		xV = ExEval(RunExprNode(aD, aR[4]), [])
		tKey = String(xK)
		if IsNumber(xK) tKey = ExNumText(xK) end
		aGot = RunGet(tInto)
		aGroups = []
		if aGot[1]
			if not IsList(aGot[2]) or ExIsObj(aGot[2]) RunFail("GROUP " + tName + " into '" + tInto + "', which is not a list of groups") end
			aGroups = aGot[2]
		end
		nAt = 0
		for j = 1 to Len(aGroups)
			if aGroups[j][1] = tKey nAt = j end
		end
		if nAt = 0
			aEntry = [tKey, [xV]]
			aGroups + aEntry
		else
			aGroups[nAt][2] + xV
		end
		RunSet(tInto, aGroups)
		if $bRunTrace RunNote(tName, ExJson(xV), tKey, "", "") end
	elseif tC = "BRANCH"
		aR = RunRole("BRANCH")
		aNode = RunExprNode(aD, aR[2])
		bThen = ExCondition(aNode, [])
		tTook = "else"
		if bThen tTook = "then" end
		if $bRunTrace RunNote(tName, "", "", tTook, "") end
		RunDepth(1)
		if bThen
			RunSteps(aDecls, RunStepsOf(aD, aR[3]), aNext)
		else
			RunSteps(aDecls, RunStepsOf(aD, aR[4]), aNext)
		end
		RunDepth(-1)
	elseif tC = "ITERATE"
		aR = RunRole("ITERATE")
		tOver = CondScalar(aD, aR[2])
		tAs = CondScalar(aD, aR[3])
		aGot = RunGet(tOver)
		if not aGot[1] RunFail("ITERATE " + tName + " over '" + tOver + "', which the record does not hold") end
		if not IsList(aGot[2]) or ExIsObj(aGot[2]) RunFail("ITERATE " + tName + " over '" + tOver + "', which is not a list") end
		# a snapshot: the walk is as long as the list was when it began
		aSnap = []
		for j = 1 to Len(aGot[2]) aSnap + aGot[2][j] end
		aBody = RunStepsOf(aD, aR[4])
		if $bRunTrace RunNote(tName, "", "", "", String(Len(aSnap))) end
		RunDepth(1)
		for j = 1 to Len(aSnap)
			RunSet(tAs, aSnap[j])
			RunSteps(aDecls, aBody, aNext)
		end
		RunDepth(-1)
	end

func RunAlgorithm(aDecls, tName, aRecord)
	aOf = RunRole("OF")
	if IsNull(aOf) RunFail("this language declares no RUN, so nothing in it runs") end
	aD = CtDeclNamed(aDecls, tName)
	if IsNull(aD) RunFail("no declaration named '" + tName + "' in this file") end
	aK = CtKindByDeclName(aOf[1])
	if IsNull(aK) or aD[1] != aK[1] RunFail(aD[1] + " " + tName + " is not an " + aK[1] + ", and only an " + aK[1] + " runs") end
	if not ExIsObj(aRecord) RunFail("the record is a JSON object") end
	ExSetRecord(aRecord)
	RunSteps(aDecls, RunStepsOf(aD, aOf[2]), [tName])
	aNames = RunStepsOf(aD, aOf[3])
	if Len(aNames) = 0 return $aExprRecord end
	aVals = []
	for i = 1 to Len(aNames)
		aGot = RunGet(aNames[i])
		if not aGot[1] RunFail("the result '" + aNames[i] + "' was never computed") end
		aVals + aGot[2]
	end
	if Len(aVals) = 1 return aVals[1] end
	return aVals
