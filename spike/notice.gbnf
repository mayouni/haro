root ::= ws decl (ws decl)* ws
decl ::= decl_OFFICE | decl_DESK | decl_NOTICE
decl_OFFICE ::= "DEFINE" sp "OFFICE" sp ident sp "AS" ws "(" ws (clause_OFFICE (ws "," ws clause_OFFICE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
