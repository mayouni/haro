-- bank_no_rationale.ledger -- the limit says nothing about why: refused under Art. 1.

DEFINE ACCOUNT main AS (
  HOLDER "the treasury", CURRENCY xof, CEILING 5000000
) RATIONALE "The bank's own account, where the day's cash lands"

DEFINE LIMIT daily_cash AS (
  ON main, DAILY 1000000,
  RULE "amount <= daily",
  MESSAGE "A posting above the day's limit waits for the treasurer"
)
