-- message_llm.rfn -- a model proposes better words for the limit's refusal: the point is
-- floored llm, so the proposal is admitted. The floor is per point.
DEFINE REFINE kinder_words AS (
  TARGET "daily_cash.MESSAGE", KIND field,
  FROM "A posting above the day's limit waits for the treasurer", TO "This posting passes the day's limit; the treasurer will look at it",
  AUTHOR "aicha", POSTURE llm,
  REASON "the words should say what happens next, not only that the limit is passed"
) RATIONALE "The words of a refusal are a field a model may propose; the gate judges the proposal"
