# The Commons' lexical form (C6): -- comments, double-quoted strings, UPPER_SNAKE keywords,
# lower_snake identifiers, trailing commas. A clause given twice and a required seat
# absent are the court's to refuse; the decoder holds the shape.

root ::= ws decl (ws decl)* ws
decl ::= decl_SCREEN | decl_VIBE | decl_PANEL
decl_SCREEN ::= "DEFINE" sp "SCREEN" sp ident sp "AS" ws "(" ws (clause_SCREEN (ws "," ws clause_SCREEN)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
clause_SCREEN ::= "SATISFIES" sp namelist | "ALWAYS_REACHABLE" sp namelist | "ACTOR" sp ident
decl_VIBE ::= "DEFINE" sp "VIBE" sp ident sp "AS" ws "(" ws (clause_VIBE (ws "," ws clause_VIBE)* (ws ",")?)? ws ")" ws "RATIONALE" sp string
