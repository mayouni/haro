-- w_in_a.a -- stz's W cases and zing's indice flow re-expressed as algorithms of A
-- (a_v09.haro), plus three hand cases; GENERATED by the ninth rung's generator from
-- stz/declarative/w/fixtures.json and zing/conformance/fixtures.json -- the expected
-- values in v09/a_cases.json are copied from those files, never typed here.

DEFINE COMPUTE eval_precedence_value AS (INTO out, VALUE "3 + 4 * 2") RATIONALE "W eval-precedence: a constant evaluation"
DEFINE ALGORITHM eval_precedence AS (STEPS [eval_precedence_value], RESULT [out]) RATIONALE "stz W fixture eval-precedence"
DEFINE COMPUTE eval_parens_value AS (INTO out, VALUE "(3 + 4) * 2") RATIONALE "W eval-parens: a constant evaluation"
DEFINE ALGORITHM eval_parens AS (STEPS [eval_parens_value], RESULT [out]) RATIONALE "stz W fixture eval-parens"
DEFINE COMPUTE eval_unary_minus_value AS (INTO out, VALUE "-3 + 10") RATIONALE "W eval-unary-minus: a constant evaluation"
DEFINE ALGORITHM eval_unary_minus AS (STEPS [eval_unary_minus_value], RESULT [out]) RATIONALE "stz W fixture eval-unary-minus"
DEFINE COMPUTE eval_modulo_value AS (INTO out, VALUE "7 % 3") RATIONALE "W eval-modulo: a constant evaluation"
DEFINE ALGORITHM eval_modulo AS (STEPS [eval_modulo_value], RESULT [out]) RATIONALE "stz W fixture eval-modulo"
DEFINE COMPUTE eval_division_value AS (INTO out, VALUE "7 / 2") RATIONALE "W eval-division: a constant evaluation"
DEFINE ALGORITHM eval_division AS (STEPS [eval_division_value], RESULT [out]) RATIONALE "stz W fixture eval-division"
DEFINE COMPUTE eval_nested_parens_value AS (INTO out, VALUE "((2))*((3)+1)") RATIONALE "W eval-nested-parens: a constant evaluation"
DEFINE ALGORITHM eval_nested_parens AS (STEPS [eval_nested_parens_value], RESULT [out]) RATIONALE "stz W fixture eval-nested-parens"
DEFINE COLLECT map_scale_each AS (INTO out, VALUE "2*item") RATIONALE "W map: the expression on each item"
DEFINE ITERATE map_scale_over AS (OVER items, AS item, DO [map_scale_each]) RATIONALE "over the input"
DEFINE ALGORITHM map_scale AS (STEPS [map_scale_over], RESULT [out]) RATIONALE "stz W fixture map-scale"
DEFINE COLLECT map_affine_each AS (INTO out, VALUE "3*item - 1") RATIONALE "W map: the expression on each item"
DEFINE ITERATE map_affine_over AS (OVER items, AS item, DO [map_affine_each]) RATIONALE "over the input"
DEFINE ALGORITHM map_affine AS (STEPS [map_affine_over], RESULT [out]) RATIONALE "stz W fixture map-affine"
DEFINE COLLECT map_parity_each AS (INTO out, VALUE "item % 2") RATIONALE "W map: the expression on each item"
DEFINE ITERATE map_parity_over AS (OVER items, AS item, DO [map_parity_each]) RATIONALE "over the input"
DEFINE ALGORITHM map_parity AS (STEPS [map_parity_over], RESULT [out]) RATIONALE "stz W fixture map-parity"
DEFINE COLLECT map_constant_each AS (INTO out, VALUE "7") RATIONALE "W map: the expression on each item"
DEFINE ITERATE map_constant_over AS (OVER items, AS item, DO [map_constant_each]) RATIONALE "over the input"
DEFINE ALGORITHM map_constant AS (STEPS [map_constant_over], RESULT [out]) RATIONALE "stz W fixture map-constant"
DEFINE COLLECT filter_gt_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_gt_test AS (WHEN "item > 2", THEN [filter_gt_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_gt_over AS (OVER items, AS item, DO [filter_gt_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_gt AS (STEPS [filter_gt_over], RESULT [out]) RATIONALE "stz W fixture filter-gt"
DEFINE COLLECT filter_ge_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_ge_test AS (WHEN "item >= 2", THEN [filter_ge_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_ge_over AS (OVER items, AS item, DO [filter_ge_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_ge AS (STEPS [filter_ge_over], RESULT [out]) RATIONALE "stz W fixture filter-ge"
DEFINE COLLECT filter_eq_string_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_eq_string_test AS (WHEN "item = 'a'", THEN [filter_eq_string_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_eq_string_over AS (OVER items, AS item, DO [filter_eq_string_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_eq_string AS (STEPS [filter_eq_string_over], RESULT [out]) RATIONALE "stz W fixture filter-eq-string"
DEFINE COLLECT filter_ne_string_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_ne_string_test AS (WHEN "item != 'b'", THEN [filter_ne_string_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_ne_string_over AS (OVER items, AS item, DO [filter_ne_string_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_ne_string AS (STEPS [filter_ne_string_over], RESULT [out]) RATIONALE "stz W fixture filter-ne-string"
DEFINE COLLECT filter_and_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_and_test AS (WHEN "item > 1 and item < 4", THEN [filter_and_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_and_over AS (OVER items, AS item, DO [filter_and_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_and AS (STEPS [filter_and_over], RESULT [out]) RATIONALE "stz W fixture filter-and"
DEFINE COLLECT filter_or_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_or_test AS (WHEN "item = 1 or item = 4", THEN [filter_or_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_or_over AS (OVER items, AS item, DO [filter_or_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_or AS (STEPS [filter_or_over], RESULT [out]) RATIONALE "stz W fixture filter-or"
DEFINE COLLECT filter_not_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_not_test AS (WHEN "not (item > 2)", THEN [filter_not_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_not_over AS (OVER items, AS item, DO [filter_not_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_not AS (STEPS [filter_not_over], RESULT [out]) RATIONALE "stz W fixture filter-not"
DEFINE COLLECT filter_arith_in_comparison_keep AS (INTO out, VALUE "item") RATIONALE "W filter: the item kept"
DEFINE BRANCH filter_arith_in_comparison_test AS (WHEN "item % 2 = 0", THEN [filter_arith_in_comparison_keep]) RATIONALE "the predicate"
DEFINE ITERATE filter_arith_in_comparison_over AS (OVER items, AS item, DO [filter_arith_in_comparison_test]) RATIONALE "over the input"
DEFINE ALGORITHM filter_arith_in_comparison AS (STEPS [filter_arith_in_comparison_over], RESULT [out]) RATIONALE "stz W fixture filter-arith-in-comparison"
DEFINE COMPUTE count_gt_zero AS (INTO n, VALUE "0") RATIONALE "the count starts at 0"
DEFINE COMPUTE count_gt_bump AS (INTO n, VALUE "n + 1") RATIONALE "one more"
DEFINE BRANCH count_gt_test AS (WHEN "item > 2", THEN [count_gt_bump]) RATIONALE "the predicate"
DEFINE ITERATE count_gt_over AS (OVER items, AS item, DO [count_gt_test]) RATIONALE "over the input"
DEFINE ALGORITHM count_gt AS (STEPS [count_gt_zero, count_gt_over], RESULT [n]) RATIONALE "stz W fixture count-gt"
DEFINE COLLECT partition_gt_yes AS (INTO yes, VALUE "item") RATIONALE "those that pass"
DEFINE COLLECT partition_gt_no AS (INTO no, VALUE "item") RATIONALE "those that do not"
DEFINE BRANCH partition_gt_test AS (WHEN "item > 2", THEN [partition_gt_yes], ELSE [partition_gt_no]) RATIONALE "the predicate"
DEFINE ITERATE partition_gt_over AS (OVER items, AS item, DO [partition_gt_test]) RATIONALE "over the input"
DEFINE ALGORITHM partition_gt AS (STEPS [partition_gt_over], RESULT [yes, no]) RATIONALE "stz W fixture partition-gt: two lists"
DEFINE GROUP groupby_parity_file AS (INTO groups, BY "item % 2", VALUE "item") RATIONALE "W groupby: the key expression"
DEFINE ITERATE groupby_parity_over AS (OVER items, AS item, DO [groupby_parity_file]) RATIONALE "over the input"
DEFINE ALGORITHM groupby_parity AS (STEPS [groupby_parity_over], RESULT [groups]) RATIONALE "stz W fixture groupby-parity"
DEFINE COMPUTE reduce_sum_seed AS (INTO acc, VALUE "0") RATIONALE "the initial value"
DEFINE COMPUTE reduce_sum_fold AS (INTO acc, VALUE "acc + item") RATIONALE "W reduce: the accumulator and the item"
DEFINE ITERATE reduce_sum_over AS (OVER items, AS item, DO [reduce_sum_fold]) RATIONALE "over the input"
DEFINE ALGORITHM reduce_sum AS (STEPS [reduce_sum_seed, reduce_sum_over], RESULT [acc]) RATIONALE "stz W fixture reduce-sum"
DEFINE COMPUTE reduce_sum_seeded_seed AS (INTO acc, VALUE "100") RATIONALE "the initial value"
DEFINE COMPUTE reduce_sum_seeded_fold AS (INTO acc, VALUE "acc + item") RATIONALE "W reduce: the accumulator and the item"
DEFINE ITERATE reduce_sum_seeded_over AS (OVER items, AS item, DO [reduce_sum_seeded_fold]) RATIONALE "over the input"
DEFINE ALGORITHM reduce_sum_seeded AS (STEPS [reduce_sum_seeded_seed, reduce_sum_seeded_over], RESULT [acc]) RATIONALE "stz W fixture reduce-sum-seeded"
DEFINE COMPUTE reduce_noinit_product_first AS (INTO first, VALUE "1") RATIONALE "the first item seeds the accumulator"
DEFINE COMPUTE reduce_noinit_product_take AS (INTO acc, VALUE "item") RATIONALE "the seed"
DEFINE COMPUTE reduce_noinit_product_seeded AS (INTO first, VALUE "0") RATIONALE "seeded"
DEFINE COMPUTE reduce_noinit_product_fold AS (INTO acc, VALUE "acc * item") RATIONALE "W reduce: the accumulator and the item"
DEFINE BRANCH reduce_noinit_product_test AS (WHEN "first = 1", THEN [reduce_noinit_product_take, reduce_noinit_product_seeded], ELSE [reduce_noinit_product_fold]) RATIONALE "the first item, then the rest"
DEFINE ITERATE reduce_noinit_product_over AS (OVER items, AS item, DO [reduce_noinit_product_test]) RATIONALE "over the input"
DEFINE ALGORITHM reduce_noinit_product AS (STEPS [reduce_noinit_product_first, reduce_noinit_product_over], RESULT [acc]) RATIONALE "stz W fixture reduce-noinit-product"
DEFINE COLLECT refuse_unknown_variable_each AS (INTO out, VALUE "nosuch + 1") RATIONALE "W refuse: a name the record does not hold"
DEFINE ITERATE refuse_unknown_variable_over AS (OVER items, AS item, DO [refuse_unknown_variable_each]) RATIONALE "over the input"
DEFINE ALGORITHM refuse_unknown_variable AS (STEPS [refuse_unknown_variable_over], RESULT [out]) RATIONALE "stz W fixture refuse-unknown-variable"
DEFINE COMPUTE indice_score AS (INTO score, VALUE "ROUND((SUM(reponses) / (COUNT(reponses) * 5)) * 100)") RATIONALE "zing FLOW indice, STEP CALCUL: the survey index"
DEFINE COMPUTE indice_vide AS (INTO score, VALUE "'VIDE'") RATIONALE "zing FLOW indice, STEP SAISIE: ON_FAIL REJECT VIDE"
DEFINE BRANCH indice_saisie AS (WHEN "COUNT(reponses) >= 1", THEN [indice_score], ELSE [indice_vide]) RATIONALE "zing FLOW indice, STEP SAISIE: VALIDATE COUNT(reponses) >= 1"
DEFINE ALGORITHM indice AS (STEPS [indice_saisie], RESULT [score]) RATIONALE "zing conformance: the indice flow as an algorithm"
DEFINE COLLECT products_one AS (INTO out, VALUE "x * y") RATIONALE "one product"
DEFINE ITERATE products_inner AS (OVER ys, AS y, DO [products_one]) RATIONALE "the inner walk"
DEFINE ITERATE products_outer AS (OVER xs, AS x, DO [products_inner]) RATIONALE "the outer walk"
DEFINE ALGORITHM products AS (STEPS [products_outer], RESULT [out]) RATIONALE "hand: every product of two collections, outer then inner"
DEFINE COMPUTE maximum_seed AS (INTO best, VALUE "0") RATIONALE "nothing seen"
DEFINE COMPUTE maximum_take AS (INTO best, VALUE "item") RATIONALE "a new best"
DEFINE BRANCH maximum_test AS (WHEN "item > best", THEN [maximum_take]) RATIONALE "larger than the best so far"
DEFINE ITERATE maximum_over AS (OVER items, AS item, DO [maximum_test]) RATIONALE "over the input"
DEFINE ALGORITHM maximum AS (STEPS [maximum_seed, maximum_over], RESULT [best]) RATIONALE "hand: a running maximum"
DEFINE COMPUTE grade_a AS (INTO grade, VALUE "'A'") RATIONALE "90 and above"
DEFINE COMPUTE grade_b AS (INTO grade, VALUE "'B'") RATIONALE "80 to 89"
DEFINE COMPUTE grade_c AS (INTO grade, VALUE "'C'") RATIONALE "under 80"
DEFINE BRANCH grade_high AS (WHEN "score >= 90", THEN [grade_a], ELSE [grade_b]) RATIONALE "the upper split"
DEFINE BRANCH grade_pass AS (WHEN "score >= 80", THEN [grade_high], ELSE [grade_c]) RATIONALE "the lower split"
DEFINE ALGORITHM grade AS (STEPS [grade_pass], RESULT [grade]) RATIONALE "hand: a branch inside a branch"
