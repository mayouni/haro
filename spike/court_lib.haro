# court_lib.haro -- the generic court of a declared language, in pure core Ring.
#
# A court FORGED from a .haro declaration is a generated program that loads
# this file and fills five tables (see forge.haro): the language's name and
# extension, its declaration kinds with their typed seats, its forms, and
# its declared refusal phrasings. Everything the DECLARATION says is judged
# here: the Commons' lexical form (C6), the DEFINE shape, the closed verb
# set, the closed clause set per kind, each clause's value shape, a clause
# given twice, a missing RATIONALE, a required seat absent, one namespace.
# What the declaration does NOT say -- a menu of words, a default, an order,
# a rule between two declarations -- is not judged here, and the guard
# counts those apart. That count is the spike's measurement.
#
# Phrasings follow harb's court (harobanda/src/machine.zig) for the shapes
# the Grammar Commons gives every court, so the fixtures' fragments can be
# compared; where the declaration carries a REFUSAL message, it is spoken.
#
# v0.2 (haro/spike/v02/GRAMMAR.md): a seat's type may be a MENU (a word of
# its WORDS), a RANGE (a number within it), a FORMAT (a text of its shape)
# or a DECLARATION (a reference that must resolve); a declaration's NAMES
# are drawn from a MENU or a FORMAT; the WORLD's ONE and FIRST hold; every
# CONSTRAINT's condition is evaluated on every declaration of its ON kind,
# and its MESSAGE is spoken with {name}, {seat}, {other} and {decl.seat}
# filled in. The refinement gate reads the REFINE's POINTS and FLOOR.
#
# v0.3 (haro/spike/v03/GRAMMAR.md): a UNION seat takes a value of one of
# several shapes and is checked as the alternative the shape names; a
# declaration's MESSAGES speak for its reference seats; a condition reads
# through a reference, quantifies, and tests the closed relations; and the
# order of the court is: shapes, the WORLD, the local types, the
# CONSTRAINTs, then the references.
#
# v0.17 (haro/spike/v17/GRAMMAR.md): UNDERSTAND -- a language that declares how a human language reaches its
# closed questions gets `tokens`, `understand`, `ask`, `vocabulary` and `examples`, and the rules of its
# sentences (n_lib.haro, loaded only by a court forged from such a language): `check <file> surfaces` asks each
# surface's own court to judge its queries too.
#
# v0.14 (haro/spike/v14/GRAMMAR.md): a court that collects -- `diagnose` goes on
# past a refusal to the next element of every pass and answers every finding,
# in the order of the file; `check` still stops at the first, to the byte.
#
# v0.13 (haro/spike/v13/GRAMMAR.md): NARRATE -- `narrate <file>` answers the
# sentence back in the language's own voice (narrate_lib.haro, loaded only where
# a NARRATE is declared): a projection of the sentence on stdout, never stored,
# never read back.
#
# v0.12 (haro/spike/v12/GRAMMAR.md): FORMS -- `family <file>` generates every
# declared family from its base and the forms it offers; `spellings <file>
# <names>` judges a list of names against the FORMS and the families
# (forms_lib.haro, loaded only where a FORMS is declared).
#
# v0.11 (haro/spike/v11/GRAMMAR.md): the Diagnostic Contract -- `diagnose
# <file> [world]` answers the court's verdict as C2 v1.2.0's one object of
# six-field envelopes; a typed refusal carries the declaration's CODE / CODES
# and CITES (CtFailC), a parse-level one is PARSE with no cites.
#
# v0.10 (haro/spike/v10/GRAMMAR.md): the WORLD as versioned data -- a SYMBOL
# seat resolves against a C1 world.json handed to `check <file> [world]`
# (UNRESOLVED in the symbol's words; NO_WORLD a warning without one), and
# `world <file>` emits the sentence's own C1 rows.
#
# v0.9 (haro/spike/v09/GRAMMAR.md): the RUN -- the A letter -- and the `run`
# verb: `run <file> <algorithm> <record json>` walks an algorithm's step tree
# on a record and answers its result (run_lib.haro, loaded by the generated
# court when its language declares a RUN); a step tree with a cycle is
# refused at check.
#
# v0.8 (haro/spike/v08/GRAMMAR.md): a refusal by NAME for a known trespasser;
# pair lists keyed by a MENU (a sequence) or a DECLARATION (resolved) with
# reference values; a UNION of declarations resolved by name; the references
# pass judges every reference, scalar, listed, keyed or valued.
#
# v0.7 (haro/spike/v07/GRAMMAR.md): the ASK -- the Q letter -- and the `ask`
# verb: `ask <file> "<question>" <rows json>` answers a question of the
# declared world on the records handed in (ask_lib.haro, loaded by the
# generated court when its language declares an ASK).
#
# v0.6 (haro/spike/v06/GRAMMAR.md): a list of a FORM that is a name and a
# scalar is written as name: value pairs; a seat typed by an EXPRESSION holds
# an expression text the court parses with the expression's own menus
# (expr_lib.haro); and the sentence court RUNS what the declaration says a
# record does -- `eval <file> <decl> <seat> <json>` evaluates one expression
# seat on a record, `walk <file> <name> <json>` walks the record through the
# steps the WALK of that kind names, in ORDER, under its GUARDS, computing
# its COMPUTE seats by their FORMULAs, stopping at the first guard that fails.
#
# Functions only. Globals ($cCourtLang, $cCourtExt, $aCourtKinds,
# $aCourtForms, $aCourtRefusals, $aCourtMenus, $aCourtRanges,
# $aCourtFormats, $aCourtUnions, $aCourtConstraints, $aCourtWorld,
# $aCourtPoints, $aCourtFloors, $aCourtToks, $nCourtPos, and cond_lib's)
# are born in the generated court, at its top level, for both runtimes' sake.

load "cond_lib.haro"
load "block_lib.haro"
# expr_lib.haro is loaded by the GENERATED court, and only when its language
# declares an EXPRESSION (forge.haro): a court carries what its language says,
# and the machine court's edit-to-verdict stays under its 100 ms target

# ---- character classes by byte code (HF-30) ---------------------------------

func CtIsDigit(tC)
	nN = ascii(tC)
	return (nN >= 48 and nN <= 57)

func CtIsLowerish(tC)
	nN = ascii(tC)
	return (nN >= 97 and nN <= 122) or nN = 95 or (nN >= 48 and nN <= 57)

func CtIsUpperish(tC)
	nN = ascii(tC)
	return (nN >= 65 and nN <= 90) or nN = 95 or (nN >= 48 and nN <= 57)

func CtFail(nLine, tMsg)
	raise($tCourtLang + " (line " + string(nLine) + "): " + tMsg)

# v0.11: a refusal that enforces a provision of the declaration -- the pinned
# instrument -- carries its code and its cites out through two globals the
# `diagnose` verb reads; a parse-level refusal leaves them at PARSE and [],
# which C2 2.5 calls honest. A code of PARSE never cites.
func CtFailC(nLine, tCode, aCites, tMsg)
	CtSetCode(tCode, aCites)
	CtFail(nLine, tMsg)

# v0.14: a collecting court. In collect mode a refusal that a pass meets at one
# of its raising sites is NOTED and the pass goes on to its next element; out
# of collect mode it is raised again, same string, same globals, so `check` is
# unchanged to the byte. A declaration whose clause has the wrong SHAPE is
# broken: the passes that read its values say nothing more about it.
func CtNote(tErr)
	if not $bCourtCollect raise(tErr) ok
	$aCourtFound + [$tCourtCode, $aCourtCites, CtLineOf(tErr), CtStripPrefix(tErr)]
	CtSetCode("PARSE", [])

func CtIsBroken(nDecl)
	for i = 1 to len($aCourtBroken)
		if $aCourtBroken[i] = nDecl return true ok
	next
	return false

# the findings in the order of the file, ties in the order they were met
func CtSortFound(aF)
	aOut = []
	for i = 1 to len(aF)
		nAt = len(aOut) + 1
		for j = len(aOut) to 1 step -1
			if aOut[j][3] > aF[i][3]
				nAt = j
			else
				exit
			ok
		next
		insert(aOut, nAt - 1, aF[i])
	next
	return aOut

func CtSetCode(tCode, aCites)
	if tCode = "" tCode = "PARSE" ok
	$tCourtCode = tCode
	if tCode = "PARSE"
		$aCourtCites = []
	else
		$aCourtCites = aCites
	ok

# a declaration kind's CODES entry for a seat, or ""
func CtCodeFor(aKind, tSeat)
	if len(aKind) < 6 return "" ok
	for i = 1 to len(aKind[6])
		if aKind[6][i][1] = tSeat return aKind[6][i][2] ok
	next
	return ""

# the code and cites of a refusal that a declaration element owns: the
# element's CODE when it has one (cited as rule:<CODE>), else a default code
# cited as rule:<element name>
func CtElementCode(tOwn, tDefault, tName)
	if tOwn != "" return [tOwn, ["rule:" + tOwn]] ok
	return [tDefault, ["rule:" + tName]]

# v0.28 (HARO-MENU-CITES-01): an element's code and cites, its declared CITES over the default -- the row's
# nth element, present only when declared: the string "none" cites nothing, a list cites what it names
func CtElementCites(tOwn, tDefault, tName, aRow, nN)
	aCC = CtElementCode(tOwn, tDefault, tName)
	if len(aRow) < nN return aCC ok
	if isstring(aRow[nN])
		aCC[2] = []
	but len(aRow[nN]) > 0
		aCC[2] = aRow[nN]
	ok
	return aCC

# v0.23: whether the court's own language is under an article of its CONSTITUTION
# (charter 2): the forged court carries ARTICLES in $aCourtConstitution, empty without one.
# A refusal that enforces an article names it -- "[Art. N name]" -- and cites "article:N",
# the number-and-article shape of COMPASS-KERN-06; a language under no constitution prints
# what it printed before, to the byte.
func CtUnderArticle(tName)
	for i = 1 to len($aCourtConstitution)
		if $aCourtConstitution[i] = tName return true ok
	next
	return false

# v0.24: whether a seat is the zone's sovereign or movement seat (organizational_sovereignty, 5):
# the forged court carries [zone kind, sovereign seat, movement seat] in $aCourtZone, empty under none
func CtZoneSeat(tKindName, tSeat)
	if len($aCourtZone) < 3 return false ok
	if tKindName != $aCourtZone[1] return false ok
	return (tSeat = $aCourtZone[2] or tSeat = $aCourtZone[3])

# v0.25: whether a point (kind.seat) is one of the constitution's PERSONAL seats
func CtIsPersonal(tPoint)
	for i = 1 to len($aCourtPersonal)
		if $aCourtPersonal[i] = tPoint return true ok
	next
	return false

# v0.25: the warnings a court collected (a CONSTRAINT of SEVERITY warning), as C2 diagnostics
func CtAppendWarnings(aDiags, tFile)
	for i = 1 to len($aCourtWarnings)
		aW = $aCourtWarnings[i]
		aDiags + [aW[1], "warning", aW[4], tFile, aW[3], aW[2]]
	next

# v0.24: the audit chain of a sentence under visible_state (3): every refinement event, admitted
# or refused, is one JSON line appended beside the sentence (<file>.audit), numbered in order --
# no clock, so both runtimes write the same bytes; `audit <file>` answers the chain as a query.
# Nothing is written under no visible_state: the chain is the article's mechanism, not a side effect.
func CtAuditWrite(tVerdict, tStage, tCode)
	if $tCourtAuditFile = "" return ok
	tOld = ""
	if fexists($tCourtAuditFile) tOld = read($tCourtAuditFile) ok
	nEv = 0
	for i = 1 to len(tOld)
		if tOld[i] = char(10) nEv++ ok
	next
	aP = $aCourtAuditProposal
	# v0.25: a personal point's values enter the chain redacted (W4.4: a log carries no personal datum)
	tFromA = aP[3]
	tToA = aP[4]
	if len(aP) >= 7
		if CtIsPersonal(aP[7])
			tFromA = "[personal]"
			tToA = "[personal]"
		ok
	ok
	tLine = '{"event": ' + string(nEv + 1) + ', "proposal": ' + CtJson(aP[1]) + ', "target": ' + CtJson(aP[2]) +
	        ', "from": ' + CtJson(tFromA) + ', "to": ' + CtJson(tToA) + ', "author": ' + CtJson(aP[5]) +
	        ', "posture": ' + CtJson(aP[6]) + ', "verdict": ' + CtJson(tVerdict) + ', "stage": ' + CtJson(tStage) +
	        ', "code": ' + CtJson(tCode) + '}'
	write($tCourtAuditFile, tOld + tLine + char(10))

# a REFUSAL category's code, codes per NAMED word and cites
func CtRefusalRow(tCategory)
	for i = 1 to len($aCourtRefusals)
		if $aCourtRefusals[i][1] = tCategory return $aCourtRefusals[i] ok
	next
	return null

func CtRefusalCode(tCategory, tWord, tDefault)
	aR = CtRefusalRow(tCategory)
	if isnull(aR) return [tDefault, []] ok
	tCode = ""
	if tWord != "" and len(aR) >= 5
		for i = 1 to len(aR[5])
			if aR[5][i][1] = tWord tCode = aR[5][i][2] ok
		next
	ok
	if tCode = "" and len(aR) >= 4 tCode = aR[4] ok
	if tCode = "" tCode = tDefault ok
	aCites = []
	if len(aR) >= 6
		if islist(aR[6]) aCites = aR[6] ok
	ok
	return [tCode, aCites]

func CtInList(tS, aL)
	for i = 1 to len(aL)
		if aL[i] = tS return true ok
	next
	return false

func CtJoin(aL, tSep)
	tOut = ""
	for i = 1 to len(aL)
		if i > 1 tOut += tSep ok
		tOut += aL[i]
	next
	return tOut

# the declared refusal message of a category, or ""
# v0.8: a refusal's NAMED word -- its own message, or ""
func CtRefusalNamed(tCategory, tWord)
	for i = 1 to len($aCourtRefusals)
		if $aCourtRefusals[i][1] = tCategory and len($aCourtRefusals[i]) >= 3
			aN = $aCourtRefusals[i][3]
			for j = 1 to len(aN)
				if aN[j][1] = tWord return aN[j][2] ok
			next
		ok
	next
	return ""

func CtRefusalMessage(tCategory)
	for i = 1 to len($aCourtRefusals)
		if $aCourtRefusals[i][1] = tCategory return $aCourtRefusals[i][2] ok
	next
	return ""

# ---- v0.4: one court, several languages ------------------------------------------
# The generated court carries $aCourtLangs, one record per language -- its own
# first, then every language a SENTENCE names, recursively: [name, ext, kinds,
# forms, refusals, menus, ranges, formats, unions, constraints, world, points,
# floors, views, sentences]. CtUseLanguage loads one record into the tables
# the court reads; a SENTENCE seat is judged by switching to its language and
# back, the judged declarations kept in $aCourtSentences for the conditions
# that read through them.

func CtDirOf(tPath)
	nN = 0
	for i = 1 to len(tPath)
		if tPath[i] = "/" or tPath[i] = char(92) nN = i ok
	next
	if nN = 0 return "" ok
	return left(tPath, nN - 1)

func CtReplace(tS, tOld, tNew)
	tOut = ""
	nI = 1
	nN = len(tS)
	nM = len(tOld)
	while nI <= nN
		if nI + nM - 1 <= nN and substr(tS, nI, nM) = tOld
			tOut += tNew
			nI += nM
		else
			tOut += tS[nI]
			nI++
		ok
	end
	return tOut

func CtLangEntry(tName)
	for i = 1 to len($aCourtLangs)
		if $aCourtLangs[i][1] = tName return $aCourtLangs[i] ok
	next
	return null

func CtUseLanguage(tName)
	aE = CtLangEntry(tName)
	if isnull(aE) raise("the court carries no language called '" + tName + "'") ok
	$tCourtLang = aE[1]
	$tCourtExt = aE[2]
	$aCourtKinds = aE[3]
	$aCourtForms = aE[4]
	$aCourtRefusals = aE[5]
	$aCourtMenus = aE[6]
	$aCourtRanges = aE[7]
	$aCourtFormats = aE[8]
	$aCourtUnions = aE[9]
	$aCourtConstraints = aE[10]
	$aCourtWorld = aE[11]
	$aCourtPoints = aE[12]
	$aCourtFloors = aE[13]
	$aCourtViews = aE[14]
	$aCourtSentenceKinds = aE[15]
	# v0.6: the EXPRESSIONs [name, ops, opds, aggs, vars, contexts, absent,
	# division, equality] and the WALKs [name, of, steps, through, order,
	# guards, compute, formula, fail]
	$aCourtExprs = []
	$aCourtWalks = []
	if len(aE) >= 17
		$aCourtExprs = aE[16]
		$aCourtWalks = aE[17]
	ok
	# v0.7: the ASK [name, from kinds, where, clauses], or NULL
	$aCourtAsk = null
	if len(aE) >= 18 $aCourtAsk = aE[18] ok
	# v0.9: the RUN [[role, [kind, seat, ...]], ...], or NULL
	$aCourtRun = null
	if len(aE) >= 19 $aCourtRun = aE[19] ok
	# v0.10: the SYMBOLs [name, kind, ref, message]
	$aCourtSymbols = []
	if len(aE) >= 20 $aCourtSymbols = aE[20] ok
	# v0.12: the FORMS [name, fluent, passive, statement, params, family], or NULL
	$aCourtFormset = null
	if len(aE) >= 21 $aCourtFormset = aE[21] ok
	# v0.13: the NARRATE [name, opens, ends, refuses, says], or NULL
	$aCourtNarrate = null
	if len(aE) >= 22 $aCourtNarrate = aE[22] ok
	# v0.17: the UNDERSTAND [name, [[role, kind], ...]], or NULL -- a human language reaches closed questions (n_lib.haro)
	$aCourtUnderstand = null
	if len(aE) >= 23 $aCourtUnderstand = aE[23] ok

# the condition tables of every language the court carries, built once
func CtBuildCondLangs()
	$aCondLangs = []
	for i = 1 to len($aCourtLangs)
		aE = $aCourtLangs[i]
		aKinds = aE[3]
		aSents = aE[15]
		aDeclSeats = []
		aVerbOf = []
		for j = 1 to len(aKinds)
			aS = aKinds[j][3]
			aInfo = []
			for k = 1 to len(aS)
				tTK = "prim"
				if len(aS[k]) >= 5 tTK = aS[k][5] ok
				tTarget = ""
				if tTK = "decl" tTarget = aE[1] ok
				if tTK = "sentence"
					for m = 1 to len(aSents)
						if aSents[m][1] = aS[k][2] tTarget = aSents[m][2] ok
					next
				ok
				aInfo + [aS[k][1], aS[k][2], aS[k][3], tTK, tTarget]
			next
			aDeclSeats + [aKinds[j][2], aInfo]
			aVerbOf + [aKinds[j][2], aKinds[j][1]]
		next
		aViews = []
		for j = 1 to len(aE[14])
			aV = aE[14][j]
			aViews + [aV[1], aV[2], null, aV[3], aV[4], aV[5]]
		next
		# v0.8: the WORLD's ENTRY kinds and the forms' seat kinds
		aEntry = []
		if len(aE[11]) >= 3 aEntry = aE[11][3] ok
		aFormTable = []
		for j = 1 to len(aE[4])
			aFS = aE[4][j][2]
			aInfo = []
			for k = 1 to len(aFS)
				aInfo + [aFS[k][1], aFS[k][2], CtTypeKind(aFS[k])]
			next
			aFormTable + [aE[4][j][1], aInfo]
		next
		$aCondLangs + [aE[1], aDeclSeats, aE[11][1], aViews, aVerbOf, aEntry, aFormTable]
	next

# the court's state, so a SENTENCE can be judged in its own language and the
# judge returned to its own; $aCourtSentences and $aCondLangs are shared
func CtSnapshot()
	return [$tCourtLang, $tCourtExt, $tCourtDir, $aCourtKinds, $aCourtForms, $aCourtRefusals,
	        $aCourtMenus, $aCourtRanges, $aCourtFormats, $aCourtUnions, $aCourtConstraints,
	        $aCourtWorld, $aCourtPoints, $aCourtFloors, $aCourtViews, $aCourtSentenceKinds,
	        $aCourtToks, $nCourtPos, $aCondDecls, $tCondLang, $tCondOther, $bCondUnread,
	        $aCondFormats, $aCondToks, $nCondPos, $aCourtExprs, $aCourtWalks, $aCourtAsk, $aCourtRun,
	        $aCourtSymbols, $aCourtWorldFile, $aCourtFormset, $aCourtNarrate, $aCourtUnderstand]

func CtRestore(aS)
	$tCourtLang = aS[1]
	$tCourtExt = aS[2]
	$tCourtDir = aS[3]
	$aCourtKinds = aS[4]
	$aCourtForms = aS[5]
	$aCourtRefusals = aS[6]
	$aCourtMenus = aS[7]
	$aCourtRanges = aS[8]
	$aCourtFormats = aS[9]
	$aCourtUnions = aS[10]
	$aCourtConstraints = aS[11]
	$aCourtWorld = aS[12]
	$aCourtPoints = aS[13]
	$aCourtFloors = aS[14]
	$aCourtViews = aS[15]
	$aCourtSentenceKinds = aS[16]
	$aCourtToks = aS[17]
	$nCourtPos = aS[18]
	$aCondDecls = aS[19]
	$tCondLang = aS[20]
	$tCondOther = aS[21]
	$bCondUnread = aS[22]
	$aCondFormats = aS[23]
	$aCondToks = aS[24]
	$nCondPos = aS[25]
	$aCourtExprs = aS[26]
	$aCourtWalks = aS[27]
	$aCourtAsk = aS[28]
	$aCourtRun = aS[29]
	$aCourtSymbols = aS[30]
	$aCourtWorldFile = aS[31]
	$aCourtFormset = aS[32]
	$aCourtNarrate = aS[33]
	$aCourtUnderstand = aS[34]

# ---- v0.11: the Diagnostic Contract (C2 v1.2.0) -------------------------------------
# `diagnose <file> [world]` runs the same court and answers in the family's
# machine form: one object carrying `diagnostics`, each a six-field envelope --
# code, severity, message, span {file, line}, cites, language. A refusal is one
# error (the court stops at the first); a sentence with SYMBOL seats and no
# world adds one NO_WORLD warning at line 0; a clean run is `"diagnostics": []`.
# No value is ever a bare true, false or null (C2 2.8).

func CtStripPrefix(tMsg)
	nN = substr(tMsg, "): ")
	if nN > 0 return substr(tMsg, nN + 3) ok
	return tMsg

func CtLineOf(tMsg)
	nAt = substr(tMsg, "(line ")
	if nAt = 0 return 0 ok
	nEnd = substr(tMsg, "): ")
	if nEnd <= nAt return 0 ok
	return number(substr(tMsg, nAt + 6, nEnd - nAt - 6))

func CtDiagnosticJson(aD)
	tC = '{"code": ' + CtJson(aD[1]) + ', "severity": ' + CtJson(aD[2]) + ', "message": ' + CtJson(aD[3])
	tC += ', "span": {"file": ' + CtJson(aD[4]) + ', "line": ' + string(aD[5]) + '}, "cites": ['
	for i = 1 to len(aD[6])
		if i > 1 tC += ", " ok
		tC += CtJson(aD[6][i])
	next
	tC += '], "language": ' + CtJson($tCourtLang) + '}'
	return tC

func CtDiagnosticsJson(aDiags)
	tC = '{"diagnostics": ['
	for i = 1 to len(aDiags)
		if i > 1 tC += ", " ok
		tC += CtDiagnosticJson(aDiags[i])
	next
	return tC + ']}'

func CtDiagnose(tFile, tWorldPath)
	aDiags = []
	tSrc = read(tFile)
	CtSetCode("PARSE", [])
	$aCourtWarnings = []
	# v0.14: this verb collects -- every pass goes on past a refusal to its next element
	$bCourtCollect = true
	$aCourtFound = []
	$aCourtBroken = []
	tErr = ""
	aDecls = null
	try
		if tWorldPath != "" $aCourtWorldFile = CtWorldLoad(tWorldPath) ok
		aDecls = CtDeclare(tSrc)
	catch
		tErr = cCatchError
	done
	$bCourtCollect = false
	# a refusal nothing could resume from (the sentence did not parse, or a pass met
	# something it cannot judge past) ends the run and is the last finding
	if tErr != ""
		$aCourtFound + [$tCourtCode, $aCourtCites, CtLineOf(tErr), CtStripPrefix(tErr)]
	ok
	if len($aCourtFound) > 0
		aF = CtSortFound($aCourtFound)
		for i = 1 to len(aF)
			aDiags + [aF[i][1], "error", aF[i][4], tFile, aF[i][3], aF[i][2]]
		next
		CtAppendWarnings(aDiags, tFile)
		return aDiags
	ok
	CtAppendWarnings(aDiags, tFile)
	if isnull($aCourtWorldFile) and len($aCourtSymbols) > 0
		aSites = CtSymbolSites(aDecls)
		if len(aSites) > 0
			aSy = CtSymbolByName(aSites[1][2][2])
			aCites = []
			if not isnull(aSy) aCites = CtSymbolCode(aSy)[2] ok
			aDiags + ["NO_WORLD", "warning", "no world to resolve against; " + string(len(aSites)) + " symbol reference(s) unresolved, which is what C3 section 3.2 asks a project to close", tFile, 0, aCites]
		ok
	ok
	return aDiags

# ---- v0.6: the EXPRESSION tables, handed to expr_lib.haro ----------------------

func CtExprByName(tName)
	for i = 1 to len($aCourtExprs)
		if $aCourtExprs[i][1] = tName return $aCourtExprs[i] ok
	next
	return null

func CtExprUse(aE)
	$tExprLang = aE[1]
	$aExprOperators = aE[2]
	$aExprOperands = aE[3]
	$aExprAggregates = aE[4]
	$aExprVariables = aE[5]
	$aExprContexts = aE[6]
	$tExprAbsent = aE[7]
	$tExprDivision = aE[8]
	$tExprEquality = aE[9]

# a SENTENCE seat type's record: [name, lang, message, refused]
func CtSentenceKind(tName)
	for i = 1 to len($aCourtSentenceKinds)
		if $aCourtSentenceKinds[i][1] = tName return $aCourtSentenceKinds[i] ok
	next
	return null

# a kind's MESSAGES entry for a seat, or ""
func CtMessageFor(aKind, tSeat)
	if len(aKind) < 5 return "" ok
	for i = 1 to len(aKind[5])
		if aKind[5][i][1] = tSeat return aKind[5][i][2] ok
	next
	return ""

# judge the file a SENTENCE seat names, beside the file being judged, with
# the language's own tables; keep its declarations, or refuse in the
# sentence's own words
func CtJudgeSentence(aDecl, aSeat, aClause)
	tRel = aClause[3][2]
	aSK = CtSentenceKind(aSeat[2])
	if isnull(aSK) CtFail(aClause[2], "Clause " + aClause[1] + " names a SENTENCE the court does not carry") ok
	tPath = tRel
	if $tCourtDir != "" tPath = $tCourtDir + "/" + tRel ok
	if tRel = "" or not fexists(tPath)
		tMsg = aSK[3]
		if tMsg = "" tMsg = "{VERB} {name} names {value}, which cannot be read from beside this file" ok
		CtFail(aClause[2], CtFill(tMsg, aDecl, tRel))
	ok
	tText = read(tPath)
	aSnap = CtSnapshot()
	CtUseLanguage(aSK[2])
	$tCourtDir = CtDirOf(tPath)
	tErr = ""
	aInner = null
	bWas = $bCourtCollect
	$bCourtCollect = false
	try
		aInner = CtDeclare(tText)
	catch
		tErr = cCatchError
	done
	$bCourtCollect = bWas
	CtRestore(aSnap)
	if tErr != ""
		# "<lang> (line N): why" -> why and N
		tWhy = tErr
		tLine = "?"
		nAt = substr(tErr, "(line ")
		if nAt > 0
			nEnd = substr(tErr, "): ")
			if nEnd > nAt
				tLine = substr(tErr, nAt + 6, nEnd - nAt - 6)
				tWhy = substr(tErr, nEnd + 3)
			ok
		ok
		tMsg = aSK[4]
		if tMsg = "" tMsg = "{VERB} {name} is refused: {why} (line {line} of {value})" ok
		tMsg = CtReplace(CtReplace(tMsg, "{why}", tWhy), "{line}", tLine)
		CtFailC(aDecl[3], "SENTENCE", [], CtFill(tMsg, aDecl, tRel))
	ok
	$aCourtSentences + [$tCourtLang, aDecl[1], aDecl[2], aSeat[1], tRel, aInner, aSK[2]]

# ---- tokenizer: the Commons' lexical form, as harb's court reads it ---------
# a token is [type, text, line]; types: string number ident keyword
# lparen rparen lbracket rbracket comma eof

func CtTokenize(tSrc)
	# v0.30: the one lexer (block_lib.haro) reads the sentence; the court keeps its own words for what it refuses,
	# in the language's voice (unexpected_character). A `?` and a `.` are C6 (Q-B1, paths) and read by the lexer;
	# a sentence has no use for either, so the court refuses them as it always did. A comment is layout to a court
	aToks = BlkTokenize(tSrc)
	aOut = []
	for i = 1 to len(aToks)
		aT = aToks[i]
		if aT[1] = "comment" loop ok
		if aT[1] = "question" or aT[1] = "dot"
			CtFailChar(aT[3], aT[2])
		ok
		if aT[1] = "error"
			if aT[2] = "unterminated_string"
				CtFail(aT[3], "Unterminated string")
			but aT[2] = "mixed_case"
				CtFail(aT[3], "'" + aT[4] + "' is neither a lower_snake identifier nor an UPPER_SNAKE keyword")
			but aT[2] = "number_glued"
				CtFail(aT[3], "'" + aT[4] + "' is neither a number nor a word")
			but aT[2] = "doubled_quote"
				CtFail(aT[3], "a doubled quote inside a string waits for C6's amendment (Q-B2): Ringua writes it; today a C6 string has no escape")
			else
				CtFailChar(aT[3], aT[4])
			ok
		ok
		aOut + aT
	next
	return aOut

func CtFailChar(nLine, tC)
	tMsgC = CtRefusalMessage("unexpected_character")
	if tMsgC != "" tMsgC = " -- " + tMsgC ok
	CtFail(nLine, "The character '" + tC + "' is not part of the " + $tCourtLang + " grammar" + tMsgC)

# ---- the tables, read ---------------------------------------------------------

func CtKindByVerb(tVerb)
	for i = 1 to len($aCourtKinds)
		if $aCourtKinds[i][1] = tVerb return $aCourtKinds[i] ok
	next
	return null

func CtVerbs()
	aV = []
	for i = 1 to len($aCourtKinds)
		aV + $aCourtKinds[i][1]
	next
	return aV

func CtFormByName(tName)
	for i = 1 to len($aCourtForms)
		if $aCourtForms[i][1] = tName return $aCourtForms[i] ok
	next
	return null

# a seat is [name, of, isList, optional, typeKind]; its clause name is the
# seat's name in UPPER_SNAKE, and its value shape follows its type:
#   text / a FORMAT -> string, name/flag/ref / a MENU / a DECLARATION -> word,
#   number / a RANGE -> number, [form] -> a list whose items follow the form's
#   first seat (text or a FORMAT -> stringlist, else namelist), [decl] and
#   [menu] -> namelist
func CtTypeKind(aSeat)
	if len(aSeat) >= 5 return aSeat[5] ok
	return "prim"

func CtIsPairForm(aFS)
	# v0.27: a third, optional MENU seat is the mark, written after the value
	if len(aFS) != 2 and not CtHasMarkSeat(aFS) return false ok
	if aFS[1][3] or aFS[2][3] return false ok
	tK1 = CtTypeKind(aFS[1])
	if aFS[1][2] != "name" and tK1 != "menu" and tK1 != "decl" return false ok
	return true

# v0.27: the mark seat of a pair form -- third, optional, a MENU
func CtHasMarkSeat(aFS)
	if len(aFS) != 3 return false ok
	if aFS[3][3] or not aFS[3][4] return false ok
	return CtTypeKind(aFS[3]) = "menu"

# v0.8: does a seat take part in the references pass -- a reference, a UNION
# of declarations, or a pair list whose keys or values are references -- and
# in the local pass -- everything else, and a pair list's menu keys and
# scalar values
func CtUnionHasDecls(tName)
	aU = CtUnionByName(tName)
	if isnull(aU) return false ok
	for i = 1 to len(aU[2])
		if aU[2][i][3] = "decl" return true ok
	next
	return false

func CtSeatPasses(aSeat)
	tK = CtTypeKind(aSeat)
	if tK = "decl" return [false, true] ok
	if aSeat[3] and tK = "union" return [false, true] ok
	if tK = "union"
		if CtUnionHasDecls(aSeat[2]) return [true, true] ok
		return [true, false]
	ok
	if aSeat[3] and tK = "form"
		aF = CtFormByName(aSeat[2])
		if not isnull(aF) and CtIsPairForm(aF[2])
			bRef = false
			if CtTypeKind(aF[2][1]) = "decl" bRef = true ok
			if CtTypeKind(aF[2][2]) = "decl" bRef = true ok
			if CtTypeKind(aF[2][2]) = "union" and CtUnionHasDecls(aF[2][2][2]) bRef = true ok
			return [true, bRef]
		ok
	ok
	return [true, false]

func CtClauseShape(aSeat)
	tOf = aSeat[2]
	tK = CtTypeKind(aSeat)
	if aSeat[3]
		if tK = "union" return "namelist" ok
		if tK = "form"
			aF = CtFormByName(tOf)
			if isnull(aF) return "namelist" ok
			aFS = aF[2]
			# v0.6: a FORM that is a name and a scalar is written as pairs
			if CtIsPairForm(aFS) return "pairlist" ok
			if len(aFS) > 0 and (aFS[1][2] = "text" or CtTypeKind(aFS[1]) = "format") return "stringlist" ok
		ok
		return "namelist"
	ok
	if tK = "union" return "union" ok
	if tK = "sentence" return "string" ok
	if tK = "expr" return "string" ok
	if tK = "symbol" return "word" ok
	if tOf = "text" or tK = "format" return "string" ok
	if tOf = "number" or tK = "range" return "number" ok
	return "word"

func CtMenuByName(tName)
	for i = 1 to len($aCourtMenus)
		if $aCourtMenus[i][1] = tName return $aCourtMenus[i] ok
	next
	return null

func CtRangeByName(tName)
	for i = 1 to len($aCourtRanges)
		if $aCourtRanges[i][1] = tName return $aCourtRanges[i] ok
	next
	return null

func CtFormatByName(tName)
	for i = 1 to len($aCourtFormats)
		if $aCourtFormats[i][1] = tName return $aCourtFormats[i] ok
	next
	return null

func CtKindByDeclName(tName)
	for i = 1 to len($aCourtKinds)
		if $aCourtKinds[i][2] = tName return $aCourtKinds[i] ok
	next
	return null

# ---- v0.3: a UNION seat takes a value of one of several shapes -------------------
# a union is [name, [[of, isList, typeKind], ...], message]

func CtUnionByName(tName)
	for i = 1 to len($aCourtUnions)
		if $aCourtUnions[i][1] = tName return $aCourtUnions[i] ok
	next
	return null

# an alternative's value shape, as CtClauseShape gives a seat's
func CtAltShape(aAlt)
	return CtClauseShape([aAlt[1], aAlt[1], aAlt[2], 0, aAlt[3]])

# the alternative whose shape the written value has, or NULL; an empty list
# fits either list shape
func CtUnionAlt(aSeat, aClause)
	aU = CtUnionByName(aSeat[2])
	if isnull(aU) return null ok
	tGot = aClause[3][1]
	bEmpty = false
	if tGot = "namelist" or tGot = "stringlist"
		if len(aClause[3][2]) = 0 bEmpty = true ok
	ok
	aAlts = aU[2]
	for i = 1 to len(aAlts)
		tShape = CtAltShape(aAlts[i])
		if tShape = tGot return aAlts[i] ok
		if bEmpty and (tShape = "namelist" or tShape = "stringlist") return aAlts[i] ok
	next
	return null

# the union's own MESSAGE speaks when the value fits no alternative
func CtWantUnion(aDecl, aClause, aSeat)
	if not isnull(CtUnionAlt(aSeat, aClause)) return ok
	aU = CtUnionByName(aSeat[2])
	if isnull(aU) CtFail(aClause[2], "Clause " + aClause[1] + " names a UNION the court does not carry") ok
	tMsg = aU[3]
	if tMsg = ""
		aNames = []
		for i = 1 to len(aU[2])
			aNames + aU[2][i][1]
		next
		tMsg = "Clause " + aClause[1] + " takes one of " + CtJoin(aNames, ", ")
	ok
	tV = ""
	if aClause[3][1] = "word" or aClause[3][1] = "string" or aClause[3][1] = "number" tV = aClause[3][2] ok
	tOwn = ""
	if len(aU) >= 4 tOwn = aU[4] ok
	aCC = CtElementCites(tOwn, "UNION", aU[1], aU, 5)
	CtFailC(aClause[2], aCC[1], aCC[2], CtFill(tMsg, aDecl, tV))

# {name}, {VERB}, {value}, {other}, {seat} and {decl.seat} in a declared message
func CtFill(tMsg, aDecl, tValue)
	tOut = ""
	nN = len(tMsg)
	nI = 1
	while nI <= nN
		tC = tMsg[nI]
		if tC = "{"
			nJ = nI + 1
			while nJ <= nN and tMsg[nJ] != "}"
				nJ++
			end
			if nJ > nN
				tOut += tC
				nI++
				loop
			ok
			tKey = substr(tMsg, nI + 1, nJ - nI - 1)
			tRep = ""
			if tKey = "name"
				if not isnull(aDecl) tRep = aDecl[2] ok
			but tKey = "VERB"
				if not isnull(aDecl) tRep = aDecl[1] ok
			but tKey = "value"
				tRep = tValue
			but tKey = "other"
				tRep = $tCondOther
			else
				if not isnull(aDecl)
					xV = CondScalar(aDecl, tKey)
					if not isnull(xV)
						tRep = xV
					else
						aL = CondListOf(aDecl, tKey)
						if not isnull(aL)
							tRep = CtJoin(aL, ", ")
						else
							# a path: {x.seat} through a reference seat, a ONE kind or a
							# VIEW, {view} a VIEW's declaration (v0.3, v0.4)
							bSave = $bCondUnread
							xV = CondPathScalar(["path", CondSplit(tKey, ".")], ["decl", $tCondLang, aDecl, $aCondDecls], null)
							$bCondUnread = bSave
							if not isnull(xV) tRep = xV ok
						ok
					ok
				ok
			ok
			tOut += tRep
			nI = nJ + 1
		else
			tOut += tC
			nI++
		ok
	end
	return tOut

# ---- the shapes of a FORMAT -----------------------------------------------------

func CtIsHexChar(tC)
	nN = ascii(tC)
	return (nN >= 48 and nN <= 57) or (nN >= 97 and nN <= 102) or (nN >= 65 and nN <= 70)

func CtIsLabelChar(tC)
	nN = ascii(tC)
	return (nN >= 97 and nN <= 122) or (nN >= 48 and nN <= 57) or nN = 45

func CtIsIpv4(tS)
	aParts = CtSplit(tS, ".")
	if len(aParts) != 4 return false ok
	for i = 1 to 4
		xP = aParts[i]
		if len(xP) = 0 or len(xP) > 3 return false ok
		for j = 1 to len(xP)
			if not CtIsDigit(xP[j]) return false ok
		next
		if number(xP) > 255 return false ok
	next
	return true

func CtSplit(tS, tSep)
	aOut = []
	tCur = ""
	for i = 1 to len(tS)
		if tS[i] = tSep
			aOut + tCur
			tCur = ""
		else
			tCur += tS[i]
		ok
	next
	aOut + tCur
	return aOut

func CtIsLabel(tS)
	if len(tS) = 0 return false ok
	for i = 1 to len(tS)
		if not CtIsLabelChar(tS[i]) return false ok
	next
	if tS[1] = "-" or tS[len(tS)] = "-" return false ok
	return true

# one definition of the shapes, in cond_lib.haro, since v0.3's `matches`
# tests them inside a condition too
func CtHasShape(tS, tShape)
	return CondHasShape(tS, tShape)

func CtAllowedClauses(aKind)
	aS = aKind[3]
	aOut = []
	for i = 1 to len(aS)
		aOut + upper(aS[i][1])
	next
	return aOut

func CtSeatByClause(aKind, tClause)
	aS = aKind[3]
	for i = 1 to len(aS)
		if upper(aS[i][1]) = tClause return aS[i] ok
	next
	return null

# ---- parser ----------------------------------------------------------------

func CtPeek()
	return $aCourtToks[$nCourtPos]

func CtNext()
	aT = $aCourtToks[$nCourtPos]
	if aT[1] != "eof" $nCourtPos++ ok
	return aT

func CtShown(xT)
	if xT[1] = "eof" return "end of file" ok
	return xT[2]

func CtExpect(tType, tWhat)
	aT = CtNext()
	if aT[1] != tType
		CtFail(aT[3], "Expected " + tWhat + ", found '" + CtShown(aT) + "'")
	ok
	return aT

# a value is [shape, payload, start, end]: word/string/number carry text;
# namelist and stringlist carry a list; an empty list is [namelist, []];
# start and end are the value's byte span in the source
func CtParseValue()
	aT = CtNext()
	if aT[1] = "ident" return ["word", aT[2], aT[4], aT[5]] ok
	if aT[1] = "string" return ["string", aT[2], aT[4], aT[5]] ok
	if aT[1] = "number" return ["number", aT[2], aT[4], aT[5]] ok
	if aT[1] = "lbracket"
		aNames = []
		aStrings = []
		aPairs = []
		while true
			aE = CtPeek()
			if aE[1] = "rbracket"
				CtNext()
				exit
			ok
			aItem = CtNext()
			if aItem[1] = "ident" and CtPeek()[1] = "colon"
				# v0.6: a name: value pair; the value a word, a string or a number
				CtNext()
				aTv = CtNext()
				if aTv[1] != "ident" and aTv[1] != "string" and aTv[1] != "number"
					CtFail(aTv[3], "A pair's value is a word, a string or a number, found '" + CtShown(aTv) + "'")
				ok
				aPair = [aItem[2], aTv[2], aTv[1], ""]
				# v0.27: a mark after the value -- `member: text personal`
				if CtPeek()[1] = "ident"
					aTm = CtNext()
					aPair[4] = aTm[2]
				ok
				aPairs + aPair
			but aItem[1] = "ident"
				aNames + aItem[2]
			but aItem[1] = "string"
				aStrings + aItem[2]
			else
				CtFail(aItem[3], "A list holds words or strings, found '" + CtShown(aItem) + "'")
			ok
			aSep = CtPeek()
			if aSep[1] = "comma"
				CtNext()
			but aSep[1] != "rbracket"
				CtFail(aSep[3], "Expected ',' or ']' in a list, found '" + CtShown(aSep) + "'")
			ok
		end
		if len(aNames) > 0 and len(aStrings) > 0
			CtFail(aT[3], "A list is all words or all strings, never mixed")
		ok
		if len(aPairs) > 0 and (len(aNames) > 0 or len(aStrings) > 0)
			CtFail(aT[3], "A list is all name: value pairs or none")
		ok
		nListEnd = $aCourtToks[$nCourtPos - 1][5]
		if len(aPairs) > 0 return ["pairlist", aPairs, aT[4], nListEnd] ok
		if len(aStrings) > 0 return ["stringlist", aStrings, aT[4], nListEnd] ok
		return ["namelist", aNames, aT[4], nListEnd]
	ok
	CtFail(aT[3], "Expected a clause value, found '" + CtShown(aT) + "'")

# one DEFINE <VERB> <name> AS ( clauses ) RATIONALE "..."
# returns [verb, name, line, clauses, rationale]; a clause is [NAME, line, value]
func CtParseDecl()
	aV = CtNext()
	if not (aV[1] = "keyword" and aV[2] = "DEFINE")
		tMsg = CtRefusalMessage("unknown_verb")
		if tMsg = "" tMsg = "the " + $tCourtLang + " verb set is closed (DEFINE)" ok
		aCC = CtRefusalCode("unknown_verb", "", "UNKNOWN_VERB")
		CtFailC(aV[3], aCC[1], aCC[2], "Unknown verb '" + CtShown(aV) + "': " + tMsg)
	ok
	aK = CtNext()
	aKind = null
	if aK[1] = "keyword" aKind = CtKindByVerb(aK[2]) ok
	if isnull(aKind)
		# v0.35: a NAMED kind held at warning is read past and said (severity_lib.haro, loaded only where one is held)
		aSevR = CtRefusalRow("unknown_declaration")
		if not isnull(aSevR)
			if len(aSevR) >= 7
				if SevSkipNamed(aSevR, aK) return null ok
			ok
		ok
		tNamed = CtRefusalNamed("unknown_declaration", lower(CtShown(aK)))
		if tNamed != ""
			aCC = CtRefusalCode("unknown_declaration", lower(CtShown(aK)), "UNKNOWN_KIND")
			CtFailC(aK[3], aCC[1], aCC[2], tNamed)
		ok
		tMsg = CtRefusalMessage("unknown_declaration")
		if tMsg = "" tMsg = "the kinds are closed (" + CtJoin(CtVerbs(), ", ") + ")" ok
		aCC = CtRefusalCode("unknown_declaration", "", "UNKNOWN_KIND")
		CtFailC(aK[3], aCC[1], [], "Unknown kind '" + CtShown(aK) + "': " + tMsg)
	ok
	aName = CtExpect("ident", "a lower_snake name")
	aAs = CtNext()
	if not (aAs[1] = "keyword" and aAs[2] = "AS")
		CtFail(aAs[3], "Expected AS after the name, found '" + CtShown(aAs) + "'")
	ok
	CtExpect("lparen", "'('")
	aClauses = []
	aAllowed = CtAllowedClauses(aKind)
	while true
		aT = CtPeek()
		if aT[1] = "rparen"
			CtNext()
			exit
		ok
		aC = CtNext()
		if aC[1] != "keyword"
			CtFail(aC[3], "Expected a clause name, found '" + CtShown(aC) + "'")
		ok
		if not CtInList(aC[2], aAllowed)
			tNamed = CtRefusalNamed("unknown_seat", lower(aC[2]))
			if tNamed != ""
				aCC = CtRefusalCode("unknown_seat", lower(aC[2]), "UNKNOWN_CLAUSE")
				CtFailC(aC[3], aCC[1], aCC[2], tNamed)
			ok
			tMsg = CtRefusalMessage("unknown_seat")
			if tMsg = "" tMsg = "allowed are " + CtJoin(aAllowed, ", ") ok
			aCC = CtRefusalCode("unknown_seat", "", "UNKNOWN_CLAUSE")
			CtFailC(aC[3], aCC[1], [], "Unknown clause '" + aC[2] + "' for " + aKind[1] + ": " + tMsg)
		ok
		for i = 1 to len(aClauses)
			if aClauses[i][1] = aC[2]
				CtFail(aC[3], "Clause " + aC[2] + " given twice")
			ok
		next
		aVal = CtParseValue()
		# a FORMAT that FOLDs case reads its value folded (v0.4): hex is case-blind
		aSeatF = CtSeatByClause(aKind, aC[2])
		if not isnull(aSeatF)
			if CtTypeKind(aSeatF) = "format" and aVal[1] = "string"
				aF = CtFormatByName(aSeatF[2])
				if not isnull(aF)
					if len(aF) >= 4
						if aF[4] = "case" aVal[2] = lower(aVal[2]) ok
					ok
				ok
			ok
		ok
		# a clause is [NAME, line, value, start, end] -- the value's span
		aClauses + [aC[2], aC[3], aVal, aVal[3], aVal[4]]
		aSep = CtPeek()
		if aSep[1] = "comma"
			CtNext()
		but aSep[1] != "rparen"
			CtFail(aSep[3], "Expected ',' or ')' after a clause, found '" + CtShown(aSep) + "'")
		ok
	end
	aR = CtNext()
	if not (aR[1] = "keyword" and aR[2] = "RATIONALE")
		tMsgR = "RATIONALE is mandatory on every declaration (" + aKind[1] + " " + aName[2] + " has none)"
		# v0.23: under explainability the refusal is traceable (code RATIONALE) and names its article
		if CtUnderArticle("explainability")
			CtFailC(aR[3], "RATIONALE", ["article:1"], tMsgR + " [Art. 1 explainability]")
		ok
		CtFail(aR[3], tMsgR)
	ok
	aRS = CtExpect("string", "the RATIONALE string")
	return [aKind[1], aName[2], aName[3], aClauses, aRS[2]]

# ---- the structural court ---------------------------------------------------

func CtWantShape(aDecl, aClause, tShape)
	tGot = aClause[3][1]
	tName = aClause[1]
	if tShape = "word"
		if tGot != "word" CtFail(aClause[2], "Clause " + tName + " takes a word") ok
	but tShape = "string"
		if tGot != "string" CtFail(aClause[2], "Clause " + tName + " takes a string") ok
	but tShape = "number"
		if tGot != "number" CtFail(aClause[2], "Clause " + tName + " takes a number") ok
	but tShape = "namelist"
		if tGot = "stringlist" and len(aClause[3][2]) = 0 return ok
		if tGot != "namelist" CtFail(aClause[2], "Clause " + tName + " takes a list of words") ok
	but tShape = "stringlist"
		if tGot = "namelist" and len(aClause[3][2]) = 0 return ok
		if tGot != "stringlist" CtFail(aClause[2], "Clause " + tName + " takes a string list, one word per string") ok
	but tShape = "pairlist"
		if tGot = "namelist" and len(aClause[3][2]) = 0 return ok
		if tGot != "pairlist" CtFail(aClause[2], "Clause " + tName + " takes name: value pairs") ok
	ok

# parse a whole source and judge what the declaration can judge; returns the
# list of declarations
func CtDeclare(tSrc)
	CtSetCode("PARSE", [])
	$aCourtToks = CtTokenize(tSrc)
	$nCourtPos = 1
	aDecls = []
	while CtPeek()[1] != "eof"
		# v0.35: a NAMED kind held at warning is read past, and declares nothing
		aPD = CtParseDecl()
		if not isnull(aPD) aDecls + aPD ok
	end
	if len(aDecls) = 0
		CtFail(1, "A " + $tCourtLang + " file declares nothing")
	ok
	# one namespace
	for i = 1 to len(aDecls)
		for j = 1 to i - 1
			if aDecls[i][2] = aDecls[j][2]
				tMsg = CtRefusalMessage("duplicate_name")
				if tMsg = "" tMsg = "one namespace, no duplicates" ok
				aCC = CtRefusalCode("duplicate_name", "", "DUPLICATE_NAME")
				try
					CtFailC(aDecls[i][3], aCC[1], aCC[2], "'" + string(aDecls[i][2]) + "' is already declared (line " + string(aDecls[j][3]) + "); " + tMsg)
				catch
					CtNote(cCatchError)
				done
				exit
			ok
		next
	next
	# every clause's value has the seat's shape; every required seat is present
	for i = 1 to len(aDecls)
		aD = aDecls[i]
		aKind = CtKindByVerb(aD[1])
		aC = aD[4]
		for j = 1 to len(aC)
			aSeat = CtSeatByClause(aKind, aC[j][1])
			try
				if CtTypeKind(aSeat) = "union" and not aSeat[3]
					CtWantUnion(aD, aC[j], aSeat)
				else
					# a LIST of a union of declarations is a name list (v0.9)
					CtWantShape(aD, aC[j], CtClauseShape(aSeat))
				ok
			catch
				CtNote(cCatchError)
				$aCourtBroken + i
			done
		next
		aSeats = aKind[3]
		for j = 1 to len(aSeats)
			aSeat = aSeats[j]
			if aSeat[3] or aSeat[4] loop ok
			bFound = false
			for k = 1 to len(aC)
				if aC[k][1] = upper(aSeat[1]) bFound = true ok
			next
			if not bFound
				# the declaration's own MESSAGES for a required seat speaks first (v0.4);
				# its CODES give the envelope's code (v0.11)
				tMsgR = CtMessageFor(aKind, aSeat[1])
				tCodeR = CtCodeFor(aKind, aSeat[1])
				aCC = CtElementCode(tCodeR, "REQUIRED", aKind[2] + "." + aSeat[1])
				# v0.24: a zone without its holder or its entry is sovereignty's refusal (Art. 5)
				tArt5 = ""
				if CtUnderArticle("organizational_sovereignty")
					if CtZoneSeat(aKind[2], aSeat[1])
						aCites5 = aCC[2]
						aCites5 + "article:5"
						aCC[2] = aCites5
						tArt5 = " [Art. 5 organizational_sovereignty]"
					ok
				ok
				try
					if tMsgR != "" CtFailC(aD[3], aCC[1], aCC[2], CtFill(tMsgR, aD, "") + tArt5) ok
					CtFailC(aD[3], aCC[1], aCC[2], upper(aSeat[1]) + " is required on " + aD[1] + " " + aD[2] + tArt5)
				catch
					CtNote(cCatchError)
				done
			ok
		next
	next

	# ---- v0.2: what the WORLD, the types, the names and the constraints say ----
	$aCondDecls = aDecls
	$tCondLang = $tCourtLang
	$aCondFormats = []
	for i = 1 to len($aCourtFormats)
		$aCondFormats + [$aCourtFormats[i][1], $aCourtFormats[i][2]]
	next

	# the WORLD: exactly one of each ONE kind, and the FIRST kind first
	aOne = $aCourtWorld[1]
	for i = 1 to len(aOne)
		aK = CtKindByDeclName(aOne[i])
		if isnull(aK) loop ok
		nN = 0
		for j = 1 to len(aDecls)
			if aDecls[j][1] = aK[1] nN++ ok
		next
		if nN != 1
			try
				CtFailC(aDecls[1][3], "WORLD_ONE", ["rule:world"], "A " + $tCourtLang + " file declares exactly one " + string(aK[1]) + " (found " + string(nN) + ")")
			catch
				CtNote(cCatchError)
			done
		ok
	next
	if $aCourtWorld[2] != ""
		aK = CtKindByDeclName($aCourtWorld[2])
		if not isnull(aK) and aDecls[1][1] != aK[1]
			try
				CtFailC(aDecls[1][3], "WORLD_FIRST", ["rule:world"], "The " + aK[1] + " declaration comes first")
			catch
				CtNote(cCatchError)
			done
		ok
	ok

	# the NAMES of a declaration kind, and every seat's typed value -- the
	# local facts first (a menu, a range, a format, a union); a reference is a
	# fact about the whole sentence and is checked after the constraints, which
	# are the maker's own words about the whole sentence (v0.3)
	CtCheckValues(aDecls, false)

	# the CONSTRAINTs, each on every declaration of its ON kind; a condition
	# that reads through a reference that resolves to nothing says nothing,
	# and the reference's own refusal speaks below
	for i = 1 to len($aCourtConstraints)
		aCn = $aCourtConstraints[i]
		aK = CtKindByDeclName(aCn[2])
		if isnull(aK) loop ok
		aWhen = CondParse(aCn[3])
		aThen = null
		if aCn[4] != "" aThen = CondParse(aCn[4]) ok
		for j = 1 to len(aDecls)
			aD = aDecls[j]
			if aD[1] != aK[1] loop ok
			if CtIsBroken(j) loop ok
			$tCondOther = ""
			$bCondUnread = false
			bWhen = CondEval(aWhen, aD)
			if $bCondUnread loop ok
			if bWhen
				# WHEN alone names a forbidden state; with THEN, the consequence must hold
				bFail = true
				if not isnull(aThen)
					bFail = not CondEval(aThen, aD)
					if $bCondUnread loop ok
				ok
				if bFail
					tCnC = ""
					if len(aCn) >= 6 tCnC = aCn[6] ok
					aCC = CtElementCode(tCnC, "CONSTRAINT", aCn[1])
					# v0.23: a CONSTRAINT that CITES cites what it declares, as a REFUSAL does. The
					# element is assigned, not the list rebuilt from its own element: on Ring 1.27
					# `a = [a[1], b]` reads a[1] from a list already emptied (R2), haro reads it
					# first -- HF-36, met again here (stage 29's L6 on the oracle, 2026-11-02)
					# v0.28: CITES none -- the row's "none" -- cites nothing
					if len(aCn) >= 7
						if isstring(aCn[7])
							aCC[2] = []
						but len(aCn[7]) > 0
							aCC[2] = aCn[7]
						ok
					ok
					# v0.25: a CONSTRAINT of SEVERITY warning is noted and spoken after the verdict, never raised
					tCnSev = "error"
					if len(aCn) >= 8 tCnSev = aCn[8] ok
					if tCnSev = "warning"
						$aCourtWarnings + [aCC[1], aCC[2], aD[3], CtFill(aCn[5], aD, "")]
					else
						try
							CtFailC(aD[3], aCC[1], aCC[2], CtFill(aCn[5], aD, ""))
						catch
							CtNote(cCatchError)
						done
					ok
				ok
			ok
		next
	next

	# v0.32: the PATTERNs, each on the value of its OVER seat as the sentence writes it
	# (pattern_judge.haro, loaded by a court whose language declares a PATTERN: the language entry has a 24th element)
	aEPat = CtLangEntry($tCourtLang)
	if not isnull(aEPat)
		# (v0.40: a language that NEEDS writes the 24th element empty when it declares no PATTERN)
		if len(aEPat) >= 24
			if len(aEPat[24]) > 0 CtCheckPatterns(aDecls, tSrc) ok
		ok
	ok

	# the references, last
	CtCheckValues(aDecls, true)
	# v0.40: a door a sentence opens must be one its language NEEDS (needs_lib.haro, loaded where a language NEEDS: the entry has a 25th element)
	aENd = CtLangEntry($tCourtLang)
	if not isnull(aENd)
		if len(aENd) >= 25 NdCheck(aDecls, aENd[25]) ok
	ok
	# v0.9: an algorithm's step tree is a tree
	if not isnull($aCourtRun)
		try
			RunCheckAcyclic(aDecls)
		catch
			CtNote(cCatchError)
		done
	ok
	# v0.12: a family offers only forms the FORMS declares
	if not isnull($aCourtFormset)
		try
			FormsCheck(aDecls)
		catch
			CtNote(cCatchError)
		done
	ok
	# v0.17: the rules of a language that is UNDERSTOOD (n_lib.haro). They read a sentence whose references
	# resolve, so a sentence that already has a finding is not read by them; `check` stops at the first
	if not isnull($aCourtUnderstand) and len($aCourtFound) = 0
		try
			NatCheckRules(aDecls)
		catch
			CtNote(cCatchError)
		done
	ok
	# v0.10: the symbols resolve against the world, when one is handed in
	if not isnull($aCourtWorldFile) CtResolveWorld(aDecls) ok
	return aDecls

# the NAMES and the typed seat values of every declaration: bRefs false checks
# the local types and skips the references, true the references alone
func CtCheckValues(aDecls, bRefs)
	for i = 1 to len(aDecls)
		if CtIsBroken(i) loop ok
		aD = aDecls[i]
		aKind = CtKindByVerb(aD[1])
		if not bRefs
			if len(aKind) >= 4 and aKind[4] != ""
				tWhy = CtCheckNamed(aKind[4], aD[2])
				if tWhy != ""
					try
						CtFail(aD[3], "'" + aD[2] + "' " + tWhy)
					catch
						CtNote(cCatchError)
					done
				ok
			ok
		ok
		aC = aD[4]
		for j = 1 to len(aC)
			aSeat = CtSeatByClause(aKind, aC[j][1])
			aP = CtSeatPasses(aSeat)
			nPass = 1  if bRefs nPass = 2 ok
			if not aP[nPass] loop ok
			if CtTypeKind(aSeat) = "sentence"
				# v0.4: the file a SENTENCE seat names is judged in its own language
				try
					CtJudgeSentence(aD, aSeat, aC[j])
				catch
					CtNote(cCatchError)
				done
				loop
			ok
			# v0.35: a reference seat held at warning speaks each element that resolves to nothing as a warning (severity_lib.haro)
			if bRefs and len(aKind) >= 7
				if SevSeatIs(aKind, aSeat[1]) = "warning"
					SevWarnClause(aD, aSeat, aC[j])
					loop
				ok
			ok
			tWhy = CtCheckSeatValue(aD, aSeat, aC[j], bRefs)
			if tWhy != ""
				try
					CtFail(aC[j][2], tWhy)
				catch
					CtNote(cCatchError)
				done
			ok
		next
	next

# a declaration's name against its kind's NAMES (a MENU or a FORMAT); "" or why
func CtCheckNamed(tNames, tName)
	aM = CtMenuByName(tNames)
	if not isnull(aM)
		if CtInList(tName, aM[2]) return "" ok
		tMsg = aM[3]
		if tMsg = "" tMsg = "is not a " + tNames + ": the menu is " + CtJoin(aM[2], ", ") ok
		tOwn = ""
		if len(aM) >= 4 tOwn = aM[4] ok
		aCC = CtElementCites(tOwn, "MENU", aM[1], aM, 5)
		CtSetCode(aCC[1], aCC[2])
		return CtFill(tMsg, null, tName)
	ok
	aF = CtFormatByName(tNames)
	if not isnull(aF)
		if CtHasShape(tName, aF[2]) return "" ok
		tMsg = aF[3]
		if tMsg = "" tMsg = "is not a " + aF[2] ok
		tOwn = ""
		if len(aF) >= 5 tOwn = aF[5] ok
		aCC = CtElementCites(tOwn, "FORMAT", aF[1], aF, 6)
		CtSetCode(aCC[1], aCC[2])
		return CtFill(tMsg, null, tName)
	ok
	return ""

# one scalar value against a seat's type (menu, range, format, reference); "" or why
func CtCheckScalar(aDecl, aSeat, tValue)
	tK = CtTypeKind(aSeat)
	tClause = upper(aSeat[1])
	if tK = "menu"
		aM = CtMenuByName(aSeat[2])
		if isnull(aM) or CtInList(tValue, aM[2]) return "" ok
		tMsg = aM[3]
		if tMsg = "" tMsg = tClause + " is " + CtJoin(aM[2], ", ") ok
		if substr(tMsg, "{value}") = 0 tMsg += ", not '{value}'" ok
		tOwn = ""
		if len(aM) >= 4 tOwn = aM[4] ok
		aCC = CtElementCites(tOwn, "MENU", aM[1], aM, 5)
		CtSetCode(aCC[1], aCC[2])
		return CtFill(tMsg, aDecl, tValue)
	but tK = "range"
		aR = CtRangeByName(aSeat[2])
		if isnull(aR) return "" ok
		nN = number(tValue)
		if nN >= number(aR[2]) and nN <= number(aR[3]) return "" ok
		tMsg = aR[4]
		if tMsg = "" tMsg = tClause + " {value} is out of range (" + aR[2] + ".." + aR[3] + ")" ok
		tOwn = ""
		if len(aR) >= 5 tOwn = aR[5] ok
		aCC = CtElementCites(tOwn, "RANGE", aR[1], aR, 6)
		CtSetCode(aCC[1], aCC[2])
		return CtFill(tMsg, aDecl, tValue)
	but tK = "format"
		aF = CtFormatByName(aSeat[2])
		if isnull(aF) or CtHasShape(tValue, aF[2]) return "" ok
		tMsg = aF[3]
		if tMsg = "" tMsg = tClause + " is not a " + aF[2] + ": '{value}'" ok
		tOwn = ""
		if len(aF) >= 5 tOwn = aF[5] ok
		aCC = CtElementCites(tOwn, "FORMAT", aF[1], aF, 6)
		CtSetCode(aCC[1], aCC[2])
		return CtFill(tMsg, aDecl, tValue)
	but tK = "expr"
		# v0.6: the text is an expression of the seat's language, or the refusal says why
		aE = CtExprByName(aSeat[2])
		if isnull(aE) return "" ok
		CtExprUse(aE)
		tErr = ""
		try
			ExParse(tValue, [])
		catch
			tErr = cCatchError
		done
		if tErr != ""
			CtSetCode("EXPRESSION", ["rule:" + aSeat[2]])
			return tClause + " of " + aDecl[1] + " " + aDecl[2] + " is not a " + aSeat[2] + " expression -- " + tErr
		ok
		return ""
	but tK = "decl"
		aK = CtKindByDeclName(aSeat[2])
		if isnull(aK) return "" ok
		for i = 1 to len($aCondDecls)
			if $aCondDecls[i][1] = aK[1] and $aCondDecls[i][2] = tValue return "" ok
		next
		# the declaration's own MESSAGES for this seat speaks first (v0.3); its
		# CODES give the envelope's code (v0.11)
		aKd = CtKindByVerb(aDecl[1])
		aCC = CtElementCode(CtCodeFor(aKd, aSeat[1]), "DANGLING", aKd[2] + "." + aSeat[1])
		# v0.24: a zone entered through nothing is sovereignty's refusal (Art. 5)
		tArt5 = ""
		if CtUnderArticle("organizational_sovereignty")
			if CtZoneSeat(aKd[2], aSeat[1])
				aCites5 = aCC[2]
				aCites5 + "article:5"
				aCC[2] = aCites5
				tArt5 = " [Art. 5 organizational_sovereignty]"
			ok
		ok
		CtSetCode(aCC[1], aCC[2])
		if len(aKd) >= 5
			for i = 1 to len(aKd[5])
				if aKd[5][i][1] = aSeat[1] return CtFill(aKd[5][i][2], aDecl, tValue) + tArt5 ok
			next
		ok
		tMsg = CtRefusalMessage("dangling_reference")
		tOut = aDecl[2] + " " + tClause + " '" + tValue + "', which resolves to nothing: no such " + aK[1]
		if tMsg != "" tOut += " -- " + tMsg ok
		return tOut + tArt5
	ok
	return ""

# a clause's value against its seat: scalars directly, lists item by item; a
# UNION seat is checked as the alternative whose shape the value has (v0.3)
# v0.8: a word against a UNION of declarations -- it resolves to a declaration
# of one of the union's kinds, or the union's own MESSAGE speaks
func CtCheckUnionWord(aDecl, aSeat, tValue)
	aU = CtUnionByName(aSeat[2])
	if isnull(aU) return "" ok
	aVerbs = []
	for i = 1 to len(aU[2])
		if aU[2][i][3] != "decl" loop ok
		aK = CtKindByDeclName(aU[2][i][1])
		if isnull(aK) loop ok
		aVerbs + aK[1]
		for j = 1 to len($aCondDecls)
			if $aCondDecls[j][1] = aK[1] and $aCondDecls[j][2] = tValue return "" ok
		next
	next
	tMsg = aU[3]
	if tMsg = "" tMsg = "{VERB} {name} " + upper(aSeat[1]) + " '{value}', which resolves to nothing: no such " + CtJoin(aVerbs, " or ") ok
	tOwn = ""
	if len(aU) >= 4 tOwn = aU[4] ok
	aCC = CtElementCites(tOwn, "UNION", aU[1], aU, 5)
	CtSetCode(aCC[1], aCC[2])
	return CtFill(tMsg, aDecl, tValue)

func CtCheckSeatValue(aDecl, aSeat, aClause, bRefs)
	if CtTypeKind(aSeat) = "union" and not aSeat[3]
		aAlt = CtUnionAlt(aSeat, aClause)
		if isnull(aAlt) return "" ok
		if aAlt[3] = "decl"
			if not bRefs return "" ok
			if aClause[3][1] != "word" return "" ok
			return CtCheckUnionWord(aDecl, aSeat, aClause[3][2])
		ok
		if bRefs return "" ok
		return CtCheckSeatValue(aDecl, [aSeat[1], aAlt[1], aAlt[2], aSeat[4], aAlt[3]], aClause, bRefs)
	ok
	tShape = aClause[3][1]
	if tShape = "word" or tShape = "string" or tShape = "number"
		return CtCheckScalar(aDecl, aSeat, aClause[3][2])
	ok
	tK = CtTypeKind(aSeat)
	aItems = aClause[3][2]
	if aSeat[3] and tK = "union"
		# v0.9: a list of references to several kinds
		aKind = CtKindByVerb(aDecl[1])
		tMsgL = CtMessageFor(aKind, aSeat[1])
		for i = 1 to len(aItems)
			tWhy = CtCheckUnionWord(aDecl, aSeat, aItems[i])
			if tWhy != ""
				if tMsgL != "" return CtFill(tMsgL, aDecl, aItems[i]) ok
				return tWhy
			ok
		next
		return ""
	ok
	if tShape = "pairlist"
		# v0.6: each pair's value takes the form's second seat's type; v0.8: a
		# key is a name (once), a MENU word (a sequence, keys may repeat) or a
		# declaration (resolved), and a value may be a reference
		aF = CtFormByName(aSeat[2])
		if isnull(aF) or len(aF[2]) < 2 return "" ok
		aKeySeat = aF[2][1]
		aValSeat = aF[2][2]
		tKeyK = CtTypeKind(aKeySeat)
		tValK = CtTypeKind(aValSeat)
		aKind = CtKindByVerb(aDecl[1])
		tMsgL = CtMessageFor(aKind, aSeat[1])
		if not bRefs
			if tKeyK != "menu"
				for i = 1 to len(aItems)
					for j = 1 to i - 1
						if aItems[j][1] = aItems[i][1]
							CtSetCode("PARSE", [])
							return "'" + aItems[i][1] + "' is named twice in " + upper(aSeat[1]) + " of " + aDecl[1] + " " + aDecl[2]
						ok
					next
				next
			else
				for i = 1 to len(aItems)
					tWhy = CtCheckScalar(aDecl, aKeySeat, aItems[i][1])
					if tWhy != "" return tWhy ok
				next
			ok
			if tValK != "decl" and tValK != "union"
				for i = 1 to len(aItems)
					tWhy = CtCheckScalar(aDecl, aValSeat, aItems[i][2])
					if tWhy != "" return tWhy ok
				next
			ok
			# v0.27: a mark after a value is a word of the form's third seat's MENU
			for i = 1 to len(aItems)
				if len(aItems[i]) >= 4 and aItems[i][4] != ""
					if len(aF[2]) < 3
						CtSetCode("PARSE", [])
						return "'" + aItems[i][4] + "' marks '" + aItems[i][1] + "' in " + upper(aSeat[1]) + " of " + aDecl[1] + " " + aDecl[2] + ", and the form takes no mark"
					ok
					tWhy = CtCheckScalar(aDecl, aF[2][3], aItems[i][4])
					if tWhy != "" return tWhy ok
				ok
			next
			return ""
		ok
		if tKeyK = "decl"
			for i = 1 to len(aItems)
				tWhy = CtCheckScalar(aDecl, aKeySeat, aItems[i][1])
				if tWhy != ""
					if tMsgL != "" return CtFill(tMsgL, aDecl, aItems[i][1]) ok
					return tWhy
				ok
			next
		ok
		if tValK = "decl"
			for i = 1 to len(aItems)
				tWhy = CtCheckScalar(aDecl, aValSeat, aItems[i][2])
				if tWhy != ""
					if tMsgL != "" return CtFill(tMsgL, aDecl, aItems[i][2]) ok
					return tWhy
				ok
			next
		but tValK = "union"
			for i = 1 to len(aItems)
				tWhy = CtCheckUnionWord(aDecl, aValSeat, aItems[i][2])
				if tWhy != "" return tWhy ok
			next
		ok
		return ""
	ok
	if tK = "menu" or tK = "decl"
		for i = 1 to len(aItems)
			tWhy = CtCheckScalar(aDecl, aSeat, aItems[i])
			if tWhy != "" return tWhy ok
		next
	but tK = "form"
		# a form's one seat may be a FORMAT: each item takes its shape
		aF = CtFormByName(aSeat[2])
		if not isnull(aF) and len(aF[2]) > 0 and CtTypeKind(aF[2][1]) = "format"
			for i = 1 to len(aItems)
				tWhy = CtCheckScalar(aDecl, aF[2][1], aItems[i])
				if tWhy != "" return tWhy ok
			next
		ok
	ok
	return ""

# ---- the printed verdict -----------------------------------------------------

func CtPrintVerdict(aDecls)
	? "ok"
	aFirst = aDecls[1]
	? "name " + aFirst[2]
	? "rationale " + aFirst[5]
	aC = aFirst[4]
	for i = 1 to len(aC)
		if aC[i][3][1] = "word" or aC[i][3][1] = "string" or aC[i][3][1] = "number"
			? lower(aC[i][1]) + " " + aC[i][3][2]
		ok
	next
	aV = CtVerbs()
	for i = 1 to len(aV)
		nN = 0
		for j = 1 to len(aDecls)
			if aDecls[j][1] = aV[i] nN++ ok
		next
		? "count " + string(aV[i]) + " " + string(nN)
	next
	# v0.27: the fields the sentence marks personal or confidential, in the order written
	aMk = CtMarkedFields(aDecls)
	if len(aMk) > 0 ? "personal " + CtJoin(aMk, ", ") ok

# ---- v0.27: the marks and the safeguards -------------------------------------------
# $aCourtMarks holds [kind, seat, markSeat] paths from the CONSTITUTION's three-part PERSONAL paths; a
# field whose mark reads personal or confidential is a personal datum at the record level (stzFieldTags'
# two tags). $aCourtSafeguards holds [path, word]: the ask under anonymisation answers redacted, under
# consent whole; the voice under redaction tells its rows redacted.
func CtMarkedFields(aDecls)
	aOut = []
	for m = 1 to len($aCourtMarks)
		aKind = null
		for k = 1 to len($aCourtKinds)
			if $aCourtKinds[k][2] = $aCourtMarks[m][1] aKind = $aCourtKinds[k] ok
		next
		if isnull(aKind) loop ok
		for d = 1 to len(aDecls)
			if aDecls[d][1] != aKind[1] loop ok
			aC = aDecls[d][4]
			for c = 1 to len(aC)
				if lower(aC[c][1]) != $aCourtMarks[m][2] loop ok
				if aC[c][3][1] != "pairlist" loop ok
				aItems = aC[c][3][2]
				for i = 1 to len(aItems)
					if len(aItems[i]) >= 4 and (aItems[i][4] = "personal" or aItems[i][4] = "confidential")
						if not CtInList(aItems[i][1], aOut) aOut + aItems[i][1] ok
					ok
				next
			next
		next
	next
	return aOut

func CtSafeguard(tPath)
	for i = 1 to len($aCourtSafeguards)
		if $aCourtSafeguards[i][1] = tPath return $aCourtSafeguards[i][2] ok
	next
	return ""

# a copy of the rows (JSON objects: the mark, then [key, value] pairs) with each marked field's value [personal]
func CtRedactRows(aRows, aFields)
	if len(aFields) = 0 return aRows ok
	aOut = []
	for i = 1 to len(aRows)
		aRow = []
		for j = 1 to len(aRows[i])
			xV = aRows[i][j]
			if j > 1 and islist(xV) and len(xV) = 2 and isstring(xV[1]) and CtInList(xV[1], aFields)
				aRow + [xV[1], "[personal]"]
			else
				aRow + xV
			ok
		next
		aOut + aRow
	next
	return aOut

# ---- the refinement gate ------------------------------------------------------
# `<court>.ring refine <file> <file.rfn>`: one refinement, judged by the
# five stages before it lands (charter section 6; stzRefinableCode.ring's
# order): structural -- the refined text is a sentence of the language;
# constraint -- the point exists, FROM is its value, TO has the seat's
# shape; derivation -- the whole file still holds (one namespace, required
# seats); governance -- an author and a reason are named; trust -- the
# proposal's posture reaches the point's floor. Admitted, the refined text
# is written to <file>.refined and the inverse to <file>.revert.rfn; the
# refusal is one human line and one C2 record (JSON) beneath it.

func CtJson(tS)
	tOut = ""
	for i = 1 to len(tS)
		tC = tS[i]
		if tC = '"' or tC = char(92)
			tOut += char(92) + tC
		but tC = char(10)
			tOut += char(92) + "n"
		else
			tOut += tC
		ok
	next
	return '"' + tOut + '"'

func CtRecord(tCode, tMsg, tFile, nLine, aCites, tWhy, tTodo)
	tC = ""
	for i = 1 to len(aCites)
		if i > 1 tC += ", " ok
		tC += CtJson(aCites[i])
	next
	return '{"code": ' + CtJson(tCode) + ', "severity": "error", "message": ' + CtJson(tMsg) +
	       ', "span": {"file": ' + CtJson(tFile) + ', "line": ' + string(nLine) + '}, "cites": [' + tC + ']' +
	       ', "language": ' + CtJson($tCourtLang) + ', "why": ' + CtJson(tWhy) + ', "todo": ' + CtJson(tTodo) + '}'

func CtPostureRank(tP)
	if tP = "trusted" return 3 ok
	if tP = "external" return 2 ok
	if tP = "sandboxed" return 1 ok
	if tP = "llm" return 0 ok
	return -1

# the refinement sentence's own tables (rfn.haro), read by the same parser
func CtRfnKinds()
	return [ ["REFINE", "refinement", [ ["target", "text", false, false], ["kind", "name", false, false], ["from", "text", false, false],
	          ["to", "text", false, false], ["author", "text", false, false], ["posture", "name", false, false], ["reason", "text", false, false] ]] ]

func CtClauseText(aDecl, tClause)
	aC = aDecl[4]
	for i = 1 to len(aC)
		if aC[i][1] = tClause return aC[i][3][2] ok
	next
	return null

func CtRefuse(tStage, tCode, tMsg, tFile, nLine, aCites, tWhy, tTodo)
	? $tCourtLang + " (line " + string(nLine) + "): " + tStage + ": " + tMsg
	? CtRecord(tCode, tStage + ": " + tMsg, tFile, nLine, aCites, tWhy, tTodo)
	CtAuditWrite("refused", tStage, tCode)

func CtRefine(tFile, tRfnFile)
	tSrc = read(tFile)
	tRfn = read(tRfnFile)

	# the refinement sentence, parsed by this court with the rfn tables
	aSaveKinds = $aCourtKinds
	aSaveLang = $tCourtLang
	$aCourtKinds = CtRfnKinds()
	$tCourtLang = "rfn"
	aR = null
	tErr = ""
	try
		aRs = CtDeclare(tRfn)
		aR = aRs[1]
	catch
		tErr = cCatchError
	done
	$aCourtKinds = aSaveKinds
	$tCourtLang = aSaveLang
	if not isnull(tErr) and tErr != ""
		? tErr
		return
	ok
	tTarget = CtClauseText(aR, "TARGET")
	tFrom = CtClauseText(aR, "FROM")
	tTo = CtClauseText(aR, "TO")
	tAuthor = CtClauseText(aR, "AUTHOR")
	tPosture = CtClauseText(aR, "POSTURE")
	tReason = CtClauseText(aR, "REASON")
	nRLine = aR[3]
	# v0.24: under visible_state every event of this proposal joins the sentence's audit chain
	$tCourtAuditFile = ""
	if CtUnderArticle("visible_state")
		$tCourtAuditFile = tFile + ".audit"
		$aCourtAuditProposal = [aR[2], tTarget, tFrom, tTo, tAuthor, tPosture]
	ok

	# structural, on the ORIGINAL: the file must be a sentence before it is refined
	aDecls = null
	try
		aDecls = CtDeclare(tSrc)
	catch
		CtRefuse("structural", "NOT_A_SENTENCE", cCatchError, tFile, 1, ["rule:structural"],
		         "the gate's structural stage is the language's own court, and the file to refine is not a sentence of it",
		         "make the file a sentence of the language first; then propose the refinement")
		return
	done

	# constraint: the point exists, FROM is its value, TO fits the seat
	nDot = substr(tTarget, ".")
	if nDot = 0
		CtRefuse("constraint", "NO_SUCH_POINT", "the target '" + tTarget + "' is not declaration.CLAUSE", tRfnFile, nRLine,
		         ["rule:constraint"], "a point is a clause of a declaration, named declaration.CLAUSE", "name the point as <declaration>.<CLAUSE>")
		return
	ok
	tDeclName = left(tTarget, nDot - 1)
	tClause = substr(tTarget, nDot + 1)
	aDecl = null
	for i = 1 to len(aDecls)
		if aDecls[i][2] = tDeclName aDecl = aDecls[i] ok
	next
	if isnull(aDecl)
		CtRefuse("constraint", "NO_SUCH_POINT", "no declaration '" + tDeclName + "' in " + tFile, tRfnFile, nRLine,
		         ["rule:constraint"], "every named thing is a refinement point, and nothing by this name is declared", "name a declaration the file carries")
		return
	ok
	aKind = CtKindByVerb(aDecl[1])
	aSeat = CtSeatByClause(aKind, tClause)
	if isnull(aSeat)
		CtRefuse("constraint", "NO_SUCH_POINT", aDecl[1] + " has no clause " + tClause + "; allowed are " + CtJoin(CtAllowedClauses(aKind), ", "),
		         tRfnFile, nRLine, ["rule:constraint"], "the point's clause is not a seat of its declaration kind", "name one of the allowed clauses")
		return
	ok
	tShape = CtClauseShape(aSeat)
	if tShape = "union"
		# a UNION seat's shape is the shape of the value written (v0.3)
		tShape = "word"
		aCw = aDecl[4]
		for i = 1 to len(aCw)
			if aCw[i][1] = tClause tShape = aCw[i][3][1] ok
		next
	ok
	if tShape != "word" and tShape != "string" and tShape != "number"
		CtRefuse("constraint", "NOT_A_KNOB", tClause + " is a list seat; this gate refines scalar points only", tRfnFile, nRLine,
		         ["rule:constraint"], "the spike's gate refines knobs, fields and symbols, not composites", "refine a scalar clause")
		return
	ok
	# v0.2: the point is declared in REFINE's POINTS, with its kind. A language
	# that declares no REFINE at all keeps the spike's first rule: every
	# scalar seat is a point (a word or number a knob, a text a field) at the
	# court's floor, trusted.
	tPointName = aKind[2] + "." + lower(tClause)
	# v0.25: the chain learns the point, so a personal point's values are redacted in it
	if $tCourtAuditFile != "" $aCourtAuditProposal + tPointName ok
	tDeclaredKind = ""
	for i = 1 to len($aCourtPoints)
		if $aCourtPoints[i][1] = tPointName tDeclaredKind = $aCourtPoints[i][2] ok
	next
	if len($aCourtPoints) = 0
		tDeclaredKind = "field"
		if tShape = "word" or tShape = "number" tDeclaredKind = "knob" ok
	ok
	if tDeclaredKind = ""
		CtRefuse("constraint", "NOT_A_POINT", "'" + tTarget + "' is not a declared refinement point of " + $tCourtLang + " (" + tPointName + " is not in REFINE's POINTS)",
		         tRfnFile, nRLine, ["rule:refine-points"], "every refinable point is declared by the language, with its kind; the boundaries are language-required, not author-chosen",
		         "propose a change to a declared point, or declare this one in the language's REFINE")
		return
	ok
	tKindGiven = CtClauseText(aR, "KIND")
	if tKindGiven != tDeclaredKind
		CtRefuse("constraint", "KIND_MISMATCH", "'" + tTarget + "' is a " + tDeclaredKind + ", not a " + tKindGiven, tRfnFile, nRLine,
		         ["rule:refine-points"], "the point's kind is declared by the language", "say KIND " + tDeclaredKind)
		return
	ok
	# the clause as written, with its token span
	aClause = null
	aC = aDecl[4]
	for i = 1 to len(aC)
		if aC[i][1] = tClause aClause = aC[i] ok
	next
	if isnull(aClause)
		CtRefuse("constraint", "POINT_UNSET", aDecl[1] + " " + tDeclName + " does not write " + tClause + "; this gate refines a clause that is written",
		         tRfnFile, nRLine, ["rule:constraint"], "a refinement changes a value the sentence carries", "write the clause first, then refine it")
		return
	ok
	tCurrent = aClause[3][2]
	if tCurrent != tFrom
		CtRefuse("constraint", "FROM_MISMATCH", tClause + " of " + tDeclName + " is '" + tCurrent + "', not '" + tFrom + "'", tRfnFile, nRLine,
		         ["rule:constraint"], "FROM is an assertion about the point's value, and it does not hold", "state the value the file carries")
		return
	ok
	if tShape = "number"
		for i = 1 to len(tTo)
			if not CtIsDigit(tTo[i])
				CtRefuse("constraint", "SHAPE", tClause + " takes a number, and '" + tTo + "' is not one", tRfnFile, nRLine,
				         ["rule:constraint"], "the seat's shape is declared", "propose a number")
				return
			ok
		next
	but tShape = "word"
		for i = 1 to len(tTo)
			if not CtIsLowerish(tTo[i])
				CtRefuse("constraint", "SHAPE", tClause + " takes a word, and '" + tTo + "' is not lower_snake", tRfnFile, nRLine,
				         ["rule:constraint"], "the seat's shape is declared", "propose a lower_snake word")
				return
			ok
		next
	ok
	# v0.2: the bounds of the point are the seat's declared type (a MENU, a RANGE, a FORMAT)
	tWhy = CtCheckScalar(aDecl, aSeat, tTo)
	if tWhy != ""
		CtRefuse("constraint", "OUT_OF_BOUNDS", tWhy, tRfnFile, nRLine, ["rule:constraint"],
		         "a knob's bounds are the declared type of its seat; the court speaks the type's own message",
		         "propose a value the seat's type admits")
		return
	ok

	# the refined text: the value's span replaced, nothing else touched
	nStart = aClause[4]
	nEnd = aClause[5]
	tNew = tTo
	if tShape = "string" tNew = '"' + tTo + '"' ok
	tRefined = left(tSrc, nStart - 1) + tNew + substr(tSrc, nEnd)

	# derivation: the whole file still holds (the court's checks on the refined text)
	try
		CtDeclare(tRefined)
	catch
		CtRefuse("derivation", "DERIVATION", cCatchError, tFile, aClause[2], ["rule:derivation"],
		         "the refined sentence breaks a rule of the language", "choose a value the language admits")
		return
	done

	# governance: an author and a reason
	if tAuthor = "" or tReason = ""
		CtRefuse("governance", "UNATTRIBUTED", "a refinement names its author and its reason; this one does not", tRfnFile, nRLine,
		         ["rule:governance"], "the audit chain is author, authority, rule, verdict, and an unattributed change has no chain", "name the author and the reason")
		return
	ok

	# trust: the point's floor (this court: trusted for every point) against the posture
	nRank = CtPostureRank(tPosture)
	if nRank < 0
		CtRefuse("trust", "POSTURE", "'" + tPosture + "' is not a posture: trusted, external, sandboxed or llm", tRfnFile, nRLine,
		         ["rule:trust"], "the trust ladder is closed", "name one of the four postures")
		return
	ok
	# v0.2: the floor is the point's own (REFINE's FLOOR), trusted when it declares none
	tFloor = "trusted"
	for i = 1 to len($aCourtFloors)
		if $aCourtFloors[i][1] = tPointName tFloor = $aCourtFloors[i][2] ok
	next
	if nRank < CtPostureRank(tFloor)
		tMsgT = "posture :" + tPosture + " below the required floor :" + tFloor + " for '" + tTarget + "'"
		aCitesT = ["rule:trust-floor"]
		# v0.23: under trust_hierarchy the refusal names its article and cites it
		if CtUnderArticle("trust_hierarchy")
			tMsgT += " [Art. 6 trust_hierarchy]"
			aCitesT + "article:6"
		ok
		CtRefuse("trust", "TRUST_FLOOR", tMsgT, tRfnFile, nRLine,
		         aCitesT, "the point's floor is declared by the language (REFINE's FLOOR; trusted when none is declared): a proposal below it is refused by construction, not by convention",
		         "an actor of posture :" + tFloor + " or above may propose the same change; or lower the point's floor in the language's REFINE")
		return
	ok

	# admitted: the refined text, and its inverse, written beside the file
	write(tFile + ".refined", tRefined)
	tRevert = "DEFINE REFINE revert_of_" + aR[2] + " AS (" + char(10) +
	          '  TARGET "' + tTarget + '", KIND ' + CtClauseText(aR, "KIND") + ',' + char(10) +
	          '  FROM "' + tTo + '", TO "' + tFrom + '",' + char(10) +
	          '  AUTHOR "' + tAuthor + '", POSTURE ' + tPosture + ',' + char(10) +
	          '  REASON "the inverse of ' + aR[2] + ', computed before it landed"' + char(10) +
	          ') RATIONALE "A revert is its own event; nothing is erased"' + char(10)
	write(tFile + ".revert.rfn", tRevert)
	# v0.25: a personal point's values are not spoken (W4.4); the inverse beside the file keeps them, as the file does
	tShownA = tFrom + " -> " + tTo
	if CtIsPersonal(tPointName) tShownA = "[personal] -> [personal]" ok
	? "admitted: " + tTarget + " " + tShownA + " [" + tPosture + "] (structural + constraint + derivation + governance + trust passed); inverse in " + tFile + ".revert.rfn"
	CtAuditWrite("admitted", "", "")

# ---- v0.6: a sentence's expressions evaluated, and a WALK run ---------------------
# `<court>.ring eval <file> <decl> <seat> <json>`: the expression in SEAT of the
# declaration DECL, evaluated on the record, answers true or false.
# `<court>.ring walk <file> <name> <json>`: the record walks the steps of the
# declaration NAME under the WALK of its kind -- every step whose THROUGH seat
# names it, in ORDER; at each step the FORMULA, when written, computes the
# COMPUTE seat's value into the record first (for this step's guards and every
# later one, as zing's runner does), then each GUARD in the WALK's order must
# hold; the first that does not stops the walk. The verdict is JSON:
#   {"status": "complete", "computed": {name: value, ...}}
#   {"status": "failed", "at": step, "code": <the FAIL seat>, "reason": why}
# A guard read through a reference (enforcing.rule) takes its reason from the
# referenced declaration's `message` seat when it has one.

func CtDeclNamed(aDecls, tName)
	for i = 1 to len(aDecls)
		if aDecls[i][2] = tName return aDecls[i] ok
	next
	return null

func CtWalkOf(tKindName)
	for i = 1 to len($aCourtWalks)
		if $aCourtWalks[i][2] = tKindName return $aCourtWalks[i] ok
	next
	return null

# the node of an expression seat, parsed under its language; NULL when the
# clause is not written
func CtExprNode(aDecl, tSeat)
	aKind = CtKindByVerb(aDecl[1])
	aSeat = CtSeatByClause(aKind, upper(tSeat))
	if isnull(aSeat) raise("no seat '" + tSeat + "' on " + aDecl[1]) ok
	if CtTypeKind(aSeat) != "expr" raise(upper(tSeat) + " of " + aDecl[1] + " " + aDecl[2] + " is not an expression seat") ok
	tText = CondScalar(aDecl, tSeat)
	if isnull(tText) return null ok
	aE = CtExprByName(aSeat[2])
	if isnull(aE) raise("the court carries no EXPRESSION called '" + aSeat[2] + "'") ok
	CtExprUse(aE)
	return ExParse(tText, [])

func CtEval(aDecls, tDecl, tSeat, aRecord)
	aD = CtDeclNamed(aDecls, tDecl)
	if isnull(aD) raise("no declaration named '" + tDecl + "' in this file") ok
	aNode = CtExprNode(aD, tSeat)
	if isnull(aNode) raise(upper(tSeat) + " is not written on " + aD[1] + " " + aD[2]) ok
	ExSetRecord(aRecord)
	return ExBool(aNode, [])

# a guard of a step: [node, reason], or [NULL, ""] when the seat is not written
func CtGuard(aDecls, aStep, tPath)
	nDot = substr(tPath, ".")
	if nDot = 0
		aNode = CtExprNode(aStep, tPath)
		return [aNode, upper(tPath) + " failed"]
	ok
	tHead = left(tPath, nDot - 1)
	tTail = substr(tPath, nDot + 1)
	tRef = CondScalar(aStep, tHead)
	if isnull(tRef) return [null, ""] ok
	aTarget = CtDeclNamed(aDecls, tRef)
	if isnull(aTarget) return [null, ""] ok
	aNode = CtExprNode(aTarget, tTail)
	tReason = CondScalar(aTarget, "message")
	if isnull(tReason) tReason = upper(tTail) + " of " + aTarget[1] + " " + aTarget[2] + " failed" ok
	return [aNode, tReason]

func CtWalk(aDecls, tName, aRecord)
	aD = CtDeclNamed(aDecls, tName)
	if isnull(aD) raise("no declaration named '" + tName + "' in this file") ok
	aKind = CtKindByVerb(aD[1])
	aW = CtWalkOf(aKind[2])
	if isnull(aW) raise("no WALK of " + aKind[2] + " is declared, so " + aD[1] + " " + tName + " cannot be walked") ok
	aStepKind = CtKindByDeclName(aW[3])
	# the steps THROUGH this declaration, in ORDER (an insertion sort on the
	# number: Ring's sort() orders a column of text)
	aSteps = []
	for i = 1 to len(aDecls)
		if aDecls[i][1] != aStepKind[1] loop ok
		tThrough = CondScalar(aDecls[i], aW[4])
		if isnull(tThrough) or tThrough != tName loop ok
		nOrder = number(CondScalar(aDecls[i], aW[5]))
		nAt = len(aSteps) + 1
		for j = 1 to len(aSteps)
			if nOrder < aSteps[j][1]
				nAt = j
				exit
			ok
		next
		aEntry = [nOrder, aDecls[i]]
		if nAt > len(aSteps)
			aSteps + aEntry
		else
			# Ring's insert() puts the item AFTER the index: before j is after j-1 (HF-52)
			insert(aSteps, nAt - 1, aEntry)
		ok
	next
	ExSetRecord(aRecord)
	aComputed = [ExObjMark()]
	for i = 1 to len(aSteps)
		aStep = aSteps[i][2]
		if aW[7] != "" and aW[8] != ""
			tTarget = CondScalar(aStep, aW[7])
			aF = CtExprNode(aStep, aW[8])
			if not isnull(tTarget) and not isnull(aF)
				xV = ExNum(ExEval(aF, []))
				$aExprOverlay + [tTarget, xV]
				aPair = [tTarget, xV]
				aComputed + aPair
			ok
		ok
		aG = aW[6]
		for j = 1 to len(aG)
			aGuard = CtGuard(aDecls, aStep, aG[j])
			if isnull(aGuard[1]) loop ok
			if not ExBool(aGuard[1], [])
				aOut = [ExObjMark(), ["status", "failed"], ["at", aStep[2]]]
				if aW[9] != ""
					tCode = CondScalar(aStep, aW[9])
					if not isnull(tCode)
						aPair = ["code", tCode]
						aOut + aPair
					ok
				ok
				aPair = ["reason", aGuard[2]]
				aOut + aPair
				return aOut
			ok
		next
	next
	aOut = [ExObjMark(), ["status", "complete"], ["computed", aComputed]]
	return aOut

# the command: check <file> | refine <file> <file.rfn> | eval ... | walk ... | ask ...
func CtMain()
	if len(sysargv) < 4
		? "usage: <court>.haro check <file" + $tCourtExt + "> | refine <file" + $tCourtExt + "> <file.rfn> | eval <file> <decl> <seat> <json> | walk <file> <name> <json> | ask <file> <question> <rows json> | audit <file>"
		return
	ok
	tVerb = sysargv[3]
	# the judged file's folder: a SENTENCE seat's file is read beside it (v0.4)
	$tCourtDir = CtDirOf(sysargv[4])
	if tVerb = "check"
		# v0.10: `check <file> [<world.json>]` -- with a world, every SYMBOL seat
		# resolves against it; without one, a sentence that holds SYMBOL seats is
		# judged alone and the last line says so, a warning (C2's "undecidable
		# without more input"), never a refusal
		tSrc = read(sysargv[4])
		try
			# v0.17: `surfaces` asks each surface's own court to judge its queries (a language that is understood)
			if not isnull($aCourtUnderstand) and len(sysargv) >= 5
				if sysargv[5] = "surfaces" $bNSurfaces = true ok
			ok
			if len(sysargv) >= 5 and not $bNSurfaces $aCourtWorldFile = CtWorldLoad(sysargv[5]) ok
			$aCourtWarnings = []
			aDecls = CtDeclare(tSrc)
			CtPrintVerdict(aDecls)
			# v0.25: a CONSTRAINT of SEVERITY warning is spoken after the verdict, with its code and line
			for i = 1 to len($aCourtWarnings)
				? "warning " + string($aCourtWarnings[i][1]) + ": " + string($aCourtWarnings[i][4]) + " (line " + string($aCourtWarnings[i][3]) + ")"
			next
			if isnull($aCourtWorldFile) and len($aCourtSymbols) > 0
				nSites = len(CtSymbolSites(aDecls))
				if nSites > 0
					? "warning NO_WORLD: no world to resolve against; " + string(nSites) + " symbol reference(s) unresolved, which is what C3 section 3.2 asks a project to close"
				ok
			ok
		catch
			? cCatchError
		done
	but tVerb = "diagnose"
		# v0.11: the same court, in the family's machine form (C2 v1.2.0)
		tWorldPath = ""
		if not isnull($aCourtUnderstand) and len(sysargv) >= 5
			if sysargv[5] = "surfaces" $bNSurfaces = true ok
		ok
		if len(sysargv) >= 5 and not $bNSurfaces tWorldPath = sysargv[5] ok
		? CtDiagnosticsJson(CtDiagnose(sysargv[4], tWorldPath))
	but tVerb = "world"
		# v0.10: the sentence's own C1 rows, as JSON
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			aWRows = CtWorldRows(aDecls, CtWorldStem(sysargv[4]) + $tCourtExt)
			# v0.40: the doors each declaration opens, published for the consumer that enforces them -- only where the language NEEDS (D51)
			aEW = CtLangEntry($tCourtLang)
			if not isnull(aEW)
				if len(aEW) >= 25 aWRows + ["opens", NdRows(aDecls, aEW[25], CtWorldStem(sysargv[4]) + $tCourtExt)] ok
			ok
			? ExJson(aWRows)
		catch
			? cCatchError
		done
	but tVerb = "refine"
		if len(sysargv) < 5
			? "usage: <court>.haro refine <file" + $tCourtExt + "> <file.rfn>"
			return
		ok
		CtRefine(sysargv[4], sysargv[5])
	but tVerb = "audit"
		# v0.24: the audit chain of a sentence under visible_state, answered as a query: every
		# refinement event kept beside the sentence, in order, then their count
		tAuditPath = sysargv[4] + ".audit"
		if not CtUnderArticle("visible_state")
			? "no audit chain: " + $tCourtLang + " is under no visible_state"
		but not fexists(tAuditPath)
			? "no audit chain yet: " + tAuditPath + " does not exist"
		else
			tAuditText = read(tAuditPath)
			nAuditEvents = 0
			tAuditLine = ""
			for i = 1 to len(tAuditText)
				if tAuditText[i] = char(10)
					if tAuditLine != ""
						? tAuditLine
						nAuditEvents++
					ok
					tAuditLine = ""
				else
					tAuditLine += tAuditText[i]
				ok
			next
			? string(nAuditEvents) + " events"
		ok
	but tVerb = "eval"
		if len(sysargv) < 7
			? "usage: <court>.haro eval <file" + $tCourtExt + "> <decl> <seat> <json>"
			return
		ok
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			aRecord = ExJsonParse(sysargv[7])
			if CtEval(aDecls, sysargv[5], sysargv[6], aRecord)
				? "true"
			else
				? "false"
			ok
		catch
			? cCatchError
		done
	but tVerb = "walk"
		if len(sysargv) < 6
			? "usage: <court>.haro walk <file" + $tCourtExt + "> <name> <json>"
			return
		ok
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			aRecord = ExJsonParse(sysargv[6])
			? ExJson(CtWalk(aDecls, sysargv[5], aRecord))
		catch
			? cCatchError
		done
	but tVerb = "run"
		# v0.9: an algorithm run on a record
		if len(sysargv) < 6
			? "usage: <court>.haro run <file" + $tCourtExt + "> <algorithm> <record json>"
			return
		ok
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			if isnull($aCourtRun) CtFail(1, "this language declares no RUN, so nothing in it runs") ok
			aRecord = ExJsonParse(sysargv[6])
			? ExJson(RunAlgorithm(aDecls, sysargv[5], aRecord))
		catch
			? cCatchError
		done
	but tVerb = "narrate"
		# v0.13: the sentence narrated back in the language's own voice, on stdout, never stored
		if len(sysargv) < 4
			? "usage: <court>.haro narrate <file" + $tCourtExt + ">"
			return
		ok
		try
			if isnull($aCourtNarrate) CtFail(1, "this language declares no NARRATE, so it has no voice") ok
			NarrateRun(sysargv[4])
		catch
			? cCatchError
		done
	but tVerb = "narrate-run"
		# v0.16: an algorithm run on a record, told in the language's own voice -- the same run `run` makes, never a second one
		if len(sysargv) < 6
			? "usage: <court>.haro narrate-run <file" + $tCourtExt + "> <algorithm> <record json>"
			return
		ok
		try
			if isnull($aCourtNarrate) CtFail(1, "this language declares no NARRATE, so it has no voice") ok
			if isnull($aCourtRun) CtFail(1, "this language declares no RUN, so nothing in it runs") ok
			NarTellRun(sysargv[4], sysargv[5], sysargv[6])
		catch
			? cCatchError
		done
	but tVerb = "narrate-ask"
		# v0.16: a question answered on rows, told in the language's own voice -- the same answer `ask` gives
		if len(sysargv) < 6
			? "usage: <court>.haro narrate-ask <file" + $tCourtExt + "> <question> <rows json>"
			return
		ok
		try
			if isnull($aCourtNarrate) CtFail(1, "this language declares no NARRATE, so it has no voice") ok
			if isnull($aCourtAsk) CtFail(1, "this language declares no ASK, so it answers no question") ok
			NarTellAsk(sysargv[4], sysargv[5], sysargv[6])
		catch
			? cCatchError
		done
	but tVerb = "family"
		# v0.12: the members of every declared family, generated from the FORMS
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			if isnull($aCourtFormset) CtFail(1, "this language declares no FORMS, so it spells no family") ok
			FormsPrintFamilies(aDecls)
		catch
			? cCatchError
		done
	but tVerb = "spellings"
		# v0.12: a list of names judged against the FORMS and the declared families
		if len(sysargv) < 5
			? "usage: <court>.haro spellings <file" + $tCourtExt + "> <names.txt>"
			return
		ok
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			if isnull($aCourtFormset) CtFail(1, "this language declares no FORMS, so it judges no spelling") ok
			FormsPrintSpellings(aDecls, FormsReadNames(sysargv[5]))
		catch
			? cCatchError
		done
	but not isnull($aCourtUnderstand) and CtInList(tVerb, ["tokens", "understand", "ask", "vocabulary", "examples"])
		# v0.17: a human language over a declared world, understood (n_lib.haro); `ask` here takes a tongue and
		# a text, where the Q letter's takes a question and rows -- different courts, different arguments
		NatMain(tVerb)
	but tVerb = "ask"
		# v0.7: a question of the declared world, answered on the rows handed in
		if len(sysargv) < 6
			? "usage: <court>.haro ask <file" + $tCourtExt + "> <question> <rows json>"
			return
		ok
		tSrc = read(sysargv[4])
		try
			aDecls = CtDeclare(tSrc)
			if isnull($aCourtAsk) CtFail(1, "this language declares no ASK, so it answers no question") ok
			aRows = ExJsonParse(sysargv[6])
			aAns = AskRun(aDecls, sysargv[5], aRows)
			# v0.27: under anonymisation the ask path answers with the marked fields redacted; under consent, whole
			if CtSafeguard("ask") = "anonymisation" aAns = CtRedactRows(aAns, CtMarkedFields(aDecls)) ok
			? ExJson(aAns)
		catch
			? cCatchError
		done
	else
		? "unknown verb '" + tVerb + "'; this court answers: check, refine, eval, walk, ask, run, world, diagnose, family, spellings, narrate, narrate-run, narrate-ask, audit"
	ok
